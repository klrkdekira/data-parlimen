      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding two hundred and forty six million three hundred arid fifteen thousand six hundred and seventy nine ringgit ($246,315,679) from the Consolidated Fund expenditure on the services specified Schedule for the service of the year 1989, not provided for or not fully provided for by the Supply Act 1989, the Supplementary Supply (1988 and 1989) Act 1989 and the Supplementary Supply (1988 and 1989) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/1/eng@/~sched_1",
