        "@value": "[Section 10 (1) (a)] (1) (2) Name of Free Commercial Zone Activities"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
