      "schema:text": {
        "@language": "en",
        "@value": "Mukim of Pringgit and Bukit Manufacturing. Baru, in Central District of Melaka: All that land situated in the Mukim of Pringgit and Bukit Baru, in the Central District of Melaka, bounded by the grey line as shown in the Gazette Plan PG 108 deposited in the Office of the Director of Survey, Melaka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~sched_2__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~sched_2",
