      "schema:text": {
        "@language": "en",
        "@value": "ACTIVITIES PERMITTED WITHIN A FREE ZONE"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SPECIFIC FUNCTIONS OF AUTHORITY"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may require the Authority to , provide and maintain in a free zone such facilities as he J may consider necessary for the proper and efficient functioning of such zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give to the Authority such directions as he may consider necessary for the proper functioning of a free zone or for the purpose of protecting revenue; and the Authority shall comply with such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall provide adequate facilities for officers of customs whose duties may require their presence within or at the perimeter of a free zone; and the Authority shall permit customs offices to be established in a free zone—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to enable the Director-General to make such arrangements as he deems necessary to ensure the proper supervision of goods taken out from the free zone; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for such purpose as may be considered necessary by the Minister for the better administration of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall provide adequate enclosures to segregate a free zone from the principal customs area for the protection of revenue together with suitable provisions for the movement of persons, conveyances, vessels and goods entering or leaving a free zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may permit any person to erect such buildings and other structures within a free industrial zone as may be required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, after consulting Director-General, lease to or allow any person to take, hold or enjoy movable and immovable property of every description in a free industrial zone upon such terms and conditions and for such period as the Authority may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act no person shall enter or reside within a free industrial zone without permission of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes the provision of subsection (1) shall be guilty of an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may in its discretion order the exclusion or removal from a free industrial zone of any goods, or the discontinuance of any activity or operations, which in its opinion are dangerous or prejudicial to the public interest, health or safety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "An order by the Authority as to the removal or exclusion of any goods, which in the opinion of the Authority are dangerous or prejudicial to public safety, shall, notwithstanding an appeal to the Minister, be complied with immediately; but an order as to the discontinuance of activities or operations shall not take effect, if an appeal has been made to the Minister, until the determination of the appeal in favour of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Minister shall be final and not be subject to review in any court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall prescribe the form and manner of keeping the accounts of a free industrial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority if so directed by the Minister shall present to him annually and at such other times as the Minister may prescribe, reports containing a - full statement of all activities, operations, receipts and expenditure and such other information in respect of such zone as the Minister may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "With the approval of the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there may be carried out in a free commercial zone the activities specified in the First Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there may be carried out in a free industrial zone the manufacturing activities specified in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, by notification in the Gazette add to, alter or amend the First and the Second Schedules."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 8, no commercial activity shall be allowed in a free industrial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act goods of any description which would be used directly for the manufacture of other goods and are approved by the Minister or goods manufactured in any part of the principal customs area which are meant for export may be brought into a free industrial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "No other goods except those referred to in subsection (1) shall be allowed to be brought into a free industrial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2) goods of any description may be brought into a free commercial zone for retail trade or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order, prohibit any goods or class of goods from being taken into a free commercial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Subject to this Act goods and services of any"
      },
      "schema:text": {
        "@language": "en",
        "@value": "description, except those specifically and absolutely prohibited by law, may be brought into, produced, manufactured or provided in a free zone without payment of any customs duty, excise duty, sales tax or service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise provided under this Act or any regulations made thereunder no person shall deal with or otherwise dispose of any goods in a free zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, goods in a free zone may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "be removed from such free zone for export or sent into another free zone either in original package or otherwise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "unless otherwise directed by the Authority— (i) be stored, sold, exhibited, broken up, repacked, assembled, distributed, sorted, graded, cleaned, mixed, or otherwise manipulated or be manu- factured in accordance with provisions of this Act, or (ii) be destroyed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "with the approval of the Authority, and subject to such conditions as may be imposed by it, be sent into any part of the principal customs area in the original package provided that the Authority shall consult the Director- General before movement of the goods is authorised."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section shall not apply to goods excluded by order made under subsection (1) of section 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, exclude any goods or services from the provisions of section 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary in any written law the provisions of the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972 and the Service Tax Act 1975 shall apply to the goods and services so excluded as if the free zone is a place within the principal customs area."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Unless otherwise provided under this Act or any"
      },
      "schema:text": {
        "@language": "en",
        "@value": "regulations made thereunder or under any other written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "goods which are taken out from any part of the principal customs area and brought into a free zone shall be deemed to be exported from Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "goods which are brought out of a free zone and taken into any part of the principal customs area shall be deemed to be imported into Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Goods manufactured within a free industrial zone shall not be taken but of such zone except—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "for export; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the approval of the Authority and after consultation with the Director-General, and subject to such conditions as may be imposed, for transmission of the goods to a free commercial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "No retail trade shall be conducted within a free industrial zone unless authorised by the Authority; and the Authority may in relation to such authorisation impose such conditions as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall consult the Director- General before authorising any retail to be conducted within a free industrial zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Goods manufactured in a free industrial zone shall not, without the written permission of a proper officer of customs not below the rank of Assistant Director of Customs and Excise, be used or consumed in such zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes the provisions of section 5 or 8 shall be guilty of an offence and shall, on conviction, be liable for the first offence to a fine of not less than ten times the amount of the customs or excise duty or tax or five thousand ringgit, whichever is the lesser amount, and of not more than twenty times the amount of the customs or excise duty or tax or five thousand ringgit whichever is the greater amount, and for a second or any subsequent offence to a fine of not less than twenty times the customs or excise duty or tax or ten thousand ringgit whichever is the lesser amount and of not more than forty times the customs or excise duty or tax or ten thousand ringgit, whichever is the greater amount, or to imprisonment for a term not exceeding two years or to both such fine and imprisonment: Provided that when the value of the goods cannot be ascertained the penalty may amount to a fine not exceeding five thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES, PENALTIES, SEARCH, SEIZURE, ARREST AND PROVISIONS AS TO TRIALS AND PROCEEDINGS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Every person required by a proper officer of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "customs to give information or to produce documents on any subject which it is such officer's duty to enquire into and which it is in such person's power to give or produce shall be bound to give such information or to produce such documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Every omission or neglect to comply with, and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "every act done or attempted to be done contrary to the provisions of this Act or any regulations made thereunder shall be an offence and in respect of any such offence for which no penalty is expressly provided, the offender shall be liable on conviction to a fine not exceeding five thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Whoever attempts to commit any offence"
      },
      "schema:text": {
        "@language": "en",
        "@value": "punishable under this Act or any regulations made thereunder or abets the commission of such offence shall be punished with the punishment provided for such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Whenever it appears to any Magistrate on"
      },
      "schema:text": {
        "@language": "en",
        "@value": "information and after such enquiry as he may think necessary, that there is reasonable cause to believe that in any shop, warehouse or other building or place in a free zone, there are concealed or deposited any goods in respect of which an offence under the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975 or this Act or any regulations made thereunder had been committed, such Magistrate may issue' a warrant authorising an officer of customs, named therein, by day or by night and with or without assistance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to enter such shop, warehouse or other building or place and there to search for and seize any goods in respect of which there is reason to believe that the offence aforesaid has been committed, and any book or document which may reasonably be believed to have a bearing on the case;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to arrest any person or persons being in such shop, warehouse, building or place, possession of any goods aforesaid found, or whom such officer may reasonably suspect to have concealed or deposited such goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to break open, if necessary, any door of such shop, warehouse, building or place and enter thereinto;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to forcibly enter, if necessary, such place and every part thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to remove by force any obstruction to such entry, search, seizure and removal as he is empowered to effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "detain any person found in such place until such place has been searched."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Whenever it appears to any senior officer of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "customs that there is reasonable cause to believe that in any shop, warehouse or other building or place in a free zone, there are concealed or deposited any goods in respect of which an offence under the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975 or this Act or any regulations made thereunder has been committed, and if he has reasonable grounds for believing that by reason of any delay in obtaining a search warrant under section 21 such goods or any book or document, which may reasonably be believed to have a bearing on the case are likely to be removed, such officer may exercise in, upon and in respect of such shop, warehouse or other building or place all the powers mentioned in the said section 21 in as full and ample a manner as if he were authorised so to do by warrant issued under that"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of customs may stop and examine any vehicle in a free zone for the purpose of ascertaining whether any goods which may form the subject of an offence under the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975 or this Act or under any regulations made thereunder are contained therein, and the person in control or in charge of such vehicle shall if required so to do by such officer stop such vehicle and allow such officer to_ examine the same or move the vehicle to another place for examination, and shall not proceed until permission to do so has been given by such officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The person in control or in charge of any vehicle stopped for examination under subsection (1) shall if so requested by the officer of customs open all parts of the vehicle for examination by such officer and take all measures necessary to enable such examination as such officer considers necessary to be made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any proper officer of customs may in a free zone"
      },
      "schema:text": {
        "@language": "en",
        "@value": "examine any goods which are being taken into or being removed from a free zone or intended to be taken into or removed from a free zone and for the purpose of such examination direct the same to be brought to a customs office or a customs station and may open any package or receptacle."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any person landing, or being about to land, or"
      },
      "schema:text": {
        "@language": "en",
        "@value": "having recently landed in a free zone, from any vessel or aircraft, whether for the purpose of landing or otherwise, or entering or having recently entered a free zone by road or railway or leaving or about to leave a free zone in any vessel or aircraft, or by road or railway shall, if so requested by any proper officer of customs either permit his person, goods and baggage to be searched by such officer, or together with such goods and baggage accompany such officer to a customs office or customs station or police station and there permit his person, goods and baggage to be searched by an officer of customs: Provided that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "any person requesting that his person be searched in the presence of a senior officer of customs shall not be searched except in the presence of and under the supervision of such officer, and such person may be detained until the arrival of such officer or taken into any customs office or customs station or police station where such officer may be found;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "the goods and baggage of any person who requests to be present when they are searched and so present himself within a reasonable time shall not be searched except in his presence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "no female shall be searched except by a female officer of customs or police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "All goods in respect of which there has been, or there is a reasonable cause to believe that there has been committed any offence against, or any breach of, the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975 or this Act or any regulations made thereunder or any contravention of any restriction or condition subject to which any licence, permit or authorisation has been granted under any such law, together with any receptacle, baggage, package, vehicle, vessel (not exceeding one hundred and eighty two nett registered tonnes), or aircraft other than an aircraft engaged in international carriage, in which the same may be found or which is used in connection with such offence, breach or contravention, and any book or document which may be reasonably believed to have a bearing on the case, may be seized by any officer of customs in a free zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "All such goods and such receptacles, baggages, packages, vehicles, vessels or aircrafts shall, as soon as is practicable, be delivered into the care of a proper officer of customs whose duty it is to receive the same."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever any goods, receptacle, package, baggage, vehicle, vessel or aircraft is seized under this Act, the officer effecting the seizure shall forthwith give to the owner thereof, if known, notice in writing of such seizure and the reasons therefor, either by delivering such notice to him personally or by post at his place of abode, if known: Provided that such notice shall not be required to be given where such seizure is made on the person or in the presence of the offender or the owner or his agents, and, in the case of a vessel or an aircraft in the presence of the master or pilot, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section relating to the seizure of goods shall apply to all the contents of any package or receptacle seized and to any article used to conceal the same."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section relating to the seizure of any vessel or aircraft shall apply also to tackles, equipments and, furnishings of such vessel or aircraft."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section relating to the seizure of conveyances shall apply to all equipments thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where any movable property has been seized under this Act, a senior officer of customs may, at his discretion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "temporarily return the movable property to the owner or to the person from whose possession, custody or control it was seized, or to such person as the senior officer of customs may consider entitled thereto, subject to such terms and conditions as may be imposed and, in any case, subject to sufficient security being furnished to the satisfaction of the senior officer of customs that the movable property shall be surrendered to a senior officer of customs on demand and that the said terms and conditions, if any, shall be complied with; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "return the movable property to the owner or to the person from whose possession, custody or control it was seized, or to such person as the senior officer of customs may consider entitled thereto, with liberty for the person to whom the movable property is so returned to dispose of the same, such return being subject to security being furnished to the satisfaction of the senior officer of customs in an amount not less than an amount which, in the opinion of the senior officer of customs, represents—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the open market value of such property on the date on which it is so returned;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the customs duty payable in respect thereof; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any tax payable in respect thereof under any written law, for the payment of the amount so secured to the Director-General in the event of the court making an order for the forfeiture of such amount under section 39; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sell or destroy the movable property, as appropriate in the circumstances, where it is a living creature or where, in the opinion of the senior officer of customs, it is of a perishable or dangerous nature or likely to speedily deteriorate in quality or value, and where it is so sold, he shall hold the proceeds of sale pending the result of any prosecution or claim and in relation to such proceeds of sale to abide by the outcome of such prosecution or claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fails to surrender on demand to a senior officer of customs the movable property temporarily returned to him under paragraph (a) of subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with or contravenes any of the terms or conditions imposed under paragraph (a) of subsection (1), shall be guilty of an offence and shall, on conviction, be liable to imprisonment for a term not exceeding three years or to a fine not exceeding ten thousand ringgit or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The criminal liability of any person under subsection (2) shall be in addition to any other liability that the said person or any other person may incur under the terms and conditions relating to the return of the movable property under paragraph subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of subsection (2) shall not apply to such person, if any, who is the guarantor or surety of the person to whom the property is returned under paragraph (a) of subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, either generally or in any particular case or class of cases, give such direction to the Director-General as he may deem necessary or expedient with regard to the exercise of the powers conferred on a senior officer of customs under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be entitled to maintain any action on account of any act done or any decision taken by or on behalf of the Minister or by or on behalf of a senior officer of customs under this section, and no court shall have any jurisdiction to entertain any such action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any officer of customs may arrest in a free zone"
      },
      "schema:text": {
        "@language": "en",
        "@value": "without warrant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "any person found committing or attempting to commit, or employing or aiding any person to commit, or abetting the commission of an offence against this Act or any regulations made thereunder;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "any person whom he may reasonably suspect to have in his possession any goods liable to seizure under the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975, or this Act or any regulations made thereunder; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "any person against whom a reasonable suspicion exists that he had committed an offence against the Customs Act 1967, the Excise Act 1976, the Sales Tax Act 1972, the Service Tax Act 1975, or this Act or any regulations made thereunder, and may search, or cause to be searched, any person so arrested: Provided that no female shall be searched except by a female officer of customs or police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "An officer of customs making an arrest without warrant shall, without unnecessary delay and subject to the provisions of this Act, as to bail or previous release, take or send the person arrested before a Magistrates' Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "No officer of customs shall detain in custody a person arrested without a warrant for a longer period than under the circumstances of the case is reasonable; and such period shall not exceed twenty-four hours exclusive of the time necessary for the journey from the place of arrest to the Magistrates' Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "No person who has been arrested by an officer of customs shall be released except on his own bond or on bail or under a special order in writing by a Magistrate or a senior officer of customs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Prosecution in respect of offences committed"
      },
      "schema:text": {
        "@language": "en",
        "@value": "under—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "sections 5 and 8 may be conducted by a senior officer of customs or by any officer of customs specially authorised in writing in that behalf by the Director-General; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "any other provisions of this Act or any regulations made thereunder may be conduc- ted by an officer of the Authority, specially or generally authorised in writing in that behalf by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Except as hereinafter provided, no witness in any civil or criminal proceedings conducted pursuant to this Act shall be obliged or permitted to disclose the name or address of an informer or the substance of the information received from him or to state any matter which might lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If any book or document which is in evidence or liable to inspection in any civil or criminal proceedings whatsoever, contain any entry or passage in which any informer is named or described or which might lead to his discovery, the court shall cause all such entries or passages to be concealed from view or to be obliterated insofar only as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If on the trial for any offence against this Act or any regulations made thereunder the court, after full enquiry into the case, believes that the informer wilfully made in his complaint a material statement which he knew or believed to be false or did not believe to be true, or if in any other proceedings the court is of the opinion that justice cannot be fully done between the parties thereto without the discovery of the informer, it shall be lawful for the court to require the production of the original complaint, if in writing, and permit enquiry, and require full disclosure, concerning the informer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_32__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence against this Act or any regulations made thereunder has been committed by a company, firm, society or other body of persons, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the company, society or other body of persons, a partner or manager of the firm, or such other person purporting to act in such capacity or such person having charge or control of the company, firm, society or other body of persons shall be deemed to be guilty of that offence, unless he proves that the offence was committed without his consent or connivance and that he has exercised all such diligence to prevent the commission of the offence as he ought to have exercised, having regard to the nature of his functions in that capacity and to all the circumstances. (2) Where any person would be liable under this Act to any punishment, penalty or forfeiture for any act, omission, neglect or default he shall be liable to the same punishment, penalty or forfeiture for every such act, omission, neglect or default of any clerk, servant or agent, or of the clerk or servant of such agent provided that such act, omission, neglect or default was com- mitted by such clerk or servant in the course of his employment or by such agent when acting on behalf of such person or by the clerk or servant of such agent when acting in the course of his employment in such circumstances that had such act, omission, neglect or default been committed by the agent his principal would have been liable under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any senior officer of customs may compound any offence under this Act which is prescribed to be a compoundable offence by reguiring the person reasonably suspected of having committed an offence to pay a sum of money not exceeding five thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "On payment of such sum of money the person reasonably suspected of having committed an offence, if he is in custody, shall be discharged, and any property seized shall be released and no further proceedings shall be taken against such person or property, unless the property consists of goods the import of which into Malaysia is absolutely or conditionally prohibited under any written law and no import licence has been issued in which case such goods shall be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Government or the Authority, as the case may"
      },
      "schema:text": {
        "@language": "en",
        "@value": "be, shall not be liable to make good any loss sustained in respect of any goods by fire, theft, damage or any other cause while such goods are in any customs ware- house or in the lawful custody or control of any officer of customs or an employee of the Authority unless such loss is caused by the wilful neglect, or default of an officer of customs or of a person employed by the Government or the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "No officer of customs or other person employed by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the Government in connection with the customs shall be liable to make good any loss sustained in respect of any goods by fire, theft, damage or other cause while such goods are in any customs warehouse or in the lawful custody or control of such officer or any other officer of customs or person employed in connection with customs unless such loss is caused by his wilful neglect or default."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "No person shall in any proceedings before any"
      },
      "schema:text": {
        "@language": "en",
        "@value": "court in respect of the seizure of any goods seized in exercise or the purported exercise of any power conferred by this Act be entitled to the cost of such proceedings or to any damages or other relief except an order for the return of such goods or the payment of their value unless such seizure was made without reasonable or probable cause."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Nothing in this Act shall prevent any person from"
      },
      "schema:text": {
        "@language": "en",
        "@value": "being prosecuted under any written law for any act, omission, neglect or default which constitutes an offence under this Act or any regulations made thereunder, or from being liable under that written law to any punishment or penalty higher or otherwise than that provided by this Act or any regulations made thereunder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "All goods seized under this Act shall be liable to"
      },
      "schema:text": {
        "@language": "en",
        "@value": "forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "An order for the forfeiture or for the release of anything liable to forfeiture under the provisions of this Act shall be made by the Court before which the prosecution with regard thereto has been held, and an order for the forfeiture of goods shall be made if it is proved to the satisfaction of the Court that an offence against this Act or any regulations made thereunder has been committed and that the goods were the subject matter of, or were used in the commission of, the offence notwithstanding that no person may have been convicted of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The Court shall order the forfeiture of,—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of goods returned under paragraph (b) of subsection (1) of section 27 and subsequently disposed of by the owner or by the person to whom it was returned, the amount secured under that paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of goods sold pursuant paragraph (c) of subsection (1) of section 27, the amount realised by such sale, if it is proved to the satisfication of the Court that an offence against this Act or any regulations made thereunder has been committed and that the movable property in respect of which the amount was secured or realised by sale, as the case may be, was the subject matter of or, was used in the commission of, the offence notwithstanding that no person may have been convicted of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "All things forfeited shall be delivered to a proper officer of customs and shall be disposed of accordance with the directions of the Director-General,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "If there be no prosecution with regard to any goods seized under this Act, such goods shall be taken and deemed to be forfeited at the expiration of one calendar month from the date of seizure unless a claim thereto is made before that date in the manner hereinafter set forth."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any person asserting that he is the owner of such goods and that they are not liable to forfeiture may personally or by his agent authorised in writing give written notice to a senior officer of customs that he claims the same."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of such notice the senior officer of customs shall refer the claim to the Director-General who may direct that such goods be released or may direct such senior officer of customs, by information in the prescribed form, to refer the matter to the Magistrate of the First Class for his decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate of the First Class shall issue a summons requiring the person asserting that he is the owner of the goods and the person from whom they were seized to appear before him, and upon their appearance or default to appear, due service of such summons being proved, the Magistrate shall proceed to the examination of the matter and, on proof that an offence against this Act has been committed and that such goods were the subject matter, or used in the commission, of such offence, shall order the same to be forfeited, or may in the absence of such proof order their release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Free Zones Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on a date to be appointed by the Minister by notification in the Gazette and the Minister may prescribe different dates for the coming into force of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— \"activity\" includes commercial activity manufacturing activity and related operations; \"Authority\" means any statutory body or company or department of the Government of Malaysia or of any State in Malaysia which has been appointed under the provisions of subsection (2) of section 3 to administer, maintain and operate any free zone; \"commercial activity\" includes trading, breaking bulk, grading, repacking, relabelling and transit; \"customs duty\" means any duty imposed by or under the Customs Act 1967; \"excise duty\" means any duty imposed by or under the Excise Act 1976; \"free zone\" means any part of Malaysia declared under the provisions of subsection (1) of section 3 to be a free commercial zone or a free industrial zone; \"goods\" includes animals, birds, fish, plants and all kinds of movable property; \"Labuan\" shall have the same meaning assigned to it under section 154 of the Customs Act 1967; \"Langkawi\" shall have the same meaning assigned to it under section 163A of the Customs Act 1967; \"manufacture\" means the conversion by manual or mechanical means of organic or inorganic material into a new product by changing the size, shape, composition, nature or quality of such materials and includes the assembly of parts into a piece of machinery or other products, but does not include the installation of machinery or equipment for the purpose of construction; and the term \"manufacturing activity\" with its grammatical variations and cognate expression shall be construed accordingly and, in relation to such term, it shall include any activity as determined by the Director-General to be manufacturing activity: Provided that the Director-General may in his absolute discretion determine that the result of any manufacture or manufacturing activity is not a new product or article; \"Minister\" means the Minister for the time being charged with the responsibility for finance; \"operation\" means the operations set out under the activity approved by the Minister under the provisions of section 10; \"principal customs area\" means any part of Malaysia but excluding a free zone, Labuan and Langkawi; \"sales tax\" means any tax imposed by or under the Sales Tax Act 1972; \"service\" has the same meaning as assigned to the term \"prescribed service\" in the Service Tax Regulations 1975; \"service tax\" means any tax imposed by or under the Service Tax Act 1975; \"value\" in relation to imported goods, means the price which an importer would give for the goods on a purchase in the open market if the goods were delivered to him at the place of payment of customs duty and if freight, insurance, commission and all other costs, charges and expenses (except any customs duty and wharf handling, storage, removal mechanical equipment and other charges incurred in a free zone) incidental to the purchase and delivery at such place had been paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of the definition of the word \"value\", import means an import into a principal customs area from a free zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The expressions \"Director-General\", \"officer of customs\", \"senior officer of customs\", \"proper officer of customs\" and \"dutiable goods\" shall have the meaning assigned respectively to them in the Customs Act 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, declare any area in Malaysia to be a free commercial zone or a free industrial zone and every such notification shall define the limits of such zone."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint any statutory body established or constituted by or under a federal law or any department of the Government of Malaysia or with the consent of the State concerned, any statutory body established or constituted by or under a State law or any department of the Government of a State or, any company as the Authority to administer, maintain and operate any free zone which has been so declared under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/11/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
