      ],
      "schema:name": {
        "@language": "en",
        "@value": "Dangerous Drugs (Special Preventive Measures) (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Dangerous Drugs (Special Preventive Measures) (Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6 of the Dangerous Drugs (Special Preventive"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Measures) Act 1985, which is referred to in this Act as the \"principal Act\", is amended, in subsection (1), by deleting the words \"from the date of such order\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Section 6A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering section 6A as subsection (1) of section 6A; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after subsection (1), the following subsection: \"(2) No fresh detention order or fresh re- striction order referred to in subsection (2) of section 11s shall be invalid or inoperative by reason that no fresh report has been submitted under subsection (3) of section 3 and subsection (4) of section 5 or that that detention order or restriction order was made on the same ground as the previous detention order or restriction order.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (2) of section 6A of the principal Act, which has been inserted by subsection (1), shall be deemed to have been an integral part of that section as from the date of commencement of that section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 1 IB of the principal Act is amended, in subsection Amendment of section 11B. (2), by substituting for the words \"order or to give a fresh direction as is mentioned under subsection (1)\" the words \"detention order under subsection (1) of section 6 or a fresh restriction order under subsection (3) of section 6 or a fresh direction under subsection (1) of section 11A\". Validation of 5. (1) Where a detention order was made under subsection detention (1) of section 6 of the principal Act against any person during orders and the period between the commencement of the principal Act detentions, and indemnity. and the commencement of this Act (hereinafter referred to as the \"transitional period\"), the detention order and the deten- tion effected in pursuance thereof during the transitional period, and its continuation thereafter, if any, are hereby declared lawful and valid, and shall be deemed to be, and to have always and at all times been, lawful and valid, notwith- standing that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the period for which it was directed by that order that such person be detained commenced from a date other than the date on which the detention order was made; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the detention order was a fresh detention order made after the revocation of a previous detention order against such person. MEASURES) (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other legal proceeding whatsoever of any description or in any form shall be brought, instituted or maintained in any court on any ground after the commencement of this Act or, if brought or instituted before the commencement of this Act, shall continue to be main- tained, for or on account of, or in respect of, anything lawfully done in relation to the detention order or the detention declared lawful and valid under subsection (1), save that the provisions of this subsection shall not apply to any such legal proceeding which had concluded and the final decision of the court in respect of which had been given before the com- mencement of this Act, or to any appeal in respect of such final decision."
      }
    }
  ]
}
