      "schema:text": {
        "@language": "ms",
        "@value": "{Seksyen 2) Maksud Tajuk B. 28 Perbendaharaan B. 30 Peruntukan kepada Kumpulan Wang Terkanun JUMLAH 1,252,478,700"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/13/msa@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 3) Maksud Tajuk B. 7 Jabatan Perdana Menteri B. 14 Kementerian Perumahan dan Kerajaan Tempatan B. 17 Kementerian Bella dan Sukan B. 18 Kementerian Perasahaan Utama B. 27 Kementerian Luar Negeri B. 32 Jabatan Hasil Dalam Negeri B. 56 Jabatan Setiausaha Persekutuan Sabah B. 57 Jabatan Setiausaha Persekutuan Sarawak JUMLAH PERBEKALAN TAMBAHAN (1989 DAN 1990)"
      }
