      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysian Agricultural Research and Development Institute (Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/15/eng@/~cl_2",
