      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perhubungan Perusahaan (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perhubungan Perusahaan (Pindaan) 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta Perhubungan Perusahaan 1967, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan subseksyen (3) dengan yang berikut: \"(3) Any term or condition of employment, contained in a collective agreement, which is less favourable than or in contravention of the provisions of any written law applicable to workmen covered by the said collective agreement, shall be void and of no effect to that extent and the provisions of such written law shall be substituted therefor.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 27 Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja perkataan-perkataan \"appear himself personally\" dalam perenggan (c) subseksyen (1), perkataan- perkataan \"or where he is a member of a trade union of workmen, be represented by an officer or employee of the trade union\"."
      }
    }
  ]
