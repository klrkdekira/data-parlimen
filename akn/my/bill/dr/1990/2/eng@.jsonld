      ],
      "schema:name": {
        "@language": "en",
        "@value": "Pertubuhan Berita Nasional Malaysia (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Pertubuhan Berita Nasional Malaysia (Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The second paragraph of the preamble to the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Pertubuhan Berita Nasional Malaysia Act 1967, which in this Act is referred to as \"the principal Act\", is amended by deleting the words \"non-profit making\" and \"and be guided by the declarations of the United Nations Conference on Freedom of Information of 1948\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop appearing at the end of the definition of \"Minister\" a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after the definition of \"Minister\", the following new definition: ' \"news or news material\" international, regional and national—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "news;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "photographs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "features; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "economic, commodity and financial data, in whatever form or manner.'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following: \"(3) Bernama shall have the exclusive right to receive into the Federation, news or news material from foreign news agencies and other organisations dealing with the news or news material, through such arrangements as subscription, payment, news exchange or other means.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after subsection (3), the following new subsections (4) and (5): \"(4) Bernama shall arrange for the distribution of the news or news material received pursuant to subsection (3) to subscribers in the Federation, on such terms or conditions as shall be prescribed by Bernama. (5) Subsections (3) and (4) shall not prejudice the right of the Department responsible for broadcasting, and any organisation approved by the Minister from time to time, to receive, without reference whatsoever to Bernama, visual news and programme materials directly from any source outside the Federation.\". (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting, New immediately after section 3, the following new section section3A 3A: \"Power 3A. Bernama, with the approval of the to enter Minister and the concurrence of the Minister into any of Finance, may— arrangement for sharing of profits, (a) enter into any arrangement for sharing etc. of profits, union of interests, co- operation or joint-venture with any person or body of persons; or (b) establish or promote the establishment and expansion of companies under the Act 125. Companies Act 1965.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 4 of the principal Act is amended by deleting.,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the words \"information,\" and \"or features\" appearing ' in paragraphs (a) and (b) of subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 7 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for paragraph (d) of subsection (1) the following: \"(d) the Vice-Chancellor of any one of the Universities in the Federation; and\"."
      }
    }
  ]
}
