      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pertubuhan Berita Nasional Malaysia (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pertubuhan Berita Nasional Malaysia (Pindaan) 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan kedua mukadimah Akta Pertubuhan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Berita Nasional Malaysia 1967, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan memotong perkataan-perkataan \"yang bukan-nya mendapat keuntongan\" dan \"serta berpandukan perishtiharan2 Persidangan Bangsa2 Bersatu mengenai Kebebasan Penerangan tahun 1948\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan, sebelum sahaja takrif \"Merited\", takrif baru yang berikut: ' \"berita atau bahan berita\" termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berita;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "fotograf;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "rencana; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "data ekonomi, komoditi dan kewangan, antarabangsa, serantau dan kebangsaan, dalam apa-apa jua bentuk atau cara;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan yang berikut: \"(3) Bernama hendaklah mempunyai hak eksklusif untuk menerima masuk ke dalam Persekutuan berita atau bahan berita daripada agensi berita luar negeri dan pertubuhan-pertubuhan lain yang berurusan dengan berita atau bahan berita, melalui apa-apa perkiraan seperti langganan, pembayaran, pertukaran berita atau lain- lain cara.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja subseksyen (3), subseksyen baru (4) dan (5) yang berikut: \"(4) Bernama hendaklah membuat perkiraan bagi membahagi-bahagikan berita atau bahan berita yang diterima menurut subseksyen (3) kepada pelanggan- pelanggan di Persekutuan, mengikut apa- apa terma dan syarat sebagaimana yang ditetapkan oleh Bernama. (5) Subseksyen (3) dan (4) tidak menjejaskan hak Jabatan yang bertanggungjawab bagi penyiaran, dan mana-mana pertubuhan yang diluluskan oleh Menteri dari semasa ke semasa, untuk menerima, tanpa apa-apa jua pun rujukan kepada Bernama, berita tampak dan bahan- bahan rancangan secara terus daripada mana-mana sumber di luar Persekutuan.\". (PINDAAN)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja seksyen 3, seksyen baru 3A yang berikut: \"Kuasa 3A. Bernama, dengan kelulusan Menteri dan membuat persetujuan Menteri Kewangan, boleh— apa-apa perkiraan (a) membuat apa-apa perkiraan untuk untuk berkongsi berkongsi keuntungan, menyatukan keuntungan kepentingan-kepentingan, dsb. sama atau berusahasama dengan mana- mana orang atau kumpulan orang; atau (b) menubuhkan atau menggalakkan penubuhan dan pengembangan Aha 125. syarikat-syarikat di bawah Akta Syarikat 1965.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_6__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"ma'aluniat, berita, bahan2 berita atau renchana2 berita\" dalam perenggan (a) dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen (1) dengan perkataan-perkataan \"berita atau bahan berita\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perenggan (d) subseksyen (1) dengan yang berikut: \"(d) Naib-Canselor mana-mana satu Universiti dalam Persekutuan; dan\"."
      }
    }
  ]
}
