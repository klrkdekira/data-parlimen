    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Port Authorities (Amend-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "ment) Act 1990 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_10",
