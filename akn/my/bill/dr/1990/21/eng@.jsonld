        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the principal Act is amended—"
      }
    },
    {
