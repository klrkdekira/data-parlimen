      "schema:name": {
        "@language": "en",
        "@value": "Section 29O of the principal Act is amended by sub-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "stituting for the words \"two thousand dollars\" in subsection (2) the words \"five thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_12",
      "@type": "akn:clause",
