      "schema:name": {
        "@language": "en",
        "@value": "Section 31 of the principal Act is amended by substituting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "for the words \"five hundred dollars\" the words \"two thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_13",
      "@type": "akn:clause",
