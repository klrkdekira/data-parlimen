      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (h) of subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
