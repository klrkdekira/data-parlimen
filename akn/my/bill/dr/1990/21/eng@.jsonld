      },
      "schema:text": {
        "@language": "en",
        "@value": "(a} by inserting after the words \"authority pilot\" in subsection (1) the words \"or an employee licensed under section 29cA (1) of a licensed operator\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_17__para_b",
