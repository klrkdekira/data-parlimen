      "schema:name": {
        "@language": "en",
        "@value": "Section 32 of the principal Act is amended by sub-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "stituting for the words \"five hundred dollars\" in subsections (2) and (4) the words \"two thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "34 the following new section 34A: 34A. Any person who hinders or obstructs any member, officer or servant of the authority in the performance or execution of his duty or in carrying out anything which he is empowered or required to do by virtue of or in consequence of this Act shall be guilty of an offence under this Act and shall be liable on conviction to a fine not exceeding one thousand ringgit or to imprison- ment for a term not exceeding six months or to both such fine and imprisonment.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_15",
      "@type": "akn:clause",
