      "schema:name": {
        "@language": "en",
        "@value": "Section 36 of the principal Act is amended by sub-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "stituting for the words \"one thousand dollars\" the words \"two thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
