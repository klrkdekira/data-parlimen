      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29M of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "29M."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"under section\" in subsection (1) the words \"29CA (1) or\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"29H (1)\" in subsection (1) the words \"or the authorisation given by the authority to any person to pilot vessels passing through a pilotage district pursuant to section 29CB (2)\""
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_11",
      "@type": "akn:clause",
