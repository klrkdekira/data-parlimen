        "@value": "by substituting for the words \"Accounts and audit\" in the marginal note the words \"Accounts and records to be open for inspection\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/21/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
