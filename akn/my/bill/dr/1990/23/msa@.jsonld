      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 78 Akta ibu adalah dipinda dengan memasukkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahajaperkataan-perkataan \"charges leviable thereon\" dalam subseksyen (2) perkataan-perkataan \"within fourteen days of such declaration\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_11",
      "@type": "akn:clause",
