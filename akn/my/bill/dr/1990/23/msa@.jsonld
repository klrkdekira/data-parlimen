      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 142 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (34), perenggan baru (35) yang berikut: \"(35) to regulate the conduct of all matters relating to duty free shops;\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula perenggan (35) yang sedia ada sebagai perenggan (36)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahajatakrif'dutiable goods\", takrif baru yang berikut: ' \"duty free shop\" means any place licensed for the warehousing and sale of dutiable goods free of duty under section 65D;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_2__para_b",
