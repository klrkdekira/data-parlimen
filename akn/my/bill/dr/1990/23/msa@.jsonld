        "@language": "ms",
        "@value": "Seksyen 131 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_18__para_a",
