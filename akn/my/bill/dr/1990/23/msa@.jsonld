      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen itu sebagai \"17. (1)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas sahaja itu subseksyen baru (2) yang berikut: \"(2) Where any amount is payable in accordance with subsection (1) the Director General may allow the amount to be paid by instalments in such amounts and on such dates as he may determine.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 18 Akta ibu adalah dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perkataan-perkataan \"by unavoidable accident, lost, damaged or destroyed\" dalam subseksyen (1) dengan perkataan- perkataan \"damaged, destroyed, or by unavoidable accident, lost\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 44 Akta ibu adalah dipinda dengan memotong"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perkataan-perkataan \"the President of a Sessions Court in West Malaysia or\" dan perkataan-perkataan \"in the States of Sabah and Sarawak\" dalam subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 55 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"one\" di baris keenam subseksyen (2) dengan perkataan \"five\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"one\" di baris akhir subseksyen (2) dengan perkataan \"two\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan-perkataan \"a Sessions Court in West Malaysia or\" dan perkataan-perkataan \"in Sabah and Sarawak\" dalam subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan, selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sahaja seksyen 65c, seksyen baru 65o dan 65E yang berikut: \"Licensing 65D (1) The Director General may at his absolute of duly free discretion on payment of such fee as may be shop. prescribed, grant a licence to operate a duty free shop to any person, hereinafter in this section referred to as \"the licensee\", and when granted, may suspend or withdraw such licence. (2) Any such licence shall be for such period and subject to such conditions as the Director General in each case may specify in the licence. (3) The licensee shall, for the proper conduct of his business, furnish such security as may be required by the Director General. (4) If it appears at any time that any goods have been sold or removed from such duty free shop otherwise than in accordance with all the conditions of a licence granted under this section, the licensee of such duty free shop shall, in the absence of proof to the contrary, be presumed to have illegally removed such goods and shall, without prejudice to any proceedings under this Act, be liable to pay to the proper officer of customs the customs duty leviable on the goods sold or removed. 65E. (1) The Director General may at his absolute discretion on payment of such fee as may be prescribed, grant a licence to operate an inland clearance depot to any person, hereinafter in this section referred to as \"the licensee\", and when granted,-may suspend or withdraw such licence. (2) Any such licence shall be for such period and subject to such conditions as the Director General in each case may specify in the licence. (3) The licensee shall, for the proper conduct of his business, furnish such security as may be required by the Director General. (4) If it appears at any time that in any inland clearance depot there is a deficiency in the quantity of dutiable goods which ought to be found therein, the licensee of such inland clearance depot shall, in the absence of proof to the contrary, be presumed to have illegally removed such goods and shall, without prejudice to any proceedings under this Act, be liable to pay to the proper officer of customs the customs duty leviable on the goods found deficient: Provided that if it is shown to the satisfaction of the Director General that such deficiency has been caused by any leakage, breakage or other unavoidable accident, the Director General may remit the whole or any part of the customs duty leviable on the goods found deficient.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 66 Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja subseksyen (4), subseksyen baru (5) yang berikut: \"(5) Notwithstanding anything contained in sub- section (1), if the Director General is of the opinion that having regard to any particular goods imported into Malaysia it would be in the public interest not to require such goods to be deposited by the importer or his agent in accordance with the said subsection, he may direct such goods to be released subject to such conditions as he may impose.\"."
      }
    }
  ]
}
