      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/23/msa@/~cl_20",
      "@type": "akn:clause",
