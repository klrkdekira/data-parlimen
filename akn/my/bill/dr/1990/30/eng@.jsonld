        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/30/eng@/~part_II__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/30/eng@/~part_II__cl_13"
      ],
