      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_III__cl_6__subpara_A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Kawasan Pembangunan Bersama hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kawasan yang disempadani oleh garis-garis yang menyambungkan titik-titik koordinat berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_III__cl_6__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "U6°50'.0 T 102°21'.2 (B) U7°10'.25 T 102°29'.0 (C) U T 49'.0 T 103° 02'.5 (D) U 7° 22'.0 T 103° 42'.5 (E) U 7° 20'.0 T 103° 39'.0 (F) U7°03'.0 T 103 06'.0 (G) U6 53'.0 T 102°34'.0 dan yang ditunjukkan dalam bahagian yang relevan Carta Admiralti British No. 2414, Edisi 1967, yang reproduksinya adalah seperti dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dengan ini ditubuhkan suatu badan dengan nama Pihak Berkuasa Bersama Malaysia- Thailand (yang disebut \"Pihak Berkuasa Bersama\" dalam Akta ini)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Bersama hendaklah mempunyai personaliti juristik dan hendaklah berdomisil di Malaysia dan Thailand."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Bersama hendaklah menjadi suatu pertubuhan perbadanan dan, tertakluk kepada dan bagi maksud-maksud Akta ini, boleh membuat kontrak, dan boleh memperolehi, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih dan tak alih, tidak termasuk tanah, dan boleh memindahhak, menyerahhak, menyerahkan, menggadai, menggadaijanji, menyerahhak semula, memindahmilik atau selainnya melupuskan, atau memperlakukan, apa-apa harta alih atau harta tak alih atau apa-apa kepentingan di dalamnya yang terletakhak pada Pihak Berkuasa Bersama mengikut apa-apa terma yang difikirkannya sesuai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Bersama hendaklah mempunyai apa-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "apa kuasa dan melaksanakan apa-apa fungsi yang perlu bagi perlaksanaan tugas-tugasnya dan penikmatan hak- hak dan keistimewaan-keistimewaannya di bawah, dan setakat yang tidak tak konsisten dengan, Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Bersama dengan ini diletakhakkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dengan dan memegang hak-hak, kuasa-kuasa, kebebasan- kebebasan dan keistimewaan-keistimewaan eksklusif untuk mencarigali dan mengeksploitasikan sumber- sumber alam, khususnya petroleum, dalam Kawasan Pembangunan Bersama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IV__cl_7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "ROYALTI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IV__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Bersama hendaklah membayar kepada setiap satu daripada Kerajaan-Kerajaan royalti sebanyak lima peratus daripada pengeluaran kasar petroleum, mengikut cara dan pada masa-masa yang ditetapkan melalui peraturan-peraturan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEGAWAI-PEGAWAI DAN BIDANG KUASA MAHKAMAH-MAHKAMAH"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana anggota Pihak Berkuasa Bersama atau"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai, pengkhidmat atau ejen Pihak Berkuasa Bersama hendaklah disifatkan pengkhidmat awam mengikut pengertian Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam mana-mana undang-undang bertulis lain berlawanan, Mahkamah Sesyen hendaklah mempunyai bidang kuasa untuk membicarakan apa-apa kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawahnya dan, apabila disabitkan, untuk mengenakan penalti penuh yang ditetapkan baginya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_IX__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud menjalankan bidang kuasa ke atas apa-apa kesalahan yang dilakukan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah seksyen 15, subseksyen (2), dan perenggan (b) dan (d) subseksyen (6), seksyen 18 hendaklah terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pihak Ber- kuasa Bersama Malaysia-Thailand 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_2__subpara_A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"garis pembahagi bidang kuasa\" ertinya garis Jurus yang menyambungkan titik-titik koordinat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_2__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "U6°50'.0 T 102°21'.2; (X) U7 35',0 T 103° 23'.0 yang membahagikan bidang kuasa sivil dan jenayah dalam Kawasan Pembangunan Bersama; \"Kawasan Pembangunan Bersama\" ertinya kawasan tertentu di pelantar benua Malaysia dan Thailand di Teluk Siam yang diperihalkan di bawah seksyen 6; \"Kerajaan-Kerajaan\" ertinya Kerajaan Malaysia dan Kerajaan Thailand; \"Kumpulan Wang\" ertinya Kumpulan Wang Pihak Berkuasa Bersama Malaysia-Thailand yang disebut di bawah seksyen 9; \"Memorandum Persefahaman, 1979\" Memorandum Persefahaman di antara Malaysia dengan Thailand mengenai Penubuhan suatu Pihak Berkuasa Bersama bagi Mengeksploitasikan Sumber-Sumber Dasar Laut dalam Kawasan Tertentu di Pelantar Benua Kedua- dua Negara di Teluk Siam, yang ditandatangani pada 21 Februari, 1979; \"Menteri\" ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi petroleum; \"Perjanjian\" ertinya Perjanjian mengenai Perlembagaan dan Perkara-Perkara Lain yang Berhubungan dengan Penubuhan Pihak Berkuasa Bersama Malaysia-Thailand yang ditandatangani oleh Kerajaan Malaysia dan Kerajaan Thailand pada 30 Mei 1990, di Kuala Lumpur, Malaysia; \"petroleum\" ertinya apa-apa minyak mineral atau hidrokarbon relatif dan gas asli yang terdapat dalam keadaan semula jadinya dan spirit petroleum kepala selongsong, termasuk syal bitumin dan longgokan- longgokan berstrata lain yang daripadanya minyak boleh didapati; MALAYSIA-THAILAND \"Pihak Berkuasa Bersama\" ertinya Pihak Berkuasa Bersama Malaysia-Thailand; \"sumber-sumber alam\" ertinya apa-apa sumber alam tak hidup termasuk apa-apa mineral, minyak mineral dan logam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/34/msa@/~part_V",
      "@type": "akn:part",
