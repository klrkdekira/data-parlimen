      "schema:name": {
        "@language": "en",
        "@value": "Entertainments Duty (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Entertainments Duty"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Entertainments Duty Act 1953, which in this Act is referred to as the \"principal Act\", is amended by substitu- ting for subsection (1) of section 12 the following: \"(1) The Minister of Finance may by order published in the Gazette exempt, subject to such conditions as he may deem fit to impose,—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any class of entertainments; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of the Federal Territories of Kuala Lumpur and Labuan, any entertainment, from the payment of entertainments duty.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "All exemption orders purported to have been made under subsection (1) of section 12 during the period between the 3rd May 1982 and the date of commencement of this Act are hereby validated and deemed to have been lawfully made, and all entertainments exempted from the payment of enter- tainments duty under such orders are hereby deemed to have been lawfully exempted, pursuant to subsection (1) of section 12 of the principal Act as amended by subsection (1) of this section, as if the said subsection (1) had been in force when the orders were made and the entertainments were exempted. BILL"
      }
    }
  ]
}
