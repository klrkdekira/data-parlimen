      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1989 and 1990) (No. 2) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/37/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
