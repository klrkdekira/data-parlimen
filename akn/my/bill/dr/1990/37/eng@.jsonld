      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/37/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding three hundred and seventy seven million two hundred and five thousand and six hundred ringgit ($377,205,600) from the Consolidated Fund for expenditure on the services specified in the Second Schedule for the service of the year 1990, not provided for or not fully provided BILL Act A744. for by the Supply Act 1990 and the Supplementary Act A773 Supply (1989 and 1990) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/37/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
