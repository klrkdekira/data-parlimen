      "schema:name": {
        "@language": "en",
        "@value": "Trade Unions (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Trade Unions (Amendment)"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act 1990 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 27 of the Trade Unions Act 1959 is amended in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (b) a colon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after paragraph (b), the following new proviso: \"Provided that any such trade union may, after obtaining the written approval of the Minister, affiliate with are gistered federation of trade unions comprising trade unions of public officers.\"."
      }
    }
  ]
