      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 27 Akta Kesatuan Sekerja 1959 adalah dipinda"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di akhir perenggan (b) dengan noktah bertindih; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/38/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (b), proviso baru yang berikut: \"Provided that any such trade union may, after obtaining the written approval of the Minister, affiliate with a registered federation of trade unions comprising trade unions of public officers.\". RANG UNDANG-UNDANG 2"
      }
