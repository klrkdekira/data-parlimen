      "schema:name": {
        "@language": "en",
        "@value": "Section 23 of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"who\" in subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting, in subsection (2), for the word \"11(a)\" the words \"11(a)(i) or 11(b)(i)\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/39/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following new subsection (3): \"(3) In respect of retirement under section 11 (b)(i), subsection (2) shall apply only to officers appointed to the public service after the com- mencement of this subsection.\"."
      }
    }
