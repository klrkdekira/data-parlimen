      "schema:name": {
        "@language": "en",
        "@value": "Medicines (Advertisement and Sale) (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Medicines"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Advertisement and Sale) (Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the Medicines (Advertisement and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Sale) Act 1956, which in this Act is referred to as the \"principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word \"circular,\" in the definition of \"advertisement\" the words \"report, commentary,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"registered\" in the definition of \"authorized officer\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Poisons List\" the following definition: \"private hospital\" means a hospital registered under the Private Act 43. Hospitals Act 1971;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended, in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"as a medicine\" the words \", an appliance or a remedy\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the colon at the end of paragraph (c) a semicolon and by inserting after that paragraph the following paragraph: \"(d) diagnosis of a disease as specified in the Schedule:\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 4A of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting therefor the following section: 4A. Subject to this Act, no person shall take part in the publication of any advertisement— (a) which refers to any skill or service relating to the treatment, prevention or diagnosis of any ailment, disease, injury, infirmity or condition affecting the human body; and (b) which is capable of inducing, or which contains an invitation, whether express of implied, to, any person to seek the advice of the advertiser or any person referred to in the advertisement in connection with such skill or service: Provided that this section shall not apply to any advertisement published— (aa) with the approval of the Minister, by any professional body related to the medical profession or to any other allied profession which is established by or registered under any written law; or (bb) with the approval of the Medicine Advertisements Board established by the Minister, by any private hospital or by any— (i) private clinic; (ii) private radiological clinic; (AMENDMENT) (iii) private medical laboratory, operated by a registered medical practitioner having a valid annual practising certificate under Medical Act 1971.\". Act 50."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 4B of the principal Act is amended, in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"as a medicine\" the words \", an appliance or a remedy\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"established for this purpose by the Minister\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6A of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "deleting the word \"registered\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6s of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "numbering the existing section as subsection (1) of section 6B and by inserting thereafter the following subsections: \"(2) An authorized officer making an vestigation under this Act may by order in writing require the attendance before himself of any person who from information given or otherwise appears to be acquainted with the circumstances of the case, and such person shall attend as so required: Provided that no person shall be required under this section to perform a journey of more than twelve kilometres from his usual place of abode exclusive of such portion of the journey as may be performed by train or motor car or other vehicle. (3) If any person refuses to attend as so required by an order issued under subsection (2), the authorized officer who issued such order may report such refusal to a Magistrate who may thereupon in his discretion issue a warrant to secure the attendance of such person as required by such order.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6F of the principal Act is amended in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "subsection (2) by substituting for the words \"registered pharmacist in the public service authorized in writing by the Public Prosecutor\" the words \"authorized officer\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 7 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by inserting after the words \"purpose of the words \"section 4A and\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/4/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by inserting after the words \"approval under\" the words \"section 4A and\"."
      }
    }
  ]
