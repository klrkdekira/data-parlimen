      ],
      "schema:name": {
        "@language": "en",
        "@value": "Fire Services (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Fire Services (Amendment) Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the Fire Services Act 1988, which in this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "is referred to as \"the principal Act\", is amended by inserting before the definition of \"contravention\" the following new definition: ' \"Committee\" means the Fire Services Department Welfare Fund Committee established under section 48A;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 48 of the principal Act is amended in subsection"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(2)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"and\" at the end of paragraph (e); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (f) the words \"; and\" and inserting thereafter the following new paragraph (g): \"(g) all sums of monies contributed by the Government.\". BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "48A. 48 the following new section 48A: \"Fire 48A. (1) There shall be established a Fire Services Services Department Welfare Fund Committee which shall Department Welfare have the control of the Fund. Fund Committee. (2) The Committee shall consist of following members: (a) the Director-General as Chairman; (b) two Senior Fire Officers to be appointed by the Minister; and (c) two public officers to be appointed by the Minister. (3) No meeting of the Committee shall be held in the absence of the Director-General. (4) The quorum for meetings of the Committee shall be three, (5) Subject to this Act, the Committee shall have power to regulate its proceedings.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Control of Fund.\" in the marginal note the words \"Administration and application of Fund,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/41/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"controlled by the Director-General, subject to\" the words \"adminis- tered in accordance with\"."
      }
    }
  ]
}
