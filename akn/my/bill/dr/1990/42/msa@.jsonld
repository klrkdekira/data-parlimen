      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang (Memperbadankan) Majlis Daya Pengeluaran Negara (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perbadankan) Majlis Daya Pengeluaran Negara (Pindaan) 1990 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja per- kataan \"bayaran\", koma dan perkataan- perkataan \"komisen-komisen atau apa-apa balasan lain\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan-perkataan \"oleh Pusat\" dengan perkataan \"olehnya\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan-perkataan \"Pusat Daya Pengeluaran Negara\" dalam subseksyen (1) dengan perkataan-perkataan \"Perbadanan Produktiviti Negara\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan-perkataan \"atau kapada Pusat\" dalam perenggan (h) sub- seksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Pusat\" dalam subseksyen (1) dengan perkataan \"Perbadanan\". (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PINDAAN)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja seksyen 14, seksyen bam 14A yang berikut: \"Akta 14A. Akta Badan Berkanun (Akaun dan Badan Laporan Tahunan) 1980 hendaklah terpakai Berkanun bagi Perbadanan.\". (Akaun dan Laporan Tahunan) 1980 terpakai. Akta 240."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja per- kataan \"ahli\" dalam subseksyen (1), koma dan perkataan-perkataan \"pegawai-pegawai dan kakitangan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan-perkataan \"dan pegawai2 dan kakitangan Pusat,\" dalam subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas perkataan \"ahli\" dalam subseksyen perkataan-perkataan \"atau pegawai atau kakitangan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan-perkataan \", atau pegawai atau kakitangan Pusat\" dalam subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta (Memperbadankan) Majlis Daya Pengeluaran Negara 1966 bolehlah, apabila mula berkuatkuasanya Akta ini, dinamakan Akta (Memperbadankan) Perbadanan Produktiviti Negara 1966."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta (Memperbadankan) Majlis Daya Pengeluaran Negara 1966, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan perkataan-perkataan \"Majlis Daya Pengeluaran Negara\" atau \"Majlis\" di mana-mana jua terdapat masing-masingnya dengan perkataan-perkataan \"Perbadanan Produktiviti Negara\" \"Perbadanan\". RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengarah Pusat yang dilantik di bawah seksyen 5 Akta ibu hendaklah, selepas mula berkuatkuasanya Akta ini, dikenali sebagai \"Ketua Pengarah\" dan segala sebutan mengenai \"Pengarah\" atau \"Pengarah Pusat\" dalam mana- mana undang-undang bertulis hendaklah ditafsirkan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pertukaran nama yang diperuntukkan oleh subseksyen (1) dan (2) tidaklah menyentuh mana-mana hak atau obligasi Majlis atau mencacatkan apa-apa prosiding undang-undang oleh atau terhadapnya; dan mana-mana prosiding undang-undang yang boleh diteruskan atau dimulakan oleh atau terhadapnya sebelum mula berkuatkuasanya Akta ini bolehlah diteruskan atau dimulakan di bawah nama barunya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2 dengan yang berikut: \"Tafsiran. 2. Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain— \"Ketua Pengarah\" ertinya pegawai eksekutif yang dilantik di bawah seksyen 5 (1); \"Menteri\" ertinya Menteri yang diper- tanggungkan dengan tanggungjawab bagi pembangunan perindustrian; \"Perbadanan\" ertinya Perbadanan Pro- duktiviti Negara yang ditubuhkan di bawah seksyen 3 (1).\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu adalah dipinda—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "fa) dengan menggantikan perkataan-perkataan \"Kementerian Perdagangan dan Perindustrian\" dalam perenggan (c) subseksyen (3) dengan perkataan-perkataan \"Kementerian Perdagangan Antarabangsa dan Industri yang hendaklah menjadi Timbalan Pengerusi\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan-perkataan \"Kementerian Buroh dan Tenaga Rakyat\" dalam perenggan (e) subseksyen (3) dengan perkataan- perkataan \"Kementerian Sumber Manusia\"; (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PtNDAAN)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (i) sub- seksyen (3) dengan yang berikut: \"(i) sekurang-kurangnya tiga orang tetapi tidak lebih daripada tujuh orang wakil daripada sektor swasta;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas sahaja perenggan (i) subseksyen (3) perenggan baru (j) dan (k) yang berikut: \"(j) seorang wakil daripada persatuan majikan; dan (k) seorang wakil daripada mana-mana persatuan yang mewakili pekerja- pekerja.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (5) dengan yang berikut: \"(5) Ahli-ahli yang tersebut dalam subseksyen (3) boleh melantik daripada kalangan mereka Pengerusi sementara untuk mempengerusikan apa-apa mesyuarat Perbadanan semasa Pengerusi Timbalan Pengerusi tidak berupaya bagi sementara kerana sakit atau tidak ada bagi sementara dalam Malaysia.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja per- kataan \"tempoh\" yang mula-mula terdapat dalam subseksyen (6), perkataan-perkataan \"yang tidak melebihi tiga tahun\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong proviso kepada subseksyen (6); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah bertindih yang terdapat di akhir subseksyen (6) dengan noktah. RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja seksyen 3, seksyen baru 3A yang berikut: 3A. (1) Menteri hendaklah, berkenaan dengan setiap ahli Perbadanan yang dinyatakan dalam seksyen 3 (3) (c) hingga (g), melantik satu orang daripada Kementerian atau jabatan yang sama dengan ahli itu menjadi ahli silih ganti untuk menghadiri mesyuarat-mesyuarat Perbadanan, meng- gantikan ahli itu, yang tidak dapat di- hadiri oleh ahli itu kerana apa-apa sebab. (2) Apabila menghadiri mesyuarat- mesyuarat Perbadanan, ahli silih ganti hendaklah disifatkan sebagai ahli Perbadanan bagi segala maksud. (3) Ahli silih ganti hendaklah berhenti daripada menjadi ahli silih ganti, melainkan jika dia menghentikan keahliannya terlebih dahulu, atau perlantikannya dibatalkan terlebih dahulu, apabila ahli yang baginya dia menjadi ahli silih ganti berhenti menjadi ahli.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dan nota birai kepada seksyen 5 dengan yang berikut: \"Perlantikan 5. (1) Perbadanan— Lembaga Pengurusan (a) hendaklah, dengan persetu- dan pegawai- juan Menteri, melantik se- pegawai lain. orang pegawai eksekutif yang akan menjadi Ketua Pengarah; (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PINDAAN) (b) boleh melantik mana-mana pegawai lain sebagaimana yang perlu atas terma-terma dan syarat-syarat yang difikir- kannya patut, sebagai anggota Lembaga Pengu- rusan yang hendaklah bertanggung- jawab bagi pentadbiran dan pe- ngurusan harian hal-ehwal Per- badanan dan yang hendaklah melaksanakan kewajipan-kewajipan dan menjalankan kuasa-kuasa se- bagaimana yang diwakilkan ke- padanya oleh Perbadanan.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja subseksyen (1), subseksyen baru (1A) yang berikut: \"(1A) Perbadanan boleh melantik, atas terma-terma dan syarat-syarat sebagaimana yang difikirkannya patut, pegawai-pegawai dan kakitangan lain sebagaimana yang difikirkannya perlu bagi melaksanakan maksud-maksud Akta ini.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di akhir perenggan (d) subseksyen (2) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (d) subseksyen (2), perenggan baru"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berikut: \"(e) bagi tatatertib pegawai-pegawai dan kakitangan yang boleh mengandungi— (i) peruntukan-peruntukan me- ngenai tahanan kerja dengan pengurangan gaji atau saraan lain, atau bagi penggantungan kerja tanpa gaji atau saraan RANG UNDANG-UNDANG lain, seseorang pegawai atau kakitangan sementara menanti prosiding tatatertib selesai; (ii) pewujudan apa-apa kesalahan tatatertib dan pengadaan peruntukan mengenai huku- man-hukuman tatatertib se- bagaimana yang difikirkan sesuai oleh Perbadanan, dan hukuman-hukuman yang di- peruntukkan sedemikian boleh meliputi pembuangan kerja atau penurunan pangkat; dan (iii) prosedur bagi prosiding tata- tertib, yang sepatutnya mem- berikan peluang bagi rep- resentasi dibuat oleh pe- gawai atau kakitangan yang terhadapnya prosiding tata- tertib telah diambil sebelum sesuatu keputusan dicapai oleh pihak berkuasa tatatertib atas pertuduhan tatatertib yang akan dikenakan terhadap pe- gawai atau kakitangan itu.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja seksyen 5, seksyen baru 5A dan 5B yang 5A. (1) Maka hendaklah ada suatu Jawatankuasa Tatatertib Perbadanan yang hendaklah terdiri daripada— (a) dua orang ahli yang hendaklah dipilih oleh dan daripada ahli-ahli Per- badanan, seorang daripadanya hendaklah dipilih sebagai pengerusi; (b) Ketua Pengarah yang dilantik di bawah seksyen 5 (1). (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PINDAAN) (2) Pihak berkuasa tatatertib berkenaan dengan tiap-tiap pegawai dan kakitangan Perbadanan selain daripada Ketua Pengarah ialah Jawatankuasa Tatatertib Perbadanan yang ditubuhkan di bawah subseksyen (1). (3) Jawatankuasa Tatatertib berkenaan dengan Ketua Pengarah hendaklah terdiri daripada Pengerusi Perbadanan sebagai pengerusi dan dua orang ahli yang hendaklah dipilih oleh dan daripada ahli-ahli Per- badanan. (4) Ketua Pengarah tidak boleh menjadi ahli Jawatankuasa Tatatertib dalam mana- mana prosiding yang di hadapannya dia menjadi pengadu; tempatnya hendaklah diambil oleh seorang ahli yang hendaklah dipilih oleh dan daripada ahli-ahli Per- badanan. (5) Pada menjalankan kerja-kerja tata- tertibnya, Jawatankuasa Tatatertib hendaklah mempunyai kuasa untuk mengenakan apa- apa hukuman tatatertib sebagaimana yang diperuntukkan di bawah mana-mana aturan yang boleh dibuat di bawah seksyen 5. (6) Jawatankuasa Tatatertib boleh, ter- takluk kepada subseksyen (7), mewakilkan mana-mana kerja, kuasa atau kewajipan tatatertibnya kepada mana-mana Jawatan- kuasa pegawai atau kakitangan Per- badanan, berkenaan dengan mana-mana pegawai atau kakitangan tertentu Per- badanan, atau berkenaan dengan mana- mana golongan atau kategori pegawai atau kakitangan Perbadanan, dan Jawatankuasa yang diwakilkan dengan kerja-kerja, kuasa- kuasa atau kewajipan-kewajipan sedemikian hendaklah melaksanakan, menjalankan atau menunaikannya di bawah arahan dan kawalan Jawatankuasa Tatatertib yang hendaklah RANG UNDANG-UNDANG mempunyai kuasa untuk mengkaji semula, membatalkan atau mengubah mana-mana keputusan atau dapatan jawatankuasa itu. (7) Tiada perwakilan boleh dibuat di bawah subseksyen (6) yang membolehkan seorang pegawai atau kakitangan Perbadanan menjadi ahli suatu jawatankuasa yang boleh menjalankan mana-mana kuasa tatatertib ke atas seseorang pegawai atau kakitangan yang lebih tinggi pangkatnya daripada dia. (8) Mana-mana pegawai atau kakitangan Perbadanan yang tidak berpuas hati dengan keputusan Jawatankuasa Tatatertib atau mana-mana jawatankuasa yang diwakilkan dengan kerja-kerja, kuasa-kuasa atau ke- wajipan-kewajipan di bawah subseksyen (6) boleh, dalam tempoh empat belas hari, merayu secara bertulis terhadap keputusan itu kepada Perbadanan yang boleh sesudah itu mengesahkan, mengakaskan atau mem- berikan arahan-arahan tentang perkara itu sebagaimana yang difikirkannya patut dan wajar. (9) Keputusan Perbadanan atas rayuan itu adalah muktamad. 5B. (1) Perbadanan boleh melantik jawatan- kuasa-jawatankuasa bagi apa-apa maksud yang berbangkit daripada atau berkaitan dengan mana-mana kuasa, kewajipan atau kerjanya di bawah Akta ini; mana-mana jawatankuasa yang dilantik sedemikian hendaklah termasuk tidak kurang daripada seorang ahli Perbadanan dan bolehlah dilantik untuk menganggotai jawatankuasa itu orang- orang lain sebagaimana yang difikirkan patut oleh Perbadanan. (2) Jawatankuasa yang dilantik sedemi- kian hendaklah mengawalselia prosedurnya sendiri. (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PINDAAN) (3) Mana-mana jawatankuasa yang dilantik sedemikian hendaklah menuruti apa-apa arahan yang diberikan kepadanya dari semasa ke semasa oleh Perbadanan, dan Perbadanan boleh pada bila-bila masa memberhentikan atau menukar keanggotaan mana-mana jawatankuasa yang dilantik sedemikian. (4) Maka bolehlah dibayar kepada ahli-ahli mana-mana jawatankuasa apa-apa saraan atau elaun sebagaimana yang ditetapkan oleh Perbadanan dari semasa ke semasa dengan kelulusan Menteri. (5) Jawatankuasa itu boleh menjemput mana-mana orang, yang pada pendapatnya, memiliki pengetahuan khas yang memberikan faedah kepadanya, untuk menghadiri mana- mana mesyuarat jawatankuasa itu dan orang yang dijemput sedemikian tidak berhak untuk mengundi pada mana-mana mesyuarat sedemikian. (6) Jawatankuasa itu hendaklah melapor- kan syor-syornya kepada Perbadanan.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 7 dengan yang berikut: 7. Kerja-kerja Perbadanan adalah— (a) menerajui penggalakan dan penye- baran maklumat dan isu-isu yang ber- hubungan dengan produktiviti; (b) menubuhkan suatu pusat maklumat dan rujukan bagi indeks produktiviti bagi negara dan bagi sistem-sistem pengurusan dan kajian-kajian kes; (c) mengeluarkan kepakaran tempatan dalam bidang produktiviti, mutu, pengurusan dan keusahawanan; RANG UNDANG-UNDANG (d) mempertingkatkan pembangunan sum- ber manusia pada peringkat penyelia- an dan peringkat pengurusan kedua- duanya dalam negara; (e) menasihati dan menyelaraskan pelak- sanaan program-program dan aktiviti- aktiviti yang berhubungan dengan produktiviti dan mutu; (f) menilai dan memperakui program- program penyeliaan dan latihan pengurusan, program-program keusa- hawanan, dan program-program pro- duktiviti dan pengurusan mutu yang dijalankan oleh sektor swasta bagi orang awam; (g) menjalankan latihan atau program- program lain yang berhubungan dengan produktiviti, mutu, pengurusan dan keusahawanan; (h) mengadakan perkhidmatan rundingan yang berhubungan dengan produktiviti, mutu, pengurusan dan keusahawanan; (i) mengumpul, mengeluarkan dan me- nerbitkan maklumat mengenai produk- tiviti, mutu, pengurusan, keusahawan- an dan hal-hal perkara lain yang ber- hubungan; (j) menjalankan usaha-usaha perniagaan bagi maksud menunaikan kerja- kerjanya di bawah Akta ini dengan kelulusan Menteri; (k) memberikan laporan tiap-tiap tahun kepada Menteri mengenai kemajuan dan masalah-masalah meningkatkan produktiviti dalam perdagangan dan industri dalam negara dan membuat syor-syor mengenai cara bagaimana masalah-masalah itu boleh diuruskan; dan (MEMPERBADANKAN) MAJLIS DAYA PENGELUARAN NEGARA (PINDAAN) (I) membuat semua perkara dan benda yang bersampingan dengan atau ber- bangkit daripada penunaian kerja- kerjanya di bawah Akta ini.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas sahaja seksyen 7, seksyen baru 7A dan 7B yang 7A. Perbadanan boleh menggunakhidmat dan membayar penasihat-penasihat teknik, termasuklah peguambela-peguambela dan peguamcara-peguamcara, jurubank-jurubank atau orang-orang lain, untuk menjalankan apa-apa urusan atau untuk membuat apa-apa perbuatan yang dikehendaki dijalankan atau dilakukan dalam. penyempurnaan kewajipan- kewajipannya atau bagi menjalankan maksud-maksud Akta dengan lebih baik. 7B. (1) Menteri boleh dari semasa ke semasa perundingan. menubuhkan satu atau lebih panel per- undingan. (2) Adalah menjadi kerja sesuatu panel perundingan yang ditubuhkan di bawah subseksyen (1) untuk menasihati Perbadanan mengenai apa-apa perkara yang dirujukkan kepadanya oleh Perbadanan yang ber- hubungan dengan kerja-kerja Perbadanan. (3) Sesuatu panel perundingan yang di- tubuhkan di bawah subseksyen (1) hendak- lah terdiri daripada— (a) sekurang-kurangnya tiga orang tetapi tidak lebih daripada tujuh orang wakil daripada sektor awam; (b) sekurang-kurangnya tiga orang tetapi tidak lebih daripada sepuluh orang daripada sektor swasta; RANG UNDANG-UNDANG (c) sekurang-kurangnya seorang tidak lebih daripada lima orang wakil daripada institusi-institusi pengajian tinggi; dan (d) sekurang-kurangnya seorang tidak lebih daripada lima orang wakil daripada persatuan-persatuan mewakili pekerja-pekerja. (4) Menteri boleh, sebagai tambahan kepada ahli-ahli yang dinyatakan dalam subseksyen (3), melantik mana-mana ahli atau ahli-ahli lain daripada kalangan orang- orang yang memiliki pengetahuan khas dalam bidang-bidang tertentu.\"."
      }
    }
  ]
}
