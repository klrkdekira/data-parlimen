      "schema:name": {
        "@language": "en",
        "@value": "Audit (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Audit (Amendment) Act 1990"
      },
      "schema:text": {
        "@language": "en",
        "@value": "and shall be deemed to have come into force on the 1st October 1988."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Audit Act 1957, which in this Act is referred to as the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"principal Act\", is amended by inserting immediately after section 10, the following new section 11: \"Power to 11. The Yang di-Pertuan Agong may by order amend published in the Gazette amend the provisions of Schedule. the Schedules.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The First Schedule to the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting the words \"three hundred and twenty\" for the"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/eng@/~sched_1",
