      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Audit (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Audit (Pindaan) 1990"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dan hendoklah disifatkan telah mula berkuatkuasa pada 1hb Oktober 1988."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Audit 1957, yang disebut \"Akta ibu\" dalam Akta ini,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "adalah dipinda dengan memasukkan selepas sahaja seksyen 10, seksyen baru 11 yang berikut: \"Kuasa 11. Yang di-Pertuan Agong boleh meminda untuk peruntukan-peruntukan Jadual melalui perintah yang meminda Jadual. disiarkan dalam Warta\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Pertama kepada Akta ibu adalah dipinda dengan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/45/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"dua ratus sepuluh\" dalam perenggan 1 (1) dan (2) dengan perkataan-perkataan \"tiga ratus dua puluh\". RANG UNDANG-UNDANG"
      }
    }
  ]
