      ],
      "schema:name": {
        "@language": "en",
        "@value": "Consolidated Fund (Expenditure on Account) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Consolidated Fund"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Expenditure on Account) Act 1990 and shall come into force on 1st January 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In conformity with paragraph (a) of Article 102 of the Constitution, expenditure of an amount not exceeding the sum of six thousand and three million four hundred and thirty six thousand and twenty ringgit ($6,003,436,020) to be issued from the Consolidated Fund for the service of that part of the year 1991 preceding the date of coming into force of the Supply Act in respect of that year is hereby authorised."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The amount authorised for each service in Column 1 of the Schedule shall be that specified in Column 2 thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/46/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Column 1 Purpose Title $ B. 1 Parliament B. 2 Office of the Keeper of the Rulers' Seal B. 3 Audit Department B. 4 Election Commission B. 5 Public Services Commission BILL Column 1 Purpose Title B. 6 Education Service Commission B. 7 Prime Minister's Department B. 8 Public Services Department B. 9 Statistics Department B. 10 Attorney General's Chambers B. 11 Anti-Corruption Agency B. 12 Office of the Federal Secretary Sabah B. 13 Office of the Federal Secretary Sarawak B. 14 Ministry of Housing and Local Government B. 15 Town and Country Planning B. 16 Fire Services Department B. 17 Ministry of Youth and Sports B. 18 Ministry of Primary Industries B. 19 Ministry of Agriculture B. 20 Ministry of International Trade and Industry B. 21 Ministry of Domestic Trade and Consumer Affairs B. 22 Ministry of Culture, Arts and Tourism B. 23 Department of the National Archives B. 24 National Museum B. 25 Ministry of Defence B. 26 Ministry of Education B, 27 Department of National Library B, 28 Treasury B. 29 Treasury General Services B. 30 Contribution to Statutory Funds B. 31 Royal Customs and Excise Department B. 32 Inland Revenue Department B. 33 Ministry of Public Enterprises B. 34 Ministry of Health B. 35 Ministry of Home Affairs B. 36 Royal Malaysia Police B, 37 Immigration Department B. 38 Registration of Societies Department B. 39 National Registration Department B. 40 Prisons Department B. 41 Civil Defence Department B. 42 National Printing Department CONSOLIDATED FUND (EXPENDITURE ON ACCOUNT) Column 1 Purpose Title $ B. 43 Ministry of Justice B. 44 Ministry of Information B. 45 Ministry of Human Resources B. 46 Ministry of Science, Technology and Environment B. 47 Ministry of Transport B. 48 Civil Aviation Department B. 49 Ministry of Energy, Telecommunications and Posts B. 50 Postal Services Department B. 51 Ministry of External Affairs B. 52 Ministry of Works B. 53 Ministry of Land and Cooperative Development B. 54 Ministry of Rural Development B. 5