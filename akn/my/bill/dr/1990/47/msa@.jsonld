        "@value": "Rang Undang-Undang Perbekalan 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_1",
      "@type": "akn:clause",
