      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 1991. Tajuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
