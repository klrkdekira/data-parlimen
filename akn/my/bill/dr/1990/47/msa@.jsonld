        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi dua belas ribu lapan ratus enam juta tujuh ratus lima ribu empat ratus sembilan puluh ($12,806,705,490) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 1991 adalah dengan ini dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah wang yang dibenarkan untuk dikeluarkan melalui Akta ini dan jumlah wang sebanyak enam ribu tiga juta empat ratus tiga puluh enam ribu dua puluh ringgit ($6,003,436,020), iaitu amaun perbelanjaan yang dibenarkan oleh seksyen 2 Akta Kumpulan Wang . Disatukan (Perbelanjaan Masuk Akaun) 1990, yang Akta RANG UNDANG-UNDANG amaun agregatnya berjumlah lapan belas ribu lapan ratus sepuluh juta seratus empat puluh satu ribu lima ratus sepuluh ringgit ($18,810,141,510) adalah dengan ini diuntukkan dan hendaklah disifatkan telah diuntukkan dari tarikh mula berkuatkuasanya Akta Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) 1990 bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/47/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 1 ... Parlimen $ B. 2 ... Pejabat Penyimpan Mohor Besar Raja-Raja B. 3 ... Jabatan Audit B. 4 ... Suruhanjaya Pilihanraya B. 5 ... Suruhanjaya Perkhidmatan Awam B. 6 ... Suruhanjaya Perkhidmatan Pen- didikan B. 7 ... Jabatan Perdana Menteri B. 8 ... Jabatan Perkhidmatan Awam B. 9 ... Jabatan Perangkaan B. 10 ... Jabatan Peguam Negara B. 11 ... Badan Pencegah Rasuah B. 12 ... Pejabat Setiausaha Persekutuan Sabah B. 13 ... Pejabat Setiausaha Persekutuan Sarawak B. 14 ... Kementerian Perumahan dan Kerajaan Tempatan B. 15 ... Jabatan Perancangan Bandar dan Desa B. 16 ... Jabatan Perkhidmatan Bomba B. 17 ... Kementerian Belia dan Sukan B. 18 ... Kementerian Perusahaan Utama B. 19 ... Kementerian Pertanian B. 20 ... Kementerian Perdagangan Antara- bangsa dan Industri PERBEKALAN Maksud Tajuk B. 21 ... Kementerian Perdagangan Dalam $ Negeri dan Hal Ehwal Pengguna B. 22 ... Kementerian Kebudayaan, Kese- nian dan Pelancongan B. 23 ... Jabatan Arkib Negara B. 24 ... Muzium Negara B. 25 ... Kementerian Pertahanan 2,500,224,000 B. 26 ... Kementerian Pendidikan 5,551,520,900 B. 27 ... Jabatan Perpustakaan Negara B. 28 ... Perbendaharaan B. 29 ... Perkhidmatan Am Perbendaharaan B. 30 ... Peruntukan kepada Kumpulan 1,958,621,010 Wang Terkanun B. 31 ... Jabatan Kastam dan Eksais Diraja B. 32 ... Jabatan Hasil Dalam Negeri B. 33 ... Kementerian Perusahaan Awam B. 34 ... Kementerian Kesihatan 1,446,500,400 B. 35 ... Kementerian Dalam Negeri B. 36 ... Polis Diraja Malaysia 1,244,731,400 B. 37 ... Jabatan Imigresen B. 38 ... Jabatan Pendaftaran Pertubuhan B. 39 ... Jabatan Pendaftaran Negara B. 40 ... Jabatan Penjara B. 41 ... Jabatan Pertahanan Awam B. 42 ... Jabatan Percetakan Negara B. 43 ... Kementerian Kehakiman B. 44 ... Kementerian Penerangan B. 45 ... Kementerian Sumber Manusia B. 46 ... Kementerian Sains, Teknologi dan Alam Sekitar B. 47 ... Kementerian Pengangkutan B. 48 ... Jabatan Penerbangan Awam RANG UNDANG-UNDANG Maksud Tajuk B. 49 ... Kementerian Tenaga, Telekom $ dan Pos B. 50 ... Jabatan Perkhidmatan Pos B. 51 ... Kementerian Luar Negeri B. 52 ... Kementerian Kerja Raya B. 53 ... Kementerian Tanah dan Pemba- ngunan Koperasi B. 54 ... Kementerian Pembangunan Luar Bandar B. 55 ... Jabatan Hal Ehwal Orang Asli B. 56 ... Kementerian Perpaduan Negara dan Pembangunan Masyarakat B. 57 ... Jabatan Perpaduan Negara JUMLAH ... $18,810.141,510"
      }
