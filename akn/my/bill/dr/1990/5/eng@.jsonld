      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after the word \"Act\" in the definition of \"prescribed\", the words \"or any regulations made thereunder\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/5/eng@/~cl_3",
