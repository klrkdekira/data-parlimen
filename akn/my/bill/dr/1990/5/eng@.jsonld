      "schema:name": {
        "@language": "en",
        "@value": "Section 2 (1) of the Control-of Supplies Act 1961,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "which in this Act is referred to as \"the principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/5/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"licensed premises\", the following: ' \"licensed premises\" means any premises specified in a licence issued by the Con- troller under this Act or any regulations made thereunder;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/5/eng@/~cl_2__para_b",
