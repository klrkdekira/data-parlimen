      ],
      "schema:name": {
        "@language": "en",
        "@value": "Elections (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Elections"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1990 and shall come into force on such date as the Yang di-Pertuan Agong may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the Elections Act 1958, which in this"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act is referred to as \"the principal Act\", is amended by substituting for the definition of \"polling station\" the following new definition: \"polling station\" means any room, structure, vehicle or vessel, at the place appointed under section 7, set apart and equipped for the purpose of polling and counting of votes;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 16 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "inserting after the word \"officer\" in paragraph (j) of subsection (2) the words \"or a presiding officer\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended, in the Bahasa"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Malaysia text, by substituting for the words \"pegawai pengetua\" wherever they appear therein the words \"ketua tempat mengundi\"."
      }
    }
  ]
