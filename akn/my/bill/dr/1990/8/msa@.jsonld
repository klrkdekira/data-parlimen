      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pilihanraya (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pilihanraya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1990 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta Pilihanraya 1958, yang disebut"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan takrif kttempat mengundi\" dengan takrif baru yang berikut: ' \"tempat mengundi\" ertinya mana-mana bilik, binaan, kereta atau vesel, di tempat yang ditetapkan di bawah seksyen 7, yang dikhaskan dan dilengkapkan bagi maksud mengundi dan pengiraan undi.'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 16 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas perkataan \"pengums\" dalam perenggan (j) subseksyen (2) perkataan-perkataan \"atau ketua tempat mengundi\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda, dalam teks Bahasa Malaysia, dengan menggantikan perkataan-perkataan \"pegawai pengetua\" di mana jua terdapat di dalam- nya dengan perkataan-perkataan \"ketua mengundi\"."
      }
    }
  ]
