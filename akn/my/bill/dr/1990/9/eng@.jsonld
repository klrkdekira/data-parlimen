      ],
      "schema:name": {
        "@language": "en",
        "@value": "Election Offences (Amendment) Bill 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Election Offences"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1990 and shall come into force on such date as the Yang di-Pertuan Agong may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 41 of the Election Offences Act 1954, which"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in this Act is referred to as \"the principal Act\", is amended by inserting after the word \"officer\" in that section and in the marginal note thereto the words \"or presiding officer\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended, in the Bahasa"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Malaysia text, by substituting for the words \"pegawai pengetua\" wherever they appear therein the words \"ketua tempat mengundi\"."
      }
    }
  ]
