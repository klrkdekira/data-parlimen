      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kesalahan Pilihanraya (Pindaan) 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kesalahan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pilihanraya (Pindaan) 1990 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 41 Akta Kesalahan Pilihanraya 1954, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan memasukkan selepas perkataan \"pengurus\" dalam seksyen itu dan dalam nota birainya perkataan- perkataan \"atau ketua tempat mengundi\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1990/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda, dalam teks Bahasa Malaysia, dengan menggantikan perkataan-perkataan \"pegawai pengetua\" di mana jua terdapat di dalam- nya dengan perkataan-perkataan \"ketua mengundi*'."
      }
    }
  ]
