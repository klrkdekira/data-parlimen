      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" after the word \"message;\" in paragraph (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/eng@/~cl_12__para_b",
