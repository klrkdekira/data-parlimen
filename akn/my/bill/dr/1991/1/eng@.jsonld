      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately before the definition of \"Director General\", the following definitions: ' \"authorized telecommunication officer\" means any telecommunication officer employed by the Government in connection with telecommunication and authorized by the Director General for the purposes of this Act either generally or in relation to any specific provision of this Act; \"conveyance\" includes vehicles, aircraft, ships and any other vessel;';"
      }
    },
