      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"telecommunication authority\" the following new definition: ' \"telecommunication authority\" means the Director General of Telecommunications, Malaysia, and includes any authorized telecommunication officer;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/eng@/~cl_2__list_1__para_d",
      "@type": "akn:paragraph",
