      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after the definition of \"telecommunication engineer\", the following definition: ' \"telecommunication equipment\" means any equipment used for the purpose of telecommunication;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/eng@/~cl_2__list_1__para_e",
