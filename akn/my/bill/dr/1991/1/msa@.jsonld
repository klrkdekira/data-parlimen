      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 25 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"or\" selepas perkataan \"message;\" dalam perenggan (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong koma dalam perenggan (c) dan memasukkan, selepas sahaja perkataan \"mischief, perkataan-perkataan \"; or\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (c), perenggan baru (d) berikut: \"(d) to transmit or allow to be transmitted by telecommunication any message without paying the prescribed charge,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan-perkataan \"two thousand\" dengan perkataan-perkataan \"twenty thousand\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 26 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"three hundred\" dengan perkataan-perkataan \"ten thousand\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_14",
      "@type": "akn:clause",
