      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Telekomunikasi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
