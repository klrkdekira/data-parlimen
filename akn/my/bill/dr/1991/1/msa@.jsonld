      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja takrif \"post\", takrif berikut: ' \"premises\" includes any house, shop, cubicle, set, conveyance or any place whether with or without enclosure;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_2__list_1__para_c",
      "@type": "akn:paragraph",
