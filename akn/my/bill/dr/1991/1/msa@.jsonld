      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 (1) Akta ibu adalah dipinda —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perkataan \" line\", perkataan-perkataan \"or equipment\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perkataan- perkataan \"across, and\", perkataan-perkataan \"telecommunication equipment or\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 21 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"five hundred\" di baris enam dengan perkataan-perkataan \"one hundred thousand\"; dan dengan menggantikan perkataan- perkataan \"five hundred\" di baris tujuh dengan perkataan- perkataan \"ten thousand\"."
      }
    }
  ]
