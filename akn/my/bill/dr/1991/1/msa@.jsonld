      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"telecommuni- cation authority\" dengan takrif baru berikut: ' \"telecommunication authority\" means the Director General of Telecommunications, Malaysia, and includes any authorized telecommunication officer;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_2__list_1__para_d",
      "@type": "akn:paragraph",
