      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"two hundred\" dengan perkataan-perkataan \"ten thousand\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_12",
