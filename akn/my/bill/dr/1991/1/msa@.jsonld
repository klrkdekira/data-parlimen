      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"twenty-five\" dengan perkataan- perkataan \"five thousand\"."
      }
    },
