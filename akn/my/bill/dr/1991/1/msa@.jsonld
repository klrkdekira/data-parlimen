      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja takrif \"telecommunication engineer\", takrif berikut: ' \"telecommunication equipment\" means any equipment used for the purpose of telecommunication;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_2__list_1__para_e",
