      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"telecommuni- cation officer\" dengan takrif baru berikut: ' \"telecommunication officer\" means any person employed, either permanently or temporarily, by—"
      }
    },
