    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Bahagian III Akta ibu, kecuali seksyen 10 (1) dan 18,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian III. adalah dipinda dengan memasukkan, selepas sahaja perkataan \"line\" atau \"lines\" di mana-mana sahaja terdapat, perkataan \", equipment\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/1/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
