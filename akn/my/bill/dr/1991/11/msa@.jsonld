      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kerajaan Tempatan (Pindaan) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kerajaan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tempatan (Pindaan) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 107 Akta Kerajaan Tempatan 1976 adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja sub- seksyen (1), subseksyen baru (1A) yang berikut: \"(1A) Mana-mana lesen atau permit yang diberikan di bawah Akta ini boleh dikeluarkan bersesama dengan mana-mana lesen atau permit lain.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas subseksyen (2), subseksyen baru (2A) yang berikut: \"(2A) Pembatalan mana-mana lesen atau permit tertentu yang dikeluarkan bersesama dengan mana-mana lesen atau permit lain di bawah, subseksyen (1A) tidak menyentuh keesahan mana-mana lesen atau permit -lain yang telah dikeluarkan bersesama dengannya.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan-perkataan \"dua belas bulan\" dalam subseksyen (4) dengan perkataan-perkataan \"tiga tahun\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja sub- seksyen (6), subseksyen baru (7) dan (8) seperti yang berikut: \"(7) Bagi maksud subseksyen (5) atau (6) apa-apa sebutan mengenai perkataan \"lesen\" hendaklah termasuk salinan sahnya yang diperakui. (8) Pemerakuan mana-mana lesen sebagai suatu salinan yang sah hendaklah dibuat oleh Yang Dipertua, Setiausaha atau mana-mana pegawai yang diberikuasa oleh Yang Dipertua secara bertulis.\"."
      }
    }
  ]
}
