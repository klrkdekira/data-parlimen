        "@value": "Rang Undang-Undang Perbekalan Tambahan (1990 dan 1991) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/12/msa@/~cl_1",
