      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the Members of Parliament Remuneration"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act 1980 is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/15/eng@/~cl_2__para_a",
