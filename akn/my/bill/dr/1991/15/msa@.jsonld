      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta Ahli Parlimen (Saraan) 1980 adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/15/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
