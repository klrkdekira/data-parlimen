      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perkataan- perkataan \"tiga ribu\" dalam perenggan (b) subseksyen (1), perkataan-perkataan \"satu ratus lima puluh\"."
      }
