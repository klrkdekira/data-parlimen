      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perkataan- perkataan \"dua ribu\" dalam perenggan (a) subseksyen (1), perkataan-perkataan \"satu ratus\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/15/msa@/~cl_2__para_b",
