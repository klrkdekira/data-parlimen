        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Saraan) (Pindaan) 1991 dan hendaklah disifatkan telah mula berkuatkuasa pada 1hb Januari 1991."
