      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the Ordinance is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
