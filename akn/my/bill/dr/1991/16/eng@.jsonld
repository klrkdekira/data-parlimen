      "schema:name": {
        "@language": "en",
        "@value": "Section 13 of the Ordinance is amended by substituting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "for the words \"the Deputy Governor\" in subsection (1) the words \"any Deputy Governor so designated by the Governor\"."
      }
