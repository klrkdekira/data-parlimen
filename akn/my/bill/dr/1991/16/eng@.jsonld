        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 8 of the Ordinance is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"the Deputy Governor\" in paragraph (b) of subsection (2) the words \"not more than three Deputy Governors\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"the Deputy Governor\" in subsection (3) the words \"any Deputy Governor so designated by the Governor\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"Governor\" appearing after the word \"Deputy\" in subsection (4) the word \"Governors\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after the words \"Governor or\" in subsection (5), the word \"any\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_4",
