      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"the\" appearing before the words \"Deputy Governor\" the word \"any\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after the word \"Agong\", the words \", or in the case of a Deputy Governor, by the Minister,\"."
      }
    },
