      "schema:name": {
        "@language": "en",
        "@value": "Section 31 of the Ordinance is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the word \"Governor\" appearing after the word \"Deputy\" in paragraph (e) the word \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_2",
      "@type": "akn:clause",
