      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the Ordinance is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following: \"(1) The Governor shall be appointed by the Yang di-Pertuan Agong and the Deputy Governors by the Minister.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"Governor\" appearing after the word \"Deputy\" subsections (2), (3), (4) and (5) the word \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the Ordinance is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \", Deputy Governor,\" in subsection (2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after subsection (2), the following new subsection (3): \"(3) The Minister may terminate the appointment of any Deputy Governor on the grounds specified in subsection (2).\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_6",
      "@type": "akn:clause",
