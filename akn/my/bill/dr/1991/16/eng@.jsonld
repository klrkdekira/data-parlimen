        "@language": "en",
        "@value": "Section 15 of the Ordinance is amended by substituting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "for the word \"Governor\" appearing after the word \"Deputy\" in subsection (3) the word \"Governors\"."
