      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Central Bank of Malaysia (Amendment) Act 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 30 of the Ordinance is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the word \"Governor\" appearing after the word \"Deputy\" in subsection (8) the word \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/eng@/~cl_11",
      "@type": "akn:clause",
