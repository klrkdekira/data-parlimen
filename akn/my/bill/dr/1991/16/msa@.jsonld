      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 12 Ordinan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"the\" yang terdapat sebelum perkataan-perkataan \"Deputy Governor\" dengan perkataan \"any\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas perkataan \"Agong\", perkataan-perkataan \", or in the case of a Deputy Governor, by the Minister,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"the Deputy Governor\" dalam subseksyen (1) dengan perkataan- perkataan \"any Deputy Governor so designated by the Governor\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Governor\" yang terdapat selepas perkataan \"Deputy\" dalam subseksyen (3) dengan perkataan \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 26 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"the\" yang terdapat sebelum perkataan-perkataan \"Deputy Governor\" di setiap tempat di mana ia terdapat dalam subseksyen (1) dengan perkataan \"any\"."
      }
