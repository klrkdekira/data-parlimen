      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bank Negara"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia (Pindaan) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 30 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Governor\" yang terdapat selepas perkataan \"Deputy\" dalam subseksyen 8 dengan perkataan \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 31 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Governor\" yang terdapat selepas perkataan \"Deputy\" dalam perenggan (e) dengan perkataan \"Governors\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Ordinan Bank Negara Malaysia 1958, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini disebut \"Ordinan\", adalah dipinda dengan menggantikan perkataan \"the\" yang terdapat selepas perkataan-perkataan ' \"Deputy Governor\" means' dengan perkataan \"any\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/16/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
