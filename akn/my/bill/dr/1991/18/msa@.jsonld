        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Lembaga Loteri Perkhidmatan Masyarakat dan Kebajikan (Pembubaran) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Loteri"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Perkhidmatan Masyarakat dan Kebajikan (Pembubaran) 1991 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa kesukaran atau anomali timbul berkaitan dengan pelaksanaan peruntukan-peruntukan Akta ini, Menteri boleh melalui perintah membuat apa- apa ubahsuaian di dalamnya sebagaimana yang didapatinya perlu bagi menghapuskan atau menghalang kesukaran atau anomali itu: Dengan syarat bahawa Menteri tidaklah boleh menjalankan kuasa-kuasa yang diberi oleh seksyen ini selepas habis tempoh tiga tahun dari tarikh ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini \"ubahsuaian\" termasuklah pindaan, penambahan, pemotongan, penggantian, penyesuaian, perubahan, pengubahan dan ketakpakaian mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"Lembaga\" ertinya Lembaga Loteri Perkhidmatan Masyarakat dan Kebajikan yang ditubuhkan di bawah Akta Lembaga Loteri Perkhidmatan Masyarakat dan Kebajikan 1950-1962; \"Menteri\" ertinya Menteri yang sedang di- pertanggungkan dengan tanggungjawab bagi kebajikan masyarakat; \"Pesuruhjaya Tanah Persekutuan\" ertinya Pesuruhjaya Tanah Persekutuan yang dilantik di bawah Akta Pesuruhjaya Tanah Persekutuan 1957; 4 RANG UNDANG-UNDANG \"tarikh ditetapkan\" ertinya tarikh yang ditetapkan oleh Menteri di bawah seksyen 1."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Lembaga Loteri Perkhidmatan Masyarakat dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kebajikan 1950-1962 adalah dimansuhkan dan Lembaga yang ditubuhkan di bawahnya adalah dibubarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Segala kuasa, hak, keistimewaan, tugas, liabiliti dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kewajipan yang sebelum sahaja tarikh ditetapkan adalah kuasa, hak, keistimewaan, tugas, liabiliti dan kewajipan Lembaga hendaklah, dari tarikh itu, diturunkan kepada Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua tanah yang sebelum sahaja tarikh ditetapkan adalah terletakhak pada Lembaga hendaklah, pada tarikh ditetapkan, terletakhak pada Pesuruhjaya Tanah Persekutuan bagi maksud-maksud Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua harta dan aset selain daripada tanah yang sebelum sahaja tarikh ditetapkan adalah terletakhak pada Lembaga atau pada mana-mana orang bagi pihaknya hendaklah, pada tarikh itu, terletakhak pada Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Semua wang yang berada pada, atau kena dibayar"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepada, Lembaga hendaklah, pada tarikh ditetapkan, dipindahkan kepada, dan diletakhakkan pada, Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Segala suratikatan, bon, perjanjian, suratcara dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perkiraan kerja yang wujud sebelum sahaja tarikh ditetapkan dan menyentuh mana-mana harta yang dipindahkan di bawah seksyen 5 hendaklah mempunyai kuatkuasa dan kesan yang penuh terhadap atau memihak kepada Kerajaan dan boleh dikuatkuasakan sepenuhnya dan dengan berkesannya seolah-olah Kerajaan, dan bukannya Lembaga atau mana-mana orang yang bertindak bagi pihaknya, telah dinamakan di dalamnya atau telah menjadi suatu pihak kepadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemansuhan Akta Lembaga Loteri Perkhidmatan Masyarakat dan Kebajikan 1950-1962 menyentuh liabiliti mana-mana orang untuk didakwa atau dihukum bagi kesalahan-kesalahan yang dilakukan di bawah Akta yang dimansuhkan itu sebelum tarikh DAN KEBAJIKAN (PEMBUBARAN) ditetapkan, atau mana-mana presiding yang telah dibawa atau hukuman yang telah dikenakan sebelum tarikh itu berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana presiding (sama ada sivil atau jenayah), atau kausa tindakan yang belum selesai atau sedang wujud sebelum sahaja tarikh ditetapkan oleh atau terhadap Lembaga atau mana-mana orang yang bertindak bagi pihaknya bolehlah diteruskan atau dimulakan oleh atau terhadap Kerajaan sepertimana yang ia boleh diteruskan atau dimulakan oleh atau terhadap Lembaga atau orang itu seolah-olah Akta ini telah tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana rayuan yang dibawa, atau mana-mana kebenaran untuk merayu yang dipohonkan, pada atau selepas tarikh ditetapkan, terhadap sesuatu keputusan yang diberi sebelum tarikh ditetapkan dalam mana-mana presiding undang-undang yang di dalamnya Lembaga adalah suatu pihak boleh dibawa oleh atau terhadap Kerajaan sepertimana yang ia boleh dibawa oleh atau terhadap Lembaga seolah-olah Akta ini telah tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan-peruntukan Akta ini,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "semua undang-undang bertulis, perintah, kaedah dan peraturan yang menyentuh atau bagi perlindungan Lembaga dan berkuatkuasa sebelum sahaja tarikh ditetapkan hendaklah, sehingga dipinda atau dibatalkan oleh pihak berkuasa berkenaan yang mempunyai kuasa untuk berbuat demikian, terus berkuatkuasa dan ditafsirkan seolah-olah Akta ini telah tidak diluluskan: Dengan syarat bahawa apa-apa sebutan di dalamnya mengenai Lembaga, melainkan jika konteksnya menghendaki makna yang lain, hendaklah ditafsirkan sebagai sebutan-sebutan mengenai Kerajaan dan ungkapan-ungkapan yang bermaksudkan sebutan sedemikian hendaklah ditafsirkan sewajarnya."
      }
    }
  ]
}
