      ],
      "schema:name": {
        "@language": "en",
        "@value": "Racing Club (Public Sweepstakes) (Amendment and Extension) Bill 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Racing Club (Public"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Sweepstakes) (Amendment and Extension) Act 1991 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 1 of the Racing Club (Public Sweepstakes)"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act 1965, which in this Act is referred to as the \"principal Act\", is amended by substituting for the words \"only to the States of West\" in subsection (2) the words \"throughout\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"the States of West\" in subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following new subsection (2): '(2) In this section— \"racing club\" means a racing club which is a member of the Malayan Racing Association or a successor thereof; and \"sweepstakes\" means any sweepstake promoted on the result of a horse race.'. Extension"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act as amended by sections 2 and 3 is of Act to extended to the States of Sabah and Sarawak and the Sabah, Sarawak Federal Territory of Labuan. and Labuan."
      }
    }
  ]
}
