      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kelab Lumba Kuda (Ambiltagan Awam) (Pindaan dan Perluasan) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kelab Lumba"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kuda (Ambiltagan Awam) (Pindaan dan Perluasan) 1991 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 1 Akta Kelab Lumba Kuda (Ambiltagan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Awam) 1965, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan perkataan- perkataan \"only to the States of West\" dalam subseksyen (2) dengan perkataan \"throughout\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan-perkataan \"the States of West\" dalam subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen (2) baru yang berikut: '(2) In this section— \"racing club\" means a racing club which is a member of the Malayan Racing Association or a successor thereof; and \"sweepstakes\" means any sweepstake promoted on the result of a horse race.'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu sebagaimana dipinda oleh seksyen 2 dan 3"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "adalah diperluaskan ke Negeri-Negeri Sabah dan Sarawak dan Wilayah Persekutuan Labuan."
      }
    }
  ]
}
