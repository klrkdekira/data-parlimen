      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 54 of the Federal Constitution is amended, in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Clause (1), by substituting for the words \"by the Election Commission that there is a vacancy\" the words \"by the President of the Senate that there is a vacancy or by the Election Commission that there is a casual vacancy, as the case may be\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/eng@/~cl_3",
