      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1), by deleting paragraph (e);and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/eng@/~cl_3__para_b",
