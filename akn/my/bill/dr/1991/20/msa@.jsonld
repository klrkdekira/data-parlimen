      "schema:name": {
        "@language": "ms",
        "@value": "Perkara 139 Perlembagaan Persekutuan adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 139. dipinda, dalam Fasal (1), dengan menggantikan perkataan-perkataan \"perenggan (c), (e) dan (/)\" dengan perkataan-perkataan \"perenggan (c) dan (/)\"."
      }
