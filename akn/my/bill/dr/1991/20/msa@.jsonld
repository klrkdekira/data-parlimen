      "schema:name": {
        "@language": "ms",
        "@value": "Perkara 132 Perlembagaan Persekutuan adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 132. dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
