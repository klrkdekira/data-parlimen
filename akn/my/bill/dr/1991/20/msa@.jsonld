      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlembagaan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/msa@/~cl_2",
      "@type": "akn:clause",
