      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Fasal (1), dengan memotong perenggan (e)\\ dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/20/msa@/~cl_3__para_b",
