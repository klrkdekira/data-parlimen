        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "The Ordinance is amended by inserting after 12B. section 12A the following new section 12B: \"Bank 12B. The Authority or its corporation guarantee. established under section 42 may, in the normal course of performing its duties, issue one or more bank guarantees to any person for such purpose and to such extent as the Authority may, with the approval of the Minister, determine.\". LAND DEVELOPMENT (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Every act or thing done by the Authority or its corporation or by both before the commencement of this Act that would have been lawful if section 12B of the Ordinance (as amended by subsection (1) of this section) had been in force at the time when it was done is hereby validated and declared to have been lawfully done."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/29/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Notwithstanding anything contained in the order"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "made by the Authority under section 42 of the Ordinance, the borrowing of money by the corporation established under the said section before commencement of this Act shall not be invalid by reason only that no bonds, debentures or debenture stock was issued by that corporation in respect of such borrowing as required under such order."
      }
    }
  ]
}
