      "schema:text": {
        "@language": "en",
        "@value": "(Section 3) Title Appropriation to purpose Prime Minister's Department 40,000,000 Ministry of Housing and Local 483,800 Government Ministry of International Trade 10,674,700 and Industry Ministry of Education 150,000,000 Treasury 20,513,700 Royal Malaysia Police 32,179,100 National Registration Department 2,399,200 Ministry of Transport 1,587,100 Ministry of Works 213,700,000 Ministry of National Unity and 20,000.000 Social Development TOTAL 491,537,600 (1990 AND 1991) (NO. 2)"
      }
