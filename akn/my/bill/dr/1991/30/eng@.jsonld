      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1990 and 1991) (No. 2) Act 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding five million two hundred and twenty seven thousand and three hundred ringgit ($5,227,300) from the Consolidated Fund for expenditure on the services specified in the First Schedule for the service of the year 1990, not provided for or not fully provided for by the Supply Act 1990, the Supplementary Supply (1989 and 1990) Act 1990 the Supplementary Supply (1989 and 1990) (No. 2) Act 1990 and the Supplementary Supply (1990 and 1991) Act 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the First Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding four hundred and ninety one million five hundred thirty seven thousand and six hundred ringgit ($491,537,600) from the Consolidated Fund for expenditure on the services specified in the Second Schedule for the service of the year 1991, not provided for or not fully provided for by the Supply Act 1991 and the Supplementary Supply (1990 and 1991) Act 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 2) Title Appropriation to purpose Ministry of Education 92,600 Ministry of Foreign Affairs 3,334,900 Civil Defence Department 800 National Unity Department 1,799,000 TOTAL 5,227,300"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/eng@/~sched_2",
