      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tambahan (1990 dan 1991) (No. 2) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan sejumlah wang yang tidak melebihi lima juta dua ratus dua puluh tujuh ribu tiga ratus ringgit ($5,227,300) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan yang dinyatakan dalam Jadual Pertama bagi perkhidmatan tahun 1990, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1990, Akta Perbekalan Tambahan (1989 dan 1990) 1990, Akta Perbekalan Tambahan (1989 dan 1990) (No. 2) 1990 dan Akta Perbekalan Tambahan (1990 dan 1991) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang tersebut itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual Pertama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan sejumlah wang yang tidak melebihi empat ratus sembilan puluh satu juta lima ratus tiga puluh tujuh ribu enam ratus ringgit ($491,537,600) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan- perkhidmatan yang dinyatakan dalam Jadual Kedua bagi perkhidmatan tahun 1991, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1991 dan Akta Perbekalan Tambahan (1990 dan 1991) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang tersebut itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
