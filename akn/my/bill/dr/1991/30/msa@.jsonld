      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (1990 dan 1991) (No. 2) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/30/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
