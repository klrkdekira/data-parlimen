      ],
      "schema:name": {
        "@language": "en",
        "@value": "International Organizations (Privileges and Immunities) Bill 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the International"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Organizations (Privileges and Immunities) Act 1991 and shall come into force on such date as may be appointed by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any written law to the contrary, it shall be lawful for land in any part of the Federation or any interest in such land to be granted, alienated, leased or transferred to or owned or held by an international organization for the purposes of the organization or the residences or offices of any of the persons specified in any of the regulations made under paragraphs 4(1)(b) and 4(1)(d)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where by virtue of subsection (1) it is lawful for land or an interest in land to be granted, alienated, leased or transferred to or owned or held by an international organization, such land or interest may be granted, alienated, leased or transferred to or owned or held by such organization in its name or its behalf to or by any person nominated for the purposes of this subsection either generally or in a particular case by writing addressed to the Minister by or on behalf of such organization, as the case may be, and such organization or person, as the case may be, shall be registered accordingly as proprietor, lessee or otherwise, as the case may require, in any register kept under the provisions of the National Land Code. (PRIVILEGES AND IMMUNITIES)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of any dealing in any land or interest in any land vested in the name of any international organization, any person authorized for the purposes of this subsection either generally or in any particular case by writing addressed to the Minister by or on behalf of such organization may, by virtue of such authorization, execute all or any instruments and do any act or thing for giving effect to any dealing with such land on behalf of such organization in the same manner and to the like extent as if such person had been authorized thereto by a valid power of attorney duly delivered under the provisions of the National Land Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for carrying into effect the objects of this Act and for prescribing all matters required or permitted by this Act to be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In particular and without prejudice to the generality of subsection (1), the regulations may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make provisions for or in relation to the waiver of any privileges or immunities to which an international organization or person is entitled by virtue of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make provisions for giving effect to the purposes of section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of sections 4 and 5, regulations conferring any privileges or immunities with respect to matters for which the Minister of Finance is for the time being responsible shall not be made without his concurrence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Regulations made under section 4 or 5 shall not confer on any person referred to in subparagraph 4(l)(c)(i) or in subsection 4(3) or in subsection 5(2) any immunity in respect of a civil action arising out of an accident caused by a motor vehicle or other means of transport belonging to or driven by such a person, or in respect of a traffic offence involving such a person and committed by such a person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Regulations made under section 4 or 5 shall not confer on any person or organization any privileges or immunities greater in extent than those which at the time of the making of the regulations are or are required fo he conferred on that person or organization in order to give effect to any international agreement in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The provisions of the Diplomatic and Consular"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Privileges Ordinance 1957 are amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "by repealing Part III thereof; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "in the manner and to the extent set out in the Sixth Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3",
