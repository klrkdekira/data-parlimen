      "schema:text": {
        "@language": "en",
        "@value": "an organ of, or office within, an organization that is so declared;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
