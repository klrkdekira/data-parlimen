      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3",
      "schema:text": {
        "@language": "en",
        "@value": "PRIVILEGES AND IMMUNITIES OF REPRESENTATIVES ACCREDITED TO, OR ATTENDING CONFERENCE CONVENED BY, INTERNATIONAL ORGANIZATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity from personal arrest or detention."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity from suit and from other legal process in respect of acts and things done in his capacity as such a representative."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Inviolability of papers and documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The right to use codes and to send and receive correspondence and other papers and documents by couriers or in sealed bags."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption (including exemption of the spouse of the representative) from the application of laws relating to immigration, the registration of aliens and the obligation to perform national service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from currency or exchange restrictions to such extent as is accorded to a representative of a foreign government on a temporary mission on behalf of that government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The like privileges and immunities, not being privileges and immunities of a kind referred to in any of the preceding paragraphs, as are accorded to a head of mission, other than exemption from—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "excise duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "sales taxes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_3__part_I__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "duties on the importation or exportation of goods not forming part of personal baggage. (PRIVILEGES AND IMMUNITIES)"
      }
    },
