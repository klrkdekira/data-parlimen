      "schema:text": {
        "@language": "en",
        "@value": "a committee, or sub-committee of a committee, of such an organization, organ, commission, council or body; \"regulation\" means regulation made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
