      "schema:text": {
        "@language": "en",
        "@value": "a commission, council or other body established by such an organization or organ; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
