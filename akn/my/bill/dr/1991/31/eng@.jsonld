        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1__list_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1__list_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_1"
    },
