      "schema:text": {
        "@language": "en",
        "@value": "PRIVILEGES AND IMMUNITIES OF OFFICER (OTHER THAN HIGH OFFICER) OF INTERNATIONAL ORGANIZATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4",
      "schema:text": {
        "@language": "en",
        "@value": "IMMUNITIES OF FORMER OFFICER (OTHER THAN HIGH OFFICER) OF INTERNATIONAL ORGANIZATION Immunity from suit and from other legal process in respect of acts and things done in his capacity as such an officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity from suit and from other legal process in respect of acts and things done in his capacity as such an officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from income tax on official salaries and emoluments received from the organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption (including exemption of spouse and children under the age of twenty-one years) from the application of laws relating to immigration and the registration of aliens."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from the obligation to perform national service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from currency or exchange restrictions to such extent as is accorded to an official of comparable rank forming part of a diplomatic mission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Repatriation facilities (including repatriation facilities for spouse and any dependent relatives) in time of international crisis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_4__part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The right to import furniture and personal effects, including one motor vehicle, free of duties and taxes when first taking up a post in Malaysia and to export furniture and personal effects free of duties and taxes when leaving Malaysia on termination of his functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_5",
      "@type": "akn:schedule",
