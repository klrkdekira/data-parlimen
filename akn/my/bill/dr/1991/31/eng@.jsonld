      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, a person who is, or has been during any period, a member of an organ of (PRIVILEGES AND IMMUNITIES) an international organization but is not, or has not been during that period, accredited to that organ as a representative of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a country;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an international organization; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an overseas organization, shall be decided to be or to have been during that period, as the case may be, so accredited as a representative of the country of which he is a national."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an alternate or deputy of, or substitute for, a representative of a country of an international organization or of an overseas organization; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an adviser to, or expert assisting, such a representative, shall each be deemed to be a member of the official staff of the representative."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "References in this Act to countries shall be read as including references to the government of countries."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may by regulations declare an organization—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of which Malaysia and a country or countries other than Malaysia are members; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that is constituted by a person or persons representing Malaysia and a person or persons representing a country or countries other than Malaysia, to be an international organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), the Minister may by regulations declare—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an organization the members of which are overseas countries in a particular geographical region;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an organization that is constituted by persons representing overseas countries in a particular geographical region; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an organization established, or a group of organizations constituted, by— (i) organizations the members of which are overseas countries in a particular geographical region; or (ii) organizations that are constituted by persons representing overseas countries in a particular geographical region, to be an overseas organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), an organization shall not be declared to be an overseas organization if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "Malaysia is a member of the organization; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the organization is constituted by a person or persons representing Malaysia and a person or persons representing a country or countries other than Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this section, and to subsections 11(3), 11(4) and 11(5), the Minister may by regulations either with or without restrictions or to the extent or subject to the conditions prescribed in such regulations—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "confer upon an international organization— (i) juridical personality and such legal capacities as are necessary for the exercise of the powers and performance of the functions of the organization; and (ii) all or any of the privileges and immunities specified in Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_b__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "confer— (i) upon a person who is, or is performing the duties of, a high officer all or any of the privileges and immunities specified in Part I of the Second Schedule; and (PRIVILEGES AND IMMUNITIES)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person who has ceased to be, or perform the duties of, a high officer the immunities specified in Part II of the Second Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "confer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person who is accredited to, or is in attendance at, an international conference convened by an international organization as a representative of— (A) a country other than Malaysia; (B) another international organi- zation; or (C) an overseas organization, all or any of the privileges and immunities specified in Part I of the Third Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person who has ceased to be accredited to such an organization, or has attended such a conference, as such a representative the immunities specified in Part II of the Third Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "confer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person (not being a high officer) who holds an office in an international organization all or any of the privileges and immunities specified in Part I of the Fourth Schedule; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person who has ceased to hold such an office the immunities specified in Part II of the Fourth Schedule; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_e__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "confer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "upon a person who is serving on a committee, or is participating in the work, of an international organization or is performing, whether alone or jointly with other persons, a mission on behalf of such an organization all or any of the privileges and immunities specified in Part I of the Fifth Schedule; and (ii) upon a person who has served on such a committee or participated in such work or has performed such a mission the immunities specified in Part II of the Fifth Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for the purpose of this section which may be of general application or may relate to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particular international organizations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particular officers or classes of officers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particular conferences, committees or missions or classes of conferences, committees or missions; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "representatives of particular countries or of particular international organizations or of particular overseas organizations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Where by the regulations any privileges or immunities are conferred upon a person who is accredited to, or is in attendance at an international conference convened by, an international organization as a representative of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a country other than Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "another international organization; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an overseas organization, that person is entitled to the same privileges and immunities while travelling to a place for the purpose of presenting his credentials or of attending the conference or while returning from a place after ceasing to be so accredited or after attending the conference."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Where by the regulations any privileges or immunities are conferred upon a person who is serving on a committee, or participating in the work, of an (PRIVILEGES AND IMMUNITIES) international organization or who is performing, whether alone or jointly with other persons, a mission on behalf of such an organization, that person is entitled to the same privileges and immunities while travelling to a place for the purpose of serving on the committee or participating in that work or performing the mission or while returning from a place after serving on the committee or participating in the work or performing the mission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (6), where by regulations or by subsection (3) any privileges or immunities are conferred upon a person who is, or has been, a person accredited to, or in attendance at an international conference convened by, an international organization as a representative of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "a country other than Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "another international organization; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "an overseas organization, a person who is, or has been during any period, a member of the official staff of the first-mentioned person is entitled, in respect of that period, to the same privileges and immunities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Except as the Minister may otherwise provide by regulations, a person who is or has been a representative of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "a country other than Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "an international organization; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "an overseas organization, or a member of the official staff of such a representative during the period when he is or was a Malaysian citizen is not entitled under this section or the regulations to any privileges or immunities, except in respect of acts and things done in his capacity as such a representative or member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an international conference is, or is to be, held in Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a mission is, or is to be, sent by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a country other than Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an international organization or an overseas organization, to Malaysia, and it appears to the Minister that the provisions of this Act other than this section do not, or may not, apply in relation to that conference or mission but it is desirable that diplomatic privileges and immunities should be applicable in relation to that conference or mission, the regulations may declare the conference or mission, as the case may be, to be a conference or mision to which this section applies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsections 11(3), 11(4) and 11(5) and to subsection (3) of this section, where a conference or mission has been declared by the regulations to be a conference or mission to which this section applies—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is, or has been, a representative of— (i) a country other than Malaysia; or (ii) an international organization or an overseas organization, at the conference or on the mission is, in respect of the period in which he is, or has been, such a representative, entitled to the privileges and immunities specified in Part I of the Third Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is, or has been, a member of the official staff of a person referred to in paragraph (a) during the whole or any part of the period referred to in that paragraph is entitled to the privileges and immunities specified in Part I of the Third Schedule in respect of that period or that part of that period, as the case may be; and INTERNATIONAL ORGANIZATIONS (PRIVILEGES AND IMMUNITIES)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an international conference, a person who is, or has been, a member of the secretariat established for the purposes of the conference is entitled to immunity from suit and from other legal process in respect of acts and things done in his capacity as such a member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Except as the Minister may otherwise provide by regulations, a person who is, or has been, in attendance at an international conference, or engaged on a mission, to which this section applies as a representative, or as a member of the official staff of a representative of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a country other than Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an international organization, during a period when he is or was a Malaysian citizen, is not entitled under subsection (2) to any privileges or immunities in respect of that period, except in respect of acts and things done in his capacity as such a representative or member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may by regulations confer upon—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "the judges, assessors and officials of the International Court of Justice established by the Charter of the United Nations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "persons engaged on missions by order of that Court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "the agents, advocates and counsel of countries that are parties in cases before that Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "witnesses in cases before that Court, such privileges and immunities as are required to give effect to the Statute of that Court and such privileges and immunities in respect of acts and things done in the course of the performance of their functions in connection with the business of that Court as are required to give effect to any resolution of, or convention or agreement approved by, the General Assembly of the United Nations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give a certificate in writing certifying any fact relating to the question whether a person is, or was at any time or in respect of any period, entitled, by virtue of this Act or the regulations, to any privileges or immunities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings, a certificate given under this section is evidence of the facts certified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Where the Minister is satisfied that persons, or"
      },
      "schema:text": {
        "@language": "en",
        "@value": "members of the official staffs of persons, representing Malaysia at an international conference in a country would not receive in that country privileges and immunities corresponding to those conferred in Malaysia by this Act or the regulations upon persons, or upon members of the official staffs of persons, representing that country, the Minister may, by order published in the Gazette, withdraw representatives, or from the members of the official staffs of the representatives, of that country all or any of those privileges and immunities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Except with the consent in writing of the Minister, a person (including a body corporate) shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "use the name or an abbreviation of the name of an international organization in connection with a trade, business, profession, calling or occupation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "use— (i) a seal, emblem or device that is identical with the official seal or emblem of an international organization; (ii) a seal, emblem or device so nearly resembling the official seal or emblem of an international organization as to be capable of being mistaken for that seal or emblem; or (iii) a seal, emblem or device that is capable of being taken to be the official seal or emblem of an international organization. (PRIVILEGES AND IMMUNITIES)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where, without the consent in writing of the Minister, the name or an abbreviation of the name of an international organization or a seal, emblem or device referred to in paragraph (1)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is used as, or as part of, the name, seal or emblem of an association;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is used as, or as part of, the name or emblem of a newspaper or magazine owned by, or published by or on behalf of, an association; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is used by an association in connection with any activity of the association so as to imply that the association is in any way connected with that organization, then—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "if the association is a body corporate, the body corporate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "if the association is not a body corporate, every member of the governing body of association, shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding one thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be convicted of an offence against this section in respect of the use of an abbreviation of the name of an international organization if the use occurred in such circumstances or in relation to such matters as to be unlikely to be taken to imply any connection with the organization, unless the prosecution proves that the use was intended to imply such a connection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The conviction of a person of an offence under this section in respect of the use of a name, an abbreviation of a name, a seal, emblem or device does not prevent a further conviction of that person in respect of the use of that name, abbreviation, seal, emblem or device at any time after the first-mentioned conviction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "any combination of words or letters, or of both words and letters, that is capable of being understood as referring to an international organization shall be deemed abbreviation of the name of that organization; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "if a seal or emblem is declared by the regulations to be the official seal or emblem of an international organization, that seal or emblem shall be taken to be the official seal or emblem of that organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Proceedings under this section shall not be instituted without the consent in writing of the Attorney- General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 4) PRIVILEGES AND IMMUNITIES OE INTERNATIONAL ORGANIZATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity of the organization, and of the property and assets of, or in the custody of, or administered by, the organization, from suit and from other legal process."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "The right to use codes and to send and receive correspondence and other papers and documents by couriers or in sealed bags and to have any such couriers or bags treated as diplomatic couriers or diplomatic bags, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Inviolability of property and assets of, or in the custody of, or administered by, the organization and of premises of, or occupied by, the organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Inviolability of archives,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Subject to section 4 of the Exchange Control Act 1953,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "exemption from currency and exchange restrictions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to compliance with such conditions as the Minister of Finance may prescribe for the protection of revenue, exemption from all duties and taxes on—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "goods imported or exported by the organization for its official use;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "locally manufactured goods procured by the organization for its official use; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "official publications of the organization imported or exported by it. (PRIVILEGES AND IMMUNITIES)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from income tax and supplementary income taxes on the income of the organization or real property gain taxes on the gains from the disposal of the properties of the organization, as the case may be, in so far as they are derived from or transacted within the scope of its official activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Exemption from stamp duties that ordinarily would be payable by the organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Exemption from prohibitions and restrictions on"
      },
      "schema:text": {
        "@language": "en",
        "@value": "importation or exportation of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "goods imported or exported by the organization for its official use; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "publications of the organization imported or exported by it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Absence of censorship for official correspondence and other official communications."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2__part_I",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2__part_II"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 4)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2__part_I",
      "@type": "akn:part",
      "eli:number": "I",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "PRIVILEGES AND IMMUNITIES OF HIGH OFFICER OF INTERNATIONAL ORGANIZATION The like privileges and immunities (including privileges and immunities in respect of a spouse and children under the age of twenty-one years) as are accorded to a head of mission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2__part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/31/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "IMMUNITIES OF FORMER HIGH OFFICER OF INTERNATIONAL ORGANIZATION Immunity from suit and from other legal process in respect of acts and things done in his capacity as such an officer."
      }
    },
    {
