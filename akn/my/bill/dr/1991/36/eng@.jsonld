    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding twenty three billion one hundred and fifty one million eight hundred and fifty two thousand and eight hundred and ninety ringgit ($23,151,852,890) from the Consolidated Fund for the service of the year 1992 is hereby authorised, and the said sum is appropriated for the purposes specified in the Schedule."
      }
    },
