      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan 1992"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi dua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "puluh tiga bilion seratus lima puluh satu juta lapan ratus lima puluh dua ribu dan lapan ratus sembilan puluh ringgit ($23,151,852,890) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 1992 adalah dengan ini dibenarkan, dan wang tersebut diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
