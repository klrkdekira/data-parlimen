      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/39/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/39/eng@/~cl_10__para_a",
