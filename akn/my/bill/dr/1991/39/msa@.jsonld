      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta Profesion Undang-Undang 1976, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan memotong takrif \"Fakulti\", \"Jawatankuasa Penyiasatan\" dan \"Jawatankuasa Tatatertib\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/39/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
