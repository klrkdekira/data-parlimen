      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di akhir perenggan (e) dengan koma bertitik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/39/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
