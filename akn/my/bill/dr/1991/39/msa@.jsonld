      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan mengenai takrif \"Jawatankuasa Tatatertib\" atau \"Jawatankuasa Penyiasatan\" di mana- mana jua ia terdapat dalam Akta ibu hendaklah disifatkan sebagai sebutan mengenai istilah \"Lembaga Tatatertib\"."
      }
