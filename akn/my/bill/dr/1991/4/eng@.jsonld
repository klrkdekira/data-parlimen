      ],
      "schema:name": {
        "@language": "en",
        "@value": "Securities Industry (Amendment) Bill 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may cited as the Securities Industry"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1991 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29 of the Securities Industry Act 1983, which"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in this Act is referred to as \"the principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" appearing after the semicolon in paragraph (1)(e);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (1)(f) a semicolon and inserting immediately thereafter the word \"or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after paragraph (1)(f), a new paragraph (g) as follows: \"(g) an authorised depository agent appointed under section 13 of the Securities Act Industry (Central Depositories) Act 1991.\". 2 BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 40 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Subsections (1) and (4) do\" appearing in subsection (5) the words \"Subsection (1) does\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (6); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"(1), (3) or (4)\" wherever appearing in subsection (7) the words \"( 1 ) or (3)\"."
      }
    }
