    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan dalam Akta-Akta dan Ordinan yang dinyatakan di dalam Jadual adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan perintah yang disiarkan dalam Warta, menambah kepada Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pemansuhan peruntukan dalam Akta-Akta dan Ordinan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di bawah seksyen 2 (1) tidak akan menjejaskan apa-apa suratcara yang telah disempurnakan sebelum tarikh kuatkuasa Akta ini."
      }
    },
