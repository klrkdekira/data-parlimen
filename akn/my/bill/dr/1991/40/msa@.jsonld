      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pembatalan Pengecualian Daripada Bayaran Duti-Duti Setem 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pembatalan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pengecualian Daripada Bayaran Duti-Duti Setem 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/40/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
