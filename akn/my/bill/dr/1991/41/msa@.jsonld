        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Tabung Antarabangsa bagi Pembangunan Pertanian 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Tabung Antarabangsa bagi Pembangunan Pertanian 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai di seluruh Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"mata wang boleh tukar secara bebas\" ertinya mata wang sebagaimana disifatkan boleh tukar cara bebas menurut Perkara 1( d) Perjanjian; \"Perjanjian\" ertinya Perjanjian Penubuhan Tabung Antarabangsa bagi Pembangunan Pertanian sebagaimana yang diterima oleh Persidangan Bangsa-Bangsa Bersatu bagi Penubuhan Tabung Antarabangsa Pembangunan Pertanian pada 13hb Jun 1976 di Rome, dan di mana satu salinan teks telah dibentangkan di Dewan Rakyat sebagai Kertas Statut Bil. 147 Tahun 1991; \"Tabung\" ertinya Tabung Antarabangsa bagi Pembangunan Pertanian yang ditubuhkan melalui Perjanjian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong boleh, melalui suratcara di"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bawah tandatangannya, memberi kuasa kepada mana- mana orang sebagaimana yang dinamakan dalam suratcara itu, bagi pihak Kerajaan Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menandatangani Perjanjian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyimpan di Tabung suatu suratcara penerimaan Perjanjian itu yang menyatakan bahawa Kerajaan Malaysia telah menerima Perjanjian itu mengikut undang-undangnya dan telah mengambil segala langkah yang perlu untuk membolehkan Kerajaan Malaysia menjalankan semua obligasinya di bawah Perjanjian tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dipertanggungkan kepada Kumpulan Wang Disatukan apa-apa bahagian sumbangan Malaysia kepada Tabung menurut seksyen 3 Perkara 4 Perjanjian yang, mengikut seksyen 5 Perkara 4 Perjanjian, kena dibayar dengan mata wang boleh tukar secara bebas atau dengan mata wang Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 5, maka hendaklah dipertanggungkan kepada Kumpulan Wang Disatukan mana-mana bahagian apa-apa penambahan sumbangan Malaysia kepada Tabung sebagaimana yang, menurut seksyen 4 Perkara 4 Perjanjian, kena dibayar dengan mata wang boleh tukar secara bebas atau dengan mata wang Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Bila masa juga apa-apa penambahan sumbangan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia kepada Tabung dibenarkan menurut seksyen 4 Perkara 4 Perjanjian, tiada amaun boleh disumbangkan berkenaan dengannya kecuali dengan keiulusan terlebih dahulu daripada Dewan Rakyat, yang ditandakan melalui ketetapan. PERTANIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri Kewangan boleh, bagi pihak Kerajaan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mewujudkan dan mengeluarkan kepada Tabung, dalam apa-apa bentuk sebagaimana yang difikirkannya patut, apa-apa nota tak boleh niaga dan nota tanpa bunga atau obligasi-obligasi yang seumpamanya sebagaimana yang Tabung boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima daripada Kerajaan sebagai ganti apa-apa mata wang Malaysia yang dibayar atau yang kena dibayar oleh Kerajaan di bawah seksyen 5(b) Perkara 4 Perjanjian atau di bawah seksyen 5(c) Perkara 4 Perjanjian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menurut seksyen 4 Perkara 4 Perjanjian, memutuskan untuk menerima sebagai ganti apa-apa mata wang Malaysia berhubungan dengan apa-apa penambahan sumbangan Malaysia kepada Tabung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah dipertanggungkan kepada"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Disatukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang yang kena dibayar oleh Malaysia kepada Tabung di bawah seksyen 2(b) Perkara 5 Perjanjian (yang berhubungan dengan penilaian mata wang);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang yang dikehendaki bagi penebusan apa-apa nota atau obligasi yang diwujudkan dan dikeluarkan kepada Tabung di bawah seksyen 6;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang kena dibayar oleh Malaysia kepada Tabung di bawah seksyen 3 Perkara 9 Perjanjian (yang berhubungan dengan hak dan tanggungjawab Negeri-Negeri yang terhenti menjadi anggota Tabung)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang diterima oleh atau bagi pihak Kerajaan Malaysia daripada Tabung hendaklah dibayar ke dalam Kumpulan Wang Disatukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong boleh melalui perintah membuat apa-apa peruntukan sebagaimana yang difikirkan semunasabahnya perlu bagi menguatkuasakan mana-mana peruntukan Perjanjian berhubungan dengan taraf, kekebalan-kekebalan dan keistimewaan- keistimewaan Tabung dan gabenor-gabenor, pengarah- pengarah eksekutif, anggota-anggota silih ganti, pegawai-pegawai dan pekerja-pekerja masing-masing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/41/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), apa- apa perintah yang dibuat di bawah subseksyen itu boleh mengisytiharkan bahawa mana-mana peruntukan tertentu dalam Perjanjian hendaklah mempunyai kuatkuasa undang-undang di Malaysia."
      }
    }
  ]
}
