      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Ahli Parlimen (Saraan) (Pindaan) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/47/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/47/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Saraan) (Pindaan) 1991."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/47/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/47/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/47/msa@/~cl_2__subsec_2",
