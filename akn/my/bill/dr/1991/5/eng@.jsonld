      ],
      "schema:name": {
        "@language": "en",
        "@value": "Companies (Amendment) Bill 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Companies"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1991 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6A of the Companies Act 1965, which in this"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act is referred to as \"the principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" after the semicolon in paragraph (10) (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (10) (c) a semicolon and inserting immediately thereafter the word \"or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after paragraph (10) (c), a new paragraph (d) as follows: \"(d) the fact that it is held by, or in the name of, a central depository or its nominee company pursuant to the Securities Industry (Central Depositories) Act Act 1991.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 39 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"and\" after the semicolon in paragraph (1) (h);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of subparagraph ( l )( i )( v) a semicolon and inserting immediately thereafter the word \"and\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, immediately after paragraph ( l )( i ), a new paragraph (j) as follows: \"(j) shall, where the prospectus offers shares, notes or other marketable securities which have been specified by a stock exchange as prescribed securities under section 14 of the Securities Act Industry (Central Depositories) Act 1991, state that such shares, notes or marketable securities have been so prescribed and that applicants are required to have securities accounts when making their applications.\"."
      }
    }
  ]
}
