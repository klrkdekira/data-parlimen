      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Syarikat (Pindaan) 1991"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Syarikat (Pindaan)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "1991 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6A Akta Syarikat 1965, yang disebut \"Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ibu\" dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"or\" selepas koma bertitik dalam perenggan (10) (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (10) (c) dengan koma bertitik dan memasukkan selepas sahaja koma bertitik itu perkataan \"or\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (10) (c), perenggan baru (d) yang berikut: \"(d) the fact that it is held by, or in the name of, a central depository or its nominee company pursuant to the Securities Act Industry (Central Depositories) Act 1991.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"and\" selepas koma bertitik dalam perenggan (l)(h);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung subperenggan (l)(i)(v) dengan koma bertitik dan memasukkan selepas sahaja koma bertitik itu perkataan \"and\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1991/5/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas sahaja perenggan (l)(i), perenggan baru (j) yang berikut: \"(j) shall, where the prospectus offers shares, notes or other marketable securities which have been specified by a stock exchange as prescribed securities under section 14 of the Securities Act Industry (Central Depositories) Act 1991, state that such shares, notes or marketable securities have been so prescribed and that applicants are required to have securities accounts when making their applications.\"."
      }
    }
  ]
}
