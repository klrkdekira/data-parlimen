        "@language": "ms",
        "@value": "Seksyen 35 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \", 20c(3) and 28\" dalam subseksyen (3A) dengan perkataan-perkataan \"and 20c(3)\"."
      }
    }
  ]
}
