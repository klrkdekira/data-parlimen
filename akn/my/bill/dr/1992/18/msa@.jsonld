      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Mahkamah- Tajuk Mahkamah Anak Negeri (Bidang Kuasa Jenayah) ringkas (Pindaan) 1992. RANG UNDANG-UNDANG Pindaan"
