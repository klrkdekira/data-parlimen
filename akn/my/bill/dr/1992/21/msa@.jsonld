        "@value": "Rang Undang-Undang Suruhanjaya Pelabuhan Pulau Pinang (Pindaan) 1992"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/21/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
