      ],
      "schema:name": {
        "@language": "en",
        "@value": "Companies (Amendment) (No. 3) Bill 1992"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Companies (Amendment) (No. 3) Act 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as may be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into force of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 37(2){b) of the Companies Act 1965,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "which is referred to as the \"principal Act\" in this Act, is amended by substituting for the words \"scheme which complies with the provisions of this Act applicable to such schemes\" the words \"offer which complies with the provisions of the relevant law applicable to such offers\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 132G of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (4) the following subsection: \"(4) For the purposes of subsection (1)— (a) a \"person connected with shareholder or a director\" shall have the same meaning as that assigned to a \"person connected with a director\" in section 122A, except that a reference to a member of that shareholder's or director's family shall be limited to that shareholder's or director's spouse and child (including adopted child and step-child); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a reference to a shareholder of an acquiring company is a reference to a shareholder who has a substantial shareholding, as defined in section 69D, in the acquiring company.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after subsection (5), the following subsection: \"(6) This section shall not apply to— (a) subscription of new shares in a company for cash consideration; (b) an arrangement or transaction for the acquisition of shares or assets entered into by a company— (i) and any of its wholly-owned subsidiaries; (ii) and its holding company which holds all the issued shares of the company; or (iii) which is a wholly-owned subsidiary of a holding company and another wholly- owned subsidiary company of that same holding company; (c) an acquisition of any asset, other than shares, by a company from another company where the sale of the relevant asset is part of the ordinary course of business of the second-mentioned company; COMPANIES (AMENDMENT) (No. 3) (d) an acquisition of shares or assets by a company made in pursuance of a scheme of compromise or arrangement approved by the Court under section 176; or (e) an acquisition of shares made by a company in connection with a take-over offer made in accordance with the relevant law applicable to such offers.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 137(2) of the principal Act is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"by virtue of section 179\" the words \"in accordance with the relevant law applicable to take-overs\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 364A(1) of the principal Act is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (d) the following paragraph: \"(d) the Securities Commission established Act under the Securities Commission Act 1992,\"."
      }
    }
  ]
}
