        "@value": "Petroleum Development (Amendment) Bill 1992"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "( 1) This Act may be cited as the Petroleum"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Development (Amendment) Act 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6 of the Petroleum Development Act 1974 is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "amended by inserting, immediately after subsection (3), the following new subsections (3A) and (3B): \"(3A) Subsection (3) shall not apply to any person who is licensed under the Gas Supply Act Act 1992 to supply gas to consumers through pipelines. (3s) For the purpose of subsection (3A), the terms \"gas\", \"consumers\" and \"pipelines\" shall have the same meaning assigned to them respectively by the Gas Supply Act 1992.\"."
      }
    }
