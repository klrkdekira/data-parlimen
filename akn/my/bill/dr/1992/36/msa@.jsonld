      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kemajuan Petroleum (Pindaan) 1992"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "( I) Akta ini bolehlah dinamakan Akta Kemajuan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Petroleum (Pindaan) 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta Kemajuan Petroleum 1974 adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dipinda dengan memasukkan, selepas sahaja subseksyen (3), subseksyen baru (3A) dan (3e) yang berikut: \"(3A) Subseksyen (3) tidak boleh terpakai bagi mana-mana orang yang dilesenkan di Akta bawah Akta Bekalan Gas 1992 untuk membekalkan gas kepada pengguna-pengguna melalui talian paip. (3B) Bagi maksud subseksyen (3A), istilah \"gas\", \"penggur.a\" dan \"talian paip\" hendaklah mempunyai rnakna yang sama yang diberikan kepadanya masing-masing oleh Akta Bekalan Gas 1992.\"."
      }
    }
