      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in the proviso to subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~cl_9__para_b__subpara_i",
