      "schema:text": {
        "@language": "en",
        "@value": "by inserting immediately after paragraph (b) of subsection (1) the following new paragraph (c) \"(c) after due inquiry by a medical review panel, which shall consist of not less than three medical practitioners appointed by the Council, been found to be unfit to perform his professional duties by reason of his mental or physical condition,\"."
      }
    },
