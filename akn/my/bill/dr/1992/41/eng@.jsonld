      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"six months of such period shall be spent in a resident surgical post and six months in a resident medical post, with time spent in midwifery being counted either as time spent in medicine or as time spent in surgery, as the provisionally registered person may elect, for a period not exceeding six months\" appearing in subsection (2) the words \"four months of such period shall be spent in a resident surgical post, four months in a resident medical post and four months in a resident obstetrical and gynaecological post\";"
      }
    },
