      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 39, 40, 41, 42, 43 and 44 of the principal Act shall be deemed to all intents and purposes to have been in force during the period commencing with effect from the 1st October 1986 until the date of the publication in the Gazette of this Act (hereinafter referred to as \"the transitional period\")."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Every act or thing done or notice issued by the Director General during the transitional period that would have been valid if the provisions of the existing section 40 had been in force at the time when it was done or issued, is hereby validated and declared to have been validly done or issued, by the Director General. MEDICAL (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~part_VII__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not have the effect of rendering any person liable to any penalty in respect of any omission to comply with, or in respect of any act done contrary to, the provision of the existing subsection (1) of section 40 and section 41 of the principal Act."
      }
    }
  ]
}
