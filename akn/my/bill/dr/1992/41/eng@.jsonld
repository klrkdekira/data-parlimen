      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 37 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/41/eng@/~cl_9__para_a",
