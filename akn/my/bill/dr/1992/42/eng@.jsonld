        "@value": "in subsection (3), by deleting the words \", on the advice of the Capital Issues Committee,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_4__para_b",
