      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
