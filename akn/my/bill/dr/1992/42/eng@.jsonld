    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 124 the following section: 124. \" Com- 124. (1) The Licensing Officer may pounding compound any offence committed by any of offences. person under Part IV, V or VII by making a written offer to such person to compound the offence if such person pays to the Licensing Officer such sum of money within such period as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer has not been paid within the period specified in the offer or any extension of it which the Licensing Officer may grant, prosecution for the offence may be instituted at any time thereafter against the person to whom the offer is made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been com- pounded under subsection (1), no prosecution shall thereafter be instituted in respect of such offence against the person to whom the offer to compound is made.\". SECURITIES INDUSTRY (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 126 the following section: \" Conduct 126. (1) No prosecution for any offence of pro- under this Act shall be instituted except with secution. the consent in writing of the Public Prosecutor. (2) A prosecution for any offence against any provision of this Act may be conducted by the Registrar or by any officer authorised in writing by the Registrar or by any officer authorised in writing by the Chairman of the Commission.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
