      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding the amendment to Part IV of the principal Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_42__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "every application under that Part pending on the date of coming into force of this Act shall continue to be dealt with by the Registrar; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_42__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "any proceeding or cause of action by or against the Registrar pending or existing on the date of coming into force of this Act in respect of his powers under that Part may be continued or instituted by or against the Registrar, as if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1992/42/eng@/~cl_4__para_a",
