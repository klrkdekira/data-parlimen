      "schema:name": {
        "@language": "en",
        "@value": "( I) This Act may be cited as the Local Government"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may by notification in the Gazette appoint and the Minister may appoint different dates—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into force of this Act in different parts of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into force of different provisions of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into force of different provisions of this Act in different parts of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the Local Government Act 1976, which"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in this Act is referred to as the \"principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"septic tank\" in the definition of \"building\"; and 2 BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Secretary\" the following new definition: \"sewage\" has the same meaning assigned to it under the Sewerage Act Services Act 1993;'. Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 72 of the principal Act is amended— of section 72."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"night-soil, slops,\" in paragraph (d)\\"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering section 72 as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following new subsection (2): \"(2) For the purposes of sections 72 and 73, effluent shall not include sewage.\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 73 of the principal Act is amended— of section 73."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"night-soil, slops,\" in paragraph (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering section 73 as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following new subsection (2): \"(2) Notwithstanding any other provision in this Act, a local authority shall not make, amend or revoke any by-laws in respect of sewage.\". New section"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "128. section 128 the following: Further 128. In addition to the rates referred to in rates. section 127, the local authority may in like manner impose a drainage rate in accordance with section 132.\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 130 of the principal Act is amended— of section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "130."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (b) in subsection (2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (b) in subsection (3). LOCAL GOVERNMENT (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "131."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt it is declared that notwithstanding anything contained in this Act, the law relating to sewerage services for the time being in force in any local authority area shall continue to be in force unless and until this Act is brought into operation with respect to that local authority area."
      }
    }
  ]
