      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perancangan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bandar dan Desa (Pindaan) 1993 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
