      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perancangan Bandar dan Desa (Pindaan) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/11/msa@/~cl_1",
