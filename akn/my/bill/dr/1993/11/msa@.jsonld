      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dan\" di akhir perenggan (b) subseksyen (2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/11/msa@/~cl_2__para_b",
