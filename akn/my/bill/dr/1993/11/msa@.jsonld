      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta Perancangan Bandar dan Desa"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "1976, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/11/msa@/~cl_2__para_a",
