      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"the provision of cess pools, privies, septic tanks, sewage purification plant and other matters relating to the reception or disposal of sewage and\" in paragraph (xix)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt it is declared that notwithstanding anything contained in this Act, the law relating to sewerage services for the time being in force in a local authority area shall continue to be in force unless and until this Act is brought into operation with respect to that local authority area."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
