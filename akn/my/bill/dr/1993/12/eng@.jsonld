      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into force of different provisions of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2__para_c",
