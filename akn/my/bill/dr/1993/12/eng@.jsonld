      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"premises\" the following new definition: ' \"private connection pipe\" has the same meaning assigned to it under the Act Sewerage Services Act 1993;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_2__para_b",
