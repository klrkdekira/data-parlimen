        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may by notification in the Gazette appoint and the Minister may appoint different dates—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into force of this Act in different parts of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_1__subsec_2__para_b",
