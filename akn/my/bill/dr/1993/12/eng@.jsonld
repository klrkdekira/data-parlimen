      },
      "schema:text": {
        "@language": "en",
        "@value": "1974, which in this Act is referred to as the \"principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
