      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"talian letrik\" dalam pcrenggan (i) perkataan \"(selain daripada betung)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (vii);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"membina, menyenggara dan membaiki penakung najis, tandas, tangki najis, loji pembersih kumbahan dan lain-lain perkara berhubung dengan penerimaan atau pembuangan kumbahan dan\" dalam perenggan (viii);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan penghubungannya kepada betung-betung\" dalam perenggan (xviii); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_2",
      "@type": "akn:list",
