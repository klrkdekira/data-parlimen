        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 58 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan seiepas perkataan \"pihak berkuasa tempatan\" dalam perenggan (a) subseksyen (3) perkataan \"dan yang mematuhi Akta Perkhidmatan Pembetungan 1993\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan rujukan birai \"Akta .\" bersetentangan dengan rujukan kepada Akta Perkhidmatan Pembetungan 1993;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (9); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"betung,\", \"tangki najis,\" dan \"loji pembersihan kumbahan,\" di mana-mana jua terdapat dalam subseksyen (14)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memotong seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "60, 62, 63 dan 64."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 70 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan subseksyen (2) dengan yang berikut: \"(2) Seseorang yang bercadang mendirikan sesuatu bangunan hendaklah mengemukakan— (a) kepada pihak berkuasa tempatan apa-apa pelan dan penentuan sebagaimana yang dikehendaki oleh mana-mana undang- undang kecil yang dibuat di bawah Akta ini; dan (b) kepada pihak berkuasa berkanun yang relevan apa-apa pelan dan penentuan berkenaan dengan sistem pembetungan sebagaimana yang dikehendaki oleh mana- mana undang-undang bertulis lain.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 77 Akta ibu adalah dipinda-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"betung\" dalam nota birai perkataan \"awam,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"betung awam,\" dalam seksyen itu perkataan \"paip sambungan persendirian,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_14",
      "@type": "akn:clause",
