      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 81 A k ta ibu adalah dipinda, dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"betung atau\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"mengalirkan kumbahan\" dengan perkataan \"menyalirkan air selain daripada kumbahan\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_15",
