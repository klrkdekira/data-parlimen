      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "memotong perkataan \"BETUNG DAN\" dalam subtajuk."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_10",
      "@type": "akn:clause",
