      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_16__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"peruntukan penakung najis, tandas, tangki najis, pembersih kumbahan dan lain-lain perkara berhubung dengan penerimaan pembuangan kumbahan dan\" dalam perenggan (xix)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan was-was dengan ini ditegaskan bahawa walau apa pun apa-apa jua yang terkandung dalam Akta ini, undang-undang yang berhubungan dengan perkhidmatan pembetungan yang pada masa ini berkuatkuasa dalam kawasan pihak berkuasa tempatan hendaklah terus berkuatkuasa melainkan jika dan sehingga Akta ini mula berkuatkuasa bagi kawasan pihak berkuasa tempatan itu. 6 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/12/msa@/~part_111",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memotong seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "49."
      }
    },
