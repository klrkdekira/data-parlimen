      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"betung,\" dalam nota birai, subseksyen (1) dan perenggan (d) dan (e) subseksyen (4); JALAN, PARIT DAN BANGUNAN (PINDAAN)"
      }
