      "schema:name": {
        "@language": "en",
        "@value": "The Ordinance is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "121 the following new section 12lA: Buildings 121 A. No person shall erect a building or any not to be extension of a building over any sewer unless he erected over shall have obtained the consent of the Director sewers. General and shall have complied with any requirements which may be attached by the Director General to his consent.\". Amendment"
      }
    },
