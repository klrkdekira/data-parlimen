      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Wilayah Persekutuan Labuan (Pindaan Ordinan Kesihatan Awam) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Wilayah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Persekutuan Labuan (Pindaan Ordinan Kesihatan Awam) 1993 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Ordinan adalah dipinda dengan memasukkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas seksyen 121 seksyen baru 12lA yang berikut: Buildings 12lA. No person shatl erect a building or any not to be e x t e n s i on of a building over any sewer unless erected over he shall have obtained the consent of the sewers. Director General and shall have complied with any requirements which may be attached by the Director General to his consent.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 122 Ordinan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (c); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"private sewer\" dan \"priyate sewer or\" di mana-mana jua terdapat dalam seksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12__para_a",
