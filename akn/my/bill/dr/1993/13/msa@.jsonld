      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 130 Ordinan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_14__para_a",
