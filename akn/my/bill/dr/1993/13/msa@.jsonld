      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 110 Ordinan Kesihatan Awam Sabah yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "berkuatkuasa di Wilayah Persekutuan Labuan sebagaimana yang diubahsuaikan oleh Perintah Wilayah Persekutuan Labuan (Pengubahsuaian Ordinan Kesihatan Awam) 1985, yang disebut \"Ordinan\" dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_2__para_a",
