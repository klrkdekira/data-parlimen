      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 123 Ordinan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"cesspool, septic tank\" dalam perenggan (a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di akhir seksyen 123 dengan noktah bertindih dan memasukkan selepas itu proviso yang berikut: \" Provided that any works to be carried out to abate such nuisance in respect of the sewerage system shall be in accordance with the rules, regulations and by-laws made pursuant to the Act Sewerage Services Act 1993.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Ordinan adalah dipinda dengan memotong seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "125 dan 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_14",
      "@type": "akn:clause",
