      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan yang berikut; \"(1) Without prejudice to the generality of section 111 a local authority may and shall where so required by the Yang di-Pertua Negara, provide, repair and maintain such public drains as may be necessary for effectually draining and cleansing its area.\";"
      }
    },
