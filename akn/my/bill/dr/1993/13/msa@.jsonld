      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 131 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memotong perkataan \", cesspools, septic tanks, sewers\" dan \"or night soil\"."
      }
    },
