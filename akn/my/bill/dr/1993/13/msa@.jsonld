      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"Sewerage seryices and\" dalam nota birai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_4__para_b",
