      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"closet\" takrif baru yang berikut: \"Director General\" means Director General of Sewerage Services appointed under section 8 of the Act Sewerage Services Act 1993;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"sanitary convenience\" takrif baru yang berikut: \"sewage\" has the same meaning assigned to it under the Sewerage Services Act 1993; \"sewerage system\" has the same meaning assigned to it under the Sewerage Services Act 1993'."
      }
    },
