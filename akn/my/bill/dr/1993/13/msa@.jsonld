      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"and night soil\" dalam perenggan (d) subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/13/msa@/~cl_15",
