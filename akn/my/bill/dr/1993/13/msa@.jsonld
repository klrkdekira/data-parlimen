      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \", cesspools, septic tanks, private sewers\" dan \"and the collection, removal and disposal of night soil\" dalam perenggan (b) subseksyen (1); dan ORDINAN KESIHATAN AWAM)"
      }
    },
