    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Federal Territory of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Labuan (Amendment of Local Government Ordinance) Act 1993 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
