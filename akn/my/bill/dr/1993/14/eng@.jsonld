      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 49 of the Local Government Ordinance of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Sabah in force in the Federal Territory of Labuan as modified by the Federal Territory of Labuan (Modification of Local Government Ordinance) Order 1984, which in this Act is referred to as the \"Ordinance\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"town planning\" in subsection (23) the words \"and the Sewerage Services Act 1993\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting the marginal reference \"Act against the reference to the Sewerage Services Act 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_3",
