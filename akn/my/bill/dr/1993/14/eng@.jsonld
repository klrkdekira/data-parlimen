      "schema:name": {
        "@language": "en",
        "@value": "Section 83 of the Ordinance is amended by deleting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "paragraph (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/eng@/~cl_4",
