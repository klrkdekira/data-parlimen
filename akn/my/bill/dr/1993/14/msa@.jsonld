      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Wilayah Persekutuan Labuan (Pindaan Ordinan Kerajaan Tempatan) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Wilayah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Persekutuan Labuan (Pindaan Ordinan Kerajaan Tempatan) 1993 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 49 Ordinan Kerajaan Tempatan Sabah yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "berkuatkuasa di Wilayah Persekutuan Labuan sebagaimana yang diubahsuaikan oleh Perintah Wilayah Persekutuan Labuan (Pengubahsuaian Ordinan Kerajaan Tempatan) 1984, yang disebut \"Ordinan\" dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"town planning\" dalam subseksyen (23) perkataan \"and the Sewerage Services Act 1993\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan rujukan birai \"Act bersetentangan dengan rujukan kepada Akta Perkhidmatan Pembetungan 1993. 2 RANG UNDANG-UNDANG Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 83 Ordinan adalah dipinda dengan memotong seksyen 83. perenggan (b). Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 97(1) Ordinan adalah dipinda dengan seksyen 97. memotong perkataan \"sewerage\"."
      }
    }
  ]
