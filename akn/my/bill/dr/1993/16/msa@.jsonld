      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 2(d), 25(a) dan 25(c), subperenggan 25(b)(i) dan seksyen 21, 23, 24, 26 dan 27 hendaklah berkuatkuasa bagi tahun taksiran 1993 dan tahun-tahun taksiran yang kemudian- nya;"
      }
    },
    {
