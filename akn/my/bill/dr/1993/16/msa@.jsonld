      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/16/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Penggalakan Pelaburan (Pindaan) 1993 dan hendaklah disifatkan telah mula berkuatkuasa pada Ihb November 1991 dan hendaklah berkuatkuasa bagi tahun taksiran 1992 dan tahun-tahun taksiran yang kemudiannya."
      }
    },
    {
