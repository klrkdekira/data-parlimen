    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Societies (Amendment) Act 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 17 of the Societies Act 1966, which in this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "is referred to as the \"principal Act\", is amended by substituting for subparagraph (1) (b) (ii) the following: \"(ii) in all other cases, to members of the society according to the rules of the society, or if there be no such rules, then the Official Assignee or such other officer shall prepare a scheme for the application of such surplus assets for the approval of the High Court;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 17B (4) of the principal Act is deleted."
      }
    }
  ]
