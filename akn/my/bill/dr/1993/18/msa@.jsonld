      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pertubuhan (Pindaan) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
