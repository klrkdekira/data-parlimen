        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pertubuhan (Pindaan) 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta Pertubuhan 1966, yang disebut"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan subperenggan (1) (b) (ii) dengan yang berikut: \"(ii) dalam segala hal lain, kepada anggota-anggota pertubuhan mengikut kaedah-kaedah pertubuhan itu, atau jika tidak ada kaedah- kaedah sedemikian, maka Pegawai Pemegang Harta atau mana-mana pegawai lain hendaklah menyediakan suatu skim bagi penggunaan aset yang lebih itu untuk kelulusan Mahkamah Tinggi;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 17s (4) kepada Akta ibu adalah dipotong."
      }
    }
  ]
