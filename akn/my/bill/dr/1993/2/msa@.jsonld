      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 32(1) Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_7__para_a",
