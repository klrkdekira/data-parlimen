      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Suruhanjaya Pelabuhan Pulau Pinang (Pindaan) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pelabuhan Pulau Pinang (Pindaan) 1993 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas seksyen 38, seksyen baru 38A yang berikut: Power to 38A. The Commission may, with the approval write off of the Minister, authorise the writing off of bad debt. any debt due to the Commission which the Commission considers bad or irrecoverable.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memotong seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "49 dan tajuk \"Audit of Accounts\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "selepas seksyen 58, seksyen baru 58A yang berikut: Additional 58A, (1) In addition to the duties provided duties of under this Act, the Commission may, with the the Com- mission. approval of the Minister, operate any port- related activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "In the exercise of the duties subsection (1) the Commission may expend such moneys as are necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "For the purposes of this section, \"port- related activities\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "activities performed outside a port which relate to any duty of the Commission or to operate or maintain a port or the transportation of goods through the port; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "the development, operation maintenance outside the port of marinas and other properties necessary for the furtherance of any duty of Commission'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 60(5) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan-perkataan \"five hundred dollars\" dengan perkataan-perkataan \"one thousand ringgit\"."
      }
    },
