      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berikut: \"(3A) The Commission may dispose of any capital asset or any asset kept in the store which is no longer required by the Commission.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 31(2) dengan seksyen 31(2) baru yang berikut: \"(2) In this section \"water authority\" means the Penang Water Authority established under En. section 3 of the Penang Water Authority 7/1972. Enactment 1972.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/2/msa@/~cl_7",
