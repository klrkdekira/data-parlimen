      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/28/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi dua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "puluh dua bilion tujuh ratus enam puluh dua juta tiga ratus lima puluh tiga ribu dan tujuh ratus tiga puluh ringgit (RM22,762,353,730) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 1994 adalah dengan ini dibenarkan, dan wang tersebut diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
