        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Trade Descriptions (Amendment) Bill 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Trade Descriptions"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1993 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Trade Descriptions Act 1972, which in this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "is referred to as the \"principal Act\", is amended in the national language text by substituting for the words \"penunjokan\" and \"penunjukan\" wherever they may appear the word \"petunjuk\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"goods\" the following definition: ' \"precious metal\" means gold, silver or platinum in its fine form or gold, silver or platinum alloy;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"ship\" the following definition: ' \"standard of fineness\", in relation to articles made of precious metals, means the number of parts by weight of fine gold, silver or platinum in one thousand parts by weight of precious metal;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 4(1) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for paragraph (e) the following paragraph: \"(e) the standard of fineness of articles made of precious metals;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 21 the following section: Com- 21 A. (1) The Controller or a Deputy pounding Controller may compound any offence under of offences. this Act or any regulations made thereunder which is prescribed to be a compoundable offence by making a written offer, to the person reasonably suspected of having committed such offence, to compound the offence upon payment to the Controller or Deputy Controller such sum of money within such time as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer, or within such extended period as the Controller or Deputy Controller may grant, prosecution for the offence may be instituted at any time thereafter against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has compounded under subsection prosecution shall thereafter be instituted against such person in respect of such offence and where possession has been taken of any goods or documents under this Act or any regulations made thereunder such goods or documents may be released, subject to such conditions as may be imposed. TRADE DESCRIPTIONS (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The power to compound offences under subsection (1) shall be exercised by the Controller or the Deputy Controller personally.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 38A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: \"(ba) prescribe the fee to be imposed in respect of the use of any expression or indication used in the course of trade or business in relation to the prices of goods or to the charges or rates for services, accommodation or facilities;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (d) a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/32/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (d) the following paragraphs: \"(e) prescribe the standard of fineness of articles made of precious metals and regulate or control the use of any expression or indication used in the course of trade or business in relation to such standard of fineness; (f) prescribe the offences under this Act or the regulations made thereunder which may be compounded, amount of such compound and the procedure to be followed compounding.\"."
      }
    }
  ]
}
