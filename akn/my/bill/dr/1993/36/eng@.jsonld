      ],
      "schema:name": {
        "@language": "en",
        "@value": "Sales Tax (Amendment) Bill 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Sales Tax (Amendment) Act 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Sales Tax Act 1972, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"company\" the following definition: ' \"computer\" has the meaning assigned Act 56 thereto in section 3 of the Evidence Act 1950;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Director General\" the following definitions: ' \"document\" has the meaning assigned thereto in section 3 of the Evidence Act Act 56. 1950; \"electronic data interchange\" means the transfer, from computer to computer, of commercial and administrative transactions using an agreed message standard to structure the data pertaining transaction;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 43 of the principal Act is amended in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "paragraph (g) by substituting for the expression \"(3)\" the expression \"(2)\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 64 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the word \"qualified\" the word \"public\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The proviso to section 66 of the principal Act is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "amended by inserting after the words \"which are not so printed or issued\" the words \"as aforesaid, or permit the use of any form submitted through an electronic data interchange\"."
      }
    }
  ]
}
