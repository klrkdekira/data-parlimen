      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Cukai Jualan (Pindaan) 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Jualan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Cukai Jualan 1972, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"di- tetapkan\" takrif yang berikut: \"dokumen\" mempunyai erti yang Akta 56. diberikan kepadanya dalam seksyen 3 Akta Keterangan 1950;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif-\"Ketua Pengarah\" takrif yang berikut: \"komputer\" mempunyai erti yang Akm 56. diberikan kepadanya dalam seksyen 3 Akta Keterangan 1950;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas \"peratoran2\" takrif yang berikut: \"pertukaran data elektronik\" ertinya pemindahan, dari komputer ke komputer, transaksi perdagangan dan pentadbiran dengan menggunakan standard perutusan yang dipersetujui untuk menstrukturkan data yang berhubungan dengan transaksi;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 43 Akta ibu adalah dipinda dalam perenggan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(g) dengan menggantikan ungkapan \"(3)\" dengan ungkapan \"(2)\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 64 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "jnenggantikan perkataan \"berkelayakan\" dengan perkataan \"awam\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Proviso kepada seksyen 66 Akta ibu adalah dipinda dengan memasukkan selepas perkataan \"yang tidak di- chetak atau di-keluarkan sa-demikian\" perkataan \"seperti yang disebut terdahulu, atau membenarkan penggunaan apa-apa borang yang dikemukakan melalui pertukaran data elektronik\"."
      }
    }
  ]
}
