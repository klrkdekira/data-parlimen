      "schema:name": {
        "@language": "en",
        "@value": "Constitution (Amendment) (No. 2) Bill 1993"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) (No. 2) Act 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 2 and 4 shall be deemed to have come into force on the 20th November 1992."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 113 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"the Election Commission shall\" in paragraph (i) of Clause (3A) the words \", subject to Clause (3B),\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (3A) the following new \"(3B) Where an amendment to Article 46 or a law enacted by the Legislative Assembly of a State referred to in paragraph (i) of Clause (3A) comes into force after the lapse of eight years from the date of completion of the last review under Clause (2) and the Election Commission are of the opinion that it is necessary to undertake a review under Clause (2), the Election Commission shall not undertake a review under paragraph (i) of Clause (3A) but shall instead undertake a 2 BILL review under Clause (2) and in conducting such review shall take into account any area which is affected in consequence of the amendment or the law referred to in paragraph (i) of Clause (3A).\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Eighth Schedule to the Federal Constitution is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "amended by inserting after the words \"section 1(2),\" in Schedule. section 22 the words \"section 1A,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Constitution (Amendment) Act 1992"
      },
      "schema:text": {
        "@language": "en",
        "@value": "amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by repealing section 3 as if it had not been part of the Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1993/5/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in section 4, by deleting the words \"following the review undertaken pursuant to Clause (3A) of Article 113 of the Federal Constitution and the said Thirteenth Schedule\"."
      }
    }
  ]
}
