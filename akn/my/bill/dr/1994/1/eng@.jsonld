      "schema:text": {
        "@language": "en",
        "@value": "ACADEMY OF SCIENCES MALAYSIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MEMBERSHIP OF THE ACADEMY"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection 9(5) and subsection (3), the Fellows of the Academy shall be elected from such Malaysian citizens who by virtue of their respective achievements in the field of science, engineering or technology are regarded as being of exceptional merit and distinction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), the honorary Fellows of the Academy shall be elected from such persons, not being Fellows, who have made or are making a distinguished contribution to the practice of science, engineering or technology which will benefit, or will be able to contribute to the work of, the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "No person may become a Fellow or honorary Fellow unless he has been elected as such by the Academy in an annual general meeting and no candidate shall be put forward for election unless his name has been submitted to the Council in the manner determined by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "From amongst the Fellows, there shall be appointed, by the Council, Senior Fellows who are persons who have made a contribution to the nation and their appointment shall be based on the recommendation of a special panel comprising members and non-members of the Academy as appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A Senior Fellow appointed under subsection (4) shall be entitled to be addressed as an Academician and be paid a special allowance for life by the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "A Fellow shall cease to be a member of the Academy"
      },
      "schema:text": {
        "@language": "en",
        "@value": "if he—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "is convicted of an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "is of unsound mind or is otherwise incapable of discharging his duties; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "is adjudicated a bankrupt."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may by resolution make a recommendation to the Academy to terminate the membership of a Fellow if he has been guilty of conduct which, in the opinion of the Council, renders him unfit to be a member of the Academy or will bring it into disrepute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Before the recommendation under subsection (1) is brought to the Academy for a decision the Fellow concerned shall be given an opportunity to give an explanation in writing to the Council stating the reasons as to why his membership should not be terminated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Upon consideration of the written explanation given by the Fellow under subsection (2) the Council shall forward its findings and recommendation to the Academy whose decision on the matter, made through its annual general meeting or extraordinary general meeting, shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Academy shall consist of the following categories of members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "Fellows; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "honorary Fellows."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), the members of the Academy shall be entitled to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the facilities of the Academy as may be decided by the Council, from time to time, subject to such terms and conditions as may be determined by the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such privileges as may be conferred upon them by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may restrict the use of the facilities of the Academy to any category of members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "No right or privilege of a member of the Council or Academy shall be transferable, but any such right or privilege shall cease upon the member of the Council or Academy ceasing to be such whether by death, retirement or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The first Fellows of the Academy shall comprise fifty Foundation Fellows appointed by the Minister from among eminent Malaysian citizens who are regarded by virtue of their respective achievements in the field of science, engineering or technology as being of exceptional merit and distinction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "There is hereby established an academy by the name"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of \"Academy of Sciences Malaysia\" which shall be a body corporate with perpetual succession and a common seal, and which may sue and be sued in its corporate name and, subject to and for the purposes of this Act, may enter into contracts and may acquire, purchase, take, hold and enjoy movable or immovable property of every description and may convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with any movable or immovable property or any interest therein vested in the Academy upon such terms as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The object of the Academy is the pursuit,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "encouragement and maintenance of excellence in the fields of science, engineering and technology in order to promote the advancement of the art and practice of science, engineering and technology for the development of the nation and the benefit of mankind."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Academy are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to promote and foster the development of science, engineering and technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to provide a forum for the interchange of ideas among scientists, engineers and technologists;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to promote national awareness, understanding and appreciation of the role of science, engineering and technology in human progress;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to promote creativity among scientists, engineers and technologists;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to promote national self-reliance in the field of science, engineering and technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to act as a forum for maintaining awareness on the part of the Government of the significance of the role of science, engineering and technology in the development process of the nation and for bringing national development needs to the attention of the scientists, engineers and technologists;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to analyse particular national problems and identify where science, engineering and technology can contribute to their solution and accordingly to make recommendations to the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to keep in touch with developments in science, engineering and technology and identify those developments which are relevant to national needs and to bring such developments to the attention of the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to prepare reports, papers or other documents relating to the national science, engineering and technology policy and make the necessary recommendations to the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to initiate and sponsor multi-disciplinary studies related to and necessary for the better understanding of the social and economic implications of science, engineering and technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to encourage research and development and education and training of the appropriate scientific, engineering and technical man- power;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to establish and maintain relations between the Academy and overseas bodies having the same or almost similar objectives in science, engineering and technology as the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as may be requested by the Government from time to time; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other acts which are consistent with this Act as may be required in order to further the advancement of science, engineering and technology in Malaysia and the welfare and status of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of carrying out the functions of the Academy and managing the affairs of the Academy, there is established a Council comprising—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the President;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Vice-President;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary-General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Treasurer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "twelve other members, who shall all be Fellows of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The President shall be appointed by the Yang di- Pertuan Agong on the recommendation of the Minister, whose recommendation is made after the Minister has consulted the Council, and the President shall hold office for three years from the date of his appointment and shall be eligible for re-appointment provided that he shall not hold office consecutively for a period exceeding six years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Vice-President, the Secretary-General, the Treasurer and the twelve other members shall be elected by the Fellows at the annual general meeting of the Academy and shall hold office for two years from the date of election and shall be eligible for re-election to the same post provided that they shall not hold office consecutively for a period exceeding four years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Schedule shall apply to the Council and the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Council are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate policy relating to the functions of the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to administer the affairs of the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint such officers or servants of the Academy as are necessary for the due administration of the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to supervise and control its officers and servants;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to administer the Fund; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to convene general meetings of the Academy to decide on matters which under this Act are required to be decided by the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint one or more committees as it considers necessary or expedient to assist it in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The number and term of office of the members of a committee appointed under this section, and the number of the members necessary to form a quorum, shall be decided by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A committee appointed under this section may include persons who are not members of the Council but who shall be members of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "There is established a fund to be known as the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Academy of Sciences Malaysia Fund which shall be administered by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "There shall be paid into the Fund—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "such sums of money as may be appropriated from time to time by Parliament from the Federal Consolidated Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "all monies received by the Academy by way of any donation, grant or bequest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "all monies earned or arising from any investment made under section 16 or from any property, mortgage, charge or debenture;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "all monies borrowed by the Council under section 17; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "all other monies and properties which may in any manner become payable to or be vested in the Academy in respect of any matter incidental to its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be used for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to make disbursements for salaries, allowances, expenses and other administrative costs incurred for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to provide awards, fellowships, scholarships and research grants; ACADEMY OF SCIENCES MALAYSIA 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to sponsor research projects undertaken by scientific organisations, institutions of higher learning and individuals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to publish and purchase magazines, books and articles relating to science, engineering or technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "organisation of seminars, expositions and other similar activities relating to science, engineering or technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to pay for the rental, or purchase of a site for and the construction, of any building for the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to pay for the rental or purchase of equipment and materials for the purposes of the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to repay any monies borrowed by the Council under section 17; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to pay any other expenses properly incurred by the Council in the execution of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Council may, from time to time, invest such"
      },
      "schema:text": {
        "@language": "en",
        "@value": "moneys of the Fund as are not immediately required to be expended under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "in any investments or securities authorised for the investment of trust funds by any written law for the time being in force; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "in such other investments or securities as the Council thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Council may, with the approval of the Minister"
      },
      "schema:text": {
        "@language": "en",
        "@value": "and upon such terms and conditions as may be determined by him, borrow such sums as it may require for the execution of any of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Academy of Sciences"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Malaysia Act 1994 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Academy\" means the Academy of Sciences Malaysia established under section 3; \"Council\" means the Council of the Academy established under section 6; \"Fellow\" means a Fellow elected under section 10 and includes a Senior Fellow; \"Fund\" means the Academy of Sciences Malaysia Fund established under section 13; \"general meetings of the Academy\" means the ordinary general meetings, annual general meetings and extraordinary general meetings of the Academy; \"members\" means Fellows and honorary Fellows of the Academy; \"Minister\" means the Minister for the time being charged with the responsibility for science and technology; \"national science, engineering and technology policy\" means the legislative and executive measures adopted by the Government to develop, organise and utilise the national scientific, engineering and technological potential with the objective of achieving the nation's overall development aim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Academy shall have a common seal and such seal may from time to time be broken, changed, altered or made anew as the Council may think fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Council, a stamp bearing the words \"Academy of Sciences Malaysia\" may be used and shall be deemed to be the common seal of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the President or such other person as may be authorised by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall not be affixed to any instrument except in the presence of the President and two other members of the Council who shall sign their names to the instrument in token of such presence, and the signatures shall be sufficient evidence that the seal was duly and properly affixed and is the lawful seal of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any document or instrument which, if executed by a person not being a body corporate, would not be required to be under seal, may in like manner be executed by the Council and such document or instrument may be executed on behalf of the Council by any officer or servant of the Academy generally or specially authorised by the Council in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Academy shall be officially and judicially noticed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "All officers and servants of the Academy shall be"
      },
      "schema:text": {
        "@language": "en",
        "@value": "deemed to be public servants within the meaning of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Council may, from time to time, with the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "approval of the Minister, make regulations with respect to the conditions of service of the officers and servants of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, from time to time, with the approval of the Minister, make regulations with respect to the discipline of the officers and servants of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section may include provisions for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the interdiction with reduction in salary or in other remuneration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the suspension without salary or other remuneration, of an officer or servant of the Academy during the pendency of disciplinary proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section shall create such disciplinary offences and provide for such disciplinary punishments as the Council may deem appropriate, and the punishments so provided may extend to dismissal or reduction in rank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section may, in prescribing the procedure for disciplinary proceedings, provide for an opportunity for representations to be made by the person against whom the disciplinary proceedings are taken before a decision is arrived at by the Council on the disciplinary charge laid against such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, with the approval of the Minister, make such regulations as may be expedient or necessary for the better carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the proceedings of the Academy and the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing generally for the performance of the functions and the exercise of the powers of the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the administration of the Fund; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~part_V__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe anything which under this Act may or is required to be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(subsection 6(4)) PROVISIONS RELATING TO THE COUNCIL AND THE ACADEMY"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_1__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "The Council shall maintain a roll of members in which shall"
      },
      "schema:text": {
        "@language": "en",
        "@value": "be inscribed the names of all its members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The President shall be the'chairman of the Council and shall preside at all meetings of the Council and the Academy at which he is present. (2) In the absence of the President, the Vice-President shall preside, and in the absence of the President and the Vice-President, the Council shall elect one of its members to preside."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_2__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 6, the first Council shall comprise the Foundation Fellows appointed under subsection 9(5) from among whom the Minister shall appoint the President, the Vice-President, the Secretary-General, the Treasurer and the twelve other members and they shall hold office until the next Council of the Academy is appointed or elected, as the case may be, in accordance with section 6. (2) Of the twelve other members of the first Council, six members shall cease to hold office at the end of the first year of their appointment and six at the end of the second year of their appointment; the selection of those of them who are so to cease to hold office shall be made by agreement amongst them and if no such agreement can be obtained, and if the President in his absolute discretion so decides, by the drawing of lots at a meeting of the Council and the vacancies thus created shall be filled by fresh elections. (3) Subject to section 6, members of the Council who retire under subparagraph (2) are eligible for election if they are not disqualified, on any of the grounds provided in paragraph 3, from holding office. (4) The Council shall ensure that the twelve other members of the Council elected shall at all times represent the various fields of activity of the Academy so as to preserve as far as possible a reasonable balance among the members of the Council and to reflect the inter-disciplinary character of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Council shall vacate his office if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "he ceases to be a Fellow;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a paid official of the Academy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "he resigns his office; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "except the President, he is removed from office by a resolution passed in an annual general meeting or extraordinary general meeting of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "The members of the Council may act in the discharge of their"
      },
      "schema:text": {
        "@language": "en",
        "@value": "functions or duties in their office notwithstanding any vacancy existing in their number."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Any casual vacancy arising in the membership of the Council"
      },
      "schema:text": {
        "@language": "en",
        "@value": "may be filled by any Fellow of the Academy appointed by the President and the Fellow shall hold office only for the unexpired period of his predecessor's term of office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet at least four times in each calendar year at such time and place as it may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "Eight members personally present at any meeting of the Council shall constitute the quorum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the majority of the members of the Council present and voting at any meeting of the Council shall be deemed to be a decision of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The chairman or member presiding at any meeting of the Council shall have an original and a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "No remuneration is payable to any member of the Council for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "holding office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subparagraph (2), the annual general meeting of the Academy shall be held in the first four months of each calendar year, and at such time as may be appointed by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "An extraordinary general meeting of the Academy may be convened at any time by the Council and shall be convened by the Council on a requisition by not less than one-fifth of the total number of the Fellows of the Academy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The ordinary general meetings of the Academy shall be held at such place and at such time as may be appointed by the Council to discuss scientific, engineering or technological or other matters of concern to the members and shall be open to all Fellows and such other persons as the Council may determine. BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The procedure for the general meetings of the Academy and for service of notices shall be in accordance with the regulations as prescribed by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/1/eng@/~sched_1__para_9",
