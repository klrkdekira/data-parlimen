      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Elections Act 1958 is amended in subsection 4(4) by substituting for the words \"a deputy\" in paragraph (a) and \"deputy\" in paragraph (b) the words \"an assistant returning officer\" and \"assistant returning officer\" respectively."
      }
