      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Elections (Amendment) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/10/eng@/~cl_2",
