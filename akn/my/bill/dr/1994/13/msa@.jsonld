      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perempuan Bersuami (Pindaan) 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perempuan Bersuami (Pindaan) 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perempuan Bersuami 1957, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan memasukkan selepas seksyen 4, seksyen berikut: 4A. A husband or a wife shall be entitled to sue each other in tort for damages in respect of injuries to his or her person, as the case may be, in the like manner as any other two separate individuals.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu adalah dipinda dengan menggantikan subseksyen (2) dengan yang berikut; \"(2) A husband or a wife shall be entitled to sue each other in tort for the protection or security of his or her property, as the case may be.\". RANG UNDANG-UNDANG"
      }
    }
  ]
