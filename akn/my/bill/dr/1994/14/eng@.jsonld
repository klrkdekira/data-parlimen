      "schema:name": {
        "@language": "en",
        "@value": "Article 121 of the Federal Constitution"
      },
      "schema:text": {
        "@language": "en",
        "@value": "amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1), by substituting for the word \"Borneo\" in paragraph (b) the words \"Sabah and Sarawak\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (1A) the following \"(1B) There shall be a court which shall be known as the Mahkamah Rayuan (Court of Appeal) and shall have its principal registry in Kuala Lumpur, and the Court of Appeal shall have the following jurisdiction, that is to say— (a) jurisdiction to determine appeals from decisions of a High Court or a judge thereof (except decisions of a High Court given by a registrar or other officer of the Court and appealable under federal law to a judge of the Court); and (b) such other jurisdiction as may be conferred by or under federal law.\"; BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Mahkamah Agung (Supreme Court)\" and \"Supreme Court\" the words \"Mahkamah Persekutuan (Federal Court)\" and \"Federal Court\" respectively; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (a) the following paragraph: \"(a) jurisdiction to determine appeals from decisions of the Court of Appeal, of the High Court or a judge thereof;\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (4), by substituting for the words \"Borneo\" and \"Justice\" the words \"Sabah and Sarawak\" and \"Judge\" respectively."
      }
    },
