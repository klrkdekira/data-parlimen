      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 87 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10__para_a__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (2)— (i) by substituting for the words \"Lord President of the Supreme Court\" in paragraph (a) the words \"Chief Justice of the Federal Court\"; and CONSTITUTION (AMENDMENT)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Supreme Court or a High Court\" in paragraph (a) the words \"Federal Court, the Court of Appeal or a High Court\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in Clauses (3) and (4), by substituting for the word \"Supreme\" the word \"Federal\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_11",
      "@type": "akn:clause",
