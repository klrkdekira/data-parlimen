      "schema:name": {
        "@language": "en",
        "@value": "Article 105 of the Federal Constitution is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (3) by substituting for the word \"Supreme\" the word \"Pederal\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_12",
