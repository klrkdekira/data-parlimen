      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1A)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_14__para_c__subpara_i",
      "@type": "akn:subparagraph",
