      "schema:text": {
        "@language": "en",
        "@value": "for Article 134 the following Article: 134. (1) The Federation may, at the request of a State, local authority, or statutory authority or of any organisation, in or outside Malaysia, second any member of its public services to the service of that State, authority or organisation, as the case may be; and a State may, at the request of the Federation, another State, a local authority or a statutory authority or of any organisation, in or outside Malaysia, second any member of its own public service to the service of the Federation, other State, authority or organisation, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A person seconded under this Article shall remain a member of the service to which he belongs, but his remuneration shall be paid by the Federation, State, authority or organisation, as the case may be, to whose service he is seconded.\". BILL"
      }
    },
