      "schema:text": {
        "@language": "en",
        "@value": "in section 1, by inserting after subsection (1) the following subsection: \"(1A) In the exercise of his functions under the Constitution of this State or any law or as a member of the Conference of Rulers, where the Ruler is to act accordance with advice or on advice, the Ruler shall accept and act in accordance with such advice.\";"
      }
    },
