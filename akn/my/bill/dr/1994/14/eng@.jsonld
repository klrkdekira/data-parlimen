      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_14__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_14__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Lord President of the Supreme Court\"), of the Chief Justices of the High Courts\" the words \"Chief Justice of the Federal Court\"), of the President of the Court of Appeal, of the Chief Judges of the High Courts\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/14/eng@/~cl_14__para_c",
