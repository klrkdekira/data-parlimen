        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 70 of the principal Act is amended— of section 70."
      }
    },
