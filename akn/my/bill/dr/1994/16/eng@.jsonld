      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words \"subsections (3) and\" the word \"subsection\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_6__para_b",
