      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Subordinate Courts (Amendment) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_10__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 78 of the principal Act is amended by substituting for the word \"Justice\" in paragraphs (a) and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "the word \"Judge\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 93 of the principal Act is amended in subsection (1) by substituting for the proviso thereto the Following proviso: 'Provided that for the purpose of proceedings in Magistrates' Courts, section 13(b) shall be read as if the words \"twenty-five thousand\" were substituted for the words \"two hundred and fifty thousand\".'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 106 of the principal Act is amended by substituting for the word \"Justice\" the word \"Judge\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Third Schedule to the principal Act is amended by inserting after paragraph 26 the following paragraph: \"Interim 26A. Power to make interim payments.\". payments."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Subordinate Courts Act 1948, which in this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "is referred to as the \"principal Act\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"Chief Justice\" the following definition: \"Chief Judge\" means the Chief Judge of the High Court in Malaya or of the High Court in Sabah and Sarawak, as the case may require;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"Borneo\" in the definition of \"High Court\" the words \"Sabah and Sarawak\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"Judge\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (b) in the definition of \"local jurisdiction of the High Court\" the following paragraph: \"(b) in the case of the High Court in Sabah and Sarawak, the territory comprised in the States of Sabah and Sarawak;\". BILL Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 4 of the principal Act is amended by of section 4. substituting for the word \"Justice\" the word \"Judge\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
