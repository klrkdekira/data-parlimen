        "@value": "Subordinate Courts (Amendment) Bill 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_1",
      "@type": "akn:clause",
