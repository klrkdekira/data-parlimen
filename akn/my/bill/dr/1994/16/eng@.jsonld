      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (3). Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 72 of the principal Act is amended by deleting of section 72. the words \"where the amount of rent to be distrained does not exceed ninety-six thousand ringgit\". Amendment"
      }
