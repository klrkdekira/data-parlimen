      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Mahkamah Rendah (Pindaan) 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Mahkamah Rendah (Pindaan) 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 78 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Justice\" dalam perenggan (a) dan (b) dengan perkataan \"Judge\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 93 Akta ibu adalah dipinda dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen (1) dengan menggantikan proviso kepadanya dengan proviso yang berikut: 'Provided that for the purpose of proceedings in Magistrates' Courts, section 13(b) shall be read as if t he words \"twenty-five substituted for the words \"two hundred and fifty thousand\".'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 106 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Justice\" dengan perkataan \"Judge\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Ketiga kepada Akta ibu adalah dipinda"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_2__para_d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Mahkamah Rendah 1948, yang disebut \"Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ibu\" dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dalam takrif \"local jurisdiction of the High Court\" dengan perenggan yang berikut: \"(b) in the case of the High Court in Sabah and Sarawak, the territory comprised in the States of Sabah and Sarawak;\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu adalah dipinda dengan seksyen 4. menggantikan perkataan \"Justice\" dengan perkataan \"Judge\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 59 A k ta ibu adalah dipinda dengan seksyen 59. menggantikan perkataan \"Justice\" dalam subseksyen (3) dan (4) dengan perkataan \"Judge\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 65 A k ta ibu adalah dipinda dengan seksyen 65. menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Subject to the limitations contained in this Act, a Sessions Court shall have—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "unlimited jurisdiction to try all actions and suits of a civil nature in respect of motor vehicle accidents, landlord and tenant and distress; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jurisdiction to try all other actions and suits of a civil nature where the amount in dispute or the value of the subject-matter does not exceed two hundred and fifty ringgit.\". Pmdaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 70 Akta ibu adalah dipinda— seksyen 70."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"subsections (3) and\" dengan perkataan \"subsection\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3). Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 72 A k ta ibu adalah dipinda dengan seksyen 72. memotong perkataan \"where the amount of rent to be distrained does not exceed ninety-six thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_8__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 73 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"one hundred\" dalam perenggan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan perkataan \"two hundred and fifty\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 76 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Justice\" dalam subseksyen (3) dengan perkataan \"Judge\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@/~sched_3",
      "@type": "akn:schedule",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan 26 perenggan yang berikut: Interim 26A. Power to make imerim payments.\". payments."
      }
    }
