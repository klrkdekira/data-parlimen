      ],
      "schema:name": {
        "@language": "en",
        "@value": "Subordinate Courts Rules (Amendment) Bill 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Subordinate Courts Rules (Amendment) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Subordinate Courts Rules Act 1955 is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in section 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsections (2) and (3) the following subsections: \"(2) The Committee shall consist of the following persons: (a) the Chief Justice, who shall be the Chairman of the Committee; (b) the President; (c) the Chief Judges; (d) four Judges to be appointed by the Chief Justice for such period as he may specify in writing; (e) the Attorney General, or his nominee; (f) the Senior Judge of the Sessions Court of Kuala Lumpur; (g) three advocates, one practising in the States of West Malaysia, one practising in Sabah and one practising in Sarawak, appointed by the Chief Justice for such period as he may specify in writing; and (h) the Secretary General of the Ministry of Law, or his nominee. (3) In the absence of the Chief Justice, the President or the Chief Judge of the High Court in Malaya or the Chief Judge of the High Court in Sabah and Sarawak present shall be Chairman of the Committee.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/17/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words \"Lord President or a Chief Justice\" the words \"Chief Justice, President or a Chief Judge\"."
      }
    }
  ]
