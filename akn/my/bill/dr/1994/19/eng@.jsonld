      ],
      "schema:name": {
        "@language": "en",
        "@value": "Malayan Railway Provident Fund (Dissolution) Bill 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malayan Railway Provident Fund (Dissolution) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Board\" means the Board of managers established under subsection 4(1) of the Malayan Railway Provident Fund Ordinance 1952; \"Fund\" means the Malayan Railway Provident Fund established under section 3 of the Malayan Railway Provident Fund Ordinance 1952; \"KTMB\" means Keretapi Tanah Melayu Berhad; \"Minister\" means the Minister for the time being charged with the responsibility for transport."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Malayan Railway Provident Fund Ordinance"
      },
      "schema:text": {
        "@language": "en",
        "@value": "1952 is repealed and the Fund established thereunder is dissolved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All movable property and assets that immediately"
      },
      "schema:text": {
        "@language": "en",
        "@value": "before the commencement of this Act were vested in the Fund or in any person on its behalf shall, on the commencement of this Act, be transferred to, and be vested with, KTMB."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subject to section 7 all moneys in the Fund or due to"
      },
      "schema:text": {
        "@language": "en",
        "@value": "be paid to the Fund shall, on the commencement of this Act, be transferred to, and be vested with, KTMB."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All deeds, bonds, agreements, instruments and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "working arrangements subsisting immediately before the commencement of this Act and affecting any of the property transferred under sections 4 and 5, shall be of full force and effect against or in favour of KTMB and enforceable as fully and effectually as if, instead of the Board, the Fund, the Malayan Railway Administration, or any person or body acting on its behalf, KTMB had been named therein or had been a party thereto."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All amounts standing to each depositor's credit in the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Fund that represent contributions to the Fund both by the Malayan Railway Administration as the employer and the depositor since 1st July 1952 together with any dividend, bonus and interest thereon shall be transferred to the Employees Provident Fund established under subsection 24(1) of the Employees Provident Fund Act 1991, and to be dealt with in accordance with the provisions of that Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any civil proceedings or cause of action pending or existing immediately before commencement of this Act by or against the Board or any person acting on its behalf may be continued or instituted by or against KTMB as it might have been by or against the Board or such person as if this Act had not been passed. (DISSOLUTION)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought or any leave to appeal applied for on or after the commencement of this Act against a decision before the commencement of this Act in any legal proceedings to which the Board or any person acting on its behalf was a party may be brought by or against KTMB."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All rules made under section 11 of the Malayan"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Railway Provident Fund Ordinance 1952 shall be repealed immediately upon the commencement of this Act."
      }
    }
  ]
}
