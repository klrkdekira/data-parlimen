        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Askar Timbalan Setia Negeri Johor (Pembubaran dan Pemansuhan) 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Askar Timbalan Setia Negeri Johor (Pembubaran dan Pemansuhan) 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"anggota Askar\" ertinya pegawai dan soldadu Askar Timbalan Setia Negeri Johor; \"angkatan tentera\" hendaklah mempunyai erti yang diberi kepadanya di bawah Akta Angkatan Tentera 1972; \"angkatan tetap\" hendaklah mempunyai erti yang diberi kepadanya di bawah Akta Angkatan Tentera 1972; \"Enakmen\" ertinya Enakmen Askar Timbalan Setia Negeri Johor 1915; \"harta\" termasuklah persenjataan; \"Kerajaan Negeri\" ertinya Kerajaan Negeri Johor; \"Majlis Angkatan Tentera\" ertinya Majlis yang ditubuhkan di bawah Perkara 137 Perlembagaan Persekutuan; \"Menteri\" ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi pertahanan; \"tarikh ditetapkan\" ertinya tarikh yang ditetapkan oleh Menteri di bawah subseksyen 1(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pada tarikh ditetapkan, Askar Timbalan Setia Negeri"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Johor hendaklah dibubarkan dan anggota Askar hendaklah pada tarikh itu diberhentikan daripada perkhidmatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam Akta Angkatan Tentera 1972, anggota Askar yang sebelum sahaja tarikh ditetapkan telah, dengan kelulusan Yang di-Pertuan Agong, diberi opsyen oleh Majlis Angkatan Tentera untuk berkhidmat dalam angkatan tentera dan telah menerima opysen itu hendaklah pada tarikh ditetapkan disifatkan telah ditauliahkan atau didaftarkan dalam angkatan tetap mengikut peruntukan Akta Angkatan Tentera 1972."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Askar yang disebut dalam subseksyen (1)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah ditauliahkan atau didaftarkan untuk berkhidmat dalam angkatan tentera atas terma dan syarat perkhidmatan yang tidak kurang baiknya daripada terma dan perkhidmatan yang anggota itu berhak kepadanya sebelum sahaja tarikh ditetapkan; dan (PEMBUBARAN DAN PEMANSUHAN)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh dikehendaki untuk berkhidmat dalam angkatan tetap bagi suatu tempoh yang lebih panjang daripada tempoh yang baginya anggota itu dikehendaki untuk berkhidmat dalam Askar Timbalan Setia Negeri Johor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini tidak terpakai pada anggota Askar yang berkhidmat di bawah suatu kontrak pekerjaan atau yang di bawah Enakmen adalah atau melebihi umur persaraan sebelum sahaja tarikh ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam Akta ini, anggota Askar yang telah melaksanakan opsyen untuk bersara daripada perkhidmatan Askar Timbalan Setia Negeri Johor hendaklah pada tarikh ditetapkan disifatkan telah bersara di bawah perenggan 10(5)(b) Akta Pencen 1980."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Askar yang disebut dalam subseksyen (1) hendaklah dibayar faedah persaraan sebagaimana diperuntukkan di bawah subperaturan 4(2) Peraturan- Peraturan Pencen 1980."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala harta dan aset selain daripada harta tak alih yang sebelum sahaja tarikh ditetapkan adalah terletakhak pada, atau dalam milikan atau di bawah kawalan atau dipegang bagi pihak, Askar Timbalan Setia Negeri Johor bagi maksud pertahanan hendaklah, pada tarikh ditetapkan dan tertakluk kepada Akta ini, terletakhak pada Kerajaan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan Persekutuan boleh, selepas berunding dengan Kerajaan Negeri, melantik suatu Jawatankuasa Bersama—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membahagikan, dalam hal keraguan, antara Kerajaan Persekutuan dan Kerajaan Negeri apa-apa harta atau aset yang terletakhak pada Askar Timbalan Setia Negeri Johor dengan niat bahawa harta atau aset yang dikehendaki bagi maksud Kerajaan Persekutuan hendaklah dibahagikan kepada Kerajaan itu dan bahawa harta atau aset yang dikehendaki bagi maksud Kerajaan Negeri hendaklah dibahagikan kepada Kerajaan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membahagikan, dalam hal keraguan, harta atau aset itu kepada mana-mana pegawai yang berkenaan bagi apa-apa maksud mengikut kehendak keadaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan Persekutuan hendaklah membayar kepada Kerajaan Negeri apa-apa bayaran wajar yang kena dibuat menurut apa-apa perkiraan kewangan yang dipersetujui antara Kerajaan Persekutuan dan Kerajaan Negeri berkenaan dengan peletakhakan harta dan aset pada Kerajaan Persekutuan yang disebut dalam seksyen 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua bayaran wajar yang kena dibuat di bawah subseksyen (1) hendaklah dipertanggungkan ke atas Kumpulan Wang Disatukan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Enakmen dan semua perundangan subsidiari yang dibuat di bawahnya adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemansuhan di bawah subseksyen (1) itu tidak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyentuh penguatkuasaan terdahulu, atau apa-apa jua yang dilakukan atau dibiarkan dengan sewajarnya di bawah Enakmen, atau mana-mana perundangan subsidiari yang dibuat di bawahnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyentuh apa-apa hak, hakmilik, kepen- tingan, kebebasan, keistimewaan, obligasi atau liabiliti yang diperolehi, terakru atau dilakukan di bawah Enakmen atau mana-mana per- undangan subsidiari yang dibuat di bawahnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyentuh hak-hak anggota Askar kepada apa- apa pencen, ganjaran atau faedah lain di bawah mana-mana undang-undang bertulis yang lain yang berhubungan dengan perkara itu. (PEMBUBARAN DAN PEMANSUHAN)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, pemansuhan Enakmen atau apa-apa jua yang terkandung dalam Akta ini tidak boleh menyentuh liabiliti mana-mana orang untuk didakwa, dihadapkan ke mahkamah tentera atau dihukum bagi kesalahan yang dilakukan di bawah Enakmen sebelum hari ditetapkan, atau apa-apa prosiding yang dibawa atau hukuman yang dikenakan sebelum hari itu berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/20/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, mana-mana prosiding (sama ada jenayah atau sivil) atau kausa tindakan yang belum selesai atau yang ada sebelum sahaja hari ditetapkan oleh atau terhadap mana-mana orang yang bertindak bagi pihak Askar Timbalan Setia Negeri Johor boleh diteruskan atau dimulakan oleh atau terhadap Kerajaan Persekutuan sebagaimana ia boleh diteruskan atau dimulakan oleh atau terhadap orang itu jika Akta ini tidak diluluskan."
      }
    }
  ]
}
