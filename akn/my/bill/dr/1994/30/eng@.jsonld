      ],
      "schema:name": {
        "@language": "en",
        "@value": "Widows' and Orphans' Pensions (Sarawak) (Amendment) Bill 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Widows' and and commence- Orphans' Pensions (Sarawak) (Amendment) Act 1994. ment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint. Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Widows' and Orphans' Pensions Ordinance of of section 2. Sarawak, which in this Act is referred to as the Sarawak Cap 90. \"Ordinance\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"actuary\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"local Federal officer\" the following definitions: ' \"local pensions authority\" means the Director General of Public Service or any officer authorised by him in writing to act on his behalf; \"Minister\" means the Minister of the Federal Government who is for the time being charged with the responsibility for pensions;'. Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 of the Ordinance is amended— of section 3."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) The Fund shall be administered and controlled by a Board of Management comprising— (a) the local pensions authority, who shall be the Chairman; (b) two officers from the Public Service Department, Malaysia, to be appointed by the Director General of Public Service; (c) one officer from the Chief Minister's Department, to be appointed by the State Secretary; (d) two officers from the State Treasury Department, to be appointed by the head of that Department; and (e) at least one member representing the interests of the contributors, to be appointed by the Minister.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsections: \"(2A) Members of the Board, other than the Chairman, shall hold office for such period as may be determined by the respective appointing authorities specified in subsection (2). (2s) The Board shall appoint a Secretary who shall assist the Board in the administration of the Fund.\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 7 of the Ordinance is amended by of section 7. substituting for the words \"approved by the Minister\" the words \"appointed by the Minister\"."
      }
    }
  ]
}
