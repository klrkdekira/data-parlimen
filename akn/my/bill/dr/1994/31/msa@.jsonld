      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pencen Balu dan Anak Yatim (Sabah) (Pindaan) 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pencen Balu dan Anak Yatim (Sabah) (Pindaan) 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Ordinan Pencen Balu dan Anak Yatim, Sabah, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut \"Ordinan\" dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"actuary\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"local Pederal officer\" takrif yang berikut: ' \"local pensions authority\" means the Director General of Public Service or any officer authorised by him in writing to act on his behalf; \"Minister\" means the Minister of the Federal Government who is for the time being charged with the responsibility for pensions;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Ordinan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: \"(2) The Fund shall be administered and controlled by a Board of Management comprising— (a) the local pensions authority, who shall be the Chairman; (b) two officers from the Public Service Department, Malaysia, to be appointed by the Director General of Public Service; (c) one officer from the Chief Minister's Department, to be appointed by the State Secretary; (d) one officer from the State Treasury Department, to be appointed by the head of that Department; (e) the Federal Financial Officer, Sabah, or any officer appointed by him; and (f) at least one member representing the interests of the contributors, to be appointed by the Minister.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Members of the Board, other than the Chairman, shall hold office for such period as may be determined by the respective appointing authorities specified in subsection (2). (PINDAAN) (2B) The Board shall appoint a Secretary who shall assist the Board administration of the Fund.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Ordinan adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"approved by the Minister\" dengan perkataan \"appointed by the Minister\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/31/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Ordinan adalah dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 32A dengan seksyen yang berikut: \"Revision 32A. The Minister may from time to time, on of rates of the recommendation of the Board, revise the pensions. ,, . , . , , . rates 01 pensions payable under Ordinance.\"."
      }
    }
  ]
}
