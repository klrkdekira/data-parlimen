      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan sejumlah wang yang tidak melebihi Ringgit Malaysia lima ratus enam puluh dua juta enam ratus empat belas ribu empat ratus (RM562,614,400) daripada Kumpulan Wang Disatukan bagi perbelanjaan unluk perkhidmatan yang dinyatakan dalam Jadual bagi perkhidmatan tahun 1994, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1994, Akta Perbekalan Tambahan (1993 dan 1994) 1994 dan Akta Perbekalan Tambahan (1994) 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang tersebut itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~sched_1",
      "@type": "akn:schedule",
