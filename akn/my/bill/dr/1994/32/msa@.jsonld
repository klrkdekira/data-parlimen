        "@value": "Rang Undang-Undang Perbekalan Tambahan (1994) (No. 2) 1994"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
