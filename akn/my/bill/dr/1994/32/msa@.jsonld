    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/32/msa@/~cl_2__subsec_1",
