      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"enam\" dalam perenggan (e) dengan perkataan \"lapan\"."
