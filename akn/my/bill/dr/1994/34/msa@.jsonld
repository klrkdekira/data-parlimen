      "schema:name": {
        "@language": "ms",
        "@value": "Akta Perbadanan Pembangunan Perdagangan Luar"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia 1992 adalah dipinda dalam subseksyen 4(1)— (a} dengan memotong perkataan \"dan\" di hujung perenggan (d}\\"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/34/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (d) perenggan yang berikut: \"di Ketua Pegawai Eksekutif yang dilantik di bawah seksyen 20(1); dan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/34/msa@/~cl_2__para_c",
