        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN-PERUNTUKAN KEWANGAN PENGGAL 1 Akaun Bank dan Kuasa untuk Melabur"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh menubuhkan menyimpan di dalam mana-mana bank atas namanya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu akaun am yang di dalamnya wang amanah boleh secara sementara disimpan sementara menunggu pelaburannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seberapa banyak akaun khas dan amanah yang perlu bagi membolehkan Perbadanan melaksanakan kewajipan dan fungsinya dan menjalankan kuasa-kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa amaun yang merupakan baki kredit bagi akaun am Pemegang Amanah Raya dan Pegawai Pentadbir Pusaka sebelum sahaja tarikh yang ditetapkan hendaklah dipindahkan kepada akaun am yang ditubuhkan di bawah perenggan (l)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada yang diperuntukkan kemudian"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "daripada ini, Perbadanan boleh melabur apa-apa wang sama ada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "atas akaun berasingan bagi harta pusaka, amanah, harta atau orang yang olehnya wang itu dipunyai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "di dalam Kumpulan Wang Bersama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "di dalam mana-mana Kumpulan Wang Pelaburan Kumpulan. PENGGAL 2 Kumpulan Wang Bersama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada yang diperuntukkan kemudian daripada ini, segala wang modal yang ada bagi pelaburan yang dipegang oleh Perbadanan selepas tarikh yang ditetapkan, hendaklah menjadi satu Kumpulan Wang Bersama dan hendaklah dilaburkan dalam apa-apa pelaburan yang dibenarkan oleh undang- undang bagi pelaburan wang amanah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa amaun yang merupakan baki kredit Kumpulan Wang Bersama yang ditubuhkan di bawah seksyen 10 Akta Pemegang Amanah Raya 1950 sebagaimana berkuatkuasa sebelum berkuatkuasanya Akta ini hendaklah pada tarikh yang ditetapkan dipindahkan kepada Kumpulan Wang Bersama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada yang diperuntukkan kemudian daripada ini, apa-apa pelaburan wang modal kepunyaan mana-mana harta pusaka yang dipegang oleh Perbadanan selepas tarikh yang ditetapkan, bolehlah diambil alih dan dimasukkan ke dalam akaun pelaburan Kumpulan Wang Bersama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua pelaburan yang diambil alih di bawah subseksyen (3) hendaklah diambil alih pada kadar pasaran yang terpakai pada tarikh pengambilalihan itu, ditolak apa-apa bunga yang terakru pada tarikh itu, dan tiada pelaburan sedemikian boleh diambil alih melainkan jika ia adalah suatu pelaburan yang dibenarkan oleh undang-undang bagi pelaburan wang amanah dan, pada pendapat Perbadanan, berkemungkinan akan terus menjadi boleh hasil dengan mudah. Bagi maksud-maksud subseksyen ini, bunga hendaklah disifatkan terakru dari hari ke hari dan boleh dibahagikan berkenaan dengan masa dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pelaburan yang dibuat atas akaun Kumpulan Wang Bersama atau dimasukkan ke dalam akaun pelaburannya tidaklah boleh dibuat atau dipegang atas akaun atau menjadi kepunyaan mana-mana harta pusaka tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Yang berikut tidaklah termasuk atau menjadi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebahagian daripada Kumpulan Wang Bersama:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang secara nyata atau secara implikasi yang perlu adalah ditegah dimasukkan ke dalam Kumpulan Wang Bersama atau diarahkan supaya dilaburkan dalam pelaburan yang selain daripada yang dibenarkan oleh undang-undang bagi pelaburan wang amanah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaburan yang dipegang oleh Perbadanan yang tidak diambil alih di bawah subseksyen 25(3);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang menjadi sebahagian daripada mana- mana harta pusaka yang ditadbirkan oleh Perbadanan atau yang .dipegang oleh Perbadanan sebagai pelikuidasi, penerima, penerima dan pengurus, ejen atau atas apa-apa sifat fidusiari yang lain, yang pada pendapat Perbadanan setelah mengambil kira hal keadaan yang dalamnya ia memegang wang itu dan jangka masa yang baginya wang itu tersedia untuk dilaburkan, tidak patut dilaburkan dalam Kumpulan Wang Bersama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Bunga yang kena dibayar berkenaan dengan wang modal yang menjadi sebahagian daripada Kumpulan Wang Bersama hendaklah pada kadar yang munasabah yang ditetapkan oleh Perbadanan dengan kelulusan Menteri dengan mengambil kira pendapatan Kumpulan Wang Bersama yang boleh dibahagikan dan kemampuan Kumpulan Wang Bersama dan Kumpulan Wang Rizab Am untuk menjelaskan segala bayaran yang dikehendaki dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Kadar itu bolehlah disemak setiap suku tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Bunga yang kena dibayar daripada Kumpulan Wang Bersama hendaklah dikreditkan setiap setengah tahun kepada harta pusaka masing-masing: Dengan syarat bahawa Perbadanan boleh, mengikut budi bicaranya, mengkreditkan bunga itu pada apa-apa lat tempoh yang lebih kerap yang difikirkannya patut dalam hal mana-mana harta pusaka tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan adalah bertanggungan untuk membayar apa-apa tuntutan yang sah ke atas Kumpulan Wang Bersama yang tidak dapat dijelaskan daripada Kumpulan Wang Bersama atau daripada Kumpulan Wang Rizab Am sama ada tuntutan itu berhubungan dengan wang modal atau pendapatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang modal yang boleh dituntut oleh mana- mana harta pusaka termasuklah wang daripada harta pusaka itu yang dimasukkan ke dalam Kumpulan Wang Bersama dan jika pelaburan telah diambil alih di bawah subseksyen 25(3) ia termasuklah juga nilai pelaburan itu sebagaimana yang ditentukan mengikut peruntukan subseksyen 25(4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa amaun yang merupakan baki kredit kumpulan wang rizab yang ditubuhkan di bawah subseksyen 14(4) Akta Pemegang Amanah Raya 1950 sebagaimana berkuatkuasa sebelum berkuatkuasanya Akta ini hendaklah pada tarikh yang ditetapkan dipindahkan kepada kredit Kumpulan Wang Rizab Am."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mengarahkan supaya mana- mana bahagian baki pada kredit akaun pendapatan Kumpulan Wang Bersama pada akhir tahun yang terdahulu (selepas ditolak bunga yang kena dibayar kepada benefisiari dan tanggungan sah yang lain) dibawa kepada kredit Kurnpulan Wang Rizab Am."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Rizab Am hendaklah digunakan untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjelaskan kerugian yang timbul daripada pelupusan pelaburan Kumpulan Wang Bersama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengekalkan kadar yang munasabah bagi pembayaran bunga atau pembayaran bunga yang ditetapkan atas wang modal dalam Kumpulan Wang Bersama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan maksud-maksud am Kumpulan Wang Bersama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maksud lain yang ditetapkan oleh Menteri melalui kaedah-kaedah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Rizab Am boleh dilaburkan oleh Perbadanan dalam apa-apa pelaburan yang dibenarkan oleh undang-undang bagi pelaburan wang amanah atau boleh didepositkan di dalam mana-mana bank. PENGGAL 3 Kumpulan Wang Pelaburan Kumpulan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, dari semasa ke semasa, dengan kelulusan Menteri Kewangan dan Menteri, menubuhkan dan menyimpan, sebagai tambahan kepada dan berasingan daripada Kumpulan Wang Bersama, satu kumpulan wang atau lebih yang setiap satunya hendaklah dipanggil Kumpulan Wang Pelaburan Kumpulan. Jika lebih daripada satu Kumpulan Wang Pelaburan Kumpulan ditubuhkan sedemikian, setiap Kumpulan Wang itu hendaklah diberikan nama atau nombor yang sesuai yang membezakannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala wang yang menjadi sebahagian daripada mana-mana Kumpulan Wang Pelaburan Kumpulan hendaklah dilaburkan dalam apa-apa kelas atau kelas- kelas pelaburan yang ditentukan oleh Perbadanan pada masa Kumpulan Wang itu ditubuhkan, yang merupakan pelaburan yang dibenarkan oleh suratcara atau kuasa lain yang melaluinya wang itu dipegang atau apa-apa pelaburan yang dibenarkan oleh undang-undang bagi pelaburan wang amanah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk.kepada seksyen ini, jika wang mana- mana harta pusaka berada dalam miliknya dan tersedia untuk dilaburkan tetapi tidak dilaburkan dalam Kumpulan Wang Bersama, maka Perbadanan bolehlah melaburkan wang itu dalam mana-mana Kumpulan Wang Pelaburan Kumpulannya yang dalamnya wang itu boleh dilaburkan dengan sah jika wang itu tidak diarahkan supaya dilaburkan mengikut apa-apa cara tertentu yang lain dan pelaburan dalam sesuatu Kumpulan Wang Pelaburan Kumpulan itu adalah tidak tak konsisten dengan terma-terma suratcara amanah itu (jika ada) atau kuasa lain yang mengawal wang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelaburan yang dibuat daripada wang yang menjadi sebahagian daripada sesuatu Kumpulan Wang Pelaburan Kumpulan tidaklah boleh dibuat atas akaun atau menjadi kepunyaan mana-mana harta pusaka tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri Kewangan dan Menteri boleh, dalam meluluskan sesuatu Kumpulan Wang Pelaburan Kumpulan, menimbangkan dan memberikan arahan- arahan kepada Perbadanan berkenaan dengan mana- mana perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "kebolehcairan Kumpulan Wang Pelaburan Kumpulan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran atau penguntukan pendapatan daripada Kumpulan Wang Kumpulan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegangan modal Kumpulan Wang Pelaburan Kumpulan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "penilaian modal Kumpulan Wang Pelaburan Kumpulan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "penggulungan Kumpulan Wang Pelaburan Kumpulan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan perlu oleh Menteri Kewangan dan Menteri bagi perlindungan pelabur-pelabur Kumpulan Wang Pelaburan Kumpulan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu Kumpulan Wang Pelaburan Kumpulan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "tidaklah boleh dikira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai suatu perkongsian antara orang yang berhak kepada bunga dalam sesuatu Kumpulan Wang Pelaburan Kumpulan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai suatu skim yang mengeluarkan bunga dalam pengertian Penggal V Bahagian IV Akta Syarikat 1965. PENGGAL 4 Fee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dikenakan berkenaan dengan tugas-tugas Perbadanan, apa-apa fee, sama ada dengan cara peratusan atau selainnya, yang ditetapkan oleh Perbadanan dengan kelulusan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang di sisi undang- undang boleh disimpan atau dibayar daripada harta amanah oleh seseorang pemegang amanah hendaklah disimpan atau dibayar sedemikian dan fee itu hendaklah disimpan atau dibayar mengikut cara yang sama sebagaimana dan sebagai tambahan kepada perbelanjaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Beban fee dan perbelanjaan di bawah seksyen ini antara modal dan pendapatan hendaklah ditentukan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbadanan Amanah Raya 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi mula berkuatkuasanya semua atau peruntukan yang berlainan dalam Akta ini berkenaan dengan Negeri atau bahagian yang berlainan di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"amanah\" termasuklah kewasian atau hal tadbir; dan \"pemegang amanah\" hendaklah ditafsirkan sewajarnya; \"hak\" ertinya segala hak, kuasa, keistimewaan dan kekebalan, sama ada sebenar, kontingen atau prospektif; \"harta\" termasuk segala harta, alih atau tak alih, dan segala harta pusaka, kepentingan, isemen dan hak, sama ada secara ekuiti atau di sisi undang-undang dalam, kepada atau daripada harta, hak dalam tindakan, wang dan nama baik; \"harta amanah\" termasuklah segala harta dalam milik atau di bawah kawalan, keseluruhannya atau sebahagiannya, Perbadanan menurut kuasa apa-apa amanah; \"harta pusaka\" ertinya apa-apa harta yang ditadbirkan, dipegang, diuruskan atau dikawal oleh Perbadanan sama ada sebagai pemegang amanah atau pentadbir atau penjaga, penerima, penerima dan pengurus, pelikuidasi atau wakil, atau atas apa-apa sifat lain; \"Kumpulan Wang Bersama\" ertinya Kumpulan Wang Bersama yang dibentuk di bawah seksyen 25; \"Kumpulan Wang Pelaburan Kumpulan\" atau \"Kumpulan Wang\" ertinya Kumpulan Wang Pelaburan Kumpulan yang dibentuk di bawah seksyen 30; \"liabiliti\" ertinya tiap-tiap jenis liabiliti, hutang, tanggungan, kewajipan dan obligasi (sama ada masa kini atau pada masa hadapan, sebenar atau kontingen, dan sama ada kena dibayar atau dipatuhi atau dilaksanakan di Malaysia atau di tempat lain); \"Mahkamah\" ertinya Mahkamah Tinggi atau Hakim Mahkamah itu dan termasuklah, dalam hal jika mana- mana daripada mereka diberikan kuasa untuk bertindak, Pendaftar, Timbalan Pendaftar, Penolong Kanan Pendaftar dan Penolong Pendaftar Mahkamah Tinggi; \"Menteri\" ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi pentadbiran amanah dan harta pusaka; \"Pegawai Pentadbir Pusaka\" ertinya Pegawai Pentadbir Pusaka, Malaysia, yang dilantik di bawah Akta Probet dan Pentadbiran 1959; \"Pemegang Amanah Raya\" ertinya Pemegang Amanah Raya, Malaysia, yang dilantik di bawah Akta Pemegang Amanah Raya 1950; \"pentadbir\" ertinya seseorang yang kepadanya surat kuasa mentadbir diberikan; \"pentadbiran\" ertinya pentadbiran harta pusaka orang yang mati oleh seseorang wasi atau pentadbir; \"Perbadanan\" ertinya perbadanan di bawah nama Amanah Raya Berhad yang diperbadankan di bawah Akta Syarikat 1965 menurut seksyen 3; \"probet\" ertinya suatu pemberian di bawah meterai Mahkamah yang memberikuasa wasi atau wasi-wasi yang dinamakan dalamnya untuk mentadbirkan harta pusaka pewasiat; \"surat kuasa mentadbir\" ertinya surat kuasa mentadbir harta pusaka dan barang-barang orang yang mati, sama ada am atau dengan wasiat terlampir; \"tak berwasiat\" termasuklah seseorang yang meninggalkan wasiat tetapi mati tak berwasiat tentang apa-apa kepentingan benefisial mengenai hartanya; \"tarikh yang ditetapkan\" ertinya tarikh atau tarikh- tarikh mula berkuatkuasanya kesemua atau mana-mana peruntukan Akta ini di bawah subseksyen 1(2); \"terletakhak\", berhubungan dengan harta, termasuk hak mengenai harta yang masa hadapan atau kontingen dan hak perkembalian dan lebihan; \"wasi\" ertinya seseorang yang kepadanya pelaksanaan wasiat terakhir orang yang mati telah diamanatkan, melalui perlantikan pewasiat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika apa-apa bon atau jaminan diperlukan daripada"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "orang persendirian atas pemberian kepadanya akan surat kuasa mentadbir atau atas perlantikannya untuk bertindak atas apa-apa sifat, Perbadanan, jika diberikan surat kuasa mentadbir atau dilantik untuk bertindak atas apa-apa sifat sedemikian, tidaklah dikehendaki memberikan bon atau jaminan sedemikian tetapi adalah tertakluk kepada liabiliti dan kewajipan yang sama seolah-olah ia telah memberikan bon atau jaminan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika nilai sepenuhnya apa-apa harta (tanpa ditolak"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "hutang, tetapi tidak termasuk nilai apa-apa harta yang dimiliki si mati atau yang kepadanya dia berhak sebagai pemegang amanah dan tidak secara benefisial) yang ditadbirkan oleh Perbadanan, sama ada menurut apa-apa suratcara amanah atau wasiat atau menurut kuasa pemberian surat kuasa mentadbir kepada Perbadanan atau menurut kuasa kuasa-kuasa yang diberikan kepada Perbadanan oleh Akta ini, tidak melebihi enam ratus ribu ringgit, maka tidaklah perlu bagi Perbadanan untuk memberikan notis mengenai niatnya membahagikan harta pusaka itu atau menghendaki mana-mana orang yang berkepentingan untuk menghantar butir-butir mengenai tuntutannya terhadap harta pusaka itu, tetapi Perbadanan boleh dengan serta- merta terus memindahhak atau membahagikan harta pusaka itu atau mana-mana bahagiannya kepada atau di kalangan orang-orang yang berhak kepadanya, dengan mengambil kira tuntutan itu sahaja, sama ada formal atau tidak, yang mengenainya Perbadanan telah diberikan notis ketika itu, dan Perbadanan tidaklah, berkenaan dengan harta yang dipindahhak atau dibahagikan sedemikian, bertanggungan kepada mana- mana orang yang mengenai tuntutannya Perbadanan telah tidak diberikan notis pada masa pemindahhakan atau pembahagian itu; tetapi tiada apa-apa jua dalam seksyen ini boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "menjejaskan hak mana-mana orang untuk mengikuti harta yang merupakan harta yang sama, ke dalam tangan mana-mana orang, selain daripada seorang pembeli, yang mungkin telah menerimanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "membebaskan Perbadanan daripada apa-apa obligasi untuk membuat carian yang serupa dengan carian yang seorang bakal pembeli patut membuat atau mendapatkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Permohonan oleh Perbadanan bagi pendaftaran"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai anggota atau pemegang syer dalam buku mana- mana syarikat atau kemasukan nama Perbadanan dalam buku mana-mana syarikat tidaklah menjadi notis mengenai sesuatu amanah, dan tiada syarikat berhak untuk membantah kemasukan nama Perbadanan dalam bukunya semata-mata oleh sebab bahawa Perbadanan mungkin atau ialah seorang pemegang amanah, dan, dalam pengurusan harta, hakikat bahawa orang itu atau salah seorang daripada orang yang dengannya ia berurusan ialah Perbadanan tidaklah dengan sendirinya menjadi notis mengenai suatu amanah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mengemukakan kepada Menteri akaun tahunan teraudit bagi setiap tahun kewangan dalam apa-apa masa dan bentuk yang ditetapkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mengemukakan kepada Menteri segala penyata, laporan, akaun dan maklumat berkenaan dengan harta, pelaburan dan aktivitinya yang dikehendaki oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh membuat permohonan kepada Mahkamah untuk mendapatkan arahan atas apa- apa perkara yang timbul daripada pelaksanaan mana- mana fungsi atau tugas atau penjalanan mana-mana kuasa Perbadanan di bawah seksyen 15 hingga 21."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelaksanaan mana-mana fungsi atau tugas atau penjalanan mana-mana kuasa Perbadanan di bawah seksyen 15 hingga 21 bolehlah disemak secara kehakiman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan-peruntukan mana-mana"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "undang-undang bertulis, dalam apa-apa prosiding yang melibatkan Perbadanan, mana-mana Perbadanan yang diluluskan oleh Menteri melalui pemberitahuan dalam Warta boleh, bagi pihak Perbadanan, memulakan, hadir dalam dan menjalankan prosiding itu dan boleh membuat dan melakukan segala kehadiran, tindakan dan permohonan berkenaan dengan prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat kaedah-kaedah berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang baginya kaedah-kaedah adalah dibenarkan dengan nyata untuk dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan fungsi-fungsi dan tugas-tugas atau penjalanan kuasa-kuasa Perbadanan di bawah seksyen 15 hingga 21;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur dan prosiding berkenaan dengan apa- apa perkara di bawah seksyen 15 hingga 21;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara berhubungan Kumpulan Wang Pelaburan Kumpulan yang baginya arahan boleh diberikan di bawah seksyen 31; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain secara amnya untuk memberikan kuatkuasa kepada objektif- objektif Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum membuat apa-apa kaedah-kaedah, Menteri hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil kira Bahagian III; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berunding dengan Perbadanan tentang perkara- perkara yang akan diperkatakan dalam kaedah- kaedah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa kaedah-kaedah yang difikirkannya perlu atau suaimanfaat bagi maksud menghapuskan apa-apa kesulitan yang disebabkan oleh mula berkuatkuasanya Akta ini dan apa-apa kaedah- kaedah itu boleh dibuat sedemikian supaya mempunyai kuatkuasa dari mula berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan-peruntukan Akta ini,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, memberikan arahan yang berbentuk am yang tidak tak konsisten dengan peruntukan-peruntukan Akta ini tentang pelaksanaan fungsi-fungsi atau tugas-tugas dan penjalanan kuasa-kuasa Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan kuasa Menteri untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan arahan di bawah seksyen 41, Menteri hendaklah juga mempunyai kuasa untuk mengarahkan Perbadanan menyiasat apa-apa aduan yang dibuat oleh mana-mana anggota orang awam terhadap Perbadanan atau mana-mana pegawainya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pemegang Amanah Raya 1950 dan segala kaedah-kaedah yang dibuat di bawahnya adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemegang Amanah Raya yang merupakan perbadanan seorang yang ditubuhkan di bawah Akta Pemegang Amanah Raya 1950 dan Pegawai Pentadbir Pusaka yang merupakan suatu jawatan statutori yang ditubuhkan di bawah Akta Probet dan Pentadbiran 1959 hendaklah terhenti daripada wujud pada tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan-peruntukan Akta ini, segala undang-undang bertulis yang menyentuh Pemegang Amanah Raya dan Pegawai Pentadbir Pusaka dan yang berkuatkuasa sebelum sahaja tarikh yang ditetapkan, hendaklah, sehingga dipinda atau dibatalkan, terus berkuatkuasa pada dan selepas tarikh yang ditetapkan dan ditafsirkan seolah-olah Akta ini telah tidak diluluskan: Dengan syarat bahawa apa-apa sebutan dalamnya mengenai Pemegang Amanah Raya dan Pegawai Pentadbir Pusaka hendaklah, melainkan jika konteksnya menghendaki makna yang lain, ditafsirkan sebagai sebutan mengenai Perbadanan, dan ungkapan yang mengandungi sebutan itu hendaklah ditafsirkan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala perintah, perlantikan dan pemberitahuan yang dibuat di bawah Akta Pemegang Amanah Raya 1950 dan berkuatkuasa sebelum sahaja tarikh yang ditetapkan hendaklah, setakat yang ia tidak tak konsisten dengan Akta ini, disifatkan telah dibuat di bawah Akta ini dan hendaklah terus berkuatkuasa sehingga peruntukan lain dibuat di bawah Akta ini atau sehingga tarikh ia habis tempoh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini diisytiharkan bahawa pemansuhan Akta Pemegang Amanah Raya 1950 dan apa-apa pemansuhan peruntukan-peruntukan atau pindaan Akta Probet dan Pentadbiran 1959 tidaklah menyentuh mana-mana dokumen yang dibuat atau apa jua pun perkara yang dilakukan di bawah peruntukan yang dimansuhkan atau dipinda sedemikian, dan tiap- tiap dokumen atau perkara itu, setakat yang ia wujud atau berkuatkuasa pada masa pemansuhan atau pindaan itu dan boleh dibuat atau dilakukan di bawah Akta ini, hendaklah berterusan dan mempunyai kuatkuasa seolah- olah ia telah dibuat atau dilakukan di bawah peruntukan yang bersamaan dalam Akta ini dan seolah-olah peruntukan itu telah berkuatkuasa apabila dokumen itu dibuat atau perkara itu dilakukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan-peruntukan Akta ini, pemansuhan Akta Pemegang Amanah Raya 1950 atau apa-apa jua yang terkandung dalam Akta ini tidaklah menjejaskan hak mana-mana orang untuk mendapat pampasan daripada Kumpulan Wang Disatukan dan hak itu telah berbangkit di bawah Akta yang dimansuhkan sebelum tarikh yang ditetapkan."
      }
    }
  ]
}
