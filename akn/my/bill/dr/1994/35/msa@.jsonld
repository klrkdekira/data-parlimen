        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "FUNGSI, KUASA DAN KEWAJIPAN PERBADANAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Objektif Perbadanan adalah seperti berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjadi suatu organisasi yang menunjukkan rasa tanggungjawab sosial dengan memberikan perhatian kepentingan komuniti Malaysia dan dengan berusaha untuk mengambil kira menggalakkan perkara-perkara ini apabila ia boleh berbuat sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjadi secekap dan mencapai keuntungan sebagaimana syarikat-syarikat amanah persendirian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu Mahkamah, Kerajaan Malaysia atau seseorang di dalam atau di luar Malaysia mempunyai kuasa untuk melantik seorang pemegang amanah, wasi, pentadbir, penjaga, sahabat wakil, ejen, wakil, penerima, penerima dan pengurus atau pelikuidasi atau untuk membuat apa-apa perlantikan lain yang bersifat fidusiari, Perbadanan bolehlah dilantik sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh bertindak sama bersendirian atau bersesama mana-mana orang atau kumpulan orang atas apa-apa sifat yang ia dilantik dan hendaklah mempunyai kuasa, kewajipan dan liabiliti yang sama dan adalah berhak kepada hak dan kekebalan yang sama dan hendaklah tertakluk kepada kawalan dan perintah Mahkamah yang sama sebagaimana orang persendirian yang bertindak atas sifat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan tidak boleh enggan menerima apa- apa perlantikan semata-mata atas alasan kecilnya nilai harta yang dengannya perlantikan itu berhubungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Perbadanan untuk enggan menerima apa-apa perlantikan boleh, dalam tempoh empat belas hari dari keputusan itu, merayu kepada Menteri secara bertulis dan keputusan Menteri atas rayuan itu adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh dilantik menjadi pemegang amanah apa-apa wasiat atau berian atau suratcara lain yang mewujudkan amanah atau untuk melaksanakan apa-apa amanah atau kewajipan yang tergolong dalam kelas yang ia dibenarkan untuk menerima, dan boleh dilantik sedemikian sama ada wasiat atau berian atau suratcara lain yang mewujudkan amanah atau kewajipan itu dibuat atau mula berkuatkuasa sebelum atau selepas tarikh yang ditetapkan, dan sama ada sebagai pemegang amanah asal atau baru, atau sebagai pemegang amanah tambahan, dalam hal yang sama dan dengan cara yang sama dan oleh orang atau Mahkamah yang sama seolah- olah ia adalah orang persendirian yang bertindak atas sifat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Walaupun pada hakikatnya mana-mana wasiat, berian atau suratcara lain yang mewujudkan amanah atau kewajipan membuat peruntukan bagi atau mengarahkan atau menghendaki perlantikan dua pemegang amanah atau lebih, Perbadanan boleh dilantik dan bertindak dengan sah sebagai pemegang amanah tunggal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Perbadanan telah dilantik sebagai pemegang amanah apa-apa amanah, seorang pemegang amanah bersama boleh bersara daripada amanah itu di bawah dan mengikut seksyen 43 Akta Pemegang Amanah 1949, walaupun tidak terdapat lebih daripada dua orang pemegang amanah dan tanpa apa-apa persetujuan yang dikehendaki oleh seksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan tidak boleh dilantik sama ada sebagai pemegang amanah baru atau tambahan jika wasiat, berian atau suratcara lain yang wujudkan amanah atau kewajipan itu mengandungi arahan yang bertentangan, melainkan jika Mahkamah memerintahkan selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis mengenai apa-apa cadangan perlantikan Perbadanan sama ada sebagai pemegang amanah baru atau tambahan hendaklah, jika praktik, diberikan kepada semua orang yang mempunyai kepentingan benefisial yang bermastautin di Malaysia dan yang alamat mereka diketahui oleh orang yang bercadang membuat perlantikan itu, atau, jika benefisiari itu ialah orang yang belum dewasa, kepada penjaga mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang kepadanya notis itu telah diberikan memohon kepada Mahkamah dalam tempoh dua puluh satu hari dari penerimaan notis itu, Mahkamah boleh, jika setelah mengambil kira kepentingan semua benefisiari ia memikirkan bahawa adalah suaimanfaat dibuat sedemikian, membuat perintah melarang perlantikan itu dibuat: Dengan syarat bahawa kegagalan untuk memberikan apa-apa notis sedemikian tidaklah mentaksahkan apa- apa perlantikan yang dibuat di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, atas permohonannya sendiri atau atas permohonan mana-mana orang lain, diberikan probet bagi wasiat atau surat kuasa mentadbir oleh Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah menganggap Perbadanan sebagai sama-sama berhak di sisi undang-undang dengan mana-mana orang lain atau golongan orang lain untuk mendapatkan pemberian surat kuasa mentadbir, kecuali bahawa persetujuan atau perintah Perbadanan tidaklah dikehendaki bagi pemberian surat kuasa mentadbir kepada mana-mana orang lain dan bahawa antara Perbadanan dan duda, balu atau waris kadim si mati, duda, balu atau waris kadim itu hendaklah diberikan keutamaan, melainkan jika atas alasan yang baik yang berlawanan ditunjukkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh, atas permohonan mana- mana orang yang mempunyai kepentingan benefisial, melantik Perbadanan, jika alasan yang mencukupi ditunjukkan, sebagai ganti kesemua atau mana-mana wasi, pentadbir atau pemegang amanah yang sedia ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana wasi yang telah mendapat probet atau mana-mana pentadbir yang telah mendapat surat kuasa mentadbir atau mana-mana pemegang amanah boleh, dengan keizinan Mahkamah dan setelah memberikan apa-apa notis kepada orang yang mempunyai kepentingan benefisial sebagaimana yang diarahkan oleh Mahkamah, dan walaupun dia telah bertindak dalam mentadbirkan harta pusaka si mati atau harta amanah itu, memindahkan harta pusaka atau harta amanah itu kepada Perbadanan bagi pentadbirannya sama ada secara tunggal atau bersesama wasi, pentadbir atau pemegang amanah yang berterusan, jika ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Perintah Mahkamah yang memberikan keizinan mengenai pemindahan itu hendaklah, tertakluk kepada Akta ini, memberi kepada Perbadanan segala kuasa wasi, pentadbir atau pemegang amanah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Wasi, pentadbir atau pemegang amanah itu tidaklah dalam apa-apa cara bertanggungan berkenaan dengan apa-apa perbuatan atau keingkaran berhubungan dengan harta pusaka atau harta amanah itu selepas tarikh perintah itu selain daripada perbuatan keingkarannya sendiri atau perbuatan atau keingkaran orang yang selain daripada dirinya yang ke atas kelakuannya dia adalah bertanggungjawab di sisi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam hal-hal yang berikut, iaitu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "jika mana-mana orang yang telah menerima pemberian surat kuasa mentadbir mengabaikan, dalam tempoh tiga bulan dari tarikh pemberian itu, untuk memberikan apa-apa jaminan yang dia dikehendaki memberikan menurut undang-undang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang pentadbir telah gagal untuk mengambil pemberian surat kuasa mentadbir dalam tempoh yang munasabah selepas perintah dibuat bagi pemberian untuk mengeluarkan, Perbadanan boleh memohon kepada Mahkamah untuk mengetepikan perintah bagi pemberian itu dan supaya memberikan surat kuasa mentadbir harta pusaka itu kepada dirinya,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, sebaik sahaja mengetahui atas apa-apa keterangan yang difikirkannya mencukupi bahawa mana-mana orang telah meninggal dunia tak berwasiat dengan meninggalkan harta di Malaysia, dengan serta-merta mengambil milik harta itu dan memperuntukkan bagi jagaan selamatnya sehingga surat kuasa mentadbir diberikan oleh Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tanpa kuasa atau alasan yang sah mengalihkan atau cuba mengalihkan mana- mana bahagian harta itu atau memusnahkan, menyembunyikan atau enggan menyerahkan harta itu kepada Perbadanan apabila diminta, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima ratus ringgit atau dipenjarakan selama tempoh tidak. melebihi enam bulan atau kedua- duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada guaman boleh dibawa terhadap Perbadanan atau mana-mana pegawainya bagi apa-apa jua yang dilakukan oleh Perbadanan berhubungan dengan mana- mana harta sedemikian di bawah kuasa atau pelaksanaan atau pelaksanaan yang dicadangkan akan kuasa-kuasa yang terletakhak pada Perbadanan' oleh subseksyen (1); tetapi mana-mana orang-yang terkilari dengannya boleh membuat permohonan kepada Mahkamah bagi tebus rugi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana mana-mana orang meninggal dunia, sama ada berwasiat atau tak berwasiat, dengan meninggalkan harta alih.di Malaysia dan Perbadanan berpuas hati selepas apa-apa peny.iasatan yang difikirkannya mencukupi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa nilai keseluruhan harta itu tanpa . ditolak hutang, tetapi tidak termasuk nilai apa- apa harta yang dimiliki si mati atau yang si mati berhak .kepadanya sebagai' pemegang amanah dan bukan secara benefisial, tidak melebihi enam ratus ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": ".bahawa tiada orang berhak memohon kepada Mahkamah bagi pemberian probet bagi wasiat atau tiada petisyen bagi surat kuasa mentadbir yang belum selesai, Perbadanan hendaklah, atas permohonan orang yang membuat tuntutan ke atas harta itu dan difikirkannya patut dibuat sedemikian, secara bertulis mengisytiharkan bahawa ia .mengakujanji .untuk mentadbirkan harta itu, dan sesudah itu Perbadanan adalah diberikan kuasa untuk mentadbirkan harta-itu seolah-olah surat kuasa mentadbir bagi harta pusaka orang yang mati itu telah diberikan kepada Perbadanan, dan resit Perbadanan hendaklah menjadi pelepasan yang mencukupi bagi mana-mana orang yang membayar apa- apa ,wang atau yang menyerahkan apa~apa harta kepada Perbadanan; dan notis mengenai tiap-tiap perisytiharan sedemikian hendaklah difailkan di Pejabat Pendaftaran Mahkamah yang sesuai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "(a) Apabila Perbadanan berpuas hati bahawa nilai apa-apa harta yang disebut dalam subseksyen (1) tidak melebihi lima puluh ribu ringgit, ia bolehlah mengarahkan supaya harta itu atau mana-mana bahagiannya diserahkan kepada mana-mana orang atau orang-orang apabila berpuas hati tentang hakmilik pihak yang menuntut dan nilai harta itu melalui sumpah atau ikrar pihak yang menuntut atau melalui apa-apa keterangan lain yang dikehendaki oleh Perbadanan dan Perbadanan bolehlah mengikut budi bicaranya mengambil apa-apa jaminan yang difikirkannya patut bagi pentadbiran sewajarnya akan harta itu atau perlindungan hak mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen ini boleh menjejaskan hak mana-mana orang untuk mendapatkan kesemua atau mana-mana bahagian harta yang diserahkan di bawah perenggan (a) daripada orang yang kepadanya ia telah diserahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika harta itu tidak ketara nilainya atau nilainya, pada pendapat Perbadanan, adalah sebegitu kecil hingga menjadikannya tak praktik untuk dijual, Perbadanan bolehlah mengarahkan supaya harta itu dimusnahkan atau selainnya dilupuskan sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa-kuasa yang diberikan kepada Perbadanan oleh seksyen ini tidaklah menjejaskan kuasa-kuasa untuk menguruskan, tanpa pemberian probet bagi wasiat atau surat kuasa mentadbir, harta orang yang mati yang diberikan kepada mana-mana orang lain oleh mana- mana undang-undang bertulis yang lain: Dengan syarat bahawa tiap-tiap orang sedemikian hendaklah, apabila diminta, mengemukakan kepada Perbadanan penjelasan penuh dan benar mengenai apa- apa harta yang diuruskannya dan hendaklah, jika dikehendaki sedemikian, membayar atau menyerahkan kepada Perbadanan apa-apa wang atau harta lain yang masih di bawah kawalannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa sebelum pembahagian mana- mana bahagian harta itu antara benefisiarinya di bawah seksyen ini, Perbadanan boleh, jika difikirkannya suaimanfaat dibuat sedemikian, walau apa pun apa-apa perisytiharan yang dibuat di bawah subseksyen (1), enggan untuk terus mentadbirkan harta dalam tangannya sehingga suatu perintah pembahagian atau pemberian probet atau pemberian surat kuasa mentadbir diperolehi berkenaan dengan harta pusaka si mati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Hasil penjualan apa-apa harta yang diterima oleh Perbadanan mengikut subseksyen 23(2) Akta Polis 1967 hendaklah diuruskan mengikut cara yang sama sebagaimana yang harta itu diperintahkan oleh seksyen ini supaya diuruskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini tidaklah terpakai dalam hal harta si mati yang baginya Bahagian III atau IV Akta Harta Pusaka Kecil (Pembahagian) 1955 terpakai, tetapi, tertakluk kepada yang disebut terdahulu, hendaklah terpakai bagi semua Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "nilai harta tanpa ditolak hutang, tetapi tidak termasuk nilai apa-apa harta yang dimiliki si mati atau yang kepadanya dia berhak sebagai pemegang amanah dan bukan secara benefisial, tidak melebihi lima ribu ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan mendapati bahawa orang yang berhak secara benefisial ialah orang yang berpendapatan kecil; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mentadbirkan harta pusaka itu di bawah seksyen 17, maka Perbadanan hendaklah mentadbirkan harta pusaka itu di bawah seksyen 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika prosiding telah dimulakan di mana-mana Mahkamah bagi pentadbiran sesuatu harta pusaka dan oleh sebab kecilnya nilai harta pusaka itu Mahkamah mendapati bahawa harta pusaka itu boleh ditadbirkan dengan lebih ekonomi lagi oleh Perbadanan berbanding dengan oleh Mahkamah atau bahawa atas apa-apa sebab lain adalah suaimanfaat harta pusaka itu ditadbirkan oleh Perbadanan dan tidak oleh Mahkamah, maka Mahkamah boleh memerintahkan supaya harta pusaka itu ditadbirkan oleh Perbadanan, dan sesudah itu, tertakluk kepada apa-apa arahan Mahkamah, seksyen 17 hendaklah terpakai seolah-olah pentadbiran harta pusaka itu telah diakujanji oleh Perbadanan di bawah seksyen 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa harta yang nilainya tidak melebihi dua puluh ribu ringgit dipegang oleh Perbadanan, sama ada menurut kuasa suatu pemberian surat kuasa mentadbir kepada Perbadanan atau menurut kuasa kuasa-kuasa yang diberikan kepada Perbadanan oleh Akta ini, dan harta itu dipegang oleh Perbadanan atas amanah bagi mana-mana orang bagi apa jua pun kepentingan, sama ada terletakhak atau kontingen, maka, tertakluk kepada apa-apa kepentingan atau gadaian terdahulu yang menyentuh harta itu, Perbadanan boleh, mengikut budi bicaranya sendiri, semasa mana- mana orang sedemikian belum dewasa, membuat pembayaran daripada kesemua atau mana-mana bahagian pendapatan dan wang modal harta itu sebagaimana yang munasabah dalam segala hal keadaan itu bagi penyenggaraan, pendidikan atau faedah orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika nilai harta yang dipegang sedemikian melebihi empat puluh ribu ringgit, Perbadanan boleh membuat pembayaran daripada wang modal sehingga takat dua puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembayaran di bawah subseksyen (1) dan (2) boleh dibuat kepada ibu atau bapa atau penjaga orang itu atau selainnya sebagaimana yang ditentukan oleh Perbadanan mengikut budi bicaranya dan sama ada terdapat atau tidak terdapat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa wang lain yang boleh digunakan bagi maksud yang sama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang terikat oleh undang- undang untuk memperuntukkan penyenggaraan atau pendidikan orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika, apabila selesainya pentadbiran harta pusaka"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang mati berwasiat atau tak berwasiat, masih terdapat dengan Perbadanan wang yang tidak dapat dilupuskan serta-merta olehnya melalui pembahagian mengikut undang-undang oleh sebab ketakdayaan orang yang berhak itu untuk memberikan pelepasan, kerana kurang keupayaan di sisi undang-undang atau selainnya, atau oleh apa-apa sebab lain yang didapati mencukupi oleh Perbadanan, maka Perbadanan boteh menggunakan wang itu bagi faedah orang itu dan boleh bagi maksud itu menjalankan segala kuasa di bawah seksyen 19."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, atas permohonannya sendiri atau atas permohonan mana-mana orang lain melalui saman, dilantik oleh Mahkamah untuk bertindak sebagai sahabat wakil mana-mana orang belum dewasa bagi maksud memulakan apa-apa guaman atau prosiding atas nama orang belum dewasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam apa-apa guaman atau prosiding yang belum selesai adalah didapati perlu untuk menambah seseorang orang belum dewasa sebagai plaintif bersama, maka Mahkamah boleh, atas usulnya sendiri atau atas permohonan Perbadanan atau mana-mana orang lain, melantik Perbadanan untuk bertindak sebagai sahabat wakil orang beium dewasa itu dalam guaman atau prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa guaman atau prosiding yang dalamnya seseorang orang belum dewasa ialah defendan atau yang dalamnya adalah didapati perlu untuk menambah seseorang orang belum dewasa sebagai defendan bersama, maka Mahkarnah boleh, atas usulnya sendiri atau atas permohonan Perbadanan atau mana- mana orang lain, melantik Perbadanan untuk bertindak sebagai penjaga kepada orang belum dewasa itu bagi maksud-maksud guaman atau prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah tidaklah boleh membuat apa-apa perintah di bawah seksyen ini melainkan Perbadanan telah diberikan peluang untuk didengar dan peruntukan dibuat sehingga memuaskan hati Mahkamah bagi pembayaran kos Perbadanan atas dasar kos antara peguamcara dan klien dan bagi pembayaran apa-apa kos yang mungkin diawardkan terhadap atau diarahkan supaya dibayar oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa guaman atau prosiding yang dalamnya Perbadanan dilantik di bawah seksyen ini untuk bertindak bagi pihak seseorang orang belum dewasa, tiada kos boleh didapatkan daripada Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini \"guaman\" ertinya sesuatu tindakan atau guaman bagi pentadbiran harta pusaka mana-mana orang yang mati atau sesuatu amanah, dan \"prosiding\" ertinya prosiding di bawah Kaedah-Kaedah Mahkamah Tinggi 1980."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah sah bagi Perbadanan untuk bertindak di bawah apa-apa suratikatan atau suratcara yang melaluinya Perbadanan dilantik sebagai ejen atau wakil bagi mana-mana orang, dan segala kuasa yang diberikan kepada Perbadanan oleh mana-mana suratikatan atau suratcara itu bolehlah dijalankan oleh mana-mana pegawai Perbadanan yang ditetapkan oleh Perbadanan bagi maksud itu: Dengan syarat bahawa tiada apa-apa jua dalam seksyen ini boleh disifatkan memberikuasa mana-mana orang untuk memberi kepada Perbadanan apa-apa kuasa yang tidak boleh diwakilkan dengan sah olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada suatu Perbadanan yang diperbadankan di bawah Akta Syarikat 1965 di bawah nama \"Amanah Raya Berhad\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Menteri boleh, dari semasa ke semasa, melalui perintah yang disiarkan dalam Warta, menetapkan suatu tarikh peletakhakan dan pada tarikh itu segala harta, hak dan liabiliti Pemegang Amanah Raya dan Kerajaan Malaysia berkenaan dengan pentadbiran amanah dan harta pusaka yang ditentukan oleh Menteri dalam perintah itu hendaklah, menurut kuasa Akta ini, dipindahkan kepada dan terletakhak pada Perbadanan tanpa apa jua pun pemindahhakan, penyerahhakan atau pemindahmilikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap harta yang terletakhak pada Perbadanan menurut kuasa subseksyen (1) hendaklah terletakhak sedemikian pada Perbadanan dengan hakmilik, harta pusaka atau kepentingan dan pemegangan yang serupa sebagaimana ia terletakhak atau dipegang sebelum sahaja tarikh peletakhakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap hak dalam tindakan yang terletakhak pada Perbadanan menurut kuasa subseksyen (1) boleh, selepas tarikh peletakhakan, dituntut melalui guaman, didapatkan atau dikuatkuasakan oleh Perbadanan atas namanya sendiri dan tidaklah perlu bagi Perbadanan atau Pemegang Amanah Raya atau Kerajaan Malaysia memberikan notis kepada orang yang terikat dengan hak dalam tindakan itu mengenai peletakhakan di bawah subseksyen (1)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap hak dan liabiliti yang terletakhak pada Perbadanan menurut kuasa subseksyen (1) boleh, pada dan selepas tarikh peletakhakan, dituntut melalui guaman, didapatkan atau dikuatkuasakan oleh atau terhadap Perbadanan atas namanya sendiri dan tidaklah perlu bagi Perbadanan atau Pemegang Amanah Raya atau Kerajaan Malaysia memberikan notis kepada orang yang hak atau liabilitinya tersentuh oleh peletakhakan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding undang-undang yang belum selesai oleh atau terhadap Pemegang Amanah Raya atau Kerajaan Malaysia yang berhubungan dengan apa-apa harta, hak atau liabiliti yang dipindahkan kepada dan terletakhak pada Perbadanan menurut kuasa subseksyen (1) boleh, pada dan selepas tarikh peletakhakan, diteruskan oleh atau terhadap Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala harta dalam milik atau di bawah kawalan Pemegang Amanah Raya, keseluruhannya atau sebahagiannya, menurut kuasa apa-apa amanah hendaklah pada tarikh peletakhakan berpindah kepada Perbadanan dengan segala kuasa, hak, kewajipan, liabiliti dan obligasi yang berhubung-kait dengannya sebelum sahaja tarikh peletakhakan setakat yang ia tidak tak konsisten dengan Akta ini atau mana-mana kaedah yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan mengenai Pemegang Amanah Raya atau Pegawai Pentadbir Pusaka dalam mana-mana perintah Mahkamah, suratikatan, kontrak, suratcara atau apa jua pun dokumen lain hendaklah ditafsirkan sebagai sebutan mengenai Perbadanan dan segala hak, kuasa, obligasi dan kewajipan yang diberikan, dikenakan, diakujanji atau ditanggung oleh Pemegang Amanah Raya atau Pegawai Pentadbir Pusaka di bawah atau menurut kuasa mana-mana perintah Mahkamah, suratikatan, kontrak, suratcara atau dokumen lain itu hendaklah disifatkan telah diberikan atau dikenakan atau diakujanji atau ditanggung oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai akibat peletakhakan harta, hak dan liabiliti pada Perbadanan di bawah seksyen 4, Perbadanan hendaklah menerbitkan apa-apa syer Perbadanan kepada Menteri Kewangan sebagaimana yang diarahkan oleh Menteri Kewangan dari semasa ke seraasa selepas berunding dengan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Syer yang dikehendaki diterbitkan di bawah seksyen ini hendaklah diterbitkan atau diuntukkan pada bila-bila masa dan atas apa-apa terma tentang penguntukan sebagaimana yang diarahkan oleh Menteri Kewangan selepas berunding dengan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Syer yang diterbitkan di bawah seksyen ini-—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mempunyai nilai sebagaimana yang diarahkan oleh Menteri Kewangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah diterbitkan sebagai berbayar penuh dan dikira bagi maksud-maksud Akta Syarikat 1965 seolah-olah ia berbayar menurut kuasa pembayaran nilai nominalnya kepada Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa dividen atau jumlah wang lain yang diterima oleh Menteri Kewangan menurut kuasa seksyen ini hendaklah dibayar ke dalam Kumpulan Wang Disatukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Penerbitan selanjutnya ' akan syer dalam Perbadanan hanya boleh dibuat sebagaimana yang diarahkan oleh Menteri Kewangan pada bila-bila masa selepas berunding dengan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dilakukan oleh Menteri Kewangan berikutan dengan peruntukan ' seksyen ini hendaklah dikira sebagai pelaburan dan dibenarkan di bawah subperenggan 8(3)(a)(iv) Akta Prosedur Kewangan 1957."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa dividen atau jumlah wang lain yang diterima oleh Menteri Kewangan di bawah seksyen ini hendaklah dibayar ke dalam Kumpulan Wang Disatukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Duti setem tidaklah bbleh dikenakan berkenaan dengan apa-apa pertambahan modal Perbadanan yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dilaksanakan dengan penerbitan syer; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_6__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "diperakui oleh Perbendaharaan sebagai telah dilaksanakan dengan penerbitan syer yang dimohon beli oleh Menteri Kewangan di bawah subseksyen (1). PERBADANAN AMANAH RAYA 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menerima sebagai pekerjanya, pada suatu tarikh yang akan ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, tiap-tiap orang yang sebelum sahaja tarikh itu ialah anggota kakitangan Pemegang Amanah Raya atau Pejabat Pegawai Pentadbir Pusaka dan yang telah diberikan pilihan oleh Kerajaan Malaysia dan telah membuat pilihan untuk berkhidmat sebagai pekerja Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang sedemikian yang telah membuat pilihan di bawah subseksyen (1) untuk berkhidmat sebagai pekerja Perbadanan hendaklah diambil kerja oleh Perbadanan atas terma dan syarat perkhidmatan yang tidak kurang baiknya daripada terma dan syarat perkhidmatan yang kepadanya dia berhak sebelum sahaja tarikh yang ditetapkan oleh Menteri di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri Kewangan boleh, dari semasa ke semasa, bagi pihak Kerajaan Malaysia, memohon beli atau selainnya memperolehi kesemua syer dalam Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Syer-syer dalam Perbadanan yang dipegang oleh Menteri Kewangan hendaklah dipegang oleh Menteri Kewangan sebagaimana diperbadankan di bawah Akta Menteri Kewangan (Pemerbadanan) 1957."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa undang-undang bertulis lain atau kaedah undang-undang lain, maka tidaklah perlu untuk . menyelesaikan atau mendaftarkan pindahmilik syer daripada jenis yang disebut dalam subseksyen (2) berikutan dengan pertukaran orang yang memegang jawatan Menteri Kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri Kewangan bolehlah menjalankan segala hak dan kuasa yang berhubung-kait dengan syer dalam Perbadanan yang dipegang olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri Kewangan boleh, pada bila-bila masa, dengan notis bertulis kepada Setiausaha Syarikat Perbadanan, memberikuasa, atas apa-apa terma dan syarat yang dinyatakan dalam notis itu, mana-mana orang yang difikirkannya layak untuk bertindak sebagai wakilnya pada mana-mana atau semua mesyuarat pemegang syer Perbadanan atau mana-mana golongan pemegang syer, dan mana-mana orang yang diberikuasa sedemikian adalah berhak untuk menjalankan kuasa yang sama, bagi pihak Menteri Kewangan, sebagaimana yang Menteri Kewangan boleh menjalankannya jika dia hadir sendiri pada mesyuarat atau mesyuarat- mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri Kewangan tidaklah boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual atau selainnya melupuskan mana- mana syer dalam Perbadanan yang dipegang olehnya kepada mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membenarkan syer dalam Perbadanan diuntukkan kepada mana-mana orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) terpakai bagi syer keutamaan boleh tebus yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh ditukarkan menjadi syer daripada mana-mana kelas yang lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak memberikan apa-apa hak untuk mengundi pada mana-mana mesyuarat agung Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
