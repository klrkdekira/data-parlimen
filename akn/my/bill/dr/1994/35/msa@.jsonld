        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/35/msa@/~part_III__cl_16",
