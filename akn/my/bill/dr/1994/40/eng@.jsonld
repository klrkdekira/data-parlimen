      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"and Assistant General Managers\" after the words \"other than the deputy General Managers\" in subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_e",
