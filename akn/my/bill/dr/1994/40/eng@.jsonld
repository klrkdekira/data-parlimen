      "schema:name": {
        "@language": "en",
        "@value": "Section 31 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"and Assistant General Managers\" after the words \"Deputy General Managers\" in subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_b",
