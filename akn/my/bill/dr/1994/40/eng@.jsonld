      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to be deposited in any bank or financial institution established by or under any written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2",
      "schema:text": {
