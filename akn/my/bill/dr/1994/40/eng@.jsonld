      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"two\" the word \"four\" in paragraph (l)(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsections: \"(1A) The Chairman of the Disciplinary Committee of the Board and two members of the Committee shall form a quorum at all meetings of the Disciplinary Committee. (IB) The Disciplinary Committee shall have powers to determine the conduct of its proceedings.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_d",
