      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in accordance with the provisions of the Trustee Act 1949: Provided however, where the Board invests in or upon titles to immovable property in Malaysia in accordance with section 4(l)(c) of the Trustee Act 1949, such immovable property may or may not yield any income at the time of such investment;"
      }
    },
    {
