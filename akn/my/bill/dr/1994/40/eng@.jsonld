      "schema:name": {
        "@language": "en",
        "@value": "Section 27 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "inserting after the words \"the Board shall\" the words \"with the approval of the Minister,\"."
      }
    },
    {
