      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the proviso to subsection (2) the following subsections: \"(2A) The Chairman of the Disciplinary Committee of the Board and two members of the Committee shall form a quorum at all meetings of the Disciplinary Committee. (2B) The Disciplinary Committee shall have powers to determine the conduct of its proceedings.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"against such decision to the Board which may give such decision thereon as it deems fit and proper\" the words \"to the Board within thirty days from the date of the service of the decision to the last known address of the officer or servant and such decision of the Board thereon shall be final\" in subsection (7)."
      }
    },
    {
