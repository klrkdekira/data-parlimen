      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"two\" the word \"four\" in paragraph (1)(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_11__para_b",
