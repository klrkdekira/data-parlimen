        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may with the written approval of the Minister, invest moneys belonging to the Fund in the following manner:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_6__subsec_2__para_a",
