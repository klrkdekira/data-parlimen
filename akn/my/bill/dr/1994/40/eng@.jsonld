      "schema:name": {
        "@language": "en",
        "@value": "Section 36 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "inserting after subsection (1) the following subsection: \"(1A) For the purpose of this section, an Inspector shall include any officer who is vested with the powers of an Inspector.\"."
      }
