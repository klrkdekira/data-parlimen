        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 43 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"monthly contributions\" the words \"on the amount of wages for the month\" in subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (8) the following subsection: \"(8) Notwithstanding subsection (1)— (a) a self-employed person; (b) a pensionable employee; (c) any person not being an employer or an employee within the meaning of this Act; or (d) any person not being an employer and not being an employee within the meaning of this Act and both have given their consent to contribute, may, by giving notice in such manner and form as may be prescribed by the Board, elect to pay monthly contributions in accordance with the rate as prescribed by the Board.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 44 the following section: 44. In addition to and not in derogation of section 43(3), an employer may with the retirement consent of an employee, remit to the Board at any time any moneys being retirement benefits of any employee in such manner as may be prescribed by the Board and where any such moneys has been received, the Board shall cause such moneys to be paid into the Fund in accordance with section 50.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 45 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"the rate of the word \"last\" in the proviso to subsection (3); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(4) Any employer who contravenes the provisions of subsection (3) shall be guilty of an offence and shall, on conviction, be liable to imprisonment for a term not exceeding three years or to a fine not exceeding ten thousand ringgit or both.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Employees Provident Fund (Amendment) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into force of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
