      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 30 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"be the General Manager\" the words \"exercise the duties of the General Manager and shall be known as the Executive Chairman and any remuneration or allowance paid shall be determined by the Minister\" in subsection (2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_9__para_b",
