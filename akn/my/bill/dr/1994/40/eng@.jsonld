    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 37 the following section— Power of 37A. (1) An Inspector or an officer vested the Board with the powers of an Inspector may, assess to assess any contributions which is due by any employer contribu- tions based on any information available if the based on employer— informa- tion"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "fails to keep or maintain any statement, available. particulars, register book or any record pertaining to each employee as required to be performed by him under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuse to submit any statement, particulars, register book or record pertaining to each employee as required to be submitted by him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The assessment made under subsection (1) shall be sufficient proof of the Board's claim for the recovery of any contributions under section 65.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
