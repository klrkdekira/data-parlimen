        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 73 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subperenggan (m)(iv) dengan subperenggan yang berikut: \"(iv) Kaedah-kaedah tatatertib yang dibuat di bawah Akta ini boleh, dalam menetapkan prosedur bagi prosiding tatatertib mengadakan peruntukan bagi peluang untuk representasi dibuat dalam keadaan-keadaan tertentu oleh orang terhadapnya prosiding tatatertib itu diambil sebelum sesuatu keputusan dicapai oleh pihak berkuasa tatatertib ke atas tuduhan tatatertib yang dikenakan terhadap orang itu;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dan\" di hujung subperenggan (m)(iv);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (m) perenggan yang berikut: \"(n) untuk menetapkan prosedur yang hendaklah diikuti dalam hal berhubungan dengan kewangan dan akaun Kumpulan Wang; dan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula perenggan (n) yang sedia ada sebagai perenggan (o)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Keempat Akta ibu adalah dipotong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah bertindih dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong proviso."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas perkataan \"seorang ahli lain Lembaga,\" perkataan \"atau mana-mana dua orang ahli lain Lembaga\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
