      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 4(4) Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 65(1) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Kesemua caruman\" dengan perkataan \"Walau apa pun peruntukan mana-mana undang- undang bertulis yang lain kesemua caruman\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 66 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dalam masa dua belas bulan sebelum tarikh perintah itu\" dalam subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(2) Dalam seksyen ini perkataan \"caruman\" hendaklah disifatkan sebagai termasuk apa-apa dividen dan faedah yang kena dibayar ke atas mana-mana caruman.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 72 ( b) perenggan yang berikut: \"(c) mengisytiharkan mana-mana orang atau golongan orang yang diambil kerja, yang terlibat atau berkontrak untuk menjalankan kerja dalam mana- mana pekerjaan dalam apa-apa kegiatan pertanian atau perusahaan, kerja binaan, tred, peraiagaan atau tempat kerja sebagai pekerja atau pekerja- pekerja dan orang yang mengambil kerja, terlibat atau berkontrak dengan setiap orang atau golongan orang yang disebut di atas, hendaklah disifatkan sebagai majikan dan majikan dan pekerja itu hendaklah disifatkan telah membuat kontrak perkhidmatan antara satu sama lain dan Menteri boleh memutuskan apa-apa bayaran yang diterima oleh orang yang disebut di atas sebagai upah bagi maksud Akta ini;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_33__para_a",
