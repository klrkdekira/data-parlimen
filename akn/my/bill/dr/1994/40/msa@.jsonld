      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"fee lain dan kos\" perkataan \"di bawah seksyen 14\" dalam perenggan (d)\\ dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"di bawah seksyen 14\" dalam perenggan (e)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a",
