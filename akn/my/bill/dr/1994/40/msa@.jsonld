        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 26 dengan seksyen yang berikut: 26. (1) Lembaga boleh tertakluk kepada seksyen 18(2), melabur wang kepunyaan Kumpulan Wang mengikut cara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "didepositkan dalam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank Negara Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank yang dilesenkan sewajarnya di bawah Akta Bank dan Institusi- Institusi Kewangan 1989; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana institusi kewangan lain yang dilesenkan sewajarnya di bawah Akta Bank dan Institusi-Institusi Kewangan 1989 dan diluluskan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dilabur dalam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "saham mana-mana syarikat awam yang tersenarai dalam bursa saham yang ditubuhkan di Malaysia dan pembelian saham baru, terbitan atau jualan yang baginya telah diluluskan di bawah Akta Perindustrian Sekuriti 1983, dalam mana-mana syarikat awam berhad yang diperbadankan di Malaysia yang tersenarai dalam suatu bursa saham di Malaysia atau yang penyenaraiannya dalam suatu bursa saham di Malaysia telah di- luluskan di bawah Akta Perindustrian Sekuriti 1983; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "debentur mana-mana syarikat awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam bon-bon atau pembelian kertas- kertas gadai-janji, nota-nota perdagangan, persetujuan-persetujuan jurubank, kertas- kertas pasaran wang, sijil-sijil deposit, sekuriti hutang persendirian, nota-nota janji hutang dan bil-bil pertukaran mengikut pengertian Akta Bil-Bil Pertukaran 1949 dan instrumen bolehniaga lain jenis yang seumpamanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mengikut peruntukan-peruntukan Akta Pemegang Amanah 1949: Dengan syarat bagaimanapun, jika Lembaga melaburkan dalam atau atas hakmilik-hakmilik kepada harta tak alih di Malaysia mengikut seksyen 4( 1 )(c) Akta Pemegang Amanah 1949, harta tak alih itu mungkin atau mungkin tidak meng- hasilkan apa-apa pendapatan pada masa pelaburan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi pinjaman kepada Kerajaan Persekutuan atau Negeri; dan (/) memberi pinjaman kepada ahli Kumpulan Wang tertakluk kepada apa-apa terma dan syarat sebagaimana yang boleh ditentukan oleh Lembaga bagi maksud pembelian atau pembinaan sebuah rumah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh dengan kebenaran bertulis Menteri, melabur wang kepunyaan Kumpulan Wang dengan cara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "didepositkan dalam mana-mana bank atau institusi kewangan yang ditubuhkan oleh atau di bawah mana-mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dilaburkan dalam apa-apa usahasama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyertai dalam apa-apa program pen- swastaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi pinjaman kepada mana-mana syarikat yang diperbadankan di bawah Akta Syarikat 1965 atau mana-mana perbadanan yang ditubuhkan oleh atau di bawah mana- mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan melabur dalam apa-apa pelaburan di luar Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dilaburkan dalam apa-apa bentuk pelaburan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini— \"debentur\" termasuklah stok debentur, bon-bon, nota-nota dan mana-mana sekuriti lain sesebuah perbadanan sama ada membentuk suatu gadaian ke atas aset perbadanan atau tidak; dan \"saham\" ertinya saham-saham berbayar (sama ada dibayar secara penuh atau tidak) dalam modal saham syarikat dan termasuklah stok-stok dan hak-hak untuk melanggan bagi mana-mana stok dan saham.'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 26 seksyen yang berikut: 26A. (1) Sebagai tambahan kepada kuasa Lembaga untuk melabur mengikut seksyen 26, Lembaga boleh melabur— (a) secara pinjaman kepada sesuatu syarikat diluluskan atau pembelian syer dalam sesuatu syarikat diluluskan; atau (b) secara pinjaman perumahan khas kepada sesuatu syarikat diluluskan. (2) Tiada wang kepunyaan Kumpulan Wang boleh dilaburkan mengikut subseksyen (1) melainkan jika— (1) (a) modal syer biasa berbayar syarikat diluluskan itu adalah tidak kurang daripada lima juta ringgit Malaysia; (b) syarikat diluluskan itu telah membayar dividen pada kadar yang tidak kurang daripada lima peratus ke atas modal syer biasa itu dalam setiap tiga tahun yang terakhir sebelum masa pelaburan itu dan jika syarikat diluluskan itu adalah suatu syarikat yang telah memperolehi aset-aset dan liabiliti-liabiliti sesuatu syarikat diluluskan yang lain, pembayaran dividen oleh syarikat yang lain itu dalam setiap tiga tahun yang terakhir sebelum masa perolehan itu hendaklah dianggap sebagai pembayaran oleh syarikat diluluskan itu; (c) dalam hal sesuatu syarikat diluluskan yang tujuan tunggal atau utamanya adalah untuk menggalakkan pemunyaan rumah dan, jumlah amaun peminjaman syarikat diluluskan itu daripada semua sumber, tidak termasuk amaun apa-apa pinjaman perumahan khas, sama ada pemegang amanah atau tidak, yang telah diterima oleh syarikat diluluskan itu atas pinjaman dan deposit, dan termasuk faedah yang kena dibayar ke atasnya dan tidak dibayar balik oleh syarikat diluluskan itu, tidak pada bila-bila masa melebihi tiga perempat daripada amaun, tidak termasuk faedah akan datang, yang pada masa itu dicagarkan kepada syarikat diluluskan itu daripada peminjam-peminjamnya; (d) suatu perakuan bahawa peruntukan- peruntukan perenggan (a), (b) dan (c) subseksyen ini telah dipatuhi berkenaan dengan tahun kewangan yang terakhir bagi syarikat diluluskan itu, jika dimasukkan dalam laporan juruaudit yang dilampirkan kepada akaun tahunan syarikat diluluskan itu yang dikehendaki disediakan di bawah Akta Syarikat 1965, yang kepadanya syarikat diluluskan itu tertakluk, hendaklah muktamad memihak kepada Lembaga yang membuat pelaburan itu; dan (e) mana-mana perjanjian tentang pem- bayaran balik yang dibuat antara Lembaga dan syarikat diluluskan itu hendaklah ditamatkan dengan serta-merta jika— (i) syarikat diluluskan itu terhenti daripada mematuhi mana-mana peruntukan perenggan (a), (b) dan (2) (c) subseksyen ini; (ii) syarikat diluluskan itu tidak mendapatkan suatu perakuan dalam terma-terma dan mengikut cara yang dinyatakan dalam perenggan (d) subseksyen ini; atau (iii) Menteri boleh, pada bila-bila masa melalui pemberitahuan dalam Warta, mengarahkan bahawa syarikat itu hendaklah terhenti daripada menjadi suatu syarikat diluluskan akibat daripada pertimbangannya bahawa syarikat itu telah menyimpang daripada tujuan tunggal atau utamanya, dan apa-apa wang kepunyaan Kumpulan Wang hendaklah sesudah itu kena dibayar balik dengan serta-merta. 26B. (1) Tertakluk kepada apa-apa perubahan yang boleh dibuat oleh Menteri di bawah subseksyen (2), Lembaga hendaklah melaburkan atau melaburkan semula sekurang-kurangnya lima puluh peratus, daripada wang yang dipunyai oleh Kumpulan Wang dan dilaburkan atau dilaburkan semula dalam mana-mana satu tahun, dalam sekuriti-sekuriti yang diterbitkan oleh Kerajaan Malaysia dengan syarat bahawa jumlah amaun wang dilaburkan sedemikian dalam sekuriti- sekuriti itu pada bila-bila masa tertentu tidaklah boleh kurang daripada tujuh puluh peratus daripada jumlah pelaburan Kumpulan Wang. (2) Menteri boleh, atas permohonan Lembaga, mengubah peratusan yang dinyatakan dalam subseksyen (1). (3) Bagi maksud seksyen ini, sekuriti-sekuriti yang diterbitkan oleh Kerajaan Malaysia hendaklah termasuk— (a) pinjaman-pinjaman yang dijamin sepenuh- nya oleh Kerajaan Persekutuan; (b) kertas-kertas Bank Negara Malaysia dengan tempoh matang sekurang-kurangnya tiga tahun dari tarikh terbitan; (c) mana-mana instrumen komersial (yang mempunyai sifat-sifat bolehniaga) yang diterbitkan oleh Kerajaan Negeri atau pihak-pihak berkuasa tempatan dengan tempoh matang sekurang-kurangnya tiga tahun dari tarikh terbitan; (d) apa-apa jua bon dengan tempoh matang sekurang-kurangnya dua tahun dari tarikh terbitan; dan (e) apa-apa deposit dalam akaun sumbangan pendahuluan di bawah 26(1)(a)(i).\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 27 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas perkataan \"Lembaga hendaklah\" perkataan \"dengan kelulusan Menteri,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 30 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"hendaklah menjadi Pengurus Besar\" dengan perkataan \"hendaklah menjalankan tugas-tugas Pengurus Besar dan hendaklah dikenali sebagai Pengerusi Eksekutif dan apa-apa saraan atau elaun yang dibayar hendaklah ditentukan oleh Menteri\" dalam subseksyen (2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/40/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dan Penolong- Penolong Pengurus Besar\" dalam perenggan (3)(a)."
