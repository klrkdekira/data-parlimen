    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Criminal Procedure Code (Amendment) Act 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Criminal Procedure Code, which in this Act is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "referred to as the \"Code\", is amended by deleting section 8."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the Code is amended by deleting paragraphs"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(b) and (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 128 of the Code is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
