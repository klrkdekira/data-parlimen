      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (3)(a) the following paragraph: \"(3) (a) When an order is made under paragraph (cc) of subsection (1) the lower Court before which the trial of the offence against the accused person is pending shall cause the accused person to appear or be brought before the High Court on the date specified in the said order or as soon as may be practicable if no such date is specified.\"; and"
      }
    },
