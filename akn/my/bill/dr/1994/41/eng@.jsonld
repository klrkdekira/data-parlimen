      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (i)(d) by deleting the words \"either to inquire into or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (ii) by deleting the word \"either\" and the words \"or committed for trial before the High Court\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Code is amended by deleting Chapters XVII and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "XVIlA."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 158(i) of the Code is amended by deleting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the words \"or in the case of trials by jury or trials with the aid of assessors before the verdict of the jury is returned or the opinions of the assessors are expressed\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 177 of the Code is amended by deleting the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "words \"or proceed under Chapter XVII with a view to the committal of the accused for trial by the High Court, and shall record such order upon the proceedings\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Code is amended by inserting after section 177 in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "177A. Chapter XIX the following section: 177A. (1) A prosecution in respect of an offence which is to be tried by the High Court in accordance with Chapter XX, shall not be instituted except by or with the consent of the Public Prosecutor: Provided that a person may be arrested, or a warrant for his arrest may be issued and executed, and any such person may be remanded in custody notwithstanding that the consent of the Public Prosecutor to the institution of a prosecution for the offence has not been obtained, but the case shall not be further prosecuted until the consent has been obtained."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "In any prosecution pursuant to subsection (1), the accused shall be produced before the Magistrate's Court which shall, after the charge has been explained to him, transmit the case to the High Court and cause the accused to appear or be brought before such Court as soon as may be practicable: Provided that when the accused is brought before the Magistrate's Court before the Public Prosecutor has consented to the prosecution, the charge shall be explained to him but he shall not be called upon to plead thereto."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "When the accused appears or is brought before the High Court in accordance with subsection (2), the High Court shall fix a date for his trial which shall be held in accordance with the procedure under Chapter XX.\","
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The heading to Chapter XX of the Code is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "deleting the words \"WITHOUT ASSESSORS\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39",
      "@type": "akn:paragraph",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any preliminary inquiry, trial by jury or trial with the aid of assessors that has been commenced before or on the commencement of this Act shall be continued orconcluded in all respects as if this Act had not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/eng@/~sched_1__para_39",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), any preliminary inquiry or trial has been commenced when the accused has appeared before or has been brought before the Magistrate's Court or the High Court, as the case may be, and evidence has begun to be adduced in the inquiry or trial."
      }
    }
  ]
}
