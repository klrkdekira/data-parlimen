      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a) by deleting the words \"inquiry or\"; (ii) in paragraph (c) by deleting the words \"inquiry into or\"; (iii) in paragraph (aa) by deleting the words \"inquired into or\"; (iv) in paragraph (cc) by substituting for the word \"; or\" a full stop; and (v) by deleting paragraphs (dd) and (ee);"
      }
    },
    {
