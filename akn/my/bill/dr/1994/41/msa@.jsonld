      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (aa) dengan memotong perkataan \"inquired into or\"; (iv) dalam perenggan (cc) dengan meng- gantikan perkataan \"; or\" dengan noktah; dan (v) dengan memotong perenggan (dd) dan (ee)\\"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~chp_XVII__cl_33__para_b",
      "@type": "akn:paragraph",
