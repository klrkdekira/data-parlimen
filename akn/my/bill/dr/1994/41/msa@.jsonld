      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (3)(a) dengan perenggan yang berikut: \"(3) (a) When an order is made under paragraph (cc) of subsection (1) the lower Court before which the trial of the offence against the accused person is pending shall cause the accused person to appear or be brought before the High Court on the date specified in the said order or as soon as may be practicable if no such date is specified.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~chp_XVII__cl_33__para_c",
      "@type": "akn:paragraph",
