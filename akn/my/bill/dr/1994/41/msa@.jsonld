      "schema:name": {
        "@language": "ms",
        "@value": "Kanun Prosedur Jenayah, yang disebut \"Kanun\" dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini, adalah dipinda dengan memotong seksyen :"
      }
    },
