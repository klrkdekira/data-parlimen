      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Kedua kepada Kanun adalah dipinda dengan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~chp_XVII__cl_6",
      "@type": "akn:clause",
