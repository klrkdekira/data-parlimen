      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~sched_2__para_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa siasatan permulaan, perbicaraan oleh juri atau perbicaraan dengan bantuan pengapit yang telah dimulakan sebelum atau pada mula berkuatkuasanya Akta ini hendaklah diteruskan atau diselesaikan dalam segala aspek seolah-olah Akta ini telah tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~sched_2__para_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/41/msa@/~sched_2__para_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), apa-apa siasatan permulaan atau perbicaraan telah dimulakan apabila yang tertuduh telah hadir di hadapan atau telah dibawa di hadapan Mahkamah Majistret atau Mahkamah Tinggi, mengikut mana-mana yang berkenaan, dan keterangan telah mula dikemukakan dalam siasatan atau perbicaraan itu."
      }
    }
  ]
}
