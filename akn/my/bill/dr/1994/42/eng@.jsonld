      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: \"(2A) An application for leave under subsection (2) shall be made within fourteen days after the date of the decision of the High Court.\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 51(2) of the principal Act is amended by of section 51. substituting for the full stop a colon and inserting thereafter the following proviso: \"Provided that, in a case of an appeal under section 50(2), the computation of the aforesaid period of fourteen days shall commence from the date immediately after leave has been granted by the Court of Appeal.\". Amendment"
      }
    },
