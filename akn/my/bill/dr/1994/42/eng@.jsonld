    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Any proceeding which is pending before the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Supreme Court on the 23rd June 1994 shall be continued or proceeded with, as the case may be, before the Federal Court and for this purpose the Federal Court shall have and exercise all the powers of the Supreme Court prior to 24th June 1994."
      }
    },
