      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3) dengan memotong perkataan \", but the evidence shall not be taken in the presence of a jury or assessors\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_14__para_c",
      "@type": "akn:paragraph",
