      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 65 Akta ibu adalah dipotong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_11",
