        "@language": "ms",
        "@value": "Seksyen 95 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
