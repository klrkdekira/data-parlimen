      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 96 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"enactments or\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dan proviso kepadanya dengan perenggan yang berikut: \"(a) from any judgment or order of the Court of Appeal in respect of any civil cause or matter decided by the High Court in the exercise of its original jurisdiction; and\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa prosiding yang belum selesai di hadapan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Agung pada 23hb Jun 1994 hendaklah disambung atau diteruskan, mengikut mana-mana yang berkenaan, di hadapan Mahkamah Persekutuan dan bagi maksud ini Mahkamah Persekutuan hendaklah mempunyai dan menjalankan semua kuasa Mahkamah Agung sebelum 24hb Jun 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 50 Akta Mahkamah Kehakiman 1964, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut \"Akta ibu\" dalam Akta ini, adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": ". dalam perenggan (1)(b), dengan memasukkan selepas perkataan \"appellate\" perkataan \"or revisionary\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_b__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"appellate\" perkataan \"or revisionary\"; dan (ii) dengan memasukkan selepas perkataan \"questions of law\" perkataan \"which have arisen in the course of the appeal or revision and the determination of which by the High Court has affected the event of the appeal or revision\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) An application for leave under subsection (2) shall be made within fourteen days after the date of the decision of the High Court.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 51(2) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan noktah dengan noktah bertindih dan memasukkan selepas subseksyen 51(2) proviso yang berikut: \"Provided that, in a case of an appeal under section 50(2), the computation of the aforesaid period of fourteen days shall commence from the date immediately after leave has been granted by the Court of Appeal.\"."
      }
    },
    {
