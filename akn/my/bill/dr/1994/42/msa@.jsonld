      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Mahkamah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kehakiman (Pindaan) (No. 2) 1994 dan hendaklah disifatkan telah mula berkuatkuasa pada 24hb Jun 1994."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_10",
