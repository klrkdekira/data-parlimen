      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 52(1) Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_4__para_a",
