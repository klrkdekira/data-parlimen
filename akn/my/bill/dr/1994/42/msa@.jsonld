      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4) dengan menggantikan perkataan \"trial court\" dengan perkataan \"High Court\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_15",
