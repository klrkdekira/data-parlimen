      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"trial court\" yang terdapat selepas perkataan \"thereon to the\" dengan perkataan \"High Court\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_13__para_a__subpara_iii",
      "@type": "akn:subparagraph",
