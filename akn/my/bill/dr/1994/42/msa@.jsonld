      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dan (2) dengan menggantikan perkataan \"trial court\" dengan perkataan \"High Court\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/42/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
