        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the Kidnapping Act 1961 is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering subsection 3(1) as section 3;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (3) aiid the marginal note thereto; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any trial with the aid of assessors that has been commenced before or on the commencement of this Act shall be continued or concluded in all respects as if this Act has not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), any trial has been commenced when the accused has appeared before or has been brought before the High Court and evidence has begun to be adduced in the trial."
      }
    }
  ]
