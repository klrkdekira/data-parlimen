      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta Penculikan 1961 adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula subseksyen 3(1) sebagai seksyen 3;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
