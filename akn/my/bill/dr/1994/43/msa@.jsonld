      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3) dan nota birai kepadanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
