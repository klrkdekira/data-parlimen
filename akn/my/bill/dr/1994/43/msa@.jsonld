      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbicaraan dengan bantuan pengapit yang telah dimulakan sebelum atau pada mula berkuatkuasanya Akta ini hendaklah diteruskan atau diselesaikan dalam segala aspek seolah-olah Akta ini telah tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/43/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), apa-apa perbicaraan telah dimulakan apabila tertuduh telah hadir di hadapan atau telah dibawa di hadapan Mahkamah Tinggi dan keterangan telah mula dikemukakan dalam perbicaraan itu."
      }
    }
  ]
