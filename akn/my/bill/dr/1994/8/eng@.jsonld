        "@value": "in subsection (1) by inserting after the words \"such officer\" the words \"or any other person authorised to conduct weighing\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1994/8/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
