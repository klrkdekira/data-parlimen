      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding one billion one hundred and forty-three million eight hundred and eighty-one thousand seven hundred and fifty ringgit (RMl,143,881,750) from the Consolidated Fund for expenditure on the services specified in the Second Schedule for the service of the year 1995, not provided for or not fully provided for by the Supply Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Second Schedule. FlRST SCHEDULE (Section 2) Purpose Title B. 1 Parliament B. 4 Election Commission B. 7 Prime Minister's Department B. 14 Ministry of Housing and Local Government B. 15 Town and Country Planning Department B. 16 Fire Services Department B. 19 Ministry of Agriculture B. 22 Ministry of Culture, Arts and Tourism B. 25 Ministry of Defence B. 26 Ministry of Education B. 28 Treasury B. 30 Contribution to Statutory Funds B. 31 Royal Customs and Excise Department B. 32 Inland Revenue Department B. 33 Valuation and Property Services Department B. 34 Ministry of Health B. 36 Royal Malaysia Police B. 37 Immigration Department B. 40 Prisons Department B. 42 Ministry of National Unity and Social Development B. 43 Ministry of Law B. 47 Ministry of Transport B. 52 Ministry of Works TOTAL 14,807,476,746 SUPPLEMENTARY SUPPLY (1994 AND 1995)"
      }
    },
