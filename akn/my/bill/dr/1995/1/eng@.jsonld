      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding fourteen billion eight hundred and seven million four hundred and seventy-six thousand seven hundred and forty-six ringgit (RM14,807,476,746) from Consolidated Fund for expenditure on the services specified in the Pirst Schedule for the seryice of the year 1994, not provided for or not fuljy provided for by the Supply Act 1994, the Supplementary Supply (1993 and 1994) Act 1994, the Supplementary Supply (1994) Act 1994 and the Supplementary Supply (1994) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Pirst Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_3",
