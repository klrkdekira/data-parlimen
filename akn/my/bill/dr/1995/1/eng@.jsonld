      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1994 and 1995) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/1/eng@/~cl_2",
