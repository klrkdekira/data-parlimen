      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FUNCTIONS AND POWERS OF THE CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to promote and co-ordinate the development of small and medium industries in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake studies related to the development of small and medium industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake promotional activities in the country to promote the growth of small and medium industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to establish a comprehensive database and information system on small and medium industries development programmes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to become the centre for collection, reference and dissemination of information related to small and medium industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to provide technical support and management counselling services with the co-operation of other agencies involved in the enhancement of small and medium industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to promote mutual co-operation among small and medium industries through amalgamation of businesses, technical co-operation, establishment of mutual fund or co-operative enterprise and the procurement of common equipment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to encourage industrial linkages with large industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to promote human resource development in the small and medium industries; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to do all such matters as may be incidental to or consequential upon the discharge of its functions, from time to time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Corporation shall have power to do all things"
      },
      "schema:text": {
        "@language": "en",
        "@value": "reasonably necessary for, or expedient or incidental to, the discharge of its functions under this Act and in particular, but without prejudice to the generality of the foregoing:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to establish and maintain branch offices with the approval of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint agents or obtain services for the purpose of carrying out its function under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to establish a comprehensive database and information system on small and medium industries development programmes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to acquire and hold venture capital in any company with the approval of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to organise promotional activities for small and medium industries such as participation in trade exhibitions, seminars and conferences in Malaysia and abroad;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to publish or sponsor the publication of periodicals, booklets and other information materials in any media; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "to charge a fee for the use of any facilities or services provided by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Corporation may, from time to time, borrow in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "such form and at such rate of interest and for such period and upon such terms as to the time and method of repayment and otherwise, as the Minister, with the concurrence of the Minister of Finance may approve, any sum required by the Corporation for meeting any of its obligations or discharging any of its functions or exercising any of its powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Corporation may engage and pay agents and technical"
      },
      "schema:text": {
        "@language": "en",
        "@value": "advisers, and any other person deemed necessary to transact any business or to do any act required to be transacted or done in the discharge of its functions or the exercise of its powers or for the better carrying into effect the purposes of this Act. DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, subject to such terms and conditions, limitations or restrictions as it deems fit to impose, delegate to the Chairman, the Chief Executive Officer or any member of the Corporation, the power and authority to exercise or perform on its behalf such of its powers or functions under this Act as it may determine, except the power to make regulations under section 32; and any power or functions so exercised or performed by the Chairman, or the Chief Executive Officer or the other member of the Corporation as the case may be, shall be deemed to have been exercised by and on behalf of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1) and to the other provisions of this Act, the Corporation may delegate to either the Chairman or to the Chief Executive Officer authority to sanction expenditure from the Fund or any other moneys vested in and under the control of the Corporation up to such limit as the Corporation shall specify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may appoint committees for any purpose arising out of or connected with any of its functions and powers; any committee so appointed shall include at least one member of the Corporation and there may be appointed to such committee such other persons as the Corporation thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The committee so appointed shall regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any committee so appointed shall conform to any instructions from time to time given to it by the Corporation and the Corporation may at any time discontinue or alter the constitution of any committee so appointed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The commitee may invite any person who, in its opinion, is possessed of special knowledge of advantage to it, to attend any meeting of the committee and the person so invited shall not be entitled to vote at any such meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall report its recommendations to the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Where any person ceases to be a member of the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Corporation by reason of the provisions of this Act, the Minister may appoint another person to fill the vacancy for the remainder of the term for which the member was appointed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be paid to the members and alternate members of the Corporation such allowances as the Minister may determine. DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "There shall be established a body corporate to be known"
      },
      "schema:text": {
        "@language": "en",
        "@value": "as the \"Small and Medium Industries Development Corporation\" which shall have perpetual succession and a common seal, and which may sue and be sued in its name and, subject to and for the purposes of this Act, may enter into contracts and may acquire, purchase, take, hold and enjoy movable and immovable property of every description and may convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property or any interest therein vested in the Corporation upon such terms as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Deputy Chairman who shall be a representative from the Ministry of International Trade and Industry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Finance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Economic Planning Unit of the Prime Minister's Department;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer of the Corporation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such other members, not exceeding six, as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Corporation shall be appointed by the Minister and subject to sections 5 and 6, shall, unless DEVELOPMENT CORPORATION they sooner resign or their appointment is sooner revoked, hold office subject to such terms and conditions as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Schedule shall apply to the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Subject to section 6, members of the Corporation other"
      },
      "schema:text": {
        "@language": "en",
        "@value": "than the Chief Executive Officer shall hold office for a term not exceeding three years as the Minister may determine at the time of their appointment and shall be eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of any member of the Corporation without giving any reason therefor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation may at any time resign from his office by giving notice in writing to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint any member of the Corporation to exercise the functions of the Chairman during any period the Chairman is for any reason unable to exercise his functions or during any period of any vacancy in the office of the Chairman; and such member shall, during the period in which he is exercising the functions of the Chairman, under this subsection, be deemed to be the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Until an appointment is made under subsection (1) or in default of such appointment, the member appointed under paragraph 4(l)(b) shall exercise the functions of and be deemed to be the Chairman of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in respect of each member of the Corporation appointed under paragraphs 4(l)(b), (c) and (d), appoint one person to be an alternate member to attend in place of the member, meetings of the Corporation that the member is for any reason unable to attend."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "When attending meetings of the Corporation, an alternate member shall for all purposes be deemed to be a member of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An alternate member shall, unless he sooner resigns or his appointment is sooner revoked, cease to be an alternate member if the member for whom he is an alternate member ceases to be a member of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation shall be disqualified and his appointment as such member shall be revoked if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any other offences punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt or has made an arrangement with his creditors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he has been found or declared to be of unsound mind or is otherwise incapable of performing his duties or managing his affairs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "at three consecutive meetings of the Corporation, without leave in writing of the Minister, he has neither been present nor represented by the alternate member, if any, appointed in his respect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of subsection (1), other than paragraph (d), shall apply mutatis mutandis to an alternate member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCIAL PROVISIONS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act the Corporation shall establish, administer and control a fund to be known as the \"Small and Medium Industries Development Fund\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be paid into the Fund—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the launching grant of the Fund provided by the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided from time to time by the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums borrowed by the Corporation under section 14;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be allocated from time to time to the Corporation from loan funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys earned by the Corporation for services provided or operation of any projects, schemes or enterprises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all donations and contributions received from within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys earned or arising from any property, investment, mortgages, charges or debentures acquired by or vested in the Corporation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys belonging to or which in any manner become payable to the Corporation in respect of any matter incidental to its functions, powers and duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "In this section and section 20, the expression \"loan funds\" means such sums as may be made available from time to time to the Government by way of loan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Fund shall be expended for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of any expenses lawfully incurred by the Corporation, the remuneration of officers and DEVELOPMENT CORPORATION servants appointed and employed by Corporation, including superannuation allowances, pensions or gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of any charges on any amount which may be allocated to the Corporation from loan funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, cost or expenditure properly incurred by the Corporation in the execution of its duties or in the discharge of its functions including fees and costs for professional services rendered to the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under this Act and the interest due thereon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the making of loans to officers and servants of the Corporation for purposes approved by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "It shall be the duty of the Corporation to conserve the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "revenue of the Fund by exercising its powers and functions under this Act in such a way as to ensure that the total revenue of the Corporation are, subject to any directions given by the Minister under section 34, sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest on capital, taking one year with another."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Corporation may, with the approval of the Minister,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "place the Fund on deposit with a bank in Malaysia or invested in the securities of the Government or such other securities as may be approved by the Minister with the concurrence of the Minister of Finance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The expenses of the Corporation up to such amount as may be authorised by the Minister for any year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Before the beginning of September of each year, the Corporation shall submit to the Minister an estimate of its expenditure (including those for development projects) for the following year in such form and containing such particulars as the Minister may direct; and the Minister shall before the beginning of the following year, notify the Corporation of the amount authorised for expenditure generally or of amounts authorised for each description of expenditure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may at any time submit to the Minister a supplementary estimate of expenditure for any one year and the Minister may allow the whole or any part of the additional expenditure included therein."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The provisions of the Statutory Bodies (Accounts and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Annual Reports) Act 1980 shall apply to the Corporation. 1980."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is or was in the employment of the Corporation may be surcharged if it appears to the Corporation that the person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has failed to collect any moneys owing to the Corporation for the collection of which he is or was responsible;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is or was responsible for any improper payment of moneys from the Corporation or for any payment of such moneys which is not dul approved;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is or was responsible, directly or indirectly, for any deficiency in, or for the destruction of, any moneys, stamps, securities, stores or other property of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being or having been an accounting officer, fails or has failed to keep proper accounts or records; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has failed to make any payment, or is or was responsible for any delay in the payment, of moneys to any person to whom such payment is due under any law or under any contract, agreement or arrangement entered into between that person and the Corporation. DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall, before such person is surcharged serve- on him a written notice calling on him to show cause why he should not be surcharged."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If a satisfactory explanation is not received within fourteen days from the date of service of the aforesaid notice, the Corporation may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraphs (1)(a), (b) and (c), surcharge against such person a sum not exceeding the amount not collected, or of the improper payment made, or of the deficiency in or destruction of property caused; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraphs (l)(d) and (e), surcharge against such person, such sum as the Corporation may think fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall notify the person surcharged in respect of any surcharge made under sub- section (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsections (3) and (4) the Corporation may at any time withdraw any surcharge if it appears that no surcharge should have been made, and the Chief Executive Officer shall forthwith notify the person surcharged of such withdrawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The amount of any surcharge made under subsection (3) and not withdrawn under subsection (5) shall be a debt due to the Corporation from the person surcharged and may be sued for and recovered in any court at the suit of the Corporation and may also if the Corporation so directs be recovered by deduction from—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the salary of the person surcharged; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_IV__cl_24__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the pension of the person surcharged, by equal monthly instalments not exceeding one-fourth of the total monthly salary or pension, as the case may be, of that person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Small and Medium Industries"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Development Corporation Act 1995 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"company\" means a company incorporated under the Companies Act 1965 and includes a business registered under the Registration of Businesses Act 1956; \"Corporation\" means the Small and Medium Industries Development Corporation established under section 3; \"Fund\" means the Small and Medium Industries Development Fund established under section 19; \"manufacturing activity\" has the same meaning assigned to it under the Industrial Coordination Act 1975; \"Minister\" means the Minister responsible for international trade and industry; \"small and medium industry\" means a company engaged in manufacturing activities and related activities as the Minister may, in a statutory order published in the Gazette, determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ADMINISTRATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_34"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Corporation, make such regulations as may be expedient or necessary for the proper and effective carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the foregoing, such regulations may be made for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "imposing fees in such cases as may be determined by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "or in respect of allowances to be paid to any member and alternate member of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the responsibilities, conduct and control of officers and servants of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "or in respect of the remuneration, allowances and conditions of service of officers and servants of the Corporation; DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of pensions, allowances or gratuities to the officers and servants of the Corporation upon their retirement or otherwise ceasing to hold office as such officers and servants;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the manner in which and the terms and conditions on which loans to officers and servants of the Corporation may be granted under paragraph 19 (f) and the purposes therefor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the discipline of the officers and servants of the Corporation, which may include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for the interdiction with reduction in salary or in other remuneration, or for the suspension without salary or other remuneration, of an officer or servant of the Corporation during the pendency of disciplinary proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g",
      "schema:text": {
        "@language": "en",
        "@value": "the creation of such disciplinary offences and providing for such disciplinary punishments as the Corporation may deem appropriate, and the punishments so provided may extend to dismissal or reduction in rank; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_cc",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_dd"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure for disciplinary proceedings which shall provide the officer or servant of the Corporation against whom disciplinary proceedings are taken an opportunity to make representations against the disciplinary charge laid against him before a decision is arrived at by the disciplinary authority, except in the following cases where:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "an officer or servant of the Corporation is dismissed or reduced in rank on the ground of conduct in respect of which a criminal charge has been proved against him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "the Corporation is satisfied that for some reason, to be recorded by the Corporation in writing it is not reasonably practicable to carry out the requirements subparagraph; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister is satisfied that in the interest of the security of the Federation or any part thereof it is not expedient to carry out the requirements of this subparagraph; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_dd",
      "@type": "akn:subparagraph",
      "eli:number": "dd",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "there has been made against an officer or servant of the Corporation any order of detention, supervision, restricted residence, banishment or deportation, or where there has been imposed on such officer or servant of the Corporation any form of restriction or supervision by bond or otherwise, under any law relating to the security of the Federation or any part thereof; prevention of crime, preventive detention, restricted residence, banishment, immigration, or protection of women and girls; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing all other such matters which under this Act may be prescribed by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall furnish to the Minister, such returns, reports, accounts and information with respect to its property and activities as the Minister may from time to time require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the provisions of subsection (1), the Corporation shall, as soon as practicable after the end of each financial year, cause to be made and transmitted to the Minister a report dealing with the activities of the Corporation during the preceding financial year and the report shall be in such form and shall contain such information relating to the proceedings and policies of the Corporation as the Minister may from time to time specify. DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may give to the Corporation such directions"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of a general nature, not inconsistent with the provisions of this Act as to the discharge of the functions and exercise of the powers of the Corporation and the Corporation shall give effect to such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister shall appoint a Chief Executive Officer"
      },
      "schema:text": {
        "@language": "en",
        "@value": "upon such terms and conditions as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "There shall be paid to the Chief Executive Officer such"
      },
      "schema:text": {
        "@language": "en",
        "@value": "remuneration as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be responsible to the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Corporation for the proper administration and management of the functions and affairs of the Corporation in accordance with the policy laid down by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2) and any regulations made under paragraphs 32(2)(c), (d) and (e), the Corporation may from time to time appoint such number of officers and servants as it may think desirable and necessary, and upon such terms and conditions as it considers appropriate, for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provision of subsection (1), the Corporation shall not establish or modify any post or scheme of service for officers and servants of the Corporation, including the terms and conditions of service and the salaries, any pension scheme, and any scheme relating to allowances and other remuneration, without the prior approval of the Ministry of Finance and the Public Services Department."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a Disciplinary Board of the Corporation which shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Corporation upon such appeal shall be final and conclusive."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "two members to be elected by and from the members of the Corporation, one of whom shall be elected Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Disciplinary Board of the Corporation established under subsection (1) shall be the disciplinary authority in respect of every officer and servant of the Corporation other than the Chief Executive Officer. DEVELOPMENT CORPORATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall not be a member of the Disciplinary Board in any proceedings before it in which he is the complainant; his place shall be taken by a member to be elected by and from members of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "In the exercise of its disciplinary functions and powers, the Disciplinary Board shall have the power to impose such disciplinary punishment as may be provided for under regulations made under section 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The procedure for disciplinary proceedings shall be in accordance with regulations made under section 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Disciplinary Board may, subject to subsection (7), delegate any of its disciplinary functions and powers to any committee of officers or servants of the Corporation to be known as the Disciplinary Committee, in respect of any particular officer or servant of the Corporation, or in respect of any class or category of officers or servants of the Corporation, and the committee delegated with such functions and powers shall carry out, exercise or discharge them under the direction and control of the Disciplinary Board which shall have the power to review, rescind or vary any decision or finding of such committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "No delegation shall be made under subsection (6) so as to enable an officer or servant of the Corporation to be a member of any Disciplinary Committee which may exercise any disciplinary authority over an officer or servant who is superior to him in rank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer or servant of the Corporation who is dissatisfied with the decision of the Disciplinary Board or of any Disciplinary Committee delegated with functions and powers under subsection (6) may, within fourteen days appeal in writing against such decision to the Corporation which may thereupon affirm, reverse or give such directions on the matter as it deems fit and proper."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "When the Corporation considers any appeal under subsection (8), no member of the Disciplinary Board or of the Disciplinary Committee, as the case may be, against whose decision the appeal is made, shall be present in any proceedings relating to that appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 shall apply"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to any action, suit, prosecution or proceedings against the 1948. Corporation or against any member, officer, servant or agent of the Corporation in respect of any act, neglect or default done or committed by him in such capacity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "All members, officers and servants of the Corporation,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "while discharging their functions as such members, officers and servants, shall be deemed to be public servants within the meaning of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 4(3))"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum for a meeting of the Corporation shall be four."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "If for any question to be determined by the Corporation there is an equality of votes, the Chairman shall have a casting vote in addition to his deliberative vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subparagraphs (1) and (2), the Corporation shall regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have a common seal which shall bear such device as the Corporation shall approve and such seal may from time to time be broken, changed, altered or made anew as the Corporation may think fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "The seal of the Corporation shall be authenticated by the Chairman and one other member of the Corporation; and all deeds, documents and other instruments purporting to be sealed with the said seal, authenticated as aforesaid, shall until the contrary is shown be deemed to have been validly executed: Provided that any document or instrument which if executed by a person not being a body corporate would not be required to be under seal may in like manner be executed by the Corporation; and any such document or instrument may be executed on behalf of the Corporation by any officer or servant of the Corporation generally or specially authorised by the Corporation in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Corporation, a stamp bearing the description \"Small and Medium Industries Development Corporation\" may be used and shall be deemed to be the common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Chairman or such other person as may be authorised by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "The seal of the Corporation shall be officially and judicially noticed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of meetings of the Corporation shall, if duly signed, be admissible in evidence in all legal proceedings without further proof and every meeting of the Corporation in respect of the proceedings of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "No act done or proceeding under this Act shall be questioned on"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the grounds of any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "vacancy in the membership of, or of any defect in the constitution of, the Corporation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "omission, defect or irregularity not affecting the merits of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Corporation whether directly or indirectly having"
      },
      "schema:text": {
        "@language": "en",
        "@value": "any interest in any company or undertaking with which the Corporation proposes to make any contract or whether directly or indirectly having any interest in any such contract or in any matter under discussion by the Corporation shall disclose to the Corporation the fact of his interest and the nature thereof, and such disclosure shall be recorded in the minutes of the meetings of the Corporation and the member shall withdraw from any deliberation or decision of the Corporation relating to the contract."
      }
    }
  ]
}
