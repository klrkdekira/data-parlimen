        "@value": "PENTADBIRAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_34"
      ],
