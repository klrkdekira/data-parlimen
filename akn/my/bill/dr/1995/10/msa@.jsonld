        "@language": "ms",
        "@value": "FUNGSI DAN KUASA PERBADANAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalak dan menyelaras pembangunan industri kecil dan sederhana di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan kajian-kajian yang berkaitan dengan pembangunan sektor industri kecil dan sederhana;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan aktiviti promosi di dalam negeri bagi menggalakkan pertumbuhan industri kecil dan sederhana di dalam negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menubuhkan pengkalan data yang komprehensif dan sistemmaklumatbagi program- program pembangunan industri kecil dan sederhana;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjadi pusat pengumpulan, rujukan dan penyebaran maklumat berhubung dengan industri kecil dan sederhana;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyediakan sokongan teknikal dan khidmat nasihat pengurusan dengan kerjasama agensi- agensi lain yang terlibat dalam pembangunan industri kecil dan sederhana;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan kerjasama di kalangan industri kecil dan sederhana melalui pencantuman perniagaan, kerjasama teknikal, penubuhan tabung bersama atau perusahaan kerjasama dan pembelian peralatan gunasama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan perhubungan industri dengan industri besar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan pembangunan sumber manusia di sektor industri kecil dan sederhana; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa jua perkara lain yang bersampingan dengan atau berbangkit daripada pelaksanaan fungsinya dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mempunyai kuasa untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan segala perkara yang semunasabahnya perlu, atau yang suaimanfaat bagi, atau yang bersampingan untuk pelaksanaan fungsinya di bawah Akta ini, dan khususnya, tetapi tanpa menjejaskan keluasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan dan menyelenggara pejabat cawangan dengan kelulusan Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik agen atau mendapatkan khidmat luar untuk menjalankan fungsi Perbadanan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewujudkan pengkalan data dan sistem maklumat yang komprehensif berkaitan dengan program pembangunan industri kecil dan sederhana; DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil dan memegang modal dalam mana-mana syarikat dengan kelulusan Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengelolakan aktiviti promosi industri kecil dan sederhana seperti penyertaan dalam pameran perdagangan, seminar dan persidangan dalam dan luar negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerbit atau menaja penerbitan berkala, risalah dan pengeluaran bahan maklumat di dalam apa-apa media; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan bayaran bagi penggunaan mana-mana kemudahan atau perkhidmatan yang disediakan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Perbadanan boleh, dari semasa ke semasa meminjam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa bentuk, atas apa-apa kadar bunga dan bagi apa-apa tempoh dan atas apa-apa terma tentang masa dan cara pembayaran balik dan selainnya sebagaimana yang diluluskan oleh Menteri, dengan persetujuan Menteri Kewangan, apa-apa jumlah wang yang diperlukan oleh Perbadanan bagi menjelaskan mana-mana obligasinya atau bagi melaksanakan mana-mana fungsinya atau bagi menjalankan mana-mana kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Perbadanan boleh mengguna-khidmat dan membayar"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ejen dan penasihat teknik, dan mana-mana orang lain yang disifatkan perlu untuk menjalankan apa-apa urusan atau melakukan apa-apa perbuatan yang dikehendaki dijalankan atau dilakukan pada melaksanakan fungsi-fungsinya atau menjalankan kuasanya bagi melaksanakan maksud Akta ini dengan lebih baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, tertakluk kepada apa-apa terma dan syarat, had atau sekatan, sebagaimana yang disifatkan sesuai dikenakan, mewakilkan kepada Pengerusi, atau kepada Ketua Pegawai Eksekutif, atau kepada mana-mana anggota Perbadanan, kuasa dan kewibawaan untuk menjalankan atau melaksanakan bagi pihaknya kuasa atau fungsinya di bawah Akta ini sebagaimana yang ditentukan olehnya, kecuali kuasa untuk membuat peraturan-peraturan di bawah seksyen 32; dan apa-apa kuasa atau fungsi sedemikian yang dijalankan atau dilaksanakan oleh Pengerusi, atau Ketua Pegawai Eksekutif, atau anggota lain Perbadanan itu, mengikut mana-mana yang berkenaan, hendaklah disifatkan sebagai telah dijalankan oleh dan bagi pihak Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menyentuh keluasan subseksyen (1) dan peruntukan lain Akta ini, Perbadanan boleh mewakilkan sama ada kepada Pengerusi atau kepada Ketua Pegawai Eksekutif kuasa untuk membenarkan perbelanjaan daripada Kumpulan Wang atau mana-mana wang lain yang diletakhakkan pada atau yang di bawah kawalan Perbadanan sehingga had yang hendaklah dinyatakan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh melantik jawatankuasa bagi apa-apa maksud yang berbangkit daripada atau berkaitan dengan apa-apa fungsi dan kuasanya; mana-mana jawatankuasa yang dilantik hendaklah mengandungi sekurang-kurangnya seorang anggota Perbadanan dan bolehlah dilantik ke jawatankuasa itu, mana-mana orang lain yang difikirkan sesuai oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa yang dilantik hendaklah mengawalselia prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana jawatankuasa yang dilantik itu hendaklah mematuhi apa-apa arahan yang diberikan kepadanya oleh Perbadanan dari semasa ke semasa dan Perbadanan boleh pada bila-bila masa memberhentikan atau mengubah keanggotaan mana-mana jawatankuasa yang dilantik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menjemput mana-mana orang yang, pada pendapatnya mempunyai pengetahuan khusus untuk kebaikannya, untuk menghadiri mana-mana mesyuarat jawatankuasa dan orang yang dijemput itu tidak berhak mengundi dalam mana-mana mesyuarat berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah melaporkan syornya kepada Perbadanan. PERBADANAN PEMBANGUNAN INDUSTRI KECIL 11 DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang terhenti daripada menjadi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Perbadanan oleh sebab peruntukan Akta ini, Menteri boleh melantik orang lain untuk mengisi kekosongan itu bagi baki tempoh anggota itu dilantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dibayar kepada anggota-anggota dan anggota silih ganti Perbadanan apa-apa elaun sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka adalah dengan ini ditubuhkan suatu pertubuhan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang dikenali sebagai \"Perbadanan Pembangunan Industri Kecil dan Sederhana\" yang kekal turun-temurun dan mempunyai suatu meterai biasa, yang boleh mendakwa dan didakwa atas nama perbadanannya dan, tertakluk kepada dan bagi maksud Akta ini, boleh membuat kontrak dan boleh memperolehi, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih dan harta tak alih dan boleh memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai-janji, mendemis, menyerahhakkan semula, memindahmilikkan atau dengan apa-apa cara lain meJupuskan, atau membuat apa-apa urusan mengenai, apa-apa harta alih atau harta tak alih atau apa-apa kepentingan di dalamnya yang terletakhak pada Perbadanan, mengikut apa-apa terma dan syarat sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah terdiri daripada anggota berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Timbalan Pengerusi yang hendaklah seorang wakil Kementerian Perdagangan Antarabangsa dan Industri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Kementerian Kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Unit Perancang Ekonomi, Jabatan Perdana Menteri; DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif Perbadanan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota lain, yang tidak melebihi enam orang, sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Perbadanan hendaklah dilantik oleh Menteri dan tertakluk kepada seksyen 5 dan 6, hendaklah, melainkan jika mereka meletakkan jawatan terlebih dahulu atau perlantikan mereka dibatalkan terlebih dahulu, memegang jawatan tertakluk kepada apa-apa terma dan syarat sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual hendaklah terpakai kepada Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 6, anggota Perbadanan selain"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "daripada Ketua Pegawai Eksekutif hendaklah memegang jawatan selama tempoh yang tidak melebihi tiga tahun sebagaimana yang ditentukan oleh Menteri pada masa perlantikan mereka dan adalah layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan perlantikan mana-mana anggota Perbadanan tanpa memberi apa-apa sebab."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perbadanan boleh pada bila-bila masa meletakkan jawatannya dengan memberikan notis bertulis kepada Menteri,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik mana-mana anggota Perbadanan untuk menjalankan fungsi Pengerusi semasa apa-apa tempoh yang Pengerusi oleh kerana apa-apa jua sebab tidak dapat menjalankan fungsi-fungsinya atau semasa apa-apa tempoh kekosongan dalam jawatan Pengerusi; dan anggota sedemikian hendaklah, semasa tempoh yang dia menjalankan fungsi Pengerusi di bawah subseksyen ini, disifatkan sebagai Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu perlantikan dibuat di bawah subseksyen (1) atau jika tiada perlantikan sedemikian dibuat, anggota yang dilantik di bawah perenggan 4(l) (b) hendaklah menjalankan fungsi Pengerusi dan disifatkan sebagai Pengerusi Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, berkenaan dengan setiap anggota Perbadanan yang dilantik di bawah perenggan 4(1)(b), (c) dan (d), melantik seorang menjadi anggota silih ganti untuk menghadiri mesyuarat Perbadanan sebagai ganti anggota itu, sekiranya anggota itu tidak dapat hadir kerana apa-apa jua sebab."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menghadiri mesyuarat Perbadanan, seseorang anggota silih ganti hendaklah bagi semua maksud disifatkan sebagai seorang anggota Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota silih ganti hendaklah, melainkan jika dia meletakkan jawatan terlebih dahulu atau perlantikannya dibatalkan terlebih dahulu, terhenti daripada menjadi anggota silih ganti sekiranya anggota yang baginya dia menjadi anggota silih ganti terhenti daripada menjadi anggota Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perbadanan hilang kelayakan dan perlantikannya sebagai anggota sedemikian hendaklah terbatal sekiranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dibuktikan terhadapnya, atau dia telah disabitkan atas, sesuatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda) selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap atau telah membuat perkiraan dengan pemiutangnya; DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah didapati atau diisytiharkan sebagai tak sempurna akal atau selainnya tak berupaya melaksanakan tugas atau menguruskan hal- ehwalnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pada tiga kali mesyuarat Perbadanan berturut- turut, tanpa kebenaran bertulis Menteri, dia telah tidak hadir juga tidak diwakili oleh anggota silih ganti, jika ada, yang dilantik berkenaan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan subseksyen (1), selain daripada perenggan (d), hendaklah dipakai mutatis-mutandis kepada ahli silih ganti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN KEWANGAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, Perbadanan hendaklah menubuhkan, mentadbirkan dan mengawal suatu kumpulan wang yang dikenali sebagai \"Kumpulan Wang Pembangunan Industri Kecil dan Sederhana\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dibayar ke dalam Kumpulan Wang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "wang pelancaran penubuhan Kumpulan Wang pemberian Kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang diperuntukkan dari semasa ke semasa oleh Kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang dipinjam oleh Perbadanan di bawah seksyen 14;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang diperuntukkan dari semasa ke semasa kepada Perbadanan daripada kumpulan wang pinjaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang didapati oleh Perbadanan bagi perkhidmatan yang disediakan atau pengendalian apa-apa projek, skim atau enterpris;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua derma dan sumbangan yang diterima dari dalam atau luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang didapati atau berbangkit daripada apa-apa harta, pelaburan, gadai-janji, gadaian atau debentur yang diperolehi oleh atau terletakhak pada Perbadanan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang mungkin dengan apa-apa cara menjadi kena dibayar kepada atau terletakhak pada Perbadanan berkenaan dengan apa-apa perkara yang bersampingan dengan fungsi dan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini dan seksyen 20, ungkapan \"kumpulan wang pinjaman\" ertinya apa-apa jumlah wang yang boleh diadakan dari semasa ke semasa bagi Kerajaan sebagai pinjaman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran apa-apa perbelanjaan yang dilakukan dengan sah oleh Perbadanan, saraan bagi pegawai dan pengkhidmat yang dilantik dan diguna-khidmat oleh Perbadanan, termasuklah elaun persaraan, pencen atau ganjaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "bayaran apa-apa caj atas apa-apa amaun yang diperuntukkan kepada Perbadanan daripada kumpulan wang pinjaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa kos atau perbelanjaan lain yang dilakukan dengan sepatutnya oleh Perbadanan pada menjalankan kuasa-kuasanya atau melaksanakan fungsi-fungsinya termasuk fee dan kos bagi perkhidmatan profesional kepada Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik apa-apa wang yang dipinjam di bawah Akta ini dan bunga yang kena dibayar atasnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian pinjaman kepada pegawai dan pengkhidmat Perbadanan bagi maksud yang diluluskan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pada amnya, membayar apa-apa perbelanjaan bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka adalah menjadi tugas Perbadanan untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memelihara Kumpulan Wang dengan menjalankan kuasa dan melaksanakan fungsinya untuk memastikan supaya jumlah hasil Perbadanan, tertakluk kepada apa-apa arahan yang diberikan oleh Menteri di bawah seksyen 34, adalah mencukupi untuk membayar semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya kepada akaun hasilnya, termasuklah susut nilai dan bunga atas modal, dari setahun ke setahun. DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Perbadanan boleh, dengan kelulusan Menteri"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menempatkan Kumpulan Wang sebagai deposit dengan sebuah bank di Malaysia atau melaburkan dalam sekuriti Kerajaan atau apa-apa sekuriti yang diluluskan oleh Menteri dengan persetujuan Menteri Kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Perbadanan hingga sebanyak yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendakJah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum permulaan bulan September setiap tahun, Perbadanan hendaklah mengemukakan kepada Menteri suatu anggaran perbelanjaan (termasuklah perbelanjaan bagi projek pembangunan) bagi tahun berikutnya dalam apa-apa bentuk dan mengandungi apa-apa butir sebagaimana yang diarahkan oleh Menteri; dan sebelum permulaan tahun yang berikutnya Menteri hendaklah memberitahu Perbadanan amaun yang dibenarkan bagi perbelanjaan pada amnya atau amaun yang dibenarkan bagi setiap jenis perbelanjaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh pada bila-bila masa menge- mukakan kepada Menteri suatu anggaran tambahan bagi mana-mana satu tahun dan Menteri boleh membenarkan kesemua atau mana-mana bahagian daripada perbelanjaan tambahan yang termasuk dalam anggaran tambahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Peruntukan Akta Badan Berkanun (Akaun dan Laporan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tahunan) 1980 hendaklah terpakai bagi Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang sedang atau telah bekerja dengan Perbadanan boleh disurcaj sekiranya ternyata kepada Perbadanan bahawa orang tersebut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah gagal mengutip apa-apa wang yang terhutang pada Perbadanan yang pemungutannya adalah atau telah menjadi tanggungjawabnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah atau telah bertanggungjawab atas apa- apa pembayaran wang yang tidak sepatutnya daripada Perbadanan atau atas apa-apa pembayaran wang Perbadanan yang tidak diluluskan dengan sewajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah atau telah bertanggungjawab secara langsung atau tak langsung, atas apa-apa kekurangan pada atau atas pemusnahan, apa-apa wang, setem, sekuriti, storan atau harta lain Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai, atau yang pernah menjadi pegawai perakaunan, gagal atau telah gagal menyimpan akaun atau rekod yang sepatutnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah gagal untuk membuat apa-apa bayaran, atau telah bertanggungjawab atas apa-apa kelambatan dalam pembayaran, wang daripada Kumpulan Wang kepada mana-mana orang yang kepadanya bayaran itu kena dibuat di bawah mana-mana undang-undang atau di bawah mana- mana kontrak, perjanjian atau perkiraan yang dibuat di antara orang itu dengan Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah, sebelum orang itu disurcaj menyampaikan kepadanya, suatu notis bertulis memintanya menunjuk sebab mengapa beliau tidak patut disurcaj."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya satu penjelasan yang memuaskan tidak diterima dalam masa empat belas hari dari tarikh penyampaian notis yang disebutkan dahulu, Perbadanan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "di dalam hal perenggan ( l )( a ), (b) dan (c), mensurcajkan sejumlah wang terhadap orang tersebut yang tidak melebihi amaun yang tidak dikutip, atau bayaran yang tidak sepatutnya dibuat atau kekurangan dalam, atau kerugian kepada harta yang musnah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "di dalam hal perenggan ( 1 )( d) dan ( e ), mensurcajkan apa-apa jumlah wang terhadap orang tersebut sebagaimana yang difikirkan patut oleh Perbadanan. DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah memberitahu orang yang disurcaj berkenaan dengan apa-apa surcaj yang dibuat di bawah subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan subseksyen (3) dan (4), Perbadanan boleh pada bila-bila masa menarik balik apa- apa surcaj jika ternyata bahawa tiada surcaj patut dibuat, dan Ketua Pegawai Eksekutif hendaklah dengan serta- merta memberitahu orang yang disurcaj tentang penarikan balik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Amaun apa-apa surcaj yang dibuat di bawah subseksyen (3) dan tidak ditarik balik di bawah subseksyen (5) hendaklah menjadi hutang yang kena dibayar kepada Perbadanan daripada orang yang terhadapnya surcaj itu dibuat dan boleh didakwa dan didapatkan kembali dalam mana-mana mahkamah atas guaman oleh Perbadanan dan boleh juga jika diarahkan sedemikian oleh Perbadanan didapatkan kembali melalui potongan daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "gaji orang yang disurcajkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_IV__cl_24__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pencen orang yang disurcajkan, dengan ansuran bulanan yang sama banyak tidak melebihi satu perempat daripada jumlah gaji atau pencen bulanan orang itu, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbadanan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pembangunan Industri Kecil dan Sederhana 1995 dan hendaklah mula berkuatkuasa pada suatu tarikh sebagaimana yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"industri kecil dan sederhana\" ertinya suatu syarikat yang terlibat di dalam aktiviti perkilangan dan aktiviti berkaitan yang diisytiharkan, dari semasa ke semasa, oleh Menteri dalam perintah statutori yang disiarkan dalam Warta; \"Kumpulan Wang\" ertinya Kumpulan Wang Pembangunan Industri Kecil dan Sederhana yang ditubuhkan di bawah seksyen 19; \"Menteri\" ertinya Menteri yang bertanggungjawab mengenai perdagangan antarabangsa dan industri; \"Perbadanan\" ertinya Perbadanan Pembangunan Industri Kecil dan Sederhana yang ditubuhkan di bawah seksyen 3; \"aktiviti pengilangan\" hendaklah mempunyai erti yang diberikan kepadanya di bawah Akta Penyelarasan Perindustrian 1975; \"syarikat\" ertinya suatu syarikat yang ditubuhkan di bawah Akta Syarikat 1965 dan termasuk sesuatu perniagaan yang didaftar di bawah Akta Pendaftaran Perniagaan 1956."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
