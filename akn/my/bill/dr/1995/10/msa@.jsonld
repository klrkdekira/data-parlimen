        "@language": "ms",
        "@value": "AM"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Perbadanan, membuat apa-apa peraturan yang suaimanfaat atau perlu bagi melaksanakan maksud dan peruntukan Akta ini dengan teratur dan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan yang berikut, peraturan sedemikian boleh dibuat bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan fee dalam kes tertentu yang ditentukan oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tujuan elaun yang perlu dibayar kepada mana- mana ahli dan ahli ganti Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan tanggungjawab, kelakuan dan kawalan pegawai dan pengkhidmat Perbadanan; PERBADANAN PEMBANGUNAN INDUSTRI KECIL 19 DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "atau berkenaan dengan saraan, elaun dan syarat perkhidmatan pegawai dan pengkhidmat Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bayaran pencen, elaun atau ganjaran kepada pegawai dan pengkhidmat Perbadanan kerana pesaraan mereka atau selainnya pemberhentian mereka dari memegang jawatan sebagai pegawai atau pengkhidmat sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara bagaimana terma-terma dan syarat-syarat pinjaman boleh diberikan kepada pegawai dan pengkhidmat Perbadanan di bawah perenggan 20(f) dan maksud-maksudnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tatatertib pegawai dan pengkhidmat Perbadanan yang boleh meliputi— (i) peruntukan bagi penahanan kerja dengan pengurangan gaji atau saraan lain, atau bagi penggantungan kerja tanpa gaji atau saraan lain, seseorang pegawai atau pengkhidmat Perbadanan semasa menanti prosiding tatatertib selesai; (ii) pengwujudan apa-apa kesalahan tatatertib dan mengadakan peruntukan bagi apa-apa hukuman tatatertib sebagaimana yang difikirkan sesuai oleh Perbadanan, dan hukuman yang diperuntukkan boleh meliputi pembuangan kerja atau penurunan pangkat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_cc",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_dd"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "prosidur bagi prosiding tatatertib yang hendaklah memperuntukkan supaya pegawai atau pengkhidmat Perbadanan yang terhadapnya prosiding tatatertib diambil, peluang untuk membela diri terhadap tuduhan tatatertib terhadapnya itu sebelum satu keputusan dibuat oleh pihakberkuasa tatatertib, kecuali di dalam kes berikut jika:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai atau pengkhidmat Perbadanan dibuang kerja atau diturunkan pangkat kerana kelakuan berkenaan dengan mana satu pertuduhan jenayah telah dibuktikan terhadapnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan berpuas hati bahawa kerana sesuatu sebab yang hendaklah direkodkan secara bertulis, tidaklah semunasabahnya praktik melak- sanakan kehendak subperenggan ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri berpuashati bahawa bagi kepentingan keselamatan Persekutuan atau mana-mana bahagiannya tidaklah suaimanfaat melaksanakan kehendak subperenggan ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii__subpara_dd",
      "@type": "akn:subparagraph",
      "eli:number": "dd",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perintah pengawasan, kediaman terhad, buang negeri atau deportasi telah dibuat ke atas seseorang pegawai atau pengkhidmat Perbadanan atau jika apa-apa bentuk sekatan atau pengawasan dengan bon atau selainnya telah dikenakan ke atas seorang pegawai atau pengkhidmat Perbadanan, di bawah mana-mana undang-undang yang berhubungan dengan keselamatan Persekutuan atau mana-mana bahagiannya, pencegahan jenayah, tahanan pencegahan, kediaman terhad, buang negeri, imigeresen, atau perlindungan bagi wanita dan gadis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan apa-apa jua perkara yang di bawah Akta ini boleh ditetapkan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah memberi Menteri, apa- apa penyata, laporan, akaun dan maklumat berkenaan dengan harta dan aktiviti Perbadanan sebagaimana yang dikehendaki atau diarahkan oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan peruntukan subseksyen (1), Perbadanan hendaklah, dengan seberapa segera yang praktik selepas akhir setiap tahun kewangan, menyebabkan dibuat dan dihantar kepada Menteri suatu laporan yang DAN SEDERHANA memperkatakan aktiviti Perbadanan sepanjang tahun kewangan yang sebelumnya dan laporan itu hendaklah dalam bentuk serta hendaklah mengandungi apa-apa maklumat yang berhubungan dengan prosiding dan dasar Perbadanan sebagaimana yang dinyatakan dari semasa ke semasa oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh memberikan kepada Perbadanan apa-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "apa arahan yang bersifat am, yang tidak tak konsisten dengan peruntukan Akta ini mengenai pelaksanaan fungsi dan penjalanan kuasa Perbadanan dan Perbadanan hendaklah melaksanakan arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__chp_45",
      "@type": "akn:chapter",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh melantik seorang Ketua Pegawai"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Eksekutif di atas terma dan syarat sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah dibayar kepada Ketua Pegawai"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Eksekutif saraan sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif adalah bertanggungjawab"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepada Perbadanan untuk memastikan pentadbiran dan pengurusan fungsi-fungsi dan hal-ehwal Perbadanan yang teratur bersesuaian dengan dasar Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2) dan apa-apa peraturan yang dibuat di bawah perenggan 33(2)(c), (d) dan (e), Perbadanan boleh dari semasa ke semasa, melantik sekian bilangan pegawai dan pengkhidmat sebagaimana yang difikirkannya wajar dan perlu dan atas apa-apa terma dan syarat yang difikirkan sesuai, bagi menjalankan maksud- maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan subseksyen (1), Perbadanan tidak boleh menubuhkan atau mengubahsuai apa-apa jawatan atau skim perkhidmatan untuk pegawai dan pengkhidmat Perbadanan, termasuk terma dan syarat- syarat perkhidmatan dan gaji, apa-apa skim pencen, dan apa-apa skim yang berhubungan dengan elaun dan saraan lain, tanpa kelulusan Kementerian Kewangan dan Jabatan Perkhidmatan Awam terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menubuhkan Lembaga Tatatertib Perbadanan yang hendaklah dianggotai oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Perbadanan atas rayuan tersebut adalah muktamad dan konklusif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang ahli yang dilantik oleh dan daripada anggota Perbadanan dan seorang daripadanya hendaklah dilantik sebagai Pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga Tatatertib Perbadanan yang ditubuhkan di bawah subseksyen (1) hendaklah menjadi pihak berkuasa tatatertib berkenaan dengan tiap-tiap pegawai dan pengkhidmat Perbadanan selain daripada Ketua Pegawai Eksekutif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif tidak boleh menjadi anggota Jawatankuasa Tatatertib di dalam sebarang perbicaraan yang mana beliau adalah merupakan pengadu; tempat beliau hendaklah diambil oleh ahli yang akan dilantik dari kalangan anggota Perbadanan. PERBADANAN PEMBANGUNAN INDUSTRI KECIL 17 DAN SEDERHANA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam melaksanakan fungsi dan kuasa tatatertib, Lembaga Tatatertib mempunyai kuasa untuk mengenakan hukuman y ang diperuntukkan di bawah mana-mana peraturan yang boleh dibuat di bawah seksyen 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Tatacara untuk prosiding tatatertib hendaklah mengikut peraturan yang dibuat di bawah seksyen 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga Tatatertib boleh, tertakluk kepada subseksyen (7), mewakilkan mana-mana fungsi tatatertib dan kuasa kepada mana-mana jawatankuasa pegawai atau pengkhidmat Perbadanan, dikenali sebagai Jawatankuasa Tatatertib, yang berkaitan dengan mana-mana pegawai atau pengkhidmat Perbadanan yang berkenaan, atau yang berkaitan dengan mana-mana kelas atau kategori pegawai atau pengkhidmat Perbadanan, dan jawatankuasa yang diperwakilkan dengan fungsi dan, kuasa hendaklah menjalankan melaksanakan atau dibuat di bawah arahan dan kawalan Lembaga Tatatertib yang hendaklah mempunyai kuasa untuk menyemak semula, membatalkan atau mengubah mana-mana keputusan atau rumusan jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Penurunan kuasa tidak boleh dibuat di bawah subseksyen (6) untuk membolehkan seorang pegawai atau pengkhidmat Perbadanan untuk menjadi ahli mana-mana Jawatankuasa Tatatertib yang boleh menjalankan mana- mana tindakan tatatertib ke atas seorang pegawai atau pengkhidmat yang lebih kanan dari segi jawatannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai atau pengkhidmat Per- badanan yang tidak puashati dengan keputusan Lembaga Tatatertib atau mana-mana Jawatankuasa Tatatertib yang diwakilkan dengan fungsi dan kuasa di bawah subseksyen (6) boleh, dalam tempoh empat belas (14) hari merayu secara bertulis terhadap keputusan itu kepada Perbadanan yang mana Perbadanan selanjutnya akan mengesahkan, mengakaskan atau memberi apa-apa arahan yang sewajarnya ke atas perkara berkenaan yang difikirkan sesuai dan berpatutan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Perbadanan menimbangkan apa-apa rayuan di bawah subseksyen (8), hendaklah tiada anggota Lembaga Tatatertib atau Jawatankuasa Tatatertib, mengikut mana- mana yang berkenaan, hadir dalam prosiding berhubung dengan rayuan terhadap siapa rayuan itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah terpakai bagi apa-apa tindakan guaman, pendakwaan atau prosiding terhadap Perbadanan atau terhadap mana-mana anggota, pegawai, pengkhidmat atau ejen Perbadanan berkenaan dengan apa-apa perbuatan, keabaian atau keingkaran yang dibuat atau dilakukan olehnya atas sifat yang sedemikian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Semua anggota, pegawai dan pengkhidmat Perbadanan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "semasa melaksanakan fungsi mereka sebagai anggota, pegawai dan pengkhidmat Perbadanan, hendaklah disifatkan sebagai pengkhidmat awam mengikut pengertian Kanun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 4(3))"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi sesuatu mesyuarat Perbadanan adalah empat orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mengenai apa-apa persoalan yang hendak diputuskan oleh Perbadanan terdapat bilangan undi yang sama banyak Pengerusi hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subperenggan (1) dan (2) Perbadanan hendaklah mengawalselia prosidur sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mempunyai suatu meterai biasa yang mengandungi apa-apa tanda yang diluluskan oleh Perbadanan dan meterai itu boleh dari semasa ke semasa dipecahkan, ditukar, diubah atau dibuat baharu sebagaimana yang dif ikirkan patut oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai Perbadanan hendaklah disahkan oleh Pengerusi atau seorang anggota Perbadanan yang lain dan semua suratikatan, dokumen dan suratcara lain yang berupa sebagai telah dimeteraikan dengan meterai itu, disahkan sebagaimana yang disebutkan terdahulu, hendaklah sehingga dibuktikan sebaliknya, disifatkan telah disempurnakan dengan sah: Dengan syarat bahawa apa-apa dokumen atau suratcara yang jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan tidak akan dikehendaki dimeteraikan boleh disempurnakan oleh Perbadanan mengikut cara yang serupa; dan mana-mana dokumen atau suratcara itu boleh disempurnakan bagi pihak Perbadanan oleh mana-mana pegawai atau pengkhidmat Perbadanan yang diberikuasa secara am atau khas oleh Perbadanan bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu meterai diadakan oleh Perbadanan, suatu cop yang mengandungi perkataan \"Perbadanan Pembangunan Industri Kecil dan Sederhana\" boleh digunakan dan hendaklah disifatkan sebagai meterai biasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa itu hendaklah disimpan dalam jagaan Pengerusi atau mana-mana orang yang diberi kuasa oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa Perbadanan hendaklah diberi pengiktirafan rasmi dan kehakiman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menyebabkan minit kesemua mesyuaratnya disenggara dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa minit yang dibuat mengenai mesyuarat Perbadanan, jika ditandatangani sewajarnya. hendaklah diterima sebagai keterangan dalam segala prosiding undang-undang tanpa bukti selanjutnya dan tiap-tiap mesyuarat Perbadanan yang minit berkenaan dengan prosidingnya telah dibuat sedemikian hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota dalam mesyuarat itu layak dengan sewajarnya untuk bertindak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada apa-apa perbuatan yang dilakukan atau prosiding yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "diambil di bawah Akta ini boleh dipersoalkan atas alasan bahawa apa- apa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "kekosongan dalam keanggotaan, atau ada apa-apa kecacatan dalam penubuhan Perbadanan, atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "peninggalan, kecacatan atau ketakteraturan yang tidak menyentuh merit kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/10/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota Perbadanan yang, sama ada secara langsung"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau tak langsung mempunyai, apa-apa kepentingan dalam mana- mana syarikat atau pengusahaan, yang dengannya Perbadanan bercadang hendak membuat apa-apa kontrak atau yang mempunyai sama ada secara langsung atau secara tak langsung apa-apa kepentingan dalam apa-apa kontrak seperti itu atau dalam apa-apa perkara yang sedang dibincangkan oleh Perbadanan hendaklah menzahirkan hakikat dan jenis kepentingan itu kepada Perbadanan dan penzahiran itu hendaklah direkodkan dalam minit mesyuarat Perbadanan dan anggota itu hendaklah keluar daripada mana-mana perbincangan atau keputusan Perbadanan yang berhubungan dengan kontrak atau perkara itu."
      }
    }
  ]
}
