      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 18 of the principal Act is amended by substituting of section for the word \"three\" in paragraph (l)(c) the word \"six\". 18 . Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 19(11) of the principal Act is amended by of section substituting for the word \"directors\" the word \"directions\". 19 . New section"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 24 A . 24 the following section: \"Service of 24A. (1) Any notice required or authorised under notice. this Act to be served on a person may be served— (a) by delivering it personally to the person to be served; (b) by sending it by registered post addressed to the person to be served at the usual or last known place or residence of the person; or (c) by affixing it on some conspicuous part of the controlled premises to which it relates if the person to be served cannot be served personally or by registered post. (2) In this section \"notice\" includes a certificate or other document.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The repeal of the principal Act under section 1A or 1B"
      },
      "schema:text": {
        "@language": "en",
        "@value": "shall not affect any application for the recovery of possession of any controlled premises made under section 16, 18 or 19 before the repeal, and section 16, 18 or 19 shall apply to such application as if the principal Act had not been repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Control of Rent (Amendment) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Control of Rent Act 1966, which in this Act is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "referred to as the \"principal Act\", is amended by inserting after subsection 1(2) the following subsection: \"(3) Notwithstanding subsection (2) the State Authority may, by notification in the Gazette, exempt any area within any local authority area from all or any of the provisions of this Act.\" BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "1 the following sections: 1A. (1) This Act, unless sooner repealed in accordance with section 1B, shall cease to be in operation at the expiration of five years after the coming into force of this section. (2) For the purpose of any written law, when this Act ceases to be in operation by virtue of subsection (1) or section 1B, it shall thereupon be deemed to have been repealed. 1B. This Act shall cease to be in operation in any State or in such part or parts of the State on such date as the Minister may, after consultation with the State Authority, appoint in relation to the State by a notification in the Gazette, and the Minister may, after consultation with the State Authority, appoint different dates for the cessation of this Act in any State or in such part or parts operate in any State unless approved by resolution of the Legislative Assembly of the State.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_4",
      "@type": "akn:clause",
