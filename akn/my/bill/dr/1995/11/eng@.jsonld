      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(3A) There shall be included amongst the persons appointed in subsection (3) valuation officers in the public service or in the employment of any local authority.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_7__para_c",
