      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4) by substituting for the word \"one- sixtieth\" in paragraph (b) the word \"one-twentieth\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "8 the following section: 8A. (1) The landlord of any controlled premises may vary the fair rent of the premises if, on the date of the coming into force of this section, the fair rent per mensem of the premises is less than one-twelfth of the annual value thereof. (2) The provisions of section 7 relating to the procedure of determining the fair rent of premises shall apply mutatis mutandis to the varying of fair rent under this section.\"."
      }
    },
    {
