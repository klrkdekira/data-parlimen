        "@value": "Rang Undang-Undang Lembaga Pelabuhan (Pindaan) 1995"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Pelabuhan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Lembaga Pelabuhan 1963, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 16A—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan dalam subseksyen (1) dan (3) perkataan \"1989\" dengan perkataan \"1990\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Where a reply is received from the authority as regards the memorandum submitted under subsection (1) indicating the decision of the authority to disallow the change in the existing structure of charges as contained in the memorandum, any person or body of persons who is aggrieved by the decision of the authority may, within fourteen days from the date of such decision, appeal to the Minister whose decision shall be final.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 47 Akta ibu adalah dipinda dengan memasukkan seksyen 47. selepas subsekyen (1) subseksyen yang berikut: \"(1A) The powers referred to in subsection (1) shall include the power to amend the name of any port under the First Schedule.\"."
      }
    }
  ]
