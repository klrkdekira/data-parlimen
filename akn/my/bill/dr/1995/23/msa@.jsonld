        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AMALAN PERANCANGAN BANDAR OLEH PERTUBUHAN PERBADANAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh mengeluarkan permit kepada sesuatu"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pertubuhan perbadanan untuk ia menjalankan amalan sebagai Perancang Bandar jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "lembaga pengarah pertubuhan perbadanan itu terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "keseluruhannya orang perseorangan yang adalah Perancang Bandar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sebilangan besarnya orang perseorangan yang adalah Perancang Bandar berdaftar, dan orang perseorangan lain yang adalah Jurutera Profesional, Juruukur Bahan, Juruukur Tanah atau Arkitek yang berdaftar di bawah mana-mana undang- undang bertulis berhubungan dengan pendaftaran profesion-profesion itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sebilangan besarnya orang perseorangan yang adalah Perancang Bandar berdaftar, dan orang perseorangan lain yang berada dalam profesion yang ada hubungan dengan amalan perancangan bandar yang diluluskan oleh Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "semua saham pertubuhan perbadanan itu dipegang oleh sama ada orang yang disebut dalam subperenggan (a)(i), (a)(ii) atau (a)(iii) dan bahawa Perancang Bandar berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mempunyai kepentingan kawalan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang apa-apa peratusan saham mengundi dalam pertubuhan perbadanan itu yang ditetapkan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Suatu pertubuhan perbadanan yang menjalankan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "amalan sebagai Perancang Bandar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menggunakan gelaran \"Perancang Bandar berdaftar\" atau apa-apa gelaran dalam apa-apa bahasa yang boleh semunasabahnya ditafsirkan sebagai membayangkan bahawa ia ialah suatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menggunakan atau mempamerkan apa- apa papan tanda, papan, kad atau alat lain yang menggambarkan atau membayangkan yang ia ialah suatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "berhak mendapatkan dalam mana-mana mahkamah apa-apa fee, caj atau saraan bagi nasihat profesional atau khidmat profesional yang diberikan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu permohonan permit oleh sesuatu pertubuhan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perbadanan untuk menjalankan amalan sebagai Perancang Bandar hendaklah dibuat kepada Lembaga dalam borang dan mengikut cara yang ditetapkan dan disertai fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mengeluarkan kepada suatu pertubuhan perbadanan jika permohonannya untuk menjalankan amalan sebagai Perancang Bandar diluluskan oleh Lembaga suatu permit dalam borang yang ditetapkan setelah menerima fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar yang telah kehilangan permitnya hendaklah dikeluarkan kepadanya suatu pendua bagi permit itu apabila permohonan dibuat dan fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu permit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah habis tempoh pada 31 Disember tahun ia dikeluarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dibaharui secara tahunan setelah fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu pertubuhan perbadanan yang menjalankan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "amalan sebagai Perancang Bandar hendaklah memberitahu Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai apa-apa perubahan dalam komposisi lembaga pengarahnya atau pemegang sahamnya dalam suatu laporan yang mengandungi butir- butir penuh mengenai perubahan itu, dalam masa tiga puluh hari dari perubahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai apa-apa pertukaran perniagaannya, dalam masa empat belas hari dari pertukaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan permit yang dikeluarkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepada suatu pertubuhan perbadanan jika Lembaga mendapati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "pertubuhan perbadanan itu atau mana-mana pengarahnya atau pemegang sahamnya telah melanggar atau tidak mematuhi atau tidak menjalankan mana-mana terma, syarat atau sekatan yang dikenakan oleh Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "komposisi lembaga pengarah pertubuhan perbadanan itu tidak lagi menepati perenggan 20(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegangan saham pertubuhan perbadanan itu tidak lagi menepati perenggan 20(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "pertubuhan perbadanan itu telah melanggar kehendak seksyen 24;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pengarah atau pemegang saham pertubuhan perbadanan itu, sama ada dia seorang Perancang Bandar berdaftar atau bukan— (i) bersalah atas; (ii) telah melakukan; (iii) terbabit dalam; atau (iv) merupakan antara sebab, mana-mana perbuatan atau hal yang dinyatakan dalam subseksyen 34(1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "wujud mana-mana hal keadaan di bawah seksyen 35 berhubungan dengan seorang pengarah atau pemegang saham pertubuhan perbadanan itu, sama ada dia seorang Perancang Bandar berdaftar atau bukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga tidak boleh membatalkan permit yang dikeluarkan kepada sesuatu pertubuhan perbadanan melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pendengaran diadakan mengenai aduan terhadap pertubuhan perbadanan itu atau mana- mana pengarahnya atau pemegang sahamnya yang menyebabkan atau merupakan antara sebab kepada atau terbabit dalam aduan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu peluang untuk didengar— (i) sama ada melalui seorang wakil yang dilantik secara bertulis atau melalui peguam dalam hal suatu pertubuhan perbadanan; atau (ii) sama ada secara sendiri atau melalui peguam dalam hal seorang pengarah atau pemegang saham, telah diberikan kepada pertubuhan perbadanan, pengarah atau pemegang saham itu, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendengaran di bawah subseksyen (1) hendaklah dijalankan oleh sekurang-kurangnya dua pertiga daripada jumlah bilangan anggota Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika aduan itu berasaskan perenggan 25(e) atau (f), maka Lembaga tidak boleh membatalkan permit itu sekiranya, pada tarikh pendengaran, pertubuhan perbadanan itu memuaskan Lembaga bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pengarah atau pemegang saham yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bersalah atas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "terbabit dengan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan antara sebab, perbuatan atau hal yang menjadi alasan aduan itu telah terhenti daripada menjadi pengarah atau pemegang saham pertubuhan perbadanan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun perenggan (a), komposisi lembaga pengarah dan pemegang saham pertubuhan perbadanan itu menepati seksyen 20; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak ada pengarah atau pemegang saham lain, selain daripada dengan sebab dia ialah pengarah atau pemegang saham pertubuhan perbadanan itu pada tarikh material itu, yang dengan apa- apa cara terbabit atau bersangkut-paut dengan perbuatan atau hal yang menjadi alasan aduan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Lembaga membatalkan permitnya, pertubuhan perbadanan itu hendaklah terhenti daripada menjalankan amalan sebagai Perancang Bandar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun pertubuhan perbadanan itu berhak untuk mendapatkan dalam mana-mana mahkamah apa- apa fee, caj atau saraan bagi nasihat profesional atau khidmat profesional yang diberikannya jika nasihat atau khidmat itu diberikan sebelum tarikh penerimaan notis daripada Lembaga tentang pembatalan permitnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu pertubuhan perbadanan yang menjalankan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "amalan sebagai Perancang Bandar hendaklah memulangkan kepada Lembaga permit yang dikeluarkan kepadanya, dalam masa empat belas had dari ia diberitahu melalui pos berdaftar mengenai pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengeluarkan suatu permit baru kepada suatu pertubuhan perbadanan yang permitnya telah dibatalkan, apabila permohonan dibuat oleh pertubuhan perbadanan itu jika Lembaga berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebab yang membawa kepada pembatalan itu tidak lagi wujud; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "komposisi lembaga pengarah dan pemegang saham pertubuhan perbadanan itu, pada masa permohonan itu dibuat, menepati seksyen 20."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada mengeluarkan suatu permit baru, Lembaga boleh mengenakan terma, syarat dan sekatan tambahan yang difikirkan patut olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka tidaklah boleh ada rayuan terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "penolakan Lembaga untuk mengeluarkan permit kepada suatu pertubuhan perbadanan untuk menjalankan amalan sebagai Perancang Bandar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa terma, syarat atau sekatan yang dikenakan oleh Lembaga ke atas suatu permit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "pembatalan permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perancang Bandar"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "1995 dan hendaklah mula berkuatkuasa pada 1 Januari 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"anggota\" ertinya anggota Lembaga yang dilantik di bawah seksyen 4 dan termasuklah Pengerusi Lembaga; \"Daftar\" ertinya Daftar Perancang Bandar yang disebut dalam seksyen 11; \"ditetapkan\" ertinya ditetapkan melalui kaedah-kaedah yang dibuat di bawah seksyen 50; \"jawatankuasa\" ertinya jawatankuasa yang dilantik di bawah seksyen 10; \"Lembaga\" ertinya Lembaga Perancang Bandar yang ditubuhkan di bawah seksyen 3; \"Menteri\" ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi perkara- perkara yang berhubungan dengan perancangan bandar dan desa; \"Pendaftar\" ertinya Pendaftar Perancang Bandar yang dilantik di bawah subseksyen 12(1); \"perakuan pendaftaran\" ertinya perakuan yang dikeluarkan di bawah subseksyen 17(1) dan termasuklah pendua bagi perakuan pendaftaran yang dikeluarkan di bawah subseksyen 17(2); \"perakuan pendaftaran sementara\" ertinya perakuan yang dikeluarkan di bawah subseksyen 18(4) dan termasuklah pendua bagi perakuan pendaftaran sementara yang dikeluarkan di bawah subseksyen 18(5); \"Perancang Bandar berdaftar\" ertinya seseorang yang didaftarkan di bawah subseksyen 15(3); \"Perancang Bandar Siswazah berdaftar\" ertinya seseorang yang didaftarkan di bawah subseksyen 15(1); \"permit\" ertinya permit yang dikeluarkan di bawah subseskyen 23(1) dan termasuklah pendua bagi permit yang dikeluarkan di bawah subseksyen 23(2); \"Persatuan Pegawai Perancang Bandar dan Desa\" ertinya persatuan yang dibentuk oleh Perancang Bandar yang bekerja dalam sektor awam; \"Pertubuhan Perancang Malaysia\" termasuklah institut, badan atau pertubuhan yang menggantikannya dan diluluskan oleh Menteri; \"pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar\" ertinya pertubuhan perbadanan yang diperbadankan di bawah Akta Syarikat 1965 yang telah dikeluarkan kepadanya permit untuk menjalankan amalan sebagai Perancang Bandar; \"pihak berkuasa awam\" mempunyai pengertian yang diberikan kepadanya dalam Perlembagaan Persekutuan; \"profesion\" ertinya profesion perancangan bandar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32",
