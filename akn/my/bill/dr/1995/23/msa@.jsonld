        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar Perancang Bandar hendaklah dalam dua Daftar. seksyen yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen A - yang hendaklah mengandungi nama, alamat perniagaan dan butir-butir lain Perancang Bandar berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen B - yang hendaklah mengandungi nama, alamat dan butir-butir lain Perancang Bandar Siswazah berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah disimpan dan disenggara di pejabat Lembaga dan hendaklah ada akses bagi pemeriksaan awam ke atasnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pindaan atau perubahan boleh dibuat kepada Daftar tanpa mendapat kelulusan Lembaga terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah dibuat oleh Jawatankuasa Tatatertib di bawah seksyen 33;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "berlaku mana-mana hal keadaan yang menjadikan pendaftaran batal dan tak sah di bawah seksyen 35;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu penyingkiran dari Daftar dibuat di bawah seksyen 36;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kemasukan semula ke dalam Daftar dibuat di bawah seksyen 38; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hal keadaan lain yang berlaku; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_11__subsec_4__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa keputusan atau perintah lain yang dibuat, termasuklah berkenaan dengan rayuan yang dibuat di bawah Akta ini, yang menyentuh pendaftaran seseorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar, maka Lembaga hendaklah menyebabkan suatu catatan dibuat dalam Daftar dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Pendaftar Perancang Bandar yang hendaklah berada di bawah arahan dan pengawasan am Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menandatangani kesemua perakuan pendaftaran, perakuan pendaftaran sementara dan permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseskyen 11(3), merekodkan kesemua catatan yang dikehendaki dibuat ke dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan seberapa segera yang praktik selepas 1 Januari setiap tahun, menyiarkan dalam Warta suatu senarai nama dan alamat kesemua Perancang Bandar berdaftar dan Perancang Bandar Siswazah berdaftar; . PERANCANG BANDAR"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dari semasa ke semasa, menyiarkan dalam Warta suatu senarai nama dan alamat Perancang Bandar berdaftar dan Perancang Bandar Siswazah berdaftar— (i) yang ditambahkan kepada; (ii) yang disingkirkan dari; atau (iii) yang dimasukkan semula ke dalam, Daftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan dalam sekurang-kurangnya dua akhbar tempatan, satu dalam bahasa kebangsaan dan satu dalam apa-apa bahasa lain, nama dan alamat Perancang Bandar berdaftar dan Perancang Bandar Siswazah berdaftar— (i) yang disingkirkan dari; dan (ii) dimasukkan semula ke dalam, Daftar, dalam masa tiga puluh hari dari penyingkiran atau kemasukan semula itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa prosiding, senarai yang disiarkan dalam Warta di bawah perenggan (2)(c) dan (d) hendaklah menjadi bukti prima facie bahawa Perancang Bandar berdaftar dan Perancang Bandar Siswazah berdaftar yang namanya terdapat dalam senarai itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah seorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disingkirkan dari Daftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dimasukkan semula ke dalam Daftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh menyiarkan secara tahunan dan menawarkan untuk jualan salinan Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap Perancang Bandar berdaftar berhak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan rancangan pemajuan seperti rancangan struktur dan rancangan tempatan bagi maksud Akta Perancangan Bandar dan Desa 1976;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan kajian perancangan pembangunan bandar, luar bandar dan wilayah, dan kajian kebolehlaksanaan dan penilaian kesan alam sekitar berhubungan dengan kegunaan tanah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan dan mengemukakan permohonan kebenaran merancang, susunatur pecan bahagian, lakaran dan laporan perancangan kepada mana- mana orang atau pihak berkuasa awam bagi maksud membangunkan mana-mana tanah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua yang terkandung dalam seksyen ini boleh menjejaskan hak mana-mana orang lain di bawah mana-mana undang-undang bertulis lain untuk membuat mana-mana perkara di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun melainkan jika dia ialah seorang Perancang Bandar berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menggunakan gelaran \"Perancang Bandar berdaftar\" atau apa-apa gelaran dalam apa-apa bahasa yang boleh semunasabahnya ditafsirkan sebagai membayangkan bahawa dia ialah seorang Perancang Bandar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menggunakan atau mempamerkan apa- apa papan tanda, papan, kad atau alat lain yang menggambarkan atau membayangkan bahawa dia ialah seorang Perancang Bandar berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhak mendapatkan dalam mana-mana mahkamah apa-apa fee, caj atau saraan bagi nasihat profesional atau khidmat profesional yang diberikan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan subseksyen (1), seseorang Perancang Bandar Siswazah berdaftar boleh, dengan kelulusan Lembaga, bekerja sebagai Perancang Bandar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang mempunyai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kelayakan yang dikehendaki bagi Keanggotaan Siswazah Pertubuhan Perancang Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kelayakan lain yang difikirkan oleh Lembaga setara dengannya, berhak, apabila permohonan dibuat olehnya, untuk didaftarkan di bawah Seksyen B Daftar sebagai Perancang Bandar Siswazah berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Perancang Bandar Siswazah berdaftar adalah dikehendaki memperolehi pengalaman amali yang ditetapkan oleh Lembaga, selepas berunding dengan Menteri dan Pertubuhan Perancang Malaysia, supaya menjadi berhak untuk memohon didaftarkan sebagai Perancang Bandar berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang berikut berhak, apabila permohonan dibuat olehnya, untuk didaftarkan di bawah Seksyen A Daftar sebagai Perancang Bandar berdaftar:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang— (i) merupakan seorang Perancang Bandar Siswazah berdaftar; dan (ii) telah memperolehi pengalaman amali yang ditetapkan di bawah subseksyen (2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang, pada 1 Januari 1996, ialah Anggota Korporat Pertubuhan Perancang Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (3), seseorang tidak berhak didaftarkan sebagai Perancang Bandar berdaftar melainkan jika pada masa permohonan pendaftaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia seorang warganegara atau pemastautin tetap Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia sedang bermastautin di Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah bermastautin di Malaysia selama suatu tempoh tidak kurang dari enam bulan sebelum tarikh permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "yang namanya telah disingkirkan dari Daftar di bawah perenggan 36(b); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak memohon untuk dimasukkan semula ke dalam Daftar dalam masa lima tahun dari tarikh penyingkiran itu, berhak, apabila permohonan dibuat olehnya, untuk didaftarkan di bawah Seksyen A Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun berhak untuk didaftarkan sebagai Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar jika pada bila-bila masa sebelum pendaftarannya wujud apa-apa hal keadaan yang boleh menjadikan pendaftarannya batal dan tak sah di bawah seksyen 35."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu permohonan pendaftaran di bawah seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "15 hendaklah dibuat kepada Lembaga dalam borang dan mengikut cara yang ditetapkan dan disertai fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mengeluarkan kepada seseorang pemohon yang permohonan pendaftarannya diluluskan oleh Lembaga suatu perakuan pendaftaran dalam borang yang ditetapkan setelah menerima fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar yang kehilangan perakuan pendaftarannya hendaklah dikeluarkan kepadanya suatu pendua bagi perakuan pendaftaran itu apabila permohonan dibuat olehnya dan fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perakuan pendaftaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah habis tempoh pada 31 Disember tahun ia dikeluarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_17__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dibaharui secara tahunan setelah fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, apabila permohonan dibuat olehnya dalam borang dan mengikut cara yang ditetapkan dan fee yang ditetapkan dibayar, meluluskan pendaftaran sementara sebagai Perancang Bandar berdaftar seseorang Perancang Bandar asing yang merupakan perunding kepada sesuatu projek—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dibiayai sepenuhnya oleh sesuatu kerajaan asing; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dilaksanakan di bawah perkiraan dwipihak antara kerajaan-kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Perancang Bandar asing boleh dipertimbangkan bagi pendaftaran sementara jika dia memuaskan Lembaga bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memiliki kelayakan yang perlu yang diiktiraf bagi amalan perancangan bandar di negara yang dia biasanya menjalankan amalan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memiliki kepakaran yang perlu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kehadirannya secara fizikal dikehendaki di Malaysia selama tempoh tidak kurang daripada satu ratus lapan puluh hari dalam satu tahun kalendar atau dia ialah wakil pemastautin bagi komponen asing sesuatu usahasama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh meluluskan suatu pendaftaran sementara bagi suatu tempoh yang tidak melebihi satu tahun kalendar dan, apabila permohonan dibuat, boleh membaharui pendaftaran sementara itu sebagaimana yang difikirkan patut olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mengeluarkan suatu perakuan pendaftaran sementara dalam borang yang ditetapkan kepada seseorang Perancang Bandar asing yang permohonan pendaftaran sementaranya diluluskan oleh Lembaga setelah menerima fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Perancang Bandar asing yang kehilangan perakuan pendaftaran sementaranya hendaklah dikeluarkan kepadanya suatu pendua bagi perakuan pendaftaran sementara itu apabila permohonan dibuat olehnya dan fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Perancang Bandar asing yang tak berpuas hati dengan keputusan Lembaga yang menolak permohonannya bagi pendaftaran sementara atau pembaharuan pendaftaran sementara boleh, dalam masa dua puluh satu hari dari diberitahu mengenai tarikh penolakan itu, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri atas rayuan di bawah subseksyen (6) adalah muktamad dan tidak boleh dirayui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, \"Perancang Bandar asing\" ertinya seseorang Perancang Bandar yang bukan warganegara atau pemastautin tetap Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap Perancang Bandar berdaftar, Perancang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bandar Siswazah berdaftar dan Perancang Bandar asing hendaklah memberitahu Pendaftar mengenai apa-apa pertukaran alamat perniagaannya atau alamat surat- menyuratnya, mengikut mana-mana yang berkenaan, dalam masa empat belas hari dari pertukaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik jawatankuasa- jawatankuasa yang difikirkan suaimanfaat olehnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihatinya tentang perkara-perkara berkenaan dengan fungsinya, kuasanya dan tugasnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi penunaian yang sepatutnya akan fungsinya, penjalanan yang sepatutnya akan kuasanya dan pelaksanaan yang sepatutnya akan tugasnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa maksud yang berbangkit daripada atau berkaitan dengan fungsinya, kuasanya atau tugasnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan fungsinya, kuasanya atau tugasnya yang ditentukan atau diwakilkan olehnya kecuali yang berhubungan dengan kuasanya di bawah seksyen 50."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dilantik ke sesuatu jawatankuasa sekurang-kurangnya seorang anggota Lembaga dan mana- mana orang lain yang difikirkan layak oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota sesuatu jawatankuasa hendaklah dibayar apa-apa elaun yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, pada bila-bila masa, memberhentikan atau mengubah keanggotaan sesuatu jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan arahan yang diberikan oleh Lembaga, sesuatu jawatankuasa boleh mengawalselia prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa hendaklah mematuhi arahan yang diberikan kepadanya oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengundang mana- mana orang untuk menghadiri mesyuaratnya bagi maksud menasihatinya tentang apa-apa perkara yang sedang dibincangkan, tetapi orang itu tidak berhak untuk mengundi dalam mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subseksyen (7) hendaklah dibayar apa-apa fee yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa hendaklah menyebabkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "minit kesemua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_10__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan minit kesemua mesyuaratnya dikemukakan kepada Lembaga dengan seberapa segera yang praktik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ditubuhkan suatu lembaga yang hendaklah dikenali sebagai \"Lembaga Perancang Bandar\" yang hendaklah menjadi suatu pertubuhan perbadanan yang kekal turun temurun dan mempunyai suatu meterai biasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mendakwa dan didakwa dengan nama perbadanannya,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada dan bagi maksud Akta ini, Lembaga boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengikat kontrak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memperolehi, membeli, mengambil, memegang dan menikmati segala perihal harta alih dan tak alih."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh memindahhakkan, menyerahhakkan, menyerahkan dan memulangkan, menggadai, menggadai- janji, mendemiskan, menyerahhakkan memindahmilikkan atau selainnya melupuskan, atau memperlakukan, harta alih atau tak alih yang terletakhak pada Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengikut apa-apa terma yang difikirkan patut oleh Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada mana-mana undang-undang bertulis yang menyentuh perkara yang sama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada anggota- anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden Pertubuhan Perancang Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden Persatuan Pegawai Perancang Bandar dan Desa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tujuh anggota yang merupakan Perancang Bandar yang dinamakan dalam senarai penamaan yang dikemukakan oleh Pertubuhan Perancang Malaysia dan mereka itu hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga orang Perancang Bandar yang berkhidmat dengan suatu pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga orang Perancang Bandar yang menjalankan amalan persendirian selama sekurang-kurangnya sepuluh tahun di Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Perancang Bandar yang bekerja dengan mana-mana universiti atau institusi pengajian tinggi dan yang bertugas mengajar perancangan bandar dan desa atau perancangan bandar dan wilayah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang anggota yang dinamakan oleh Lembaga Arkitek daripada kalangan anggota Lembaga itu yang ditubuhkan di bawah Akta Arkitek 1967;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang anggota yang dinamakan oleh Lembaga Jurutera daripada kalangan anggota Lembaga itu yang ditubuhkan di bawah Akta Pendaftaran Jurutera 1967; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang anggota yang dinamakan oleh Lembaga Juruukur daripada kalangan anggota Lembaga itu yang ditubuhkan di bawah Akta Juruukur Tanah Berlesen 1958."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi dan anggota lain Lembaga yang dilantik di bawah perenggan (d) hingga (g)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dilantik oleh Menteri bagi suatu tempoh yang tidak melebihi tiga tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika dia meletakkan jawatan terlebih dahulu atau perlantikannya dibatalkan terlebih dahulu, hendaklah memegang jawatan selama tempoh yang ditentukan dalam suratcara perlantikannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah layak dilantik semula apabila habis tempoh jawatannya tetapi tidaklah boleh dilantik bagi lebih daripada tiga penggal berturut-turut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh, pada bila-bila masa, meletakkan jawatannya dengan surat yang ditujukan kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual hendaklah terpakai bagi Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Perlantikan seseorang anggota Lembaga yang dilantik"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah tamat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila dia mati; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meletakkan jawatannya dengan surat yang ditujukan kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh menamatkan perlantikan seseorang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Lembaga yang dilantik—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelakuannya, sama ada yang berkaitan dengan tugasnya sebagai anggota Lembaga atau selainnya, ialah kelakuan yang memburukkan nama Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi tak berupaya untuk menjalankan dengan sepatutnya tugasnya sebagai anggota Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dibuktikan terhadapnya, atau jika dia disabitkan atas, sesuatu pertuduhan berkenaan dengan— (i) sesuatu kesalahan yang melibatkan fraud, ketakjujuran atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesalahan di bawah suatu undang- undang berhubungan dengan rasuah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesalahan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia didapati atau diisytiharkan tak sempurna akal atau selainnya menjadi tak berupaya untuk menguruskan hal-ehwalnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menghadiri mesyuarat Lembaga tiga kali berturut-turut tanpa kebenaran secara bertulis daripada Pengerusi Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pendaftarannya dibatalkan atau menjadi batal dan tak sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika namanya disingkirkan dari Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika seseorang anggota yang dilantik terhenti daripada"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi anggota Lembaga, Menteri boleh melantik orang lain untuk mengisi kekosongan itu selama baki tempoh yang baginya anggota yang mengosongkan jawatan itu telah dilantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Fungsi Lembaga ialah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "menyimpan dan menyenggara Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan atau menolak permohonan pendaftaran di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan skala fee yang akan dicajkan oleh Perancang Bandar berdaftar bagi nasihat profesional dan khidmat profesional yang diberikannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan etika profesion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawalselia tatakelakuan profesion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mendengar dan memutuskan sendiri atau melantik suatu jawatankuasa atau penimbang- tara untuk mendengar dan memutuskan pertikaian berhubungan dengan— (i) tatakelakuan profesional; dan (ii) etika profesional, Perancang Bandar berdaftar dan Perancang Bandar Siswazah berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mewakili profesion dalam apa-apa perkara yang perlu atau suaimanfaat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa, membuat laporan dan syor mengenai perundangan semasa dan apa-apa perkara lain yang menyentuh profesion kepada— (i) kerajaan; (ii) pihak berkuasa awam; atau (iii) institut, badan atau pertubuhan yang pada masa ini mewakili profesion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik suatu panel, jika diperlukan sedemikian, untuk menjalankan peperiksaan bagi penerimaan masuk ke profesion itu, yang terdiri daripada— (i) seorang anggota Lembaga; dan (ii) Perancang Bandar-Perancang Bandar yang ditentukan oleh Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik seseorang untuk mewakilinya dalam sesuatu badan atau panel pemeriksa yang boleh dilantik oleh sesuatu institut, badan atau pertubuhan yang pada masa ini mewakili profesion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat syor kepada pihak berkuasa yang relevan berhubungan dengan apa-apa peperiksaan untuk kelayakan bagi penerimaan masuk ke profesion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik anggota-anggota Lembaga untuk menganggotai sesuatu lembaga, jawatankuasa atau badan yang ditubuhkan bagi apa-apa maksud yang menyentuh profesion; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik anggota-anggota Lembaga untuk menganggotai lembaga badan profesional lain sebagaimana yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh, dengan kelulusan Menteri dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mengikut apa-apa terma dan syarat yang ditentukan olehnya, meminjam apa-apa jumlah wang yang diperlukan oleh Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi melaksanakan fungsinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
