      "schema:text": {
        "@language": "ms",
        "@value": "bagi menunaikan obligasinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
