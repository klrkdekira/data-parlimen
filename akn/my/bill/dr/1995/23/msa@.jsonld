      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada tindakan atau guaman boleh dimulakan atau"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "diteruskan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang anggota Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu jawatankuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang anggota sesuatu jawatankuasa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang diberikuasa untuk bertindak bagi atau bagi pihak Lembaga atau sesuatu jawatankuasa, bagi apa-apa perbuatan atau peninggalan yang dilakukan dengan suci hati pada menjalankan kuasa dan tugasnya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh, dengan kelulusan Menteri, membuat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah-kaedah, yang hendaklah disiarkan dalam Warta, secara am sebagaimana yang perlu atau suaimanfaat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud melaksanakan atau menguat- kuasakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menetapkan apa-apa jua yang dikehendaki oleh Akta ini supaya ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap Perancang Bandar berdaftar, Perancang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bandar Siswazah berdaftar, Perancang Bandar asing dan pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar adalah tertakluk kepada Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua yang terkandung dalam Akta ini"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "terpakai bagi apa-apa yang dilakukan atau ditinggalkan daripada dilakukan oleh atau di bawah kuasa Kerajaan Persekutuan atau Kerajaan mana-mana Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang melakukan kesalahan jika dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memperolehi atau menyebabkan pemerolehan suatu perakuan pendaftaran, pendaftaran sementara atau permit dengan— (i) membuat atau menyebabkan dibuat; atau (ii) menghasilkan atau menyebabkan dihasilkan, suatu akuan, perakuan, permohonan atau representasi palsu atau tipuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu pemalsuan di dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memalsukan, mengubah atau melancung suatu perakuan pendaftaran, perakuan pendaftaran sementara atau permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan suatu perakuan pendaftaran, perakuan pendaftaran sementara atau permit yang dipalsukan, diubah atau dilancung;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyamar sebagai seorang Perancang Bandar berdaftar, Perancang Bandar Siswazah berdaftar, Perancang Bandar asing atau seorang pengarah atau pemegang saham suatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau secara fraud memperolehi— (i) suatu perakuan pendaftaran atau perakuan pendaftaran sementara yang dilceluarkan kepada orang lain; atau (ii) suatu permit yang dilceluarkan kepada suatu pertubuhan perbadanan yang dia bukannya pengarahnya atau pemegang sahamnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_g__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual, menyerahhakkan atau memindah- kan— (i) suatu perakuan pendaftaran atau perakuan pendaftaran sementara yang dikeluarkan kepadanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_g__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_1__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permit yang dilceluarkan kepada suatu pertubuhan perbadanan yang dia ialah pengarahnya atau pemegang sahamnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan kesalahan di bawah seksyen ini boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Icesalahan yang berterusan, didenda tidak melebihi satu ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama Icesalahan itu berterusan selepas sabitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar atau tidak mematuhi mana- mana peruntukan Akta ini adalah melakukan suatu Icesalahan dan jika tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal kesalahan yang berterusan, didenda tidak melebihi lima ratus ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan di bawah Akta ini telah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dilakukan oleh sesuatu pertubuhan perbadanan, maka seseorang yang, pada masa kesalahan itu dilakukan, ialah pengarah, pengurus, setiausaha atau pegawai serupa itu bagi pertubuhan perbadanan itu atau seseorang yang berupa sebagai bertindak atas kapasiti itu hendaklah, di samping pertubuhan perbadanan itu, disifatkan telah melakukan kesalahan itu, melainkan jika dia membuktikan bahawa kesalahan itu telah dilakukan tanpa pengetahuannya atau bahawa dia telah mengambil langkah yang munasabah untuk mencegahnya daripada berlaku."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendakwaan bagi sesuatu kesalahan di bawah Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ini tidak boleh dimulakan atau dijalankan kecuali dengan kebenaran bertulis Pendakwaraya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik seorang peguambela dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "peguamcara untuk memulakan dan menjalankan apa-apa prosiding sivil bagi pihaknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, maka hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ditubuhkan suatu Lembaga Rayuan yang terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Hakim Mahkamah Tinggi atau seorang bekas Hakim Mahkamah Tinggi, sebagai Pengerusi, yang hendaklah dilantik oleh Yang di-Pertuan Agong selepas berunding dengan Ketua Hakim Negara; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang lain yang dilantik oleh Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota Lembaga Rayuan hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika dia meletakkan jawatan terlebih dahulu atau perlantikannya dibatalkan terlebih dahulu, memegang jawatan selama tempoh yang ditentukan dalam suratcara perlantikannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "layak untuk dilantik semula; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "dibayar apa-apa elaun yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga Rayuan hendaklah menurut budi bicaranya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan selainnya dalam Akta ini seseorang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah ditolak pendaftarannya oleh Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah didaftarkan tetapi tak berpuas hati dengan apa-apa terma, syarat atau sekatan yang dikenakan oleh Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tak berpuas hati dengan perintah yang dibuat oleh Jawatankuasa Tatatertib; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "yang namanya telah disingkirkan dari Daftar, boleh merayu kepada Lembaga Rayuan dalam masa tiga puluh hari dari dia diberitahu mengenai perkara yang dirayuinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu notis rayuan hendaklah dibuat kepada Lembaga Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima notis rayuan, Pengerusi Lembaga Rayuan, atau semasa ketiadaannya, anggota yang diwakilkan olehnya untuk berbuat sedemikian, hendaklah menyebabkan Lembaga menyediakan dan menghantar kepada Lembaga Rayuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "rekod atau suatu ringkasan rekod prosiding Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "alasan-alasan keputusan Lembaga, mengenai perkara yang dirayui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima rekod atau ringkasan rekod dan alasan-alasan keputusan Lembaga, Pengerusi Lembaga Rayuan hendaklah mengadakan suatu sidang Lembaga Rayuan untuk mendengar rayuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Peluang untuk didengar sama ada secara sendiri atau melalui peguam hendaklah diberikan oleh Lembaga Rayuan kepada seorang perayu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas mendengar rayuan itu Lembaga Rayuan boleh mengesahkan, mengakaskan atau mengubah keputusan Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Lembaga Rayuan adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah dengan segera memberi kuatkuasa kepada suatu perintah yang dibuat oleh Lembaga Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga hendaklah melantik—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu Jawatankuasa Penyiasatan, yang terdiri daripada tiga anggota Lembaga, untuk menyiasat sesuatu aduan yang dibuat terhadap seseorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu Jawatankuasa Tatatertib, yang terdiri daripada lima anggota Lembaga yang bukan anggota Jawatankuasa Penyiasatan, untuk membuat siasatan mengenai sesuatu aduan yang dirujukkan kepadanya oleh Jawatankuasa Penyiasatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, jika difikirkan patut olehnya, menggantung pendaftaran seseorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar selama suatu tempoh yang tidak melebihi enam bulan sementara menanti selesai apa-apa penyiasatan oleh Jawatankuasa Penyiasatan di bawah perenggan 3 1( a )."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam masa tempoh penggantungan, Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar itu tidak boleh menjalankan apa-apa hak atau keistimewaan yang diberikan kepadanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatankuasa Tatatertib boleh memerintahkan mana-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana satu atau mana-mana kombinasi dua atau lebih yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "pengeluaran suatu celaan bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "pengenaan denda yang tidak melebihi lima ribu ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "penggantungan bagi tempoh yang tidak melebihi satu tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "pembatalan pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah di bawah seksyen 33 boleh dibuat terhadap seseorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar di bawah mana- mana hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menawarkan atau menerima suatu komisen yang pada pendapat Jawatankuasa Tatatertib ialah komisen haram;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika semasa bertindak dalam kapasiti profesionalnya, dia pada masa yang sama dan tanpa memberitahu fakta itu kepada kliennya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah seorang pengarah, atau pemegang saham substansial dalam, atau ejen bagi suatu syarikat, firma atau perniagaan pejanji; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai suatu kepentingan kewangan dalam syarikat, firma atau perniagaan yang dengannya dia berurusan bagi pihak kliennya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pendaftarannya telah diperolehi melalui fraud atau salah nyataan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia didapati bersalah oleh Jawatankuasa Tatatertib atas suatu perbuatan atau kelakuan yang pada pendapat Jawatankuasa Tatatertib adalah mengaibkan atau keji;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia didapati oleh Jawatankuasa Tatatertib telah melanggar atau tidak mematuhi mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menjalankan atau menurut mana- mana terma, syarat atau sekatan yang dikenakan oleh Lembaga ke atas pendaftarannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g__subpara_i__subpara_iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "memperolehi; (ii) menyebabkan pemerolehan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g__subpara_i__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_g__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa cara terbabit dengan perolehan, suatu permit bagi pertubuhan perbadanan yang dia ialah pengarahnya atau pemegang sahamnya, secara fraud atau salahnyataan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia, sebagai pengarah atau pemegang saham suatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyembunyikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan penyembunyian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan apa-apa cara terbabit dengan penyembunyian, kewujudan apa-apa fakta atau hal keadaan dari Lembaga yang, jika diketahui, akan memberikan hak kepada Lembaga untuk membatalkan permitnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia, atas kapasitinya sebagai pengarah atau pemegang saham suatu pertubuhan perbadanan yang menjalankan amalan sebagai Perancang Bandar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "melanggar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan pelanggaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan apa-apa cara terbabit dengan pelanggaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menjalankan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_i__subpara_iii__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menurut, terma, syarat atau sekatan atas permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menyebabkan atau membenarkan atau membiarkan suatu pertubuhan perbadanan yang dia ialah pengarahnya atau pemegang saham—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan amalan sebagai Perancang Bandar sebelum permit dikeluarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_1__para_j",
      "schema:text": {
        "@language": "ms",
        "@value": "terus menjalankan amalan sebagai Perancang Bandar selepas Lembaga membatalkan permitnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu peluang untuk didengar sama ada secara sendiri atau melalui peguam hendaklah diberikan kepada Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar yang terhadapnya Jawatankuasa Tatatertib berniat untuk membuat suatu perintah, sebelum perintah itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran seseorang Perancang Bandar berdaftar"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau Perancang Bandar Siswazah berdaftar adalah batal dan tak sah dalam mana-mana hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dibuktikan terhadapnya, atau jika dia disabitkan atas, sesuatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesalahan yang melibatkan fraud, ketakjujuran atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesalahan di bawah suatu undang- undang berhubungan dengan rasuah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesalahan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelayakannya di bawah seksyen 15 ditarik balik atau dibatalkan oleh pihak berkuasa yang melaluinya kelayakan itu diperolehi atau yang olehnya kelayakan itu diawardkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia didapati atau diisytiharkan tak sempurna akal atau selainnya menjadi tak berupaya untuk melaksanakan tugas profesionalnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah disingkirkan dari Daftar nama dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir lain seorang Perancang Bandar berdaftar atau Perancang Bandar Siswazah berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak membaharui pendaftarannya dalam masa tiga bulan dari habis tempohnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak membayar denda yang dikenakan ke atasnya di bawah perenggan 33(6);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang amalannya telah digantung di bawah perenggan 33(c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang pendaftarannya telah dibatalkan di bawah perenggan 33(d); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "yang pendaftarannya adalah batal dan tak sah di bawah seksyen 35."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang namanya telah disingkirkan dari"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah memulangkan kepada Lembaga perakuan pendaftaran yang dikeluarkan kepadanya, dalam masa empat belas hari dari dia diberitahu melalui pos berdaftar mengenai penyingkiran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang namanya telah disingkirkan dari Daftar menurut kuasa suatu perintah Jawatankuasa Tatatertib hendaklah dengan seberapa segera yang praktik dimasukkan semula ke dalam Daftar jika rayuannya dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang namanya telah disingkirkan dari Daftar kerana tidak membaharui pendaftarannya hendaklah dengan seberapa segera yang praktik dimasukkan semula ke dalam Daftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas dia memberitahu Pendaftar akan hasratnya untuk dimasukkan semula dalam masa lima tahun dari penyingkiran itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~part_V__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "setelah fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_2",
