        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Subseksyen 4(3))"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Lembaga hendaklah menumpukan tnasa"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepada urusan Lembaga sebanyak yang perlu bagi menjalankan tugasnya dengan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah bermesyuarat sekurang-kurangnya dua kali setahun di suatu tempat yang ditentukan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan mesyuarat Lembaga dan semasa ketiadaannya anggota-anggota Lembaga hendaklah melantik seorang daripada mereka untuk mempengerusikan mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi sesuatu mesyuarat Lembaga ialah empat orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mengenai apa-apa soal yang hendak diputuskan oleh Lembaga terdapat bilangan undi yang sama banyak, maka Pengerusi atau, jika Pengerusi tidak ada, anggota yang mempengerusikan mesyuarat itu hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Lembaga hendaklah dibayar apa-apa elaun yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengundang mana-mana orang untuk menghadiri mesyuarat atau perbincangan Lembaga bagi maksud menasihatinya tentang apa-apa perkara yang dibincangkan, tetapi orang itu tidak berhak untuk mengundi dalam mesyuarat atau perbincangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subperenggan (1) hendaklah dibayar apa-apa fee yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "(I) Lembaga hendaklah menyebabkan minit kesemua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit yang dibuat mengenai mesyuarat Lembaga, jika ditandatangani dengan sewajarnya, hendaklah diterima sebagai keterangan dalam segala prosiding undang-undang tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap mesyuarat Lembaga yang minit berkenaan dengan prosidingnya telah dibuat sedemikian hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan kesemua anggota dalam mesyuarat itu layak dengan sewajarnya untuk bertindak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Lembaga yang, secara langsung atau tak langsung, mempunyai sendiri atau melalui pekongsinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kepentingan dalam sesuatu syarikat atau usaha yang dengannya Lembaga bercadang hendak membuat sesuatu kontrak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kepentingan dalam sesuatu kontrak atau perkara yang sedang dibincangkan oleh Lembaga, hendaklah menzahirkan kepada Lembaga hakikat dan jenis kepentingannya itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subperenggan (1) hendaklah direkodkan dalam minit Lembaga dan, melainkan jika dibenarkan secara khusus oleh Pengerusi, anggota itu tidak boleh mengambil bahagian dalam perbincangan atau keputusan Lembaga berhubungan dengan kontrak atau perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada apa-apa tindakan yang dilakukan atau prosiding yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat di bawah Akta ini boleh dipersoalkan atas alasan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "ada suatu kekosongan dalam keanggotaan, atau ada suatu kecacatan dalam penubuhan, Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "ada pelanggaran perenggan 5 oleh seorang anggota Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "ada suatu peninggalan, kecacatan atau ketakteraturan yang tidak menyentuh merit kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai suatu meterai biasa yang mengandungi suatu tanda yang diluluskan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa itu boleh, dari semasa ke semasa, dipecahkan, ditukar, diubah dan dibuat baharu sebagaimana yang difikirkan patut oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa itu hendaklah disimpan dalam jagaan Pengerusi Lembaga dan hendaklah disahkan oleh Pengerusi atau seorang anggota Lembaga yang bertindak semasa ketiadaan Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala suratikatan, dokumen dan suratcara lain yang berupa sebagai dimeteraikan dengan meterai biasa itu dan yang disahkan sebagaimana yang disebutkan dalam subperenggan (3) hendaklah disifatkan sebagai telah disempurnakan dengan sahnya sehingga dibuktikan sebaliknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu suratikatan, dokumen atau suratcara yang jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan, tidak dikehendaki supaya dimeteraikan, boleh disempurnakan oleh Lembaga mengikut cara yang serupa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu suratikatan, dokumen atau suratcara yang disebutkan dalam subperenggan (5) boleh disempurnakan bagi pihak Lembaga oleh seorang anggota Lembaga yang diberikuasa secara am atau khas oleh Lembaga bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa Lembaga hendaklah diberi pengiktirafan rasmi dan kehakiman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang diterima oleh Lembaga sama ada daripada fee yang kena dibayar di bawah Akta ini atau selainnya hendaklah digunakan oleh Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pertamanya untuk membayar perbelanjaan pendaftaran dan perbelanjaan lain bagi mentadbirkan Akta ini termasuklah apa-apa perbelanjaan Lembaga yang dibenarkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kemudian daripada itu untuk menggalakkan dan memajukan profesion perancangan bandar dan desa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang tidak diperlukan serta merta oleh Lembaga boleh dilaburkan dalam mana-mana sekuriti pemegang amanah yang ditentukan oleh Lembaga, dari semasa ke semasa, selepas berunding dengan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/23/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Lembaga hendaklah menentukan prosedurnya sendiri mengikut budibicaranya."
      }
    }
  ]
}
