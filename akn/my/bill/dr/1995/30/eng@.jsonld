      "schema:name": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding twenty-nine billion"
      },
      "schema:text": {
        "@language": "en",
        "@value": "two hundred and seventy-three million and nine hundred and thirty-one thousand ringgit (RM29,273,931,000) from the Consolidated Fund for the service of the year 1996 is hereby authorised, and the said sum is appropriated for the purposes specified in the Schedule."
