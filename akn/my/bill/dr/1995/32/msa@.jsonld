      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10A Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung subseksyen (1) dengan noktah bertindih; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) proviso yang berikut: \"Dengan syarat bahawa tiada bangunan atau bangunan-bangunan yang mempunyai hanya satu tingkat boleh dimasukkan dalam permohonan bagi pengeluaran hakmilik atau hakmilik-hakmilik strata sementara bagi blok atau blok-blok sementara.\"."
      }
    },
    {
