      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Hakmilik Strata (Pindaan) 1995"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Hakmilik Strata"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Kedua kepada Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Kedua. memotong perenggan 18."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Hakmilik Strata 1985, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 4—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"keluasan lantai\" takrif yang berikut: ' \"ketetapan khas\" ertinya suatu ketetapan yang diluluskan dalam suatu mesyuarat agung perbadanan pengurusan yang diadakan dengan sempurnanya yang mengenainya notis sekurang-kurangnya empat belas hari yang menyatakan ketetapan yang dicadangkan itu telah diberikan oleh pemilik yang sesama mereka berhak kepada tidak kurang daripada satu perempat agregat unit-unit syer dan yang sesama mereka membentuk tidak kurang daripada satu perempat keanggotaan;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"ketetapan sebulat suara\" dengan takrif yang berikut: ' \"ketetapan sebulat suara\" ertinya suatu ketetapan yang diluluskan dalam mesyuarat agung perbadanan pengurusan yang diadakan dengan sempurnanya yang mengenainya notis sekurang-kurangnya dua puluh satu hari yang menyatakan ketetapan yang dicadangkan itu telah diberikan dan terhadapnya tiada undi yang menentang dibuat.'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 6(1) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \", tetapi hanya kepada petak- petak yang hendak dipegang sebagai petak-petak aksesori\" dengan perkataan \"kepada petak-petak yang hendak dipegang di bawah hakmilik-hakmilik strata atau kepada petak-petak aksesori\","
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(2) Walau apa pun subseksyen (1), pemilik mana-mana tanah bermilik yang dipegang di bawah hakmilik sementara yang telah diukur dengan sempurnanya dan berkenaan dengannya pelan yang diperakui telah diluluskan oleh Pengarah Ukur, boleh memohon kepada Pengarah untuk memecah bahagi mana-mana bangunan di atasnya. (3) Bagi maksud subseksyen (1) dan (2), permohonan boleh dibuat walaupun bangunan itu belum lagi diperakui oleh pihak berkuasa tempatan sebagai layak diduduki atau digunakan.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu adalah dipinda— seksyen 9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dan\" di hujung perenggan (i);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (j) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (j) perenggan yang berikut: \"(k) bahawa, jika tanah itu dipegang di bawah hakmilik sementara sebagaimana yang dinyatakan dalam subseksyen (2) seksyen 7, hakmilik tetap kepada tanah itu telah didaftarkan; dan (I) bahawa bangunan yang hendak dipecahbahagikan itu telah di- perakui oleh pihak berkuasa tempatan sebagai layak diduduki atau digunakan.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu adalah dipinda— seksyen 10."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"bangunan\" perkataan \"dan apa-apa pindaan kepadanya yang diluluskan\" dalam subperenggan (b)(i); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (ca) perenggan yang berikut: \"(cb) dalam sesuatu hal jika tanah itu dipegang di bawah hakmilik sementara sebagaimana yang RANG UNDANG-UNDANG dinyatakan dalam subseksyen (2) seksyen 7, pelan tanah yang diperakui sebagaimana yang diluluskan oleh Pengarah Ukur, yang hendaklah dikemukakan dalam tiga salinan;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (8) dengan subseksyen yang berikut: \"(8) Apabila menerima sesuatu permohonan di bawah subseksyen (1), Pentadbir Tanah hendaklah mengendorskan, atau menyebab diendorskan, suatu catatan mengenai pembuatannya dalam dokumen hakmilik daftar, dan hendaklah kemudiannya— (a) merujukkan permohonan itu kepada Pengarah Ukur; (b) dalam hal jika tanah yang dipegang di bawah hakmilik sementara sebagaimana yang dinyatakan dalam subseksyen (2) seksyen (7), mengambil tindakan sewajarnya berkenaan dengan penukaran hakmilik sementara kepada hakmilik tetap; dan (c) dalam hal jika bangunan yang hendak dipecahbahagikan itu belum lagi diperakui layak untuk diduduki atau digunakan, dengan serta-merta mem- beritahu pemohon untuk mendapatkan perakuan kelayakan menduduki dari pihak berkuasa tempatan dalam tempoh yang diberikan.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (10) dengan menggantikan noktah di hujung proviso dengan noktah bertindih dan memasukkan selepas itu proviso yang berikut: \"Dan dengan syarat selanjutnya bahawa— (a) jika tanah itu dipegang di bawah hakmilik sementara, hakmilik tetap telah didaftarkan oleh pihak berkuasa pendaftaran; dan (b) jika bangunan itu belum lagi diperakui layak untuk diduduki atau digunakan, perakuan itu telah diperolehi dan dikemukakan oleh pemohon,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/32/msa@/~cl_7__para_a",
