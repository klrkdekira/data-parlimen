      "schema:name": {
        "@language": "en",
        "@value": "The Land (Group Settlement Areas) Act I960 is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "in section 44—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/33/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of subsection ( 1) a colon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/33/eng@/~cl_2__para_b",
