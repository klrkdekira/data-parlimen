      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection ( 1) the following proviso: \" Provided that the consultation shall not be necessary where the land within a group settlement area does not constitute a Federal Development area.\"."
