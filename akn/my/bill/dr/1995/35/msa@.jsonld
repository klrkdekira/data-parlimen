      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh menubuhkan dan menyenggarakan institusi pendidikan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1__para_a",
