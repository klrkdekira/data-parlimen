      "schema:text": {
        "@language": "ms",
        "@value": "PERATUR AN-PERATURAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan kuasanya untuk membuat peraturan-peraturan di bawah mana-mana peruntukan lain dalam Akta ini, Menteri boleh membuat peraturan- peraturan bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
