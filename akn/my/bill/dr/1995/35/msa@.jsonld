      "schema:text": {
        "@language": "ms",
        "@value": "yang menyediakan kursus pendidikan menengah selama lima tahun yang sesuai bagi murid yang baru sahaja tamat mengikuti pendidikan rendah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
