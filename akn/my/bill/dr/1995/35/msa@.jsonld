      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "politeknik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa institusi pendidikan lain, yang penubuhan atau penyenggaraannya tidak diperuntukkan di bawah Akta ini atau Akta Universiti dan Kolej Universiti 1971."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_2",
