      "eli:number": "146",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Pada tarikh yang ditetapkan semua nama institusi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan yang, sebelum sahaja tarikh adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146",
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah rendah kebangsaan hendaklah dikenali sebagai sekolah kebangsaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_146",
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah rendah jenis kebangsaan hendaklah dikenali sebagai sekolah jenis kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_147",
      "@type": "akn:clause",
      "eli:number": "147",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Sekolah menengah vokasional yang ditubuhkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum tarikh yang ditetapkan hendaklah terus menjadi sebahagian daripada sekolah menengah kebangsaan di bawah perenggan 30(1)(b) sehingga sekolah sedemikian dimansuhkan oleh Menteri melalui perintah yang disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_148",
      "@type": "akn:clause",
      "eli:number": "148",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah terus membantu semua institusi pendidikan yang menerima sumbangan bantuan atau bantuan kewangan lain yang serupa daripada Kerajaan atau daripada wang awam pada hari sebelum sahaja tarikh yang ditetapkan,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_149",
      "@type": "akn:clause",
      "eli:number": "149",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang berlawanan,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan Persekutuan boleh terus membuat bayaran berkenaan dengan kos yang disebut dalam seksyen 37 Akta Pelajaran 1961 berhubungan dengan ajaran agama yang diberikan di bawah seksyen itu tidak dimansuhkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150",
      "@type": "akn:clause",
      "eli:number": "150",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Sehingga apa-apa tarikh yang ditetapkan oleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri melalui pemberitahuan dalam Warta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150",
      "schema:text": {
        "@language": "ms",
        "@value": "semua institusi pendidikan yang tertentu, terkecuali daripada peruntukan Akta Pelajaran 1961 melalui seksyen 127 Akta itu hendaklah terkecuali daripada peruntukan yang bersamaan dalam Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_150",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang guru yang terkecuali daripada peruntukan Bahagian VI Akta Pelajaran 1961 melalui seksyen 128 Akta itu hendaklah terkecuali daripada peruntukan Bahagian IX Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151",
      "@type": "akn:clause",
      "eli:number": "151",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu institusi pendidikan, pengelola, pengurus"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau pekerja yang berdaftar atau disifatkan berdaftar di bawah peruntukan Akta Pelajaran 1961 hendaklah, pada tarikh yang ditetapkan, disifatkan telah berdaftar di bawah Akta ini dan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada perenggan (b), peruntukan Akta ini hendaklah terpakai bagi institusi pendidikan, pengelola, pengurus atau pekerja itu seolah-olah institusi pendidikan, pengelola, pengurus atau pekerja itu telah berdaftar di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat-syarat yang dikenakan kepada institusi pendidikan, pengelola, pengurus atau pekerja itu sebelum mula berkuatkuasanya Akta ini hendaklah terus berkuatkuasa seolah-olah syarat- syarat itu telah dikenakan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152",
      "@type": "akn:clause",
      "eli:number": "152",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada tarikh yang ditentukan olehnya, melalui notis yang disiarkan dalam Warta, memerintahkan penggulungan Lembaga Pusat yang ditubuhkan di bawah seksyen 92 Akta Pelajaran 1961."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152",
      "schema:text": {
        "@language": "ms",
        "@value": "Dengan penggulungannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota-anggotanya, termasuk Pengerusi Lembaga, hendaklah terhenti memegang jawatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terhenti menjadi majikan kepada guru-guru di sesuatu institusi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan mengenai mana-mana harta alih atau tak alih dan apa-apa hak dan liabiliti yang sebelum ini terletakhak pada atau mungkin dipunyai oleh Lembaga sebelum sahaja tarikh penggulungan Lembaga hendaklah turun kepada Kerajaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberikan apa-apa arahan yang difikirkannya patut berkenaan dengan mana- mana kakitangan atau pekerja Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153",
      "@type": "akn:clause",
      "eli:number": "153",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana kumpulan wang caruman (termasuk Kumpulan Wang Simpanan Guru) yang ditubuhkan di bawah Akta Pelajaran 1961 atau mana-mana peraturan yang dibuat di bawah Akta itu hendaklah terus disenggarakan dan diuruskan mengikut mana-mana undang-undang bertulis yang berhubungan dengan kumpulan wang itu sehingga Yang di-Pertuan Agong membuat perintah bagi penggulungannya atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Perintah penggulungan di bawah seksyen ini hendaklah hanya dibuat atas nasihat Menteri Kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melalui peraturan meminda mana- mana kaedah atau peraturan berhubungan dengan kumpulan wang itu yang dibuat sebelum tarikh yang ditetapkan untuk mengadakan pentadbiran yang lebih baik bagi kumpulan wang itu atau untuk menghapuskan apa- apa kesulitan yang berhubungan dengan kumpulan wang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_154",
      "@type": "akn:clause",
      "eli:number": "154",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Sebutan dalam Akta ini mengenai seseorang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pengelola hendaklah termasuk sebutan mengenai pengurus yang didaftarkan di bawah Akta Pelajaran 1961 dan sebutan mengenai lembaga pengelola hendaklah termasuk sebutan mengenai lembaga pengurus di bawah Akta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155",
      "@type": "akn:clause",
      "eli:number": "155",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pelajaran 1961, Akta Pelajaran (Pindaan) 1963, Perintah Akta Pelajaran (Perluasan ke Sarawak) 1975 dan Perintah Akta Pelajaran (Perluasan ke Sabah) 1976 adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_155",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perlantikan, peraturan, kaedah, undang- undang kecil, pengecualian, arahan dan perintah yang dibuat, semua daftar yang disimpan dan semua perakuan atau sijil yang diberikan atau mempunyai kuatkuasa di bawah undang-undang atau perintah yang dimansuhkan oleh seksyen ini dan yang berkuatkuasa atau mempunyai kuatkuasa pada tarikh Akta ini mula berkuatkuasa, hendaklah (tanpa menjejaskan kuasa Menteri untuk meminda peraturan, kaedah dan undang-undang kecil sedemikian, melalui mana-mana peraturan-peraturan atau meminda, membatalkan atau menarik balik pengecualian, arahan, perakuan atau sijil itu melalui perintah atau arahan yang dibuat di bawah peruntukan yang berkenaan dalam Akta ini dan tertakluk kepada apa-apa ubahsuaian yang perlu untuk menjadikan peraturan, kaedah, undang-undang kecil, pengecualian, arahan, atau perintah selaras dengan Akta ini) terus berkuatkuasa dan mempunyai kuatkuasa seolah-olah ia telah dibuat, disimpan, atau diberikan di bawah Akta ini, sehingga diperuntukkan selainnya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI__cl_156",
      "@type": "akn:clause",
      "eli:number": "156",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam Akta ini boleh dianggap"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menyentuh penjalanan oleh Menteri Kewangan kuasa yang diberikan kepadanya oleh seksyen 6 Akta Prosedur Kewangan 1957 berkenaan dengan pengurusan Kumpulan Wang Disatukan dan berkenaan dengan pengawasan, pengawalan dan arahan tentang perkara yang berhubungan dengan hal-ehwal kewangan Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45",
      "@type": "akn:chapter",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_142",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_143",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141",
      "@type": "akn:clause",
      "eli:number": "141",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengelola atau orang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan hendaklah memastikan bahawa premis institusi pendidikan itu mematuhi apa-apa piawaian yang ditetapkan bagi institusi pendidikan yang sama perihalnya dengan institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri berpuas hati berkenaan dengan sesuatu institusi pendidikan bahawa setelah mengambil kira keadaan tapak atau mana-mana bangunan yang sedia ada di situ atau hal keadaan tertentu yang lain yang menyentuh premis itu tidaklah munasabah dalam hal yang sedemikian untuk menghendaki pematuhan piawaian yang ditetapkan yang disebut dalam subseksyen (1) daripada apa-apa aspek tertentu, dia boleh mengarahkan supaya premis itu disifatkan sebagai mematuhi piawaian yang ditetapkan jika sebagai ganti pematuhan kepada piawaian yang ditetapkan itu premis itu mematuhi apa-apa kehendak lain yang ditentukan dalam arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_142",
      "@type": "akn:clause",
      "eli:number": "142",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45",
      "schema:name": {
        "@language": "ms",
        "@value": "Kecuali dengan kebenaran Pendaftar, seseorang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "murid yang berdaftar sebagai murid di suatu institusi pendidikan kerajaan atau bantuan kerajaan tidak boleh, semasa masih berdaftar sedemikian, berdaftar di mana- mana institusi pendidikan sedemikian yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_143",
      "@type": "akn:clause",
      "eli:number": "143",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, jika difikirkannya wajar dan demi mengecualikan institusi kepentingan sesuatu institusi pendidikan atau demi kepentingan murid atau awam, melalui perintah yang disiarkan dalam Warta, mengecualikan institusi pendidikan atau mana-mana golongan atau golongan institusi pendidikan daripada semua atau mana-mana peruntukan Akta ini kecuali peruntukan tentang pendaftaran, sama ada secara mutlak atau tertakluk kepada apa-apa syarat yang difikirkannya patut dikenakan, dan boleh pada bila- bila masa menurut budi bicaranya membatalkan pengecualian sedemikian atau mengkensel atau mengubah atau menambah syarat-syarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144",
      "@type": "akn:clause",
      "eli:number": "144",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa peruntukan lain dalam Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ini, Menteri boleh membentuk suatu jawatankuasa khas yang terdiri daripada orang yang dilantik oleh Menteri berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana institusi pendidikan atau golongan institusi pendidikan tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_144",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara atau projek pendidikan, bagi maksud menasihatinya dalam perkara yang berhubungan dengan institusi pendidikan, golongan institusi pendidikan atau perkara atau projek pendidikan dan dia boleh menurut budi bicaranya memberikan jawatankuasa sedemikian semua atau mana-mana kuasa yang diberikan kepada sesuatu Jawatankuasa Siasatan oleh seksyen 127."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145",
      "@type": "akn:clause",
      "eli:number": "145",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana notis, perintah atau komunikasi, yang dikehendaki, atau boleh, dihantar atau disampaikan kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengerusi lembaga pengelola, pengelola atau orang lain yang bertanggungjawab tentang pengurusan, atau pekerja, sesuatu institusi pendidikan yang didaftarkan di bawah Akta ini, bolehlah disampaikan melalui surat yang dialamatkan kepada pengerusi, pengelola, orang atau pekerja itu di alamat berdaftar institusi pendidikan itu atau boleh disampaikan dengan melekatkan notis, perintah atau komunikasi itu di suatu bahagian yang ketara di premis institusi pendidikan itu yang difikirkan sesuai oleh Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang memohon supaya sesuatu institusi pendidikan didaftarkan atau supaya didaftarkan sebagai guru, pengelola atau pekerja bolehlah disampaikan melalui surat yang dialamatkan kepada orang itu di alamat yang dinyatakan dalam borang permohonannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang guru berdaftar, bolehlah disampaikan melalui surat yang dialamatkan ke institusi pendidikan atau alamat terakhir yang dilaporkan kepada Ketua Pendaftar di bawah seksyen 116;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit mengajar yang dikeluarkan di bawah seksyen 114 bolehlah disampaikan melalui surat yang dialamatkan ke institusi pendidikan yang berkenaan dengannya permit itu dikeluarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang selain daripada orang yang dinyatakan dalam perenggan (a) hingga (d), bolehlah disampaikan melalui surat yang dialamatkan kepada orang itu di tempat tinggalnya yang terakhir yang diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__chp_45__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan ( 1 )( a ), jika pengerusi lembaga pengelola sesuatu institusi pendidikan belum dilantik, maka notis, perintah atau komunikasi untuk disampaikan kepada pengerusi itu bolehlah dialamatkan atau disampaikan kepada orang yang, pada pendapat Ketua Pendaftar, bertanggungjawab tentang institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__cl_140",
      "@type": "akn:clause",
      "eli:number": "140",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang dilantik, atau yang secara sah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan kuasa seseorang yang dilantik, di bawah Bahagian II hendaklah disifatkan sebagai pengkhidmat awam bagi maksud Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_118",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_119",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X",
      "schema:name": {
        "@language": "ms",
        "@value": "Jemaah Nazir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Nazir hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "bertanggungjawab, dengan kerjasama mana-mana pihak berkuasa yang dilantik oleh Menteri, bagi memastikan bahawa taraf pengajaran yang memuaskan diwujudkan dan dikekalkan di institusi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa institusi pendidikan menyebabkan institusi pendidikan diperiksa oleh Nazir Sekolah pada lat tempoh yang difikirkannya sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila diarahkan supaya berbuat demikian oleh Menteri, memeriksa sesuatu institusi pendidikan atau menyebabkan institusi pendidikan itu diperiksa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa kewajipan berhubungan dengan pemeriksaan institusi pendidikan sebagaimana yang diarahkan oleh Menteri atau sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Nazir atau Nazir Sekolah boleh memberikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "nasihat kepada pengelola atau mana-mana orang lain yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan dan kepada guru tentang perkara yang berhubungan dengan pengajaran dan kaedah pengajaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Nazir atau Nazir Sekolah tidak boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan apa-apa perintah atau arahan kepada pengelola atau mana-mana orang lain yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan kecuali setakat yang dia diberikuasa oleh mana- mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Nazir hendaklah mengemukakan suatu laporan kepada Menteri tentang tiap-tiap institusi pendidikan yang diperiksanya menurut seksyen 117, dan jika laporan itu dibuat oleh Nazir Sekolah, dia hendaklah mengendorskan apa- apa ulasan yang disifatkannya sesuai pada laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_1__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Laporan tentang institusi pendidikan yang dikemukakan di bawah subseksyen (1) hendaklah menjadi dokumen rahsia tetapi boleh, menurut budi bicara Menteri, dijadikan tersedia didapati oleh mereka yang bertanggungjawab tentang pentadbiran institusi pendidikan itu dan mana-mana guru di institusi pendidikan itu dan mana-mana laporan itu yang dijadikan tersedia sedemikian hendaklah dijadikan tersedia keseluruhannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
