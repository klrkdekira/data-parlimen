      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 18(2)] MATA PELAJARAN TERAS DALAM KURIKULUM KEBANGSAAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Mata pelajaran teras dalam Kurikulum Kebangsaan hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi asas utama pendidikan murid di semua sekolah dalam Sistem Pendidikan Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_c",
