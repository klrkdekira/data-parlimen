      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh mengadakan pendidikan menengah atas di mana- mana sekolah menengah kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_4__cl_31",
