      "schema:text": {
        "@language": "ms",
        "@value": "yang menjadikan bahasa kebangsaan dan bahasa Inggeris sebagai mata pelajaran wajib; \"sekolah kebangsaan\" ertinya sekolah rendah kerajaan atau sekolah rendah bantuan kerajaan—"
      }
    },
