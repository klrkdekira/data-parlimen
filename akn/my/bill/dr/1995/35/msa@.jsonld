    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), pendidikan teknik termasuklah penyediaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "latihan kemahiran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "latihan khusus yang berhubungan dengan pekerjaan tertentu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "latihan bagi meningkatkan kemahiran yang sedia ada; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa latihan teknik atau vokasional lain yang diluluskan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7",
      "schema:name": {
        "@language": "ms",
        "@value": "Politeknik yang ditubuhkan di bawah perenggan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "34(l)(c) boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "menawarkan kursus pengajian dan program latihan yang diluluskan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "menganugerahkan sijil, diploma atau apa-apa kelayakan lain yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada kelulusan Menteri, politeknik yang ditubuhkan di bawah Akta ini boleh, dengan kerjasama mana-mana institusi, perbadanan atau organisasi perindustrian, mengendalikan kursus teknik atau vokasional atau program latihan (termasuklah program pertukaran) yang disifatkan suaimanfaat oleh Menteri bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan pemindahan teknologi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meningkatkan kemahiran teknik dan vokasional guru-guru, pekerja-pekerja dan murid-murid politeknik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan apa-apa program latihan yang dianggap oleh Menteri sesuai dan bermanfaat kepada politeknik atau murid-muridnya atau guru-gurunya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan yang diberikan di bawah subseksyen (1) boleh tertakluk kepada apa-apa terma dan syarat yang dikenakan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Politeknik yang ditubuhkan di bawah Akta ini boleh, dengan kelulusan Menteri, mengendalikan kursus pengajian atau program latihan bagi diploma, sijil atau bentuk-bentuk lain pengiktirafan kelayakan yang diberikan oleh mana-mana universiti atau institusi pendidikan tinggi lain di dalam Malaysia atau di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan yang diberikan di bawah subseksyen (1) boleh dijadikan tertakluk kepada apa-apa terma dan syarat yang difikirkan oleh Menteri patut dikenakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri tidak boleh memberikan kelulusannya di bawah subseksyen (1) melainkan jika dia berpuas hati bahawa politeknik itu telah membuat segala perkiraan yang perlu dengan universiti atau institusi pendidikan tinggi lain yang terlibat dengan pengendalian kursus pengajian atau program latihan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan peruntukan Bab ini dan, tanpa menjejaskan keluasan kuasa itu, peraturan-peraturan sedemikian boleh mengadakan peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan lembaga atau badan untuk melaksanakan pengukuran atau penilaian atau mengendalikan peperiksaan untuk politeknik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan lembaga atau badan untuk menghasilkan, mengawasi dan mengubahsuaikan kurikulum tentang kursus pengajian dan program latihan yang ditawarkan oleh politeknik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penganugerahan sijil atau diploma atau apa-apa kelayakan lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "disiplin murid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan, penyusunan, pengurusan, pengawalan dan pembubaran mana-mana majlis, badan atau jawatankuasa bagi kegiatan luar kurikulum di politeknik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_7__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan oleh Menteri suaimanfaat atau perlu bagi maksud Bab ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8",
      "@type": "akn:chapter",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendidikan Khas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri hendaklah mengadakan pendidikan khas di"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah khas yang ditubuhkan di bawah perenggan 34(1 )(b) atau di mana-mana sekolah rendah atau menengah yang difikirkan oleh Menteri suaimanfaat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2) dan (3), Menteri boleh melalui peraturan-peraturan menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh pendidikan rendah dan menengah yang sesuai dengan keperluan murid yang menerima pendidikan khas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kurikulum yang hendaklah digunakan berhubungan dengan pendidikan khas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kategori murid yang memerlukan pendidikan khas dan kaedah yang sesuai bagi pendidikan murid dalam setiap kategori sekolah khas; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan oleh Menteri suaimanfaat atau perlu bagi maksud Bab ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh yang ditetapkan oleh Menteri di bawah perenggan ( 1 )( a) tidak boleh kurang daripada tempoh minimum pendidikan rendah atau menengah, mengikut mana-mana yang berkenaan, yang diperuntukkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_8__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Kurikulum yang ditetapkan di bawah perenggan ( 1 )( b) hendaklah mematuhi kehendak Kurikulum Kebangsaan setakat yang semunasabahnya praktik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "@type": "akn:chapter",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendidikan Guru"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menubuhkan atau"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menyenggarakan sesuatu maktab pendidikan guru melainkan dengan kelulusan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Semua maktab pendidikan guru, yang penubuhan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau penyenggaraannya telah diluluskan di bawah seksyen 42, hendaklah didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Maktab pendidikan guru yang ditubuhkan di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini boleh menganugerahkan sijil atau apa-apa kelayakan lain yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 42, Menteri boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan dan menyenggarakan maktab pendidikan guru dan mengadakan pendidikan guru di dalamnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap maktab pendidikan guru yang ditubuhkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di bawah Bab ini hendaklah mengendalikan apa-apa kursus pengajian dan program latihan yang diluluskan oleh Menteri,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Maktab pendidikan guru yang ditubuhkan di bawah Bab ini boleh, dengan kelulusan Menteri, mengendalikan kursus pengajian atau program latihan bagi ijazah, diploma, sijil atau bentuk-bentuk lain pengiktirafan kelayakan yang diberikan oleh mana-mana universiti atau institusi pendidikan tinggi lain di dalam Malaysia atau di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan yang diberikan di bawah subseksyen (1) boleh dijadikan tertakluk kepada apa-apa terma dan syarat yang difikirkan oleh Menteri patut dikenakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri tidak boleh memberikan kelulusannya di bawah subseksyen (1) melainkan jika dia berpuas hati bahawa maktab pendidikan guru itu telah membuat perkiraan yang perlu dengan universiti atau institusi pendidikan tinggi lain yang terlibat dengan pengendalian kursus pengajian atau program latihan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) atau tidak mematuhi mana-mana terma atau syarat yang dikenakan oleh Menteri di bawah subseksyen (2) adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi maktab pendidikan guru yang ditubuhkan dan disenggarakan oleh Menteri di bawah seksyen 45, tiap-tiap maktab pendidikan guru yang ditubuhkan di bawah Akta ini hendaklah mempunyai suratcara pengelolaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap suratcara pengelolaan di bawah seksyen ini hendaklah diluluskan oleh, dan hendaklah diserahkan kepada, Ketua Pendaftar pada masa pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap suratcara pengelolaan di bawah seksyen ini hendaklah mengadakan peruntukan bagi penubuhan lembaga pengelola, dengan seorang pengerusi, bagi pengurusan maktab pendidikan guru itu oleh pengelola- pengelola mengikut cara yang tidak tak konsisten dengan Akta ini dan mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap suratcara pengelolaan di bawah seksyen ini hendaklah dibuat, dipinda atau dibatalkan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan peruntukan Bab ini dan, tanpa menjejaskan keluasan kuasa itu, peraturan-peraturan itu boleh mengadakan peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan lembaga atau badan untuk menjalankan pengukuran atau penilaian atau mengendalikan peperiksaan bagi pendidikan guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "kursus pengajian dan program latihan yang hendaklah dijalankan oleh maktab pendidikan guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "penganugerahan sijil atau diploma;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "disiplin murid di maktab pendidikan guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan, penyusunan, pengurusan, pengawalan dan pembubaran majlis, badan atau jawatankuasa bagi kegiatan luar kurikulum di peringkat maktab, daerah, negeri dan kebangsaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "pengiktirafan kelayakan yang dikeluarkan oleh maktab pendidikan guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur bagi permohonan dan pendaftaran maktab pendidikan guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_9__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan oleh Menteri suaimanfaat atau perlu bagi maksud Bab ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENDAFTARAN GURU"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_104",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_105",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_107",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_108",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_112",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_113"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran Guru"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), tiada seorang pun boleh mengajar di sesuatu institusi pendidikan melainkan jika dia didaftarkan sebagai guru di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidaklah terpakai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi seseorang yang menjadi anggota Perkhidmatan Pendidikan yang .mengajar di institusi pendidikan kerajaan atau bantuan kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi seseorang yang kepadanya suatu permit untuk mengajar telah dikeluarkan di bawah seksyen 114; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_103__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi seseorang murid di sesuatu institusi pendidikan bagi latihan guru yang ditubuhkan oleh dan di bawah kawalan langsung Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menyimpan dan menyenggarakan atau menyebabkan supaya disimpan dan disenggarakan dalam bentuk yang ditetapkan suatu daftar guru yang di dalamnya hendaklah dicatatkan apa-apa butir yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Permohonan untuk didaftarkan sebagai guru"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dibuat kepada Ketua Pendaftar dalam borang dan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mendaftarkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang sebagai guru di bawah Akta ini jika dia berpuas hati bahawa orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "berumur kurang daripada lapan belas tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai kelayakan untuk mengajar atau mempunyai kelayakan yang pada pendapat Ketua Pendaftar tidak mencukupi bagi maksud itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "telah membuat pernyataan yang palsu atau mengelirukan atau yang orang itu tahu adalah palsu atau mengelirukan dalam, atau berkaitan dengan permohonannya supaya didaftarkan atau telah dengan sengaja mendiamkan apa-apa fakta yang material bagi permohonan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "menanggung suatu kecacatan jasmani atau mental atau penyakit, yang pada pendapat Ketua Pendaftar, menjadikan orang itu tidak sesuai menjadi guru;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan atas suatu kesalahan oleh mahkamah dan dijatuhi hukuman pemenjaraan selama tempoh yang tidak kurang daripada satu tahun atau denda yang tidak kurang daripada dua ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "bukanlah seorang yang layak dan sesuai didaftarkan sebagai guru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila Ketua Pendaftar enggan mendaftarkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang di bawah seksyen 106 dia hendaklah melalui notis bertulis memberitahu orang itu keengganannya, dengan menyatakan alasan bagi keengganan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan dengan keengganan Ketua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar untuk mendaftarkannya sebagai guru boleh, dalam masa dua puluh satu hari dari tarikh notis disampaikan kepadanya mengikut seksyen 107, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 106 dan 108, Ketua Pendaftar hendaklah, apabila permohonan untuk didaftarkan di bawah Bab ini dibuat dengan sewajarnya dan selepas dibuat apa-apa siasatan yang difikirkannya perlu, dan apabila fee yang ditetapkan dibayar, mendaftarkan pemohon itu dan mengeluarkan perakuan pendaftaran sebagai guru kepadanya mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengenakan apa-apa terma dan syarat yang difikirkannya patut apabila mendaftarkan seseorang pemohon di bawah subseksyen (1) dan dia boleh pada bila- bila masa membatalkan, mengubah atau menambah terma dan syarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pendaftar berpuas hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa adalah suaimanfaat untuk berbuat demikian atas mana-mana alasan yang disebut dalam perenggan 106(c) hingga (e); 60 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa seseorang guru berdaftar telah melakukan kemungkiran atau telah tidak mematuhi mana- mana syarat yang dikenakan di bawah subseksyen 109(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pendaftaran seseorang guru telah diperolehi disebabkan oleh kesilapan atau apa- apa pernyataan yang palsu atau mengelirukan berkaitan dengan permohonan untuk didaftarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa ada alasan yang munasabah untuk mempercayai bahawa pengekalan pendaftaran orang itu sebagai guru akan memudaratkan kepentingan institusi pendidikan atau murid, dia boleh menyampaikan kepada guru itu notis tentang niat untuk membatalkan pendaftaran guru itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang guru yang kepadanya telah disampaikan suatu notis menurut subseksyen (1) boleh, dalam masa dua puluh satu hari dari tarikh notis itu disampaikan kepadanya, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada rayuan dibuat dalam tempoh yang ditentukan dalam subseksyen (2) atau jika rayuan telah dibuat tetapi ditolak, Ketua Pendaftar hendaklah dengan segera membatalkan pendaftaran itu dan menyampaikan suatu notis kepada guru itu memberitahunya bahawa pendaftarannya telah dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pembatalan pendaftaran boleh dibuat di bawah seksyen ini berdasarkan mana-mana alasan yang disebut dalam perenggan 106(d) dan (e) disebabkan apa- apa fakta atau hal yang berlaku sebelum tarikh pendaftaran seseorang guru dan yang telah diberitahu kepada Ketua Pendaftar sebelum tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas suatu rayuan yang dibuat di bawah Bab ini diperintahkan oleh Menteri supaya seseorang guru hendaklah didaftarkan, atau hendaklah kekal didaftarkan, tertakluk kepada syarat-syarat yang ditentukan, Ketua Pendaftar hendaklah mengenakan syarat-syarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Syarat-syarat yang dikenakan di bawah subseksyen (1) hendaklah disifatkan sebagai syarat-syarat yang dikenakan di bawah subseksyen 109(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika pendaftaran seseorang guru telah dibatalkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di bawah seksyen 110 dan notis telah disampaikan di bawah subseksyen 110(3), Ketua Pendaftar hendaklah dengan segera mengeluarkan guru itu daripada daftar, dan guru itu hendaklah, dalam masa dua puluh satu hari dari tarikh notis itu disampaikan kepadanya, menyerahkan balik perakuan pendaftarannya kepada Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang pada tarikh yang ditetapkan adalah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "berdaftar atau disifatkan berdaftar sebagai guru di bawah Akta Pelajaran 1961 hendaklah disifatkan telah didaftarkan sedemikian di bawah Akta ini dan hendaklah tertakluk kepada Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Permit Mengajar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengeluarkan suatu permit mengajar kepada orang yang berikut, yang bukan guru berdaftar:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang guru pelatih, selain daripada mereka yang dinyatakan dalam perenggan 103(2)(c), yang sedang menjalani latihan menjadi guru mengikut mana-mana skim yang diluluskan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang telah memohon untuk didaftarkan sebagai guru dan permohonannya belum diputuskan lagi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang diperlukan untuk bertindak secara sementara sebagai guru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Permit mengajar hendaklah dalam borang dan tertakluk kepada apa-apa syarat yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, pada bila-bila masa dan menurut budi bicaranya, membatalkan sesuatu permit mengajar dengan memberikan notis bertulis kepada pemegang permit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_116"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Pelbagai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran sebagai guru yang dikeluarkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di bawah Akta ini atau di bawah mana-mana undang- undang bertulis terdahulu yang berhubungan dengan pendaftaran guru atau apa-apa dokumen yang menjadi keterangan pendaftaran atau pengecualian daripada pendaftaran guru atau bahawa seorang guru itu disifatkan sebagai didaftarkan di bawah undang-undang itu, atau sesuatu permit mengajar yang dikeluarkan di bawah seksyen 114 hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila perakuan, dokumen atau permit itu dibatalkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila orang yang kepadanya perakuan, dokumen atau permit itu dikeluarkan terhenti mengajar di sesuatu institusi pendidikan di Malaysia selama suatu tempoh berterusan yang melebihi dua tahun, atau apabila orang itu meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila diminta secara bertulis oleh Ketua Pendaftar bagi tujuan pengubahan, pemindaan, pengendorsan atau penggantian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu permit, apabila tempoh keesahannya tamat, diserahkan balik kepada Ketua Pendaftar dalam masa dua puluh satu hari oleh orang yang kepadanya perakuan, dokumen atau permit itu dikeluarkan atau mana-mana orang yang memilikinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IX__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap guru berdaftar hendaklah dalam tempoh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "empat belas hari dari tarikh dia mula atau terhenti mengajar di sesuatu institusi pendidikan melaporkan secara bertulis kepada Ketua Pendaftar nama institusi pendidikan tempat dia mengajar atau terhenti mengajar dan tarikh dia mula mengajar atau terhenti mengajar di institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pendidikan 1995"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"bahasa Cina\" ertinya bentuk bahasa Cina yang biasanya dikenali sebagai Mandarin; \"bahasa kebangsaan\" ertinya bahasa Melayu sebagaimana yang ditentukan dalam Perkara 152 Perlembagaan Persekutuan; \"ditetapkan\" ertinya ditetapkan oleh peraturan-peraturan yang dibuat di bawah Akta ini; \"fee yang diluluskan\" ertinya fee yang diluluskan oleh Menteri; \"guru\" ertinya seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengajar murid di sesuatu institusi pendidikan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan atau mengeluarkan bahan pengajaran atau memeriksa jawapan yang dikembalikan di, bagi atau melalui pusat pendidikan jarak jauh, dan termasuklah guru besar atau pengetua; \"guru berdaftar\" ertinya mana-mana guru yang didaftarkan di bawah Akta ini; \"ibu bapa\" termasuklah penjaga dan mana-mana orang yang mempunyai kawalan di sisi undang-undang atau kawalan sebenar ke atas seseorang murid; \"institusi pendidikan\" ertinya sekolah atau mana-mana tempat lain, di mana dalam menjalankan kerja sesuatu organisasi atau institusi, orang lazimnya diajar, sama ada di dalam satu kelas atau lebih, dan termasuklah tadika dan pusat pendidikan jarak jauh tetapi tidak termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana tempat di mana pengajarannya terbatas kepada pengajaran mana-mana agama semata-mata; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana tempat yang diisytiharkan oleh Menteri melalui pemberitahuan dalam Warta sebagai bukan institusi pendidikan bagi maksud Akta ini; \"institusi pendidikan tinggi\" ertinya institusi pendidikan yang menyediakan pendidikan tinggi yang membawa kepada penganugerahan diploma, ijazah atau yang setaraf dengannya; \"kelas peralihan\" ertinya kelas di sekolah menengah yang menyediakan ajaran selama satu tahun untuk murid daripada sekolah rendah yang menggunakan bahasa selain daripada bahasa kebangsaan sebagai bahasa pengantar sebelum bermulanya pendidikan menengah rendah; \"Ketua Nazir\" ertinya Ketua Nazir Sekolah yang dilantik di bawah subseksyen 6(1); \"Ketua Pendaftar\" ertinya Ketua Pendaftar Sekolah dan Guru yang dilantik di bawah subseksyen 5(l),dan termasuklah Timbalan Ketua Pendaftar Sekolah dan Guru yang dilantik di bawah subseksyen 5(2); \"Ketua Pengarah\" ertinya Ketua Pengarah Pendidikan yang dilantik di bawah seksyen 3; \"Kurikulum Kebangsaan\" ertinya kurikulum yang ditetapkan; \"kurikulum prasekolah\" ertinya garis panduan kurikulum yang diluluskan oleh Menteri di bawah seksyen 22 bagi kegunaan tadika; \"murid\" ertinya seseorang, tanpa mengira umurnya, yang kepadanya pendidikan atau latihan sedang diberikan di sesuatu institusi pendidikan; \"Pegawai Pendidikan\", berhubungan dengan sesuatu daerah atau kawasan, ertinya pegawai pendidikan yang dilantik di bawah perenggan 4(b); \"pekerja\" ertinya orang yang diambil kerja oleh suatu lembaga pengelola, selain daripada pengelola, guru atau mana-mana orang lain yang dilantik atau dinamakan oleh Menteri di bawah subseksyen 58(2) atau 61(2), mengikut mana-mana yang berkenaan, yang diambil kerja atau yang mengambil bahagian secara aktif dalam kerja yang berkaitan dengan perjalanan atau pentadbiran sesuatu institusi pendidikan; \"Pendaftar\" ertinya Pendaftar Sekolah dan Guru yang dilantik di bawah subseksyen 5(3) dan termasuklah Ketua Pendaftar; \"pendidikan khas\" ertinya pendidikan yang menyediakan keperluan pendidikan khas murid; \"pendidikan lepas menengah\" ertinya pendidikan yang disediakan untuk seseorang yang sudah tamat mengikuti pendidikan menengah atas, tetapi tidak termasuk pendidikan tinggi; \"pendidikan menengah\" ertinya pendidikan yang terdiri daripada pendidikan menengah rendah dan menengah atas; \"pendidikan menengah atas\" ertinya pendidikan yang sesuai dengan kebolehan dan bakat seseorang murid yang sudah tamat mengikuti pendidikan menengah rendah; \"pendidikan menengah rendah\" ertinya kursus tiga tahun yang sesuai bagi seseorang murid yang sudah tamat mengikuti pendidikan rendah; \"pendidikan pengembangan\" ertinya pendidikan sepenuh masa atau separuh masa bagi orang yang tidak mengikuti kursus pengajian biasa di institusi pendidikan; \"pendidikan prasekolah\" ertinya program pendidikan bagi murid yang berumur antara empat dan enam tahun; \"pendidikan rendah\" ertinya kursus pengajian pada peringkat rendah yang direncanakan bagi tempoh enam tahun tetapi yang boleh tamat diikuti dalam tempoh antara lima hingga tujuh tahun; \"pendidikan tinggi\" ertinya pendidikan yang disediakan oleh institusi pendidikan tinggi; \"Pengarah Pendidikan\" ertinya Pengarah Pendidikan sesuatu Negeri atau Wilayah Persekutuan yang dilantik di bawah seksyen 4; \"pengelola\" ertinya orang yang diberikan kuasa di bawah suratcara pengelolaan untuk mentadbirkan atau menguruskan sesuatu institusi pendidikan; \"Penolong Pendaftar\" ertinya Penolong Pendaftar Sekolah atau Penolong Pendaftar Guru, mengikut mana- mana yang berkenaan, yang dilantik di bawah subseksyen 5(3); \"Perkhidmatan Pendidikan\" ertinya suatu perkhidmatan awam di bawah perenggan ( 1 )( h) Perkara 132 Perlembagaan Persekutuan; \"Pihak Berkuasa Negeri\" ertinya Raja atau Yang di- Pertua Negeri sesuatu Negeri dan, bagi Wilayah Persekutuan, Yang di-Pertuan Agong; \"premis\" ertinya mana-mana bangunan yang digunakan sebagai institusi pendidikan dan termasuklah mana-mana bangunan bagi maksud menyediakan tempat tinggal dan kemudahan lain bagi murid dan kakitangan institusi itu tetapi tidak termasuk mana-mana tanah yang menjadi tapak bangunan itu; \"pusat pendidikan jarak jauh\" ertinya tempat, organisasi atau institusi yang menyediakan ajaran atau pengajaran—"
      }
    },
