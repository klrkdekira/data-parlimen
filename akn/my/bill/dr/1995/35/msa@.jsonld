      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_80",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran Institusi Pendidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan lain Akta ini, tiap-tiap institusi pendidikan hendaklah didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan untuk didaftarkan di bawah Akta ini hendaklah dibuat kepada Ketua Pendaftar mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengenakan apa-apa terma dan syarat yang difikirkannya patut apabila mendaftarkan sesuatu institusi pendidikan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menyimpan atau menyebabkan supaya disimpan suatu daftar institusi pendidikan dalam bentuk dan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Sementara menanti selesainya penyiasatan tentang permohonan yang dibuat di bawah subseksyen 79(2), Ketua Pendaftar boleh, menurut budi bicaranya, mengeluarkan perakuan pendaftaran sementara dalam bentuk dan tertakluk kepada apa-apa syarat yang ditetapkan kepada orang yang akan bertindak sebagai pengerusi lembaga pengelola atau orang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran sementara yang dikeluarkan di bawah subseksyen (1) boleh menurut budi bicara Ketua Pendaftar dibatalkan pada bila-bila masa melalui notis bertulis yang disampaikan kepada orang yang kepadanya perakuan itu dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan seksyen 81 dan tertakluk kepada subseksyen (3) dan seksyen 83, Ketua Pendaftar hendaklah, apabila permohonan bagi pendaftaran sesuatu institusi pendidikan dibuat dengan sewajarnya dan selepas apa-apa siasatan yang difikirkannya perlu, dan apabila apa-apa fee yang ditetapkan dibayar, mendaftarkan institusi pendidikan itu dan mengeluarkan perakuan pendaftaran kepada pengerusi lembaga pengelola atau orang yang bertanggungjawab tentang pengurusan institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi lembaga pengelola atau mana-mana orang lain yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan hendaklah menyebabkan sesalinan perakuan pendaftaran yang dikeluarkan di bawah subseksyen (1) sentiasa dipamerkan di suatu tempat yang ketara di premis institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengenakan apa-apa syarat sebagaimana yang difikirkannya patut sebelum pendaftaran,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada institusi pendidikan boleh menukar alamat premisnya atau membuat apa-apa perubahan kepada premis itu tanpa terlebih dahulu mendapat kelulusan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan untuk menukar alamat premis institusi pendidikan atau untuk membuat perubahan kepada premis hendaklah dibuat kepada Ketua Pendaftar dalam bentuk dan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mendaftarkan sesuatu"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan jika dia berpuas hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan itu tidak memenuhi piawaian kesihatan dan keselamatan yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan itu digunakan atau mungkin digunakan bagi maksud yang memudaratkan kepentingan Malaysia, awam atau murid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa nama yang dengannya pendidikan itu hendak didaftarkan adalah, pada pendapatnya, tidak sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kemudahan pendidikan yang sedia ada sudah mencukupi dalam kawasan di mana institusi pendidikan itu dicadangkan dibuka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa suatu pernyataan yang palsu atau mengelirukan berkenaan dengan sesuatu butir yang material telah dibuat dalam atau berkaitan dengan permohonan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa orang yang memohon mendaftarkan institusi pendidikan itu tidak atau enggan mematuhi mana- mana syarat yang dikenakan oleh Ketua Pendaftar di bawah subseksyen 82(3); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa orang yang dilantik menjadi pengerusi lembaga pengelola, guru besar atau pengetua bukanlah seorang yang layak dan sesuai atau bertanggungjawab untuk bertindak sebagai pengerusi atau guru besar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Ketua Pendaftar enggan mendaftarkan sesuatu institusi pendidikan di bawah seksyen 84, dia hendaklah memberitahu pemohon melalui notis bertulis tentang keengganannya itu, dengan menyatakan alasan keengganannya dalam notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemohon yang terkilan dengan keengganan Ketua Pendaftar untuk mendaftarkan sesuatu institusi pendidikan boleh, dalam masa dua puluh satu hari dari tarikh notis itu disampaikan kepadanya mengikut subseksyen (1), merayu kepada Menteri dan keputusan Menteri adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mempromosikan sesuatu institusi pendidikan, sama ada melalui iklan prospektus, risalah atau selainnya, melainkan jika institusi pendidikan itu telah didaftarkan atau perakuan pendaftaran sementara telah dikeluarkan di bawah subseksyen 81(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_1__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pembatalan Pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh menyampaikan notis kepada pengerusi lembaga pengelola atau mana-mana orang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan tentang niat untuk membatalkan pendaftaran institusi pendidikan itu jika dia berpuas hati bahawa adalah suaimanfaat untuk berbuat demikian berdasarkan mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "alasan yang dinyatakan dalam perenggan 84(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa disiplin di institusi pendidikan itu tidak dijaga dengan secukupnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pendaftaran institusi pendidikan itu diperolehi oleh sebab kesilapan atau apa-apa pernyataan yang palsu atau mengelirukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pengerusi lembaga pengelola atau mana- mana orang yang bertanggungjawab tentang pengurusan institusi pendidikan itu telah membuat pernyataan yang palsu atau mengelirukan berkenaan dengan suatu butir yang material pada mempromosikan pendidikan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa terdapat pelanggaran mana-mana terma atau syarat yang dikenakan oleh Ketua Pendaftar di bawah subseksyen 79(3);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa lembaga pengelola institusi pendidikan itu tidak ada pengerusi, atau bahawa orang yang dilantik menjadi pengerusi lembaga pengelola atau menjadi guru besar bukanlah orang yang layak dan sesuai atau bertanggungjawab untuk bertindak sebagai pengerusi atau guru besar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh bertindak di bawah subseksyen (1) jika dia ada sebab untuk mempercayai bahawa suatu institusi pendidikan berdaftar tidak lagi wujud."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis tentang niat untuk membatalkan pendaftaran sesuatu institusi pendidikan di bawah subseksyen (1) hendaklah menyatakan alasan yang berdasarkannya pendaftaran dicadangkan dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika notis di bawah subseksyen (1) telah disampaikan kepada orang yang disebut dalam subseksyen itu, dia boleh dalam masa dua puluh satu hari dari tarikh notis itu disampaikan kepadanya merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_2__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada rayuan dibuat di bawah subseksyen (4), atau jika suatu rayuan telah dibuat tetapi ditolak, Ketua Pendaftar boleh membatalkan pendaftaran institusi pendidikan itu dengan segera; dan dalam masa dua puluh satu hari dari tarikh pembatalan itu, pengerusi lembaga pengelola atau mana-mana orang yang bertanggungjawab tentang pengurusan institusi pendidikan itu hendaklah menyerahkan balik perakuan pendaftaran institusi pendidikan itu dan suratcara pengelolaannya kepada Ketua Pendaftar, dan pengerusi dan pengelola serta tiap- tiap pekerja institusi pendidikan itu hendaklah menyerahkan balik perakuan pendaftaran mereka yang dikeluarkan di bawah Akta ini kepada Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_91",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_92",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_95",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_96",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran Pengelola dan Pekerja"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang bertindak sebagai pengelola atau pekerja sesuatu institusi pendidikan hendaklah didaftarkan sebagai pengelola atau pekerja, mengikut mana-mana yang berkenaan, berkenaan dengan institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan supaya didaftarkan sebagai pengelola atau pekerja sesuatu institusi pendidikan hendaklah dibuat dalam borang yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 90, Ketua Pendaftar hendaklah, apabila permohonan dibuat dengan sewajarnya dan selepas dibuat apa-apa siasatan yang difikirkannya perlu, mendaftarkan seseorang sebagai pengelola atau pekerja berkenaan dengan sesuatu institusi pendidikan dan hendaklah mengeluarkan suatu perakuan pendaftaran dalam borang yang ditetapkan kepada orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh menurut budi bicaranya mengeluarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada seseorang yang memohon untuk didaftarkan di bawah Bab ini (sama ada semasa institusi pendidikan didaftarkan atau selepasnya); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada seseorang yang diperlukan untuk bertindak secara sementara sebagai pengelola atau pekerja, suatu permit, dalam apa-apa borang yang ditetapkan, untuk bertindak atas sifat itu, dan semasa permit itu berkuatkuasa orang yang kepadanya permit itu dikeluarkan hendaklah disifatkan sebagai berdaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Permit yang dikeluarkan di bawah subseksyen (2) boleh dibatalkan oleh Ketua Pendaftar pada bila-bila masa dan, dalam hal seseorang yang memohon untuk didaftarkan, hendaklah terhenti berkuatkuasa apabila orang yang kepadanya permit itu dikeluarkan didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mendaftarkan seseorang sebagai pengelola atau pekerja sesuatu institusi pendidikan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah disabitkan atas suatu kesalahan oleh mahkamah dan dijatuhi hukuman pemenjaraan selama tempoh yang tidak kurang daripada satu tahun atau denda yang tidak kurang daripada dua ribu ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah, selain daripada hanya atas sebab sesuatu institusi pendidikan tidak lagi wujud, dikeluarkan daripada mana-mana daftar yang diwujudkan di bawah Akta ini atau di bawah peruntukan mana-mana undang-undang bertulis yang bersamaan yang terdahulu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah membuat pernyataan yang palsu atau mengelirukan dalam, atau berkaitan dengan, permohonannya untuk didaftarkan, atau dengan sengaja rnendiamkan apa-apa fakta yang material bagi permohonan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu bukan warganegara Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah enggan mendaftarkan seseorang yang berumur di bawah lapan belas tahun sebagai pengelola."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila Ketua Pendaftar enggan mendaftarkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang sebagai pengelola atau pekerja sesuatu institusi pendidikan di bawah seksyen 90 dia hendaklah memberitahu orang itu melalui notis bertulis tentang keengganan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan dengan keengganan Ketua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar untuk mendaftarkannya sebagai pengelola atau untuk pekerja sesuatu institusi pendidikan boleh, dalam masa dua puluh satu hari dari tarikh dia diberitahu tentang keengganan itu mengikut seksyen 91, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengeluarkan daripada daftar seseorang pengelola atau pekerja—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas alasan yang dinyatakan dalam perenggan 90(l)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika didapati oleh Ketua Pendaftar bahawa orang itu bukanlah seorang yang patut, demi kepentingan Malaysia, awam atau mana-mana orang, kekal sebagai pengelola atau pekerja; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah memperoleh pendaftarannya akibat suatu kesilapan atau apa-apa butir yang palsu atau mengelirukan yang diberikan dalam atau berkaitan dengan permohonannya untuk didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), tiada seorang pun boleh dikeluarkan daripada daftar di bawah perenggan (l)(a) atas sebab apa-apa fakta atau hal yang berlaku sebelum tarikh pendaftarannya dan yang telah diberitahu kepada Pendaftar sebelum tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila seseorang pengelola atau pekerja sesuatu institusi pendidikan bersara atau terhenti bertindak sebagai yang sedemikian, pengerusi lembaga pengelola institusi pendidikan itu atau seseorang yang diberikuasa olehnya bagi maksud itu hendaklah, dalam masa dua puluh satu hari dari tarikh pengelola atau pekerja itu bersara atau terhenti sedemikian, melaporkan hakikat itu kepada Ketua Pendaftar secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, apabila menerima laporan di bawah subseksyen (1), dengan segera mengeluarkan pengelola atau pekerja itu, mengikut mana- mana yang berkenaan, daripada daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila seseorang dikeluarkan daripada daftar di"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bawah seksyen 93 atau 94 Ketua Pendaftar hendaklah dengan segera memberitahu orang itu melalui notis bertulis bahawa dia telah dikeluarkan sedemikian dan alasan pengeluarannya itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang dikeluarkan daripada daftar di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 93 atau 94 boleh, dalam masa dua puluh satu hari dari tarikh notis disampaikan kepadanya mengikut seksyen 95, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang telah dikeluarkan daripada daftar hendaklah, dalam masa dua puluh satu hari dari tarikh penyampaian notis di bawah seksyen 95, menyerahkan balik kepada Ketua Pendaftar perakuan pendaftaran yang dikeluarkan kepadanya di bawah Akta ini atau mana- mana undang-undang bertulis terdahulu yang berhubungan dengan pendaftaran pengelola atau pekerja, mengikut mana-mana yang berkenaan, sesuatu institusi pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_3__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika rayuan dibuat di bawah seksyen 96, perakuan yang disebut dalam subseksyen (1) tidak perlu diserahkan balik sehingga rayuan itu diputuskan dengan memihak kepada Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_4__cl_98",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran Murid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_4__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_4",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengelola, guru besar atau orang lain yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bertanggungjawab tentang pengurusan sesuatu institusi pendidikan hendaklah menyimpan atau menyebabkan supaya disimpan, mengikut cara yang ditetapkan, suatu daftar yang mengandungi butir-butir yang ditetapkan mengenai semua murid di institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5",
      "@type": "akn:chapter",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_99",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Pemeriksaan Institusi Pendidikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "oleh Ketua Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Semasa menjalankan pemeriksaan menurut seksyen 99, Ketua Pendaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memasuki mana-mana premis dan memeriksa mana-mana buku, dokumen, bahan media elektronik atau barang lain yang difikirkannya perlu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil dan menahan apa-apa buku, dokumen, bahan media elektronik atau barang lain yang didapatinya memudaratkan kepentingan awam atau murid atau yang, pada pendapatnya, boleh menjadi bukti pelakuan sesuatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh pada bila-bila masa ketika menjalankan dengan sah pemeriksaan di sesuatu institusi pendidikan di bawah Akta ini menghendaki mana-mana orang, yang menjadi pengelola, pekerja, guru atau murid institusi pendidikan itu, supaya mengemukakan untuk pemeriksaannya apa-apa buku, dokumen, bahan media elektronik atau barang lain yang berhubungan dengan pengurusan, atau pengajaran yang dijalankan di, institusi pendidikan itu yang ada dalam milikan orang itu atau di bawah kawalannya atau yang orang itu mempunyai kuasa untuk mengemukakannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika Ketua Pendaftar atau pegawai awam yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "diberikuasa oleh Ketua Pendaftar bagi maksud itu secara bertulis atau pegawai polis yang berpangkat tidak rendah daripada Inspektor mempunyai sebab yang munasabah untuk mempercayai bahawa mana-mana rumah, bangunan atau tempat lain sedang digunakan sebagai institusi pendidikan tanpa berdaftar di bawah Akta ini, Ketua Pendaftar atau pegawai awam atau pegawai polis itu, dengan ditemani oleh mana-mana orang yang difikirkannya perlu, boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "memasuki dan memeriksa rumah, bangunan atau tempat itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "menyita dan menahan apa-apa buku, dokumen, bahan media elektronik atau barang lain yang terdapat di dalamnya yang didapatinya boleh menjadi bukti pelakuan sesuatu kesalahan terhadap Akta ini atau yang tampaknya adalah harta, atau telah digunakan berkaitan dengan, sesuatu institusi pendidikan yang tidak berdaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pendaftar atau pegawai awam yang diberikuasa oleh Ketua Pendaftar bagi maksud itu secara bertulis atau pegawai polis yang berpangkat tidak rendah daripada Inspektor mempunyai sebab yang munasabah untuk mempercayai bahawa mana-mana rumah, bangunan atau tempat lain sedang digunakan sebagai institusi pendidikan tanpa berdaftar di bawah Akta ini atau sedang digunakan dengan melanggar mana-mana syarat yang dikenakan oleh Menteri di bawah subseksyen 47(2) atau 77(3), maka Ketua Pendaftar atau pegawai awam atau pegawai polis itu, dengan ditemani oleh mana-mana orang yang difikirkannya perlu boleh, tanpa menjejaskan penjalanan kuasa yang diberikan kepadanya di bawah seksyen 99, 100 dan 101, dengan segera mengambil apa- apa langkah yang difikirkannya perlu atau dengan apa- apa cara menutup institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang diambil di bawah subseksyen (1) berkenaan dengan mana-mana rumah, bangunan atau tempat lain tidaklah menghalang Ketua Pendaftar daripada mendakwa mana-mana orang yang menggunakan rumah, bangunan atau tempat itu sebagai institusi pendidikan tanpa berdaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VIII__chp_5",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, dari semasa ke semasa,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa atau menyebabkan supaya diperiksa institusi pendidikan yang didaftarkan di bawah Akta ini bagi maksud memastikan bahawa Akta ini dan peraturan- peraturan yang dibuat di bawah Akta ini telah dan sedang dipatuhi. 56 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam Akta ini boleh ditafsirkan sebagai melarang penubuhan dan penyenggaraan institusi pendidikan swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), tiap-tiap institusi pendidikan swasta hendaklah mematuhi peruntukan Akta ini dan semua peraturan yang dibuat di bawah Akta ini yang terpakai bagi institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Institusi pendidikan swasta yang menyediakan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan rendah atau menengah atau kedua-duanya hendaklah mematuhi kehendak Kurikulum Kebangsaan dan hendaklah menyediakan murid bagi peperiksaan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menghendaki institusi pendidikan swasta yang menyediakan pendidikan lepas menengah supaya mengajar mata pelajaran yang berikut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahasa kebangsaan, jika bahasa pengantarnya ialah suatu bahasa selain daripada bahasa kebangsaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengajian Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahasa Inggeris, jika bahasa pengantarnya ialah suatu bahasa selain daripada bahasa Inggeris; 46 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengajian yang berhubungan dengan pendidikan Islam bagi murid yang menganut agama Islam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan moral bagi murid yang tidak menganut agama Islam, berdasarkan kurikulum yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Mata pelajaran yang disebut dalam perenggan (l)(a) hingga (l)(e) hendaklah diajarkan sebagai tambahan kepada apa-apa mata pelajaran atau kursus pengajian lain yang diajarkan di institusi pendidikan swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pengawasan, pengawalseliaan atau pengawalan taraf pendidikan di institusi pendidikan swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada institusi pendidikan swasta boleh mengendalikan apa-apa kursus pengajian atau program latihan secara bersesama atau bersekutu, bergabung, bekerjasama atau selainnya, dengan sesuatu universiti atau institusi pendidikan tinggi atau institusi atau organisasi pendidikan lain di dalam atau di luar Malaysia, kecuali dengan kelulusan bertulis daripada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri tidak boleh memberikan kelulusannya di bawah subseksyen (1) melainkan jika dia berpuas hati bahawa institusi pendidikan swasta itu telah membuat perkiraan yang sesuai dengan universiti atau institusi pendidikan tinggi atau institusi pendidikan atau organisasi pendidikan lain itu tentang kemudahan bagi penyediaan kursus pengajian atau program latihan yang disebut dalam subseksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengenakan apa-apa terma dan syarat yang difikirkannya patut apabila memberikan kelulusan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) atau tidak mematuhi mana-mana terma atau syarat yang dikenakan oleh Menteri di bawah subseksyen (3) adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, adalah diisytiharkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tiada apa-apa jua dalam Bahagian ini boleh menyentuh atau mengurangkan pemakaian peruntukan lain dalam Akta ini bagi institusi pendidikan swasta kecuali setakat yang institusi pendidikan itu telah dengan nyatanya dikecualikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh mengadakan pendidikan tinggi di"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi mengikut mana-mana undang- undang bertulis yang berhubungan dengan pendidikan tinggi dan hendaklah bertanggungjawab tentang arahan am pendidikan tinggi tu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan, membentuk, menggalakkan atau melaksanakan apa-apa kegiatan bagi maksud menubuhkan atau membentuk, atau bagi penubuhan atau pembentukan, suatu institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "memungut, memberikan atau menerima apa-apa wang, sumbangan, hadiah atau derma, atau melakukan apa-apa perbuatan atau menjalankan apa-apa kegiatan bagi maksud menubuhkan atau membentuk suatu institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "mengendalikan, menguruskan menyenggarakan mana-mana kelas bagi pengajaran dan pembelajaran pendidikan tinggi melainkan jika kelas itu dikendalikan, diuruskan atau disenggarakan oleh suatu pendidikan tinggi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan, mengendalikan, menguruskan atau menyenggarakan institusi pendidikan tinggi dengan menggunakan perkataan \"universiti\", kecuali mengikut mana-mana undang-undang bertulis mengenai pendidikan tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar seksyen 71 adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan cara murid di sekolah rendah dan sekolah menengah hendaklah dinilai dan taraf yang perlu dicapai oleh murid itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Penilaian yang ditetapkan di bawah subseksyen (1) hendaklah sebagai tambahan kepada mana-mana peperiksaan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan yang mengadakan peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "peperiksaan yang hendaklah diadakan bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "masa dan tempat peperiksaan akan diadakan, dan kelayakan serta syarat-syarat untuk menyertai peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "fee yang hendaklah dibayar bagi menyertai peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "sukatan dan bahasa pengantar bagi peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "pengendalian peperiksaan termasuklah penubuhan badan atau lembaga untuk menguruskan dan mengendalikan peperiksaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "kuasa, fungsi dan kewajipan Pengarah Peperiksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (4), tiada seorang pun atau tiada suatu institusi pendidikan pun boleh mengendalikan, membenarkan atau menyebabkan diadakan atau dikendalikan, atau dengan apa-apa cara terlibat dalam pengadaan atau pengendalian, apa-apa peperiksaan bagi mana-mana murid institusi pendidikan atau bagi mana- mana calon persendirian tanpa terlebih dahulu mendapat kelulusan bertulis Pengarah Peperiksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam memberikan kelulusan di bawah subseksyen (1), Pengarah Peperiksaan boleh mengenakan apa-apa sekatan, terma dan syarat yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan dalam seksyen ini mengenai pengadaan atau pengendalian peperiksaan hendaklah disifatkan termasuk perbuatan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mempelawa calon untuk mengambil peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memungut atau menerima apa-apa fee atau bayaran atau apa-apa derma atau hadiah berkenaan dengan sesuatu peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan apa-apa sukatan pelajaran, kursus atau skim pengajian berkenaan dengan sesuatu peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa atau menggred jawapan atau respons kepada soalan atau ujian dalam sesuatu peperiksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan atau menganugerahkan apa-apa diploma atau apa-apa dokumen lain atau bentuk lain pengiktirafan berkenaan dengan sesuatu peperiksaan, dan apa-apa perbuatan lain yang berhubungan dengan pengadaan atau pengendalian sesuatu peperiksaan, tidak kira sama ada perbuatan itu dilakukan sebelum atau selepas peperiksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidaklah terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "badan atau lembaga yang ditubuhkan untuk menguruskan dan mengendalikan peperiksaan di bawah perenggan 68(e);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peperiksaan Malaysia yang ditubuhkan di bawah Akta Majlis Peperiksaan Malaysia 1980; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu institusi pendidikan yang mengendalikan peperiksaan, ujian atau bentuk-bentuk penilaian lain bagi maksud menilai murid-muridnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) atau tidak mematuhi mana-mana sekatan, terma atau syarat yang dikenakan di bawah subseksyen (2) adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua- duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
