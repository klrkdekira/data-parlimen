      "schema:name": {
        "@language": "ms",
        "@value": "Sistem Pendidikan Kebangsaan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Sistem"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10",
      "@type": "akn:chapter",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_52"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengajaran Agama di Institusi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika di dalam sesuatu institusi pendidikan terdapat lima orang murid atau lebih yang menganut agama Islam, maka murid-murid itu hendaklah diberikan pengajaran agama Islam oleh guru yang diluluskan oleh Pihak Berkuasa Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengajaran yang dikehendaki di sesuatu institusi pendidikan di bawah subseksyen (1) hendaklah selama tempoh sekurang-kurangnya dua jam seminggu dalam waktu pengajaran biasa institusi pendidikan itu, atau dalam apa-apa waktu lain yang ditetapkan oleh Menteri, dalam hal mana-mana institusi pendidikan yang tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengelola atau orang lain yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan yang dikehendaki menyediakan pengajaran di bawah seksyen ini hendaklah membuat apa-apa perkiraan yang perlu bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengelola atau orang lain yang bertanggungjawab tentang pengurusan dua institusi pendidikan atau lebih boleh, dengan kelulusan Pendaftar, membuat perkiraan supaya pengajaran di bawah seksyen ini diberikan secara bergabung di institusi-institusi pendidikan itu kepada murid yang menganut agama Islam. PENDIDIKAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengelola institusi pendidikan bantuan kerajaan boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi pengajaran agama selain daripada agama Islam untuk murid institusi pendidikan itu atau mana-mana daripada mereka tetapi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "peruntukan sedemikian tidak boleh dibiayai dengan wang yang diperuntukkan oleh Parlimen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada murid boleh mengikuti pengajaran agama selain daripada agama yang dianutinya,kecuali dengan keizinan bertulis ibu bapanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_10",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa syarat dan batasan yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "difikirkan oleh Menteri patut dikenakan, bantuan kewangan secara sumbangan boleh diberikan daripada wang yang diperuntukkan oleh Parlimen kepada sesuatu institusi pendidikan Islam yang tidak disenggarakan oleh Menteri di bawah Akta ini atau oleh Kerajaan sesuatu Negeri dan yang adalah institusi pendidikan mengikut pengertian Akta ini atau bukan institusi pendidikan sedemikian hanya kerana pengajaran di institusi itu adalah terbatas kepada pengajaran agama Islam semata-mata."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11",
      "@type": "akn:chapter",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_63"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengurusan Institusi Pendidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, tiap-tiap institusi pendidikan hendaklah mempunyai suratcara pengelolaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap suratcara pengelolaan hendaklah mengadakan peruntukan bagi penubuhan suatu lembaga pengelola, dengan seorang pengerusi, bagi pengurusan institusi pendidikan itu oleh pengelola-pengelola mengikut cara yang tidak tak konsisten dengan Akta ini dan mana- mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidaklah terpakai bagi institusi pendidikan kerajaan kecuali sekolah rendah jenis kebangsaan dan sekolah-sekolah yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap suratcara pengelolaan hendaklah dibuat, dipinda atau dibatalkan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi penubuhan lembaga pengelola dan bagi pengurusan institusi pendidikan oleh lembaga pengelola dan, tanpa menjejaskan keluasan kuasa itu, Menteri boleh, dalam peraturan-peraturan itu, menetapkan kewajipan pengelola- pengelola dan orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana peraturan yang dibuat di bawah subseksyen (1) boleh menetapkan kewajipan yang berlainan bagi pengelola-pengelola atau orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan yang berlainan kategori."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan lain Akta ini dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "khususnya peruntukan tentang pengecualian, tiap-tiap institusi pendidikan hendaklah diuruskan mengikut suratcara pengelolaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri berpuas hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa disiplin di sesuatu institusi pendidikan tidak dijaga dengan secukupnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa terma suratcara pengelolaan sesuatu institusi pendidikan sengaja tidak diendahkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini sengaja tidak diendahkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal institusi pendidikan bantuan kerajaan, harta atau wang institusi pendidikan itu tidak ditadbirkan dengan sepatutnya, dia boleh melantik dengan menyatakan namanya, pengelola-pengelola tambahan bagi institusi pendidikan itu sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, mengikut budi bicaranya, pada bila- bila masa memberhentikan jawatan pengelola tambahan yang dilantik di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengelola tambahan yang dilantik bagi institusi pendidikan di bawah subseksyen (1) hendaklah bagi segala maksud disifatkan menjadi pengelola institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab 3 Bahagian VIII tidaklah terpakai bagi pengelola tambahan yang dilantik di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan lain Akta ini dan mana-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana peraturan yang dibuat di bawah Akta ini, guru di institusi pendidikan selain daripada institusi pendidikan kerajaan atau bantuan kerajaan hendaklah dilantik mengikut suratcara pengelolaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri berpuas hati bahawa di sesuatu institusi pendidikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengelola-pengelolanya telah bertindak atau bercadang untuk bertindak dengan tidak munasabah berkenaan dengan penjalanan mana- mana kuasa yang diberikan atau penunaian mana- mana kewajipan yang dikenakan oleh atau di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengelola-pengelolanya telah tidak menunaikan mana-mana kewajipan yang dikenakan kepada mereka oleh atau di bawah Akta ini, maka Menteri boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan apa-apa arahan bertulis tentang penjalanan kuasa atau penunaian kewajipan itu sebagaimana yang didapati oleh Menteri adalah suaimanfaat, dan hendaklah menjadi kewajipan pengelola-pengelola itu untuk mematuhi arahan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menggantung atau membuang kerja semua atau mana-mana pengelola dan, walau apa pun peruntukan mana-mana suratcara pengelolaan berhubungan dengan institusi itu, melantik seseorang atau orang yang difikirkannya layak untuk mempunyai dan menjalankan semua fungsi pengelola itu selama apa-apa tempoh yang diarahkan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada bila-bila masa, bagi sesuatu institusi pendidikan, tidak ada lembaga pengelola yang ditubuhkan di bawah Akta ini maka Menteri boleh melantik seseorang atau orang yang difikirkannya layak untuk menjalankan fungsi pengelola bagi institusi itu selama apa-apa tempoh yang diarahkan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas memberi lembaga pengelola sesuatu institusi pendidikan kerajaan atau bantuan kerajaan suatu peluang untuk membuat representasi mengikut peraturan-peraturan yang dibuat di bawah Akta ini, melalui notis bertulis yang dialamatkan dan disampaikan kepada pengerusi lembaga itu memerintahkan supaya lembaga itu dibubarkan jika dia berpuas hati bahawa lembaga itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana arahan yang dikeluarkan oleh Menteri di bawah seksyen 9;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana terma atau syarat yang dikenakan di bawah subseksyen 82(3);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah tidak mematuhi atau melaksanakan mana- mana peruntukan suratcara pengelolaan institusi pendidikan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah tidak menghalang institusi pendidikan itu daripada digunakan bagi maksud yang memudaratkan kepentingan Malaysia atau mana- mana bahagiannya atau yang berlawanan dengan kepentingan awam; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah tidak menghalang institusi pendidikan itu daripada digunakan bagi apa-apa kegiatan atau maksud yang menyalahi undang-undang, atau bagi apa-apa kegiatan atau maksud sesuatu organisasi, pertubuhan atau kumpulan lain orang yang menyalahi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri membubarkan sesuatu lembaga di bawah subseksyen (1), dia hendaklah menyatakan dalam notis alasan-alasan bagi pembubaran itu dan tarikh pembubaran itu hendaklah berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11",
      "schema:name": {
        "@language": "ms",
        "@value": "Notis pembubaran sesuatu lembaga di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 59(1) boleh mengandungi segala arahan yang bersifat sampingan, berbangkit, tambahan atau peralihan yang difikirkan oleh Menteri perlu, suaimanfaat atau patut diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri membubarkan sesuatu lembaga di bawah seksyen 59, Menteri hendaklah pada bila-bila masa selepas itu melantik lembaga yang lain mengikut Akta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri tidak melantik lembaga di bawah subseksyen (1), kuasa, fungsi dan kewajipan lembaga hendaklah dijalankan oleh guru besar institusi pendidikan itu atau oleh mana-mana orang lain yang dinamakan oleh Menteri dan yang hendaklah merupakan anggota perkhidmatan awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas pembubaran lembaga pengelola sesuatu institusi pendidikan kerajaan atau bantuan kerajaan di bawah seksyen 59, maka seksyen 53, 54, 55, 56, 57 dan 87 tidaklah terpakai bagi institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap lembaga pengurus atau lembaga pengelola institusi pendidikan kerajaan kecuali—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah rendah jenis kebangsaan kerajaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah rendah kebangsaan kerajaan atau sekolah menengah kebangsaan kerajaan yang ditentukan oleh Menteri, yang ditubuhkan sebelum tarikh yang ditetapkan, hendaklah dibubarkan pada tarikh itu mengikut cara yang ditentukan oleh Menteri, dan sesudah itu ia hendaklah berhenti mengambil pekerja dan terhenti menjadi majikan kepada guru dan pekerja lain, dan tiap-tiap suratcara pengurusan atau pengelolaan yang berkaitan dengan institusi pendidikan itu hendaklah terhenti berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila lembaga pengurus atau lembaga pengelola sesuatu institusi pendidikan kerajaan dibubarkan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang bertindak sebagai pengurus atau pengelola sebaik sahaja sebelum tarikh yang ditetapkan hendaklah berhenti bertindak sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "segala hak, obligasi dan liabiliti berhubungan dengan apa-apa perkara yang, sebelum sahaja tarikh yang ditetapkan, adalah menjadi tanggungjawab lembaga hendaklah pada tarikh itu turun kepada Kerajaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_62__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 53, 54, 55, 56, 59 dan 87 tidaklah terpakai bagi institusi pendidikan kerajaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan mengenai lembaga pengelola dalam Bab ini hendaklah, berhubungan dengan Sabah dan Sarawak, termasuk Jawatankuasa Pengurusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12",
      "@type": "akn:chapter",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_66"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Peruntukan Kemudahan dan Perkhidmatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana peraturan yang dibuat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di bawah Akta ini, Menteri boleh memberikan sama ada bantuan kewangan atau selainnya berkenaan dengan murid atau mana-mana golongan murid di institusi pendidikan kerajaan atau bantuan kerajaan dan bantuan itu boleh termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian dermasiswa, biasiswa, pinjaman atau bantuan lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "penyediaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat tinggal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pengangkutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "buku; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_64__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan perubatan dan pergigian, bagi maksud membolehkan murid itu menggunakan sepenuhnya kemudahan yang tersedia bagi mereka atau bagi maksud memperbaiki kesihatan dan kesejahteraan hidup mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan oleh seksyen 64, Menteri hendaklah, setakat yang munasabah dan praktik berbuat demikian, menyediakan pemeriksaan perubatan dan pergigian pada lat tempoh yang sesuai ke atas murid institusi pendidikan kerajaan atau bantuan kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai yang diberikuasa bagi maksud itu oleh Menteri boleh menghendaki ibu bapa atau penjaga murid institusi pendidikan kerajaan atau bantuan kerajaan menyebabkan murid itu menjalani pemeriksaan perubatan atau pergigian, mengikut persediaan yang dibuat oleh pihak berkuasa sekolah, atau oleh seseorang pengamal perubatan atau pengamal pergigian berdaftar, dan seseorang yang tanpa alasan yang munasabah tidak mematuhi kehendak itu adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_12",
      "schema:name": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "oleh seksyen 64, Menteri boleh, jika tidak boleh semunasabahnya disediakan bagi murid pendidikan atau latihan yang diperlukan melainkan jika tempat penginapan disediakan, membuat perkiraan bagi tempat penginapan itu (sama ada percuma atau tertakluk kepada apa-apa bayaran yang diperuntukkan dalam perkiraan itu) yang difikirkannya sesuai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Sistem Pendidikan Kebangsaan hendaklah terdiri Pendidikan daripada— Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan prasekolah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan rendah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan menengah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan lepas menengah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan tinggi, tetapi tidak termasuk pendidikan di sekolah ekspatriat. Kategori"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada tiga kategori institusi pendidikan institusi dalam Sistem Pendidikan Kebangsaan, iaitu— pendidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan bantuan kerajaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahasa kebangsaan hendaklah menjadi bahasa pengantar utama di semua institusi pendidikan dalam Sistem Pendidikan Kebangsaan kecuali sekolah jenis kebangsaan yang ditubuhkan di bawah seksyen 28 atau mana-mana institusi pendidikan lain yang dikecualikan oleh Menteri daripada subseksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bahasa pengantar utama di sesuatu institusi pendidikan adalah selain daripada bahasa kebangsaan, maka bahasa kebangsaan hendaklah diajarkan sebagai mata pelajaran wajib di institusi pendidikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah menetapkan suatu kurikulum yang dikenali sebagai Kurikulum Kebangsaan yang tertakluk kepada subseksyen (3), hendaklah digunakan oleh semua sekolah dalam Sistem Pendidikan Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Kurikulum Kebangsaan yang ditetapkan di bawah subseksyen (1) hendaklah menentukan pengetahuan, kemahiran dan nilai yang dijangka akan diperolehi oleh murid-murid pada akhir tempoh persekolahan masing- masing dan hendaklah termasuk mata pelajaran teras yang dinyatakan dalam Jadual dan apa-apa mata pelajaran lain yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal sekolah swasta, subseksyen (1) hendaklah disifatkan telah dipatuhi jika mata pelajaran teras Kurikulum Kebangsaan yang dinyatakan dalam Jadual diajarkan di sekolah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh dari semasa ke semasa melalui perintah yang disiarkan dalam Warta menambah, meminda atau mengubah Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap sekolah hendaklah menyediakan murid-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "muridnya untuk peperiksaan yang ditetapkan oleh atau di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini melainkan jika dikecualikan selainnya oleh atau di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_20",
