        "@value": "di mana kemudahan bagi pengajaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_5__para_d__subpara_i",
