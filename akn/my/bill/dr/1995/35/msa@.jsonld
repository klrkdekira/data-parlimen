      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekolah khas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1__para_c",
