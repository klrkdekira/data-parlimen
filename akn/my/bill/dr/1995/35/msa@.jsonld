      "schema:name": {
        "@language": "ms",
        "@value": "Pendidikan Prasekolah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Larangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_20__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tadika boleh ditubuhkan, dikendalikan atau terhadap diuruskan melainkan jika tadika itu didaftarkan di bawah penubuhan, pengendalian Akta ini. atau pengurusan (2) Seseorang yang melanggar subseksyen (1) adalah tadika. melakukan suatu kesalahan. Kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh tertakluk kepada peruntukan Akta ini Menteri menubuhkan dan menyenggarakan tadika. untuk menubuhkan tadika. Kurikulum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Program dan kegiatan tiap-tiap tadika hendaklah prasekolah. diasaskan pada garis panduan kurikulum untuk tadika yang diluluskan oleh Menteri. Bahasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen 17(1), bahasa-bahasa pengantar di selain daripada bahasa kebangsaan boleh digunakan tadika sebagai bahasa pengantar di tadika, tetapi jika sesuatu tadika menggunakan bahasa selain daripada bahasa kebangsaan, bahasa kebangsaan hendaklah diajarkan sebagai mata pelajaran wajib. Kuasa untuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan untuk membuat melaksanakan peruntukan Bab ini. peraturan berhubungan dengan pendidikan prasekolah. Bab 2 tidak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Bab ini tidaklah terpakai bagi sesuatu terpakai bagi pusat asuhan kanak-kanak yang ditubuhkan dan didaftarkan pusat asuhan kanak-kanak. di bawah mana-mana undang-undang bertulis yang berhubungan dengan pusat sedemikian. Ketakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 18 dan 19 tidaklah terpakai bagi tadika. seksyen 18 dan 19."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendidikan Rendah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah menjadi kewajipan Menteri mengadakan hendaklah pendidikan rendah di sekolah rendah kerajaan dan di mengadakan pendidikan sekolah rendah bantuan kerajaan. rendah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan sekolah kebangsaan dan sekolah jenis kebangsaan dan hendaklah menyenggarakan sekolah- sekolah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Sekolah kebangsaan atau sekolah jenis kebangsaan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang ditubuhkan di bawah Akta ini hendaklah mengadakan kursus pendidikan rendah yang direncanakan bagi tempoh enam tahun tetapi yang boleh tamat diikuti dalam tempoh antara lima hingga tujuh tahun."
      }
    },
