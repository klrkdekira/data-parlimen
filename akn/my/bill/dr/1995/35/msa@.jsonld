      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kajian Tempatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendidikan Islam, bagi murid yang menganut agama Islam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendidikan Moral, bagi murid yang tidak menganut agama Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
