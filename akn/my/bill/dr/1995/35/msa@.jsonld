        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_z",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ab",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ac",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ad",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ae"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan dalam subseksyen (1), Menteri boleh membuat peraturan- peraturan bagi atau berkenaan dengan semua atau mana- mana perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penerimaan masuk murid ke institusi pendidikan, penyimpanan daftar murid di institusi pendidikan itu, had umur dan syarat yang membolehkan murid dikekalkan belajar di dalam sesuatu institusi pendidikan atau di dalam mana-mana kelas di dalam institusi pendidikan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_aa",
      "@type": "akn:paragraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penentuan yuran yang diluluskan yang dikenakan berkenaan dengan kehadiran belajar di institusi pendidikan secara amnya, atau di mana-mana golongan institusi pendidikan bantuan kerajaan dan pembayaran atau peremitan yuran sedemikian; 72 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ab",
      "@type": "akn:paragraph",
      "eli:number": "ab",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara untuk memindahmilikkan meletakhakkan apa-apa harta dipindahmilikkan atau diletakhakkan di bawah Akta ini dan cara mendaftarkan hakmilik mana- mana harta sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ac",
      "@type": "akn:paragraph",
      "eli:number": "ac",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa fee yang disifatkan patut dilevi berkenaan dengan apa-apa perkara yang diperuntukkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ad",
      "@type": "akn:paragraph",
      "eli:number": "ad",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "borang yang boleh digunakan bagi melaksanakan peruntukan Akta ini dan yang boleh digunakan berkaitan dengan apa-apa perkara yang dinyatakan atau yang dikehendaki dalam Akta ini supaya ditetapkan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_ae",
      "@type": "akn:paragraph",
      "eli:number": "ae",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang disifatkan oleh Menteri sebagai suaimanfaat atau perlu bagi melaksanakan mana- mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh penggal institusi pendidikan, hari dan waktu murid hendaklah hadir di institusi pendidikan itu dan hari yang hendaklah dijadikan hari cuti oleh semua institusi pendidikan atau mana-mana institusi pendidikan atau golongan institusi pendidikan yang ditentukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan dan pengurusan institusi pendidikan, dan kewajipan pengelola atau orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bentuk yang mengikutnya daftar bagi pendaftaran institusi pendidikan atau pengelola atau pekerja hendaklah disimpan atau disenggarakan dan prosedur bagi pengeluaran cabutan daripadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti dan fee yang disifatkan patut dikenakan berhubungan dengan sesuatu permohonan bagi pendaftaran di bawah Akta ini, atau berhubungan dengan apa-apa perakuan atau permit atau apa-apa dokumen lain yang dikeluarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti bagi pengubahan atau pemindaan perakuan pendaftaran atau permit yang dikeluarkan di bawah Akta ini dan penggantian perakuan atau permit sedemikian yang hilang atau rosak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disiplin di institusi pendidikan dan apa-apa kegiatan murid, sama ada di dalam atau di luar institusi pendidikan, yang pada pendapat Menteri mungkin mempunyai kesan terhadap disiplin sesuatu institusi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kurikulum Kebangsaan termasuklah mata pelajaran dan perkara, yang bukan pengajian yang berhubungan dengan agama Malaysia, yang mengenainya ajaran boleh atau hendaklah diberikan di institusi pendidikan dan masa yang hendaklah ditumpukan kepada pengajian setiap mata pelajaran yang diajarkan di institusi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan, penyusunan, pengurusan, pengawalan dan pembubaran persatuan murid atau persatuan murid dan guru, atau persatuan guru dan ibu bapa sama ada di dalam atau di luar institusi pendidikan, dan peraturan-peraturan yang dibuat di bawah perenggan ini boleh membuat peruntukan supaya persatuan guru dan ibu bapa sedemikian mengandungi mana-mana orang selain daripada guru atau ibu bapa murid di institusi pendidikan yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "buku, bahan dan radas yang hendaklah digunakan di institusi pendidikan, dan kaedah pembelian buku, bahan dan radas itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "larangan tentang penggunaan di sesuatu institusi pendidikan atau mana-mana golongan institusi yang ditentukan apa-apa buku atau bahan yang penggunaannya didapati tidak diingini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "larangan tentang penggunaan atau penghantarserahan kepada mana-mana murid oleh sesuatu pusat pendidikan jarak jauh atau pembekalan, pengimportan atau penjualan bagi kegunaan atau penghantarserahan oleh sesuatu pusat pendidikan jarak jauh apa-apa bahan, buku, pelajaran, pengajaran atau bahan lain yang bercetak atau bertulis atau selainnya yang penggunaannya oleh sesuatu pusat pendidikan jarak jauh itu didapati tidak diingini; RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penyimpanan buku akaun dan pengauditan akaun di institusi pendidikan yang menerima surnbangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "piawaian, termasuklah piawaian kesihatan dan keselamatan, dan kegunaan untuk premis institusi pendidikan yang perlu dipatuhi, dan penetapan piawaian dan kegunaan yang berlainan bagi apa- apa perihal institusi pendidikan yang ditetapkan dalam peraturan-peraturan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran murid di institusi pendidikan, pemeriksaan daftar murid sedemikian, pengambilan cabutan daripada daftar sedemikian bagi maksud Akta ini oleh orang yang diberikuasa dengan sewajarnya bagi maksud itu di bawah peraturan-peraturan sedemikian, dan pemberian kepada mana-mana pihak berkuasa yang ditetapkan oleh peraturan-peraturan, oleh orang yang dikehendaki menyimpan daftar yang berkenaan, apa-apa laporan berkala atau penyata lain tentang kandungan daftar itu sebagaimana yang suaimanfaat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bentuk yang mengikutnya daftar guru yang disimpan di bawah seksyen 104 hendaklah disimpan atau disenggarakan, dan prosedur bagi pengeluaran salinan yang diperakui tentang butiran-butiran yang terkandung dalam daftar itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti bagi pengendorsan, pengubahan atau pemindaan perakuan pendaftaran sebagai guru yang dikeluarkan di bawah seksyen 109 dan penggantian perakuan atau permit mengajar yang hilang atau rosak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti dan akibat yang akan mengikuti pembatalan perakuan pendaftaran sebagai guru yang dikeluarkan di bawah seksyen 109 atau pembatalan permit mengajar; PENDIDIKAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa fee yang disifatkan patut dikenakan bagi permohonan untuk didaftarkan sebagai guru di bawah, atau apabila dikeluarkan perakuan atau permit mengajar atau selainnya berkenaan dengan apa-apa perkara yang tersebut dalam, Bahagian XI;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "amalan dan prosedur yang hendaklah diikuti berkaitan dengan sesuatu penyiasatan yang dibuat oleh Jawatankuasa Siasatan yang ditubuhkan di bawah subseksyen 126(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_u",
      "@type": "akn:paragraph",
      "eli:number": "u",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara rayuan terhadap keputusan Ketua Pendaftar yang hendaklah dibuat kepada Menteri dan fee yang hendaklah dibayar berkenaan dengan sesuatu rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_v",
      "@type": "akn:paragraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penubuhan, penyusunan, pengurusan, pengawalan dan pembubaran mana-mana majlis, badan atau Jawatankuasa sukan di peringkat institusi pendidikan, daerah, negeri atau kebangsaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_w",
      "@type": "akn:paragraph",
      "eli:number": "w",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "peruntukan bagi pendidikan pengembangan di institusi pendidikan yang ditubuhkan dan disenggarakan oleh Menteri di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_x",
      "@type": "akn:paragraph",
      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pengedaran oleh murid atau murid-murid, sama ada di dalam atau di luar institusi pendidikan apa-apa majalah, risalah atau bahan bercetak atau bertulis yang seumpamanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_y",
      "@type": "akn:paragraph",
      "eli:number": "y",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara menentukan amaun sumbangan bantuan yang kena dibayar kepada institusi pendidikan bantuan kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_z",
      "@type": "akn:paragraph",
      "eli:number": "z",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat dan batasan yang menurutnya atau tertakluk kepadanya sumbangan bantuan atau sumbangan modal hendaklah dibayar kepada institusi pendidikan bantuan kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah Akta ini"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memperuntukkan bahawa pelanggaran mana-mana peruntukan dalam peraturan-peraturan itu adalah suatu kesalahan dan bahawa kesalahan sedemikian boleh dihukum, apabila disabitkan, dengan hukuman denda atau pemenjaraan atau kedua-duanya tetapi tidak boleh membuat peruntukan supaya denda itu melebihi sepuluh ribu ringgit atau tempoh pemenjaraan itu melebihi enam bulan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila rayuan dibuat kepada Menteri terhadap keputusan Ketua Pendaftar, Menteri, melainkan jika dia membenarkan rayuan itu dengan segera, hendaklah membentuk suatu Jawatankuasa Siasatan yang terdiri daripada orang yang difikirkannya layak untuk menyiasat fakta dan mengemukakan laporan tentang fakta itu kepadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan laporan yang dikemukakan di bawah subseksyen (1), Menteri hendaklah memutuskan perkara rayuan itu dan membuat apa-apa perintah tentangnya sebagaimana yang difikirkannya wajar dan patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_126",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri tentang sesuatu rayuan adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 129 dan mana-mana"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "peraturan yang dibuat di bawah Akta ini, Jawatankuasa Siasatan hendaklah mempunyai kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperoleh dan menerima segala keterangan, sama ada bertulis atau lisan, dan memeriksa semua orang (termasuklah perayu) yang difikirkan wajar oleh Jawatankuasa Siasatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki supaya keterangan seseorang diberikan dengan sumpah atau ikrar atau dengan akuan berkanun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memanggil mana-mana orang termasuklah perayu supaya hadir dan memberikan keterangan walau apa pun peruntukan mana-mana undang- undang bertulis yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima apa-apa keterangan bertulis atau lisan, walaupun keterangan itu tidak boleh diterima dalam prosiding sivil atau jenayah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk tidak membenarkan orang awam menyertai apa-apa penyiasatan atau mana-mana bahagiannya dan, jika Jawatankuasa Siasatan berpendapat bahawa adalah demi kepentingan awam untuk berbuat demikian, menerima keterangan tanpa kehadiran perayu; tetapi jika keterangan diterima tanpa kehadiran perayu, Jawatankuasa Siasatan hendaklah memberitahu perayu tentang isi keterangan itu setakat yang bersesuaian dengan kepentingan awam untuk berbuat demikian, dan hendaklah dalam tiap- tiap kes sedemikian memasukkan dalam laporan kepada Menteri suatu kenyataan tentang hal keadaan yang menjadikan keterangan itu telah diterima."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang berlawanan dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana undang-undang bertulis, tiada peguambela atau peguamcara boleh dibenarkan hadir dalam mana- mana prosiding di hadapan Jawatankuasa Siasatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang dikehendaki di memberikan keterangan di hadapan Jawatankuasa Siasatan berkewajipan mendedahkan nama atau alamat mana-mana orang yang telah memberikan maklumat secara sulit kepada pegawai awam berhubungan dengan apa-apa fakta yang menjadi hal perkara penyiasatan dan tidaklah juga mana- mana orang berkewajipan menyatakan apa-apa perkara yang pada pendapatnya mungkin membawa kepada penemuan orang yang telah memberikan maklumat sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XII__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang dikehendaki di bawah seksyen 127 untuk memberikan keterangan berkewajipan memberikan apa-apa keterangan yang mungkin boleh menunjukkan bahawa dia bersalah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV",
      "@type": "akn:part",
      "eli:number": "XIV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KESALAHAN DAN PENALTI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6",
      "@type": "akn:chapter",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_137",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_138",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesalahan boleh tangkap tidak boleh dijalankan oleh Ketua Pendaftar atau pegawai awam yang diberikuasa oleh Ketua Pendaftar bagi maksud itu secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_137",
      "@type": "akn:clause",
      "eli:number": "137",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6",
      "schema:name": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan seksyen 136, jika Ketua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar atau pegawai awam yang diberikuasa oleh Ketua Pengarah bagi maksud itu secara bertulis oleh Ketua Pendaftar atau pegawai polis yang berpangkat tidak rendah daripada Inspektor mempunyai alasan yang munasabah bagi mempercayai bahawa tujuan apa-apa penggeledahan yang hendak dilakukan di mana-mana premis bagi maksud Akta ini mungkin terkecewa oleh sebab apa-apa kelengahan dalam mendapatkan waran geledah di bawah Kanun Prosedur Jenayah, dia boleh, tanpa waran, memasuki mana- mana premis itu bagi rnaksud sedemikian dengan menggunakan hanya apa-apa kekerasan yang perlu supaya dia dapat masuk."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_138",
      "@type": "akn:clause",
      "eli:number": "138",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar atau pegawai awam yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "diberikuasa oleh Ketua Pendaftar bagi maksud itu secara bertulis atau pegawai polis yang berpangkat tidak rendah daripada Inspektor boleh, dengan kebenaran bertulis Pendakwa Raya, memulakan dan menjalankan pendakwaan berkenaan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139",
      "@type": "akn:clause",
      "eli:number": "139",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, dalam sesuatu hal apabila difikirkannya layak dan patut untuk berbuat demikian, dan dengan kebenaran bertulis Pendakwa Raya, mengkompaunkan apa-apa kesalahan yang dilakukan oleh seseorang yang boleh dihukum di bawah Akta ini, kecuali suatu kesalahan di bawah seksyen 72 dan subseksyen 132(1), atau mana-mana peraturan yang dibuat di bawah Akta ini dengan membuat suatu tawaran bertulis kepada orang itu untuk mengkompaunkan kesalahan itu apabila dibayar kepada Ketua Pendaftar dalam masa yang ditentukan dalam tawaran itu, apa-apa jumlah wang, yang boleh ditentukan sedemikian, yang tidak boleh melebihi lima puluh peratus daripada amaun denda maksimum yang boleh dikenakan kepada orang itu sekiranya dia telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya telah dimulakan, dan jika amaun yang ditentukan dalam tawaran itu tidak dibayar dalam masa yang ditentukan dalam tawaran itu, atau dalam apa-apa tempoh lanjutan yang dibenarkan oleh Ketua Pendaftar, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu telah dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaunkan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pendakwaan boleh dibuat selepas itu berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran mengkompaunkan itu telah dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang, benda atau artikel lain yang disita berkaitan dengan kesalahan itu hendaklah dilepaskan dengan serta-merta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__chp_6__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa wang yang dibayar kepada Ketua Pendaftar menurut subseksyen (1) hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang, sebagai pengerusi lembaga pengelola atau mana-mana orang lain yang dengan bertanggungjawab tentang pengurusan sesuatu institusi pendidikan, yang membuat pernyataan yang palsu atau mengelirukan dalam mempromosikan institusi pendidikan itu adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua- duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila membuat permohonan di bawah Akta ini bagi pendaftaran sesuatu institusi pendidikan, atau bagi pendaftaran sebagai pengelola atau pekerja, atau selainnya bagi maksud mendorong Ketua Pendaftar untuk menjalankan atau tidak menjalankan kuasanya di bawah Akta ini, membuat apa-apa pernyataan yang dia ketahui adalah palsu atau yang dia tidak percaya adalah benar atau dengan sengaja mendiamkan apa- apa fakta material, atau memberikan apa-apa maklumat yang mengelirukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menghalang atau menggendalakan Ketua Pendaftar, pegawai awam atau pegawai polis dalam menjalankan kuasa yang diberikan kepada pegawai itu di bawah seksyen 100, 101 atau 102;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan mengemukakan apa-apa buku, dokumen atau barang, atau enggan memberikan maklumat dengan melanggar subseksyen 100(2) atau memberikan apa-apa maklumat yang dia tahu adalah palsu atau yang dia tidak percaya adalah benar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengerusi lembaga pengelola sesuatu institusi pendidikan melanggar subseksyen 94(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai seorang yang hendaklah didaftarkan sebagai pengelola atau pekerja di bawah seksyen 88 bertindak sebagai pengelola atau pekerja tanpa didaftarkan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengelola atau orang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan menyebabkan atau membenarkan mana-mana orang bertindak sebagai pengelola atau seorang yang bertanggungjawab tentang pengurusan, atau sebagai pekerja institusi pendidikan itu tanpa didaftarkan di bawah Akta ini; RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai pengelola atau pekerja di institusi pendidikan yang tidak didaftarkan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengerusi lembaga pengelola atau pengelola atau seseorang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan telah tidak menghalang institusi pendidikan itu digunakan bagi apa-apa kegiatan atau maksud yang menyalahi undang-undang, atau bagi apa- apa kegiatan atau maksud sesuatu organisasi, pertubuhan atau kumpulan orang yang lain yang menyalahi undang-undang, adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengerusi lembaga pengelola atau sebagai orang yang bertanggungjawab tentang pengurusan sesuatu institusi pendidikan tidak menyebabkan salinan perakuan pendaftaran institusi pendidikan itu dipamerkan mengikut subseksyen 82(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menyerahkan balik kepada Ketua Pendaftar mana-mana perakuan pendaftaran atau suratcara pengelolaan di bawah subseksyen 87(5) atau 97(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengerusi lembaga pengelola sesuatu institusi pendidikan melanggar subseksyen 94(1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_132__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai tuan punya atau penghuni mana-mana premis dan mempunyai sebab yang munasabah untuk mempercayai bahawa premis itu atau sebahagian daripadanya digunakan sebagai institusi pendidikan yang dikehendaki didaftarkan di bawah Akta ini tetapi tidak berdaftar sedemikian, tidak mengambil langkah yang munasabah untuk menghalang penggunaan sedemikian, adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, semasa membuat permohonan untuk didaftarkan sebagai guru atau selainnya bagi maksud mendorong Ketua Pendaftar menjalankan atau tidak menjalankan kuasanya di bawah Akta ini, membuat apa- apa pernyataan yang dia ketahui adalah palsu atau yang dia tidak percaya adalah benar atau dengan sengaja mendiamkan apa-apa fakta yang material atau memberikan apa-apa maklumat yang mengelirukan adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua- duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai guru di sesuatu institusi pendidikan dengan melanggar subseksyen 103(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan, membenarkan atau mengambil kerja seseorang untuk bertindak sebagai guru dengan melanggar subseksyen 103(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai guru di suatu institusi pendidikan yang tidak berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai guru berdaftar mengajar di suatu institusi pendidikan dengan melanggar mana-mana syarat yang dikenakan di bawah subseksyen 109(2) atau sebagai pemegang permit mengajar yang dikeluarkan di bawah seksyen 114, mengajar di suatu institusi pendidikan dengan melanggar mana-mana syarat yang dikenakan oleh permit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan, membenarkan atau mengambil kerja seseorang guru berdaftar untuk mengajar di suatu institusi pendidikan dengan melanggar mana-mana syarat yang berhubungan dengan guru itu yang dikenakan di bawah seksyen 109 atau menyebabkan, membenarkan atau mengambil kerja pemegang permit mengajar yang dikeluarkan di bawah seksyen 114 untuk mengajar selain daripada mengikut syarat yang dikenakan oleh permit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menyerahkan balik perakuan, dokumen atau permit mengikut seksyen 115; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai guru berdaftar tidak membuat laporan kepada Ketua Pendaftar mengikut seksyen 116, boleh, apabila disabitkan atas suatu kesalahan di bawah perenggan (b) atau (e), didenda tidak melebihi sepuluh ribu ringgit dan boleh, apabila disabitkan atas suatu kesalahan di bawah perenggan (a), (c), (d), (f) atau (g), didenda tidak melebihi lima ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134",
      "schema:text": {
        "@language": "ms",
        "@value": "menghalang atau menggendalakan Ketua Nazir atau Nazir Sekolah dalam menjalankan mana- mana kuasa yang diberikan kepadanya oleh seksyen 121;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan mengemukakan mana-mana jadual waktu, sukatan pelajaran, rekod, buku, bahan, dokumen atau barang, atau enggan memberikan maklumat, dengan melanggar subperenggan 121(b)(ii); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_134",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan apa-apa maklumat yang palsu dalam apa-apa perkara yang material atau yang dia tahu adalah palsu atau yang dia tidak percayai adalah benar, adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan kesalahan di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_135",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah Akta ini boleh, dalam hal suatu kesalahan yang berterusan, apabila disabitkan, dikenakan hukuman denda harian yang tidak melebihi lima ratus ringgit sebagai tambahan kepada apa-apa penalti lain yang boleh dikenakan kepadanya di bawah Akta ini berkenaan dengan kesalahan itu, bagi setiap hari kesalahan itu terus dilakukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136",
      "@type": "akn:clause",
      "eli:number": "136",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar atau pegawai awam yang diberikuasa bagi maksud itu secara bertulis oleh Ketua Pendaftar atau pegawai polis yang berpangkat tidak rendah daripada Inspektor hendaklah mempunyai kuasa untuk menyiasat pelakuan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIV__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar atau pegawai awam yang diberikuasa bagi maksud itu secara bertulis oleh Ketua Pendaftar atau pegawai polis yang berpangkat tidak rendah daripada Inspektor boleh, berhubungan dengan apa-apa penyiasatan berkenaan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini, menjalankan kuasa khas berhubungan dengan penyiasatan polis kecuali bahawa kuasa menangkap tanpa waran yang diberikan oleh Kanun Prosedur Jenayah dalam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Kecuali setakat wang diluluskan atau diperuntukkan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud itu oleh Parlimen atau selainnya, tiada apa- apa jua dalam Akta ini boleh disifatkan sebagai mengenakan apa- apa kewajipan kepada Menteri untuk menubuhkan dan menyenggarakan suatu institusi pendidikan di bawah Akta ini atau untuk menyenggarakan keseluruhan atau sebahagian daripada suatu institusi pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa sumbangan bantuan atau sumbangan modal"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang boleh dibayar di bawah Akta ini kepada sesuatu institusi pendidikan, selain daripada institusi pendidikan kerajaan, daripada wang yang diperuntukkan oleh Parlimen bagi maksud itu hendaklah dibayar tertakluk kepada apa- apa syarat dan batasan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh menggantung atau mengkensel atau"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan digantung atau dikensel pembayaran apa- apa sumbangan kepada sesuatu institusi pendidikan jika pengelola atau mana-mana orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan itu telah tidak mematuhi mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV",
      "@type": "akn:part",
      "eli:number": "XV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XV__cl_140",
