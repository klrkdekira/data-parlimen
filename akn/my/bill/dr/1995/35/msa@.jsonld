      "schema:name": {
        "@language": "ms",
        "@value": "Am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud membuat pemeriksaan ke atas institusi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan di bawah seksyen 117 Ketua Nazir atau Nazir Sekolah (dalam seksyen ini disebut \"Nazir\") boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "pada bila-bila masa memasuki sesuatu institusi pendidikan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengerusi lembaga pengelola atau pengelola atau mana-mana orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan itu atau guru atau pekerja atau orang yang ditemui di institusi pendidikan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan bagi pemeriksaannya mana-mana jadual waktu, sukatan pelajaran atau rekod yang berkaitan dengan mata pelajaran yang diajarkan atau yang akan diajarkan atau apa-apa buku, bahan, dokumen atau barang yang berhubungan dengan atau yang pada pendapat Nazir itu mungkin ada hubungan dengan pengajaran yang dijalankan di institusi pendidikan itu atau dengan pengurusan institusi pendidikan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_121__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan Nazir itu apa-apa maklumat yang berhubungan dengan pengajaran di, atau pengelolaan, institusi pendidikan itu yang diminta oleh Nazir itu, dan yang pengerusi, pengelola, atau orang lain yang bertanggungjawab tentang pengurusan institusi pendidikan itu, guru, pekerja atau orang itu mempunyai kuasa untuk memberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_X__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Nazir boleh secara bertulis memberikuasa"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Pendidikan yang dilantik di bawah seksyen 4 untuk bertindak bagi pihaknya dalam penjalanan kuasa- kuasanya atau pelaksanaan kewajipan-kewajipannya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
