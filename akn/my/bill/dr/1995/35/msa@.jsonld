      "schema:text": {
        "@language": "ms",
        "@value": "sekolah menengah teknik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_4__cl_30__para_c",
      "@type": "akn:paragraph",
