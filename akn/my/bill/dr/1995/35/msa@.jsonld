      "schema:text": {
        "@language": "ms",
        "@value": "yang menyediakan pendidikan rendah yang sesuai bagi murid dari umur enam tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
