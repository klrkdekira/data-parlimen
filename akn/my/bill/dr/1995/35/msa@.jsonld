        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan dan menyenggarakan mana-mana sekolah yang diperihalkan dalam seksyen 30."
