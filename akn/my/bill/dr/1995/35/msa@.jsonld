      "schema:text": {
        "@language": "ms",
        "@value": "MAJLIS PENASIHAT PENDIDIKAN KEBANGSAAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka bolehlah ditubuhkan bagi maksud Akta ini Majlis Penasihat Pendidikan Kebangsaan,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Penasihat Pendidikan Kebangsaan hendaklah terdiri daripada seorang pengerusi dan orang lain yang dilantik oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peraturan- peraturan yang dibuat di bawah Bahagian ini, setiap anggota Majlis Penasihat Pendidikan Kebangsaan hendaklah memegang jawatan selama tempoh dan tertakluk kepada apa-apa syarat yang ditentukan dalam surat perlantikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perlantikan yang dibuat di bawah seksyen ini hendaklah disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh merujukkan apa-apa perkara berhubungan dengan pendidikan kepada Majlis Penasihat Pendidikan Kebangsaan untuk mendapatkan nasihatnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Penasihat Pendidikan Kebangsaan hendaklah, apabila apa-apa perkara dirujukkan kepadanya di bawah subseksyen (1), menimbangkan perkara itu dan mengemukakan nasihatnya kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh menghadiri, dan boleh menamakan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "wakil untuk menghadiri, mana-mana mesyuarat Majlis Penasihat Pendidikan Kebangsaan. Kuasa untuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi membuat maksud melaksanakan peruntukan Bahagian ini, dan, tanpa peraturan menjejaskan keluasan kuasa itu, boleh melalui peraturan- berhubungan dengan peraturan sedemikian membuat peruntukan tentang— Majlis Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "bilangan anggota Majlis; Pendidikan Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "terma dan syarat jawatan anggota;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "mesyuarat dan prosedur Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "perlantikan jawatankuasa dan jawatankuasa kecil Majlis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan perlu oleh Menteri bagi Majlis berfungsi dengan sepatutnya. Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan mana-mana peraturan Penasihat yang dibuat di bawah Akta ini, Majlis Penasihat Pendidikan Pendidikan Kebangsaan Kebangsaan boleh mengawalselia prosedurnya sendiri. boleh mengawalselia prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada seorang Ketua Pengarah Pendidikan yang hendaklah dilantik oleh Yang di-Pertuan Agong daripada kalangan pegawai dalam Perkhidmatan Pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mempunyai kuasa dan menjalankan fungsi yang diberikan kepadanya oleh Akta ini, dan hendaklah menasihati Menteri tentang hal yang berkaitan dengan pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah ada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi setiap Negeri atau bagi mana-mana kawasan lain di dalam Malaysia yang ditentukan oleh Menteri, seorang Pengarah Pendidikan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi setiap daerah atau bagi mana-mana kawasan lain di dalam sesuatu Negeri yang ditentukan oleh Menteri, seorang Pegawai Pendidikan yang dinamakan sedemikian bagi maksud Akta ini, yang hendaklah dilantik oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada seorang Ketua Pendaftar Sekolah dan Guru yang hendaklah dilantik oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik seorang Timbalan Ketua Pendaftar Sekolah dan Guru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Pendaftar Sekolah dan Guru bagi setiap Negeri, dan boleh melantik apa-apa bilangan Penolong Pendaftar Sekolah dan Penolong Pendaftar Guru yang difikirkan perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Ketua Pendaftar, Pendaftar, dan Penolong Pendaftar hendaklah di bawah arahan dan kawalan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah mempunyai kuasa dan menjalankan fungsi yang diberikan kepadanya oleh Akta ini, dan sewaktu ketiadaannya kuasa dan fungsi sedemikian bolehlah dipunyai atau dijalankan oleh Timbalan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar atau Penolong Pendaftar boleh menjalankan semua kuasa dan fungsi yang diberikan kepada Ketua Pendaftar oleh atau di bawah Akta ini, tertakluk kepada apa-apa sekatan yang boleh dikenakan oleh Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Ketua Nazir Sekolah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik Nazir-Nazir Sekolah lain yang difikirkan perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua Nazir Sekolah yang dilantik di bawah subseksyen (2) hendaklah tertakluk kepada arahan dan kawalan Ketua Nazir Sekolah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Pengarah Peperiksaan dan boleh melantik pegawai-pegawai lain untuk bertindak di bawah arahan dan kawalan am Pengarah Peperiksaan yang difikirkannya perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengarah Peperiksaan hendaklah, tertakluk kepada mana-mana peraturan yang dibuat di bawah seksyen 68, bertanggungjawab atas pengendalian peperiksaan bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh dari semasa ke semasa memberi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai yang dilantik di bawah Bahagian ini arahan-arahan yang bersifat am, dan tidak tak konsisten dengan peruntukan Akta ini, tentang penjalanan kuasa dan budi bicara yang diberikan kepada pegawai itu oleh, dan kewajipan-kewajipan yang perlu ditunaikan oleh pegawai itu di bawah, Akta ini dan peraturan-peraturan yang dibuat di bawah Akta ini, berhubungan dengan segala hal yang didapati oleh Menteri menyentuh Dasar Pendidikan Kebangsaan, dan pegawai itu hendaklah melaksanakan tiap-tiap arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh dari semasa ke semasa memberi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "pengelola atau mana-mana anggota suatu lembaga yang dilantik di bawah subseksyen 61(1), atau pekerja atau guru besar, sesuatu institusi pendidikan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Lembaga Pusat yang ditubuhkan di bawah seksyen 92 Akta Pelajaran 1961, arahan-arahan, yang tidak tak konsisten dengan peruntukan Akta ini dan peraturan-peraturan yang dibuat di bawah Akta ini, berhubungan dengan apa-apa perkara yang berkenaan dengannya peraturan-peraturan boleh dibuat di bawah Akta ini, dan pengelola, anggota, pekerja atau guru besar itu hendaklah melaksanakan tiap-tiap arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV",
