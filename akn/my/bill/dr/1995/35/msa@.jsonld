        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_XIII__cl_130__subsec_2__para_w",
