      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_6__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maktab, selain daripada maktab yang bertaraf universiti atau kolej universiti yang ditubuhkan atau disifatkan telah ditubuhkan di bawah Akta Universiti dan Kolej Universiti 1971;"
      }
    },
