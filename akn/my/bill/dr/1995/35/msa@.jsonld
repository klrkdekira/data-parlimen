      "schema:text": {
        "@language": "ms",
        "@value": "sekolah menengah daripada apa-apa perihal lain yang ditentukan oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_IV__chp_4__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
