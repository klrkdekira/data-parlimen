      "schema:name": {
        "@language": "ms",
        "@value": "Mata pelajaran teras pada peringkat sekolah rendah ialah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahasa Kebangsaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahasa Inggeris;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahasa Cina, bagi murid di sekolah jenis kebangsaan (Cina);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahasa Tamil, bagi murid di sekolah jenis kebangsaan (Tamil);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_e",
