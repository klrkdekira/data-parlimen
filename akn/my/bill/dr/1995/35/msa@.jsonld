      "schema:text": {
        "@language": "ms",
        "@value": "Matematik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~sched_1__para_2__para_f",
      "@type": "akn:paragraph",
