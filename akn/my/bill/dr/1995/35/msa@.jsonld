      "schema:text": {
        "@language": "ms",
        "@value": "yang menggunakan bahasa Cina atau Tamil sebagai bahasa pengantar utama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/35/msa@/~part_I__cl_2__list_4__para_c",
