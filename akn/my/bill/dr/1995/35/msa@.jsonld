      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh mengadakan kelas peralihan di mana-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana sekolah menengah kebangsaan akademik."
      }
    },
