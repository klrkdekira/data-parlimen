    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "There is hereby established, for the purposes of this Act, a fund to be administered and controlled by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided from time to time for the purposes of this Act by Parliament;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums borrowed by the Authority for the purposes of meeting any of its obligations or discharging any of its duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "levies payable under section 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fees, costs or other charges imposed by the Authority under laws relating to offshore financial services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any compound paid under laws relating to offshore financial services; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other sums or property which may in any manner become payable to or vested in the Authority in respect of any matter incidental to its functions and powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Fund shall be expended for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Authority, including legal fees and costs and other fees and costs, and the remuneration of officers and servants of the Authority, including the granting of loans, superannuation allowances or gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs or expenditure properly incurred or accepted by the Authority in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other materials, acquiring land and erecting AUTHORITY buildings, and carrying out any other works and undertakings in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under this Act and the interest due thereon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "It shall be the duty of the Authority to conserve the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Fund by so performing its functions and exercising its powers under this Act as to secure that the total revenues of the Authority are sufficient to meet all sums properly chargeable to its revenue account including depreciation and interest on capital taking one year with another."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "An offshore financial institution shall be liable, in the case of any offshore financial service provided by it, to pay a levy to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the Minister may, by order published in the Gazette, specify such rates of levy as is necessary to meet the administrative and operating costs of the Authority; and different rates may be specified in respect of different classes of offshore financial services."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The amount of any levy payable under this section shall be recoverable as a civil debt due to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations providing for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of levies under this section;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_32__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "subject to the provisions relating to secrecy under any written law relating to offshore financial institutions, the keeping, examination and audit of the accounts of the offshore financial institutions relating to the collection of such levies. 22 BILL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/eng@/~part_III__cl_33",
      "@type": "akn:clause",
