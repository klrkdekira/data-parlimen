      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dengan ini ditubuhkan, bagi maksud Akta ini, suatu kumpulan wang yang hendaklah ditadbirkan dan dikawal oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang diperuntukkan dari semasa ke semasa bagi maksud Akta ini oleh Parlimen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jumlah wang yang dipinjam oleh Lembaga bagi maksud memenuhi mana-mana obligasinya atau menunaikan mana-mana kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "levi yang kena dibayar di bawah seksyen 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "fee, kos atau caj lain yang dikenakan oleh Lembaga di bawah undang-undang berhubungan dengan perkhidmatan kewangan luar pesisir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kompaun yang dibayar di bawah undang- undang berhubungan dengan perkhidmatan kewangan luar pesisir; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "segala jumlah wang atau harta lain yang mungkin dengan apa-apa cara menjadi kena dibayar kepada atau terletakhak pada Lembaga berkenaan dengan apa-apa perkara yang bersampingan dengan fungsi dan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan dengan sah oleh Lembaga, termasuk fee dan kos guaman dan fee dan kos yang lain, dan saraan pegawai dan pengkhidmat Lembaga, termasuk pemberian pinjaman, elaun persaraan atau ganjaran; LUAR PESISIR LABUAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos atau perbelanjaan lain yang dilakukan atau disetujuterima dengan sepatutnya oleh Lembaga dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan, jentera dan apa-apa bahan lain, memperoleh tanah dan mendirikan bangunan, dan menjalankan apa-apa kerja dan pengusahaan lain dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik apa-apa wang yang dipinjam di bawah Akta ini dan bunga yang kena dibayar atasnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya, membayar apa-apa perbelanjaan bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka adalah menjadi kewajipan Lembaga memelihara"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini dengan sedemikian cara supaya pasti bahawa jumlah hasil Lembaga cukup untuk membayar semua jumlah wang yang dipertanggungkan sepatutnya kepada akaun hasilnya termasuk susut nilai dan bunga atas modal, dari setahun ke setahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu institusi kewangan luar pesisir adalah bertanggungan, dalam hal mana-mana perkhidmatan kewangan luar pesisir yang diadakan olehnya, membayar suatu levi kepada Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), Menteri boleh, melalui perintah yang disiarkan dalam Warta, menentukan apa-apa kadar levi sebagaimana yang perlu untuk membayar kos pentadbiran dan pengendalian Lembaga; dan kadar yang berlainan boleh ditentukan berkenaan dengan kelas berlainan perkhidmatan kewangan luar pesisir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Amaun apa-apa levi yang kena dibayar di bawah seksyen ini bolehlah didapatkan sebagai hutang sivil yang kena dibayar kepada Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran levi di bawah seksyen ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_32__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada peruntukan berhubungan dengan kerahsiaan di bawah mana-mana undang-undang bertulis berhubungan dengan institusi kewangan luar pesisir, penyimpanan, pemeriksaan dan pengauditan akaun institusi kewangan luar pesisir berhubungan dengan pemungutan levi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menyebabkan disimpan akaun yang sepatutnya bagi Kumpulan Wang dan laporan yang sepatutnya mengenai aktivitinya dan hendaklah, dengan seberapa segera yang praktik selepas berakhirnya setiap tahun kewangan, menyebabkan disediakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu penyata akaun Lembaga yang hendaklah mengandungi kunci kira-kira dan akaun pendapatan dan perbelanjaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "peryataan mengenai aktivitinya, bagi tahun kewangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah dengan seberapa segera yang mungkin menghantar suatu salinan penyata akaun yang diperakui oleh juruaudit dan suatu salinan laporan juruaudit kepada Menteri yang hendaklah menyebabkannya dibentangkan di hadapan kedua-kedua Majlis Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 hendaklah terpakai bagi Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh dari semasa ke semasa, dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kelulusan Menteri, meminjam, pada apa-apa kadar bunga dan bagi apa-apa tempoh dan atas apa-apa terma tentang masa dan kaedah pembayaran balik dan selainnya LUAR PESISIR LABUAN sebagaimana yang diluluskan oleh Menteri, apa-apa jumlah wang yang diperlukan oleh Lembaga bagi memenuhi mana- mana obligasinya atau bagi melaksanakan mana-mana fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang Lembaga hendaklah, setakat yang ia tidak dikehendaki untuk dibelanjakan oleh Lembaga di bawah Akta ini, dilaburkan mengikut apa-apa cara yang difikirkan patut oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__chp_45",
      "@type": "akn:chapter",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan kelulusan Menteri,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menentukan prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh mengundang mana-mana orang untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menghadiri mana-mana mesyuarat atau pertimbangtelitian Lembaga bagi maksud menasihatinya mengenai apa-apa perkara yang dibincangkan, tetapi mana-mana orang yang hadir sedemikian tidaklah mempunyai hak mengundi pada mesyuarat atau pertimbangtelitian itu,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Anggota Lembaga atau mana-mana orang yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "diundang untuk menghadiri mana-mana mesyuarat atau pertimbangtelitian Lembaga di bawah seksyen 11 boleh dibayar apa-apa saraan atau elaun yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai suatu meterai biasa dan meterai itu boleh dari semasa ke semasa dipecahkan, ditukar, diubah dan dibuat baharu sebagaimana yang difikirkan patut oleh Lembaga. 10 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu meterai diadakan oleh Lembaga, suatu cap yang mengandungi perkataan \"Lembaga Perkhidmatan Kewangan Luar Pesisir Labuan\" boleh digunakan dan hendaklah disifatkan sebagai meterai biasa Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa itu hendaklah disimpan dalam jagaan Pengerusi atau mana-mana orang lain yang diberikuasa oleh Lembaga, dan hendaklah disahkan sama ada oleh Pengerusi atau oleh orang yang diberikuasa itu atau oleh mana-mana pegawai yang diberikuasa oleh Pengerusi secara bertulis; dan semua suratikatan, dokumen dan suratcara lain yang berupa sebagai dimeteraikan dengan meterai tersebut, disahkan sebagaimana yang disebut terdahulu, hendaklah disifatkan telah disempurnakan dengan sah sehingga dibuktikan sebaliknya: Dengan syarat bahawa apa-apa dokumen atau suratcara yang, jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan, tidak akan dikehendaki dimeteraikan boleh disempurnakan oleh Lembaga mengikut cara yang serupa, dan mana-mana dokumen atau suratcara itu boleh disempurnakan bagi pihak Lembaga oleh mana- mana pegawai atau pengkhidmat Lembaga yang diberikuasa secara am atau khusus oleh Lembaga bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa Lembaga hendaklah diberikan pengiktirafan kehakiman bagi semua maksud rasmi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mewakilkan mana-mana fungsi atau kuasanya kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana jawatankuasa yang ditubuhkan oleh Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai atau pengkhidmat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah seksyen ini menghalang Lembaga sendiri daripada melaksanakan atau menjalankan mana-mana fungsi atau kuasa yang diwakilkan sedemikian pada bila-bila masa. LEMBAGA PERKHIDMATAN KEWANGAN LUAR PESISIR LABUAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menubuhkan apa-apa jawatan- kuasa yang difikirkannya perlu atau suaimanfaat untuk membantunya dalam melaksanakan fungsi-fungsinya di bawah Akta ini,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik mana-mana orang untuk menjadi anggota mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa yang ditubuhkan di bawah seksyen ini boleh memilih mana-mana anggotanya menjadi pengerusi dan boleh mengawalselia prosedurnya sendiri dan, pada menjalankan kuasanya di bawah subseksyen ini, jawatankuasa itu adalah tertakluk kepada dan hendaklah bertindak mengikut apa-apa arahan yang diberikan kepada jawatankuasa oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat sesuatu jawatankuasa yang ditubuhkan di bawah seksyen ini hendaklah diadakan pada bila-bila masa dan di mana-mana tempat yang ditentukan oleh pengerusi, tertakluk kepada subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengundang mana- mana orang, bagi maksud menasihatinya mengenai apa- apa perkara yang dibincangkan, untuk menghadiri mana- mana mesyuarat jawatankuasa itu tetapi orang yang diundang sedemikian tidaklah berhak mengundi pada mana-mana mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota jawatankuasa atau mana-mana orang yang diundang menghadiri mana-mana mesyuarat sesuatu jawatankuasa boleh dibayar apa-apa elaun dan perbelanjaan lain sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota sesuatu jawatankuasa hendaklah memegang jawatan bagi apa-apa tempoh yang dinyatakan dalam surat perlantikannya dan adalah layak dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan perlantikan mana- mana anggota sesuatu jawatankuasa tanpa memberikan apa-apa sebab baginya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota sesuatu jawatankuasa boleh pada bila- bila masa meletakkan jawatan dengan memberikan notis bertulis kepada Pengerusi Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga atau sesuatu jawatankuasa hendaklah menyebabkan minit semua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa minit yang dibuat mengenai mesyuarat Lembaga atau sesuatu jawatankuasa, jika ditandatangani sewajarnya, hendaklah, dalam mana-mana prosiding undang-undang, boleh diterima sebagai keterangan prima facie mengenai fakta yang dinyatakan dalamnya dan tiap- tiap mesyuarat Lembaga atau sesuatu jawatankuasa berkenaan dengan prosiding yang mengenainya minit telah dibuat sedemikian hendaklah disifatkan telah dipanggil dan diadakan sewajarnya dan semua anggota pada mesyuarat itu adalah layak sewajarnya untuk bertindak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Lembaga atau sesuatu jawatankuasa yang mempunyai atau memperolehi secara langsung atau tak langsung, sendiri, atau melalui isterinya atau suaminya atau anaknya, atau pekongsinya atau ejennya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa syer atau kepentingan dalam mana-mana institusi kewangan luar pesisir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa syer atau kepentingan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa kontrak yang dibuat dengan Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa kerja yang dilakukan untuk Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana syarikat atau firma yang dengannya Lembaga bercadang hendak membuat kontrak berkenaan dengan apa- apa pengusahaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan benefisial mengenai tanah yang dicadangkan hendak diperoleh, dibeli, dipajakkan atau diurusniagakan selainnya oleh LEMBAGA PERKHIDMATAN KEWANGAN LUAR PESISIR LABUAN Lembaga, yang diketahuinya akan tersentuh atau mungkin akan tersentuh oleh mana-mana projek, skim atau perusahaan yang diluluskan atau dicadangkan hendak diluluskan oleh Lembaga, hendaklah mengisytiharkan jenis dan takat syer atau kepentingannya kepada Lembaga atau jawatankuasa itu, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (7), perisytiharan yang dikehendaki dibuat oleh seseorang anggota di bawah subseksyen (1) hendaklah dibuat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan (1)(a), pada mesyuarat yang pertama Lembaga atau jawatankuasa yang diadakan selepas dia memperolehi syer atau kepentingan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan (1)(b) dan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pada mesyuarat Lembaga jawatankuasa yang dalamnya apa-apa soal berhubungan dengan pemerolehan, pembelian, pemajakan, urusniaga, projek atau skim yang disebut dalam perenggan itu mula-mula dipertimbangkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika anggota itu tidak mempunyai apa- apa syer atau kepentingan sebagaimana yang disebut dalam subperenggan (i) pada tarikh mesyuarat yang disebut dalam subperenggan itu, pada mesyuarat sedemikian yang berikutnya yang diadakan selepas dia memperolehi syer atau kepentingan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang anggota memperolehi apa- apa syer atau kepentingan dalam apa-apa kontrak dengan Lembaga selepas kontrak itu dibuat, pada mesyuarat yang pertama yang diadakan selepas anggota itu memperolehi syer atau kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, suatu notis am yang diberikan kepada anggota lain oleh seseorang anggota yang bermaksud bahawa dia ialah pemegang syer atau pengarah mana-mana syarikat atau firma yang tertentu dan hendaklah dikira mempunyai kepentingan dalam apa- apa kontrak yang mungkin, selepas tarikh notis itu, dibuat dengan atau oleh syarikat atau firma itu, hendaklah disifatkan sebagai perisytiharan yang mencukupi tentang kepentingan berhubungan dengan apa-apa kontrak yang dibuat sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis yang diberikan di bawah subseksyen (3) tidaklah mempunyai kuatkuasa melainkan jika ia diberikan pada mesyuarat Lembaga atau jawatankuasa, mengikut mana-mana yang berkenaan, atau anggota yang berkenaan mengambil langkah-langkah yang munasabah untuk memastikan bahawa notis itu dikemukakan dan dibaca pada mesyuarat Lembaga atau jawatankuasa yang berikutnya selepas notis itu diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap perisytiharan yang dibuat menurut subseksyen (1) hendaklah direkodkan dalam minit mesyuarat yang padanya perisytiharan itu dibuat atau dibaca."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun anggota Lembaga atau jawatankuasa boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil bahagian dalam pertimbangtelitian (kecuali dengan undangan Lembaga atau jawatankuasa, mengikut mana- mana yang berkenaan) mengenai apa-apa perkara yang menyentuh mana-mana institusi kewangan luar pesisir yang dalamnya dia mempunyai apa- apa syer atau kepentingan, sama ada atau tidak dia sudah mengisytiharkan syer atau kepentingannya itu, atau dalam apa-apa keputusan yang berhubungan dengannya atau dalam apa-apa perkara yang bersampingan dengannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mengundi atas apa-apa ketetapan atau soal yang berhubungan dengan apa-apa kontrak, pemerolehan, pembelian, pajakan, urusniaga, projek atau skim yang dalamnya dia mempunyai LEMBAGA PERKHIDTMATAN KEWANGAN LUAR PESISIR LABUAN apa-apa syer atau kepentingan, sama ada atau tidak dia sudah mengisytiharkan syer atau kepentingannya itu, atau mengambil bahagian dalam apa-apa pertimbangtelitian (kecuali dengan undangan Lembaga atau jawatankuasa, mengikut mana-mana yang berkenaan) atau apa-apa keputusan yang berhubungan dengannya atau apa-apa perkara yang bersampingan dengannya, dan jika dia berbuat sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "undinya tidak boleh dikira; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak boleh dikira dalam kuorum yang hadir pada mesyuarat mengenai pertimbangtelitian, ketetapan atau soal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota yang, sebelum perlantikannya sebagai anggota Lembaga atau sesuatu jawatankuasa, sudah memperolehi syer atau kepentingan yang disebut dalam subseksyen (1) hendaklah mengisytiharkan jenis dan takat syer atau kepentingannya itu kepada Lembaga atau jawatankuasa sebaik sahaja dia dilantik melalui notis am yang hendaklah diberikan kepada Lembaga atau jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Lembaga atau sesuatu jawatankuasa yang tidak mendedahkan syer atau kepentingannya sebagaimana yang diperuntukkan di bawah seksyen ini adalah melakukan suatu kesalahan dan apabila disabitkan bolehlah didenda tidak melebihi dua ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, dari semasa ke semasa, mengambil kerja orang yang hendaklah dibayar apa-apa saraan dan elaun dan orang itu hendaklah diambil kerja atas apa-apa terma dan syarat lain yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membuat perkiraan bagi pembayaran kepada pegawai dan pengkhidmatnya serta orang tanggungan mereka apa-apa faedah persaraan, gratuiti atau elaun lain sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga boleh memberikan pinjaman dan membuat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "pendahuluan kepada pegawai dan pengkhidmatnya atas apa-apa terma dan syarat yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai kuasa tatatertib ke atas semua pegawai dan pengkhidmatnya dan hendaklah menjalankan kawalan tatatertib berkenaan dengan semua orang sedemikian mengikut Akta ini dan mana-mana peraturan yang dibuat di bawah seksyen 22."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maka hendaklah ditubuhkan suatu jawatankuasa tatatertib Lembaga berkenaan dengan Ketua Pengarah yang terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Lembaga, yang hendaklah menjadi pengerusi jawatankuasa itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya dua anggota Lembaga, tidak termasuk Ketua Pengarah, yang ditentukan daripada kalangan anggota itu sendiri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, melalui pemberitahuan dalam Warta, menubuhkan jawatankuasa tatatertib yang berlainan bagi kategori berlainan pegawai atau pengkhidmat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang berikut hendaklah terpakai bagi mana-mana jawatankuasa tatatertib yang ditubuhkan menurut perenggan (2)(b):"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatankuasa itu hendaklah terdiri daripada apa- apa bilangan anggota Lembaga, selain daripada Pengerusi Lembaga, atau pegawai Lembaga, atau apa-apa kombinasi anggota dan pegawai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai yang menjadi anggota sesuatu jawatankuasa tatatertib tidaklah boleh lebih LUAR PESISIR LABUAN rendah pangkatnya daripada mana-mana pegawai atau pengkhidmat yang ke atasnya jawatankuasa yang dia menjadi anggota mempunyai kuasa tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa yang ditubuhkan menurut perenggan (2)(b) hendaklah menjalankan kuasanya dalam segala perkara berhubungan dengan tatatertib pegawai dan pengkhidmat yang diletakkan di bawah bidang kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan fungsi dan kuasa tatatertibnya, sesuatu jawatankuasa tatatertib yang disebut dalam subseksyen (2) hendaklah mempunyai kuasa untuk mengambil tindakan tatatertib dan mengenakan apa-apa hukuman tatatertib atau apa-apa kombinasi dua hukuman tatatertib atau lebih sebagaimana yang diperuntukkan di bawah mana-mana peraturan yang dibuat di bawah seksyen 22."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu keputusan jawatankuasa tatatertib di bawah perenggan 20(2)(a) bolehlah dirayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu keputusan jawatankuasa tatatertib di bawah perenggan 20(2)(b) bolehlah dirayu kepada Lembaga Rayuan Tatatertib yang hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Lembaga, yang hendaklah menjadi pengerusi Lembaga Rayuan Tatatertib dan mempunyai undi pemutus; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga anggota Lembaga, yang bukannya anggota jawatankuasa tatatertib yang keputusannya ialah hal perkara rayuan itu, yang hendaklah dilantik oleh pengerusi Lembaga Rayuan Tatatertib dengan kelulusan Lembaga bagi maksud rayuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri atau Lembaga Rayuan Tatatertib, mengikut mana-mana yang berkenaan, boleh mengesahkan, mengakaskan atau mengubah keputusan jawatankuasa tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Lembaga Rayuan Tatatertib menimbangkan sesuatu rayuan di bawah subseksyen (2), seorang anggota jawatankuasa tatatertib yang terhadap keputusannya rayuan itu dibuat yang juga anggota Lembaga tidak boleh hadir pada atau dengan apa-apa cara mengambil bahagian dalam apa-apa prosiding berhubungan dengan rayuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri atau Lembaga Rayuan Tatatertib di bawah subseksyen (3) adalah muktamad dan konklusif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, dengan kelulusan Menteri, membuat apa-apa peraturan yang difikirkannya perlu atau suaimanfaat untuk mengadakan peruntukan bagi tatatertib pegawai dan pengkhidmat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan tatatertib yang dibuat di bawah seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh mewujudkan kesalahan tatatertib;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh mengadakan peruntukan bagi hukuman tatatertib yang difikirkan sesuai oleh Lembaga, dan hukuman itu boleh meliputi amaran, denda, pelucuthakan emolumen, penangguhan pergerakan gaji, pengurangan gaji, penurunan pangkat dan buang kerja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memberikan kepada orang yang terhadapnya prosiding tatatertib itu diambil peluang membuat representasi pertuduhan tatatertib yang dibuat terhadapnya sebelum keputusan dicapai oleh jawatankuasa tatatertib kecuali dalam hal-hal yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang pegawai atau pengkhidmat Lembaga dibuang kerja atau diturunkan pangkat atas alasan kelakuan yang berkenaan dengannya suatu pertuduhan jenayah telah dibuktikan terhadapnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika Lembaga, atas syor Menteri yang dipertanggungkan dengan hal-ehwal dalam negeri, berpuas hati bahawa demi LUAR PESISIR LABUAN kepentingan keselamatan Persekutuan atau mana-mana bahagiannya adalah tidak suaimanfaat untuk menjalankan kehendak perenggan ini; atau (iii) jika telah dibuat terhadap seseorang pegawai atau pengkhidmat Lembaga apa- apa perintah tahanan, pengawasan, kediaman terhad, buang negeri atau deportasi, atau jika telah dikenakan terhadap pegawai atau pengkhidmat Lembaga apa-apa bentuk sekatan atau pengawasan dengan bon atau selainnya di bawah mana-mana undang-undang berhubungan dengan keselamatan Persekutuan atau mana-mana bahagiannya, pencegahan jenayah, tahanan pencegahan, kediaman terhad, buang negeri, imigresen, atau perlindungan wanita dan gadis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi penahanan kerja dengan pengurangan emolumen pegawai atau pengkhidmat Lembaga sementara menanti selesainya prosiding jenayah terhadapnya atau prosiding tatatertib terhadapnya dengan tujuan membuang kerja atau menurunkan pangkatnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi penggantungan tanpa emolumen seseorang pegawai atau pengkhidmat Lembaga jika pegawai atau pengkhidmat itu telah disabitkan oleh mana- mana mahkamah jenayah atau jika suatu perintah tahanan atau sekatan telah dibuat berkenaan dengan atau dikenakan terhadap pegawai atau pengkhidmat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang sedang atau telah bekerja dengan Lembaga boleh disurcaj jika ternyata kepada Lembaga bahawa orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak memungut apa-apa wang yang terhutang kepada Lembaga yang pemungutannya menjadi tanggungjawabnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah atau telah bertanggungjawab bagi apa- apa pembayaran wang daripada Lembaga yang tidak sepatutnya dibuat atau bagi apa-apa pembayaran wang yang tidak diluluskan dengan sewajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah atau telah bertanggungjawab, secara langsung atau tak langsung, bagi apa-apa kekurangan dalam, atau bagi pemusnahan, apa- apa wang, barang simpanan atau harta lain Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai atau semasa menjadi pegawai perakaunan, tidak menyimpan akaun atau rekod yang sepatutnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak membuat apa-apa pembayaran, atau adalah atau telah bertanggungjawab bagi apa-apa kelewatan dalam pembayaran wang daripada Lembaga kepada mana-mana orang yang kepadanya pembayaran itu kena dibuat di bawah mana-mana undang-undang atau di bawah mana- mana kontrak, perjanjian atau perkiraan yang dibuat antara orang itu dengan Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah, sebelum orang itu disurcaj, menyampaikan suatu notis bertulis kepadanya yang memintanya menunjukkan sebab mengapa dia tidak patut disurcaj."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penjelasan yang memuaskan hati tidak diterima dalam masa empat belas hari dari tarikh penyampaian notis seperti yang disebut terdahulu, Lembaga boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan ( 1 )( a ), (b) dan (c) mensurcajkan terhadap orang itu sejumlah wang yang tidak melebihi amaun yang tidak dipungut, atau apa-apa bayaran yang tidak sepatutnya dibuat, atau kekurangan dalam, atau pemusnahan harta yang dilakukan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan (1)(d) dan (e), mensurcajkan apa-apa jumlah wang terhadap orang itu sebagaimana yang difikirkannya patut. LEMBAGA PERKHIDMATAN KEWANGAN LUAR PESISIR LABUAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga hendaklah memberitahu orang yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disurcajkan berkenaan dengan surcaj yang dikenakan di bawah subseksyen 23(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen 23(3) dan seksyen 24,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh pada bila-bila masa menarik balik apa- apa surcaj yang berkenaan dengannya penjelasan yang memuaskan hati telah diterima atau jika ternyata selainnya bahawa tiada surcaj patut dibuat, dan Lembaga hendaklah dengan serta-merta memberitahu orang yang disurcajkan itu akan penarikbalikan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Amaun apa-apa surcaj yang dikenakan di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 23(3) dan tidak ditarik balik di bawah seksyen 25 hendaklah menjadi hutang yang kena dibayar kepada Lembaga daripada orang yang terhadapnya surcaj itu dikenakan dan boleh didakwa dan diperdapatkan di dalam mana-mana mahkamah atas guaman Lembaga dan boleh juga, jika diarahkan sedemikian oleh Lembaga, diperdapatkan melalui potongan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "daripada gaji orang yang disurcajkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "daripada pencen orang yang disurcajkan, dengan ansuran bulanan yang sama banyak yang tidak melebihi satu perempat daripada jumlah gaji atau pencen bulanan, mengikut mana-mana yang berkenaan, orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam apa-apa tindakan surcaj terhadap Ketua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pengarah, keanggotaan Lembaga bagi maksud seksyen 23 hingga 26 tidaklah termasuk Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Semua anggota Lembaga atau mana-mana"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "jawatankuasanya atau mana-mana pegawai, pengkhidmat atau ejen Lembaga semasa menunaikan kewajipan mereka sebagai anggota, pegawai, pengkhidmat atau ejen sedemikian hendaklah disifatkan sebagai pengkhidmat awam dalam pengertian Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dengan ini ditubuhkan suatu pertubuhan perbadanan bernama \"Lembaga Perkhidmatan Kewangan Luar Pesisir Labuan\" yang kekal turun-temurun dan mempunyai suatu meterai biasa, yang boleh mendakwa dan didakwa atas namanya dan, tertakluk kepada dan bagi maksud-maksud Akta ini, boleh membuat kontrak dan boleh memperolehi, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih dan harta tak alih dan boleh memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai-janji, mendemis, menyerahhakkan semula, memindahmilikkan atau dengan apa-apa cara lain melupuskan, atau membuat apa-apa urusan mengenai, apa-apa harta alih atau harta tak alih atau apa-apa kepentingan mengenainya yang terletakhak pada Lembaga, atas apa-apa terma yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Objektif Lembaga adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memajukan dan membangunkan Labuan sebagai pusat bagi perkhidmatan kewangan luar pesisir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memajukan objektif, dasar dan keutamaan negara bagi pembangunan dan pentadbiran yang teratur akan perkhidmatan kewangan luar pesisir di Labuan, dan membuat syor-syor kepada Menteri berkenaan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Lembaga adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbirkan, menguatkuasakan, men- jalankan dan melaksanakan peruntukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Syarikat Luar Pesisir 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Syarikat Amanah Labuan 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Bank Luar Pesisir 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Insurans Luar Pesisir 1990; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana undang-undang berhubungan dengan perkhidmatan kewangan luar pesisir di Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan, menunaikan dan me- laksanakan apa-apa kuasa, kewajipan dan fungsi di bawah undang-undang yang disebut dalam perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memastikan bahawa transaksi kewangan luar pesisir dijalankan mengikut undang-undang berhubungan dengan perkhidmatan kewangan luar pesisir dan norma-norma mantap bagi tatalaku yang baik dan mulia dan mengekalkan nama baik Labuan sebagai pusat bagi perkhidmatan kewangan luar pesisir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan penyelidikan menyebabkan diadakan kajian mengenai perkhidmatan kewangan luar pesisir di Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat syor bagi mewujudkan dan memperbaiki apa-apa kemudahan yang akan meningkatkan daya tarikan Labuan sebagai pusat bagi perkhidmatan kewangan luar pesisir; LUAR PESISIR LABUAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bekerjasama dengan institusi kewangan luar pesisir dan persatuan profesional dan industri di Labuan untuk memajukan dan mengadakan perkhidmatan kewangan luar pesisir dan menggalakkan standard yang tinggi bagi perkhidmatan kewangan luar pesisir di Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Menteri secara amnya mengenai perkara yang berhubungan dengan perkhidmatan kewangan luar pesisir di Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai kuasa untuk melakukan segala benda yang suaimanfaat atau yang semunasabahnya perlu bagi, atau bersampingan dengan, pelaksanaan fungsi-fungsinya dan, khususnya, tetapi tanpa menjejaskan keluasan yang tersebut di atas—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana ejen yang difikirkannya patut bagi maksud melaksanakan fungsi-fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan fee atau apa-apa caj lain yang difikirkannya patut bagi melaksanakan mana-mana fungsi atau kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa benda lain yang difikirkannya patut untuk membolehkannya menjalankan fungsi-fungsi dan kuasa-kuasanya dengan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan adalah dengan ini diisytiharkan bahawa Lembaga hendaklah juga mempunyai fungsi yang berikut, iaitu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melesenkan atau mendaftarkan orang yang menjalankan perkhidmatan kewangan luar pesisir di Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawalselia dan mengawasi penjalanan perkhidmatan kewangan luar pesisir di Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada anggota yang berikut yang hendaklah dilantik oleh Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada tiga dan tidak lebih daripada tujuh orang lain, dua daripadanya hendaklah daripada sektor awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang dilantik di bawah perenggan (1)(c) hendaklah daripada kalangan orang yang mempunyai pengalaman yang relevan dalam perkara kewangan, komersil atau undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah menjadi ketua pegawai eksekutif Lembaga dan hendaklah dipertanggungjawabkan dengan pentadbiran harian Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya Ketua Pengarah tidak ada atau tidak dapat bertindak kerana sakit atau apa-apa sebab lain, Pengerusi hendaklah melantik mana-mana anggota Lembaga untuk menjalankan fungsi-fungsi Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa syarat yang dinyatakan dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "suratcara perlantikannya, seseorang anggota Lembaga hendaklah, melainkan jika dia terlebih dahulu meletakkan atau mengosongkan jawatannya atau perlantikannya terlebih dahulu dibatalkan, memegang jawatan selama tempoh yang tidak melebihi tiga tahun dan adalah layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Perlantikan mana-mana anggota boleh pada bila- bila masa dibatalkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota boleh pada bila-bila masa meletakkan jawatannya dengan notis bertulis yang ditujukan kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Lembaga hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia telah disabitkan atas apa-apa kesalahan di bawah mana-mana undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap; LUAR PESISIR LABUAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tak sempurna akal atau selainnya tak berupaya menunaikan kewajipan-kewajipannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menghadiri mesyuarat Lembaga tiga kali berturut-turut tanpa kebenaran Pengerusi atau dalam hal Pengerusi, tanpa kebenaran Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa. memberikan kepada Lembaga arahan-arahan yang bersifat am yang tidak tak konsisten dengan peruntukan Akta ini dan arahan sedemikian hendaklah mengikat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, menghendaki Lembaga memberi Menteri apa-apa penyata, akaun dan maklumat mengenai pelaksanaan mana-mana fungsinya di bawah Akta ini dan mana-mana undang- undang lain berhubungan dengan perkhidmatan kewangan luar pesisir dan Lembaga hendaklah mematuhi kehendak sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga, mana-mana anggota Lembaga atau mana- mana jawatankuasa yang ditubuhkan oleh Lembaga, dan mana-mana pegawai atau pengkhidmat Lembaga tidaklah bertanggungan bagi apa-apa tindakan atau prosiding lain bagi ganti-rugi bagi atau oleh sebab, atau berkenaan dengan, apa-apa tindakan yang dilakukan atau pernyataan yang dibuat, ditinggalkan daripada dilakukan atau dibuat, menurut atau dalam melaksanakan Akta ini atau dalam melaksanakan mana-mana fungsi, atau dalam menjalankan mana-mana kuasa, yang diberikan oleh atau di bawah mana-mana undang-undang bertulis berhubungan dengan perkhidmatan kewangan luar pesisir: Dengan syarat bahawa tindakan, pernyataan, pelaksanaan fungsi atau penjalanan kuasa itu telah dilakukan atau dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan yang suaimanfaat atau perlu bagi melaksanakan atau menguatkuasakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memperuntukkan bahawa apa-apa pelanggaran mana-mana peruntukannya adalah suatu kesalahan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memperuntukkan bagi pengenaan penalti yang tidak melebihi dua puluh lima ribu ringgit bagi mana-mana kesalahan di bawahnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), Menteri boleh, bilamana didapatinya perlu atau suaimanfaat dibuat sedemikian sama ada bagi maksud menghapuskan kesulitan atau berikutan dengan terlulusnya Akta ini, melalui perintah membuat apa-apa ubahsuaian kepada mana-mana peruntukan dalam mana-mana undang-undang berhubungan dengan perkhidmatan kewangan luar pesisir sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri tidak boleh menjalankan kuasa yang diberikan di bawah subseksyen (1) selepas habis tempoh dua tahun dari mula berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua peraturan, petunjuk, arahan, perintah atau keputusan yang dibuat oleh Pendaftar atau Bank, mengikut mana-mana yang berkenaan, di bawah mana-mana undang- undang berhubungan dengan perkhidmatan kewangan luar pesisir yang wujud sebelum mula berkuatkuasanya Akta ini hendaklah disifatkan telah dibuat oleh Lembaga sehingga dipinda atau dibatalkan atau sehingga tarikh ia habis tempoh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua peraturan, petunjuk, arahan, perintah atau keputusan yang dibuat oleh Menteri bertanggungjawab bagi Akta Syarikat Luar Pesisir 1990 dan Akta Syarikat Amanah Labuan 1990 di bawah Akta- Akta itu yang wujud sebelum mula berkuatkuasanya Akta ini hendaklah disifatkan telah dibuat oleh Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan melainkan jika dipinda atau dibatalkan atau sehingga tarikh ia habis tempoh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua permohonan, kelulusan atau keputusan yang belum selesai di hadapan Pendaftar atau Bank, mengikut mana-mana yang berkenaan, di bawah mana-mana undang- undang berhubungan dengan perkhidmatan kewangan luar pesisir hendaklah, apabila mula berkuatkuasanya Akta ini, diuruskan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua permohonan, kelulusan atau keputusan yang belum selesai di hadapan Menteri yang bertanggungjawab bagi Akta Syarikat Luar Pesisir 1990 dan Akta Syarikat LEMBAGA PERKHIDMATAN KEWANGAN LUAR PESISIR LABUAN Amanah Labuan 1990 di bawah Akta-Akta itu hendaklah, apabila mula berkuatkuasanya Akta ini, diuruskan oleh Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_IV__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua suratcara, perakuan atau dokumen yang diserahsimpan dengan Pendaftar atau Bank, mengikut mana-mana yang berkenaan, di bawah mana-mana undang- undang berhubungan dengan perkhidmatan kewangan luar pesisir sebelum mula berkuatkuasanya Akta ini hendaklah, apabila mula berkuatkuasanya Akta ini, disifatkan telah diserahsimpan dengan Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Perkhidmatan Kewangan Luar Pesisir Labuan 1995 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta; dan Menteri boleh menetapkan tarikh yang berlainan bagi mula berkuatkuasanya peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain— \"Bank\" ertinya Bank Negara Malaysia yang ditubuhkan di bawah Akta Bank Negara Malaysia 1958; \"institusi kewangan luar pesisir\" ertinya mana-mana orang yang mengadakan perkhidmatan kewangan luar pesisir; \"jawatankuasa\" ertinya mana-mana jawatankuasa yang ditubuhkan oleh Lembaga di bawah subseksyen 15(1); \"Kumpulan Wang\" ertinya Kumpulan Wang yang ditubuhkan di bawah subseksyen 29(1); \"Labuan\" ertinya Kawasan Lembaga Pembangunan Labuan yang ditakrifkan dalam seksyen 2 Akta Lembaga Pembangunan Labuan 1992; \"Lembaga\" ertinya Lembaga Perkhidmatan Kewangan Luar Pesisir Labuan yang ditubuhkan di bawah seksyen 3; \"Menteri\" ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi kewangan; \"orang tanggungan\", berhubungan dengan pegawai atau pengkhidmat Lembaga, ertinya isteri atau suami, ibu atau bapa, anak termasuk anak angkat atau anak tiri, atau mana-mana orang lain yang ditentukan oleh Lembaga dengan persetujuan Menteri dari semasa ke semasa melalui notis yang disiarkan dalam Warta; \"pegawai perakaunan\" termasuklah tiap-tiap pegawai dan pengkhidmat yang dipertanggungkan dengan kewajipan memungut, menerima, atau mengakaunkan, atau yang sebenarnya memungut, menerima atau mengakaunkan, apa-apa wang dalam Kumpulan Wang, atau yang dipertanggungkan dengan penerimaan, penjagaan atau pelupusan, atau pengakaunan, apa-apa barang simpanan dan harta Lembaga atau yang sebenarnya menerima, memegang atau melupuskan barang simpanan dan harta sedemikian; \"Pendaftar\" ertinya Pendaftar Syarikat di bawah Akta Syarikat 1965, dan termasuklah mana-mana Pendaftar Rantau, Timbalan Pendaftar atau Penolong Pendaftar Syarikat; \"Pengerusi\" ertinya Pengerusi yang dilantik di bawah seksyen 5; LUAR PESISIR LABUAN \"perkhidmatan kewangan luar pesisir\" ertinya apa-apa perkhidmatan yang diadakan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "syarikat luar pesisir atau syarikat luar pesisir asing yang didaftarkan di bawah Akta Syarikat Luar Pesisir 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana syarikat domestik atau syarikat asing yang didaftarkan di bawah Akta Syarikat Amanah Labuan 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang dilesenkan atau didaftarkan, mengikut mana-mana yang berkenaan, di bawah Akta Bank Luar Pesisir 1990, Akta Insurans Luar Pesisir 1990, atau mana-mana undang-undang lain berhubungan dengan perkhidmatan kewangan luar pesisir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/39/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ungkapan \"syarikat asing\", \"syarikat domestik\", \"syarikat luar pesisir\" dan \"syarikat luar pesisir asing\" masing-masingnya mempunyai pengertian yang diberikan kepadanya dalam Akta Syarikat Luar Pesisir 1990."
      }
    }
  ]
}
