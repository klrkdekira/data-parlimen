        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/eng@/~cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 138 of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "138."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/eng@/~cl_13__para_a",
