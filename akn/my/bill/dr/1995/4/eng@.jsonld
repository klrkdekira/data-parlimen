      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"permit is issued\" the words \"or any exemption is granted\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/eng@/~cl_13__para_b",
