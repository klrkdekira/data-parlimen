      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dan (2), dengan memasukkan sebelum perkataan \"authority card\" perkataan \"badge or\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/msa@/~cl_5__para_b",
