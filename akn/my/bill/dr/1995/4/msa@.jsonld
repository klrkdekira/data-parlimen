      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan menggantikan perkataan \"Authority\" dengan perkataan \"Badges and authority\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/4/msa@/~cl_6",
