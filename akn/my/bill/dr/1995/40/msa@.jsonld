      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kanun Tanah Negara (Pindaan) 1995"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kanun Tanah Negara (Pindaan) 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa dalam setiap Negeri pada tarikh yang ditetapkan oleh Menteri dengan kelulusan Majlis Tanah Negara berhubungan dengan Negeri itu melalui pemberitahuan dalam Warta Persekutuan, dan Menteri boleh, dengan kelulusan Majlis Tanah Negara, menetapkan tarikh-tarikh yang berlainan berkenaan dengan peruntukan-peruntukan yang berlainan dalam Akta ini berhubungan dengan Negeri itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa di Wilayah Persekutuan Kuala Lumpur pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh-tarikh yang berlainan berkenaan dengan peruntukan-peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Kanun Tanah Negara, yang disebut \"Kanun\" dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini, adalah dipinda dalam perenggan 14(1)(g) dengan memasukkan selepas perkataan \"fees\" perkataan \"or levy\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 301A Kanun adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"has not\" dengan perkataan \"and, where applicable, any levy payable under sub-section (2) of section 433B have not\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Kanun adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "428AA. seksyen 428A seksyen yang berikut: \"Offences 428AA. (1) Where a person charged with an committed offence under this Act or any rules made by body corporate: thereunder is a body corporate, every person officers who at the time of the commission of the offence deemed to be guilty. is a director or officer of the body corporate may be charged jointly in the same proceedings with the body corporate, and where the body corporate is convicted of the offence charged, every such director or officer shall be deemed to be guilty of that offence unless he proves that the offence was committed without his knowledge or that he took reasonable precautions to prevent its commission. (2) Any person who would be liable under this Act or any rules made thereunder to any penalty for anything done or omitted if the thing had been done or omitted by him personally shall be liable to the same penalty if the thing had been done or omitted by his agent, unless he proves that he took reasonable precautions to prevent the doing or omission of the thing.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 433A Kanun adalah dipinda dengan menggantikan takrif \"foreign company\" dengan takrif 433A. ' \"foreign company\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "a foreign company as defined in sub-section Akta 125."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "of section 4 of the Companies Act 1965;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "a company incorporated under the Companies Act 1965 with thirty per cent or more of its voting shares being held by a non-citizen, or by a foreign company referred to in paragraph (a), or by both, at the time of the proposed acquisition of any land or any interest in land or at the time of the execution of the instrument or deed in respect of any alienated land or any interest therein, as the case may be; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "a company incorporated under the Companies Act 1965 with thirty per cent or more of its voting shares being held by a company referred to in paragraph (b), or by a company referred to in paragraph (b) together with a non-citizen or a foreign company referred to in paragraph (a), at the time of the proposed acquisition of any land or any interest in land or at the time of the execution of the instrument or deed in respect of any alienated land or any interest therein, as the case may be.'. Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 433B Kanun adalah dipinda— 433B."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"or an interest in land\" dalam perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"purposes\" dalam proviso dengan perkataan \", or in respect of State land to be alienated for industrial purposes\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas proviso, proviso yang berikut: \"And provided further that no such approval shall be required in respect of any dealing effected pursuant to a sale and purchase agreement for which an approval has been granted under section 433E and executed by the same parties in such agreement.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"Authority\" yang terdapat kali kedua dalam subseksyen (2) perkataan \"and to the payment of such levy as may be prescribed\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan ( 1 )( a )( i) dan (ii) hendaklah disifatkan telah mula berkuatkuasa pada 1 Januari 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Kanun adalah dipinda dengan menomborkan semula"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 433E sebagai seksyen 433H dan dengan memasukkan selepas seksyen 433D seksyen yang berikut: 433E. (1) Subject to any written law, a person or body desiring to convey or dispose of, in a manner other than those specified in sub-section (1) of section 433B, any alienated land or any interest therein to a non-citizen or a foreign company may be allowed to do so, but only after the prior approval of the State Authority has been obtained upon an application in writing being made by such person or body: Provided that no such approval shall be required in respect of any alienated land or any interest in land which is subject to the category \"industry\" or to any condition requiring its use for industrial purposes. (2) Where the State Authority grants any approval under sub-section (1), it may be made subject to such terms and conditions as may be specified by the State Authority and to the payment of such levy as may be prescribed. (3) Any person or body conveying or disposing of, or any non-citizen or foreign company accepting the conveyance or disposal of, any alienated land or any interest therein in contravention of sub-section (1) shall be guilty of an offence, and liable on conviction to a fine of not less than one hundred thousand ringgit. (4) Nothing contained in this section shall render invalid anything done before the commencement of this section if— (a) in respect of an instrument or a deed executed before 27 October 1995, the instrument or deed has been stamped in accordance with the provisions of the Stamp Act 1949 either before or within one month after the commencement of this section; or (b) the instrument or deed effecting any conveyance or disposal of any alienated land or any interest therein in favour of a non-citizen or a foreign company was executed on or after 27 October 1995 but before the commencement of this section, and— (i) an application in writing is made within three months of the commencement of this section for an approval under this section; (ii) any levy imposed in respect thereof has been paid; and (iii) the instrument or deed has been stamped in accordance with the provisions of the Stamp Act 1949 either before or within one month after the commencement of this (5) After the commencement of this section, any conveyance or disposal, in a manner other than those specified in sub-section (1) of section 433B, of any alienated land or any interest therein in contravention of this section shall be null and void. Execution 433F. (1) Subject to sections 433B and 433E, by non- after the commencement of this section, any citizen or foreign deed or instrument executed by a non-citizen company or a foreign company under a power of attorney under power of in respect of any alienated land or any interest attorney therein in favour of any person or body shall void. be void, and, in the case of an instrument of dealing, be incapable of registration. (2) Nothing contained in this section shall render invalid any deed or instrument effected by a non-citizen or a foreign company under a power of attorney in respect of any alienated land or any interest therein in favour of any person or body before the commencement of this section and stamped in accordance with Act 378. the provisions of the Stamp Act 1949 either before or within one month after such commencement. Levy to be 433G. Any levy payable under this Part shall paid within be paid in full not later than thirty days from thirty days of service the date of the service of the notice of approval of notice by the State Authority and if the levy is not of approval. paid within such time, the approval shall thereupon lapse.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa levi yang dipungut berkenaan dengan sesuatu kebenaran yang diberikan di bawah subseksyen (1) seksyen 433B dan apa-apa penolakan apa-apa suratcara pengurusan kerana tak bayar levi oleh Pentadbir Tanah atau oleh Pendaftar Hakmilik, mengikut mana- mana yang berkenaan, selepas 27 Oktober 1995 sehingga Akta ini mula berkuatkuasa, yang akan menjadi sah KANUN TANAH NEGARA (PINDAAN) sekiranya Akta ini telah dibuat dan berkuatkuasa semasa pemungutan atau penolakan itu dibuat adalah dengan ini diisytiharkan sebagai telah dipungut atau dilakukan secara san, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/40/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding undang-undang apa jua pun boleh dibawa, dimulakan atau disenggara terhadap mana-mana Pentadbir Tanah, Pendaftar Hakmilik, Pengarah Tanah dan Galian Negeri, Kerajaan Negeri, Jawatankuasa Eksekutif Tanah Wilayah Persekutuan Kuala Lumpur, Kerajaan Persekutuan, atau mana-mana pegawai yang bertindak di bawah salah seorang di antara mereka, bagi apa-apa levi yang dipungut oleh salah seorang di antara mereka sebelum Akta ini mula berkuatkuasa, dan sekiranya apa-apa tindakan atau prosiding undang-undang sedemikian telah dibawa, dimulakan dan disenggara, maka ianya hendaklah dilepaskan dan terbatal dan tiada bayaran balik berkenaan dengan levi yang telah dipungut seperti yang disebut terdahulu boleh dibuat."
      }
    }
  ]
}
