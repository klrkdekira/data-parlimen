      "schema:name": {
        "@language": "en",
        "@value": "Service Tax (Amendment) Bill 1995"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Service Tax (Amendment)"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Service Tax Act 1975, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in subsection 12(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"aggregate amount of the proceeds received\" the words \"during that taxable period\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"during that period\" after the words \"charges for provisions of taxable goods\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "14 the following section: When tax 14. (1) The service tax chargeable under this becomes Act shall be due at the time when payment is due and payable. received for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable service provided; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods sold or provided, to the customer or purchaser by the taxable person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Where the whole or any part of the payment for any taxable service provided or taxable goods sold or provided is not received within a period of six calendar months from the date of issue of the invoice for the taxable service provided or the taxable goods sold or provided, service tax shall be due on the day following that period of six months."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any tax which falls due under subsection (1) or (2) during any taxable period shall be payable to the Director General within twenty- eight days from the expiration of that taxable period.\"."
      }
    }
  ]
}
