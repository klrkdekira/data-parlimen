      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: \"(ba) mana-mana kedai bebas cukai yang dilesenkan di bawah seksyen 65D; dan\"."
      }
