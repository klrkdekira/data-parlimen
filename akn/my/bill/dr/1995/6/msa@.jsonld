      "schema:name": {
        "@language": "ms",
        "@value": "Akta Eksais 1976 adalah dipinda dalam subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2(1) dalam takrif \"gudang berlesen\"—"
