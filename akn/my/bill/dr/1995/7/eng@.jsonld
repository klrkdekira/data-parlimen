      ],
      "schema:name": {
        "@language": "en",
        "@value": "Free Zones (Amendment) Bill 1995"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Free Zones (Amendment) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Free Zones Act 1990, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in subsection 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"commercial activity\" the following definition: ' \"customs airport\" shall have the same meaning assigned to it under the Customs Act 1967;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Langkawi\" the following definition: ' \"legal landing place\" shall have the same meaning assigned to it under the Customs Act 1967;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"operation\" the following definition: \"prescribed place of import or export\" means any place prescribed under section 142 of the Customs Act 1967 as a place for the import and export of goods by road and rail;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"principal customs area\" the following definition: ' \"proper officer of the Authority\" means any officer of the Authority acting in the fulfilment of his duties under the Act, whether such duties are assigned to him specially or generally, or expressly or by implication;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 17(1) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "deleting the word \"industrial\" appearing before the word \"zone\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "renumbering it as subsection (1) of that section and by 42. inserting after the renumbered subsection (1) the following subsection: \"(2) Any ship to ship transfer within the port limits of a free zone shall be deemed to have been done within such zone.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "42 the following sections: 42A. (1) No goods shall be brought into, or be loaded or water-borne to be loaded to be taken into and from a out from, any free zone by sea— free zone by sea. (a) except at a legal landing place; and (b) until permission to do so has been received from the proper officer of the Authority. (2) Except with the permission of the proper officer of the Authority, no such goods, after having been landed or unshipped, shall be transhipped. Movement 42B. No goods shall be brought into, or be taken of goods out from, any free zone by air except at a customs into and from a airport. free zone by air. Movement 42c. No goods shall be brought into, or be taken of goods out from, any free zone by road or rail except into and from a at prescribed places of import or export and, free zone where a route has been prescribed, by such by road route.\". or rail."
      }
    }
  ]
}
