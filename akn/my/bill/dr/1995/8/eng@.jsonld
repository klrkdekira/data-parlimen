      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding one hundred and thirty-eight million one hundred and forty-six thousand and three hundred (RM138,146,300) from the Consolidated Fund for expenditure on the services specified in the Schedule for the service of the year 1995, not provided for or not fully provided for by the Supply Act 1995 and the Supplementary Supply (1994 and 1995) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~sched_1",
