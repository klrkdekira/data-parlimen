      "schema:text": {
        "@language": "en",
        "@value": "(Section 2) Purpose Title Appropriation B. 3 Audit Department B. 7 Prime Minister's Department 62,921,000 Purpose Title Appropriation B. 16 Fire Services Department B. 26 Ministry of Education 25,000,000 B. 34 Ministry of Health B. 39 National Registration Department Total ... 138,146,300"
