    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1995) Act 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1995/8/eng@/~cl_2",
