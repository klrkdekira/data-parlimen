        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_18",
