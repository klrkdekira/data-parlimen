      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh menubuhkan jawatankuasa yang difikirkannya patut bagi maksud membantu Majlis melaksanakan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa hendaklah terdiri daripada apa-apa bilangan orang yang boleh dilantik oleh Majlis daripada kalangan anggotanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan subseksyen (2), Majlis boleh mengundang mana-mana orang atau wakil mana- mana organisasi untuk menasihati sesuatu jawatankuasa yang ditubuhkan di bawah subseksyen (1) dalam menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang dilantik di bawah subseksyen (2) atau diundang menjadi anggota sesuatu jawatankuasa di bawah subseksyen (3) boleh dibayar apa-apa elaun yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Majlis hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan prosedurnya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah bermesyuarat sebagaimana dan apabila dikehendaki berbuat sedemikian oleh Pengerusi Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi dan empat anggota lain Majlis hendaklah menjadi kuorum dalam mana-mana mesyuarat Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas apa-apa persoalan yang hendak diputuskan oleh Majlis terdapat pembahagian undi yang sama banyak, Pengerusi atau anggota yang mempengerusikan mesyuarat itu hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota Majlis mempunyai apa-apa"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepentingan benefisial dalam apa-apa perkara yang sedang dipertimbangkan oleh Majlis dia hendaklah dengan serta- merta mengisytiharkan jenis dan takat kepentingannya dalam perkara itu kepada Pengerusi atau anggota yang mempengerusikan mesyuarat itu dan Majlis hendaklah memutuskan sama ada dia boleh atau tidak mengambil bahagian dalam mesyuarat Majlis apabila perkara itu sedang dipertimbangkan, walau apa pun kepentingannya dalam perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah menyebabkan minit segala mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Majlis atau wakilnya bolehlah dibayar apa-apa elaun kerana menghadiri mesyuarat Majlis sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud membolehkan Majlis menjalankan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "fungsinya di bawah Akta ini, Menteri boleh, dari semasa ke semasa, membuat sumbangan bantuan kepada Majlis apa-apa jumlah wang yang ditentukan oleh Menteri daripada wang yang hendaklah diperuntukkan oleh Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ditubuhkan suatu Sekretariat daripada Jabatan Pendidikan Tinggi Kementerian Pendidikan yang hendaklah membantu Majlis dalam menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota yang dilantik oleh Menteri di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 4(i) boleh meletakkan jawatan sebagai anggota Majlis pada bila-bila masa dengan memberi satu bulan notis secara bertulis kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh menamatkan perlantikan mana-mana"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Majlis yang dilantik di bawah perenggan 4(g), (h) atau (i) pada bila-bila masa tanpa memberikan apa-apa alasan mengenainya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Majlis adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merancang, membentuk dan menentukan dasar dan strategi kebangsaan bagi perkembangan pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelaraskan perkembangan pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memajukan dan memudahkan pertumbuhan teratur institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan kriteria bagi penguntukan wang kepada institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar berhubungan dengan kemasukan pelajar ke institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan garis panduan mengenai perkara-perkara yang berkaitan dengan struktur gaji dan sistem pengurusan kakitangan Universiti dan Kolej Universiti yang ditubuhkan di bawah Akta Universiti dan Kolej Universiti 1971;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan garis panduan mengenai struktur fee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan garis panduan mengenai bidang atau kursus pengajian yang diusahakan oleh institusi pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan garis panduan mengenai penjalanan apa-apa kursus pengajian atau program latihan oleh institusi pendidikan tinggi bersesama atau bersama-sama dengan, secara bergabung, secara usahasama atau selainnya, dengan mana-mana Universiti atau institusi pendidikan tinggi atau institusi pendidikan atau organisasi lain di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan dasar dan menetapkan garis panduan mengenai penglibatan Universiti dalam aktiviti perniagaan mengikut kuasa yang diberikan di bawah Akta Universiti dan Kolej Universiti 1971; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil apa-apa tindakan atau melakukan apa-apa benda lain yang difikirkannya patut atau perlu bagi membolehkannya menjalankan fungsi-fungsi dan kuasa-kuasanya dengan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila dasar, strategi dan garis panduan kebangsaan dibentuk dan ditentukan oleh Majlis berhubungan dengan fungsinya di bawah perenggan (l)(a) hingga (k), Menteri hendaklah dengan demikian itu melaksanakan dasar, strategi dan garis panduan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah ditubuhkan suatu Majlis yang dikenali"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai \"Majlis Pendidikan Tinggi Negara\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri sebagai Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian Pendidikan atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Pendidikan atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian Kewangan atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Unit Perancang Ekonomi Jabatan Perdana Menteri atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Negara atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga Naib Canselor mana-mana Universiti dan Kolej Universiti yang ditubuhkan di bawah Akta Universiti dan Kolej Universiti 1971;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada dua ketua pegawai eksekutif mana-mana institusi pendidikan tinggi swasta; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada tiga orang yang kerana pengetahuan dan pengalaman mereka boleh, pada pendapat Menteri, membantu Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian Pendidikan hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mempengerusikan mesyuarat Majlis semasa ketakhadiran Pengerusi atau bila mana Pengerusi yang kerana apa-apa sebab tidak dapat menghadiri mesyuarat Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Perlantikan seseorang anggota Majlis di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 4(g), (h) dan (i) hendaklah dibuat oleh Menteri dan, tertakluk kepada seksyen 7 dan 11, hendaklah bagi suatu tempoh tidak melebihi tiga tahun dan tiap-tiap anggota yang dilantik sedemikian hendaklah, apabila terhenti menjadi anggota, layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Orang yang berikut hilang kelayakan untuk dilantik"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai atau untuk menjadi anggota Majlis:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang telah disabitkan atas suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang bankrap; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang tak sempurna akal atau selainnya tak berupaya untuk menunaikan kewajipannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota Majlis yang dilantik di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 4( g ), (h) dan (i) hendaklah terhenti menjadi anggota—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menghadiri mesyuarat Majlis tiga kali berturut-turut tanpa kebenaran Pengerusi Majlis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jika perlantikannya dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika berlaku sesuatu kekosongan daripada kalangan anggota Majlis yang dilantik di bawah perenggan 4(g), (h) atau (i), kekosongan itu hendaklah diisi oleh seseorang yang dilantik oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Majlis Pendidikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tinggi Negara 1996 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki makna yang lain— \"anggota\" ertinya seseorang anggota Majlis Pendidikan Tinggi Negara; \"institusi pendidikan tinggi\" ertinya sesuatu institusi pendidikan yang sama ada atau tidak ditubuhkan di bawah mana-mana undang-undang bertulis dan termasuklah institusi pendidikan swasta yang menyediakan pendidikan tinggi yang membawa kepada penganugerahan sijil, diploma, ijazah atau yang setaraf dengannya; \"ketua eksekutif\" ertinya ketua eksekutif sesuatu institusi pendidikan tinggi swasta yang didaftarkan di bawah Akta Institusi Pendidikan Tinggi Swasta 1996; \"Majlis\" ertinya Majlis Pendidikan Tinggi Negara yang ditubuhkan di bawah seksyen 3; \"Menteri\" ertinya Menteri yang bertanggungjawab bagi Pendidikan; \"Naib Canselor\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan sesuatu Universiti ertinya Naib Canselor, Presiden, Rektor atau Pengarah Universiti itu dan termasuklah mana-mana orang lain, dengan nama apa jua disebut, yang dilantik sebagai ketua pegawai eksekutif Universiti itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/1/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan sesuatu Kolej Universiti hendaklah dibaca sebagai sebutan mengenai pihak berkuasa yang berkenaan Kolej Universiti itu; \"pelajar\" ertinya seseorang yang menerima apa-apa perihalan pendidikan, pengajaran atau latihan daripada atau di sesuatu institusi pendidikan tinggi; \"pendidikan tinggi\" ertinya pendidikan yang disediakan oleh sesuatu institusi pendidikan tinggi; \"Pengerusi\" ertinya Pengerusi Majlis Pendidikan Tinggi Negara; \"Universiti\" atau \"Kolej Universiti\" ertinya—"
      }
