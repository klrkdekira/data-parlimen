        "@value": "Constitution (Amendment) Bill 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 46 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"ninety-two\" in Clause (1) the word \"ninety-three\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"eighty-one\" in paragraph (a) the word \"eighty-two\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"twenty-seven\" in subparagraph (a)(xi) the word \"twenty- eight\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 46 of the Federal Constitution, as amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by section 2 of this Act, shall not affect the composition of the House of Representatives or any election to that House until the dissolution of Parliament occurring on or after the date of the coming into force of the Order made under section 12 of the Thirteenth Schedule to the Federal Constitution following the review undertaken"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "pursuant to Clause (2) of Article 113 of the Federal Constitution and the said Thirteenth Schedule."
      }
    }
