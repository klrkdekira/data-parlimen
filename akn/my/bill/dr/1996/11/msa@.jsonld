      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perlembagaan (Pindaan) 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlembagaan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perkara 46 Perlembagaan Persekutuan adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"sembilan puluh dua\" dalam Pasal (1) dengan perkataan \"sembilan puluh tiga\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Pasal (2)— 2 RANG UNDANG-UNDANG Keanggotaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"lapan puluh satu\" dalam perenggan (a) dengan perkataan \"lapan puluh dua\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"dua puluh tujuh\" dalam subperenggan (a)(xi) dengan perkataan \"dua puluh lapan\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 46 Perlembagaan Persekutuan, sebagaimana Dewan yang dipinda oleh seksyen 2 Akta ini, tidaklah menyentuh Rakyat yang sedia ada keanggotaan Dewan Rakyat atau mana-mana pemilihan atau kepada Dewan itu sehingga pembubaran Parlimen yang pemilihan kepada berlaku pada atau selepas tarikh mula berkuatkuasanya Dewan itu Perintah yang dibuat di bawah seksyen 12 Jadual Ketiga sebelum Perintah Belas kepada Perlembagaan Persekutuan berikutan dengan yang dibuat kajian semula yang dijalankan menurut Pasal (2) Perkara di bawah 113 Perlembagaan Persekutuan dan Jadual Ketiga Belas seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@/~sched_3",
      "@type": "akn:schedule",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "tersebut. Belas."
      }
    }
  ]
}
