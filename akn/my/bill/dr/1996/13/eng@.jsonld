    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_14__para_b"
