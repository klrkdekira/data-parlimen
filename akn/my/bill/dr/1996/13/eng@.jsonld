      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Employees Provident Fund (Amendment) Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Employees Provident Fund Act 1991, which in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act is referred to as the \"principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Sixth Schedule of the principal Act is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by inserting, after paragraph (3), the following paragraph: Schedule. \" (4) For the purpose of this Schedule, a member's credit at the time of incapacity shall not include the amount so invested under Part IIIA.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting, after the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Schedule. Sixth Schedule, the following Schedule:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"General Manager\" wherever appearing therein the words \"chief executive officer\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"Deputy General Manager\" wherever appearing therein."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended by inserting,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "after the definition of \"amount of wages for the month\", the following definition: ' \"chief executive officer\" means any person appointed to be a chief executive officer under section 30 of the Act;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 26A(2) (c) of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "26A."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the semicolon a colon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting the following proviso: \" Provided that the Minister may vary any limitation imposed on the total amount of the borrowings of the approved company in this paragraph;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 26B(3) of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "26B."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by inserting after the semicolon the words \"and\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (d)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting, after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "26B, the following section: Power 26c. (1) The Board may, in exercising the of the investment powers under this Act, from time Board to establish to time, with the special approval of the a corpora- Minister— nation or a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "establish a corporation by such name as company. the Board may think fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "incorporate a company under the Act 125. Companies Act 1965 by such name as the Board may think fit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "take over any company, to carry out, administer, conduct and manage any project, joint venture, privatisation programme, scheme, enterprise or any other matters which have been planned or undertaken by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Seventh Schedule shall apply to a corporation established under paragraph 1(a) and the Companies Act 1965 shall apply to a company incorporated or taken over under paragraph (1)(b) or (c), respectively.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_7__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting, after Part III, the following Part: PART IIIA INVESTMENT BY MEMBER OF THE FUND 29A. (1) Notwithstanding anything contrary to the provisions of this Act, the Board may, subject to any regulations and rules made under this Act, authorize an application for investment, made by a member of the Fund, partly any amount standing to the credit of such member of the Fund in fund management institutions approved by the Minister, subject to such terms and conditions as he thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Board has authorized such transfer of a sum of money standing to the credit of such member under subsection (1), such amount so authorized shall not be paid dividend as declared by the Board under section 27.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 30 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: \" (1) The Minister shall appoint a fit and proper person, on such terms and conditions as he may determine, as chief executive officer, who may be designated by any name as determined by the Board.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: \" (3) The Board shall appoint such number of other officers or servants, as it considers necessary for the efficient conduct of the business of the Board, on such terms and conditions as may be determined by the Board, who may be designated by any name as determined by the Board.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31 of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "31."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (1), (1A) and (1B);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \" (2) Subject to subsection (4), the disciplinary authority of the Board in respect of officers and servants of the Board shall be the Disciplinary Committee of the Board which shall consist of five members of the Board to be appointed by the Board, one of whom shall be appointed chairman of the Committee.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2A), by substituting for the word \"Chairman\" the word \"chairman\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in subsections (3) and (4), by deleting the word \"appropriate\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "@type": "akn:schedule",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 26C) THE PROVISIONS APPLICABLE TO A CORPORATION ESTABLISHED BY THE BOARD"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Duty of the Board to make regulations in respect of a corporation. The Board shall, on or before the date on which a corporation is established, make regulations in respect of the corporation defining—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "the purposes and objects for which the corporation is established;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "the rights, powers, duties and functions of the corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "the system of management of the corporation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "the relationship between the corporation and the Board and the right of control over the corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Scope of corporation. Nothing in this Act shall be construed to authorize the Board to establish any corporation for any purpose or object more extensive in scope than the purposes or objects for which the Board was constituted or as conferring on any corporation any right, duty, power or function which is not within the rights, duties, powers or functions of the Board under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Binding effect of such regulations. Subject to the provisions of this Act, and of any regulations made under section 71, regulations made under paragraph 1 shall be binding on the corporation in respect of which they were made and shall have effect for all purposes under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Register of corporation. The Board shall keep a register in the prescribed form of all corporations and such register together with copies of all regulations made under paragraph 1 shall be open to public inspection at such places and at such times as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Winding-up."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may by order published in the Gazette direct that any corporation be wound up and dissolved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the dissolution of any corporation under this paragraph, the assets of the corporation, after payment of all liabilities, shall be transferred to and vested in the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Legal character of a corporation. Every corporation shall be a body corporate by such name as the Board shall give to such corporation and shall have perpetual succession and a common seal and may sue and be sued in such name, and for the purpose of effecting the purposes and objects for which it was established, may enter into contracts and hold and deal in or with any movable or immovable property and may do all other matters and things incidental or appertaining to a body corporate not inconsistent with the provisions of this Act and subject to such restrictions or limitations as may be prescribed by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7",
      "schema:text": {
        "@language": "en",
        "@value": "Common seal of a corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "Every corporation shall have a common seal, which shall bear such device as the corporation, with the approval of the Board, may approve, and the seal may from time to time be broken, changed, altered and made anew by the corporation, with approval of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the corporation under this paragraph, the common seal of the Employees Provident Fund Board may be used as the common seal of the corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of, and shall be authenticated by, any person as the corporation may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~sched_7__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purporting to be sealed with the common seal of the corporation and authenticated by the person in whose custody of the common seal is kept shall, until the contrary is proved, be deemed to have been validly executed.\"."
      }
    }
  ]
}
