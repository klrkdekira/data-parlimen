      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsections (1A) and (1B), by substituting for the word \"Chairman\" the word \"chairman\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/13/eng@/~cl_11",
