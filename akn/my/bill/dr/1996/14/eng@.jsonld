      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may delegate all or any part of the powers of the Corporation vested in or exercisable by the Board to the Management Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall, with the approval of the Minister, appoint the Chairman of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint a Deputy Chairman of the Corporation.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 14 of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "14."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (f); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (k) by deleting the words \"and regulations\" appearing after the word \"bye-laws\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~sched_1__para_14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~sched_1__para_14",
      "@type": "akn:paragraph",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding sections 10 and 13 of this Act, the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "rules of the Corporation contained in the Second Schedule of the principal Act shall, in so far as it is not inconsistent with the principal Act as amended by this Act, remain in force until revoked or replaced by rules made under section 14 of the principal Act as amended by this Act."
      }
    }
  ]
}
