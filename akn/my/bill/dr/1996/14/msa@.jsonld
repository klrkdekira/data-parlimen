      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen itu sebagai subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_b",
