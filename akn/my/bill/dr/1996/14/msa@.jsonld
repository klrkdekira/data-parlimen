      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 18(1)(b) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \", bye-laws or regulations\" yang terdapat selepas perkataan \"rules\" dengan perkataan \"or bye-laws\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_13",
      "@type": "akn:clause",
