      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"bye- laws\" takrif yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
