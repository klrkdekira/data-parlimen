      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 3(4) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Director\" dengan perkataan \"person\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_4__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "5 dengan seksyen yang berikut: Income of 5. (1) The income of the Corporation shall Corpora- accrue to the Board. tion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Subsection (1) shall not prevent the payment or repayment of remuneration or expenses to any officer or servant of the Corporation or to any Member thereof in return for services rendered to the Corporation.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_5",
