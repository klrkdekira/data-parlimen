      "schema:name": {
        "@language": "ms",
        "@value": "Akta Pasaran Getah Malaysia (Perbadanan) 1962, yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_a",
