      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"rules\" dengan takrif yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "This Act shall be read and Act construed as one with the Malaysian Rubber Board (Incorporation) Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "In the event of any consistency occuring between the Act provisions of the Malaysian Rubber Board (Incorporation) Act 1996 and the provisions of this Act, the provisions of that Act shall prevail.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
