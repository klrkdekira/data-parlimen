      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"Secretary\" dengan menggantikan perkataan \"pursuant to the rules\" dengan perkataan \"under this Act\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_b__subpara_v",
