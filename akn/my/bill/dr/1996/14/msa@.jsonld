      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)— ' \"Board\" means the Malaysian Rubber Board established under Act . the Malaysian Rubber Board (Incorporation) Act 1996;'; ' \"Chairman\" means the Chairman of the Corporation appointed under section 12(3);'; ' \"Deputy Chairman\" means the Deputy Chairman of the Corporation appointed under section 12(4);'; \"Deputy Chairman\" takrif yang berikut: \"Management Committee\" means the Management Committee established under Act . section 17 of the Malaysian Rubber Board (Incorporation) Act 1996;'; ' \"rules\" means the rules made under section 14;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_2__para_b__subpara_i",
