      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \", bye-laws and regulations\" di mana-mana jua ia terdapat dengan perkataan \"and bye- laws\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_12",
      "@type": "akn:clause",
