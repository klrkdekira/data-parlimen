      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(b) dengan memasukkan selepas perkataan \"Ordinary Members\" perkataan \", Associate Members\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2). Pemotongan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memotong seksyen seksyen 8. 8. Penggantian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan seksyen seksyen 12. 12 dengan seksyen yang berikut: Manage- 12. (1) All the powers of the Corporation shall ment and be vested in and be exercisable by the Board administra- except in so far as the same are by this Act or tion of Corpora- by the rules expressly required to be exercised tion. by the Corporation in a general meeting or authorised to be delegated by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "The Board may delegate all or any part of the powers of the Corporation vested in or exercisable by the Board to the Management Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "The Board shall, with the approval of the Minister, appoint the Chairman of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "The Board may appoint a Deputy Chairman of the Corporation.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu adalah dipinda— seksyen 14."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (f); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (k) dengan memotong perkataan \"and regulations\" yang terdapat selepas perkataan \"bye-laws\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~sched_1__para_14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~sched_1__para_14",
      "@type": "akn:paragraph",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/14/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 10 dan 13 Akta ini, kaedah-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah Perbadanan yang terkandung dalam Jadual Kedua Akta ibu hendaklah, setakat yang ia tidak tak konsisten dengan Akta ibu sebagaimana yang dipinda oleh Akta ini, terus berkuatkuasa sehingga dibatalkan atau digantikan oleh kaedah-kaedah yang dibuat di bawah seksyen 14 Akta ibu sebagaimana yang dipinda oleh Akta ini."
      }
    }
  ]
}
