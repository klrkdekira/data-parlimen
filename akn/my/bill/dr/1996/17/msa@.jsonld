      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Cukai Jualan (Pindaan) 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Jualan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_2__subsec_3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Cukai Jualan 1972, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 1 dengan memasukkan selepas subseksyen (2) subseksyen yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini tidaklah terpakai bagi kawasan yang dikenali sebagai Kawasan Pembangunan Bersama.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas takrif \"kawalan kastam\" takrif yang berikut: \"Kawasan Pembangunan Bersama\" hendaklah mempunyai erti yang diberi kepadanya di bawah seksyen 2 Akta Pihak Berkuasa Bersama Akta 440. Malaysia-Thailand 1990;'."
      }
    }
