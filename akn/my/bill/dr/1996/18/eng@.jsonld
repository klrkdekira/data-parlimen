      "schema:name": {
        "@language": "en",
        "@value": "Service Tax (Amendment) Bill 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Service Tax (Amendment) short title. Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Service Tax Act 1975, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in section 1 by inserting after subsection (1) the following subsection: \" ( 1A) This Act shall not apply to the area known as the Joint Development Area.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended by inserting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "after the definition of \"goods\" the following definition: ' \"Joint Development Area\" has the meaning Act 440. assigned thereto in section 2 of the Malaysia- Thailand Joint Authority Act 1990;'."
      }
    }
  ]
