      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas takrif \"Kastam\" takrif yang berikut: ' \"Kawasan Pembangunan Bersama\" mem- punyai erti yane diberikan kepadanya dalam Akta 440. seksyen 2 Akta Pihak Berkuasa Bersama Malaysia-Thailand 1990;'."
