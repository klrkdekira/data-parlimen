      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"tahanan gaji\" dengan menggantikan noktah dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"tahanan gaji\" takrif yang berikut: ' \"tarikh yang ditetapkan\" ertinya suatu tarikh sebagaimana yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh-tarikh yang berlainan bagi mula berkuatkuasanya berbagai-bagai peruntukan dan tarikh-tarikh itu bolehlah lebih awal daripada tarikh Akta ini disiarkan.'."
      }
    },
