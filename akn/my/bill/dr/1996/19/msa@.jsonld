      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a) dengan memasukkan selepas perkataan \"angkatan sukarela\" perkataan \"dan tempoh minimum yang baginya orang-orang itu boleh ditauliahkan atau didaftarkan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_49__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (j) dengan memasukkan selepas perkataan \"kesalahan-kesalahan ringan\" perkataan \"termasuk perkara- perkara prosedur yang berhubung dengannya\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
