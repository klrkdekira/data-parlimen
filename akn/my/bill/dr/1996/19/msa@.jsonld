        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
