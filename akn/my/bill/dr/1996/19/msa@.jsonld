      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 36 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"peraturan-peraturan\" perkataan \"termasuk peraturan-peraturan yang memperuntukkan perkara-perkara yang boleh dikeluarkan melalui Majlis Angkatan Tentera\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"perkhidmatan mereka\" perkataan \"termasuk penyerapan, pertugasan dan peminjaman kepada mana-mana badan, angkatan atau perkhidmatan,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 51 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas subseksyen (2) subseksyen yang berikut: \" (3) Perintah tetap atau perintah biasa lain yang diperihalkan dalam subseksyen (2) bolehlah— (a) dibuat; dan (b) disiarkan dalam apa-apa sebagaimana yang boleh ditentukan oleh, Ketua Perkhidmatan bagi setiap Perkhidmatan atau mana-mana pegawai yang diberikuasa olehnya.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 81(b) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"pegawai waran, ketua pegawai kecil, pegawai tidak bertauliah atau pegawai kecil\" dengan perkataan \"askar-laskar\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_19",
