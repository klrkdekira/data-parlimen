      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Angkatan Tentera (Pindaan) 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_1__subsec_1",
