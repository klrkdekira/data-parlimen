      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 93 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
