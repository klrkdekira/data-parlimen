      "schema:name": {
        "@language": "ms",
        "@value": "Akta Angkatan Tentera 1972, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_20",
