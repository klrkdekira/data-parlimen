      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \", naib leftenan laut atau naib leftenan udara\" dengan perkataan \"atau yang setaraf dengannya\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_35",
      "@type": "akn:clause",
