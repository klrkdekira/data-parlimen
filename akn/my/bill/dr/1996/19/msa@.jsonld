      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas \"penangkapan\" takrif yang berikut: ' \"Perintah Majlis Angkatan Tentera\" ertinya arahan atau perintah yang dikeluarkan oleh Majlis Angkatan Tentera menurut Akta ini;';"
      }
    },
