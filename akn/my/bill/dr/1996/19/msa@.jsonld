      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"pegawai\" dengan menggantikan perkataan \", kadet laut, pegawai kadet atau kadet udara\" dengan perkataan \"atau pegawai kadet\";"
      }
    },
