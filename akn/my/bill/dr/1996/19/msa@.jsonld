      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 213 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"pangkat- pangkat yang tidak bertauliah\" di mana jua terdapat dalamnya dengan perkataan \"askar- laskar\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (6) subseksyen yang berikut: \" (7) Berkenaan dengan Bahagian V, bagi maksud seksyen ini, jika mana-mana peruntukan dalamnya menetapkan bahawa sesuatu tindakan boleh dilakukan oleh seseorang anggota angkatan tetap yang mempunyai suatu pangkat tertentu atau yang memegang sesuatu jawatan tertentu, dan Simpanan Angkatan Tetap atau angkatan sukarela tidak mempunyai seorang anggota yang mempunyai pangkat sedemikian atau memegang jawatan sedemikian, maka seorang anggota angkatan tetap yang mempunyai pangkat itu atau yang memegang jawatan itu boleh menjalankan tindakan sedemikian berhubungan dengan seseorang anggota Simpanan Angkatan Tetap atau angkatan sukarela.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Angkatan Tentera (Pindaan) 1984 adalah dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ini dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B",
      "@type": "akn:clause",
      "eli:number": "5B",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Angkatan Tentera boleh mempertugaskan buat sementara mana-mana pegawai atau askar-laskar kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana angkatan pelawat yang ada di Malaysia menurut perenggan (b) subseksyen (1) seksyen 17 Akta Angkatan Pelawat 1960; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana angkatan asing sesuatu negara lain di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perintah yang dibuat menurut perenggan (b) subseksyen (1) hendaklah mengikat pegawai atau askar-laskar, mengikut mana-mana yang berkenaan, kepada undang- undang tentera di bawah Akta ini setakat, dan tertakluk kepada apa-apa padanan dan ubahsuaian sebagaimana yang diperuntukkan oleh atau di bawah mana-mana undang-undang bertulis berhubung dengan pertugasan anggota angkatan itu di negara itu. 5c. Majlis Angkatan Tentera boleh meminjamkan seseorang pegawai atau askar- laskar ke perkhidmatan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu jabatan Kerajaan Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu Negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu pihak berkuasa tempatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan berkanun; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5B__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu organisasi, di dalam atau di luar Malaysia: Dengan syarat bahawa pegawai atau askar- laskar itu, mengikut mana-mana yang berkenaan, hendaklah terus menjadi anggota angkatan tetap tetapi saraannya hendaklah RANG UNDANG-UNDANG dibayar oleh jabatan Kerajaan Persekutuan, Negeri, pihak berkuasa atau organisasi itu, mengikut mana-mana yang berkenaan, yang kepada perkhidmatannya dia dipinjamkan. Kegunaan 5D. Seksyen 5A, 5B dan 5c tidaklah terpakai bagi berhubungan dengan kegunaan bagi maksud maksud operasi. operasi pegawai atau askar-laskar, mengikut mana-mana yang berkenaan.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5D",
      "@type": "akn:clause",
      "eli:number": "5D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "\"Perkhid- 5A. Majlis Angkatan Tentera"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "matan menghendaki seseorang pegawai atau askar- di luar Malaysia. laskar berkhidmat di luar Malaysia. ANGKATAN TENTERA (PINDAAN) 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkannya semula sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula itu subseksyen yang berikut: \" (2) Jika orang yang dikurniakan sesuatu tauliah di bawah subseksyen (1) adalah seorang pegawai dalam angkatan sukarela, Majlis Angkatan Tentera boleh menerima perkhidmatan yang diambil kira pegawai itu, jika ada, termasuk pangkatnya yang terakhir dan perkara-perkara lain yang berkaitan dengannya, sebagai perkhidmatan yang diambil kira. (3) Bagi maksud subseksyen (2), seksyen 15 hendaklah terpakai.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota birai dengan nota birai yang berikut: \"Perlantikan pegawai muda laut dan pegawai kadet.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"pemangku naib leftenan laut, pegawai muda laut, kadet laut, pegawai kadet atau kadet udara\" di mana jua terdapat dalamnya dengan perkataan \"pegawai muda laut atau pegawai kadet\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 10 seksyen yang berikut: Pegawai 10A. Tertakluk kepada mana-mana peraturan kadet yang dibuat di bawah Bahagian ini, seseorang boleh membayar pegawai kadet, selain daripada askar-laskar untuk yang telah dilantik sebagai pegawai kadet, boleh, pember- sebelum habis tempoh tiga bulan mulai dari hentian kerja. tarikh perlantikannya, memohon kepada pihak berkuasa kompeten bagi pemberhentian kerja dan dengan keizinan Majlis Angkatan Tentera dan atas pembayaran sejumlah wang yang tidak melebihi enam bulan elaunnya sebagaimana yang ditetapkan dia hendaklah diberhentikan kerja dengan seberapa segera yang boleh.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 12(2) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \", leftenan dalam Tentera Laut dan Ieftenan udara dalam Tentera Udara\" dengan perkataan \"atau yang setaraf dengannya dalam Tentera Laut dan Tentera Udara\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai dengan memasukkan selepas perkataan \"satu perkhidmatan lain\" perkataan \"atau dalam Perkhidmatan yang sama\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dengan memasukkan selepas perkataan \"satu Perkhidmatan lain\" perkataan \", atau daripada satu kor atau cawangan kepada satu kor atau cawangan lain dalam Perkhidmatan yang sama,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/19/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dan (3) dengan memasukkan selepas perkataan \"Perkhidmatan\" di mana jua terdapat dalamnya perkataan \", kor atau cawangan\"."
      }
    }
  ]
