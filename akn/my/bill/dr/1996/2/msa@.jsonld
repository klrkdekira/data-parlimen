        "@language": "ms",
        "@value": "PEMERIKSAAN INSTITUSI PENDIDIKAN TINGGI SWASTA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_71"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUATKUASAAN DAN PENYIASATAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Bahagian ini, \"pegawai penyiasat\" ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar, Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar dan Penolong Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai polis yang berpangkat tidak rendah daripada Inspektor; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai awam lain yang diberikuasa secara bertulis oleh Ketua Pendaftar untuk melaksanakan apa-apa kewajipan berhubungan dengan penguatkuasaan dan penyiasatan di bawah Bahagian ini sebagaimana yang dinyatakan dalam pemberikuasaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat hendaklah mempunyai segala kuasa yang perlu untuk menjalankan penyiasatan tentang kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat yang menjalankan penyiasatan di bawah Akta ini boleh memasuki mana-mana tempat atau bangunan dan boleh memeriksa, membuat salinan, membuat cabutan daripada, mengalihkan dan menahan apa-apa buku, buku minit, daftar, dokumen, bahan atau barang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat boleh, melalui notis secara bertulis, menghendaki mana-mana orang memberikan kepadanya apa-apa buku, buku minit, daftar, dokumen barang atau bahan yang berada dalam milikan atau jagaan atau di bawah kawalan orang itu atau berada dalam kuasa orang itu untuk diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengemukakan apa-apa buku, buku minit, daftar, dokumen, bahan atau barang yang dikehendaki oleh seseorang pegawai penyiasat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menghalang atau menggendalakan seseorang pegawai penyiasat yang sedang menjalankan mana-mana kuasa di bawah seksyen ini, adalah melakukan suatu kesalahan, dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat boleh memberikan kebenaran kepada mana-mana orang untuk memeriksa buku, buku rninit, daftar, dokumen, bahan atau barang yang ditahan dan diambil milik oleh pegawai penyiasat di bawah subseksyen (2) jika orang itu berhak di bawah Akta ini untuk memeriksa buku, buku minit, daftar, dokumen, bahan atau barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini tidak boleh ditafsirkan sebagai menghadkan atau menyentuh apa-apa kuasa yang serupa yang diberikan kepada mana-mana orang di bawah mana- mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika didapati oleh Majistret, daripada maklumat bertulis yang dibuat atas sumpah dan selepas apa-apa siasatan yang difikirkannya perlu, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana premis telah digunakan atau sedang hendak digunakan bagi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat di dalam mana-mana premis keterangan yang diperlukan bagi membuktikan, pelakuan suatu kesalahan di bawah Akta ini, maka Majistret boleh mengeluarkan waran yang memberikuasa pegawai penyiasat untuk, pada bila-bila masa yang munasabah sama ada siang atau malam dan sama ada dengan bantuan atau tanpa bantuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memasuki premis itu, dengan kekerasan jika perlu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menggeledah dan menyita dan mengalihkan daripadanya apa-apa buku, buku minit, daftar, bahan, dokumen, barang atau apa-apa benda lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berkenaan dengannya suatu kesalahan telah dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berkenaan dengannya suatu kesalahan disyaki telah dilakukan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_1__para_b__subpara_bb",
      "schema:text": {
        "@language": "ms",
        "@value": "yang semunasabahnya dipercayai dapat dijadikan keterangan tentang pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memecahkan mana-mana pintu luar atau pintu dalam premis itu atau mana-mana pagar, kepungan, pintu pagar atau halangan lain ke premis itu supaya dapat masuk ke dalamnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengalihkan dengan menggunakan kekerasan apa-apa halangan kepada kemasukan, penggeledahan, penyitaan atau pengalihan yang berkenaan dengannya dia mempunyai kuasa di bawah subseksyen (1) untuk melakukan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menahan tiap-tiap orang yang didapatinya dalam premis itu sehingga premis itu selesai diperiksa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai penyiasat mempunyai sebab"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang munasabah untuk mempercayai bahawa disebabkan kelengahan mendapatkan waran geledah di bawah seksyen 67 maka—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "penyiasatan itu akan terjejas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "tujuan kemasukan itu mungkin terkecewa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "buku, buku minit, daftar, dokumen, bahan, atau apa-apa benda lain yang dicari mungkin dialihkan atau diganggu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "keterangan yang dicari mungkin diganggu atau dimusnahkan, 56 RANG UNDANG-UNDANG dia boleh menjalankan, di dalam dan berkenaan dengan premis itu, segala kuasa yang disebut dalam seksyen 67 secara yang sepenuhnya dan secukupnya seolah-olah dia telah diberikuasa berbuat sedemikian melalui waran yang dikeluarkan di bawah seksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pegawai penyiasat mempunyai alasan yang munasabah untuk mempercayai bahawa mana-mana rumah, bangunan, premis atau tempat lain digunakan sebagai institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa diluluskan dan didaftarkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan melanggar apa-apa syarat yang dikenakan oleh Menteri atau Ketua Pendaftar, maka pegawai penyiasat itu boleh dengan serta-merta mengambil apa-apa langkah yang difikirkannya perlu atau dengan apa-apa cara mengunci institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang menggunakan rumah, bangunan, premis atau tempat yang telah dikunci itu sebagai institusi pendidikan tinggi swasta hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam masa dua puluh satu hari dari penguncian itu mengemukakan kepada Ketua Pendaftar perakuan pendaftaran institusi pendidikan tinggi swasta itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menanggung apa-apa kos yang dilakukan berbangkit daripada tindakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Kunci itu hendaklah dibuka jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu mematuhi keperluan subseksyen (2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "perintah mahkamah didapatkan terhadap orang itu untuk berhenti daripada menggunakan rumah, bangunan, premis atau tempat itu sebagai institusi pendidikan tinggi swasta, mengikut mana-mana satu yang lebih awal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat yang melakukan tindakan di bawah seksyen ini tidaklah bertanggungan bagi apa-apa kos yang berbangkit daripada tindakan yang sedemikian atau kerosakan pada rumah, bangunan, premis atau tempat yang dikunci di bawah seksyen ini melainkan jika kerosakan itu telah dilakukan dengan sengaja."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang dilakukan di bawah seksyen ini berkenaan dengan mana-mana rumah, bangunan, premis atau tempat lain tidaklah menghalang pendakwaan terhadap mana-mana orang yang menggunakan rumah, bangunan, premis atau tempat itu sebagai institusi pendidikan tinggi swasta secara yang berlawanan dengan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penyiasat boleh, melalui notis secara bertulis, menghendaki mana-mana orang yang tahu tentang fakta dan keadaan sesuatu kes hadir di hadapannya dan untuk diperiksa secara lisan dan hendaklah mengubah ke dalam bentuk bertulis apa-apa pernyataan yang dibuat oleh orang yang diperiksa sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu hendaklah terikat di sisi undang-undang untuk menjawab soalan-soalan berhubungan dengan kes itu yang dikemukakan kepadanya oleh pegawai penyiasat dan untuk menyatakan yang benar, sama ada atau tidak pernyataan itu dibuat keseluruhannya atau sebahagiannya bagi menjawab soalan-soalan, dan tidak boleh enggan untuk menjawab apa-apa soalan atas alasan bahawa soalan itu mungkin menunjukkan bahawa dia bersalah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah ditulis dan ditandatangani oleh orang yang membuatnya atau dicapkan dengan cap ibu jarinya, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas pernyataan itu dibacakan kepadanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas dia diberikan peluang untuk membuat apa-apa pembetulan yang dimahukannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang diperiksa di bawah seksyen ini enggan menandatangani atau mengecapkan cap ibu jarinya atas pernyataan itu, pegawai penyiasat hendaklah mengendorskan padanya di bawah tandatangannya hakikat keengganan itu dan sebabnya, jika ada, yang dinyatakan oleh orang yang diperiksa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pernyataan yang dibuat dan direkodkan di bawah seksyen ini boleh diterima sebagai keterangan dalam mana-mana prosiding di dalam mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak hadir di hadapan seseorang pegawai penyiasat sebagaimana yang dikehendaki di bawah subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk menjawab apa-apa soalan yang dikemukakan kepadanya oleh seseorang pegawai penyiasat di bawah subseksyen (2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_70__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kepada seseorang pegawai penyiasat maklumat atau pernyataan yang palsu atau mengelirukan dalam apa-apa butir material, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu .tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada seorang pun adalah, dalam apa-apa prosiding"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "di hadapan mana-mana mahkamah berkenaan dengan penyitaan apa-apa jua pun yang disita atau ditahan pada menjalankan atau berupa menjalankan mana-mana kuasa yang diberikan kepadanya di bawah Bahagian ini, berhak mendapat kos prosiding itu atau apa-apa gantirugi atau relief lain, selain daripada perintah pemulangan benda yang disita atau ditahan itu, atau bayaran berdasarkan nilainya, melainkan jika penyitaan atau penahanan itu dibuat tanpa sebab yang munasabah atau berpatutan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, dari semasa ke semasa,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa atau menyebabkan diperiksa institusi pendidikan tinggi swasta yang didaftarkan di bawah Akta ini bagi maksud memastikan bahawa Akta ini dan peraturan-peraturan yang dibuat di bawah Akta ini telah dan sedang dipatuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam menjalankan pemeriksaan di bawah seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "63, Ketua Pendaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "memasuki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kawasan termasuklah bangunan atau struktur di atasnya yang dipunyai atau digunakan oleh, sama ada secara tetap atau selainnya, atau sama ada didaftarkan atau tidak bagi kegunaan, institusi pendidikan tinggi swasta; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana premis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa apa-apa buku, daftar, dokumen, bahan atau barang lain yang difikirkannya perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "mengalihkan dan menahan apa-apa buku, daftar, dokumen, bahan atau barang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "yang didapati olehnya boleh memudaratkan kepentingan Malaysia, orang awam atau pelajar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "yang pada pendapatnya, boleh dijadikan keterangan tentang suatu kesalahan yang dilakukan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki mana-mana orang, sebagai anggota lembaga pengarah, ketua eksekutif, pekerja atau pelajar institusi pendidikan tinggi swasta itu, supaya mengemukakan bagi pemeriksaannya apa-apa buku, daftar, dokumen, bahan atau barang lain yang berada dalam milikan atau jagaan atau di bawah kawalannya atau yang berada dalam kuasanya untuk diberi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan pengurusan institusi pendidikan tinggi swasta itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII__cl_64__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan pengajaran yang dijalankan dalam institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "@type": "akn:part",
      "eli:number": "XIV",
