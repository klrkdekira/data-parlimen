      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak ia ditubuhkan di bawah mana-mana undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a__subpara_ii",
