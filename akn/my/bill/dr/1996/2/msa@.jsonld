      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu institusi pendidikan tinggi swasta tidak menyebabkan dipamerkan salinan perakuan pendaftaran institusi pendidikan tinggi swasta itu mengikut peruntukan subseksyen 26(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila sesuatu institusi pendidikan tinggi swasta ditutup, ketua eksekutif itu tidak memulangkan kepada Ketua Pendaftar perakuan pendaftaran- nya dan perakuan pendaftaran pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang bekerja atau menjadi guru di institusi pendidikan tinggi swasta yang tidak diluluskan dan didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ketua eksekutif sesuatu institusi pendidikan tinggi swasta tidak didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang mengajar di institusi pendidikan tinggi swasta tanpa permit mengajar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu institusi pendidikan tinggi swasta mengambil kerja seorang ketua eksekutif yang tidak didaftarkan di bawah Akta ini atau seorang guru yang tidak dikeluarkan kepadanya permit mengajar di bawah Akta ini, maka institusi pendidikan tinggi swasta atau ketua eksekutif atau orang itu, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal suatu kesalahan di bawah perenggan (l)(c) hingga (f), adalah menjadi suatu pembelaan bagi seseorang atau seseorang ketua eksekutif atau sesuatu institusi pendidikan tinggi swasta jika dia atau ia membuktikan bahawa setelah mengambil segala langkah berjaga-jaga yang munasabah bagi mengelakkan daripada melakukan kesalahan yang sedemikian, dia atau ia tidak tahu atau tidak mempunyai apa-apa alasan yang munasabah untuk mengesyaki bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta itu tidak diluluskan atau didaftarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ketua eksekutif itu tidak didaftarkan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak mempunyai permit mengajar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah Akta ini yang berkenaan dengannya tiada penalti diperuntukkan dengan nyata, apabila disabitkan boleh didenda tidak melebihi lima ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah, dalam hal kesalahan yang berterusan, sebagai tambahan kepada apa-apa penalti lain yang boleh dikenakan ke atasnya di bawah Akta ini berkenaan dengan kesalahan itu, didenda tidak melebihi lima ratus ringgit bagi setiap hari kesalahan itu berterusan selepas sabitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika suatu pertubuhan perbadanan melakukan suatu"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang, pada masa kesalahan itu dilakukan merupakan pengarah, pengurus, setiausaha, atau pegawai yang seumpamanya bagi pertubuhan perbadanan itu, boleh didakwa secara berasingan atau bersesama dalam prosiding yang sama dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap pengarah, pengurus, setiausaha atau pegawai yang seumpamanya bagi pertubuhan perbadanan itu, yang dalam apa-apa cara, melalui perbuatan atau peninggalan secara langsung atau tak langsung terlibat dengan atau menjadi pihak dalam pelakuan kesalahan itu hendaklah disifatkan telah melakukan kesalahan itu, INSTITUSI PENDIDIKAN TINGGI SWASTA melainkan jika dia membuktikan bahawa kesalahan itu telah dilakukan tanpa pengetahuannya atau pembiarannya atau bahawa dia telah mengambil segala langkah berjaga- jaga yang munasabah atau bahawa dia telah mengambil segala usaha yang wajar bagi mengelakkan kesalahan itu daripada berlaku."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan terhadap mana-mana peruntukan Akta ini telah dilakukan oleh suatu institusi pendidikan tinggi swasta atau mana-mana orang yang pada masa kesalahan itu dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah anggota lembaga pengarah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah pengurus;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah setiausaha;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang jawatan atau kedudukan yang serupa dengan pengurus atau setiausaha syarikat yang menubuhkan institusi pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah ketua eksekutif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah kerani;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah pengkhidmat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah ejen, institusi pendidikan tinggi swasta itu, hendaklah disifatkan telah melakukan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah menjadi suatu pembelaan bagi mana-mana orang yang didakwa menurut subseksyen (1) jika dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya atau pembiarannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil segala langkah berjaga-jaga yang munasabah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan segala usaha yang wajar, bagi mengelakkan kesalahan itu daripada berlaku, sebagaimana yang sepatutnya diambil dan dijalankan olehnya, dengan mengambil kira sifat fungsinya dalam kapasiti itu dan segala hal keadaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta yang boleh dikenakan hukuman atau penalti di bawah Akta ini bagi apa-apa perbuatan atau peninggalan hendaklah bertanggungan bagi hukuman atau penalti yang sama bagi apa-apa perbuatan atau peninggalan sedemikian yang dilakukan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ejen yang bertindak bagi pihaknya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kerani atau pengkhidmat yang bertindak semasa dalam penggajian institusi pendidikan swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pekongsi, ejen, kerani atau pengkhidmat, atau kerani atau pengkhidmat pekongsi atau ejen itu, tidaklah terlepas daripada pendakwaan di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, dengan kebenaran bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh institusi pendidikan tinggi swasta atau seseorang di bawah Akta ini atau peraturan-peraturan yang dibuat di bawah Akta ini, yang ditetapkan sebagai kesalahan yang boleh dikompaun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Tawaran bertulis hendaklah dibuat kepada orang itu untuk mengkompaun kesalahan itu dengan membayar kepada Ketua Pendaftar apa-apa jumlah wang yang dinyatakan, yang tidak melebihi lima puluh peratus denda maksimum yang boleh dikenakan kepada orang itu jika dia disabitkan atas kesalahan itu, dalam masa apa-apa tempoh yang dinyatakan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada prosiding selanjutnya boleh diambil dan tiada pendakwaan boleh dimulakan terhadap orang yang kepadanya tawaran kompaun telah dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang, buku, buku minit, daftar, dokumen, bahan atau barang lain yang disita berkaitan dengan kesalahan itu, boleh dilepaskan tertakluk kepada syarat yang boleh dikenakan selaras dengan syarat kompaun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa wang yang diterima oleh Ketua Pendaftar di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika amaun yang dinyatakan dalam tawaran kompaun tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau dalam apa-apa tempoh lanjutan yang diberikan oleh Ketua Pendaftar, maka pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), Ketua Pendaftar, Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar, Penolong Pendaftar atau seorang pegawai polis yang berpangkat tidak rendah daripada Inspektor, hendaklah diberikuasa untuk hadir di dalam mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menjalankan apa-apa pendakwaan berkenaan dengan suatu kesalahan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud apa-apa prosiding undang-undang yang lain di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar atau Penolong Pendaftar, pemberikuasaan itu adalah tertakluk kepada kelulusan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendakwaan berkenaan dengan kesalahan di bawah Akta ini tidak boleh dimulakan atau dijalankan tanpa kebenaran bertulis Pendakwa Raya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas kerelaannya sendiri seorang ketua eksekutif memberitahu Menteri atau jika daripada hasil pemeriksaan yang dibuat di bawah Bahagian XII atau atas apa-apa sebab lain Menteri berpendapat bahawa sesuatu institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak dapat memenuhi obligasinya kepada pelajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hampir menggantung kegiatan perniagaannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_cc"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sedang menjalankan aktivitinya dalam cara yang memudaratkan kepentingan Malaysia, orang awam atau pelajar, maka Menteri boleh, tanpa menjejaskan keluasan kuasa Menteri untuk memberikan arahan di bawah seksyen 5, demi melindungi kepentingan Malaysia, orang awam dan pelajar institusi pendidikan tinggi swasta itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan supaya institusi pendidikan tinggi swasta yang berkenaan mengambil apa-apa langkah yang difikirkan patut oleh Menteri untuk membetulkan apa-apa perkara atau membaiki apa-apa hal keadaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan supaya seseorang atau suatu jawatankuasa dilantik, atau Menteri sendiri melantik seseorang atau jawatankuasa, untuk menasihatkan ketua eksekutif tentang cara pengurusan institusi pendidikan tinggi swasta itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil apa-apa tindakan yang difikirkan perlu oleh Menteri dalam hal keadaan kes itu untuk menjadikan hal- ehwal institusi pendidikan tinggi swasta itu selaras dengan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap arahan Menteri yang dibuat di bawah subseksyen (1) atau nasihat atau arahan seseorang atau sesuatu jawatankuasa yang dilantik di bawah perenggan (1)(bb) hendaklah mengikut institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Kesemua perbelanjaan yang dilakukan oleh orang atau jawatankuasa yang dilantik di bawah perenggan (1)(bb) hendaklah dibayar oleh institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu institusi pendidikan tinggi swasta tidak mematuhi apa-apa nasihat atau arahan yang diberikan kepadanya oleh orang atau jawatankuasa yang dilantik di bawah perenggan (1)(bb), maka ketakpatuhan itu boleh dijadikan alasan untuk membatalkan kelulusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu institusi pendidikan tinggi swasta hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menghentikan kegiatan perniagaannya dan menamatkan kursus pengajiannya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "kelulusan bagi penubuhannya telah dibatalkan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftarannya telah dikenselkan oleh Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "lembaga pengarah memutuskan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "syarikat yang dengannya institusi pendidikan tinggi swasta itu ditubuhkan telah digulung—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh lembaga pengarah syarikat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui perintah mahkamah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta itu terpaksa ditutup atas apa-apa sebab lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu institusi pendidikan tinggi swasta yang sedang hendak menghentikan kegiatan perniagaannya kecuali atas sebab-sebab yang dinyatakan dalam perenggan 59(a) dan (b) dan subperenggan 59(d)(ii), hendaklah memberikan notis tentang niatnya untuk berbuat sedemikian sekurang-kurangnya bagi tempoh selama satu tahun kalender sebelum penutupannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis di bawah subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat kepada Ketua Pendaftar oleh ketua eksekutif institusi pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disampaikan melalui surat berdaftar Akuan Terima kepada pelajar institusi pendidikan tinggi swasta itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disiarkan dalam akhbar, sekurang-kurangnya satu dalam bahasa kebangsaan dan satu lagi dalam apa-apa bahasa lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penutupan institusi pendidikan tinggi swasta adalah atas sebab dalam perenggan 59(a) dan (b) dan subperenggan 59(d)(ii), maka institusi pendidikan tinggi swasta itu hendaklah dalam masa dua puluh satu hari selepas diberitahu tentang keputusan Menteri untuk membatalkan kelulusannya, keputusan Ketua Pendaftar untuk mengkenselkan pendaftarannya atau perintah mahkamah supaya syarikat digulung, mengikut mana- mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyampaikan notis penutupannya kepada pelajarnya melalui surat berdaftar Akuan Terima; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan notis penutupannya dalam akhbar, sekurang-kurangnya satu dalam bahasa kebangsaan dan satu lagi dalam apa-apa bahasa lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penutupan institusi pendidikan tinggi swasta itu ialah kerana alasan dalam perenggan 56(e), ketua eksekutif hendaklah meminta arahan daripada Ketua Pendaftar berkenaan dengan pemberitahuan penutupannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta yang melanggar seksyen ini adalah melakukan suatu kesalahan dan apabila disabitkan, boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila institusi pendidikan tinggi swasta ditutup,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "lembaga pengarah hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa perkiraan yang memudaratkan atau menjejaskan kepentingan, kebajikan atau hasrat pelajar, sebagaimana yang perlu, bagi penerusan pendidikan pelajar institusi pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu Ketua Pendaftar tentang perkiraan yang dibuat di bawah perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "mendapatkan kelulusan Ketua Pendaftar sebelum melaksanakan perkiraan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu Ketua Pendaftar penyelesaian perkiraan itu setelah perkiraan itu dimuktamadkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Apabila suatu institusi pendidikan tinggi swasta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ditutup, ketua eksekutif hendaklah memulangkan perakuan pendaftarannya dan perakuan pendaftaran institusi pendidikan tinggi swasta itu kepada Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV",
      "@type": "akn:part",
      "eli:number": "XV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERATURAN-PERATURAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI",
      "@type": "akn:part",
      "eli:number": "XVI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_91",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII",
      "@type": "akn:part",
      "eli:number": "XVII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN KECUALIAN DAN PERALIHAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-Peraturan Perlu (Yayasan Pengajian Tinggi) 1969 adalah dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), semua institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang ditubuhkan di bawah Peraturan-Peraturan Perlu (Yayasan Pengajian Tinggi) 1969; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang didaftarkan atau disifatkan telah didaftarkan . di bawah Akta Pendidikan 1996, hendaklah, pada tarikh mula berkuatkuasanya Akta ini, disifatkan telah diluluskan, ditubuhkan dan didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Syarat yang dikenakan ke atas institusi pendidikan tinggi swasta yang disebut dalam perenggan (2)(a) dan (b), sebelum mula berkuatkuasanya Akta ini, hendaklah terus berkuatkuasa sehingga diubah atau dibatalkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini hendaklah terpakai bagi institusi pendidikan tinggi swasta itu seolah-olah institusi pendidikan tinggi swasta itu telah diluluskan, ditubuhkan dan didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran sementara yang dikeluarkan atau disifatkan telah dikeluarkan kepada suatu institusi pendidikan tinggi swasta di bawah Akta . Pendidikan 1996, hendaklah ditukarkan menjadi dan disifatkan menjadi suatu perakuan pendaftaran yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada syarat yang boleh dikenakan di bawah mana-mana peruntukan Akta ini, institusi pendidikan tinggi swasta itu hendaklah juga mematuhi apa-apa syarat lain yang boleh dikenakan oleh Ketua Pendaftar, dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui kaedah-kaedah, membuat apa-apa peruntukan yang difikirkannya perlu atau suaimanfaat bagi maksud menghapuskan apa-apa kesukaran yang ditimbulkan oleh pemakaian Akta ini bagi institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang ditubuhkan di bawah Peraturan-Peraturan Perlu (Yayasan Pengajian Tinggi) 1969;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang didaftarkan atau disifatkan telah didaftarkan . di bawah Akta Pendidikan 1996; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang kepadanya perakuan pendaftaran sementara telah dikeluarkan atau disifatkan . dikeluarkan di bawah Akta Pendidikan 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa Menteri di bawah subseksyen (1) hendaklah termasuk kuasa untuk membuat apa-apa ubahsuaian bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, pada tarikh mula berkuatkuasanya Akta ini, sedang bekerja dengan suatu institusi pendidikan tinggi swasta sebagai guru sama ada secara sepenuh masa atau sambilan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berdaftar sebagi guru atau disifatkan telah berdaftar sebagai guru di bawah Akta Pendidikan 1996 hendaklah, dalam masa satu bulan dari tarikh mula berkuatkuasanya Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah dikeluarkan kepadanya atau disifatkan telah dikeluarkan kepadanya permit mengajar di bawah Akta Pendidikan 1996 hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam masa satu bulan sebelum permit itu habis tempoh; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam masa satu bulan dari tarikh mula berkuatkuasanya Akta ini, mengikut mana-mana satu terkemudian, memohon untuk mendapatkan permit mengajar di bawah Bahagian IX Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Sementara menanti permohonan bagi mendapatkan permit mengajar yang disebut di bawah subseksyen (1) diputuskan, orang itu boleh terus mengajar di institusi pendidikan tinggi swasta itu dan hendaklah dalam hal keadaan itu disifatkan mengajar secara sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Surat akuan terima yang dikeluarkan oleh Ketua Pendaftar berkenaan dengan permohonan untuk mendapatkan permit mengajar di bawah seksyen ini hendaklah menjadi bukti yang mencukupi pembuatan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45",
      "@type": "akn:chapter",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, jika difikirkannya wajar dan demi kepentingan sesuatu institusi pendidikan tinggi swasta atau demi kepentingan pelajar atau orang awam, melalui perintah yang disiarkan dalam Warta, mengecualikan institusi pendidikan tinggi swasta itu daripada mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengecualian yang diberikan di bawah subseksyen (1) adalah tertakluk kepada apa-apa syarat yang dinyatakan oleh Menteri dalam perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa mengecualikan di bawah subseksyen (1) tidaklah termasuk peruntukan tentang kelulusan bagi penubuhan institusi pendidikan tinggi swasta dan pendaftarannya, dan peruntukan seksyen 38 dan 39."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada bila-bila masa, menggunakan budi bicaranya membatalkan pengecualian di bawah seksyen ini atau mengubah atau menambah kepada syarat pengecualian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota lembaga pengarah, ketua eksekutif atau mana-mana orang yang bertanggungjawab bagi pengurusan sesuatu institusi pendidikan tinggi swasta hendaklah memastikan bahawa pada sepanjang masa premis institusi pendidikan tinggi swasta itu mematuhi apa-apa piawai yang ditetapkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), jika Menteri berpuas hati berkenaan dengan mana-mana institusi pendidikan tinggi swasta bahawa setelah mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keadaan tapaknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana bangunan yang sedia ada di atas tapak itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hal keadaan tertentu yang lain yang menyentuh premis itu, adalah tidak munasabah dalam keadaan yang sedemikian untuk menghendaki institusi pendidikan tinggi swasta itu mematuhi keperluan dalam peraturan-peraturan mengenainya dalam apa-apa aspek tertentu, maka Menteri boleh mengarahkan supaya premis itu disifatkan mematuhi piawai yang ditetapkan jika sebagai ganti pematuhan kepada piawai yang ditetapkan itu, premis itu mematuhi apa-apa kehendak lain yang ditentukan dalam arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa notis, perintah, dokumen atau perhubungan lain yang dikehendaki diberikan atau disampaikan di bawah Akta ini kepada institusi pendidikan tinggi swasta boleh, melainkan jika cara penyampaian yang lain ditetapkan, dihantar melalui pos berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah disifatkan bahawa notis, perintah, dokumen atau apa-apa perhubungan itu telah disampaikan pada hari yang berikutan hari notis, perintah, dokumen atau perhubungan itu sepatutnya diterima dalam perjalanan biasa pos."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang yang kepadanya suatu surat berdaftar di bawah subseksyen (1) dialamatkan, diberitahu hakikat tentang adanya surat berdaftar yang menantinya di pejabat pos dan jika orang itu enggan atau mengabaikan untuk mengambil surat berdaftar itu maka notis, perintah, dokumen atau perhubungan itu hendaklah disifatkan telah disampaikan kepadanya pada tarikh yang dia dimaklumkan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan yang ditubuhkan oleh Menteri di bawah atau disifatkan ditubuhkan di bawah Akta Pendidikan 1996;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi yang ditubuhkan di bawah Akta Institut Teknologi MARA 1976;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Universiti atau Kolej Universiti yang ditubuhkan di bawah Akta Universiti dan Kolej Universiti 1971; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__chp_45__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan yang ditubuhkan di bawah mana-mana undang-undang bertulis lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Perkara 153 Perlembagaan Persekutuan, keanggotaan institusi pendidikan tinggi swasta, sama ada sebagai pegawai, guru atau pelajar, hendaklah dibuka kepada semua orang tanpa mengira jantina, ras, agama, bangsa atau kelas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada ujian mengenai agama yang dianuti atau kepercayaan boleh diadakan atau dipaksakan untuk membolehkan seseorang berhak diterima sebagai anggota sedemikian atau untuk dianugerahkan apa-apa ijazah, diploma atau sijil atau fellowship, biasiswa, bantuan, dermasiswa, pingat, hadiah, atau kepujian atau penganugerahan lain boleh dihadkan bagi orang daripada mana-mana ras, agama, bangsa atau kelas tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada tindakan boleh diambil atau pendakwaan boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dibawa, dimulakan atau dibuat terhadap Kerajaan, Menteri, Ketua Pendaftar, Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar atau Penolong Pendaftar atau terhadap mana-mana pegawai Kerajaan atau mana-mana orang yang bertindak di bawah arahan Menteri atau Ketua Pendaftar, di dalam mana-mana mahkamah bagi apa-apa perkara yang dilakukan atau ditinggalkan daripada dilakukan di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan suci hati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan semunasabahnya mempercayai bahawa perkara itu perlu bagi maksud yang diniatkan untuk dicapai melaluinya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XVI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang dilantik, atau yang secara sah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan kuasa seseorang yang dilantik di bawah Akta ini, hendaklah disifatkan sebagai pengkhidmat awam mengikut pengertian Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan kuasanya untuk membuat peraturan-peraturan di bawah mana-mana peruntukan lain dalam Akta ini, Menteri boleh membuat peraturan- peraturan bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_q"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan dalam subseksyen (1), Menteri boleh membuat peraturan- peraturan bagi atau berkenaan dengan kesemua atau mana- mana perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "borang yang hendaklah digunakan dan maklumat yang hendaklah diberikan dalam apa-apa permohonan atau bagi apa-apa maksud lain di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti dan fee yang difikirkan patut ditetapkan berkenaan dengan apa-apa permohonan di bawah Akta ini atau berkenaan dengan apa-apa perakuan, permit atau dokumen lain yang dikeluarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bentuk yang dalamnya suatu daftar atau rekod lain hendaklah disimpan atau disenggarakan di bawah Akta ini, catatan yang hendaklah dibuat dalamnya, peruntukan bagi pemeriksaan dan pengambilan cabutan daripadanya dan petnberian salinannya dan fee yang hendaklah dibayar bagi pemeriksaan, cabutan dan salinan itu masing- masingnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pengendalian kursus-kursus pengajian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti bagi pengendorsan, pengubahan atau pindaan perakuan pendaftaran, permit mengajar atau apa- apa dokumen lain yang dikeluarkan di bawah Akta ini dan penggantian perakuan, permit atau dokumen lain yang hilang atau rosak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kemudahan pendidikan yang hendaklah disediakan oleh institusi pendidikan tinggi swasta;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pengadaan pendidikan jarak jauh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "piawai kesihatan dan keselamatan, dan kegunaan yang hendaklah dipatuhi bagi premis institusi pendidikan tinggi swasta, dan menetapkan piawai dan kegunaan yang berlainan, bagi apa-apa perihalan institusi pendidikan tinggi swasta, sebagaimana yang dinyatakan dalam peraturan- peraturan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mata pelajaran wajib lain yang hendaklah diajarkan selain daripada yang dinyatakan dalam seksyen 42 dan 43;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur yang hendaklah diikuti berkenaan dengan rayuan kepada Menteri daripada keputusan Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "rekod yang hendaklah disimpan oleh institusi pendidikan tinggi swasta dan penyata yang hendaklah dibuat termasuklah rekod dan penyata kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan fee yang hendaklah dikenakan ke atas pelajar institusi pendidikan tinggi swasta;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "fee yang dikehendaki ditetapkan di bawah Akta ini selain daripada fee yang disebut dalam perenggan (b) dan (c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara bagaimana gabungan, persekutuan atau kerjasama antara institusi-institusi pendidikan tinggi swasta boleh dijalankan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan kesalahan yang boleh dikompaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang dikehendaki ditetapkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang Menteri fikirkan adalah suaimanfaat atau perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XV__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah seksyen ini boleh memperuntukkan bahawa pelanggaran mana- mana peruntukan dalam peraturan-peraturan itu adalah suatu kesalahan dan bahawa kesalahan sedemikian boleh dihukum, apabila disabitkan, dengan hukuman denda atau pemenjaraan atau kedua-duanya tetapi tidak boleh membuat peruntukan supaya denda itu melebihi sepuluh ribu ringgit atau tempoh pemenjaraan itu melebihi satu bulan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, di bawah arahan Menteri, menyampaikan kepada institusi pendidikan tinggi swasta suatu notis tentang niat untuk membatalkan kelulusan institusi pendidikan tinggi swasta itu jika Menteri berpuas hati bahawa adalah suaimanfaat berbuat sedemikian atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kelulusan institusi pendidikan tinggi swasta itu telah didapatkan melalui apa-apa pernyataan palsu atau yang mengelirukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa telah berlaku pelanggaran mana-mana syarat yang dikenakan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tahap pendidikan di institusi pendidikan tinggi swasta itu tidak dikekalkan dengan sewajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan tinggi swasta itu telah disabitkan atas suatu kesalahan di bawah Akta ini atau mana-mana undang-undang bertulis lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa suatu kesalahan telah dilakukan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa alasan lain yang difikirkan patut oleh Menteri demi kepentingan Malaysia, orang awam atau pelajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_2__para_f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Alasan-alasan di bawah perenggan (1)(a) hingga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah sebagai tambahan kepada apa-apa alasan lain yang diperuntukkan di bawah mana-mana peruntukan lain dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh menyampaikan kepada institusi pendidikan tinggi swasta suatu notis tentang niat untuk mengkenselkan pendaftaran institusi pendidikan tinggi swasta itu jika dia berpuas hati bahawa adalah suaimanfaat untuk berbuat sedemikian atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pendaftaran institusi pendidikan tinggi swasta itu telah didapatkan melalui apa-apa pernyataan yang palsu atau mengelirukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa telah berlaku pelanggaran mana-mana syarat yang dikenakan oleh Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa suatu kesalahan telah dilakukan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan tinggi swasta itu telah disabitkan atas suatu kesalahan di bawah Akta ini atau mana-mana undang-undang bertulis lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa disiplin di institusi pendidikan tinggi swasta itu tidak dikekalkan dengan sewajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa peruntukan perlembagaan institusi pendidikan tinggi swasta itu sengaja diabaikan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan tinggi swasta itu telah digunakan secara yang berlawanan dengan maksud penubuhannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_2__para_g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Alasan-alasan di bawah perenggan (1)(a) hingga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_55__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah sebagai tambahan kepada mana-mana alasan lain sebagaimana yang diperuntukkan di bawah mana- mana peruntukan lain Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis tentang niat untuk membatalkan kelulusan di bawah seksyen 54 atau untuk mengkenselkan pendaftaran di bawah seksyen 55 hendaklah menyatakan alasan yang di atasnya pembatalan kelulusan atau pengkenselan pendaftaran itu dicadangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta itu hendaklah diberikan peluang untuk membuat representasi bertulis mengenainya dalam masa dua puluh satu hari dari tarikh penyampaian notis dalam subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas habis tempoh dua puluh satu hari yang disebutkan dalam subseksyen (2) dan selepas menimbangkan apa-apa representasi yang dibuat di bawah subseksyen itu, Ketua Pendaftar hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan pengkenselan pendaftaran, memutuskan sama ada atau tidak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk meneruskan tindakan yang dicadangkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk tidak mengambil tindakan lanjut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menambah, menukar atau mengubah syarat-syarat pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberikan amaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan pembatalan kelulusan, membuat apa-apa syor kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Ketua Pendaftar di bawah perenggan (3)(a) untuk mengkenselkan pendaftaran institusi pendidikan tinggi swasta hendaklah dibuat dengan persetujuan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X",
      "schema:name": {
        "@language": "ms",
        "@value": "Keputusan Menteri dan Ketua Pendaftar dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian ini hendaklah dibuat berdasarkan dokumen berhubungan dengan perkara di hadapan mereka, dan tidak boleh diadakan pendengaran secara mengenainya."
      }
    }
  ]
}
