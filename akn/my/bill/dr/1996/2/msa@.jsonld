        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ke atas seseorang, sewaktu dia merupakan pelajar institusi pendidikan tinggi swasta itu, daripada menjadi ahli atau dalam apa-apa cara bersekutu dengan suatu pertubuhan, parti politik, kesatuan sekerja atau apa-apa organisasi, badan atau kumpulan orang lain—"
      }
    },
    {
