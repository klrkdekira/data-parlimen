      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak ditubuhkan di bawah undang-undang bertulis lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_v__subpara_bb",
