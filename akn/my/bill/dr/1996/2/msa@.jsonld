      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada ia di dalam atau di luar institusi pendidikan tinggi swasta itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada ia di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ke atas sesuatu persatuan, badan atau kumpulan pelajar institusi pendidikan tinggi swasta itu, yang bergabung, bersekutu atau mempunyai urusan lain walau apa jua pun dengan mana- mana pertubuhan, parti politik, kesatuan sekerja atau mana-mana organisasi, badan atau kumpulan orang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak ia ditubuhkan di bawah mana-mana undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada ia di dalam atau di luar institusi pendidikan tinggi swasta itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada ia di dalam atau di luar Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ke atas seseorang, sewaktu dia merupakan pelajar institusi pendidikan tinggi swasta, dan sesuatu persatuan, badan atau kumpulan pelajar institusi pendidikan tinggi swasta yang menyatakan atau melakukan apa-apa perkara yang boleh dianggapkan sebagai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan sokongan dan simpati kepada atau tentangan terhadap mana-mana parti politik atau kesatuan sekerja; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan sokongan atau simpati kepada mana-mana organisasi, badan atau kumpulan orang yang tak sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada bila-bila masa perlembagaan tidak mengandungi peruntukan di bawah subseksyen (1), Ketua Pendaftar boleh memerintahkan institusi pendidikan tinggi swasta itu memasukkan peruntukan berkenaan ke dalam perlembagaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika institusi pendidikan tinggi swasta itu tidak mematuhi perintah yang dikeluarkan oleh Ketua Pendaftar di bawah subseksyen (2), Ketua Pendaftar boleh mengkenselkan pendaftarannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pelajar yang melanggar atau tidak mematuhi peruntukan perlembagaan yang dikehendaki supaya diperuntukkan dalam perlembagaan di bawah subseksyen (1), adalah melakukan suatu kesalahan dan hendaklah apabila disabitkan didenda tidak melebihi satu ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta hendaklah juga bertanggungan bagi kesalahan di bawah subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "kerana tidak mengikuti perlembagaannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila disabitkan boleh didenda tidak melebihi sepuluh ribu ringgit, melainkan jika institusi pendidikan tinggi swasta itu memuaskan mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu dilakukan tanpa pengetahuan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa ia telah menjalankan segala usaha yang wajar untuk mengelakkan berlakunya kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Sabitan institusi pendidikan tinggi swasta di bawah subseksyen (5) boleh dijadikan alasan bagi membatalkan kelulusan penubuhannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (2) hendaklah terpakai jika suatu kesalahan dilakukan di bawah mana-mana undang-undang bertulis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak mana-mana orang telah disabitkan berkenaan dengannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "termasuklah jika kesalahan itu telah dilakukan atau berupa dilakukan atas nama atau bagi pihak mana-mana persatuan, badan atau kumpulan pelajar institusi pendidikan tinggi swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pemegang jawatan persatuan, badan atau kumpulan dan tiap-tiap orang yang menguruskan atau membantu dalam pengurusan persatuan, badan atau kumpulan itu pada masa kesalahan itu dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah melakukan kesalahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dikenakan hukuman yang ditetapkan oleh undang-undang, melainkan jika dia memuaskan mahkamah bahawa kesalahan itu dilakukan tanpa pengetahuannya dan bahawa dia telah menjalankan segala usaha yang wajar untuk mengelakkan daripada berlakunya kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pemegang jawatan, atau seseorang yang menguruskan atau membantu dalam pengurusan, sesuatu persatuan, badan atau kumpulan yang disebutkan dalam subseksyen (2), boleh didakwa di bawah seksyen ini, walau pun dia mungkin tidak terlibat dalam melakukan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa pendakwaan di bawah seksyen ini, dokumen yang dijumpai berada dalam milikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang jawatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang menguruskan atau membantu dalam pengurusan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang anggota, persatuan, badan atau kumpulan itu hendaklah menjadi keterangan prima facie mengenai kandungannya bagi maksud membuktikan bahawa apa-apa telah dilakukan atau berupa telah dilakukan oleh atau bagi pihak organisasi, badan atau kumpulan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengarahkan ketua eksekutif untuk menggantung atau membubarkan sesuatu persatuan, badan atau kumpulan pelajar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika persatuan, badan atau kumpulan itu dikendalikan mengikut cara yang difikirkan oleh Ketua Pendaftar sebagai memudaratkan atau menjejaskan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ketenteraman awam; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pelajar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika persatuan, badan atau kumpulan itu melanggar mana-mana peruntukan mana-mana undang-undang bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar tidak boleh memberi arahan di bawah subseksyen (1) sehinggalah selepas dia menimbangkan representasi yang dibuat oleh persatuan, badan atau kumpulan pelajar institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua eksekutif hendaklah mengambil tindakan serta-merta untuk melaksanakan arahan Ketua Pendaftar dan hendaklah dalam masa dua puluh satu hari, memberitahu Ketua Pendaftar tentang apa-apa tindakan yang telah diambil oleh ketua eksekutif di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika arahan Ketua Pendaftar di bawah seksyen ini tidak dipatuhi, Ketua Pendaftar boleh mengkensel pendaftaran ketua eksekutif itu atau pendaftaran institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh menetapkan, selepas berunding"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dengan Menteri, peraturan-peraturan bagi pembuangan pelajar dalam hal-hal tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan Menteri hendaklah diperolehi terlebih dahulu sebelum sesuatu institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh mengendalikan sesuatu kursus pengajian atau program latihan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh mengendalikan sesuatu kursus pengajian atau program latihan secara bersesama atau bergabung, bersekutu atau bekerjasama dengan mana-mana Universiti, Kolej Universiti, institusi pendidikan tinggi, sama ada awam atau swasta, atau badan profesional, di dalam atau di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta yang melanggar peruntukan seksyen ini adalah melakukan suatu kesalahan dan apabila disabitkan, boleh didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh yang tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri tidak boleh memberikan kelulusannya di"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "bawah seksyen 38 melainkan jika dia berpuas hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan kesesuaian perkiraan berhubungan dengan kemudahan pendidikan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan penjaminan kualiti kursus pengajian atau program latihan itu, berdasarkan syor yang dibuat oleh pihak berkuasa yang ditubuhkan di bawah undang-undang bertulis bagi maksud sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila memberi kelulusan di bawah Bahagian ini, Menteri boleh mengenakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat-syarat yang difikirkannya patut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu institusi pendidikan tinggi swasta melanggar syarat yang dikenakan di bawah subseksyen (1), ia adalah melakukan suatu kesalahan dan apabila disabitkan, boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua institusi pendidikan tinggi swasta hendaklah mengendalikan kursus pengajiannya dalam bahasa kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Kursus pengajian di bawah subseksyen (1) adalah termasuk mata pelajaran yang dikehendaki supaya diajar di bawah seksyen 43."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), institusi pendidikan tinggi swasta boleh, dengan kelulusan Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengendalikan suatu kursus pengajian atau sebahagian yang substansial suatu kursus pengajian dalam bahasa Inggeris; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengendalikan pengajaran agama Islam dalam bahasa Arab."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana kursus pengajian atau sebahagian yang substansial mana-mana kursus pengajian di mana- mana institusi pendidikan tinggi swasta dikendalikan dalam bahasa Inggeris atau Arab, bahasa kebangsaan hendaklah diajarkan sebagai mata pelajaran wajib bagi pelajar yang mengikuti kursus pengajian sedemikian dalam bahasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal pelajar yang disebutkan dalam subseksyen (4) yang merupakan warganegara Malaysia, suatu pencapaian dalam bahasa kebangsaan, pada tahap yang ditentukan oleh pihak berkuasa yang disebut dalam seksyen 39, hendaklah menjadi pra-syarat bagi penganugerahan sijil, diploma atau ijazah institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Berkenaan dengan kelulusan yang diberikan oleh Menteri di bawah subseksyen 38(1) Menteri boleh pada bila-bila masa selepas itu mengarahkan supaya bahasa kebangsaan digunakan untuk mengendalikan kursus pengajian tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Arahan Menteri di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah terpakai hanya bagi pelajar yang merupakan warganegara Malaysia bagi pengambilan baru institusi pendidikan tinggi swasta itu yang belum mula mengikuti kursus pengajian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidaklah terpakai bagi pelajar lain yang mengikuti kursus pengajian itu melainkan jika Menteri berpuas hati bahawa arahan itu tidak akan memudaratkan mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengenakan syarat-syarat ke atas institusi pendidikan tinggi swasta bagi maksud melaksanakan arahannya di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua institusi pendidikan tinggi swasta hendaklah mengajar mata pelajaran yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengajian Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengajian yang berhubungan dengan pengajaran agama Islam bagi pelajar yang menganut agama Islam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pendidikan moral bagi pelajar bukan Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mata pelajaran yang disebut dalam perenggan (l)(a) hingga (c) hendaklah diajarkan sebagai tambahan kepada mata pelajaran atau kursus pengajian lain yang diajarkan di institusi pendidikan tinggi swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal pelajar yang merupakan warganegara Malaysia, kelulusan dalam mata pelajaran yang dinyatakan dalam perenggan (l)(a) hingga (c), pada tahap yang ditentukan oleh pihak berkuasa yang disebut dalam seksyen 39, hendaklah menjadi pra-syarat bagi penganugerahan sijil, diploma atau ijazah institusi pendidikan tinggi swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua sijil, diploma dan ijazah institusi pendidikan tinggi swasta hanya boleh dianugerahkan apabila mencapai tahap minimum yang ditentukan oleh pihak berkuasa yang disebut dalam seksyen 39."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua peruntukan lain Akta ini, hanya suatu institusi pendidikan tinggi swasta yang bertaraf Universiti atau Kolej Universiti atau kampus cawangan boleh menganugerahkan ijazah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "penyeliaan, pengawalseliaan dan kawalan standard pendidikan di institusi pendidikan tinggi swasta mengikut . tahap minimum yang ditentukan oleh pihak berkuasa yang disebut dalam seksyen 3.9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, tiap-tiap institusi pendidikan tinggi swasta hendaklah diuruskan dengan mengikuti perlembagaannya secara tegas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Perlembagaan itu tidak boleh dipinda tanpa mendapat kelulusan Ketua Pendaftar terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap institusi pendidikan tinggi swasta hendaklah melantik seorang ketua eksekutif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang dilantik sebagai ketua eksekutif hendaklah didaftarkan di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mendaftarkan atau mengkenselkan pendaftaran seorang eksekutif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, ketakjujuran atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah undang-undang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (atas kesalahan itu sendiri atau sebagai tambahan kepada atau ganti denda) selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia ialah atau menjadi seorang bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi tak sempurna akal atau selainnya tak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia bertindak dalam cara yang memudaratkan kepentingan Malaysia, orang awam atau pelajar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika perlantikannya di bawah subseksyen (1) dibatalkan, mengikut mana-mana yang berkenaan. Peraturan-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa Menteri untuk peraturan membuat peraturan-peraturan, Menteri boleh membuat mengenai pendaftaran peraturan-peraturan tentang prosedur pendaftaran ketua ketua eksekutif dan boleh menetapkan fee yang hendak eksekutif. dikenakan bagi pendaftaran itu. Kewajipan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua eksekutif hendaklah, tertakluk kepada ketua peruntukan Akta ini dan perlembagaan institusi pendidikan eksekutif. tinggi swasta itu, menjalankan penyeliaan am ke atas perkiraan bagi ajaran, pentadbiran, urusan hari ke hari, kebajikan dan disiplin di institusi pendidikan tinggi swasta itu. Permohonan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan berhubungan dengan dan bagi maksud di bawah institusi pendidikan tinggi swasta hendaklah dibuat oleh Akta ketua eksekutif, melainkan jika diperuntukkan selainnya. hendaklah dibuat oleh ketua eksekutif. Notis,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika— permintaan maklumat dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "notis dikehendaki disampaikan kepada institusi perhubungan pendidikan tinggi swasta di bawah Akta ini; hendaklah ditujukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat dikehendaki diberikan oleh kepada ketua eksekutif. institusi pendidikan tinggi swasta di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perhubungan lain adalah perlu antara Ketua Pendaftar dan institusi pendidikan tinggi swasta, ia hendaklah ditujukan kepada ketua eksekutif, melainkan jika diperuntukkan selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang pernah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi anggota lembaga pengarah syarikat yang menubuhkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi ketua eksekutif; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "terlibat secara langsung dengan pengurusan atau perniagaan, suatu institusi pendidikan tinggi swasta yang ditutup boleh bertindak dalam sifat yang sama berkenaan dengan institusi pendidikan tinggi swasta yang lain, tanpa kelulusan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada kuasa Ketua Pendaftar di bawah subseksyen 31(3), jika ketua eksekutif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah bertindak atau bercadang untuk bertindak secara yang tak munasabah berkenaan dengan penjalanan kuasa yang diberikan atau penunaian kewajipan yang dikenakan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah tidak menunaikan kewajipan yang dikenakan ke atasnya di bawah Akta ini, Ketua Pendaftar boleh selepas memberikan ketua eksekutif itu peluang untuk membuat representasi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kepada ketua eksekutif arahan secara bertulis tentang penjalanan kuasanya atau penunaian kewajipannya sebagaimana yang didapati suaimanfaat oleh Ketua Pendaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengkenselkan pendaftaran ketua eksekutif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah memberikan ketua eksekutif notis secara bertulis tentang keputusannya untuk mengkenselkan pendaftaran ketua eksekutif itu di bawah subperenggan (1)(bb) dan keputusan itu hendaklah mula berkuatkuasa dari tarikh notis bertulis itu disampaikan kepada ketua eksekutif itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ketua eksekutif terkilan dengan keputusan Ketua Pendaftar di bawah subperenggan (1)(bb), dia boleh, dalam masa dua puluh satu hari dari penyampaian keputusan itu, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada bila-bila masa, suatu institusi pendidikan tinggi swasta, tidak mempunyai ketua eksekutif yang dilantik di bawah Akta ini maka Ketua Pendaftar boleh melantik mana-mana orang sebagai ketua eksekutif bagi tempoh sementara sehingga institusi pendidikan tinggi swasta itu melantik ketua eksekutifnya sendiri ."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh sementara di bawah subseksyen (4) tidak boleh melebihi tiga bulan dan orang yang dilantik sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak perlu didaftarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dibayar gaji dan saraannya oleh institusi pendidikan tinggi swasta itu, dalam amaun yang ditentukan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika selepas tempoh sementara dalam subseksyen (4) habis, institusi pendidikan tinggi swasta itu tidak melantik seorang ketua eksekutif, maka pendaftaran institusi pendidikan tinggi swasta itu boleh dikenselkan oleh Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap institusi pendidikan tinggi swasta hendaklah didaftarkan di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengenakan apa-apa syarat yang difikirkannya perlu atas pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta yang terkilan dengan keputusan Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_11",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat di bawah subseksyen (10), boleh merayu kepada Menteri, dalam masa dua puluh satu hari dari diberitahu tentang keputusan yang dirayui itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat rayuan yang dibuat di bawah subseksyen (11), Ketua Pendaftar hendaklah menyediakan dan mengemukakan kepada Menteri alasan keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran hendaklah dibuat kepada Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam masa lima tahun dari tarikh kelulusan bagi penubuhan institusi pendidikan tinggi swasta yang diberikan di bawah Bahagian III;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam borang yang ditetapkan dan mengikut cara yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertai fee yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bersekali dengan struktur fee yang menyeluruh yang hendak dikenakan ke atas pelajar mengenai setiap kursus pengajian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika institusi pendidikan tinggi swasta itu tidak didaftarkan dalam masa yang dinyatakan dalam perenggan (2)(a), maka kelulusan yang diberikan bagi penubuhannya di bawah Bahagian III hendaklah disifatkan ditarik balik melainkan jika lanjutan masa diberikan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan pendaftaran dan sebelum ia ditentukan, Ketua Pendaftar boleh, melalui notis bertulis, menghendaki institusi pendidikan tinggi swasta itu memberikan maklumat, butir- butir atau dokumen tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Kehendak di bawah subseksyen (4) boleh berbeza antara perihalan yang berlainan institusi pendidikan tinggi swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan pendaftaran boleh ditarik balik pada bila-bila masa sebelum ia dibenarkan atau ditolak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), jika maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (4) tidak diberikan dalam masa yang ditetapkan dalam kehendak itu atau lanjutan masa, permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah ditarik balik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diteruskan, tanpa menjejaskan institusi pendidikan tinggi swasta itu untuk membuat permohonan baru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh menolak untuk meneruskan sesuatu permohonan dan boleh meminta supaya permohonan itu dipinda atau dilengkapkan dan mengemukakannya semula atau mengemukakan suatu permohonan baru bagi menggantikannya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "borang permohanan yang ditetapkan tidak dilengkapkan dengan sempurna disebabkan oleh apa-apa peninggalan atau salah perihalan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "borang permohonan mengandungi kesalahan atau pengubahan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak mematuhi apa-apa keperluan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, apabila permohonan bagi pendaftaran dibuat dengan sewajarnya dan selepas apa- apa penyiasatan yang difikirkannya perlu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "mendaftarkan dan mengeluarkan perakuan pendaftaran kepada institusi pendidikan tinggi swasta itu setelah dibayar fee yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_24__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menyimpan atau menyebabkan disimpan suatu daftar institusi pendidikan tinggi swasta dalam bentuk dan mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang awam boleh membuat carian ke atas daftar selepas membayar fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, suatu institusi pendidikan tinggi swasta hendaklah dikenali dengan premis yang digunakan bagi maksudnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Salinan perakuan pendaftaran yang dikeluarkan di bawah perenggan 24(9)(a) hendaklah dipamerkan di tempat yang mudah dilihat di premis institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mendaftarkan suatu"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta jika dia berpuas hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan tinggi swasta itu atau mana-mana bahagiannya, atas alasan keselamatan dan kesihatan— (i) adalah tak sesuai bagi kegunaan sebagai institusi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai kawasan mencukupi dan memuaskan bagi rekreasi pelajar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "terletak di tempat yang tak sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah tak sesuai disebabkan oleh bahaya kebakaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah selainnya suatu bangunan yang berbahaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa institusi pendidikan tinggi swasta itu berkemungkinan digunakan bagi maksud memberikan pendidikan, ajaran atau latihan yang difikirkan oleh Ketua Pendaftar, atas apa-apa sebab, sebagai memudaratkan kepentingan Malaysia, orang awam atau pelajar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa nama yang dengannya institusi pendidikan tinggi swasta itu didaftarkan adalah pada pendapat Ketua Pendaftar, tak sesuai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa struktur fee yang dicadangkan bagi pelajar adalah tak munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta tidak boleh berpindah premis tanpa mendapat kelulusan Ketua Pendaftar terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran premis baru institusi pendidikan tinggi swasta hendaklah dibuat kepada Ketua Pendaftar dalam borang yang ditetapkan mengikut cara yang ditetapkan dan selepas membayar fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta yang melanggar subseksyen (1) adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, pada bila-bila masa,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan budi bicaranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menambah, meminda, mengkensel atau mengubah apa-apa syarat pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan syarat pendaftaran yang baru atau syarat tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_X",
      "@type": "akn:part",
