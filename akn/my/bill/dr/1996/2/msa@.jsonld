    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_46__subsec_2"
      ],
