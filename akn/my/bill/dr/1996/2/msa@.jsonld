      "schema:text": {
        "@language": "ms",
        "@value": "PENUBUHAN INSTITUSI PENDIDIKAN TINGGl SWASTA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menerima dan menimbangkan syor Ketua Pendaftar di bawah seksyen 8, Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memberikan kelulusan bagi penubuhan institusi pendidikan tinggi swasta, dengan bersyarat atau tanpa syarat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menolak permohonan itu memberikan sebab bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri menolak suatu permohonan, Ketua Pendaftar hendaklah memberitahu pemohon mengenai penolakan itu secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada memberikan kelulusan di bawah subseksyen (1), meminta pemohon membayar fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri di bawah seksyen ini adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Kelulusan bagi penubuhan institusi pendidikan tinggi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "swasta tidak boleh diberikan melainkan jika Menteri berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon berkebolehan menyediakan kemudahan pendidikan yang mencukupi bagi penubuhan institusi pendidikan swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon berkebolehan menyediakan pengurusan dan pentadbiran yang mencukupi dan cekap bagi penjalanan yang sepatutnya akan institusi pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "langkah yang mencukupi telah diambil bagi menentukan dan mengekalkan tahap pendidikan yang disediakan oleh institusi pendidikan tinggi swasta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "telah diadakan sistem pengelolaan yang teratur bagi institusi pendidikan tinggi swasta itu serta perlembagaan yang hendaklah diluluskan oleh Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika pemohon sendiri bukanlah atau mana-mana ahli atau pekongsi pemohon bukanlah seorang yang telah disabitkan atas kesalahan yang melibatkan fraud atau ketakjujuran atau seorang bankrap yang belum dilepaskan, jika permohonan dibuat masing- masing oleh seseorang atau kumpulan orang atau firma; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika tiada seorang pun yang telah disabitkan atas kesalahan yang raelibatkan fraud atau ketakjujuran atau merupakan seorang bankrap yang belum dilepaskan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang jawatan sebagai pengarah, pengurus atau setiausaha atau jawatan atau kedudukan lain yang seumpamanya, jika permohonan dibuat oleh syarikat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_11__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang jawatan sebagai presiden, setiausaha atau bendahari atau jawatan atau kedudukan lain yang seumpamanya, jika permohonan dibuat oleh pertubuhan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila kelulusan diberikan, jika pemohon yang berjaya itu bukan syarikat yang diperbadankan di dalam negeri, pemohon hendaklah, dalam masa satu tahun dari diberitahu tentang kelulusan itu, memperbadankan suatu syarikat di dalam negeri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mempunyai modal terbitan dan berbayar dalam amaun yang ditentukan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada apa-apa terma dan syarat mengenai penyertaan ekuiti dan keanggotaan lembaga pengarah yang ditentukan oleh Menteri; dan INSTITUSI PENDIDIKAN TINGGI SWASTA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tujuan tunggalnya iaitu menubuhkan dan menguruskan institusi pendidikan tinggi swasta yang dinyatakan dalam memorandum dan perkara-perkara persatuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan Ketua Pendaftar mengenai memorandum dan perkara-perkara persatuan yang dicadangkan bagi syarikat hendaklah didapatkan terlebih dahulu sebelum permohonan dibuat bagi memperbadankan syarikat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon itu gagal memperbadankan syarikat di dalam negeri dalam masa yang dinyatakan dalam subseksyen (1), kelulusan yang diberikan bagi penubuhan institusi pendidikan tinggi swasta hendaklah disifatkan telah ditarik balik melainkan jika lanjutan masa telah diberikan oleh Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (l)(b), jika pemohon ialah seorang orang natural dia hendaklah pada setiap masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kepentingan kawalan dalam syarikat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_12__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang apa-apa peratusan saham mengundi dalam syarikat sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Syarat yang sama seperti dalam perenggan I 2 ( 1 ) ( a ),"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(b) dan (c) bolehlah dikenakan ke atas syarikat yang kepadanya kelulusan di bawah Bahagian ini telah diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen 15, 16 dan 17, sebutan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai syarikat adalah sebutan mengenai syarikat yang kepadanya kelulusan di bawah Bahagian ini telah diberikan dan syarikat yang ditubuhkan di bawah seksyen 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Melainkan jika kelulusan Ketua Pendaftar telah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "didapatkan terlebih dahulu, suatu syarikat tidak boleh menukar atau mengubah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "namanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "modal terbitan dan berbayarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "penyertaan ekuitinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "keanggotaan lembaga pengarahnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "memorandum dan perkara-perkara persatuannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Suatu syarikat hendaklah memberitahu Ketua"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tentang apa-apa pertukaran pada alamat perniagaannya, dalam masa empat belas hari dari pertukaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Maka hendaklah menjadi kewajipan tiap-tiap syarikat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberikan apabila diminta oleh Ketua Pendaftar, dalam tempoh yang ditentukan olehnya, butir-butir—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai apa-apa kepentingan kewangan walau apa jua pun yang dipunyai oleh orang lain dalam perniagaan syarikat itu atau hak yang dipunyai oleh orang lain untuk menamakan pengarah syarikat itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai apa-apa kepentingan atau hak yang dipunyai oleh syarikat itu dalam perniagaan orang lain sama ada yang berhubungan dengan pendidikan atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan Menteri hendaklah didapatkan terlebih dahulu sebelum institusi pendidikan tinggi swasta menubuhkan cawangan atau bergabung, bersekutu atau bekerjasama dengan mana-mana institusi pendidikan tinggi lain, sama ada swasta atau awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan untuk mendapatkan kelulusan di bawah subseksyen (1) hendaklah dibuat kepada Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam borang yang ditetapkan dan mengikut cara yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertai fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan itu dan sebelum ia ditentukan oleh Menteri, Ketua Pendaftar boleh menghendaki melalui notis bertulis maklumat, butir-butir atau dokumen tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (3) tidak diberikan dalam masa yang ditetapkan dalam kehendak itu atau apa-apa lanjutan masa, permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah ditarik balik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diteruskan, tanpa menjejaskan hak pemohon untuk membuat permohonan baru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah apabila permohonan dibuat dengan sewajarnya di bawah seksyen ini dan selepas diberikan kesemua maklumat, butir-butir dan dokumen yang dikehendakinya di bawah subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil langkah yang perlu bagi menimbangkan permohonan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat syor kepada Menteri sama ada permohonan itu patut dibenarkan atau ditolak dan syarat, jika ada, yang boleh dikenakan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menerima dan menimbangkan syor Ketua Pendaftar, Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memberikan kelulusan di bawah subseksyen (1), dengan atau tanpa syarat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menolak permohonan itu memberikan apa-apa sebab bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri menolak permohonan itu, Ketua Pendaftar hendaklah memberitahu pemohon tentang penolakan itu secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada memberikan kelulusan di bawah perenggan (6)(a), menghendaki institusi pendidikan tinggi swasta itu membayar apa-apa amaun fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri di bawah seksyen ini adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi pendidikan tinggi swasta tidak boleh membuat perkiraan atau perjanjian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjual, melupuskan atau membangunkan semula; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil apa-apa tindakan yang akan menjejaskan secara yang material, perniagaannya berhubungan dengan pendidikan sama ada melalui penyatuan atau selainnya, melainkan jika diluluskan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan untuk mendapatkan kelulusan di bawah subseksyen (1) hendaklah dibuat kepada Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam borang yang ditetapkan dan mengikut cara yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertai dengan fee yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan mengemukakan bersekali dengan permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan perjanjian atau perkiraan yang dicadangkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "semua maklumat, butir-butir dan dokumen lain yang berkaitan dengan secara langsung dan tak langsung dengan perjanjian atau perkiraan itu atau yang relevan bagi pertimbangannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan dan sebelum ia ditentukan oleh Menteri, Ketua Pendaftar boleh dengan notis bertulis menghendaki maklumat, butir- butir atau dokumen tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (3) tidak diberikan dalam masa yang ditetapkan dalam kehendak itu atau apa-apa lanjutan masa, permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah ditarik balik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diteruskan, tanpa menjejaskan pemohon untuk membuat permohonan baru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menerima apabila permohonan dibuat dengan sewajarnya di bawah seksyen ini' dan selepas diberikan kesemua maklumat, butir-butir dan dokumen yang diminta olehnya di bawah subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil tindakan yang perlu bagi menyemak permohonan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_b__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat syor kepada Menteri mengenai sama ada permohonan itu— (i) boleh diluluskan atau ditolak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "tentang ubahsuaian, pengubahan atau syarat, jika ada, tertakluk kepadanya ia diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima dan setelah menimbangkan syor Ketua Pendaftar, Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh meluluskan permohonan itu dengan atau tanpa apa-apa ubahsuaian, pengubahan atau syarat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu tanpa memberikan apa- apa sebab bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri menolak suatu permohonan, Ketua Pendaftar hendaklah memberitahu pemohon itu mengenai penolakan itu secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada memberikan kelulusan di bawah perenggan (6)(a), menghendaki institusi pendidikan tinggi swasta itu membayar apa-apa amaun fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri di bawah seksyen ini adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah, mengkensel, menukar atau menambah kepada apa-apa syarat di bawah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 10(l)(aj;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan I2(l)(a) , (b) dan (4)(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 18(6); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 19(6); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat baru atau tambahan di bawah peruntukan yang dinyatakan dalam perenggan (a), yang difikirkan patut oleh Menteri bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan Menteri hendaklah diperolehi terlebih dahulu sebelum sesuatu institusi pendidikan tinggi swasta boleh ditubuhkan atau disenggarakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi mendapatkan kelulusan di bawah Bahagian ini hendaklah dibuat kepada Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam borang yang ditetapkan dan mengikut cara yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertai dengan fee yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan mengemukakan bersekali dengan permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "pelan menyeluruh bagi penubuhan dan penyenggaraan yang sepatutnya akan institusi pendidikan tinggi swasta yang dicadangkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan draf perlembagaan pendidikan tinggi swasta dicadangkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pemohon—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang orang natural, laporan kedudukan kewangannya daripada jurubanknya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "bukan seseorang orang natural—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan memorandum dan perkara-perkara persatuan atau dokumen konstituen lain yang di bawahnya pemohon ditubuhkan, yang ditentu- sahkan dengan sewajarnya melalui perakuan statutori yang dibuat oleh pegawai yang diberikuasa bagi pemohon; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_c__subpara_iii__subpara_bb",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan kunci kira-kira teraudit, akaun untung rugi dan laporan, yang terbaru, jika ada, oleh juruaudit dan pengarah pemohon, jika berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat, butir-butir atau dokumen lain sebagaimana yang diminta oleh Ketua Pendaftar bagi maksud menentukan permohonan dan kesesuaian pemohon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan itu dan sebelum ia ditentukan oleh Menteri, Ketua Pendaftar boleh melalui notis secara bertulis menghendaki pemohon memberikan maklumat, butir-butir atau dokumen tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara yang dinyatakan dalam subseksyen (2) dan yang dikehendaki di bawah subseksyen (3) boleh berbeza antara pemohon, kelas, kategori atau perihalan pemohon yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah seksyen ini boleh ditarik balik pada bila-bila masa sebelum ia dibenarkan atau ditolak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah perenggan (2)(d) atau subseksyen (3) tidak diberikan oleh pemohon dalam masa yang dinyatakan dalam kehendak itu atau lanjutan masa yang diberikan baginya, maka permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah ditarik balik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_6__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diteruskan, tanpa menjejaskan hak pemohon membuat permohonan baru."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan seksyen 6, pemohon hendaklah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menzahirkan atau memberikan dalam permohonannya maklumat berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kelulusan lain yang telah diberikan kepada pemohon di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan kewangan walau apa jua pun yang dipunyai oleh pemohon dalam perniagaan mana-mana orang atau syarikat lain yang mengadakan atau menguruskan institusi pendidikan tinggi sama ada di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan atau hak yang dipunyai oleh orang lain dalam perniagaan pemohon dan dalam hal pemohon yang merupakan syarikat, apa-apa hak yang dipunyai oleh orang lain untuk menamakan pengarah syarikat pemohon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "urusan perniagaan lain pemohon; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan kewangan walau apa jua pun atau hak yang dipunyai oleh orang atau syarikat lain dalam urusan perniagaan yang lain pemohon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, apabila permohonan dibuat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dengan sewajarnya mengikut seksyen 6 dan 7, dan setelah diberikan segala maklumat, butir-butir dan dokumen yang dikehendaki oleh Ketua Pendaftar di bawah seksyen tersebut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil langkah yang perlu untuk menyemak permohonan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan perlembagaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat syor kepada Menteri tentang sama ada kelulusan boleh diberikan atau ditolak dan syarat, jika perlu, yang hendaklah dikenakan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan meneruskan tindakan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ke atas suatu permohonan, dan boleh menghendaki supaya permohonan itu dipinda atau dilengkapkan dengan sepatutnya dan dikemukakan semula atau supaya suatu permohonan baru dikemukakan bagi menggantikannya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "borang permohonan sebagaimana yang ditetapkan tidak dilengkapkan dengan sewajarnya disebabkan apa-apa peninggalan atau salah perihalan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "borang permohonan itu mengandungi kesilapan atau pengubahan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak mematuhi keperluan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada seorang Ketua Pendaftar Institusi Pendidikan Tinggi Swasta yang hendaklah dilantik oleh Menteri daripada kalangan pegawai dalam Perkhidmatan Pendidikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah juga melantik seorang Timbalan Ketua Pendaftar dan sekian bilangan Pendaftar, Timbalan Pendaftar dan Penolong Pendaftar Institusi Pendidikan Tinggi Swasta, sebagaimana yang difikirkannya perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah mempunyai kuasa dan menjalankan fungsi yang diberikan kepadanya oleh Akta ini, dan sewaktu ketiadaannya kuasa dan fungsi sedemikian bolehlah dipunyai atau dijalankan oleh Timbalan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar dan Penolong Pendaftar hendaklah di bawah arahan dan kawalan Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Ketua Pendaftar, Pendaftar, Timbalan Pendaftar dan Penolong Pendaftar boleh menjalankan kesemua kuasa dan fungsi yang diberikan kepada Ketua Pendaftar oleh atau di bawah Akta ini, tertakluk kepada apa-apa sekatan yang boleh dikenakan oleh Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, memberikan seseorang pegawai yang dilantik di bawah Bahagian ini arahan yang bersifat am, yang tidak tak konsisten dengan peruntukan Akta ini, tentang penjalanan kuasa dan budi bicara yang diberikan kepada pegawai itu oleh, dan kewajipan yang hendaklah ditunaikan oleh, pegawai itu di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Arahan yang diberikan di bawah subseksyen (1) bolehlah yang berhubungan dengan perkara yang didapati oleh Menteri menyentuh dasar, strategi dan garis panduan kebangsaan mengenai pendidikan tinggi yang dirumuskan dan ditentukan oleh Majlis Pendidikan Tinggi Negara yang ditubuhkan di bawah Akta Majlis Pendidikan Tinggi Negara 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai yang kepadanya arahan diberikan di bawah seksyen ini hendaklah melaksanakan tiap-tiap arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, memberikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "lembaga pengarah, ketua eksekutif atau pekerja institusi pendidikan tinggi swasta, arahan yang tidak tak konsisten dengan peruntukan Akta ini berhubungan dengan perkara yang berkenaan dengannya peraturan-peraturan boleh dibuat di bawah Akta ini, dan lembaga pengarah, ketua eksekutif atau pekerja berkenaan hendaklah melaksanakan tiap-tiap arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_23"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENUBUHAN INSTITUSI PENDIDIKAN TINGGI SWASTA BERTARAP UNIYERSITI, KOLEJ UNIYERSITI DAN KAMPUS CAWANGAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Kelulusan Menteri hendaklah didapatkan terlebih"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dahulu bagi penubuhan institusi pendidikan tinggi swasta yang bertaraf Universiti atau Kolej Universiti atau kampus cawangan kedua-duanya atau kampus cawangan Universiti atau Kolej Universiti luar negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi mendapatkan kelulusan di bawah seksyen 21 boleh dibuat kepada Menteri atas pelawaannya untuk berbuat sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelawaan di bawah subseksyen (1) boleh dibuat kepada pemohon yang dicadangkan, terraasuk kepada Universiti dan Kolej Universiti luar negeri dan kampus cawangan luar negeri, sama ada secara langsung atau melalui pengumuman dalam media atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "nyata di bawah seksyen 21 dan 22 semua peruntukan Akta ini hendaklah terpakai bagi institusi pendidikan tinggi swasta yang bertaraf Universiti atau Kolej Universiti atau kampus cawangan kedua-duanya atau kampus cawangan Universiti atau Kolej Universiti luar negeri yang ditubuhkan di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERMIT MENGAJAR"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah mendapatkan permit mengajar yang dikeluarkan oleh Ketua Pendaftar sebelum dia boleh dibenarkan mengajar di mana-mana institusi pendidikan tinggi swasta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi permit mengajar di bawah Akta ini hendaklah dibuat kepada Ketua Pendaftar dalam borang yang ditetapkan dan mengikut cara yang ditetapkan dan selepas membayar fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan bagi mendapatkan permit mengajar dan sebelum ia ditentukan, Ketua Pendaftar boleh, melalui notis secara bertulis, menghendaki pemohon memberikan maklumat, butir-butir atau dokumen tambahan, yang berbeza antara mata pelajaran yang hendak diajar oleh pemohon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh, selepas melakukan apa- apa penyiasatan yang difikirkannya perlu mengenai permohonan bagi mendapatkan permit mengajar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan permit mengajar dalam bentuk yang ditetapkan dan tertakluk kepada apa-apa syarat yang dinyatakan kepada orang yang memohon permit itu, dan selepas orang itu membayar fee yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak pennohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permit mengajar hendaklah menyatakan mata pelajaran atau mata-mata pelajaran yang boleh diajar oleh orang yang kepadanya permit mengajar itu dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan dengan keputusan Ketua Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_51__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan syarat atas permit itu, boleh merayu kepada Menteri dalam masa dua puluh satu hari daripada diberitahu tentang keputusan yang terhadapnya rayuan dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh enggan mengeluarkan permit mengajar atau membatalkan permit mengajar jika dia berpuas hati bahawa orang yang memohon permit itu atau yang kepadanya permit telah dikeluarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai kelayakan untuk mengajar, atau mempunyai kelayakan yang pada pendapat Ketua Pendaftar tidak mencukupi bagi maksud itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat pernyataan yang palsu atau mengelirukan berkaitan dengan permohonannya bagi mendapatkan permit mengajar atau telah dengan sengaja menyembunyikan suatu fakta material;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengalami kecacatan fizikal atau mental atau penyakit yang menjadikannya seorang yang tak sesuai untuk mengajar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan yang melibatkan ketakjujuran atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan di bawah mana-mana undang- undang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (bagi kesalahan itu sendiri atau sebagai tambahan kepada atau sebagai ganti denda) selama lebih daripada dua tahun; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah, kerana apa-apa sebab bukan seorang yang layak dan patut untuk mengajar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pendaftar enggan mengeluarkan permit mengajar atau membatalkan permit mengajar, dia hendaklah memberitahu orang yang memohon permit itu dan orang yang permitnya dibatalkan itu, melalui notis secara bertulis, tentang keengganan atau pembatalan itu, dengan menyatakan alasan keengganan atau pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan dengan apa-apa keputusan Ketua Pendaftar di bawah seksyen ini boleh, dalam masa dua puluh satu hari dari dimaklumkan tentang keputusan itu, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permit mengajar boleh dibatalkan oleh Ketua Pendaftar selepas memberikan orang yang kepadanya ia dikeluarkan hak untuk membuat representasi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada alasan yang dinyatakan di bawah perenggan 52(l)(a) hingga (e), permit mengajar boleh dibatalkan atas alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pemegang permit itu bertindak mengikut cara yang menjejaskan atau memudaratkan kepentingan Malaysia, orang awam atau pelajar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_IX__cl_53__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa alasan lain yang difikirkan patut oleh Ketua Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Institusi Pendidikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tinggi Swasta 1996 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"bahasa kebangsaan\" ertinya bahasa Melayu sebagaimana yang ditentukan dalam Perkara 152 Perlembagaan Persekutuan; \"buku\" termasuklah rekod maklumat dan rekod akaun atau perakaunan, bagaimana juapun dikumpulkan, direkodkan atau disimpan; \"diploma\" ertinya diploma yang dianugerahkan kepada seseorang oleh institusi pendidikan tinggi swasta, sesudah tamat mengikuti dengan jayanya kursus pengajian yang dirancangkan supaya membawa kepada penganugerahan diploma itu atau yang setaraf dengannya; \"ditetapkan\" ertinya ditetapkan oleh peraturan-peraturan yang dibuat di bawah Akta ini; \"dokumen konstituen\" ertinya statut, piagam, memorandum dan perkara-perkara persatuan, kaedah- kaedah dan undang-undang kecil, perjanjian perkongsian atau suratcara lain yang di bawahnya atau melaluinya seseorang pemohon, bagi penubuhan institusi pendidikan tinggi swasta, ditubuhkan dan yang dalamnya struktur pengelolaan dan pentadbirannya, skop fungsinya, urusan, kuasa dan kewajipannya dinyatakan, sama ada dalam satu dokumen atau lebih; \"fee yang ditetapkan\" ertinya fee yang dikehendaki supaya ditetapkan di bawah Akta ini; \"gabungan\" termasuklah pengendalian program berkembar; \"guru\" ertinya seseorang yang diambil kerja oleh institusi pendidikan tinggi swasta untuk menjadi guru dan termasuklah profesor kanan, profesor, penolong profesor, pensyarah kanan, pensyarah, penolong pensyarah dan tutor; \"ijazah\" ertinya ijazah yang dianugerahkan kepada seseorang di peringkat Sarjana Muda atau di peringkat Sarjana atau di peringkat Kedoktoran oleh institusi pendidikan tinggi swasta yang bertaraf Universiti atau Kolej Universiti, atau kampus cawangan, sesudah tamat mengikuti dengan jayanya kursus pengajian yang dirancangkan supaya membawa kepada penganugerahan ijazah itu atau yang setaraf dengannya; \"institusi pendidikan tinggi swasta\" ertinya institusi pendidikan, termasuklah Universiti atau Kolej Unversiti atau kampus cawangan yang diluluskan dan didaftarkan di bawah Akta ini, dan tidak ditubuhkan atau disenggarakan oleh Kerajaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyediakan pendidikan tinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyediakan pendidikan jarak jauh; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_vii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyediakan pendidikan tinggi atau pendidikan jarak jauh dengan bergabung, bersekutu atau bekerjasama dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta yang diluluskan dan didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_I__cl_2__list_1__para_c__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak ditubuhkan di bawah undang-undang bertulis lain; atau"
      }
    },
    {
