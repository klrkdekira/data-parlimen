        "@value": "PENUTUPAN INSTITUSI PENDIDIKAN TINGGI SWASTA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XII",
