      "schema:text": {
        "@language": "ms",
        "@value": "KESALAHAN DAN PENALTI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menganjurkan sesuatu institusi pendidikan tinggi swasta, sama ada melalui iklan, prospektus, risalah atau selainnya, melainkan jika penubuhan institusi pendidikan tinggi swasta itu telah diluluskan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pendaftar berpendapat bahawa apa- apa pernyataan yang dibuat dalam mana-mana iklan berhubungan dengan sesuatu institusi pendidikan tinggi swasta adalah palsu, mengaburi mata, menyinggung perasaan atau mengelirukan, maka Ketua Pendaftar boleh, melalui notis secara bertulis, mengarahkan supaya institusi pendidikan tinggi swasta itu melakukan kesemua atau mana-mana daripada yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghentikan penerusan keluaran iklan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubahsuaikan iklan itu mengikut cara yang dinyatakan oleh Ketua Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghentikan keluaran mana-mana iklan yang keseluruhannya atau sebahagiannya adalah pengulangan iklan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil segala langkah yang praktik untuk menarik balik iklan itu daripada tiap-tiap dan segala penyiaran atau pemamerannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan suatu pernyataan dalam cara yang serupa dengan iklan yang dikeluarkan pada awalnya untuk menarik balik mengubahsuaikan iklan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar boleh mengubah, menambah kepada, menukar, membatalkan atau selainnya meminda apa-apa arahan yang dikeluarkan di bawah subseksyen (1) melalui notis secara bertulis k pada institusi pendidikan tinggi swasta yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas pendaftaran sesuatu institusi pendidikan tinggi swasta di bawah Bahagian V, mana-mana iklan berhubungan dengan institusi pendidikan tinggi swasta itu hendaklah mengandungi nombor pendaftaran institusi pendidikan tinggi swasta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang atau institusi pendidikan tinggi swasta yang melanggar arahan Ketua Pendaftar di bawah subseksyen (1) adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang diambil oleh Ketua Pendaftar di bawah seksyen ini tidak menjejaskan kuasa Pengawal, Timbalan Pengawal atau Penolong Pengawal Perihal Dagangan di bawah Akta Perihal Dagangan 1972."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen 72 dan 73, \"iklan\" ertinya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pemberitahuan atau maklumat mengenai penubuhan institusi pendidikan tinggi swasta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "yang disiarkan dalam mana-mana akhbar, jurnal atau majalah atau apa-apa bentuk lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dipamerkan pada mana-mana papan iklan, papan, bumbung, dinding, paling, pagar, rangka, papan tanda, plat, kain rentang, palang, batang tiang, tonggak, tuangan dawai atau binaan, struktur atau rekaan lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "yang disampaikan melalui filem dalam pengertian Akta Filem Wayang Gambar (Penapisan) 1952 atau melalui alat terima radio atau alat terima televisyen dalam pengertian Peraturan-Peraturan Telekom (Alat Terima Televisyen) 1964; atau INSTITUSI PENDIDIKAN TINGGl SWASTA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "yang disampaikan melalui cara lain, secara lisan atau tulisan dan sama ada daripada bentuk yang sama atau tidak sebagaimana yang dinyatakan dalam perenggan (a) hingga (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang membuat pernyataan yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "palsu atau mengelirukan semasa mempromosikan sesuatu institusi pendidikan tinggi swasta adalah melakukan kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan, mendirikan, menganjurkan atau menjalankan apa-apa aktiviti bagi maksud menubuhkan, mendirikan atau menganjurkan atau ke arah penubuhan, pendirian, atau penganjuran sesuatu institusi pendidikan tinggi swasta;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengendalikan, menguruskan atau menyeng- garakan apa-apa kelas bagi pengajaran dan pembelajaran pendidikan tinggi di sesuatu institusi pendidikan tinggi swasta; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan, mendirikan, menganjurkan, mengendalikan, menguruskan atau menyeng- garakan sesuatu institusi pendidikan tinggi swasta dengan menggunakan perkataan \"Universiti\", \"Kolej Universiti\" atau \"kampus cawangan\", kecuali dengan mengikut peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua ratus ribu ringgit atau [ dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu institusi pendidikan tinggi swasta yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan atau menganugerahkan kepada mana-mana orang apa-apa sijil, diploma atau ijazah secara yang berlawanan dengan peruntukan seksyen 44 adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana institusi pendidikan tinggi swasta yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "melanggar mana-mana syarat yang dikenakan atas kelulusan bagi penubuhannya dan pendaftarannya, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon yang, semasa membuat permohonan untuk mendapatkan kelulusan bagi penubuhan suatu institusi pendidikan tinggi swasta; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta yang, semasa membuat apa-apa permohonan, di bawah Akta ini, membuat pernyataan yang diketahuinya adalah palsu atau yang dia atau ia percaya adalah tidak benar atau sengaja menyembunyikan apa-apa fakta yang material, atau memberikan apa-apa maklumat yang mengelirukan adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang, sebagai pemunya atau penghuni mana-mana rumah, bangunan, premis atau tempat, telah tidak mengambil langkah yang munasabah untuk mengelakkan bangunan, premis atau tempat itu daripada digunakan sebagai institusi pendidikan tinggi swasta secara yang berlawanan dengan Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "institusi pendidikan tinggi swasta yang digunakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa aktiviti atau maksud yang tak sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_80__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa aktiviti atau maksud sesuatu organisasi, pertubuhan atau kumpulan orang yang tak sah, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_81",
      "@type": "akn:clause",
