      "schema:text": {
        "@language": "ms",
        "@value": "Perlembagaan hendaklah mengandungi larangan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_VIII__cl_47__subsec_1__para_a",
