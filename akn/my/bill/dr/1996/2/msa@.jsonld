        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_78",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/2/msa@/~part_XIV__cl_79",
