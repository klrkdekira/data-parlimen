        "@value": "Rang Undang-Undang Perbekalan Tambahan (1996) 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/20/msa@/~cl_1",
      "@type": "akn:clause",
