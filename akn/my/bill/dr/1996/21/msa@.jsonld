    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 15(2) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Pengarah\" dengan perkataan \"pendaftar berlesen\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 16 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"Pengarah mana-mana kawasan pendaftaran\" dan perkataan \"Pengarah\" dengan perkataan \"pendaftar berlesen\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 17(1) Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Pengarah\" dengan perkataan \"pendaftar berlesen\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan \"Jabatan\" yang terdapat sebelum perkataan \"Polis\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 19(1) Akta ibu adalah dipinda dengan seksyen 19. menggantikan perkataan \"Pengarah sesuatu kawasan pendaftaran\" dan perkataan \"Pengarah\" yang mula-mula terdapat dengan perkataan \"pendaftar berlesen\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 21 Akta ibu adalah dipinda dengan seksyen 21. menggantikan perkataan \"Pengarah\" di mana-mana jua terdapat dengan perkataan \"pendaftar berlesen\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta ibu adalah dipinda dengan seksyen 22. menggantikan perkataan \"Pengarah bagi kawasan pendaftaran\" , \"Pengarah sesuatu kawasan pendaftaran\" dan \"Pengarah\" di mana-mana jua terdapat dengan perkataan \"pendaftar berlesen\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu adalah dipinda dengan seksyen 23. menggantikan perkataan \"Pengarah\" di mana-mana jua terdapat dengan perkataan \"pendaftar berlesen\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 24 Akta ibu adalah dipinda dengan seksyen 24. menggantikan perkataan \"Pengarah\" di mana-mana jua terdapat dengan perkataan \"pendaftar berlesen\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 27(6) Akta ibu adalah dipinda— seksyen 27."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (b) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: \"(c) selama tempoh dua belas bulan dari tarikh pembatalan lesen memandu di bawah seksyen 35, 35A, 41, 42, 43, 44, 45, 45A, 45B atau 45c.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 29 Akta ibu adalah dipinda— seksyen 29."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)— \"(a) memegang lesen memandu percubaan selama tempoh dua tahun dan membuat permohonan dalam tempoh satu tahun selepas habis tempoh itu;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"sama ada\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) Walau apa pun yang diperuntukkan dalam seksyen ini, tiada lesen memandu boleh diberikan kepada mana-mana pemohon melainkan jika dia memuaskan hati Pengarah bahawa pada tarikh dia memohon dia tidak mempunyai perkara-perkara atau hal-hal yang belum selesai dengan Jabatan Pengangkutan Jalan atau Polis berhubungan dengan apa- apa pelanggaran atau kesalahan yang bertentangan dengan Akta ini atau Akta Lembaga Pelesenan Kenderaan Perdagangan 1987.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (4) subseksyen yang berikut: \"(4A) Jika seseorang yang memegang lesen belajar memandu lulus ujian kekompetenan yang ditetapkan, Pengarah hendaklah memberinya lesen memandu percubaan dan lesen itu hendaklah dalam bentuk yang ditetapkan dan tertakluk kepada syarat-syarat yang ditetapkan dan hendaklah sah selama dua tahun. (4B) Subseksyen (4A) tidaklah terpakai kepada pemohon yang memegang lesen memandu, selain daripada lesen belajar memandu, daripada kelas atau perihalan yang lain. (4c) Jika mana-mana orang yang kepadanya lesen memandu percubaan diberikan gagal mematuhi mana-mana syarat yang tertakluk kepadanya lesen itu diberikan, maka dia adalah melakukan suatu kesalahan.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pengangkutan Jalan (Pindaan) 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta; dan Menteri boleh menetapkan tarikh yang berlainan bagi mula berkuatkuasanya peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Pengangkutan Jalan 1987, yang disebut \"Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ibu\" dalam Akta ini, adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
