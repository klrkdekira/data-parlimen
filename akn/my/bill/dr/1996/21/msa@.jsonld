    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 41 Akta ibu adalah dipinda dengan Pindaan seksyen 41. memasukkan selepas subseksyen (3) subseksyen yang berikut: \"(3A) Walau apa pun subseksyen (1), jika seseorang yang memegang lesen memandu percubaan disabitkan di bawah seksyen ini, mahkamah hendaklah sesudah itu membatalkan lesen memandunya itu.\". Pindaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu adalah dipinda dengan seksyen 42. memasukkan selepas subseksyen (3) subseksyen yang berikut: \"(4) Walau apa pun subseksyen (1), jika seseorang yang memegang lesen memandu percubaan disabitkan di bawah seksyen ini, mahkamah hendaklah sesudah itu membatalkan lesen memandunya itu.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_26",
      "@type": "akn:clause",
