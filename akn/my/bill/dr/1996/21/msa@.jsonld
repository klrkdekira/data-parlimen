      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (2)(a)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_b__subpara_i",
      "@type": "akn:subparagraph",
