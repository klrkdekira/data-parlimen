      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dan (5) dengan menggantikan perkataan \"atau seseorang Pengarah\" dengan perkataan \", Pengarah atau pendaftar berlesen\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_8__para_b",
