      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"dan\" yang terdapat selepas perkataan \"seksyen 43\" dengan koma; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_a__subpara_ii",
      "@type": "akn:subparagraph",
