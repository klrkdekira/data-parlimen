      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"seksyen 44\" perkataan \",subseksyen (1) seksyen 45A, subseksyen (4) seksyen 45B, subseksyen (5) seksyen 45B dan subseksyen (6) seksyen 45c\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_b",
      "@type": "akn:paragraph",
