        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_20__para_e",
