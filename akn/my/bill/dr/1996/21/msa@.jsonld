      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 43 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas subseksyen (3) subseksyen yang berikut; \"(4) Walau apa pun subseksyen (1), jika seseorang yang memegang lesen memandu percubaan disabitkan di bawah seksyen ini, mahkamah hendaklah sesudah itu membatalkan lesen memandunya itu.\"."
      }
    },
