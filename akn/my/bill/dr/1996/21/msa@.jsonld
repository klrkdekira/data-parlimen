        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_22__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 37 Akta ibu adalah dipinda— seksyen 37."
      }
    },
