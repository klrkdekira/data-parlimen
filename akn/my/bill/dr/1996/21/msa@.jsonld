      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"dua ratus\" dengan perkataan \"satu ribu\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
