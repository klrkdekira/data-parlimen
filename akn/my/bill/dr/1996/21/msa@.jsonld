      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"atau\" yang terdapat selepas perkataan \"seksyen 42\" dengan koma; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"44,\" perkataan \"45A, 45B atau 45c,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/21/msa@/~cl_33__para_c",
