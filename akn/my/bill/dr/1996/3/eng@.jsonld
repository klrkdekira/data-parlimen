        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/3/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/3/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 38(1 B) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/3/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
