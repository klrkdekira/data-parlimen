      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/3/eng@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/3/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 374 of the principal Act is amended by"
      },
      "schema:text": {
