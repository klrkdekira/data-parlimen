        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KESALAHAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_43"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUASA-KUASA LAIN PENDAFTAR"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemunya sesuatu reka bentuk perindustrian berdaftar boleh, mengikut peraturan-peraturan yang ditetapkan oleh Menteri, meminta Pendaftar supaya meminda sesuatu reka bentuk perindustrian berdaftar atau apa-apa dokumen yang dikaitkan dengannya bagi maksud membetulkan silap tulis, kesilapan nyata atau bagi apa- apa sebab lain yang dapat diterima oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan supaya dibuat sesuatu pindaan hendaklah disertakan dengan fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi maksud membetulkan silap tulis atau kesilapan nyata, tiada pindaan boleh dibenarkan di bawah seksyen ini jika pindaan itu akan menyebabkan penzahiran perkara yang melebihi apa yang dizahirkan sebelum pindaan itu, atau memperluas perlindungan yang diberikan pada masa pendaftaran reka bentuk perindustrian yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pindaan boleh dibenarkan dibuat dalam pendaftaran sesuatu reka bentuk perindustrian di bawah seksyen ini jika ada prosiding mahkamah yang belum selesai dan dalam prosiding itu kesahan pendaftaran reka bentuk perindustrian itu boleh dijadikan isu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Daftar telah dipinda di bawah seksyen ini, Pendaftar boleh menghendaki supaya perakuan pendaftaran itu diserahkan kepadanya dan boleh membatalkan perakuan pendaftaran itu dan mengeluarkan perakuan pendaftaran baru dengan apa-apa pindaan berbangkit yang menjadi perlu oleh sebab pindaan kepada Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, pada amnya bagi maksud Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memanggil saksi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima keterangan bersumpah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan apa-apa dokumen atau barang; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawardkan kos terhadap sesuatu pihak dalam apa-apa prosiding di hadapannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi apa-apa saman, perintah atau arahan yang dibuat oleh Pendaftar di bawah perenggan (1)(a), (1)(b) atau (l)(c) tanpa apa- apa alasan yang sah di sisi undang-undang adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua- duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Kos yang diawardkan oleh Pendaftar boleh didapatkan, jika berlaku keingkaran membuat bayaran, dalam mahkamah yang mempunyai bidang kuasa yang kompeten oleh orang yang kepadanya kos itu telah diawardkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika apa-apa kuasa budi bicara diberikan kepada"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar oleh Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini dia tidak boleh menjalankan kuasa itu terhadap mana-mana orang yang mungkin dimudaratkan oleh keputusannya tanpa memberi orang itu peluang untuk didengar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan subseksyen 17(2) dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 50, jika melalui Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini suatu masa ditetapkan dan dalam masa itu sesuatu perbuatan atau perkara hendaklah dilakukan, Pendaftar boleh, melainkan jika diarahkan selainnya dengan nyata oleh Mahkamah, melanjutkan masa itu sama ada sebelum atau selepas habis tempohnya, setelah fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu catatan palsu dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu catatan palsu dalam mana-mana salinan terperaku sesuatu dokumen atau penerbitan di Pejabat Pendaftaran Reka Bentuk Perindustrian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu dokumen palsu yang berupa sebagai suatu salinan catatan dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan atau memberikan menyebabkan dikemukakan atau diberikan sebagai keterangan mana-mana dokumen yang tersebut dalam perenggan (b) atau (c) dengan rnengetahui bahawa dokumen itu atau mana- mana catatan dalamnya adalah palsu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat tuntutan secara palsu bahawa dia adalah pemunya reka bentuk perindustrian berdaftar itu atau menyatakan bahawa dia bertindak sebagai, atau bagi pihak, pemunya reka bentuk perindustrian berdaftar itu, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima belas ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang membuat pernyataan palsu bahawa apa-apa jua pun yang dilupuskan olehnya untuk mendapat balasan berharga ialah suatu barang yang dilindungi oleh suatu pendaftaran reka bentuk perindustrian adalah melakukan suatu kesalahan dan apabila disabitkan, boleh didenda tidak melebihi lima belas ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), seseorang yang melupuskan untuk mendapat balasan berharga apa-apa barang yang telah dicap, diukir atau ditera padanya atau selainnya digunakan padanya perkataan \"reka bentuk perindustrian berdaftar\" atau apa-apa perkataan lain yang menyatakan atau menyiratkan bahawa barang itu adalah suatu barang yang padanya reka bentuk perindustrian berdaftar telah digunakan, hendaklah dikira sebagai menggambarkan bahawa barang itu adalah suatu barang yang dilindungi oleh suatu pendaftaran reka bentuk perindustrian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidaklah terpakai jika pernyataan dibuat berhubungan dengan sesuatu reka bentuk perindustrian selepas pendaftaran berkenaan dengan reka bentuk itu telah habis tempoh atau dibatalkan dan sebelum tamat suatu tempoh yang semunasabahnya cukup untuk membolehkan orang itu mengambil langkah untuk memastikan bahawa pernyataan itu tidak dibuat atau tidak terus dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam prosiding bagi sesuatu kesalahan di bawah seksyen ini adalah menjadi suatu pembelaan bagi mana-mana orang jika dia membuktikan bahawa dia telah menggunakan usaha wajar untuk menghalang pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini hendaklah mempunyai kuatkuasa berhubungan dengan sesuatu hak untuk memohon pendaftaran sesuatu reka bentuk perindustrian sebagaimana ia mempunyai kuatkuasa berhubungan dengan sesuatu reka bentuk perindustrian berdaftar, dan sebutan tentang reka bentuk perindustrian berdaftar hendaklah termasuk sebutan tentang hak untuk memohon pendaftaran sesuatu reka bentuk perindustrian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menggunakan di tempat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perniagaannya atau pada apa-apa dokumen yang dikeluarkan olehnya atau selainnya perkataan \"Pejabat Pendaftaran Reka Bentuk Perindustrian\" atau apa-apa perkataan lain yang memberikan maksud bahawa tempat perniagaannya adalah atau secara rasminya adalah berkaitan dengan Pejabat Pendaftaran Reka Bentuk Perindustrian, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima belas ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan di bawah Akta ini yang dilakukan oleh suatu pertubuhan perbadanan telah terbukti dilakukan dengan kebenaran atau pembiaran oleh, atau yang disebabkan oleh apa-apa kecuaian pada pihak, seseorang pengarah, pengurus, setiausaha atau pegawai lain yang seumpama itu dalam pertubuhan perbadanan itu, atau mana-mana orang yang berupa sebagai bertindak atas apa-apa sifat sedemikian, maka dia, dan juga pertubuhan perbadanan itu, adalah melakukan kesalahan itu dan boleh didakwa dan boleh dihukum dengan sewajarnya sebagaimana yang diperuntukkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika hal-ehwal sesuatu pertubuhan perbadanan diuruskan oleh anggota-anggotanya, maka subseksyen (1) hendaklah terpakai berhubungan dengan perbuatan dan keingkaran seseorang anggota berkaitan dengan fungsi pengurusannya seolah-olah dia ialah seorang pengarah pertubuhan perbadanan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, pemunya sesuatu reka bentuk perindustrian berdaftar hendaklah mempunyai hak eksklusif untuk membuat atau mengimport untuk dijual atau disewakan, atau untuk menggunakan bagi tujuan apa-apa perdagangan atau perniagaan, atau untuk menjual, menyewakan atau menawarkan atau mendedahkan untuk dijual atau disewakan, apa-apa barang yang padanya reka bentuk perindustrian berdaftar itu telah digunakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 30, seseorang melanggar hak yang diberikan oleh pendaftaran sesuatu reka bentuk perindustrian jika dia, tanpa lesen atau kebenaran pemunya reka bentuk perindustrian itu membuat mana-mana perkara yang berikut semasa pendaftaran itu masih berkuatkuasa:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan reka bentuk perindustrian itu atau apa-apa tiruan palsu atau nyata reka bentuk perindustrian itu pada apa-apa barang yang berkenaan dengannya reka bentuk perindustrian itu didaftarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengimport ke dalam Malaysia untuk dijual, atau untuk digunakan bagi maksud apa-apa perdagangan atau perniagaan, apa-apa barang yang padanya, telah digunakan reka bentuk perindustrian itu atau apa-apa tiruan palsu atau nyata reka bentuk perindustrian itu di luar Malaysia tanpa lesen atau kebenaran pemunyanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual, atau menawarkan atau menyimpan untuk dijual, atau menyewakan atau menawarkan atau menyimpan untuk disewakan, mana-mana barang yang diperihalkan dalam perenggan (a) dan (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), hak pemunya sesuatu reka bentuk perindustrian berdaftar tidaklah meliputi perbuatan berkenaan dengan sesuatu barang yang padanya reka bentuk perindustrian berdaftar itu digunakan, oleh atau dengan kebenaran pemunya, selepas barang itu diimport atau dijual di Malaysia dengan sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Pemunya sesuatu reka bentuk perindustrian berdaftar hendaklah mempunyai hak untuk memulakan prosiding undang-undang terhadap mana-mana orang yang telah melanggar atau sedang melanggar mana-mana hak yang diberikan oleh pendaftaran reka bentuk perindustrian itu. (2) Pemunya sesuatu reka bentuk perindustrian berdaftar hendaklah mempunyai hak yang sama terhadap mana- mana orang yang telah melakukan perbuatan yang boleh menyebabkan pelanggaran berlaku. (3) Prosiding yang tersebut dalam subsekyen (1) dan (2) tidak boleh dimulakan selepas lima tahun dari perbuatan pelanggaran itu. (4) Bagi maksud seksyen ini, \"pemunya sesuatu reka bentuk perindustrian berdaftar\" ertinya pemunya berdaftar dan termasuklah pemegang serahhak, pemegang lesen atau benefisiari sesuatu lesen wajib yang diberikan di bawah seksyen 27; tetapi jika apa-apa prosiding dimulakan oleh seseorang selain daripada pemunya berdaftar, mestilah dibuktikan bahawa dia telah membuat permintaan terlebih dahulu kepada pemunya berdaftar untuk memulakan prosiding bagi pelanggaran yang diadukan olehnya dan bahawa pemunya berdaftar itu telah enggan atau gagal untuk memulakan prosiding dalam tempoh tiga bulan dari penerimaan permintaan itu, tanpa bagaimanapun menjejaskan hak pemunya berdaftar itu untuk turut bersama dalam prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa alasan yang membolehkan pendaftaran"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu reka bentuk perindustrian dibatalkan boleh digunakan sebagai suatu pembelaan dalam sesuatu tindakan pelanggaran reka bentuk perindustrian berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemunya sesuatu reka bentuk perindustrian berdaftar membuktikan bahawa suatu pelanggaran telah dilakukan atau sedang dilakukan, Mahkamah boleh mengawardkan ganti rugi atau membuat perintah pengemukaan akaun keuntungan dan boleh memberikan perintah injunksi untuk menghalang pelanggaran lanjut dan apa-apa remedi lain di sisi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemunya sesuatu reka bentuk perindustrian berdaftar membuktikan bahawa perbuatan sedang dilakukan yang boleh menyebabkan suatu pelanggaran berlaku, Mahkamah boleh memberikan perintah injunksi untuk menghalang pelanggaran dan apa-apa remedi lain di sisi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh enggan mengawardkan ganti rugi, atau enggan membuat perintah pengemukaan akaun REKA BENTUK PERINDUSTRIAN keuntungan, berkenaan dengan sesuatu pelanggaran, jika defendan memuaskan Mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa, semasa pelanggaran itu, defendan tidak tahu bahawa reka bentuk perindustrian itu telah didaftarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa defendan telah, sebelum itu, mengambil segala langkah yang munasabah untuk menentukan sama ada reka bentuk perindustrian itu telah didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Hak pemunya berkenaan dengan sesuatu reka bentuk perindustrian adalah harta sendiri dan boleh diserahhakkan dan dipindahmilik melalui kuatkuasa undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, undang-undang yang terpakai bagi pemunyaan dan penurunan harta sendiri hendaklah terpakai berhubungan dengan sesuatu reka bentuk perindustrian berhubungan dengan hak-hak dalam tindakan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu penyerahhakan yang disebut dalam subseksyen (1) hendaklah secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang menjadi berhak melalui penyerahhakan atau perpindahan atau melalui kuatkuasa undang-undang lain kepada sesuatu reka bentuk perindustrian berdaftar atau permohonan untuk mendaftarkan suatu reka bentuk perindustrian, dia hendaklah memohon kepada Pendaftar mengikut cara yang ditetapkan supaya penyerahhakan, perpindahan atau kuatkuasa lain di sisi undang-undang itu direkodkan dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa penyerahhakan, perpindahan atau kuatkuasa lain di sisi undang-undang berkenaan dengan sesuatu reka bentuk perindustrian berdaftar boleh berkuatkuasa terhadap pihak ketiga melainkan jika direkodkan dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu reka bentuk perindustrian didaftarkan atas nama dua orang atau lebih, setiap seorang daripada mereka, tertakluk kepada apa-apa perjanjian yang sebaliknya antara mereka, hendaklah mempunyai hak yang sama rata terhadap bahagian yang tak dipecahkan dalam reka bentuk perindustrian berdaftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua orang atau lebih adalah pemunya bersama suatu reka bentuk perindustrian berdaftar, maka, tertakluk kepada seksyen ini dan kepada apa-apa perjanjian yang sebaliknya antara mereka—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "setiap seorang daripada mereka, dengan bertindak sendiri atau melalui ejennya, adalah berhak untuk melakukan apa-apa perbuatan, untuk faedah dirinya dan tanpa kebenaran atau keperluan untuk memberikan penjelasan kepada orang lain, yang jika tidak kerana subseksyen ini akan menjadi suatu pelanggaran reka bentuk perindustrian berdaftar itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perbuatan sedemikian tidaklah menjadi suatu pelanggaran reka bentuk perindustrian berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua orang atau lebih adalah pemunya bersama suatu reka bentuk perindustrian berdaftar, maka, tertakluk kepada apa-apa perjanjian yang sebaliknya antara mereka, tiada seorang pun daripada mereka boleh memberikan lesen berkenaan dengan penggunaan reka bentuk perindustrian berdaftar itu, atau menyerahhakkan atau menggadaikan kepentingannya dalam reka bentuk perindustrian berdaftar itu tanpa mendapat kebenaran pemunya yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan seksyen ini hendaklah mempunyai kuatkuasa berhubungan dengan hak untuk memohon untuk mendaftarkan suatu reka bentuk perindustrian sebagaimana ia berkuatkuasa berhubungan dengan reka bentuk perindustrian berdaftar, dan sebutan tentang reka bentuk perindustrian berdaftar hendaklah termasuk sebutan tentang hak untuk memohon untuk mendaftarkan suatu reka bentuk perindustrian."
      }
    }
  ]
}
