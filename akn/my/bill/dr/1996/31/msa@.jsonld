        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENDAPTARAN REKA BENTUK PERINDUSTRIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen ini, pencipta sesuatu reka bentuk perindustrian hendaklah dianggap sebagai pemunya asal reka bentuk perindustrian itu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu reka bentuk perindustrian dicipta menurut tempahan bagi suatu wang atau nilai wang, orang yang menempah reka bentuk perindustrian itu hendaklah dianggap sebagai pemunya asal reka bentuk perindustrian itu, tertakluk kepada apa-apa perjanjian yang sebaliknya antara kedua-dua pihak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, dalam keadaan yang tidak terangkum dalam subseksyen (2), suatu reka bentuk perindustrian dicipta oleh seorang pekerja dalam tempoh penggajiannya, majikannya hendaklah dianggap sebagai pemunya asal reka bentuk perindustrian itu, tertakluk kepada apa-apa perjanjian yang sebaliknya antara kedua-dua pihak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemunya asal sesuatu reka bentuk perindustrian atau pemegang serahhak apa-apa kepentingan dalam sesuatu reka bentuk perinduslrian boleh menyerahhakkan secara bertulis kepada orang lain keseluruhan atau mana- mana bahagian kepentingannya mengenai reka bentuk perindustrian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu reka bentuk perindustrian, atau hak untuk menggunakan sesuatu reka bentuk perindustrian pada apa-apa barang, menjadi terletakhak sama ada secara penyerahhakan, perpindahan atau kuatkuasa undang- undang, pada mana-mana orang selain daripada pemunya asal, sama ada berseorangan atau bersesama dengan pemunya asal, maka orang lain itu atau, mengikut mana- mana yang berkenaan, pemunya asal dan orang lain itu hendaklah dianggap bagi maksud seksyen 11 sebagai pemunya asal reka bentuk perindustrian itu atau sebagai pemunya asal reka bentuk perindustrian berkaitan dengan barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi sesuatu reka bentuk perindustrian yang dihasilkan oleh komputer dalam keadaan tiada pencipta manusia, orang yang membuat perkiraan yang perlu untuk mencipta reka bentuk perindustrian itu hendaklah dianggap sebagai penciptanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemunya asal sesuatu reka bentuk perindustrian adalah berhak untuk membuat permohonan untuk mendaftarkan reka bentuk perindustrian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua orang atau lebih mempunyai kepentingan mengenai suatu reka bentuk perindustrian, semua orang yang mempunyai kepentingan itu, yang bertindak bersesama, adalah berhak membuat permohonan untuk mendaftarkan reka bentuk perindustrian itu, tertakluk kepada apa-apa perjanjian yang sebaliknya antara mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, sesuatu reka bentuk perindustrian hanya boleh didaftarkan jika ia baharu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu reka bentuk perindustrian yang baginya suatu permohonan bagi pendaftaran telah dibuat tidak boleh dianggap baharu jika, sebelum tarikh prioriti REKA BENTUK PERINDUSTRIAN permohonan itu, ia atau suatu reka bentuk perindustrian yang berbeza daripadanya hanya dari segi butir-butir tak material atau dari segi ciri-ciri yang biasa digunakan dalam perdagangan yang relevan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dizahirkan kepada awam di mana-mana jua di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan hal perkara suatu permohonan lain untuk mendaftarkan suatu reka bentuk perindustrian yang difailkan di Malaysia tetapi mempunyai suatu tarikh prioriti yang lebih awal yang dibuat oleh pemohon lain setakat yang hal perkara itu termasuk dalam pendaftaran yang telah diberikan berasaskan permohonan lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan 2(a), suatu reka bentuk perindustrian tidak boleh disifatkan sebagai telah dizahirkan kepada awam semata-mata dengan sebab bahawa, dalam tempoh enam bulan sebelum tarikh pemfailan suatu permohonan bagi pendaftaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ia dipamerkan dalam pameran rasmi atau pameran yang diiktiraf; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ia telah dizahirkan oleh seseorang selain daripada pemohon atau pendulunya dalam hakmilik akibat daripada suatu perbuatan yang menyalahi undang-undang yang dilakukan oleh orang itu atau orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Reka bentuk perindustrian yang bertentangan dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ketenteraman awam atau prinsip moral tidak boleh didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dibuat dalam borang yang ditetapkan dan hendaklah difailkan di Pejabat Pendaftaran Reka Bentuk Perindustrian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disertakan dengan representasi, mengikut bilangan yang ditetapkan, barang yang padanya reka bentuk perindustrian itu digunakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mengandungi pernyataan kebaharuan berkenaan dengan reka bentuk perindustrian yang berkaitan dengan permohonan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disertakan dengan bayaran fee pemfailan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tempat bermastautin biasa atau tempat utama perniagaan pemohon adalah di luar Malaysia, pemohon hendaklah melantik seorang ejen di Malaysia yang kepadanya notis atau proses berhubungan dengan permohonan untuk mendaftarkan suatu reka bentuk perindustrian boleh disampaikan, dan jika pemohon gagal melantik seorang ejen, Pendaftar boleh enggan meneruskan permohonan itu sehingga ejen sedemikian dilantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Dua reka bentuk perindustrian atau lebih boleh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi subjek bagi permohonan yang sama, dengan syarat reka bentuk perindustrian itu adalah berkaitan dengan kelas yang sama mengikut Klasifikasi Antarabangsa untuk Reka Bentuk Perindustrian atau berkaitan dengan set atau komposisi barang yang sama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Tarikh pemfailan sesuatu permohonan untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mendaftarkan suatu reka bentuk perindustrian hendaklah tarikh terawal apabila semua syarat yang berikut yang berhubungan dengan permohonan itu dipenuhi:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dokumen yang tersebut dalam seksyen 14 mengenal pasti pemohon atau pemohon- pemohon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "bilangan representasi mengikut bilangan yang ditetapkan, barang yang padanya reka bentuk perindustrian itu digunakan difailkan di Pejabat Pendaftaran Reka Bentuk Perindustrian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "fee permohonan yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen ini, tarikh prioriti sesuatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian ialah tarikh pemfailan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu permohonan boleh, menurut mana-mana triti atau konvensyen antarabangsa yang Malaysia menjadi satu pihak kepadanya, mengandungi akuan yang menuntut prioriti satu permohonan negara, serantau atau antarabangsa atau lebih yang terdahulu yang difailkan oleh pemohon atau pendulunya dalam hakmilik dalam atau bagi mana- mana negara yang menjadi pihak kepada triti atau konvensyen itu, dan dalam mana-mana kes sedemikian, tarikh prioriti hendaklah tarikh terawal permohonan negara, serantau atau antarabangsa itu difailkan: Dengan syarat bahawa permohonan yang dibuat di bawah Akta ini telah difailkan dalam tempoh enam bulan dari tarikh terawal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permohonan itu mengandungi suatu akuan di bawah subseksyen (2), Pendaftar boleh menghendaki supaya pemohon itu, dalam masa yang ditetapkan, memberikan satu salinan permohonan yang terdahulu yang diperakui sebagai betul oleh pejabat di mana ia telah difailkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Kesan akuan yang disebut dalam subseksyen (2) hendaklah sebagaimana yang diperuntukkan dalam triti atau konvensyen yang disebut dalam subseksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana kehendak seksyen ini atau mana- mana peraturan yang berkaitan dengannya telah tidak dipatuhi, maka akuan yang disebut dalam subseksyen (2) hendaklah dianggap tak sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Pemohon pendaftaran suatu reka bentuk perindustrian"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "boleh, melalui notis bertulis kepada Pendaftar, menarik balik permohonan itu pada bila-bila masa semasa menunggu jawapan, dan mana-mana penarikan balik itu tidak boleh dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, atas permintaan yang dibuat kepadanya dengan cara yang ditetapkan, meminda sesuatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian. 16 RANG UNDANG-UNDANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pindaan di bawah subseksyen (1) tidak boleh dibuat jika, akibat daripada pindaan itu, ruang lingkup permohonan itu akan bertambah dengan kemasukan apa-apa perkara yang tidak pada matannya didedahkan dalam permohonan yang difailkan pada mulanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permintaan untuk membuat pindaan di bawah seksyen 19 dibenarkan, dan pindaan itu telah meng- akibatkan satu reka bentuk perindustrian atau lebih terkeluar daripada permohonan yang mula-mula, pemohon boleh pada bila-bila masa semasa menunggu jawapan kepada permohonan yang mula-mula membuat suatu permohonan lanjutan, yang disebut \"permohonan terbahagi\" dalam seksyen ini, untuk mendaftarkan reka bentuk perindustrian yang terkeluar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan terbahagi hendaklah berhak mendapat tarikh prioriti permohonan yang mula-mula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian telah diuntukkan tarikh pemfailan dan permohonan itu tidak ditarik balik, Pendaftar hendaklah menyebabkan permohonan itu diteliti bagi menentukan sama ada ia memenuhi kehendak-kehendak formal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, hasil daripada penelitian itu, telah ditentukan bahawa permohonan itu tidak memenuhi kehendak- kehendak formal, Pendaftar hendaklah memberitahu pemohon dan memberinya suatu peluang untuk memberikan pandangan tentang keputusan itu dan untuk meminda permohonan dalam tempoh yang ditetapkan supaya kehendak-kehendak itu dipenuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, dalam tempoh yang ditetapkan, pemohon gagal meyakinkan Pendaftar bahawa kehendak-kehendak formal telah dipenuhi atau meminda permohonan supaya kehendak itu dipenuh, Pendaftar boleh enggan mendaftarkan reka bentuk perindustrian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak boleh enggan di bawah subseksyen (3) untuk mendaftarkan sesuatu reka bentuk perindustrian sehingga pemohon sudah diberi peluang untuk didengar. REKA BENTUK PERINDUSTRIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, \"kehendak-kehendak formal\" ertinya kehendak-kehendak Akta ini dan mana-mana peraturan yang dibuat di bawah Akta ini yang ditetapkan melalui peraturan-peraturan itu sebagai kehendak-kehendak formal bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar berpuas hati bahawa suatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian mematuhi kehendak seksyen 21, dia hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendaftarkan reka bentuk perindustrian itu dengan merekodkan butir-butir yang ditetapkan dalam Daftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan kepada pemohon perakuan pendaftaran reka bentuk perindustrian itu dalam bentuk yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Dengan seberapa segera yang mungkin selepas itu Pendaftar hendaklah menyebabkan disiarkan dalam Warta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu notis bahawa reka bentuk perindustrian itu telah didaftarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nama dan alamat pemunya berdaftarnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang membentuk atau berhubungan dengan reka bentuk perindustrian itu yang pada fikirannya wajar disiarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran hendaklah menjadi keterangan prima facie tentang fakta yang dinyatakan dalamnya dan kesahan pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu reka bentuk perindustrian sudah didaftarkan berkenaan dengan apa-apa barang dan pemunya reka bentuk perindustrian itu membuat permohonan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendaftarkan, berkenaan dengan satu barang lain atau lebih, reka bentuk perindustrian berdaftar itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendaftarkan, berkenaan dengan barang yang sama atau satu barang lain atau lebih, suatu reka bentuk perindustrian yang terdiri daripada reka bentuk perindustrian berdaftar itu dengan ubahsuaian atau kelainan yang tidak mencukupi untuk mengubah ciri atau untuk secara substansial menyentuh identitinya, permohonan itu tidak boleh ditolak, dan pendaftaran yang dibuat berasaskan permohonan itu tidak boleh dibatalkan semata-mata disebabkan oleh pendaftaran yang terdahulu, atau apa-apa penzahiran atau penggunaan selepas tarikh prioriti berkenaan dengan permohonan bagi pendaftaran yang terdahulu, reka bentuk perindustrian yang telah didaftarkan berasaskan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh pendaftaran sesuatu reka bentuk perindustrian yang didaftarkan mengikut seksyen ini tidak boleh dilanjutkan melebihi tempoh pendaftaran reka bentuk perindustrian berdaftar yang asal dan apa-apa tempoh lanjutan kepada tempoh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh, atas permohonan mengikut cara yang ditetapkan daripada mana-mana orang yang terkilan dengan atau berkepentingan dalam ketakmasukan atau peninggalan daripada Daftar apa-apa catatan, atau dengan atau dalam apa- apa catatan yang dibuat dalam Daftar tanpa sebab yang mencukupi, atau apa-apa catatan yang secara salah masih ada dalam Daftar, atau apa- apa kesilapan atau kecacatan apa-apa catatan dalam Daftar, membuat apa-apa perintah supaya dimasukkan, dibuat, dikeluarkan atau diubah apa- apa catatan sedemikian supaya dibetulkan apa- apa kesilapan atau kecacatan sedemikian yang didapatinya perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh, dalam apa-apa prosiding di bawah seksyen ini, memutuskan apa-apa soalan yang mungkin perlu atau suaimanfaat untuk diputuskan berkaitan dengan pembetulan Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal fraud dalam pendaftaran, penyerahhakan atau pindahmilik sesuatu reka bentuk perindustrian berdaftar atau jika pada pendapatnya adalah untuk kepentingan awam dia berbuat demikian, Pendaftar sendiri boleh memohon kepada Mahkamah di bawah seksyen ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah Mahkamah yang membetulkan Daftar hendaklah mengarahkan supaya notis tentang perintah itu disampaikan kepada Pendaftar mengikut cara yang ditetapkan dan Pendaftar hendaklah apabila menerima notis itu membetulkan Daftar dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), Mahkamah tidak boleh membuat apa-apa perintah atas permohonan seseorang selain daripada Pendaftar sehingga notis tentang permohonan itu telah diberikan kepada Pendaftar yang berhak hadir dan didengar tentang permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan bagi membetulkan Daftar, yang di bawah subseksyen (1) hendaklah dibuat kepada Mahkamah dan jika pemohon bukan Pendaftar sendiri, boleh, mengikut pilihan pemohon, dibuat pada mula- mulanya kepada Pendaftar kecuali jika sesuatu tindakan berkaitan dengan reka bentuk perindustrian yang berkenaan masih belum selesai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh pada mana-mana peringkat apa- apa permohonan untuk membetulkan Daftar yang dibuat kepadanya merujukkan mana-mana permohonan itu kepada Mahkamah, atau Pendaftar boleh, setelah mendengar pemohon mana-mana permohonan sedemikian dan juga pemunya jika pemohon bukan pemunya reka bentuk perindustrian berdaftar itu, memutuskan persoalan antara mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik seorang Pendaftar Reka Bentuk Perindustrian yang hendaklah diberi kuasa dan fungsi bagi pentadbiran yang sepatutnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberi Pendaftar apa-apa arahan yang konsisten dengan peruntukan Akta ini tentang penjalanan dan pelaksanaan kuasa dan fungsi berhubungan dengan apa-apa perkara yang didapatinya kena mengena dengan kemajuan reka bentuk perindustrian dan perkara lain yang berkaitan dengannya dan Pendaftar hendaklah melaksanakan apa-apa arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik apa-apa bilangan Timbalan Pendaftar Reka Bentuk Perindustrian yang perlu bagi melaksanakan peruntukan Akta ini dan Timbalan Pendaftar itu, tertakluk kepada kawalan Pendaftar, hendaklah mempunyai segala kuasa dan fungsi Pendaftar di bawah Akta ini kecuali kuasa pewakilan yang disebut dalam subseksyen (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik apa-apa bilangan Penolong Pendaftar Reka Bentuk Perindustrian yang perlu untuk melaksanakan peruntukan Akta ini dan apa-apa peraturan yang dibuat di bawahnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, berhubungan dengan sesuatu perkara atau kelas perkara tertentu, mewakilkan kepada seseorang Penolong Pendaftar secara bertulis di bawah tandatangannya semua atau mana-mana kuasa atau fungsinya di bawah Akta ini, kecuali kuasa pewakilannya, tetapi pewakilan yang dibuat di bawah subseksyen ini boleh dibatalkan menurut budi bicara Pendaftar dan tidaklah menghalang penjalanan kuasa atau fungsi itu oleh Pendaftar atau mana-mana Timbalan Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mempunyai meterai dengan reka bentuk yang diluluskan oleh Menteri dan teraan meterai itu hendaklah diberi pengiktirafan kehakiman dan diterima sebagai keterangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, maka hendaklah ditubuhkan suatu Pejabat Pendaftaran Reka Bentuk Perindustrian yang hendaklah menjadi pejabat Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah bertanggungjawab bagi pentadbiran Pejabat Pendaftaran Reka Bentuk Perindustrian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui pemberitahuan dalam Warta, menubuhkan apa-apa bilangan pejabat cawangan bagi Pejabat Pendaftaran Reka Bentuk Perindustrian yang didapatinya perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan atau dokumen lain yang dikehendaki atau dibenarkan difailkan di Pejabat Pendaftaran Reka Bentuk Perindustrian boleh difailkan di mana-mana pejabat cawangan Pejabat Pendaftaran Reka Bentuk Perindustrian dan permohonan atau dokumen lain itu hendaklah disifatkan telah difailkan di Pejabat Pendaftaran Reka Bentuk Perindustrian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menyimpan dan menyenggara suatu daftar yang dinamakan Daftar Reka Bentuk Perindustrian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dicatatkan dalam Daftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nama dan alamat pemunya reka bentuk perindustrian berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "notis penyerahhakan dan perpindahan reka bentuk perindustrian berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang ditetapkan dari semasa ke semasa atau yang difikirkan perlu oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah disimpan dalam bentuk dan pada bahan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Notis tentang sesuatu amanah, sama ada nyata, tersirat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau konstruktif, tidak boleh dicatatkan dalam Daftar atau disetuju terima oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah terbuka untuk diperiksa oleh orang ramai pada masa yang boleh ditetapkan oleh Menteri melalui peraturan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Salinan atau cabutan yang diperakui benar bagi mana-mana catatan dalam Daftar yang dimeterai dengan meterai Pendaftar hendaklah diberikan kepada mana-mana orang yang menghendakinya apabila fee yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah menjadi keterangan prima facie bagi semua perkara yang dikehendaki atau diberi kuasa oleh Akta ini untuk dicatatkan di dalamnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh membekalkan satu salinan atau cabutan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana catatan atau dokumen dalam Daftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dokumen atau penerbitan di Pejabat Pendaftaran Reka Bentuk Perindustrian, yang diperakui secara bertulis di bawah tandatangan dan meterainya sebagai salinan atau cabutan benar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Salinan atau cabutan yang telah diperakui dan dimeteraikan sedemikian boleh diterima sebagai keterangan yang sama sahnya dengan salinan asal dalam semua mahkamah dan prosiding tanpa dibuktikan selanjutnya atau dikemukakan salinan asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh memperakui secara bertulis di bawah tandatangan dan meterainya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa sesuatu catatan, perkara atau benda yang dikehendaki supaya dibuat atau dilakukan atau tidak dibuat atau tidak dilakukan, di bawah Akta ini, sudah atau telah tidak, mengikut mana-mana yang berkenaan, dibuat atau dilakukan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_II__cl_9__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa sesuatu buku, dokumen atau penerbitan di Pejabat Pendaftaran Reka Bentuk Perindustrian ada disediakan untuk pemeriksaan oleh orang ramai pada tarikh yang dinyatakan dalam perakuan itu, dan perakuan itu hendaklah diterima sebagai keterangan prima facie tentang perkara yang dinyatakan dalam . perakuan itu dalam mana-mana prosiding undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "TEMPOH PENDAPTARAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran sesuatu reka bentuk perindustrian hendaklah disifatkan telah mula berkuatkuasa pada tarikh pemfailan permohonan untuk mendaftarkan reka bentuk perindustrian itu dan hendaklah berkuatkuasa selama lima tahun selepas itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh pendaftaran sesuatu reka bentuk perindustrian boleh dilanjutkan dua kali lagi berturut- turut selama tempoh lima tahun bagi setiap kali lanjutan jika suatu permohonan bagi mendapatkan pelanjutan dibuat dalam borang yang ditetapkan, dan fee pelanjutan yang ditetapkan dibayar sebelum luput tempoh pendaftaran semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh tangguhan selama enam bulan dari tarikh apa-apa fee pelanjutan yang belum dibayar kena dibayar hendaklah diberikan bagi pembayaran fee pelanjutan itu, tertakluk kepada pembayaran apa-apa surcaj sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu permohonan pelanjutan tidak dibuat atau sesuatu fee pelanjutan tidak dibayar mengikut kehendak seksyen ini, pendaftaran hendaklah luput dan notis tentang luputnya pendaftaran itu hendaklah disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam masa satu tahun dari tarikh notis tentang luputnya pendaftaran sesuatu reka bentuk perindustrian disiarkan dalam Warta, pemunya atau penggantinya dalam hakmilik boleh memohon untuk memasukkan semula pendaftaran reka bentuk perindustrian itu dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memfailkan suatu permintaan bagi kemasukan semula itu dalam borang yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa fee pelanjutan yang belum jelas dan surcaj yang ditetapkan bagi kemasukan semula; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memfailkan suatu pernyataan yang menerangkan hal keadaan yang menyebabkan kegagalan untuk melanjutkan pendaftaran reka perindustrian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar berpuas hati bahawa kegagalan untuk melanjutkan pendaftaran itu tidak disengajakan atau disebabkan oleh kesilapan, dia boleh menyiarkan dalam Warta suatu notis yang menyatakan niat untuk memasukkan semula pendaftaran yang telah luput itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang berkepentingan boleh, dalam masa tiga bulan dari tarikh penyiaran itu, memberikan notis kepada Pendaftar tentang bangkangan terhadap kemasukan semula pendaftaran itu dan hendaklah menyampaikan satu salinan notis itu kepada pemohon kemasukan semula itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada notis bangkangan diberikan mengikut subseksyen (3) dalam tempoh tiga bulan berikutan tarikh penyiaran yang disebut dalam subseksyen (2), Pendaftar hendaklah memasukkan semula pendaftaran reka bentuk perindustrian itu, yang hendaklah berkuatkuasa seolah- olah pendaftaran itu tidak luput, dan dia hendaklah menyiarkan suatu notis dalam Warta bahawa pendaftaran itu telah dimasukkan semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika notis bangkangan diberikan mengikut subseksyen (3), Pendaftar hendaklah, selepas memberi pembangkang dan pemohon kemasukan semula peluang untuk didengar, memutuskan perkara itu, dan jika dia memutuskan untuk memasukkan semula pendaftaran, maka pendaftaran itu hendaklah berkuatkuasa seolah-olah ia tidak luput, dan dia hendaklah menyiarkan suatu notis dalam Warta bahawa pendaftaran itu telah dimasukkan semula sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Tindakan atau prosiding tidak boleh diambil berkenaan dengan sesuatu pelanggaran reka bentuk perindustrian berdaftar yang dilakukan antara tarikh pendaftaran reka bentuk perindustrian itu terhenti berkuatkuasa dengan tarikh penyiaran dalam Warta tentang kemasukan semula pendaftaran reka bentuk perindustrian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Pendaftar untuk membenarkan atau enggan membenarkan kemasukan semula di bawah seksyen ini boleh membuat rayuan kepada Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas pendaftaran sesuatu reka bentuk perindustrian, mana-mana orang yang berkepentingan boleh memohon kepada Mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya dibatalkan pendaftaran reka bentuk perindustrian itu atas alasan, tertakluk kepada seksyen 12, bahawa reka bentuk perindustrian itu telah dizahirkan kepada awam sebelum tarikh prioriti permohonan untuk mendaftarkan reka bentuk perindustrian itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya dibatalkan pendaftaran reka bentuk perindustrian itu atas alasan bahawa pendaftaran reka bentuk perindustrian itu telah diperolehi dengan cara yang melanggar undang-undang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya diberi lesen wajib berkenaan dengan reka bentuk perindustrian itu atas alasan bahawa reka bentuk perindustrian itu tidak digunakan di Malaysia melalui apa-apa proses perindustrian atau cara perindustrian pada barang yang berkenaan dengannya ia didaftarkan setakat yang munasabah mengikut hal keadaan kes itu, dan Mahkamah boleh membuat perintah sedemikian berasaskan permohonannya itu sebagaimana yang didapatinya adil."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan perenggan ( 1 )( a) dan (1) (b) tidaklah menjejaskan hak pemunya sesuatu reka bentuk perindustrian untuk meminta Pendaftar membatalkan pendaftaran reka bentuk perindustrian yang dia menjadi pemunya, atau kuasa Pendaftar untuk mengarahkan pembatalan pendaftaran sesuatu reka bentuk perindustrian atas apa-apa alasan lain sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada perintah yang tak konsisten dengan mana-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mana triti, konvensyen, perkiraan atau perjanjian dengan mana-mana negara di luar Malaysia boleh dibuat oleh Mahkamah di bawah seksyen 27. REKA BENTUK PERINDUSTRIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59",
      "@type": "akn:chapter",
      "eli:number": "59",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "(2) Walau apa pun subseksyen (1)— (a) apa-apa perundangan subsidiari yang dibuat di bawah undang-undang termansuh hendaklah, setakat yang perundangan subsidiari itu tidak bertentangan dengan peruntukan Akta ini, terus berkuatkuasa dan mempunyai kesan seolah-olah ia telah dibuat di bawah Akta ini dan boleh dimansuhkan, diperluas, diubah atau dipinda dengan sewajarnya; (b) apa-apa pelantikan yang dibuat di bawah undang- undang termansuh atau perundangan subsidiari yang dibuat di bawah undang-undang termansuh REKA BENTUK PERINDUSTRIAN hendaklah terus berkuatkuasa dan mempunyai kesan seolah-olah ia telah dibuat di bawah Akta ini melainkan jika Menteri mengarahkan selainnya; (c) apa-apa pendaftaran yang dilindungi di bawah undang-undang termansuh dan berkuatkuasa sebaik sahaja sebelum Akta berkuatkuasa hendaklah, tertakluk kepada terma, syarat dan tempoh kesahan yang dinyatakan dalam pendaftaran itu, terus berkuatkuasa dan mempunyai kesan yang sama seolah-olah ia telah dilaksanakan di bawah Akta ini, tetapi apa-apa pelanjutan yang dibuat selepas itu hendaklah menurut subseksyen 50(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum Akta ini mula berkuatkuasa, suatu permohonan untuk mendaftarkan suatu reka bentuk perindustrian telah dibuat di bawah Akta Pendaftaran Reka Bentuk 1949 bagi United Kingdom sebagaimana yang dipinda oleh Akta Hakcipta, Reka Bentuk dan Paten 1988 bagi United Kingdom dan menunggu pendaftaran, pemohon itu boleh, dalam masa dua belas bulan dari tarikh Akta ini mula berkuatkuasa, membuat permohonan untuk mendaftarkan reka bentuk perindustrian itu di bawah Akta ini, dan permohonan itu hendaklah diberi tarikh prioriti yang telah diberikan di United Kingdom."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__chp_59__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran yang diberikan di bawah Akta Pendaftaran Reka Bentuk 1949 bagi United Kingdom hendaklah mempunyai tempoh kesahan maksimum yang diberikan di bawah undang-undang yang dimansuhkan itu dan bagi maksud ini, prosedur pelanjutan hendaklah seperti yang ditetapkan dalam peraturan-peraturan yang dibuat di bawah seksyen 47 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa notis yang dikehendaki supaya diberikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "atau dibenarkan diberikan di bawah Akta ini atau mana- mana peraturan yang dibuat di bawah Akta ini, dan apa- apa permohonan atau dokumen lain yang dikehendaki atau dibenarkan dibuat atau difailkan, boleh diberikan, dibuat atau difailkan melalui pos."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu perbuatan dikehendaki oleh Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini supaya dilakukan oleh atau terhadap mana-mana orang berkaitan dengan sesuatu reka bentuk perindustrian atau apa-apa prosedur yang berhubungan dengannya, perbuatan itu boleh, di bawah dan mengikut Akta ini dan mana- mana peraturan yang dibuat di bawah Akta ini atau dalam hal tertentu dengan keizinan khas Pendaftar, dilakukan oleh atau terhadap seorang ejen orang itu yang diberikuasa sewajarnya mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak terikat untuk mengiktiraf sebagai ejen seseorang yang pernah disabitkan atas kesalahan jenayah yang melibatkan fraud atau kejujuran, atau seorang bankrap yang belum dilepaskan atau telah digugurkan atau selainnya disingkirkan daripada daftar keahlian mana- mana badan profesional atau digantung buat sementara waktu daripada menjalankan amalan oleh mana-mana badan atau jawatankuasa badan profesional itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan apa-apa keputusan atau perintah Pendaftar boleh merayu kepada Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah prosedur yang sama tentang rayuan hendaklah terpakai bagi rayuan yang dibuat di bawah subseksyen (1) seperti yang terpakai bagi rayuan kepada Mahkamah Tinggi daripada suatu keputusan mahkamah rendah dalam perkara sivil."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh membuat peraturan bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Khususnya dan tanpa menjejaskan keluasan makna subseksyen (1), peraturan-peraturan yang dibuat di bawah seksyen ini boleh mengadakan peruntukan bagi kesemua atau mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawalselia prosedur yang hendaklah diikuti berkaitan dengan apa-apa prosiding atau perkara lain di hadapan Pendaftar atau Pejabat Pendaftaran Reka Bentuk Perindustrian di bawah Akta ini termasuklah penyampaian dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengelaskan barang bagi maksud pendaftaran reka bentuk perindustrian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menghendaki penduaan dokumen yang berkaitan dengan pendaftaran reka bentuk perindustrian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan fee yang hendaklah dibayar berkaitan dengan apa-apa prosiding atau perkara lain atau berkaitan dengan pemberian apa-apa perkhidmatan oleh Pendaftar atau Pejabat Pendaftaran Reka Bentuk Perindustrian, dan menetapkan amaun fee itu dan membenarkan fee yang berbeza dalam keadaan-keadaan tertentu untuk kes tertentu yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan borang dan perkara lain yang akan digunakan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawalselia penyimpanan Daftar dan menetapkan bentuk dan kandungannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawalselia cara memberikan keterangan dalam mana-mana prosiding di hadapan Pendaftar di bawah Akta ini dan memberi Pendaftar kuasa untuk memaksa kehadiran saksi dan penzahiran dan pengemukaan dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa jua yang dikehendaki supaya dilakukan berkaitan dengan apa-apa prosiding atau perkara lain di hadapan Pendaftar atau Pejabat Pendaftaran Reka Bentuk Perindustrian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal pengiktirafan ejen yang mewakili pemohon atau pihak lain di hadapan Pendaftar atau Pejabat Pendaftaran Reka Bentuk Perindustrian, dan menetapkan kelayakan dan syarat lain yang hendaklah dipenuhi oleh ejen itu sebelum dibenarkan hadir di hadapan Pendaftar atau Pejabat Pendaftaran Reka Bentuk Perindustrian, dan selainnya mengawalselia kelakuan mereka sebagai ejen sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan had masa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "secara umum mengawalselia perkara-perkara yang berhubungan dengan urusan pendaftaran reka bentuk perindustrian yang dijalankan di Pejabat Pendaftaran Reka Bentuk Perindustrian sama ada ditetapkan dengan khusus atau tidak di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta bagi maksud memenuhi sesuatu triti, korwensyen, perkiraan atau perjanjian antara Malaysia dengan suatu negara lain, mengisytiharkan bahawa negara yang dinyatakan dalam perintah itu ialah negara korwensyen bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri, dengan perintah mengisytiharkan bahawa sesuatu permohonan bagi mendapatkan perlindungan berkenaan dengan suatu reka bentuk perindustrian adalah, mengikut terma triti yang wujud antara dua negara konvensyen atau lebih, setara dengan permohonan yang dibuat di salah satu negara konvensyen itu, permohonan yang mula-mula disebut hendaklah, bagi maksud Akta ini, disifatkan telah dibuat di negara konvensyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri, melalui perintah, mengisytiharkan bahawa sesuatu permohonan bagi mendapatkan perlindungan berkenaan dengan suatu reka bentuk perindustrian adalah, mengikut undang-undang suatu negara koiwensyen, setara dengan permohonan yang dibuat di negara korwensyen itu, permohonan yang mula-mula disebut hendaklah, bagi maksud Akta ini, disifatkan telah dibuat di negara konvensyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_49__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_IX__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Reka Bentuk United Kingdom (Perlindungan) 1949, Ordinan Reka Bentuk United Kingdom (Perlindungan) bagi Sabah dan Ordinan Reka Bentuk (United Kingdom) bagi Sarawak (yang semuanya disebut \"undang-undang termansuh\" kemudian daripada Bab 152. ini) adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Reka Bentuk Perindustrian 1996 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai di seluruh Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi permohonan untuk"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mendaftarkan reka bentuk perindustrian yang dibuat selepas Akta ini mula berkuatkuasa dan bagi pendaftaran reka bentuk perindustrian yang dibuat berasaskan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain— \"barang\" ertinya apa-apa barang perkilangan atau kraftangan dan termasuklah mana-mana bahagian barang atau kraftangan itu jika bahagian itu dibuat dan dijual berasingan; \"berdaftar\" ertinya berdaftar di bawah Akta ini; \"Daftar\" ertinya Daftar Reka Bentuk Perindustrian yang disimpan di bawah Akta ini; \"ditetapkan\" ertinya ditetapkan oleh atau di bawah Akta ini atau apa-apa peraturan yang dibuat di bawah Akta ini, dan jika tiada cara dinyatakan, ertinya ditetapkan dari semasa ke semasa melalui perintah yang disiarkan dalam Warta; \"Mahkamah\" ertinya Mahkamah Tinggi atau seorang hakim Mahkamah Tinggi; \"negara konvensyen\" ertinya suatu negara yang berkenaan dengannya sedang berkuatkuasa suatu perintah di bawah seksyen 48 yang mengisytiharkannya sebagai suatu negara konvensyen bagi maksud Akja ini; \"pemunya\" ertinya orang yang didaftarkan sebagai pemunya reka bentuk perindustrian berdaftar atau, jika terdapat dua orang sedemikian atau lebih, setiap orang daripada mereka; \"pemunya asal\" mempunyai erti yang diberikan kepadanya oleh seksyen 10; \"Pendaftar\", \"Timbalan Pendattar\" dan \"Penolong Pendaftar\" masing-masing ertinya Pendaftar Reka Bentuk Perindustrian, Timbalan Pendaftar Reka Bentuk Perindustrian dan Penolong Pendaftar Reka Bentuk Perindustrian yang dilantik di bawah seksyen 4; \"pencipta\" ertinya orang yang mencipta sesuatu reka bentuk; \"pernyataan kebaharuan\", berhubungan dengan sesuatu reka bentuk perindustrian, ertinya pernyataan yang berhubungan dengan representasi sesuatu barang yang padanya reka bentuk perindustrian itu digunakan yang menunjukkan ciri-ciri representasi itu yang berkenaan dengannya kebaharuan dituntut; \"reka bentuk perindustrian\" ertinya ciri bentuk, tatarajah, corak atau hiasan yang digunakan pada sesuatu barang melalui apa-apa proses atau cara perindustrian, iaitu ciri yang, pada barang siap, merupakan ciri yang menarik dan dinilaikan dengan pandangan mata, tetapi tidak termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah atau prinsip pembinaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ciri bentuk atau tatarajah sesuatu barang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "ditentukan semata-mata oleh fungsi yang perlu dilakukan oleh barang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bergantung kepada rupa suatu barang lain dan barang itu dimaksudkan oleh pencipta reka bentuk itu untuk menjadi suatu bahagian yang perlu dalam barang lain itu; \"reka bentuk perindustrian berdaftar\" ertinya suatu reka bentuk perindustrian yang didaftarkan di bawah Akta ini; \"representasi\", berhubungan dengan suatp barang yang padanya reka bentuk perindustrian digunakan, ertinya lukisan, surihan atau spesimen barang yang padanya reka bentuk perindustrian itu digunakan atau gambar foto bagi lukisan, surihan atau spesimen itu; \"set barang\" ertinya sebilangan barang yang sama sifat umumnya dan biasanya dijual bersama-sama, atau dimaksudkan untuk digunakan bersama-sama, iaitu barang yang pada setiap satunya digunakan suatu reka bentuk perindustrian yang sama seperti, atau yang berlainan hanya dari segi butir-butir tak material atau ciri-ciri yang biasanya digunakan dalam perdagangan yang relevan daripada, reka bentuk perindustrian yang digunakan terhadap barang lain atau terhadap mana-mana barang itu; \"wakil diri di sisi undang-undang\", berhubungan dengan orang yang telah mati, ertinya orang yang kepadanya probet wasiat oleh orang yang telah mati itu, surat pentadbiran harta pusaka orang yang telah mati itu atau pemberian lain yang seumpamanya, telah diberikan, sama ada di Malaysia atau di tempat lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang sesuatu barang dalam Akta ini hendaklah dibaca sebagai termasuk sebutan tentang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu set barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "setiap barang dalam suatu set barang; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu set barang dan setiap barang dalam set itu, kedua-duanya, mengikut kehendak keadaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_V__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "HAK PEMUNYA, PENYERAHHAKAN DAN PERPINDAHAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
