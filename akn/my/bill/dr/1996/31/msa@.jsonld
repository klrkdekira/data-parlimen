      "schema:text": {
        "@language": "ms",
        "@value": "PELANGGARAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
