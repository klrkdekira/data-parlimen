        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/31/msa@/~part_VI__cl_35"
      ],
