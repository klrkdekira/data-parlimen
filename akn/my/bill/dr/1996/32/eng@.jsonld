        "@value": "CREATION AND RECOGNITION OF OFFSHORE TRUSTS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/32/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
