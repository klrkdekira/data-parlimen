      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Members of Parliament"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Remuneration) (Amendment) Act 1996 and shall be deemed to have come into force on 1 January 1995."
      }
