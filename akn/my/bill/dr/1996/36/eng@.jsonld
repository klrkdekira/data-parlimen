      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Members of Parliament (Remuneration) Act 1980,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "which in this Act is referred to as the \"principal Act\", is amended in section 3—"
      }
    },
