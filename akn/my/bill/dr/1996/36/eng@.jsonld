      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a) by inserting after the word \"thousand\" the words \"and ninety\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/eng@/~cl_2__para_a__subpara_ii",
