      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b) by inserting after the word \"hundred\" the words \"and ninety\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
