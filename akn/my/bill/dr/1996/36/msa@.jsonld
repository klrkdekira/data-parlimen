      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Saraan) (Pindaan) 1996 dan hendaklah disifatkan telah mula berkuatkuasa pada 1 Januari 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2",
      "@type": "akn:clause",
