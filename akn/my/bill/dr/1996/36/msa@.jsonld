        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a) dengan memasukkan selepas perkataan \"ribu\" perkataan \"sembilan puluh\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b) dengan memasukkan selepas perkataan \"ratus\" perkataan \"sembilan puluh\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dengan memasukkan selepas perkataan \"ratus\" perkataan \"sembilan puluh\". 2 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
