        "@value": "Rang Undang-Undang Ahli Parlimen (Saraan) (Pindaan) 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_1",
      "@type": "akn:clause",
