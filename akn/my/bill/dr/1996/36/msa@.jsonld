      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Ahli Parlimen (Saraan) 1980, yang disebut \"Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ibu\" dalam Akta ini, adalah dipinda dalam seksyen 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/36/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
