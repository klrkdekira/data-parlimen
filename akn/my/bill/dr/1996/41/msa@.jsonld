      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/41/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/41/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/41/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi tiga"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "puluh satu bilion empat puluh tujuh juta satu-ratus tiga puluh satu ribu tujuh ratus ringgit (RM31,047,131,700) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 1997 adalah dengan ini dibenarkan, dan jumlah wang itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
