      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Board shall consist of the following members who shall be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Accountant General; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "six other members who possess knowledge and experience in matters of financial accounting and reporting and in one or more of the following fields:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "accountancy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "business;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "finance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "At least five of the members appointed under subsection (1) shall be members of the Malaysian Institute of Accountants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint three advisors to the Board to represent—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Securities Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Central Bank of Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar of Companies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The advisors to be appointed under subsection (3) shall be appointed from amongst persons who possess knowledge and experience in the field of accountancy, law, business or finance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An advisor appointed under subsection (3) shall, unless he sooner resigns or his appointment is sooner revoked, hold office for such term as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall meet as often as may be necessary for the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Six members of the Board shall form the quorum at all meetings of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The advisors to the Board shall have the right to attend meetings of the Board but shall not have a right to vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A question arising at any meeting of the Board shall be determined by not less than six votes of the members present and voting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have power to determine the conduct of its proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may invite any person to attend any meeting or deliberation of the Board for the purpose of obtaining views on any matter under discussion, but any person so attending shall have no right to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Where financial statements are required to be prepared"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or lodged under any law administered by the Securities Commission, the Central Bank or the Registrar of Companies, and approved accounting standards have been issued or adopted by the Board under subsection 7(1), such financial statements shall be deemed not to have complied with the requirement of such law unless they have been prepared and are kept in accordance with the approved accounting standards."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the purpose of any civil or criminal proceedings under any written law or for the purpose of assisting any authority or agency in the performance or exercise of its functions or power under any written law in Malaysia, the Foundation and the Board shall take all reasonable measures to protect from unauthorised use or disclosure any information given to the Foundation or the Board in confidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be"
      },
      "schema:text": {
        "@language": "en",
        "@value": "expedient or necessary for carrying out or giving effect to the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Financial Reporting Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on such date as the Minister may, by notification in the Gazette appoint, and the Minister may appoint different dates for the coming into force of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/44/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"accounting standards\" means statements of standard accounting practices used for the preparation of financial statements; \"approved accounting standards\" means accounting standards which are issued or approved by the Board under subsection 7(1); \"Board\" means the Malaysian Accounting Standards Board established under section 7; \"Central Bank\" means the Central Bank of Malaysia established under the Central Bank of Malaysia Act 1958; \"Foundation\" means the Financial Reporting Foundation established under section 3; \"Fund\" means the Fund established under subsection 19(1); \"Malaysian Institute of Accountants\" means the body established under section 3 of the Accountants Act 1967; \"Minister\" means the Minister for the time being charged with the responsibility for finance; \"principal officer\", in relation to a public listed company, means a person by whatever name called who is responsible for the conduct of the business and administration of the public listed company, and includes a non-executive chairman of the public listed company; \"Registrar of Companies\" means the Registrar of Companies appointed under the Companies Act 1965; \"Securities Commission\" means the Securities Commission established under the Securities Commission Act 1993."
      }
    }
  ]
}
