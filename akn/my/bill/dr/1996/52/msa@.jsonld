        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMANSUHAN AKTA DAGANGAN KOMODITI 1985 DAN PERUNTUKAN KECUALIAN DAN PERALIHAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Bab ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"Akta ibu\" ertinya Akta Perindustrian Niaga Hadapan 1993; \"berdagang\" mempunyai erti yang sama seperti dalam Akta ibu; \"gabungan\" mempunyai erti yang sama seperti dalam Akta ibu; \"kontrak niaga hadapan\" mempunyai erti yang sama seperti dalam Akta ibu; \"Menteri\" mempunyai erti yang sama seperti dalam Akta ibu; \"pasaran niaga hadapan\" mempunyai erti yang sama seperti dalam Akta ibu; \"Pesuruhjaya\" mempunyai erti yang sama seperti dalam Akta Dagangan Komoditi 1985; \"Suruhanjaya Dagangan Komoditi\" ertinya Suruhanjaya Dagangan Komoditi yang ditubuhkan oleh Akta Dagangan Komoditi 1985; \"Suruhanjaya Sekuriti\" ertinya Suruhanjaya Sekuriti yang ditubuhkan oleh Akta Suruhanjaya Sekuriti 1993; \"tarikh mula berkuatkuasa\", apabila digunakan dalam sesuatu peruntukan dalam Bab ini, ertinya tarikh peruntukan itu mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Dagangan Komoditi 1985, yang disebut \"Akta termansuh\" dalam Bab ini, adalah dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perundangan subsidiari yang dibuat, atau disifatkan telah dibuat, di bawah Akta termansuh adalah dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Suruhanjaya Dagangan Komoditi adalah, pada tarikh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mula berkuatkuasa, dibubarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, sebelum sahaja tarikh mula berkuatkuasa, merupakan seorang pekerja Suruhanjaya Dagangan Komoditi boleh, pada tarikh mula berkuatkuasa, membuat pilihan untuk menjadi pekerja Suruhanjaya Sekuriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang membuat pilihan sedemikian, Suruhanjaya Sekuriti hendaklah mengambil kerja orang Perindustrian Niaga Hadapan (Pindaan dan Penyatuan) itu atas terma dan syarat yang tidak kurang baiknya daripada yang terpakai berkenaan dengan orang itu sebelum sahaja tarikh mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa wang yang terkandung, sebelum sahaja tarikh mula berkuatkuasa, dalam Kumpulan Wang Suruhanjaya Dagangan Komoditi yang ditubuhkan di bawah subseksyen 13(1) Akta termansuh hendaklah menjadi, pada tarikh mula berkuatkuasa, harta Kerajaan dan hendaklah dibayar ke dalam Kumpulan Wang Disatukan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa harta lain yang terkandung dalam Kumpulan Wang Suruhanjaya Dagangan Komoditi sebelum sahaja tarikh mula berkuatkuasa hendaklah menjadi, pada tarikh mula berkuatkuasa, harta Suruhanjaya Sekuriti melainkan jika Menteri mengisytiharkan secara bertulis selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa wang yang terkandung, sebelum sahaja tarikh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mula berkuatkuasa, dalam Akaun Deposit-Deposit Dagangan Hadapan yang ditubuhkan di bawah subseksyen 14(1) Akta termansuh hendaklah, pada tarikh mula berkuatkuasa, dibayar kepada Suruhanjaya Sekuriti dan hendaklah disifatkan telah dibayar di bawah seksyen 103 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Apa-apa harta yang dipegang, sebelum sahaja tarikh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "mula berkuatkuasa, atas amanah oleh Suruhanjaya Dagangan Komoditi atau Pesuruhjaya menurut suatu perintah di bawah subperenggan 116(l)(iv) Akta termansuh hendaklah menjadi, pada tarikh mula berkuatkuasa, harta Suruhanjaya Sekuriti dan hendaklah dipegang atas amanah tertakluk kepada terma amanah yang mengenainya harta itu dipegang oleh Suruhanjaya Dagangan Komoditi atau Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, prosiding yang kepadanya Suruhanjaya Dagangan Komoditi atau Pesuruhjaya menjadi pihak sedang menunggu penyelesaian di mana-mana mahkamah, Suruhanjaya Sekuriti hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah menggantikan Suruhanjaya Dagangan Komoditi atau Pesuruhjaya sebagai suatu pihak kepada prosiding itu dan hendaklah mempunyai hak yang sama dalam prosiding itu sebagaimana yang dipunyai oleh Suruhanjaya Dagangan Komoditi atau Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu hak tindakan yang memihak kepada atau terhadap Suruhanjaya Dagangan Komoditi atau Pesuruhjaya yang ada sebelum sahaja tarikh mula berkuatkuasa hendaklah, pada tarikh mula berkuatkuasa, disifatkan sebagai suatu hak tindakan yang memihak kepada atau terhadap Suruhanjaya Sekuriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu rayuan yang dibuat kepada Suruhanjaya Dagangan Komoditi di bawah seksyen 46, 73 atau 95 Akta termansuh yang belum diputuskan sebelum tarikh mula berkuatkuasa hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah dibuat kepada Suruhanjaya Sekuriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu hak rayuan kepada Suruhanjaya Dagangan Komoditi di bawah seksyen 46, 73 atau 95 Akta termansuh yang ada sebelum sahaja tarikh mula berkuatkuasa hendaklah, pada tarikh mula berkuatkuasa, disifatkan sebagai suatu hak rayuan kepada Suruhanjaya Sekuriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, apa-apa prosiding jenayah sedang menunggu penyelesaian dalam mana-mana mahkamah, prosiding itu hendaklah diteruskan seolah-olah pindaan kepada Akta ini telah tidak dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, tiada apa-apa jua dalam seksyen ini menyentuh seksyen 30 Akta Tafsiran 1948 dan 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, sesuatu syarikat telah diluluskan di bawah seksyen 19 Akta termansuh untuk menubuhkan dan mengendalikan suatu bursa komoditi, syarikat itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan sebagai suatu syarikat yang berhubungan dengannya suatu kelulusan di bawah subseksyen 4(1) Akta ibu berkuatkuasa. (Pindaan dan Penyatuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kelulusan bagi syarikat itu di bawah seksyen 19 Akta termansuh telah diberikan tertakluk kepada syarat, kelulusan yang dikira oleh subseksyen (1) sebagai telah diberikan di bawah subseksyen 4(1) Akta ibu hendaklah disifatkan telah diberikan tertakluk kepada syarat yang sama, setakat yang syarat itu tidak tak konsisten dengan peruntukan Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (5), Menteri boleh, tidak kurang daripada satu tahun selepas tarikh mula berkuatkuasa, mengenakan apa-apa terma atau syarat tambahan yang difikirkan patut olehnya ke atas syarikat yang disifatkan oleh subseksyen (1) telah diluluskan sebagai suatu syarikat bursa di bawah subseksyen 4(1) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa terma atau syarat yang dikenakan di bawah subseksyen (3) hendaklah disifatkan telah dikenakan di bawah subseksyen 4(4) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa yang diberikan oleh subseksyen (3) tidak boleh dijalankan selepas dua tahun dari tarikh mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Anggota Lembaga Pengurusan sesuatu syarikat yang"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "disebut dalam seksyen 21 yang dipilih atau dilantik di bawah subseksyen 22(2) Akta termansuh dan yang memegang jawatan sebelum sahaja tarikh mula berkuatkuasa hendaklah terus memegang jawatan itu selama tempoh satu tahun dari tarikh mula berkuatkuasa seolah-olah mereka ialah pengarah yang dipilih atau dilantik dengan sewajarnya di bawah seksyen 5 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, sesuatu syarikat ialah suatu pusat penjelasan mengikut pengertian Akta termansuh, syarikat itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah diluluskan sebagai suatu pusat penjelasan di bawah subseksyen 6B(l) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (4), Menteri boleh, tidak kurang daripada satu tahun selepas tarikh mula berkuatkuasa, mengenakan apa-apa terma atau syarat yang difikirkan patut olehnya ke atas sesuatu syarikat yang disifatkan oleh subseksyen (1) telah diluluskan sebagai suatu pusat penjelasan di bawah subseksyen 6B(l) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa syarat yang dikenakan di bawah subseksyen (2) hendaklah disifatkan sebagai suatu syarat kelulusan bagi maksud seksyen 7A Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa yang diberikan oleh subseksyen (2) tidak boleh dijalankan selepas dua tahun dari tarikh mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengarah sesuatu pusat penjelasan yang disebut dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 23 yang memegang jawatan sebelum sahaja tarikh mula berkuatkuasa hendaklah terus memegang jawatan selama tempoh satu tahun dari tarikh mula berkuatkuasa seolah-olah mereka ialah pengarah yang dipilih atau dilantik dengan sewajarnya di bawah seksyen 6c Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika, sebelum tarikh mula berkuatkuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu syarikat yang adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu syarikat bursa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pusat penjelasan, mengikut pengertian Akta termansuh telah mengemukakan kepada Suruhanjaya Dagangan Komoditi apa-apa pindaan kepada perlembagaan, kaedah-kaedah atau peraturan-peraturannya di bawah seksyen 20 Akta termansuh; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya Dagangan Komoditi belum memberitahu syarikat itu di bawah subseksyen 20(3) Akta termansuh mengenai kelulusannya atau keengganannya untuk meluluskan pindaan sedemikian, Perindustrian Niaga Hadapan (Pindaan dan Penyatuan) pengemukaan itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah dibuat kepada Suruhanjaya Sekuriti—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu syarikat yang adalah suatu syarikat bursa mengikut pengertian Akta termansuh, oleh suatu syarikat bursa di bawah seksyen 6 Akta ibu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_25__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu syarikat yang adalah suatu pusat penjelasan mengikut pengertian Akta termansuh, oleh suatu pusat penjelasan di bawah seksyen 60 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu arahan yang diberikan di bawah subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "26(1) Akta termansuh, atau sesuatu notis yang diberikan di bawah subseksyen 26(2) Akta termansuh, yang berkuatkuasa sebelum sahaja tarikh mula berkuatkuasa, hendaklah disifatkan telah diberikan dengan sewajarnya di bawah seksyen 8 Akta ibu dan seksyen itu hendaklah terpakai berkenaan dengan arahan atau notis itu selepas tarikh mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu arahan yang diberikan di bawah subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "27(1) Akta termansuh yang berkuatkuasa sebelum sahaja tarikh mula berkuatkuasa hendaklah dianggap telah diberikan dengan sewajarnya di bawah subseksyen 9(1) Akta ibu dan subseksyen 9(1) itu hendaklah terpakai berkenaan dengan arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Tindakan yang diambil oleh Suruhanjaya Dagangan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Komoditi di bawah seksyen 28 Akta termansuh hendaklah, jika ia telah berkuatkuasa sebelum sahaja tarikh mula berkuatkuasa, disifatkan telah diambil dengan sewajarnya oleh Suruhanjaya Sekuriti di bawah seksyen 10 Akta ibu dan seksyen 10 itu hendaklah terpakai berkenaan dengan arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya Dagangan Komoditi telah membuat"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "syor kepada Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi perusahaan utama mengikut pengertian seksyen 29 Akta termansuh dan Menteri itu belum, sebelum tarikh mula berkuatkuasa, bertindak atas syor itu, syor itu hendaklah disifatkan telah dibuat dengan sewajarnya oleh Suruhanjaya Sekuriti di bawah seksyen 11 Akta ibu kepada Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi kewangan dan Menteri itu boleh bertindak atas syor itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, seseorang telah didaftarkan sebagai peniaga di bawah seksyen 33 Akta termansuh, orang itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah diberi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu perbadanan, suatu lesen broker niaga hadapan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seseorang individu, suatu lesen wakil broker niaga hadapan, di bawah subseksyen 22(1) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, seseorang telah didaftarkan sebagai penasihat dagangan komoditi di bawah seksyen 34 Akta termansuh, orang itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah diberi lesen penasihat perdagangan niaga hadapan di bawah subseksyen 22(1) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, seseorang telah didaftarkan sebagai wakil peniaga di bawah seksyen 35 Akta termansuh, orang itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah diberi lesen wakil broker niaga hadapan di bawah subseksyen 22(1) Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, seseorang telah didaftarkan sebagai wakil penasihat dagangan komoditi di bawah seksyen 36 Akta termansuh, orang itu hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah diberi lesen wakil penasihat perdagangan niaga hadapan di bawah subseksyen 22(1) Akta ibu. (Pindaan dan Penyatuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pendaftaran di bawah Akta termansuh telah dijadikan tertakluk kepada syarat, lesen yang dikira telah diberikan oleh seksyen ini berkenaan dengan pendaftaran itu hendaklah disifatkan telah diberikan tertakluk kepada syarat yang sama setakat yang syarat itu tidak tak konsisten dengan peruntukan Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Sesuatu permohonan yang dibuat dengan sewajarnya"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kepada Pesuruhjaya bagi pembaharuan pendaftaran di bawah subseksyen 41(1) Akta termansuh yang belum diuruskan sebelum tarikh mula berkuatkuasa hendaklah disifatkan telah dibuat kepada Suruhanjaya Sekuriti di bawah seksyen 25 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika, sebelum tarikh mula berkuatkuasa, sesuatu"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "siasatan telah dijalankan oleh Pesuruhjaya di bawah seksyen 44 Akta termansuh tetapi siasatan itu belum selesai sebelum tarikh mula berkuatkuasa, siasatan itu boleh diselesaikan oleh Suruhanjaya Sekuriti di bawah seksyen 28 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, sebelum sahaja tarikh mula berkuatkuasa, pendaftaran seseorang orang berdaftar yang disifatkan oleh seksyen 30 telah diberi suatu lesen telah digantung, penggantungan itu hendaklah terus berjalan selepas tarikh mula berkuatkuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu penggantungan di bawah seksyen 43 Akta termansuh, sehingga hak orang itu untuk berdagang dalam kontrak niaga hadapan di pasaran niaga hadapan sesuatu syarikat bursa, mengikut pengertian Akta ibu yang orang itu menjadi gabungannya dipulihkan oleh syarikat bursa itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal sesuatu penggantungan menurut seksyen 44 Akta termansuh, bagi suatu masa, atau sehingga berlaku sesuatu kejadian, sebagaimana yang telah ditentukan oleh Pesuruhjaya di bawah perenggan 44(2)(b) Akta termansuh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Hakikat bahawa pendaftaran orang berdaftar itu telah, sebelum sahaja tarikh mula berkuatkuasa, digantung hendaklah disifatkan bagi maksud seksyen 28 Akta ibu sebagai suatu pengataan bahawa orang itu bukan lagi seorang yang layak dan sesuai sebagaimana yang disebut dalam perenggan 28(l)(b) Akta itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Segala wang atau harta lain yang terkandung,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum sahaja tarikh mula berkuatkuasa, dalam suatu akaun terasing yang ditubuhkan dan disimpan oleh seseorang peniaga di bawah seksyen 53 Akta termansuh, hendaklah, pada tarikh mula berkuatkuasa, disifatkan telah didepositkan di bawah seksyen 52A Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 49 dan 51 Akta ibu tidaklah terpakai bagi seseorang yang, pada tarikh mula berkuatkuasa, disifatkan oleh subseksyen 31(1) Akta ini telah diberi lesen broker niaga hadapan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terhenti mempunyai kuatkuasa enam bulan selepas tarikh mula berkuatkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang telah dilantik sebagai seorang juruaudit"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "oleh Pesuruhjaya di bawah seksyen 59 atau 60 Akta termansuh hendaklah, jika pelantikan itu masih berkuatkuasa pada tarikh mula berkuatkuasa, disifatkan telah dilantik sebagai seorang juruaudit oleh Suruhanjaya Sekuriti di bawah seksyen 40 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu syarikat bursa yang, sebelum sahaja tarikh mula berkuatkuasa, menyenggarakan suatu kumpulan wang pampasan di bawah seksyen 80 Akta termansuh hendaklah, pada tarikh mula berkuatkuasa, menyeng- garakan kumpulan wang itu sebagai suatu tabung kesetiaan di bawah seksyen 58 Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun Bahagian VI Akta ibu jika sesuatu hak untuk membuat tuntutan terhadap kumpulan wang pampasan itu berbangkit sebelum tarikh mula berkuatkuasa, dan tuntutan itu belum dibereskan sebelum tarikh itu, syarikat itu hendaklah, selepas tarikh mula berkuatkuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mendengar dan menentukan tuntutan itu; dan (Pindaan dan Penyatuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan tabung kesetiaannya berkenaan dengan tuntutan itu, mengikut Akta termansuh seolah-olah pindaan yang dibuat oleh Akta ini telah tidak dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu tuntutan dibuat selepas tarikh mula berkuatkuasa berkenaan dengan sesuatu hak untuk membuat tuntutan terhadap kumpulan wang pampasan yang berbangkit sebelum tarikh mula berkuatkuasa, Suruhanjaya Sekuriti—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menggantikan, bagi maksud subseksyen (2), Suruhanjaya Dagangan Komoditi dalam Bahagian IX Akta termansuh; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_IV__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mempunyai segala kuasa yang, jika tidak kerana Akta ini, dipunyai oleh Suruhanjaya Dagangan Komoditi di bawah Bahagian itu berkenaan dengan tuntutan itu, termasuk kuasa untuk mendengar rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perindustrian Niaga Hadapan (Pindaan dan Penyatuan) 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/52/msa@/~chp_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh atau tarikh-tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh-tarikh yang berlainan bagi mula berkuatkuasanya peruntukan-peruntukan yang berlainan dalam Akta ini."
      }
    }
  ]
}
