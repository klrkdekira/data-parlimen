      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Menteri\" dengan takrif yang berikut: ' \"Menteri\" ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi kewangan;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Pendaftar\" dengan takrif yang berikut: ' \"Pendaftar\" ertinya Lembaga Perkhid- matan Kewangan Luar Pesisir Labuan yang ditubuhkan di bawah Akta Lembaga Akta 545 Perkhidmatan Kewangan Luar Pesisir Labuan 1996;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"syer\" takrif yang berikut: ' \"tarikh pembayaran fee tahunan\" ertinya tarikh fee tahunan sesuatu syarikat luar pesisir kena dibayar menurut seksyen 15(6);'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan menggantikan seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "6 dengan seksyen yang berikut: \" 6. Seorang pemastautin Malaysia yang melakukan apa-apa perbuatan yang dibenarkan oleh Akta ini dilakukan oleh pemastautin itu hendaklah dianggap sebagai seorang bukan pemastautin untuk tujuan seksyen 8 Akta Syarikat Amanah Labuan 1990.\"."
      }
    },
