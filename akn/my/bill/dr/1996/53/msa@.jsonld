      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 84(1) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"empat belas hari\" di mana-mana jua terdapat dengan perkataan\"satu bulan\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_12",
