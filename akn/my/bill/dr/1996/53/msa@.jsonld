    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e) dengan menggantikan noktah di akhir perenggan itu dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: \"(f) memeringkatnilaikan semula mata- wang mana-mana syer dengan menukar syer yang diperingkat- nilaikan dalam satu matawang kepada jumlah syer yang sama dalam matawang lain dengan kebenaran bertulis terdahulu daripada pemiutang, jika ada;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) Sesuatu pemeringkatnilaian semula matawang mana-mana syer di bawah subseksyen (1)(f) hendaklah disifatkan tidak melaksanakan pengkenselan syer-syer yang sedia ada dan penerbitan syer-syer baru.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3) dengan menggantikan perkataan \"empat belas hari\" dengan perkataan \"satu bulan\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 55(8) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"empat belas hari\" dengan perkataan \"satu bulan\"."
      }
    }
  ]
