      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"buku\" takrif yang berikut: ' \"bulan\" ertinya suatu tempoh selama tiga puluh hari;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"debentur\" dengan menggantikan perkataan \"syarikat luar pesisir\" dengan perkataan \"perbadanan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
