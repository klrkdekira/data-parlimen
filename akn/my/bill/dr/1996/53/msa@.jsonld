      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 85(2) dan 85(3) Akta ibu adalah dipinda"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"empat belas hari\" dengan perkataan \"satu bulan\". Syarikat Luar Pesisir (Pindaan) 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 86 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Nama sesuatu syarikat luar pesisir atau syarikat luar pesisir asing hendaklah (sama ada atau tidak ia menjalankan perniagaan di bawah suatu nama perniagaan) terdapat dalam huruf rumi yang mudah dibaca dan nombor syarikat bagi syarikat luar pesisir atau syarikat luar pesisir asing itu hendaklah terdapat pada memorandum dan perkara- perkara persatuan dan apa-apa dokumen lain yang ditetapkan dan jika berlaku keingkaran pada mematuhi subseksyen ini, syarikat itu adalah melakukan suatu kesalahan terhadap Akta ini.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b) dengan memotong perkataan \"atau\" pada akhir perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c) dengan menggantikan koma di akhir perenggan itu dengan perkataan \"; atau\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_13__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: \"(d) menandatangani atau membenarkan ditandatangani, bagi pihak syarikat, memorandum dan perkara-perkara persatuan atau apa-apa dokumen lain yang ditetapkan oleh Pendaftar apabila nama dan nombor syarikat bagi syarikat luar pesisir atau syarikat luar pesisir asing itu tidak disebut sedemikian,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 87(2) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas perkataan \"pegawai syarikat amanah\" perkataan \"atau sesuatu syarikat domestik yang dimiliki sepenuhnya oleh syarikat amanah itu\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 93 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) Tertakluk kepada subseksyen (2) dan apa-apa peruntukan yang berlawanan dalam memorandum dan perkara-perkara persatuan sesuatu syarikat luar pesisir, suatu perbadanan boleh menjadi setiausaha sesuatu syarikat luar pesisir dan perbadanan itu boleh bertindak sendiri atau melalui seorang penama yang dilantik secara bertulis dan boleh dilantik atau bertindak sebagai setiausaha bagi lebih daripada satu syarikat.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dengan memasukkan selepas perkataan \"pegawai syarikat amanah\" perkataan \"atau sesuatu syarikat domestik yang dimiliki sepenuhnya oleh syarikat amanah itu\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_a",
