      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 94 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dengan menggantikan perkataan \"atau, dalam hal pengarah yang adalah suatu syarikat, nama penuh syarikat itu,\" perkataan \"dan nama syarikat amanah yang dia adalah seorang pegawainya dan alamat pejabat berdaftarnya, atau dalam hal suatu perbadanan, nama penuh perbadanan itu,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"setiausaha,\" perkataan \"dalam hal seorang individu,\"; dan Syarikat Luar Pesisir (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_16__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"pejabat berdaftar syarikat amanah itu\" perkataan \", atau dalam hal suatu perbadanan, nama penuh perbadanan itu, alamat pejabat berdaftarnya dan nama-nama penama dan wakilnya yang diberikuasa di Labuan.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Bahagian V Penggal 2 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas seksyen 94 seksyen berikut: \" Kesalahan 94A. Jika mana-mana kesalahan terhadap mana- terhadap mana peruntukan Akta ini telah dilakukan oleh mana-mana peruntukan mana-mana syarikat domestik yang disediakan Akta ini oleh suatu syarikat amanah untuk bertindak atau yang dilakukan dilantik sebagai pengarah pemastautin atau oleh setiausaha pemastautin sesuatu syarikat luar pengarah- pengarah pesisir, mana-mana orang yang pada masa dan setiausaha- pelakuan kesalahan itu adalah pengarah atau setiausaha pegawai syarikat amanah itu atau berupa sebagai bertindak atau mana-mana sifat sedemikian, atau telah dengan apa-apa cara atau sehingga apa- apa takat bertanggungjawab tentang pengurusan mana-mana hal-ehwal syarikat amanah itu, atau telah membantu dalam pengurusan sedemikian, adalah melakukan kesalahan itu melainkan jika dia membuktikan bahawa kesalahan itu telah dilakukan tanpa dipersetujui atau dibiarkan olehnya dan bahawa dia telah menjalankan segala usaha untuk mencegah pelakuan kesalahan itu sebagaimana yang patut dijalankan olehnya, dengan memberikan perhatian kepada jenis fungsinya atas sifat itu dan segala hal keadaan.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_18",
      "@type": "akn:clause",
