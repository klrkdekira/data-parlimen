      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"syarikat domestik\" perkataan \"menurut seksyen 147\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_4__para_b__subpara_iii__subpara_B",
