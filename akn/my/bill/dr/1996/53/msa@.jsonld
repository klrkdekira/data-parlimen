      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e) dengan memotong perkataan \"atau\" di akhir perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_4__para_b__subpara_iii",
