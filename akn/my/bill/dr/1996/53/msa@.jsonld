      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 83(1) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"tidak lewat daripada empat belas hari\" dengan perkataan \"dalam masa satu bulan\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
