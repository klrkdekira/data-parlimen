        "@language": "ms",
        "@value": "Subseksyen 106(2) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan \"dua hari\" dan perkataan \"empat belas hari\" masing-masing dengan perkataan \"satu bulan\". 10 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_19",
