        "@language": "ms",
        "@value": "Perenggan 1 2 1 ( 2 )( e) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memotong perkataan \"luar pesisir\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/53/msa@/~cl_1__subsec_1",
