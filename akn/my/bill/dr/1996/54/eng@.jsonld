      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"a guarantee secured, and\" the words \"in the case of an application by an offshore company, a guarantee secured and an undertaking given, and, in the case of an application by a foreign offshore company,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
