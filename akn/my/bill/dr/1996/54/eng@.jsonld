      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1) by substituting for the word \"two\" the word \"four\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
