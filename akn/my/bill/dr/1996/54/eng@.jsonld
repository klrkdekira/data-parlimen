        "@language": "en",
        "@value": "Section 17 of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
