      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 5 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
