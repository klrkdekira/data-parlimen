      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1) by inserting after the words \"offshore banking business\" the words \"or offshore investment banking business\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
