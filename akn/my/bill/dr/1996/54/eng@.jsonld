      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(ee)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
