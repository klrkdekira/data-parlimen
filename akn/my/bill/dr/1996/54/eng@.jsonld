      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (3)(dd)(ii) by substituting for the words \"a guarantee secured, and an undertaking given,\" the words \"an undertaking given\". 6 Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_5",
      "@type": "akn:clause",
