        "@value": "Subsection 26(2) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the words \"Deputy Governor, director 26. and any\" the words \"the Director-General and any member, officer and\"."
      }
    }
  ]
