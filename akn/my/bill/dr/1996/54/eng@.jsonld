      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (ii) by inserting after the word \"Bank\" the words \"and, where the applicant is a foreign offshore company, that it shall promptly notify the Bank of any change in its participants who hold ten per centum or more of its paid-up capital\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/54/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
