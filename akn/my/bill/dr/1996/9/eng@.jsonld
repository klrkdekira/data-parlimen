      ],
      "schema:name": {
        "@language": "en",
        "@value": "Income Tax (Amendment) Bill 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Income Tax (Amendment) Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Income Tax Act 1967, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in subsection 2(1) by inserting after the definition of \"individual\" the following definition: \"Inland Revenue Board of Malaysia\" means the Inland Revenue Board of Malaysia Act 533. established under the Inland Revenue Board of Malaysia Act 1995;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 136 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5) by inserting after the words \"public officer\" the words \"or any employee of the Inland Revenue Board of Malaysia\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (6) by inserting after the words \"public officer\" the words \"or an employee of the Inland Revenue Board of Malaysia\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (8) by inserting after the words \"public officer\" the words \"or an employee of the Inland Revenue Board of Malaysia\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 137(2) of the principal Act is amended by of section inserting after the words \"public officer\" the words \"or 137. an employee of the Inland Revenue Board of Malaysia\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 138(5) of the principal Act is amended in of section the definition of \"classified person\"— 138."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" appearing at the end of paragraph (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting the word \"or\" at the end of paragraph (c); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (c) the following paragraph: \"(d) any employee of the Inland Revenue Board of Malaysia;\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1996/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 144 of the principal Act is amended by inserting of section after the words \"public officer\" the words \"or employee 144. of the Inland Revenue Board of Malaysia\"."
      }
    }
