  "@graph": [
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@",
      "@type": "akn:bill",
      "eli:is_realized_by": {
        "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11"
      },
      "eli:jurisdiction": {
        "@id": "http://publications.europa.eu/resource/authority/country/MYS"
      },
      "eli:language": "en",
      "eli:number": "DR-11-1997",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Telemedicine Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Telemedicine Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Council\" means the Malaysian Medical Council established under section 3 of the Medical Act; \"Director General\" means the Director General of Health, Malaysia; \"fully registered medical practitioner\" means any person who is fully registered under section 14 of the Medical Act; \"Medical Act\" means the Medical Act 1971; \"practising certificate\" means a practising certificate issued under section 20 of the Medical Act; \"provisionally registered\" means provisionally registered under section 12 of the Medical Act; \"registered medical assistant\" means any person who Act 180. is registered under the Medical Assistants (Registration) Act 1977; \"registered midwife\" means any person who is registered Act 436. under the Midwives Act 1966; \"registered nurse\" means any person who is registered Act 14. under the Nurses Act 1950; \"telemedicine\" means the practice of medicine using audio, visual and data communications. Persons who"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "No person other than— may practise telemedicine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a fully registered medical practitioner holding a valid practising certificate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a medical practitioner who is registered or licensed outside Malaysia and— may practise telemedicine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "holds a certificate to practise telemedicine issued by the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "practises telemedicine from outside Malaysia through a fully registered medical practitioner holding a valid practising certificate,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (l)(a), the Director General may, upon an application being made by a fully registered medical practitioner, permit in writing, subject to such terms and conditions as the Director General may specify, a provisionally registered medical practitioner, a registered medical assistant, a registered nurse, a registered midwife or any other person providing healthcare, to practise telemedicine if such person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is deemed suitable by the Director General to be so permitted; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is under the supervision, direction and authority of the fully registered medical practitioner making the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who practises telemedicine in contravention of this section, notwithstanding that he so practises from outside Malaysia, shall be guilty of an offence and shall on conviction be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "An application for a certificate to practise telemedicine referred to in paragraph 3(l)(b) shall be made by a medical practitioner registered or licensed outside Malaysia through a fully registered medical practitioner to the Council in such manner or form and accompanied by such documents, particulars and fees as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may issue to the applicant a certificate to practise telemedicine for a period not exceeding three years subject to such terms and conditions as the Council may specify in such certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may at any time vary the terms and conditions of a certificate to practise telemedicine issued under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may at any time cancel any certificate to practise telemedicine issued under subsection (2) if the person to whom the certificate is issued contravenes any term or condition specified in the certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved by the refusal of the Council to issue a certificate to practise telemedicine or by the cancellation of a certificate to practise telemedicine may appeal to the Minister whose decision shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Before a fully registered medical practitioner practises telemedicine in relation to a patient, the fully registered medical practitioner shall obtain the written consent of the patient."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The consent given by a patient under subsection (1) is not valid for the purpose of that subsection unless the fully registered medical practitioner has, before the consent is given, informed the patient—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that he is free to withdraw his consent at any time without affecting his right to future care or treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "of the potential risks, consequences and benefits of telemedicine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that all existing confidentiality protection apply to any information about the patient obtained or disclosed in the course of the telemedicine interaction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that any image or information communicated or used during or resulting from telemedicine interaction which can be identified as being that of or about the patient will not be disseminated to any researcher or any other person without the consent of the patient."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The consent given by a patient under subsection (1) shall not be valid for the purpose of that subsection unless the consent contains a statement signed by the patient indicating that he understands the information provided pursuant to subsection (2) and that this information has been discussed with the fully registered medical practitioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The written consent under subsection (1) and statement under subsection (3) of a patient shall become part of the patient's medical record."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the patient is a minor, or is under such mental disability as to render him incapable of giving an informed consent, consent may be given on his behalf by his next friend or guardian ad idem."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any fully registered medical practitioner who contravenes this section shall be guilty of an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Telemedicine 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as appear to him to be necessary or expedient for carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the minimum standards in respect of any facility, computer, apparatus, appliance, equipment, instrument, material, article and substance which are to be used in the practice of telemedicine on any premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for acceptable quality assurance and quality control in respect of telemedicine services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require persons practising telemedicine to maintain such books, records and reports as may be necessary for the proper enforcement and administration of this Act and to prescribe the manner in which such books, records and reports are to be kept and issued;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require the furnishing of statistical information to the Director General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide that the contravention of any provision of any regulation made under this Act shall constitute an offence and that persons convicted of such offence shall be liable to a fine or imprisonment or both but such fine shall not exceed five thousand ringgit and such imprisonment shall not exceed one year;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the offences under this Act or the regulations made under this Act which may be compounded and the person by whom and the manner in which such offences may be compounded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any other matter which is required or permitted by this Act to be prescribed."
      }
    }
  ]
}
