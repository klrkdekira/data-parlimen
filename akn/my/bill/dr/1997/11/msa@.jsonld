        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Teleperubatan 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Teleperubatan 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"Akta Perubatan\" ertinya Akta Perubatan 1971; \"berdaftar sementara\" ertinya didaftarkan sementara di bawah seksyen 12 Akta Perubatan; \"bidan berdaftar\" ertinya mana-mana orang yang didaftarkan di bawah Akta Bidan 1966; \"jururawat berdaftar\" ertinya mana-mana orang yang didaftarkan di bawah Akta Jururawat 1950; \"Ketua Pengarah\" ertinya Ketua Pengarah Kesihatan, Malaysia; \"Majlis\" ertinya Majlis Perubatan Malaysia yang ditubuhkan di bawah seksyen 3 Akta Perubatan; \"pembantu perubatan berdaftar\" ertinya mana-mana orang yang didaftarkan di bawah Akta Pembantu Perubatan (Pendaftaran) 1977; \"pengamal perubatan berdaftar penuh\" ertinya mana- mana orang yang didaftarkan penuh di bawah seksyen 14 Akta Perubatan; \"perakuan amalan\" ertinya perakuan amalan yang dikeluarkan di bawah seksyen 20 Akta Perubatan; \"teleperubatan\" ertinya amalan perubatan dengan menggunakan komunikasi audio, visual dan data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun, selain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengamal perubatan berdaftar penuh yang memegang suatu perakuan amalan yang sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengamal perubatan yang didaftarkan atau dilesenkan di luar Malaysia dan— (i) memegang perakuan untuk mengamalkan teleperubatan yang dikeluarkan oleh Majlis; dan (ii) mengamalkan teleperubatan dari luar Malaysia melalui seorang pengamal perubatan berdaftar penuh yang memegang perakuan amalan yang sah, boleh mengamalkan teleperubatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (l)(a), Ketua Pengarah boleh, apabila permohonan dibuat oleh seseorang pengamal perubatan berdaftar penuh, membenarkan secara bertulis, tertakluk kepada apa-apa terma dan syarat yang ditentukan oleh Ketua Pengarah, seseorang pengamal perubatan berdaftar sementara, pembantu perubatan berdaftar, jururawat berdaftar, bidan berdaftar atau mana-mana orang lain yang memberikan jagaan kesihatan, mengamalkan teleperubatan jika orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "difikirkan sesuai oleh Ketua Pengarah untuk dibenarkan sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berada di bawah pengawasan, arahan dan kuasa pengamal perubatan berdaftar penuh yang membuat permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengamalkan teleperubatan dengan melanggar seksyen ini, walaupun dia mengamalkan teleperubatan dari luar Malaysia, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu permohonan untuk mendapatkan perakuan untuk mengamalkan teleperubatan yang disebut dalam perenggan 3(l)(b) hendaklah dibuat oleh seseorang pengamal perubatan yang didaftarkan atau dilesenkan di luar Malaysia melalui seorang pengamal perubatan berdaftar penuh kepada Majlis mengikut cara atau dalam borang dan disertakan dengan apa-apa dokumen, butir dan fee yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh mengeluarkan suatu perakuan untuk mengamalkan teleperubatan kepada pemohon bagi suatu tempoh yang tidak melebihi tiga tahun tertakluk kepada apa-apa terma dan syarat yang ditentukan oleh Majlis dalam perakuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh pada bila-bila masa mengubah terma dan syarat sesuatu perakuan untuk mengamalkan teleperubatan yang dikeluarkan di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh pada bila-bila masa membatalkan apa- apa perakuan untuk mengamalkan teleperubatan yang dikeluarkan di bawah subseksyen (2) jika orang yang kepadanya perakuan itu dikeluarkan melanggar mana- mana terma atau syarat yang dinyatakan dalam perakuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keengganan Majlis untuk mengeluarkan suatu perakuan untuk mengamalkan teleperubatan atau dengan pembatalan sesuatu perakuan untuk mengamalkan teleperubatan boleh merayu kepada Menteri dan keputusan Menteri adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum seseorang pengamal perubatan berdaftar penuh mengamalkan teleperubatan berhubungan dengan seseorang pesakit, pengamal perubatan berdaftar penuh itu hendaklah mendapatkan persetujuan bertulis pesakit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Persetujuan yang diberikan oleh seseorang pesakit di bawah subseksyen (1) tidaklah sah bagi maksud subseksyen itu melainkan jika pengamal perubatan berdaftar penuh itu sudah, sebelum persetujuan itu diberikan, memaklumkan pesakit itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia bebas menarik balik persetujuannya pada bila-bila masa tanpa menyentuh haknya untuk mendapat jagaan atau rawatan pada masa hadapan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tentang risiko, akibat dan faedah yang mungkin diperoleh daripada teleperubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa segala perlindungan kerahsiaan sedia ada adalah terpakai bagi apa-apa maklumat tentang pesakit itu yang diperoleh atau didedahkan dalam masa interaksi teleperubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa apa-apa imej atau maklumat yang disampaikan atau digunakan semasa atau yang terhasil daripada interaksi teleperubatan yang dapat dikenal pasti sebagai imej atau maklumat pesakit itu atau tentang pesakit itu tidak akan Teleperubatan 7 disebarkan kepada mana-mana penyelidik atau mana-mana orang lain tanpa persetujuan pesakit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Persetujuan yang diberikan oleh seseorang pesakit di bawah subseksyen (1) tidaklah sah bagi maksud subseksyen itu melainkan jika persetujuan itu mengandungi pernyataan yang ditandatangani oleh pesakit itu yang menunjukkan bahawa dia memahami maklumat yang diberikan menurut subseksyen (2) dan bahawa maklumat ini telah dibincangkan dengan pengamal perubatan berdaftar penuh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Persetujuan bertulis di bawah subseksyen (1) dan pernyataan di bawah subseksyen (3) seseorang pesakit hendaklah menjadi sebahagian daripada rekod perubatan pesakit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pesakit itu belum dewasa, atau mengalami ketakupayaan mental yang sedemikian rupa sehingga menyebabkannya tidak berupaya untuk memberikan persetujuan berpengetahuan, maka persetujuan boleh diberikan bagi pihaknya oleh sahabat wakilnya atau penjaga ad idem-nya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengamal perubatan berdaftar penuh yang melanggar seksyen ini adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan yang didapatinya perlu atau suaimanfaat bagi melaksanakan peruntukan-peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan standard minimum berkenaan dengan apa-apa kemudahan, komputer, perkakas, alat, kelengkapan, peralatan, bahan, artikel dan benda yang akan digunakan dalam amalan teleperubatan di mana-mana premis; Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi jaminan mutu dan kawalan mutu boleh terima berkenaan dengan perkhidmatan teleperubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki orang-orang yang mengamalkan teleperubatan supaya menyenggara buku, rekod dan laporan sebagaimana yang perlu bagi penguatkuasaan dan pentadbiran yang sepatutnya Akta ini dan untuk menetapkan cara bagaimana buku, rekod dan laporan itu hendaklah disimpan dan dikeluarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki pemberian maklumat perangkaan kepada Ketua Pengarah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi memperuntukkan bahawa pelanggaran mana-mana peruntukan mana-mana peraturan yang dibuat di bawah Akta ini hendaklah menjadi suatu kesalahan dan bahawa orang-orang yang disabitkan atas kesalahan itu boleh didenda atau dipenjarakan atau kedua-duanya tetapi denda itu tidaklah boleh melebihi lima ribu ringgit dan pemenjaraan itu tidaklah boleh melebihi satu tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kesalahan di bawah Akta ini atau peraturan-peraturan yang dibuat di bawah Akta ini yang boleh dikompaunkan dan orang yang boleh mengkompaunkan kesalahan itu dan cara bagaimana kesalahan itu boleh dikompaunkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan apa-apa perkara lain yang dikehendaki oleh Akta ini supaya ditetapkan atau dibenarkan oleh Akta ini untuk ditetapkan."
      }
    }
  ]
}
