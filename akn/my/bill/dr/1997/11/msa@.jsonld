      },
      "eli:language": "ms",
      "eli:number": "DR-11-1997",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/11/msa@/~cl_2",
