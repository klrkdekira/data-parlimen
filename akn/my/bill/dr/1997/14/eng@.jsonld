      ],
      "schema:name": {
        "@language": "en",
        "@value": "Promotion of Investments (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29B of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "inserting after subsection (2) the following subsection: \"(2A) Notwithstanding subsection (2), the expenditure incurred prior to the grant of approval on the basis of an application made under the proviso to section 26A(1) shall not be deemed as having been incurred in the basis period the approval is to take effect whether or not the assets acquired by that expenditure are subsequently owned by the same company or a new entity.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29o of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1) by inserting after the word \"technologies\" the words \"or in respect of a promoted activity or a promoted product in an industrial. linkage programme\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2) by inserting after the word \"technologies\" in the proviso to that subsection the words \"or in respect of a promoted activity or a promoted product in an industrial linkage programme\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 4lB(l) of the principal Act is amended"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (a) of the proviso to that subsection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Promotion of Investments (Amendment) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be deemed to have come into force on 25 October 1996 and shall have effect for the year of assessment 1997 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Promotion of Investments Act 1986, which in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act is referred to as the \"principal Act\", is amended in subsection 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"in-house research\" the following definition: ' \"industrial linkage programme\" means an integrated programme undertaken by a Ministry or government agency in which a small company or medium company which is a manufacturer and supplier is linked to a larger company or to another small company or medium company through the manufacture and supply of parts and components or through technology or research and development;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"related company\" the following definition: ' \"related company\", in relation to a company, means a company—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the operations of which are or can be controlled, either directly or indirectly, by the first-mentioned company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "which controls or can control, either directly or indirectly, the operations of the first-mentioned company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the operations of which are or can be controlled, either directly or indirectly, by a person or persons who control or can control, either directly or indirectly, the operations of the first-mentioned company: Provided that a company shall be deemed to be a related company of another company if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "at least twenty per cent of its issued share capital is beneficially owned, either directly or indirectly, by that other company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "at least twenty per cent of the issued share capital of that other company is beneficially owned, either directly or indirectly, by the first-mentioned company;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"promoted activity\" by substituting for the words \"or 4B\" the words \", 4B or 5(1A)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"promoted product\" by substituting for the words \"or 4B\" the words \", 4B or 5(lA)\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"small scale company\" by substituting for the words ' \"small scale company\" ' the words \"small company\" or \"medium company\".'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 5 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1A)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word \"product\" first appearing in that subsection the words \"which is of national and strategic importance to Malaysia\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of that subsection a colon and by inserting thereafter the following proviso: \"Provided that a company which is already operating in Malaysia may, if it fulfills such conditions as may be determined by the Minister, make an application in writing to the Minister for pioneer status.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (lD)(a) by inserting after the word \"technologies\" the words \", or any company participating in a promoted activity or producing a promoted product in an industrial linkage programme,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 6(1 A) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "deleting the word \"scale\" wherever appearing in that subsection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 21c of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (2)(b) a colon and by inserting thereafter the following proviso to subsection (2): \"Provided that in the case of a company that is already operating in Malaysia, the income of the company for each accounting period of its pioneer business shall be the value-added income of the company.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: \"(2A) For the purpose of this section— (a) \"value-added income\" means the statutory income for the basis period for the year of assessment less the inflation-adjusted base income; and (b) \"inflation-adjusted base income\" shall be determined in accordance with the formula— (i) for the first year, from the production day: A (1+B) where: A is the average statutory income for up to three years prior to the production day; and B is the rate of inflation for the basis year; (ii) for the second year, from the production day onwards: C (1+B) where: C is the inflation-adjusted income for the preceding year; and B is the rate of inflation for the basis year.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2lF of the principal Act is amended—"
      }
    },
    {
