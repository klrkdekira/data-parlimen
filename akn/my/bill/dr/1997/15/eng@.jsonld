      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a) by inserting after the word \"whatsoever,\" the words \"without identifying the author or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_8__para_a__subpara_ii",
