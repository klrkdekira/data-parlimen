      ],
      "schema:name": {
        "@language": "en",
        "@value": "Copyright (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Copyright (Amendment)"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act 1997 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 41(1) of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "41."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (f) by deleting the word \"or\" at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the comma at the end of paragraph (g) a semicolon and inserting thereafter the following paragraphs: \"( h) circumvents or causes the circumvention of any effective technological measures referred to in subsection (3) of section 36; (i) removes or alters any electronic rights management information without authority; or (j) distributes, imports for distribution or communicates to the public, without authority, works or copies of works in respect of which electronic rights management information has been removed or altered without authority,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (i) by deleting the word \"and\" at the end of the paragraph; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (ii) by substituting for the full stop at the end of the paragraph a semicolon and inserting thereafter the following paragraph: \"(iii) in the case of an offence under paragraphs (h), (i) and (j), to a fine not exceeding two hundred and fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both and for any subsequent offence, to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 58(2) of the principal Act is amended— Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a) by substituting for the words \"broadcast, communicate by cable\" the words \"communicate to the public\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b) by substituting for the words \"broadcast or communicate them by cable\" the words \"communicate them to the public\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "59A the following section: Power of 59e. (1) The Minister may, by order, exclude Minister from the definition of \"broadcast\" in relation to exclude from to a transmission by wire any of the following defini- services: tion of \"broad-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "an interactive service; cast\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "an internal business service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "an individual domestic service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "a service on single-occupier premises otherwise than by way of business amenity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "a service run for persons providing broadcasting services through means of wire or providing programmes for such services."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order, amend subsection (1) so as to add to or remove from the exclusion referred to in that subsection.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Copyright Act 1987, which in this Act is referred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to as the \"principal Act\", is amended in section 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"author\" by substituting for paragraph (f) the following paragraph: \"(/) in relation to broadcasts transmitted from within any country, means— (i) the person transmitting programme, if responsibility for the selection of its contents; or (ii) any person providing programme who makes with the person transmitting arrangements necessary for its transmission;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"broadcast\" the following definition: ' \"broadcast\" means a transmission, by wire or wireless means, of visual images, sounds or other information which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "is capable of being lawfully received by members of the public; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "is transmitted for presentation to members of the public, and includes the transmission of encrypted signals where the means for decrypting are provided to the public by the broadcasting service or with its consent;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"communication by cable\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"citizen\" the following definition: ' \"communication to the public\" means the transmission of a work through wire or wireless means to the public, including the making available of a work to the public in such a way that members of the public may access the work from a place and at a time individually chosen by them;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"fixation\" by inserting after the words \"or both\" the words \", or the representation thereof,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"literary work\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (g) by substituting for the words \"expressed in words, figures, or symbols (whether or not in a visible form)\" the words \"whether or not expressed in words, figures or symbols and whether or not in a visible form\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_2__list_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (h) by deleting the words \"or compilations of computer programs\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 7 of the principal Act is amended by inserting of section 7. after subsection (2) the following subsection: \"(2A) Copyright protection shall not extend to any idea, procedure, method of operation or mathematical concept as such.\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
