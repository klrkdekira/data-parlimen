        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 13 of the principal Act is amended— of section 13."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/eng@/~cl_4__para_a__subpara_i",
