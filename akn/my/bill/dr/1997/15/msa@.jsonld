      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), (2) dan (3) dengan memotong perkataan \"(selain daripada fotograf)\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/msa@/~cl_7",
      "@type": "akn:clause",
