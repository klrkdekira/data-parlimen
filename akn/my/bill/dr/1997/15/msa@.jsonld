      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (o) dengan koma bertitik dan perkataan \"dan\" dan memasukkan selepas itu perenggan yang berikut: \"(p) penyewaan secara komersial akan program komputer, jika program itu bukanlah matlamat penting penyewaan itu.\"."
      }
    },
