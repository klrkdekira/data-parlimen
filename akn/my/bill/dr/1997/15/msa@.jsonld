      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen ( 2 )-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/msa@/~cl_8__para_a__subpara_i",
