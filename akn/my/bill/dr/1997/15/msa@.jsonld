      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai dengan memotong perkataan \"(selain daripada fotograf)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/15/msa@/~cl_6__para_b",
