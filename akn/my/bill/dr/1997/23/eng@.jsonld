        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_8"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Joint Service (Islamic Affairs Officers) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Joint Service (Islamic Affairs Officers) Act 1997 and shall come into force on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply only to the Federal Territories of Kuala Lumpur and Labuan and the States of Malacca, Negeri Sembilan, Penang and Selangor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), where any other State has made a request to the Federal Government that the application of this Act be extended thereto, the Yang di-Pertuan Agong may by order published in the Gazette extend the application of this Act to such State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Commission\" means the Public Services Commission established under Article 139 of the Federal Constitution; \"joint service\" means the Joint Service for Islamic Affairs Officers established under section 3; \"officer\" means an officer of the joint service; \"remuneration\" has the meaning assigned thereto by Clause (2) of Article 160 of the Federal Constitution; \"State\" includes the Federal Territories of Kuala Lumpur and Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be established a joint service for Islamic Affairs Officers common to the Federation and the States to be known as the Joint Service for Islamic Affairs Officers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The joint service shall comprise—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all officers, other than the Mufti, whether in the general public service of the Federation or in the public service of a State, who are employed under the Skim Perkhidmatan Pegawai Hal- Ehwal Islam under the New Remuneration System and who have opted into the joint service under section 7; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all officers appointed by the Commission into the joint service after the coming into force of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The power to appoint, confirm, emplace on the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "permanent or pensionable establishment, promote, transfer and exercise disciplinary control over an officer shall be vested in the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "An officer is liable to be posted to an office of the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Federation or a State or to be transferred—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "from an office of one State to an office of another State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "from an office of a State to an office of the Federation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "from an office of the Federation to an office of a State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), an officer posted or transferred under section 5 shall remain a member of the joint service, but his remuneration shall be paid by the Federation or the State, as the case may be, to whose office he is posted or transferred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where an officer is employed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "partly for federal purposes and partly for State purposes; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the purposes of two or more States, the proportion, if any, of his remuneration payable by the Federation and the State or States concerned or, as the case may be, by each of the States concerned, shall be determined by agreement or, in default of agreement, by the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Federal Government shall, on the date this Act comes into force, accept into the joint service every person who immediately before that date is an officer, either in the general public service of the Federation or in the public service of a State, who is employed under the Skim Perkhidmatan Pegawai Hal-Ehwal Islam under the New Remuneration System and who was given an option by the Federal Government and has opted to be in the joint service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who opts under subsection (1) shall be employed in the joint service on terms and conditions of service not less favourable than the terms and conditions of service to which he was entitled immediately before the date mentioned in that subsection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong may make such regulations as may be expedient or necessary for the better carrying out of the provisions of this Act."
      }
    }
  ]
}
