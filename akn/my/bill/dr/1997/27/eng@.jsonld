        "@value": "Supplementary Supply (1997) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1997) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding two hundred and forty-six million one hundred and ninety- five thousand eight hundred ringgit (RM246,195,800) from the Consolidated Fund for expenditure on the services specified in the Schedule for the service of the year 1997, not provided for or not fully provided for by the Supply Act 1997 and the Supplementary Supply (1996 and 1997) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 2) Purpose Title B. 14 Ministry of Housing and Local Government B. 22 Ministry of Culture, Arts and Tourism B. 30 Contribution to Statutory Funds B. 32 Inland Revenue Department B. 42 Ministry of National Unity and Social Development B. 47 Ministry of Transport 167,102,000 TOTAL 246,195,800"
      }
    }
