      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (1997) 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Tambahan (1997) 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan sejumlah wang yang tidak melebihi dua ratus empat puluh enam juta satu ratus sembilan puluh lima ribu lapan ratus ringgit (RM246,195,800) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan yang dinyatakan dalam Jadual bagi perkhidmatan tahun 1997, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1997 dan Akta Perbekalan Tambahan (1996 dan 1997) 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah wang yang tersebut itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 2) Maksud Tajuk Peruntukan kepada Maksud (RM) B. 14 Kementerian Perumahan dan 3,525,000 Kerajaan Tempatan B. 22 Kementerian Kebudayaan, 10,568,800 Kesenian dan Pelancongan B. 30 Peruntukan kepada Kumpulan 30,000,000 Wang Terkanun B. 32 Jabatan Hasil Dalam Negeri 30,000,000 B. 42 Kementerian Perpaduan Negara 5,000,000 dan Pembangunan Masyarakat B. 47 Kementerian Pengangkutan 167,102,000 JUMLAH 246,195,800"
      }
    }
  ]
