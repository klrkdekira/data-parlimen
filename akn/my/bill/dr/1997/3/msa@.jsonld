      "schema:text": {
        "@language": "ms",
        "@value": "PERMULAAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana didapati oleh seseorang Majistret daripada maklumat dan selepas apa-apa siasatan yang difikirkannya perlu bahawa ada sebab yang munasabah untuk mempercayai bahawa dalam mana-mana premis ada apa-apa keterangan mengenai pelakuan suatu kesalahan di bawah Akta ini, dia boleh, dengan waran yang diarahkan kepada mana-mana pegawai polis yang berpangkat Inspektor atau lebih tinggi, memberi pegawai itu kuasa untuk memasuki premis itu, dengan kekerasan jika perlu, dan di situ menggeledah, menyita dan menahan apa-apa keterangan sedemikian dan dia hendaklah berhak untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendapat capaian kepada mana-mana atur cara atau data yang disimpan dalam mana-mana Jenayah Komputer komputer, atau mendapat capaian kepada, memeriksa atau menyemak pengendalian, mana- mana komputer dan apa-apa radas atau bahan yang berkaitan yang dia mempunyai sebab yang munasabah untuk mengesyaki digunakan atau telah digunakan berkaitan dengan apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki— digunakan; atau untuk memberikannya bantuan yang munasabah sebagaimana yang dikehendaki bagi maksud perenggan (a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang olehnya atau yang bagi pihaknya pegawai polis itu mempunyai sebab yang munasabah untuk mengesyaki komputer itu digunakan atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mempunyai tanggungjawab bagi atau sebaliknya berurusan dengan pengendalian komputer, radas atau bahan itu,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki apa-apa maklumat yang terkandung dalam suatu komputer dan boleh didapati dari premis itu dikeluarkan dalam suatu bentuk yang boleh dibawa pergi dan yang boleh dilihat dan dibaca."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana didapati oleh mana-mana pegawai polis yang berpangkat Inspektor atau lebih tinggi bahawa ada sebab yang munasabah untuk mempercayai bahawa dalam mana-mana premis ada disembunyikan atau diletakkan apa-apa keterangan mengenai pelakuan suatu kesalahan di bawah Akta ini, dan pegawai polis itu ada alasan yang munasabah bagi mempercayai bahawa dengan sebab kelewatan dalam mendapatkan waran geledah tujuan penggeledahan itu mungkin gagal, dia boleh menjalankan dalam dan berkenaan dengan premis itu semua kuasa yang disebut dalam subseksyen (1) dengan sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh waran yang dikeluarkan di bawah subseksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai polis boleh menangkap tanpa waran mana-mana orang yang dia secara munasabahnya percaya telah melakukan atau akan melakukan suatu kesalahan terhadap Akta ini, dan tiap-tiap kesalahan terhadap Akta ini hendaklah disifatkan sebagai kesalahan boleh tangkap bagi maksud undang-undang yang sedang berkuatkuasa berhubungan dengan prosedur jenayah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang adalah melakukan suatu kesalahan jika dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyerang, menghalang, merintangi atau melengahkan mana-mana pegawai polis masuk ke dalam mana-mana premis di bawah Akta ini atau pada melaksanakan apa-apa tugas yang dipertanggungjawab atau apa-apa kuasa yang diberi oleh Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mematuhi apa-apa permintaan sah daripada seseorang pegawai polis yang bertindak pada melaksanakan tugasnya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan kesalahan di bawah seksyen ini hendaklah apabila disabitkan boleh didenda tidak melebihi dua puluh lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pendakwaan di bawah Akta ini tidak boleh dimulakan kecuali oleh atau dengan keizinan Pendakwa Raya secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Jenayah Komputer 1997. ringkas dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Perdana Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya Tafsiran. menghendaki makna yang lain— \"atur cara\" ertinya data yang merupakan suruhan atau penyataan, apabila dilakukan dalam suatu komputer, menyebabkan komputer itu melaksanakan suatu fungsi; \"data\" ertinya representasi maklumat atau konsep yang disediakan atau telah disediakan dalam bentuk yang sesuai bagi kegunaan dalam suatu komputer; \"fungsi\" termasuklah logik, kawalan, aritmetik, hapusan, storan dan dapatan semula dan komunikasi atau telekomunikasi kepada, daripada atau dalam sesuatu komputer; \"komputer\" ertinya suatu peranti elektronik, magnet, optik, elektrokimia, atau peranti pemprosesan data yang lain, atau sekumpulan peranti tersaling sambung atau yang berkaitan, yang melaksanakan fungsi logik, aritmetik, storan dan paparan, dan termasuklah apa-apa kemudahan storan data atau kemudahan komunikasi yang berkaitan secara langsung dengan atau dikendali bersama dengan suatu peranti atau sekumpulan peranti tersaling sambung atau yang berkaitan, tetapi tidak termasuk suatu mesin taip atau mesin pengatur huruf berautomat, atau suatu mesin hitung pegang-tangan mudah alih atau peranti seumpama yang lain yang tak boleh diatur cara atau yang tidak mengandungi apa-apa kemudahan storan data; \"output komputer\" atau \"output\" ertinya suatu penyataan atau representasi sama ada berbentuk tulisan, tercetak, bergambar, filem, grafik, akustik atau bentuk lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rujukan dalam Akta ini kepada suatu komputer termasuklah rujukan kepada suatu rangkaian komputer. Jenayah Komputer BAHAGIAN II KESALAHAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dihasilkan oleh suatu komputer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dipapar di skrin suatu komputer; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "diterjemah dengan tepat daripada suatu penyataan atau representasi yang dihasilkan itu; \"premis\" termasuklah tanah, bangunan, binaan boleh alih dan apa-apa pengangkutan melalui jalan darat, air dan udara; \"rangkaian komputer\" ertinya saling sambungan talian komunikasi dan litar dengan suatu komputer atau suatu kompleks terdiri daripada dua atau lebih komputer tersaling sambung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, seseorang mendapat capaian kepada mana-mana atur cara atau data yang disimpan dalam komputer jika, dengan menyebabkan komputer itu melaksanakan apa-apa fungsi, dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau memadamkan atur cara atau data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyalin atau mengalihnya ke mana-mana bahantara storan selain dari di mana ia disimpan atau ke tempat lain dalam bahantara storan di mana ia disimpan; Jenayah Komputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan ia dioutput daripada komputer di mana ia disimpan sama ada dengan mengakibatkan ia dipaparkan atau mengikut apa- apa cara lain, dan rujukan kepada capaian kepada suatu atur cara atau data dan kepada suatu niat untuk mendapat capaian sedemikian hendaklah ditafsirkan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (2)(c), seseorang mengguna sesuatu atur cara jika fungsi yang disebabkannya komputer itu melaksanakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan atur cara itu dilakukan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ia sendirinya adalah fungsi sesuatu atur cara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (2)(d), bentuk apa-apa atur cara atau data dioutput dan khususnya sama ada ia merupakan suatu bentuk yang dalam hal suatu atur cara, boleh dilaksanakan atau dalam hal data, boleh diproses oleh komputer atau tidak adalah tak material."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, capaian dalam apa-apa bentuk oleh mana-mana orang kepada apa-apa atur cara atau data yang disimpan dalam komputer adalah tanpa kuasa jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia sendirinya tidak berhak untuk mengawal capaian dalam bentuk yang berkenaan kepada atur cara atau data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mempunyai keizinan atau melebihi apa-apa hak atau kebenaran untuk mencapai olehnya dalam bentuk yang berkenaan kepada atur cara atau data itu daripada mana-mana orang yang berhak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rujukan dalam Akta ini kepada apa-apa atur cara atau data yang disimpan dalam komputer termasuk rujukan kepada apa-apa atur cara atau data yang disimpan dalam mana-mana bahantara storan yang boleh tanggal yang sedang berada dalam komputer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu pengubahsuaian kandungan mana-mana komputer berlaku jika, dengan pengendalian apa-apa fungsi komputer yang berkenaan atau mana-mana komputer yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa atur cara atau data yang disimpan dalam komputer berkenaan diubah atau dipadamkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa atur cara atau data dimasukkan atau ditambahkan kepada kandungannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kejadian yang berlaku yang mencacatkan pengendalian normal mana-mana komputer, dan apa-apa perbuatan yang menyumbang kepada berlakunya suatu pengubahsuaian hendaklah disifatkan sebagai melakukannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pengubahsuaian yang disebut dalam subseksyen (7) adalah tanpa kuasa jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang perbuatannya menyebabkan begitu dengan sendirinya tidak berhak untuk menentukan sama ada pengubahsuaian itu patut dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mendapat keizinan ke atas pengubahsuaian itu daripada mana-mana orang yang berhak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rujukan dalam Akta ini kepada suatu atur cara termasuklah rujukan kepada sebahagian daripada suatu atur cara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang adalah melakukan suatu kesalahan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menyebabkan suatu komputer melaksanakan apa-apa fungsi dengan niat untuk mendapat capaian kepada mana-mana atur cara atau data yang disimpan dalam mana-mana komputer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "capaian yang dia berniat untuk didapati adalah tanpa kuasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tahu semasa dia menyebabkan komputer itu melaksanakan fungsi itu, demikian berlakunya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Niat seseorang itu untuk melakukan suatu kesalahan di bawah seksyen ini tidak perlu ditujukan kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana atur cara atau data yang tertentu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bentuk atur cara atau data yang tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu atur cara atau data yang disimpan dalam mana-mana komputer yang tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah seksyen ini hendaklah apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang adalah melakukan suatu kesalahan di bawah seksyen ini jika dia melakukan suatu kesalahan yang disebut dalam seksyen 3 dengan niat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan suatu kesalahan yang melibatkan fraud atau kecurangan atau yang menyebabkan kecederaan sebagaimana yang ditakrifkan dalam Kanun Keseksaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memudahkan berlakunya suatu kesalahan itu sama ada olehnya sendiri atau oleh mana- mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, adalah tak material sama ada kesalahan yang seksyen ini terpakai dilakukan pada masa yang sama apabila capaian tanpa kuasa itu didapati atau pada bila-bila masa hadapan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah seksyen ini hendaklah apabila disabitkan boleh didenda tidak melebihi satu ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang adalah melakukan suatu kesalahan jika dia melakukan apa-apa perbuatan yang dia tahu akan menyebabkan pengubahsuaian tanpa kuasa akan kandungan mana-mana komputer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, adalah tak material bahawa perbuatan berkenaan tidak kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana atur cara atau data yang tertentu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bentuk atur cara atau data; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu atur cara atau data yang disimpan dalam mana-mana komputer yang tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, adalah tak material sama ada suatu pengubahsuaian tanpa kuasa berlaku, atau yang dikehendaki berlaku, kekal atau hanya sementara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah seksyen ini hendaklah apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya; atau boleh didenda tidak melebihi satu ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-keduanya, jika perbuatan itu dilakukan dengan niat menyebabkan kecederaan sebagaimana yang ditakrifkan dalam Kanun Keseksaan. Jenayah Komputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang adalah melakukan suatu kesalahan jika dia berkomunikasi secara langsung atau tak langsung suatu nombor, kod, kata laluan atau cara capaian yang lain kepada suatu komputer kepada mana-mana orang selain daripada orang yang kepadanya dia diberikuasa dengan sempurnanya untuk berkomunikasi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan kesalahan di bawah seksyen ini hendaklah apabila disabitkan boleh didenda tidak melebihi dua puluh lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bersubahat dalam pelakuan atau cuba untuk melakukan mana-mana kesalahan di bawah Akta ini adalah melakukan kesalahan itu dan hendaklah apabila disabitkan boleh dikenakan hukuman yang diperuntukkan bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan apa-apa perbuatan persediaan kepada atau bagi mencapai pelakuan mana- mana kesalahan di bawah Akta ini adalah melakukan kesalahan itu dan hendaklah apabila disabitkan boleh dikenakan hukuman yang diperuntukkan bagi kesalahan itu: Dengan syarat bahawa apa-apa tempoh pemenjaraan yang dikenakan hendaklah tidak melebihi satu perdua tempoh maksimum yang diperuntukkan bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang ada dalam jagaan atau kawalannya . apa-apa atur cara, data atau maklumat lain yang disimpan dalam mana-mana komputer atau didapatkan semula daripada mana-mana komputer yang berkenaan dengannya dia tidak berkuasa untuk ada dalam jagaan atau kawalannya, hendaklah disifatkan telah memperoleh capaian tanpa kuasa kepada atur cara, data atau maklumat itu melainkan jika dibuktikan sebaliknya. BAHAGIAN III PERUNTUKAN SAMPINGAN DAN AM"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini hendaklah, berhubung dengan mana-mana orang, walau apa pun kerakyatan atau kewarganegaraannya, mempunyai kuatkuasa di luar dan juga di dalam Malaysia, dan jika suatu kesalahan di bawah Akta ini dilakukan oleh mana-mana orang di mana-mana tempat di luar Malaysia, dia boleh diuruskan berkenaan dengan kesalahan sedemikian seolah-olah kesalahan itu telah dilakukan di mana-mana tempat dalam Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), Akta ini hendaklah terpakai jika, bagi kesalahan yang dipersoalkan, komputer, program atau data itu berada di Malaysia atau yang boleh disambung kepada atau dihantar kepada atau digunakan oleh atau dengan suatu komputer di Malaysia pada masa yang material itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/3/msa@/~part_I__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pembicaraan terhadap mana-mana orang di bawah seksyen ini yang akan menghalang pembicaraan yang kemudian terhadap seseorang itu bagi kesalahan yang sama jika kesalahan itu telah dilakukan dalam Malaysia adalah menghalang pembicaraan selanjutnya terhadapnya di bawah mana-mana undang-undang bertulis berkenaan dengan serah-balik orang, berkenaan dengan kesalahan yang sama di luar Malaysia."
      }
    }
  ]
}
