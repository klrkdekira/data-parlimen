      ],
      "schema:name": {
        "@language": "en",
        "@value": "Companies (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": ", This Act may be cited as the Companies (Amendment) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall corne into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Companies Act 1965 is amended by inserting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "after section 67 the following section: Purchase 67A. (1) Notwithstanding the provisions of by a section 67, a public company with a share capital company of its may, if so authorised by its articles, purchase own its own shares or give financial assistance to shares, etc. any person for the purpose of purchasing its shares."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A company shall not purchase its own shares, or give financial assistance to a person for purchasing its shares under this section, unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is solvent at the date of the purchase or the giving of financial assistance; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the purchase is made through the Stock Exchange on which the shares of the company are quoted; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the purchase or the giving of financial assistance is made in good faith and in the interests of the company."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Where the company purchases its own shares the company's issued capital shall be diminished by the cancellation of the shares so purchased and the amount by which the company's issued capital is diminished shall be transferred to the capital redemption reserve."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The capital redemption reserve may be applied in paying up unissued shares of the company to be issued to members of the company as fully paid bonus shares."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A cancellation of shares made pursuant to subsection (3) shall not be deemed to be a reduction of share capital within the meaning of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A company shall, within fourteen days after the shares are purchased, lodge with the Registrar and the Stock Exchange a notice in the prescribed form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/34/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "If default is made in complying with this section, the company, every officer of the company and any other person or individual who is in default shall be guilty of an offence against this Act. Penalty: Imprisonment for five years or one hundred thousand ringgit or both.\"."
      }
    }
  ]
}
