      "schema:name": {
        "@language": "en",
        "@value": "Bernama (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Bernama (Amendment) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Bernama Act 1967 is amended in section 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: \"(3) Bernama may at its discretion arrange at an appropriate time for the reception through subscription, payment, exchange or other means of international, regional and other news or news material and the distribution of such news or news material to subscribers on such terms as may be arranged.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (4) and (5)."
      }
    }
