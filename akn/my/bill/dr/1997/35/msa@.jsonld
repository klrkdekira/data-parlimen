        "@value": "Rang Undang-Undang Bernama (Pindaan) 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bernama (Pindaan)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/35/msa@/~cl_2",
