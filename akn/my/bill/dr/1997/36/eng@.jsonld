        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorised of a sum not exceeding thirteen billion one hundred and forty-one million two hundred and nineteen thousand and five hundred and sixteen ringgit (RM13,141,219,516) from the Consolidated Fund for expenditure on the services specified in the Schedule for the service of the year 1997, not provided for or not fully provided for by the Supply Act 1997, the Supplementary Supply (1996 and 1997) Act 1997 and the Supplementary Supply (1997) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 2) Purpose Title Appropriation to Purpose B. 1 Parliament 12,848,500 B. 3 Audit Department B. 7 Prime Minister's Department 62,382,500 B. 11 Anti-Corruption Agency B. 16 Fire Services Department B. 18 Ministry of Primary Industries 15,900,000 B. 19 Ministry of Agriculture 43,426,100 B. 22 Ministry of Culture, Arts and 49,000,000 Tourism B. 25 Ministry of Defence 80,000,000 B. 26 Ministry of Education 33,390,000 B. 28 Treasury 10,000,000 B. 29 Treasury General Services 66,377,000 B. 30 Contribution to Statutory Funds 12,370,000,000 B. 31 Royal Customs and Excise 10,749,200 Department B. 32 Inland Revenue Department 200,000,000 B. 34 Ministry of Health B. 36 Royal Malaysia Police B. 37 Immigration Department B. 39 National Registration Department B. 42 Ministry of National Unity and 18,395,800 Social Development B. 43 Ministry of Land and Co-operative Development B. 44 Ministry of Information 13,667,116 B. 47 Ministry of Transport B. 48 Ministry of Rural Development 72,849,600 B. 52 Ministry of Works 35,400,000 TOTAL 13,141,219,516"
      }
