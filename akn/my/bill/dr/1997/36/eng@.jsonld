        "@value": "Supplementary Supply (1997) (No. 2) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1997) (No. 2) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
