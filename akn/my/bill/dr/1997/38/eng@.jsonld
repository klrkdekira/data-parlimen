      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "THE BOARD OF COUNSELLORS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "There is established a body corporate to be known"
      },
      "schema:text": {
        "@language": "en",
        "@value": "as the \"Board of Counsellors\" with perpetual succession and a common seal, which may sue and be sued in its corporate name and, subject to and for the purposes of this Act, may enter into contracts and may acquire, purchase, take, hold and enjoy movable and immovable property of every description and may convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property or any interest therein vested in the Board upon such terms as it considers fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Board shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to oversee the provision of counselling services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to evaluate the need for counselling services in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the training of counsellors and determine the types and levels of counselling to be made available in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the qualifications entitling a person to be registered under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the standard of counselling training programmes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Government in relation to the standard of counselling services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to register qualified counsellors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the fees which can be charged by a registered counsellor for his counselling services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint members of the Board to sit on any board, committee or body formed for any purpose affecting the counselling profession;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the conduct of the counselling profession, including prescribing the code of ethics for the counselling profession; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as may be necessary to enable it to carry out its functions effectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_5"
      ],
