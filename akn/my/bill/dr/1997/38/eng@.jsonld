    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_a",
