        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall consist of the following members who shall be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a President, who shall be appointed from among the registered counsellors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Welfare Department;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Education;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Health;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Islamic Development Department;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Public Services Department;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Home Affairs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "three representatives of higher educational institutions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "six registered counsellors."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the first Board shall be appointed by the Minister for a period not exceeding two years and shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for social welfare, as chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "nine persons representing professional bodies allied to the counselling profession; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "one person representing higher educational institutions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the First Schedule shall apply to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall act as Secretary to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consulting the Board, amend the First Schedule by order published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 shall"
      },
      "schema:text": {
        "@language": "en",
        "@value": "apply to any action, suit, prosecution or proceeding against the Board or against any member, officer, servant or agent of the Board in respect of any act, neglect or default done or committed by him in such capacity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Board or any of its committees and every officer, servant or agent of the Board, while discharging his duties as such member, officer, servant or agent, shall be deemed to be a public servant within the meaning of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall furnish the Minister with all such returns, reports, accounts and information with respect to its property and activities as the Minister may require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Board shall, as soon as practicable after the end of each financial year, cause to be made and transmitted to the Minister a report dealing with the activities of the Board during the preceding financial year and the report shall be in such form and shall contain such information relating to the proceedings and policy of the Board as the Minister may specify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Board may appoint an advocate and solicitor to"
      },
      "schema:text": {
        "@language": "en",
        "@value": "institute and conduct any civil proceeding on its behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet at least twice in each year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "At a meeting of the Council fifteen members shall constitute a quorum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "There is established an advisory council to be known"
      },
      "schema:text": {
        "@language": "en",
        "@value": "as the \"Malaysian Counsellors Advisory Council\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Council shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister on any matter pertaining to this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister on any matter referred to it by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for social welfare, who shall be the chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Secretary General of the Ministry responsible for social welfare, who shall be the deputy chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the President of the Board or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar, who shall be the secretary; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not more than twenty-five other members appointed by the Minister from the following categories:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the public sector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "professional bodies allied counselling profession and approved by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "representatives of higher educational institutions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "non-governmental organisations which provide counselling services; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "individuals who, because of their knowledge and experience, would in the opinion of the Minister be of assistance to the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be appointed to be a member of the Council unless he is a Malaysian citizen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Council appointed under paragraph"
      },
      "schema:text": {
        "@language": "en",
        "@value": "5 ( 1 )( e ), unless he sooner resigns or vacates his office or his appointment is sooner revoked, shall hold office for a term not exceeding two years and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister shall revoke the appointment of a member"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of the Council appointed under paragraph 5(1)(e)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a member of the Council or otherwise, has been such as to bring discredit on the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under a law relating to corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment for more than two years in itself only or in addition to or in lieu of a fine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes a bankrupt; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes of unsound mind or is otherwise incapable of discharging his duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Council appointed under paragraph"
      },
      "schema:text": {
        "@language": "en",
        "@value": "5 ( 1 )( e) shall cease to be a member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "if he is absent from three consecutive meetings of the Council without leave of the chairman of the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "if his apppointment is revoked;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "on his death; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "if he resigns his office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Council appointed by the Minister under paragraph 5 ( 1 )( e) may resign as a member of the Council at any time by giving one month's notice in writing to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18",
