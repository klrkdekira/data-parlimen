        "@value": "MISCELLANEOUS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The President of the Board or any officer authorised by him may, for the purpose of carrying out the objects of this Act or any regulations made under this Act, at any reasonable time and upon the production of his certificate of authorisation enter, inspect and examine any premises or any area including any building or structure thereon which belongs to or is used, whether permanently or otherwise, or whether or not registered for use, by a registered counsellor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "In carrying out an inspection under subsection (1), the President or an officer authorised by him may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "enter any area or premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "examine such book, register, document, material or other article as he may consider necessary; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "remove and detain any book, register, document, material or other article."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "An officer may for the purpose of this section seek whenever necessary the assistance of the police in the execution of his duty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
