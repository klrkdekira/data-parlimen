        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII"
    },
    {
