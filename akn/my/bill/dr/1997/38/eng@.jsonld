        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REGISTRATION OF COUNSELLORS AND PRACTISING CERTIFICATES"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall appoint a Registrar of Counsellors who shall be under the general direction and supervision of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sign all certificates of registration and certificates of temporary registration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "record all entries required to be made in the Register;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "remove from the Register the names and other particulars of a registered counsellor whose name has been ordered by the Board or the Disciplinary Committee to be removed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "carry out any other duty required by this Act or regulations made under this Act to be carried out by him or as directed by the Board for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall keep and maintain a register called the Register of Counsellors."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Register shall be kept in such form and on such material as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Register shall be open to the inspection of the public in such manner as the Minister may by regulations prescribe."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may, with the prior approval of the Board, make amendments to the Register for the purpose of correcting any errors or updating any information contained therein; and shall publish in the Gazette the names and addresses of registered counsellors affected by such amendments."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, if it is satisfied that a registered counsellor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has died;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has become incapable of performing his professional duties as a counsellor due to physical or mental infirmity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has failed to renew his certificate of temporary registration or practising certificate within four years from the date of its expiry, order the Registrar to remove the name and particulars relating to that registered counsellor from the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall publish in the Gazette the name of every person removed from the Register under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall, on the application of any person whose name has been removed on the ground specified in paragraph 20(1)(c), reinstate him in the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Every application for reinstatement shall be made in the prescribed form and accompanied by the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall, upon the application of any person who has been reinstated under subsection (1), issue to him a practising certificate under subsection 27(4) or 28(3) as if such application had been made under subsection 27(2) or subsection 28(1), as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "practise or carry on or operate, or hold himself out as practising or carrying on or operating, or take up employment, as a counsellor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "use the title \"registered counsellor\" or any title in any language which may be reasonably construed to imply that he is a registered counsellor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "use or display any sign, board, card or other device representing or implying that he is a registered counsellor, unless he is registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) shall be guilty of an offence and shall on conviction be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall practise as a counsellor unless he holds a valid practising certificate issued under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) shall be liable to disciplinary proceedings under Part VI and shall not be entitled to recover in any court any fee, charge or remuneration for his counselling services."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A person shall be registered as a counsellor if he satisfies the Board that he is a Malaysian citizen or a permanent resident of Malaysia, is not less than twenty- one years of age, is a fit and proper person to be registered as a counsellor and holds any of the qualifications specified in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person holds any qualification which is not specified in the Second Schedule but the Board is satisfied that such qualification is not less than any of the or equivalent to the qualifications specified in that Schedule, the Board may approve the registration of such person as a counsellor if he satisfies the Board that he is a Malaysian citizen or a permanent resident of Malaysia, is not less than twenty-one years of age and is a fit and proper person to be registered as a counsellor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consulting the Board, amend the Second Schedule by order published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "An application for registration as a counsellor shall"
      },
      "schema:text": {
        "@language": "en",
        "@value": "be made in the prescribed form and shall be accompanied by such information and documents as may be required by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of an application under section 25, the Board shall consider the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "If the Board decides to register the applicant, it shall direct the Registrar to enter the applicant's name and particulars in the Register and to issue to the applicant a certificate of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The President shall sign every entry made in the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall publish in the Gazette the name and address of every person whose name and particulars have been entered in the Register under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "If the Board refuses to register the applicant, the Registrar shall immediately serve a notice of the Board's refusal on the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant who is aggrieved by the refusal of the Board to register him may appeal in writing to the Minister within twenty-one days from the date on which the notice of such refusal is served on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Minister shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is neither a Malaysian citizen nor a permanent resident of Malaysia who intends to practise as a counsellor in Malaysia may apply in the prescribed form for temporary registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Every application made under subsection (9) shall be accompanied by the prescribed fee and such documents and information as may be required by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "An application under subsection (1) shall be accompanied by an application for a practising certificate and the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of an application under subsection (1), the Board shall consider the application and may permit the applicant to be temporarily registered if the Board is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is registered or licensed as a counsellor, or is otherwise permitted by law to practise as a counsellor, in the country where he ordinarily practises as a counsellor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he possesses counselling expertise; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "his physical presence is required in Malaysia for not less than one hundred and eighty days in one calender year for purposes of providing counselling services or he is a resident representative of the foreign component of a joint venture for such purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If the Board permits an applicant to be temporarily registered, it shall direct the Registrar to issue to the applicant a certificate of temporary registration and a practising certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If the Board refuses to register the applicant, the Registrar shall immediately serve a notice of the Board's refusal on the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant who is aggrieved by the refusal of the Board to register him may appeal in writing to the Minister within twenty-one days from the date on which the notice of such refusal is served on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Minister shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate of temporary registration and a practising certificate issued under subsection (4) shall be valid for a period of twelve months from the date the certificates are issued."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate of temporary registration and a practising certificate issued under subsection (4) may be renewed on application being made to the Board in the prescribed form not less than thirty days before the date of expiry of the certificates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A counsellor who is registered under section 26 and intends to practise as a counsellor shall make an application, in the prescribed form, within one month from the date a certificate of registration is issued to him under subsection 26(4), for a biennial practising certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Every application for a biennial practising certificate shall be accompanied by the prescribed fee and shall contain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the address of the principal place, and other places, where the registered counsellor intends to carry on practice as a counsellor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the registered counsellor's address correspondence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of an application under subsection (1), the Board may issue to the applicant a biennial practising certificate authorising the applicant to practise as a counsellor at the places specified in the certificate during the period of two years for which the biennial practising certificate is issued."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary in this Act, a registered counsellor who has made an application under subsection (1) may practise as a counsellor without a biennial practising certificate from the day his application under that subsection is received by the Board until the day the biennial practising certificate is issued to him under subsection (2), and, for the purpose of this Act and any regulations made under this Act, he shall be deemed to have a biennial practising certificate during that period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A biennial practising certificate may be renewed on application being made to the Board in the prescribed form not less than thirty days before the date of expiry of the certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "An application made later than the period mentioned in subsection (5) shall not be granted unless the prescribed additional fee has been paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (2) and (3) shall apply to an application for the renewal of a biennial practising certificate as they apply to a new application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Every registered counsellor shall exhibit, at a conspicuous place in the premises in which he practises as a counsellor, a copy of his certificate of registration or certificate of temporary registration, as the case may be, and his practising certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered counsellor practises as a counsellor in more than one premises, he shall cause a copy of the certificate of registration or certificate of temporary registration, as the case may be, and the practising certificate, to be exhibited in a conspicuous place in each premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsections (1) or (2) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who exhibits, or permits to be exhibited, in any premises, a certificate of registration or certificate of temporary registration or a practising certificate, or a copy of any of such certificates, bearing his name or photograph at any time when his name does not appear on the Register or when he does not hold a valid certificate of registration or certificate of temporary registration, as the case may be, or a practising certificate shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a change in the address of the premises stated in the practising certificate in which a registered person practises as a counsellor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a registered person practises as a counsellor in any premises additional to the premises stated in his practising certificate, he shall, within thirty days of such change or addition, notify the Registrar in writing of such change or addition."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Every notification under subsection (1) shall be accompanied by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particulars of the certificate of registration or certificate of temporary registration, as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the practising certificate, of the registered counsellor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may require the registered counsellor to submit any information as he may deem necessary about the premises referred to in subsection (1) and the registered person shall comply with such requirement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1), (2) or (3) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall endorse the new address or the address of the new premises where the registered counsellor practises as a counsellor on the registered counsellor's practising certificate and return the certificate to the registered counsellor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Every registered counsellor shall notify the Registrar of any change in his address for correspondence within fourteen days of the change."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A registered counsellor whose certificate of registration or certificate of temporary registration, as the case may be, is lost shall immediately notify the Registrar of such loss."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall, on application being made and payment of the prescribed fee by the registered counsellor, issue to the registered counsellor a duplicate certificate of registration or certificate of temporary registration, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Counsellors Act 1997 and shall come into operation on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any health professional; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any company, society or local authority providing healthcare services such as hospital, nursing home, hospice, blood bank, psychiatric hospital, ambulatory care centre, maternity home, haemodialysis centre, community mental health centre, psychiatric nursing home, medical or dental clinic, or any other healthcare facility."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— \"Board\" means the Board of Counsellors established under section 11; \"certificate of registration\" means a certificate issued under subsection 26(2) and includes a duplicate certificate of registration issued under subsection 32(2); \"certificate of temporary registration\" means a certificate issued under subsection 27(4) and includes a duplicate certificate of temporary registration issued under subsection 32(2); \"company\" has the meaning assigned to it in the Companies Act 1965; \"Council\" means the Malaysian Counsellors Advisory Council established under section 3; \"counselling\" means a systematic process of helping relationship based on psychological principles performed by a registered counsellor in accordance with the counselling code of ethics to achieve a voluntary favourable holistic change, development and adjustment of the client such that the change, development and adjustment will continue throughout the lifespan of the client; \"counsellor\" means a person who provides counselling services for a prescribed fee or any other consideration; \"Disciplinary Committee\" means the Disciplinary Committee established under paragraph 36(2)(b); \"health professional\" includes a medical practitioner, medical and clinical psychologist, nurse, midwive, medical assistant and any person involved in the giving of medical and health services under the jurisdiction of the Ministry of Health; \"higher educational institution\" means any institution established under the University and University Colleges Act 1971 or the Institut Teknologi MARA Act 1976 or the Private Higher Educational Institutions Act 1996; \"Investigation Committee\" means the Investigation Committee established under paragraph 36(2)(a); \"local authority\" means a local authority established under the Local Government Act 1976; \"Minister\" means the Minister for the time being charged with the responsibility for social welfare; \"practising certificate\" means a practising certificate issued under subsection 27(4) or 28(3), as the case may be; \"prescribed\" means prescribed by regulations made under this Act; \"President\" means the President of the Board of Counsellors; \"Register\" means the Register of Counsellors kept and maintained under section 19; \"registered counsellor\" means a person registered under section 26 or 27; \"Registrar\" means the Registrar of Counsellors appointed under subsection 18(1); \"society\" means a society registered under the Societies Act 1966."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V",
      "@type": "akn:part",
