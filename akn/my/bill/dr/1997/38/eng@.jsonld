      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister, in consultation with the Board, may make regulations for all or any of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the manner of applying for certificates under this Act, the particulars to be supplied by an applicant, the manner of certification, the fees payable therefor, the conditions or restrictions to be imposed and the form or forms of certificates;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "regulating the keeping of the Register and of accounts, records, reports and documents and prescribing the form and contents thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the management of the property of the Board and the audit of its accounts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure for the election or appointment of members of the committees of the Council or the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the requirements to be complied with by the Board for engaging a legal adviser and the remuneration to be paid to him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure for investigation into complaints and for disciplinary inquiries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure for appeals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing matters in respect of which fees and charges are to be payable under this Act or the regulations made under this Act, the amount of the fees, and the persons liable to pay them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the forms to be used in making applications under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matter which is required by this Act to be prescribed or specified or which is necessary or expedient to be prescribed or specified for carrying this Act into effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Regulations made under this Act may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide that any contravention of any of the provisions of the regulations shall be an offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide for such offence to be punished with a fine not exceeding three thousand ringgit or to imprisonment for a term not exceeding six months or to both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "be made to operate retrospectively to a date not earlier than the date of coming into force of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (2)(c), no person shall be made or shall become liable to any penalty in respect of any act done before the date the regulations are published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "procures or causes the procurement of a certificate of registration, certificate of temporary registration or practising certificate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by making or causing to be made; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by producing or causing to be produced, a false or fraudulent declaration, certificate, application or representation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "forges, alters or counterfeits a certificate of registration, certificate of temporary registration or practising certificate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "uses a forged, altered or counterfeited certificate of registration, certificate of temporary registration or practising certificate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "personates a registered person or a director of a body corporate practising as a counsellor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "buys or fraudulently obtains a certificate of registration, certificate of temporary registration, or practising certificate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "sells, assigns or transfers a certificate of registration, certificate of temporary registration or practising certificate, shall be guilty of an offence and shall on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_44__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a continuing offence, be liable to a fine not exceeding one thousand ringgit for every day or part of a day during which the offence continues after conviction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "A person who contravenes any of the provisions of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act for which no penalty is expressly provided shall on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "be liable to a fine not exceeding five thousand ringgit or imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a continuing offence, be liable to a fine not exceeding five hundred ringgit for every day or part of a day during which the offence continues after conviction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Where a body corporate commits an offence under"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act or any regulations made under this Act, any person who, at the time of the commission of such offence, was a director, manager, secretary or other similar officer of such body corporate or was purporting to act in any such capacity, or was in any manner or to any extent responsible for the management of any of the affairs of such body corporate, or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "where the body corporate is found guilty of the offence, shall be deemed to be guilty of that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_46__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Prosecution in respect of an offence under this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "shall not be instituted or conducted without the written consent of the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have disciplinary authority over all registered counsellors and shall exercise disciplinary control in respect of all such counsellors in accordance with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Part there shall be established—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an Investigation Committee comprising three members of the Board to investigate into a complaint made against a registered counsellor; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Disciplinary Committee comprising five members of the Board, not being members of the Investigation Committee, to inquire into a complaint referred to it by the Investigation Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Every complaint against any registered counsellor shall be addressed to the Registrar who shall immediately refer such complaint to the Investigation Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Investigation Committee shall investigate every complaint and shall, as soon as practicable, submit its report on such complaint to the Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Every report under subsection (2) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "state whether sufficient grounds exist for disciplinary proceedings to be taken against a registered counsellor; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "be accompanied by such evidence as the Investigation Committee may have obtained in support of such statement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where the report submitted by the Investigation Committee states that sufficient grounds exist for disciplinary proceedings to be taken against a registered counsellor, the Disciplinary Commitee shall inquire into the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "A registered counsellor against whom disciplinary proceedings are taken shall be given an opportunity to make representations against the disciplinary charge laid against him before a decision is arrived at by the Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The registered counsellor against whom disciplinary proceedings have been taken shall be notified by the Registrar by registered post of the decision of the Disciplinary Committee as soon as possible after the making of such decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, if it considers fit, suspend the practising certificate of a registered counsellor for a period not exceeding six months pending the completion of an investigation by the Investigation Committee and inquiry by the Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "No registered counsellor shall practise as a counsellor during the period of suspension under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Disciplinary Committee shall, upon being satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against the registered counsellor, or the registered counsellor has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; ."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment for more than two years in itself only or in addition to or in lieu of a fine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered counsellor's registration has been obtained by fraud or misrepresentation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registered counsellor has become a bankrupt, order the name of the registered counsellor to be removed from the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Disciplinary Committee may, upon being satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the registered counsellor has offered or accepted a commission which in the opinion of the Disciplinary Committee is an illicit commission; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_cc",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_dd"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the registered counsellor has contravened any provision of this Act or any regulations made under this Act, impose any one or any. combination of the following disciplinary punishments:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "order the name of the registered counsellor to be removed from the Register;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "order the name of the registered counsellor to be suspended from the Register for a period not exceeding two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "order the imposition of a fine not exceeding five thousand ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b__subpara_dd",
      "@type": "akn:subparagraph",
      "eli:number": "dd",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_40__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "order the registered counsellor to be reprimanded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A registered person shall surrender to the Board his certificate of registration or certificate of temporary registration, as the case may be, and his practising certificate within twenty-one days of being notified under subsection 38(3) of the decision of the Disciplinary Committee under section 40 to remove his name from the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved by a decision of the Disciplinary Committee against him under section 40 may, within thirty days of being notified of such decision, appeal against the decision to the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may confirm, reverse or vary the decision of the Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the Minister under subsection (2) shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "The Registrar shall publish in the Gazette the name"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of every registered counsellor whose name has been removed from the Register—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "on the expiry of the -period of specified in subsection 42(1), if the registered counsellor does not enter an appeal against the decision of the Disciplinary Committee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "after the decision of the Minister upholding the decision of the Disciplinary Committee, if the registered counsellor enters an appeal against the decision of the Disciplinary Committee, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "No body corporate shall practise as a counsellor unless its board of directors consists—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "entirely of individual persons who are registered counsellors; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of a majority of individual persons who are registered counsellors, and other individual persons belonging to a profession which is allied to the counselling profession and approved by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any body corporate which contravenes subsection (1) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "A body corporate practising as a counsellor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "may use the title \"registered counsellor\" or any title in any language which may be reasonably construed to imply that it is a body corporate practising as a counsellor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "may use or display any sign, board, card or other devices representing or implying that it is a body corporate practising as a counsellor; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "shall be entitled to recover in any court any fee, charge or remuneration for its professional counselling services, as long as it complies with subsection 33(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate practising as a counsellor shall notify the Board—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any change in the composition of its board of directors in a report containing full particulars of the change, within thirty days of the change; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any change in the address at which it carries on its practice as a counsellor, within fourteen days of the change."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any body corporate which contravenes subsection (1) shall be guilty of an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Subsection 15(3)]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board shall determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall meet at least twice a year at a time and place to be appointed by the President."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "At least fourteen days notice in writing shall be given to the members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The President shall preside at a meeting of the Board and in his absence the members of the Board shall elect one of their number to preside over the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Board shall be seven."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Board present shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "If on a question to be determined by the Board there is an equality of votes, the President, or where the President is absent, the member presiding over that meeting, shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Members of the Board shall be paid such allowances as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may invite any person to attend a meeting or deliberation of the Board for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subparagraph (1) may be paid such fee as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "Minutes made of meetings of the Board shall, if duly signed, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Board in respect of the proceedings of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) T he Board shall have a common seal-which shall bear such device as the Board shall, approve and such seal may be broken, changed, altered or made anew as the Board thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the President or such other person as may be authorised by the Board in writing and shall be authenticated by the President or such authorised officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purporting to be sealed with the common seal, authenticated by either of the persons specified in subparagraph (1), shall until the contrary is proved, be deemed to have been validly executed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subparagraph (3), any document or instrument which if executed by a person not being a body corporate would not be required to be under seal may in like manner be executed by the Board; and any such document or instrument may be executed on- behalf of the Board by any member of the Board generally or specially authorised by the Board in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Board shall be officially and judicially noticed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Board having, directly or indirectly, by himself"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or his partner, any interest in any company or undertaking with which the Board proposes to make any contract or having any interest in any such contractor in any matter under discussion by the Board shall disclose to the Board the fact of his interest and the nature thereof, and such disclosure shall be recorded in the minutes of the Board and, unless specifically authorised thereto by the President, such member shall take no part in deliberation or decision of the Board relating to the contract or matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "No act done or proceeding taken under this Act shall be questioned"
      },
      "schema:text": {
        "@language": "en",
        "@value": "on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "a vacancy in the membership of, or a defect in the constitution of, the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "the contravention by any member of the Board of the provisions of paragraph 6; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "an omission, a defect or an irregularity not affecting the merit of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Money received by the Board whether from fees payable under this Act or other sources shall be applied by the Board—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the first place to defraying the expenses of registration and other expenses for the administration of this Act including any expenses of the Board that may be allowed under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "thereafter to the promotion and advancement of the profession of counselling."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Money that is not immediately required by the Board may be invested in such trust securities as the Board may, from time to time, determine after consultation with the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/38/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Every member of the Board shall devote such time to the business"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of the Board as may be necessary to discharge his duties effectively."
      }
    },
    {
