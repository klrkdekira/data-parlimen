        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_8"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Offshore Insurance (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Offshore Insurance (Amendment) Act 1997 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 6 of the Offshore Insurance Act 1990, which in this Act is referred to as the \"principal Act\", is amended by substituting for the words \"one million ringgit\" in subparagraph (1)(b)(iii) the words \"three hundred thousand ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 19 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the words \"and liabilities\" the words \"as approved in accordance with its constituent documents\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsection: \"(5) Notwithstanding any provision in this Act, the Bank may require a licensee to submit to the Bank any document relating to its operation in such manner as may be specified in writing by the Bank.\". Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 21(2) of the principal Act is amended by inserting after the word \"currency\" the words \"and such other business as may be specified in writing by the Bank\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 22(2) of the principal Act is amended by deleting the words \"licensed offshore insurance manager shall provide administrative services and no\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 25 of the principal Act is amended by inserting after the word \"licensee\" the words \"and no person who has access to the information or document relating to the affairs or account of any policy owner\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 32 of the principal Act is amended by inserting after paragraph (a) the following paragraph: \" (aa) pertaining to the supervision of offshore insurance business;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 33(2) of the principal Act is amended by substituting for the words \"Governor and Deputy Governor and any director\" the words \"Governor, the Director-General, and any member, officer or employee\"."
      }
    }
  ]
}
