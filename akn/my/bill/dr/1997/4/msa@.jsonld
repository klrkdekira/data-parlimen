        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_8"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Insurans Luar Pesisir (Pindaan) 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Insurans Luar Pesisir (Pindaan) 1997 dan hendaklah mula berkuatkuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta Insurans Luar Pesisir 1990, yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dengan menggantikan perkataan \"satu juta ringgit\" dalam subperenggan (1 )(b)(iii) dengan perkataan \"tiga ratus ribu ringgit\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 19 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan \"dan liabiliti-liabilitinya\" perkataan \"sebagaimana yang diluluskan mengikut dokumen konstituennya\"; dan Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (4) subseksyen yang berikut: \"(5) Walau apa pun apa-apa peruntukan dalam Akta ini, Bank boleh menghendaki pemegang lesen untuk mengemukakan kepada Bank apa-apa dokumen berhubungan dengan pengendaliannya mengikut cara yang ditentukan oleh Bank secara bertulis.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 21(2) Akta ibu adalah dipinda dengan memasukkan selepas perkataan \"mata wang Malaysia\" perkataan \"dan apa-apa perniagaan lain yang ditentukan oleh Bank secara bertulis\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 22(2) Akta ibu adalah dipinda dengan memotong perkataan \"pengurus insurans luar pesisir berlesen boleh memberikan khidmat-khidmat pentadbiran dan tiada\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 25 Akta ibu adalah dipinda dengan memasukkan selepas perkataan \"pemegang lesen\" perkataan \"dan tiada orang yang ada akses kepada maklumat atau dokumen berhubungan dengan hal-ehwal atau akaun mana-mana pemunya polisi\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 32 Akta ibu adalah dipinda dengan memasukkan selepas perenggan (a) perenggan yang berikut: \"(aa) berkenaan dengan penyeliaan perniagaan insurans luar pesisir;\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 33(2) Akta ibu adalah dipinda dengan menggantikan perkataan \"Gabenor dan Timbalan Gabenor dan mana-mana pengarah Bank\" dengan perkataan \"Gabenor, Ketua Pengarah, dan mana-mana anggota, pegawai atau pekerja\"."
      }
    }
  ]
}
