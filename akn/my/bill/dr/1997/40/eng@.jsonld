      "schema:name": {
        "@language": "en",
        "@value": "Judges' Remuneration (Amendment) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Judges' Remuneration"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 1997 and shall be deemed to have come into force on 1 January 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Judges' Remuneration Act 1971 is amended in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 7 by substituting for the words \"1/20 of his last drawn salary for each completed month of his service\" the words \"seven and a half per centum of the amount arrived at by multiplying his total completed months of service as a Judge by his last drawn salary\"."
      }
    }
