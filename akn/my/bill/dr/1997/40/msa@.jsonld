      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Saraan Hakim 1971"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Saraan Hakim"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1997 dan hendaklah disifatkan telah mula berkuatkuasa pada 1 Januari 1995."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Saraan Hakim 1971 adalah dipinda dalam seksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "7 dengan menggantikan perkataan \"1/20 daripada gaji yang akhir diterimanya bagi tiap-tiap satu bulan genap perkhidmatannya\" dengan perkataan \"tujuh setengah peratus daripada amaun yang terhasil dengan mendarabkan jumlah bulan genap perkhidmatannya sebagai Hakim dengan gaji terakhir yang diterimanya\"."
      }
    }
