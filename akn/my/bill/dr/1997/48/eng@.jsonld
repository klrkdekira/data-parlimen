        "@value": "MUTUAL FUNDS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "EXCHANGE"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may, on the written recommendation"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of the Authority, establish a body corporate which is an offshore company to be an exchange in Labuan by the name of \"Labuan International Financial Exchange\" with perpetual succession and a common seal, which may sue and be sued in its name and, subject to and for the purpose of this Act, may enter into contracts and may acquire, purchase, take, hold and enjoy movable and immovable property of every description and may convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property or any interest therein vested in the Exchange upon such terms as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, with the approval of the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Minister, prescribe such by-laws as may be expedient or necessary for the purpose of carrying out the provisions and matters connected with the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Exchange may, with the approval of the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Authority, make rules which provide for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions of entry and admission into membership of the Exchange and for the regulation generally of the conduct of trading members in connection with the business of the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the financial, accounting, record-keeping, disclosure and capital adequacy requirements applicable to trading members;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions under which securities may be listed for trading in the securities market proposed to be operated by the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions governing dealings in securities by trading members;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the class or classes of securities that may be dealt in by trading members or listed in the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "confidentiality with respect to information relating to the affairs of the Exchange and of any trading member in connection with the business of the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitration of disputes arising out of or in connection with any securities market operated by the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the suspension of trading in and the de-listing of any security listed on the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the establishment and maintenance of a compensation fund to be administered by a committee on behalf of the Exchange and for the levying of monies on trading members in order to meet such costs, claims and expenses as the committee from time to time deems fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the carrying on of the business of the Exchange with due regard to the interests of the public;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "a fair and independent market for the listing and trading of securities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "such other matters as the Exchange deems necessary or desirable for the proper and efficient regulation, management and control of the Exchange and the securities market operated by it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The affairs of the Exchange shall be managed by a committee consisting of not less than five persons who possess relevant experience in financial, commercial or legal matters of whom the chairman and one other person shall be appointed by the Minister and the rest appointed by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to Part III, the committee shall have full power in all things to administer the affairs of the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 53, the provisions of the Offshore Companies Act 1990 shall, unless the context otherwise requires, apply in all respects to the persons who make up the committee as if such persons were directors for the purposes of that Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "No person other than a trading member shall engage in or hold himself out as engaging in the business of dealing in securities on the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection 34(1) commits an offence and shall be liable on conviction to a fine not exceeding two hundred thousand ringgit or to imprisonment for a period not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The secretary shall keep a register of the trading members and shall enter therein the names and addresses of the trading members and the date upon which each was admitted and ceased to be a trading member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The register of trading members shall be made available for inspection at the registered office of the Exchange during business hours."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any person may require, and if required the secretary shall forthwith provide, a copy of the register or any part thereof on payment of such fee as may be prescribed in writing by the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any payment under subsection 35(3) shall be made to the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "Within six months of the end of each financial year"
      },
      "schema:text": {
        "@language": "en",
        "@value": "the Exchange shall file with the Authority a copy, certified by the secretary as a true copy, of the financial statements of the Exchange for that year prepared and audited in accordance with the provisions of Part VI of the Offshore Companies Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "No person shall be deemed to be engaging in or"
      },
      "schema:text": {
        "@language": "en",
        "@value": "carrying on a trade or business in Malaysia or with residents of Malaysia for the purpose of any written law by reason only of the fact that —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "securities of such person are listed on a securities market operated by the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "such person is a trading member and that transactions are effected by it or on its behalf through the facilities of the Exchange; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "such person undertakes activities in Labuan incidental to the proper conduct of the activities referred to in paragraphs 3 7( a) and (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may direct the Exchange by written notice to suspend trading on the Exchange either wholly for a period not exceeding five consecutive business days or in respect of specified securities for such period as the Authority deems fit if the Authority after consultation with the committee determines that the orderly conduct of such trading is being or is likely to be prevented by reason of force majeure, natural disaster, strike or lock-out, revolution or other political upheaval or economic or financial crisis, wherever occurring."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "A notice to suspend trading shall indicate the reason for and duration of such suspension and shall take effect upon its delivery to the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may after consultation with the committee direct the Exchange to extend the period of suspension of trading under subsection 38(1) either wholly for additional periods not exceeding five consecutive business days or in relation to specified securities for such additional periods as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall within two clear business days give a written notice of such extension to the Exchange indicating therein the reason therefor and duration thereof and such notices shall take effect upon its delivery to the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall on the business day next following delivery to the Exchange of the notice under this section and if so requested by the Exchange provide an opportunity for the Exchange to be heard on the need for any suspension of trading or any extension thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may revoke, withdraw or modify any direction made under subsections 38(1) and (3) at any time prior to expiry of the period of suspension or extension thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act and the proper conduct of the business of the Exchange and in addition to any other powers accorded to it under this Act the Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "at any time investigate or enquire into any transaction involving the purchase or sale of securities entered into by any person whether directly or indirectly to ascertain if that person has used dishonest, unfair or unethical devices or trading practices whether such devices or trading practices constitute an offence under this Act or any other written law or an infringement of any of the rules or otherwise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require any such person to submit detailed information of any transaction involving the purchase or sale of securities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require the production of, inspect and make copies or print-outs of or take extracts from any document record or thing relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the business or affairs of the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any dealing in securities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any advice, report or analysis concerning securities; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the accounts or records of any person concerned in any capacity with the matters referred to in subparagraph 39(c)(i), (ii) or (iii) any audit of, or report of an auditor concerning, the same; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the authority of a search warrant issued by the court to that effect and with or without the assistance of such persons as the Authority may require unless the Authority has reasonable grounds for believing that, by reason of the delay in obtaining the search warrant, the object of any entry is likely to be frustrated, and in such instance without a warrant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "break into and search any premises, place or item therein on or in which the Authority has reason to suspect there may be any document, record or thing the production of which was required by virtue of this section but not produced in compliance with such requirement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "take possession, of or secure against interference any document, record or thing the production of which was required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "comply with a requirement made under subsection 39(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in purported compliance with a requirement made under subsection 39(1) furnishes information or makes a statement that is false or misleading in a material particular; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "obstructs or hinders the Authority or another person in the exercise of any power under subsection 39(1), commits an offence and is liable on conviction to a fine not exceeding ten million ringgit or to imprisonment for a term not exceeding ten years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_III__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The powers conferred under this section are, in addition to, and not in derogation of, any other powers conferred by law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "An application by the promoters for a proposed public"
      },
      "schema:text": {
        "@language": "en",
        "@value": "fund or by a public fund to the Authority for registration to carry on business or arrange or administer its affairs in or from within Labuan shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "made in such form and contain such information as may be prescribed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "accompanied by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a statement setting out the scope and nature of the business to be carried on by the applicant in or from within Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "such application fee as may be prescribed by regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the instrument by which the applicant is constituted or such other proof as the Authority may require to be satisfied that the applicant is lawfully constituted under the laws of Malaysia relating to Labuan or under the laws of any recognised country or jurisdiction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the information required under section 21; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "such other deeds, documents or information as the Authority may reasonably require for the purpose of determining the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "grant or refuse to grant registration of a public fund; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "grant provisional acceptance of a proposed public fund,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A grant under subsection 11(1) may be made subject to any terms, conditions, limitations or restrictions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A provisional acceptance granted under paragraph 1 1 ( 1 )( b) shall be valid and effective for a period not exceeding three months from the date on which it is granted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A provisional acceptance may be renewed for a period not exceeding three months upon application being made to the Authority and accompanied by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "such documents or information as the Authority may require; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "such application fee as may be prescribed by regulations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the grant of a provisional acceptance under paragraph 11(1)(b) to a proposed public fund, the Authority may grant registration to such a proposed public fund as a public fund under paragraph 11(1)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall carry on business in or from within Labuan as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a manager of a public fund unless that person is an offshore company who has been granted a licence to act as manager under section 14;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an administrator of a public fund unless that person is an offshore company or trust company and is registered to act as an administrator under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 12(l)(a) does not apply to a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is and continues to be a qualified and authorised manager of mutual funds under the laws of any recognised country or jurisdiction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has received written permission from the Authority to carry on business as manager or administrator of public funds in or from within Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 12(1)(b) does not apply to a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is an offshore bank, a trust company or a management company licensed under section 130c of the Offshore Companies Act 1990; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is and continues to be a qualified administrator of mutual funds under the laws of any recognised country or jurisdiction, and has received written permission from the Authority to carry on business as manager or administrator of public funds in or from within Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection 12(2), an application for a licence to carry on business in or from within Labuan as a manager of a public fund shall be made to the Authority in such manner as the Authority may prescribe in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "An application under subsection 13(1) shall be accompanied by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such application fee as may be prescribed by regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particulars of the financial and human resources and administrative facilities available to the applicant for the competent and efficient conduct of its business;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the information required under section 21; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such other information or documents as the Authority may reasonably require for the purpose of determining the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection 12(3), an offshore company may apply in the prescribed form, accompanied by such fee as may be prescribed, to the Authority for registration as an administrator of a mutual fund,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may grant or refuse to grant a licence or registration to any applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may refuse to grant a licence or registration unless it is satisfied that the applicant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is a fit and proper person to engage in the business of management or administration of mutual funds; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has or has available to him sufficient knowledge, expertise, resources and facilities for the proper management or administration of mutual funds."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The grant of a licence or registration may be made subject to any terms, conditions, limitations or restrictions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Except with the written consent of the Authority no change shall be made in respect of the identity, residence, domicile, ownership or shareholding of the manager or administrator during the period of operation of the licence or registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority has—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the duty to supervise mutual funds, managers and administrators in accordance with this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in and for the discharge of that duty, the powers conferred upon it by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may delegate any of its powers or duties under this Act to any person appointed by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every registered public fund shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keep or cause to be kept accounts and records and shall, after the end of each financial year cause to be prepared a statement of accounts for that financial year which shall include a balance sheet and an account of income and expenditure in accordance with generally accepted accounting principles applicable in Malaysia or in any recognised country or jurisdiction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keep such accounting records and financial statements or true copies thereof at its place of business in Labuan and make them available for inspections by the Authority or any person authorised in writing by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keep at its place of business in Labuan and make available to the Authority or any person authorised in writing by the Authority such other records, statements, documents or information as the Authority may prescribe in writing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "within three months of the end of each financial year present to an auditor the financial statements referred to in paragraph 16(1)(a) and such other records and information as may be required for audit in accordance with generally accepted auditing principles applicable in Malaysia or any recognised country or jurisdiction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "provide to or make available for inspection by all the investors of the fund the financial statements referred to in paragraph 1 6 ( 1 )( a) together with the report of the auditor thereon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The accounting records and financial statements required to be kept in accordance with subsection 16(1) may be kept in any currency and in any language, but if they are kept in a language other than the national language or English language, a translation into the national language or English language, verified in a manner satisfactory to the Authority, shall be kept by the public fund together with such accounting records and financial statements."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "No registered public fund shall, in or outside Labuan, offer its shares to the public unless prior to such offer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it publishes in writing a prospectus signed by or on behalf of its operators and its operators have approved the contents of the prospectus and authorised its publication; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a copy of such prospectus has been filed with the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Every prospectus shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide full, true and plain disclosure of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "all facts and circumstances that would facilitate a reasonable assessment by a prospective investor in determining whether to purchase or subscribe to shares of a public fund; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "such other matters as the Authority may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "contain a statement summarising the rights of investors provided by section 18; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the fund has completed a financial year in operation be accompanied by or contain reference to the availability of the financial statements of the financial year of the fund immediately preceding the date of such offer and the auditor's report thereon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall not accept for filing a copy of a prospectus unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "it is accompanied by a certificate from an expert certifying that it complies with the requirements of subsection 17(2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where all or any part of the prospectus is not in the national language or English language, a translation into the national language or English language of the prospectus or that part of the prospectus, verified in a manner satisfactory to the Authority, is filed with the prospectus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where any change occurs which materially affects any of the matters required to be disclosed under subsection 17(2), the registered public fund shall within twenty- one days of such occurrence incorporate such amendment to the prospectus and provide a copy thereof to each of its investors and to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 28 to 39 inclusive of the Offshore Companies Act 1990 shall not apply to mutual funds consented to or registered in compliance with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "If a registered public fund publishes a prospectus or any amendment thereto that contains any misrepresentation relating to any of the matters required to be disclosed under subsection 17(2), a person who purchased any shares pursuant to such prospectus or amendment thereto is deemed to have relied upon the misrepresentation and shall have the rights provided in subsection 18(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A person referred to in subsection 18(1) may elect to exercise a right of action—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the rescission of the purchase; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for damages, jointly and severally against the fund and every person who, while aware of the misrepresentation, signed the prospectus or amendment thereto and consented to its publication and filing or caused it to be signed or published and filed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"misrepresentation\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any untrue or misleading statement of any of the matters required to be disclosed under subsection 17(2); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an omission to disclose any of such matters."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be liable under this section if he proves that the purchaser purchased the shares offered by the prospectus or amendment thereto with knowledge of the misrepresentation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The right of action for rescission or damages conferred by subsection 18(2) is in addition to any other right which the aggrieved party may have at law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law to the contrary, any action under subsection 18(2) may not be commenced after—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "one hundred and eighty days from the day on which the aggrieved party first had knowledge of the misrepresentation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "one year from the date of the purchase transaction that gave rise to the cause of action, whichever is earlier."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Every registered public fund which carries on business"
      },
      "schema:text": {
        "@language": "en",
        "@value": "outside Labuan under the laws of any recognised country or jurisdiction shall every year, within ninety days of the end of its financial year, file with the Authority a certificate of compliance from the competent authority that is responsible for the regulation and supervision of the conduct of its business in that recognised country or jurisdiction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Every application for consent, registration, provisional acceptance or a licence made under this Act shall be accompanied by the following particulars:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the address of the applicant's place of business and its address for service in Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the name and address of a person in Labuan who is authorised to represent the applicant and to accept service on its behalf; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the address of the applicant's place of business outside Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "If any change is made or occurs in respect of information under subsection 21(1), the applicant, upon being granted consent, registered, provisionally accepted or licensed as the case may be, shall within twenty-one days after the change occurs file with the Authority a notice signed by him specifying the nature of change."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "A consent, licence or registration granted under this"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Act shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "be in such form as may be prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "specify any terms, conditions, restrictions or limitations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "remain in force until it is cancelled; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "be admissible in all courts as prima facie evidence of the facts stated in it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, subject to section 24 and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "subsection 25(2), revoke any consent, licence or registration under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "at the request of the holder thereof; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "where the holder thereof—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has ceased to carry on business in or from within Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any terms, conditions, restrictions or limitations attached to the consent, licence or registration as the case may be;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of an offence under this Act or of a criminal offence in any recognised country or jurisdiction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has knowingly and wilfully supplied false, misleading or inaccurate information or failed to disclose information required under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is carrying on business in a manner that the Authority reasonably believes to be detrimental to the interests of mutual funds investors; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_23__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is declared bankrupt or has been wound- up or otherwise dissolved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Before revoking any consent, licence or registration under paragraph 23(b), the Authority shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "give the holder thereof notice in writing of the grounds on which it intends so to do;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "afford the holder opportunity to make written representations to it within a period of thirty days after receipt of the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "take any such representations into consideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority revokes any consent, licence or registration under paragraph 23(b), the Authority shall give notice in writing to the holder thereof of such revocation and the revocation shall take effect on a date to be specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided under subsection 25(2), where the Authority makes a decision on any application made under this Act, it shall not be bound to assign any reasons for such decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority decides to revoke any consent, licence or registration under paragraph 23(b), the holder of such consent, licence or registration who is aggrieved by the decision may appeal against such decision under section 26."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The bringing of an appeal under this section suspends the decision appealed against, pending the determination or abandonment of the appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection 25(3), the appellant shall not carry on any business or activity without the prior written consent of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "An appeal under subsection 25(2) shall be brought"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "serving on the Authority a notice of appeal within twenty-one days, or such longer period as the Minister may allow, of the receipt by the appellant of the notice required under subsection 24(2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "summons for the hearing of the appeal before the court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of discharging the duties imposed upon the Authority under this Act the Authority or any person authorised by it may at all reasonable times in writing direct any person to whom this Act applies to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "furnish any information; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "provide access to and copies of any records, books or other documents, relating to the business of that person being carried on under this Act which, in the opinion of the Authority, are necessary to enable it to ascertain compliance with the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a fund is insolvent or is likely to become unable to meet all or any of its obligations or is about to suspend payment to any extent; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any fund, manager, administrator, operator or promoter is carrying on business in a manner the Authority reasonably believes to be detrimental to the interest of the investors; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_cc",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_dd"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any fund, manager, administrator, operator or promoter has contravened any provision of this Act or any other written law for the time being in force, the Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "impose new or additional terms, conditions, restrictions or limitations upon the operation of the fund or vary or revoke any which have already been imposed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "require the removal of any promoter, operator, manager or administrator or his replacement by another person approved by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "appoint a person to assume control of the affairs of the fund; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c__subpara_dd",
      "@type": "akn:subparagraph",
      "eli:number": "dd",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "apply to the court for an order to take such action as the Authority considers necessary to protect the interests of investors in and creditors of the fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may bring actions and institute proceedings for the enforcement of any provision of this Act or for the recovery of fees or other sums of money payable under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Save as is provided in subsection 28(2) and section 4, any information, material or document furnished to or filed with the Authority under this Act is privileged and shall not be disclosed to any person except on the order of a court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, on the application of any person or supervisory authority, direct that any specified information, material or document furnished to or filed with the Authority under this Act by any mutual fund shall not be held in confidence and shall be disclosed to the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be construed as prohibiting—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any waiver of confidentiality by the mutual fund; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the publication by the Authority and other supervisory authorities of general information and statistics relating to registrations, consents and licences granted under, implementation and operation of, this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, \"other supervisory authorities\" includes the relevant supervisory authority of any recognised country or jurisdiction which exercises functions corresponding to those of the Securities Commission over the supervision or establishment of mutual funds."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection 48(2) and section 55 of the Offshore Companies Act 1990 to the contrary—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a mutual fund which is a company may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "issue; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "convert existing non-redeemable shares, whether issued or not, into, shares which are to be redeemed, or are liable to be redeemed, at the option of the company or the shareholder;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on the redemption or purchase of its own fully paid shares, a mutual fund which is a company may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "repay the capital paid up on such shares out of paid in capital, share premium or other reserves of the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "pay the premium, if any, out of realised or unrealised profits, share premium or other reserves of the company on such terms and in such manner and at such price as may be determined having regard to the asset value of such shares as ascertained in accordance with its by-laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The redemption or purchase of its own shares by a mutual fund which is a company shall not be taken as reducing its authorised share capital and a mutual fund which is a company shall have power to issue shares equal in aggregate par value to the aggregate par value of the shares so redeemed or purchased as if those shares had never been issued and the issuance of such shares under the power herein contained shall not be taken as increasing the amount of its issued share capital."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 66 to 74 inclusive and subsection 147(2) of the Offshore Companies Act 1990 shall not apply to a mutual fund which is established under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 147(1) of the Offshore Companies Act 1990 shall apply to a mutual fund which is a partnership or a unit trust and such mutual fund shall comply with such other limitations and conditions as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Trustee Act 1949 shall not apply to a trustee of a mutual fund established or registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Section 32 of the Securities Commission Act 1993 shall apply except where an offer for subscription or purchase of shares in a mutual fund established under this Act is made to an exempt purchaser or a non-resident."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 3 of the Labuan Offshore Limited Partnerships Act 1997, a partnership established solely for the purpose of establishing a mutual fund under this Act may have more than twenty partners."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "an \"exempt purchaser\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an individual whose net personal assets exceed ten million ringgit or its equivalent in foreign currencies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a corporation incorporated in Malaysia with net assets exceeding twenty million ringgit in value as determined in accordance with the most recent audited balance sheet of the corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the persons who or which have been declared by the Minister, on the recommendation of the Securities Commission, by notification in the Gazette to be exempt purchasers for the purpose of this subsection; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_29__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "\"non-resident has the meaning assigned to it in section 2 of the Labuan Trust Companies Act 1990."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall carry on business in or from within Labuan as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a public fund unless that person is a trust company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a custodian of a mutual fund unless that person is an offshore bank or a trust company."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 3(1)(a) and (b) do not apply to a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is and continues to be a qualified and authorised trustee of public funds under the laws of any recognised country or jurisdiction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has received written permission from the Authority to carry on business as trustee of a mutual fund in or from within Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this Act, \"any recognised country or jurisdiction\" means any country or jurisdiction as may be prescribed in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "(I) The Authority may keep separate registers for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "private funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "public funds; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "managers and administrators of public funds."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The registers required under subsection 4(1) shall contain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the information required under section 21 in respect of each person who has been granted consent, registration, or licence or who has received written permission under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the date of such consent, registration, licence or written permission, as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the date upon which such consent, registration, or licence or written permission was cancelled."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The registers required to be kept pursuant to this section shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "be in such form as the Authority may determine; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "subject to section 28, be open to public inspection during office hours on payment of such inspection fee as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may issue to any person, upon request by the person, a certificate of compliance in such form, upon payment of such fee, as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "No person exercising any power or dicharging any duty under this Act shall, knowingly, have any financial interest in any person who has been granted a consent or who has been registered, licensed or given written permission under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority grants consent to a private fund under section 8, it shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "enter the particulars relating to the private fund in the register maintained under section 4; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "issue a certificate to the private fund showing the date upon which consent was granted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority grants registration of a public fund under section 11, it shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "register the public fund in the register maintained under section 4; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "issue a certificate to the public fund showing the date of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority grants a provisional acceptance under section 11, the promoters of the proposed public fund shall within the period of three months referred to in subsection 11(3) deliver to the Authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the provisional acceptance of the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "proof satisfactory to the Authority that the proposed public fund is lawfully constituted in Labuan or any recognised country or jurisdiction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application fee required under subparagraph 10(b)(ii); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the information referred to in subparagraph 10(b)(iv)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "If the Authority is satisfied that the proposed public fund referred to in subsection 5(3) has complied with the requirements of that subsection it shall register the public fund and issue to it a certificate of registration in accordance with the procedure set out in subsection 5(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority grants a licence to a person or registration to an offshore company under section 14, it shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "enter the particulars of the person or the offshore company in the register maintained under section 4; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "issue a licence to the person or a certificate to the company showing the date on which the licence or registration was granted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Authority issues a written permission pursuant to subsection 3(2) or subsection 12(2), it shall enter in the register maintained under section 4 the particulars set out in subsection 4(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "No private fund shall carry on business or arrange or administer its affairs in or from within Labuan unless it has received a consent under section 8."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An application by a private fund for consent imder section 8 shall be made by letter to the Authority setting out the details of the scope and nature of its business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An application under subsection 7(1) shall be accompanied by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such application fee as may be prescribed by regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "proof satisfactory to the Authority that the applicant is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a private fund; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "lawfully constituted either under the laws of Malaysia relating to Labuan or under the laws of any recognised country or jurisdiction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the information required under section 21."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may grant or refuse to grant a consent"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to a private fund and may make a grant of consent subject to any terms, conditions, limitations or restrictions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "No public fund shall carry on business or arrange or administer its affairs in or from within Labuan unless it has been granted registration under paragraph 11(1)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The promoters for a proposed public fund to whom a provisional acceptance has been granted under paragraph 1 1 ( 1 )( b) shall not carry on business or arrange or administer its affairs without the prior written consent of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_56"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be liable to be sued in any court for any act or matter done or ordered to be done or omitted to be done by him in good faith and in the intended exercise of any power or discharge of any duty conferred or imposed on him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Where there is any conflict or inconsistency between"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act and any other written law, this Act shall prevail."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may, on the written recommendation"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of the Authority, direct that any of the provisions of this Act shall not apply, or apply with such modifications as may be specified in the direction, to any person or class of persons and may attach such conditions to or revoke such direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes a requirement of this Act commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person who commits an offence against this Act for which no penalty is expressly provided is liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a body, incorporated or unincorporated, to a fine not exceeding five million ringgit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, to a fine not exceeding two and a half million ringgit or to imprisonment for a period not exceeding three months or to both,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any express provision of this Act, a notice may be served personally or by ordinary or registered post."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A notice relating to mutual fund or the Exchange which is sent by ordinary or registered post shall be deemed to have been served on the person to whom it is addressed on the day succeeding the day on which the notice would have been received in the ordinary course of post if it is addressed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to the person's registered office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to its last known address; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to any person authorised by it to accept service of process."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person to whom there has been addressed a registered letter containing a notice under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is informed that there is a registered letter awaiting him at a post office but refuses or neglects to take delivery of that letter; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to accept delivery of that registered letter when tendered, the notice shall be deemed to have been served upon him on the date on which he was informed that the letter was awaiting him ot on which the letter was tendered tc him, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection 44(3) an affidavit by the officer in charge of a post office stating that to the best of his knowledge and belief—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "there has been delivered to the address appearing on a registered letter a post office notification informing the addressee that there is a registered letter awaiting him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_44__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "there has been tendered for delivery to the addressee a registered letter, shall until the contrary is proved, be evidence that the addressee has been so informed or that the registered letter has been tendered to him, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a private fund is granted consent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a public fund is granted registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a person is granted a licence to be a manager or is granted registration to be an administrator of a mutual fund, there shall be payable for the year such fee as may be prescribed by regulations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "On or before 31 March of every year following the year in which any consent, licence or registration is granted there shall be payable such annual fee as may be prescribed by regulations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "An unpaid annual fee may be sued for by the Authority by action as a civil debt and in addition the Authority may require, and the court may order, payment of a penalty for late payment up to an amount equivalent to twice the amount of the fee unpaid. Labuan Offshore Securities Industry"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "A person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "wilfully or recklessly makes a misrepresentation in any document or material or records required to be filed, supplied or delivered under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "makes any statement or gives any information required under this Act that he knows to be false or misleading;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly fails to disclose any fact or information required to be disclosed under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "being in charge of or having alone or with another or others possession of or control over any information, records, books or other documents referred to in subsection 27(1) refuses or wilfully neglects to comply with any lawful direction given under that section, commits an offence under this Act and shall be liable on conviction to a fine not exceeding one hundred thousand ringgit or to imprisonment for a period not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, with the consent of the Public Prosecutor, compound any offence committed by any person under this Act, by making a written offer to such person to compound the offence by paying to the Authority within such time as may be specified in the offer such sum of money as may be specified in the offer, which shall not exceed fifty per centum of the amount of the maximum fine to which that person would have been liable if he had been convicted of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection 47(1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer, or within such extended period as the Authority with and subject to the consent of the Public Prosecutor may grant, prosecution for the offence may be instituted at any time thereafter against the person to whom the offer was made. 40 Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection 47(1), and the sum of money stipulated in the offer duly paid, no prosecution shall thereafter be instituted in respect of such offence against the person to whom the offer to compound was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A prosecution under this Act shall not be instituted except by, or with the consent in writing of, the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "All fees and penalties paid to the Authority under this Act and all sums of money paid under section 47 shall be paid into and form part of the Fund established under section 29 of the Labuan Offshore Financial Services Authority Act 1996."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection 49(1), all fees paid under subsection 35(4) shall be paid into the fund of the Exchange and may be used in accordance with the provisions of the by-laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may make regulations for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing fees payable under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing forms of application to be used for the purpose of this Act and matters to be specified in such form;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "regulating the use of any names or any words or expressions in a name connected with mutual funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "designating mutual funds or a class or classes thereof as private funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "regulating the publication of advertisements offering the services of dealers in securities or offering securities for purchase or sale and the form or content of such advertisements;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "the preparation by dealers in securities of balance-sheet and profit and loss accounts and the form and content thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "the issue and content of a contract note;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "the dealing in securities for his own account directly or indirectly by a trading member or by any person who provides information relating to securities to members of the public or who may have access to information relating to such securities which is not publicised;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "regulating or prohibiting the sale of any security by a person who does not own such security;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "prohibiting the use of any manipulative and deceptive devices and contrivances in connection with the purchase or sale of securities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "all matters or things relating to the issue of securities or the valuation of assets by persons listed on the Exchange;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "all matters or things required or authorised by this Act to be prescribed or provided, or which are necessary or convenient to be prescribed or provided, for the carrying out of, or giving full effect to, the provisions of this Act and for its due administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may on the written recommendation of the Authority issue, by notification in the Gazette, a direction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prohibiting the formation of any mutual fund or class of mutual funds;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "directing any trustee, custodian, manager, administrator, fund, trading member or the Exchange to cease to carry on its business or part of its business either immediately or within such time as may be specified in the direction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "directing the Exchange to carry on any business or part of the business either immediately or within such time as may be specified in the direction; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "approving the admission of any securities into the Exchange or the listing thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "A direction made under this section may be revoked or varied by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection 52(2), the Minister may, whenever it appears to him necessary or expedient so to do whether for the purpose of removing difficulties or in consequence of the passing of this Act, by order make such modifications to any provision in any law relating to offshore securities as he may think fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall not exercise the power conferred under subsection 52(1) after the expiration of two years from the commencement of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "In the event that any act or step is required or"
      },
      "schema:text": {
        "@language": "en",
        "@value": "permitted to be done or taken under this Act and no form is prescribed or procedure laid down either in this Act or the regulations, application may be made to the Authority for directions as to the manner in which the same may be done or taken, and any act or step done or taken in accordance with such directions shall be a valid performance of such act or step."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Securities Commission Act 1993 and the Securities Industry Act 1983 shall not be applicable to the establishment, conduct, activity and business of the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 7(3), subsection 21(2), section 24, section 85, subsections 87(2), (4), (5) and (10) and subsections 93(2), (6) and (7) of the Offshore Companies Act 1990 shall not be applicable to the Exchange."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Holidays Act 1951 shall not apply to the Exchange and the Exchange may carry on its business for twenty-four hours in each day on any and all days of each week subject to any limitation or restriction imposed by or pursuant to the by-laws or the rules, as the case may be. Labuan Offshore Securities Industry"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, on the date of the coming into force of this Act, is carrying on any business or engaged in any activity relating to mutual funds in or from within Labuan shall within six months, or such longer period as the Authority may prescribe in writing, from such date comply with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The rules of equity and of common law applicable"
      },
      "schema:text": {
        "@language": "en",
        "@value": "to mutual funds shall continue in force, except so far as they are inconsistent with the express provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Labuan Offshore Securities Industry Act 1997 and shall come into force on such date as the Minister may, by notification in the Gazette, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint different dates for the coming into force of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
