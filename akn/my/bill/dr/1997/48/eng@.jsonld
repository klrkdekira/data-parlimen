        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "shares, debentures, funds, units, interests in a limited partnership or unit trust or company and bonds or notes of or issued by any body (incorporated or unincorporated), government, local government or public authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "certificates of interest or participation in, temporary or interim certificates for, receipts for or warrants to subscribe to or purchase any of such investments, shares, debentures, funds, units, interests, bonds or notes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "such other instruments or interests as may from time to time be prescribed by the Minister, on the written recommendation of the Authority, as being admissible for listing and trading on the Exchange; \"Securities Commission\" has the meaning assigned to it under the Securities Commission Act 1993; \"securities market\" means a stock market or a place at which, or a facility by means of which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9",
      "@type": "akn:list",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9",
      "schema:text": {
        "@language": "en",
        "@value": "offers to sell, purchase or exchange securities are regularly made or accepted; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_1__list_9",
      "schema:text": {
        "@language": "en",
        "@value": "information concerning the prices at which or the consideration for which particular persons or classes of persons propose to sell, purchase or exchange, or may reasonably be expected to sell, purchase or exchange, securities is regularly provided; \"trading member\" means a person admitted to membership of the Exchange and authorised to engage in the business of dealing in securities pursuant to the rules of the Exchange; \"trust company\" has the meaning assigned to it under the Labuan Trust Companies Act 1990; \"underwriter\" means a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A company incorporated or partnership formed or unit trust organised under the laws of Malaysia relating to Labuan for the purpose of carrying on business as a mutual fund or as a manager or an administrator of a mutual fund shall be deemed to be carrying on business in Labuan notwithstanding that such business is carried on wholly outside Labuan or outside Labuan from a place of business or registered office within Labuan and the expression \"carrying on business from within Labuan\" includes carrying on business outside Labuan from a place of business or a registered office within Labuan."
      }
    }
  ]
}
