      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tawaran untuk menjual, membeli atau bertukar sekuriti dibuat atau diterima dengan tetap; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat mengenai harga yang dengannya atau balasan yang baginya orang-orang atau golongan- golongan orang tertentu bercadang untuk menjual, membeli atau bertukar, atau dapat semunasabahnya dijangkakan akan menjual, membeli atau bertukar, sekuriti disediakan dengan tetap; \"pelabur\" ertinya seseorang yang mempunyai, atau mempunyai kepentingan dalam, saham yang dikeluarkan oleh suatu kumpulan wang bersama tetapi tidaklah termasuk penaja atau pengendali; \"penaja\" ertinya seseorang yang bertindak bersendirian atau bersama-sama dengan orang lain secara langsung atau tak langsung yang mengambil inisiatif dalam membentuk atau mengelolakan perniagaan suatu kumpulan wang bersama, tetapi tidaklah termasuk seorang penjaga atau seorang pengunderait yang menerima komisen pengunderaitan tanpa mengambil bahagian dalam penubuhan atau pengelolaan perniagaan kumpulan wang bersama itu; \"pengendali\", berkenaan dengan kumpulan wang bersama, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_6",
