      "schema:text": {
        "@language": "ms",
        "@value": "bagi mendapatkan balasan yang bernilai mengadakan perkhidmatan pengurusan semata- mata atau dengan nasihat pelaburan atau perkhidmatan pentadbiran berkenaan dengan sekuriti bagi maksud pelaburan termasuk berniaga sekuriti atau apa-apa kegiatan lain sebagaimana yang ditetapkan oleh Lembaga; atau"
      }
    },
