      "schema:text": {
        "@language": "ms",
        "@value": "jika kumpulan wang bersama itu ialah suatu perkongsian, seorang rakan am perkongsian itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_6__para_c",
