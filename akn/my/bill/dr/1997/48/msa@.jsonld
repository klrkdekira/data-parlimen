      "schema:text": {
        "@language": "ms",
        "@value": "sebagai prinsipal, bersetuju untuk membeli syer yang diterbitkan oleh suatu kumpulan wang bersama dengan tujuan untuk menawarkannya kepada orang awam; atau"
      }
    },
