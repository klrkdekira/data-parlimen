      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/48/msa@/~part_I__cl_2__subsec_1__list_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kumpulan wang bersama itu ialah suatu amanah saham, seorang pemegang amanah bagi amanah itu; \"pengunderait\" ertinya seorang yang—"
      }
    },
    {
