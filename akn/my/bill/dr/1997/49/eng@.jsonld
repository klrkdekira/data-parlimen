      "schema:name": {
        "@language": "en",
        "@value": "Inland Revenue Board of Malaysia (Amendment) (No. 2) Bill 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Inland Revenue Board of Malaysia (Amendment) (No. 2) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Inland Revenue Board of Malaysia Act 1995,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "which in this Act is referred to as the \"principal Act\", is amended in section 2 by inserting after the definition of \"Board\" the following definition: ' \"body\" means a body corporate;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_3__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "10 the following section: \" 10A. (1) Notwithstanding section 10, the Board Board may act as may act as a collection agent for and on behalf collection of any body for the recovery of loans due for agent. repayment to that body under any written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section the Minister may, from time to time, give directions and make regulations in relation to the collection of the repayments.\"."
      }
    }
  ]
