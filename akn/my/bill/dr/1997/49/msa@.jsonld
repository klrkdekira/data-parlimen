      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Lembaga Hasil Dalam Negeri Malaysia (Pindaan) (No. 2) 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Hasil Dalam Negeri Malaysia (Pindaan) (No. 2) 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Lembaga Hasil Dalam Negeri Malaysia 1995,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang disebut \"Akta ibu\" dalam Akta ini, adalah dipinda dalam seksyen 2 dengan memasukkan selepas takrif \"anggota\" takrif yang berikut: ' \"badan\" ertinya pertubuhan perbadanan;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/49/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 10 seksyen yang berikut: \" Lembaga 10A. (1) Walau apa pun seksyen 10, Lembaga boleh boleh bertindak sebagai ejen pemungutan untuk bertindak dan bagi pihak mana-mana badan untuk sebagai ejen ] mendapatkan pinjaman yang kena dibayar balik pemungu- kepada badan itu di bawah mana-mana undang- tan. undang bertulis. (2) Bagi maksud seksyen ini Menteri boleh, dari semasa ke semasa, memberikan arahan dan membuat peraturan berhubungan dengan pemungutan bayaran balik itu.\"."
      }
    }
  ]
