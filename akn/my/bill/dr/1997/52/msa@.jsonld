      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perindustrian Sekuriti (Depositori Pusat) (Pindaan) 1997"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 61 seksyen yang berikut: 61A. (1) Walau apa pun peruntukan mana-mana undang-undang bertulis lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil oleh atau terhadap Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil lain yang Suruhanjaya dikehendaki atau dibenarkan oleh mahkamah diwakili, atau didengari, atau selainnya berhak diwakili atau didengari, mana-mana pegawai yang diberi kuasa oleh Suruhanjaya bagi maksud itu, boleh, bagi pihak Suruhanjaya, memulakan prosiding itu atau hadir sebagai peguambela dalam prosiding itu dan boleh memasukkan segala kehadiran dan membuat segala permohonan dan melakukan segalaperbuatan berkenaan dengan prosiding itu bagi pihak Suruhanjaya. (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), \"pegawai\" mempunyai erti yang sama seperti dalam seksyen 2 Akta 498. Akta Suruhanjaya Sekuriti 1993.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perindustrian Sekuriti (Depositori Pusat) (Pindaan) 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri, melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Perindustrian Sekuriti (Depositori Pusat) 1991,"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "yang disebut \"Akta ibu\" dalam Akta ini,adalah dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"sekuriti\", dengan menggantikan perkataan \"dan apa-apa kepentingan sepertimana yang ditakrifkan dalam seksyen 84 Akta Syarikat 1965\" dengan perkataan \",apa-apa kepentingan sebagaimana yang ditakrifkan dalam seksyen 84 Akta Syarikat 1965 dan apa-apa kepentingan dalam skim amanah saham\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"sistem komputer\" takrif yang berikut: ' \"skim amanah saham\" mempunyai erti yang sama seperti yang diberikan kepada ungkapan itu di bawah seksyen Akta 498. 2 Akta Suruhanjaya Sekuriti 1993;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan subseksyen (5) dengan subseksyen yang berikut: \"(5) Jika sesuatu bursa saham telah menetapkan suatu sekuriti di bawah subseksyen (1) yang hendak- lah didepositkan dengan depositori pusat, penetapan itu hendaklah terpakai bagi penyenaraian tambahan sekuriti itu dan kesemua jenis lain sekuriti yang diterbitkan oleh penerbit yang sama bagi penyenaraian di bursa saham dan peruntukan subseksyen (1) dan (2) tidaklah terpakai berkenaan dengan penyenaraian tambahan itu dan penyenaraian jenis lain sekuriti itu.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta ibu adalah dipinda dalam subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(1) dengan menggantikan perkataan \"dan peruntukan- peruntukan seksyen ini,\" dengan perkataan \", peruntukan- peruntukan seksyen ini dan kaedah-kaedah depositori pusat,\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 34 Akta ibu adalah dipinda dalam subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(1) dengan menggantikan perkataan \"melalui notis bertulis, menghendaki suatu depositori pusat\" dengan perkataan \"mengikut cara yang ditetapkan oleh kaedah-kaedah depositori pusat menghendaki depositori pusat itu\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 35 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Walau apa pun peruntukan Akta 125 Akta Syarikat 1965, seseorang pendeposit mana-mana sekuriti telah- deposit yang namanya terdapat dalam (Pindaan) rekod pendeposit adalah berhak kepada segala hak, faedah, kuasa dan keistimewaan dan tertakluk kepada segala liabiliti, kewajipan dan obligasi yang berkenaan dengan, atau yang berbangkit daripada, sekuriti itu (sama ada yang diberikan atau dikenakan oleh Akta Syarikat 1965, atau memorandum atau perkara- perkara persatuan penerbit sekuriti itu, atau selainnya) seolah-olah dia ialah— (a) seorang anggota yang didaftarkan dalam daftar anggota; (b) seorang pemegang yang didaftarkan dalam daftar pemegang debentur yang di- senggarakan oleh penerbit itu; atau (c) seorang pemegang yang didaftarkan— (i) dalam daftar pemegang kepentingan yang diseng- garakan oleh suatu syarikat pengurusan di Akta 125. bawah Akta Syarikat 1965; atau (ii) dalam daftar pemegang unit yang diseng- garakan oleh suatu syarikat pengurusan di P.U (A) bawah Peraturan- 439/96. Peraturan Suruhanjaya Sekuriti (Skim Amanah Saham) 1996, dan bukannya depositori pusat itu, atau syarikat namaannya, yang atas namanya sekuriti telah-deposit itu didaftarkan.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: \"(2) Walau apa pun peruntukan subseksyen (1), tiada apa-apa jua dalam seksyen ini boleh ditafsirkan sebagai menyifatkan suatu rekod pendeposit sebagai— (a) suatu daftar anggota yang disenggarakan di bawah Akta 125. seksyen 158 Akta Syarikat 1965; (b) suatu daftar pemegang debentur yang disenggarakan Akta /25. di bawah seksyen 70 Akta Syarikat 1965; (c) suatu daftar pemegang kepentingan yang disenggarakan di bawah Akta 125. seksyen 92 Akta Syarikat 1965; atau (d) suatu daftar pemegang unit yang disenggarakan di bawah P.U (A) peraturan 34 Peraturan- 439/96. Peraturan Suruhanjaya Sekuriti (Skim Amanah Saham) 1996.\". (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 38 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Jika penerbit atau pembuat tawaran, berhubungan dengan mana-mana sekuriti telah deposit— (a) membuat suatu terbitan bonus, atau menerbitkan sekuriti-sekuriti di bawah suatu terbitan hak atau penukaran mana- mana sekuriti hutang; (b) menerbitkan sekuriti-sekuriti menurut penjalanan apa-apa hak atau opsyen untuk memperoleh sekuriti-sekuriti dalam modal syer penerbit itu; atau (c) membuat suatu tawaran bagi penjualan sekuriti-sekuriti, penerbit atau pembuat tawaran itu hendaklah memberitahu depositori pusat itu nama-nama penerima umpukan atau orang yang berhak bersama-sama dengan butir-butir yang dikehendaki oleh depositori pusat itu bagi maksud membuat catatan-catatan yang sesuai dalam akaun-akaun sekuriti penerima-penerima umpukan atau orang yang berhak, masing- masing, dan hendaklah menyerahkan kepada depositori pusat itu skrip-skrip yang berkenaan (dalam peringkat-peringkat nilai yang dinyatakan oleh depositori pusat itu) yang didaftarkan atas nama depositori pusat itu atau syarikat namaannya.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(3) Bagi maksud seksyen ini— (a) \"orang yang berhak\" ertinya orang yang telah diumpukkan sekuriti oleh pembuat tawaran dalam tawaran bagi penjualan; dan (b) \"pembuat tawaran\", berhubungan dengan mana-mana sekuriti, ertinya tuan punya sekuriti itu.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Bahagian III Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas seksyen 41 seksyen yang berikut: 4lA. Tiada notis apa-apa amanah yang, nyata, tersirat atau konstruktif, boleh diterima oleh depositori pusat dan depositori pusat atau apa-apa jua yang dilakukan oleh depositori pusat berhubungan dengan sekuriti telah-deposit tidaklah terjejas oleh notis apa-apa amanah itu.\""
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1997/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 61 Akta ibu adalah dipinda dengan mengganti-"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "kan subseksyen (2) dengan subseksyen yang berikut: \"(2) Mana-mana pegawai boleh, jika dia diberi kuasa secara bertulis oleh Pendakwa Raya, mendakwa apa-apa kes berkenaan dengan apa-apa kesalahan yang dilakukan di bawah Akta ini.\"."
      }
    }
  ]
}
