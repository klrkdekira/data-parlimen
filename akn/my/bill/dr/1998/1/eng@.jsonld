      ],
      "schema:name": {
        "@language": "en",
        "@value": "Printing of Qur'anic Texts Bill 1986"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Printing of Qur'anic Texts (Amendment) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on a date to be appointed by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Printing of Qur'anic Texts Act 1986, which in"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act is referred to as the \"principal Act\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_1__para_a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"document\" the following definition: ' \"document\" means any matter expressed, described, or howsoever represented, upon any substance, material, thing or article, including any matter embodied in a disc, tape, film, sound track or other device whatsoever, by means of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "letters, figures, marks, symbols, signals, signs, or other forms of expression, description, or representation what- soever; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any visual recording (whether of still or moving images);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any sound recording, or any electronic, magnetic, mechanical or other recording whatsoever and howsoever made, or any sounds, electronic impulses, or other data whatsoever;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a recording, or transmission, over a distance of any matter by any, or any combination, of the means mentioned in paragraph (a), (b) or (c). or by more than one of the means mentioned in paragraphs (a), (b), (c) and (d), intended to be used or which may be used for the purpose of expressing, describing, or howsoever representing, that matter;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_3__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"Qur'anic text\" by substituting for the words \"which may appropriately be called the Mushaf of the Qur'an\" the words \"or any part thereof which contains one juzu' or more with or without translation, or interpretation, as the case may be\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2) by substituting for the words \"Islamic Religious Affairs Division\" the words \"Department of Islamic Development Malaysia\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (8) by substituting for the word \"nine\" the word \"seven\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_4__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 6(1) of the principal Act is amended—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(a) by inserting after the words \"final proof wherever appearing therein the words \"or original copy\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"the Qur'anic text\" the words \", as the case may be,\". Printing of Qur'anic Texts (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 8 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for subsection (1) the following subsection: \"(1) Every Qur'anic text which is printed or published in Malaysia or imported into Malaysia shall bear conspicuously on the first or last printed leaf thereof, or in the case of a recorded text, at a conspicuous part of the text, the following information: (a) the name and address of its printer and publisher, or in the case of a recorded text, the person responsible for the making of the recording and publication of the recorded text; (b) in the case of an imported Qur'anic text, the name and address of its importer; (c) the address of the place where it was printed, recorded or published; (d) a statement to the effect that the Qur' anic Verses contained in the text have been certified to be correct by the Lembaga in accordance with section 6 or 7; and (e) the reference number of the relevant certificate.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 12(3) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the words \"or last leaf thereof the words \"or last printed leaf thereof or, in the case of a recorded text, at a conspicuous part of the text\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 13(1) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the words \"or last leaf thereof the words \"or last printed leaf thereof or, in the case of a recorded text, at a conspicuous part of the text,\"."
      }
    }
  ]
}
