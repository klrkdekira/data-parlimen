      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Ahli Kimia (Pindaan) 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Kimia"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(Pindaan) 1998 dan hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Ahli Kimia 1975, yang disebut \"Akta ibu\" dalam"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini, adalah dipinda dalam teks bahasa kebangsaan dengan menggantikan perkataan \"Institiut\" di mana-mana jua terdapat dengan perkataan \"Institut\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 11 seksyen yang berikut: \"Anggota 11 A. Tiada seorang pun boleh menjadi anggota Majlis. Majlis, atau mana-mana Jawatankuasa, bagi Jawatan- kuasa. Institut atau sesuatu jawatankuasa bagi mana- dsb. mana cawangan Institut melainkan jika dia mestilah seorang warganegara.\". warga- negara. 2 Rang Undang-Undang"
      }
    }
  ]
