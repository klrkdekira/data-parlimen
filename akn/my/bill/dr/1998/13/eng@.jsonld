      ],
      "schema:name": {
        "@language": "en",
        "@value": "Tourism Industry (Amendment) Bill 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Tourism Industry (Amendment) Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Tourism Industry Act 1992, which in this Act is"
      },
      "schema:text": {
        "@language": "en",
        "@value": "referred to as the \"principal Act\", is amended in section 16 by inserting after subsection (2) the following subsection: \"(3) For all outbound tour packages, the licensed tour operator shall— (a) purchase insurance policy; or (b) cause a deposit in the form of cash or bank guarantee to be made to the Commissioner, as the case may be, as directed by the Commissioner.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 34(2) of the principal Act is amended— Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (c) the following paragraph: \"(ca) the purchase of insurance policy by the licensed tour operator, or the making of a deposit in the form of cash or bank guarantee to the Commissioner;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"the qualification of the instructors,\" in paragraph (f) the words \"the granting of permits by the Commissioner for lecturers and instructors, the qualifications of lecturers and instructors,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"to be maintained by them\" in paragraph (i) the words \"and the granting of exemptions by the Commissioner to any tourism enterprise or tourist guide from any requirement imposed by regulations made under this paragraph\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 25 of the principal Act is amended by of section 25. substituting for the words \"twelve months\" the words \"not exceeding three years\". Amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 40(1) of the principal Act is amended by of section 40. deleting the words \"or officer of the Malaysia Tourism Promotion Board\"."
      }
    }
  ]
}
