      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorized of a sum not exceeding four hundred million ringgit (RM400,000,000) from the Consolidated Fund for expenditure on the services specified in the Schedule for the service of the year 1998, not provided for or not fully provided for by the Supply Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/eng@/~cl_2__subsec_2",
