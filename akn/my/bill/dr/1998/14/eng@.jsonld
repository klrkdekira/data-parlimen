      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purpose specified in the Schedule. 2 Bill"
      }
    },
