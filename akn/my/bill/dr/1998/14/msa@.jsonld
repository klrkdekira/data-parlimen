    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan sejumlah wang yang tidak melebihi empat ratus juta ringgit (RM400,000,000) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan yang dinyatakan dalam Jadual bagi perkhidmatan tahun 1998, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1998. 2 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah wang yang tersebut itu adalah diper- untukkan bagi maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 2) Maksud Tajuk Peruntukan kepada Maksud (RM) B. 29 Perkhidmatan Am Perbendaharaan 400,000,000 JUMLAH 400,000,000"
      }
    }
