      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"di bawah\" perkataan \"Akta ini atau\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/19/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
