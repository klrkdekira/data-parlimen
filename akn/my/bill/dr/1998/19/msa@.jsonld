      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/19/msa@/~cl_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/19/msa@/~cl_6__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/19/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/19/msa@/~cl_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
