      ],
      "schema:name": {
        "@language": "en",
        "@value": "Teachers' Superannuation Fund (Sabah) (Dissolution) Bill 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, where an eligible person to whom any payment could be made under subsection 9(1) is deceased or dies before the payment is made, the amount remaining unpaid may be paid to his dependants without probate or letters of administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where there are more than one dependant to whom payment may be made under subsection (1), the payment shall be made in equal amounts to the dependants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is no dependant, the amount payable under subsection (1) shall become part of the deceased eligible person's estate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "\"child\" in relation to a deceased eligible person means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a child who is under twenty-one years of age of the eligible person and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "a posthumous child, a dependant step-child and an illegitimate child of the eligible person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "a child adopted by the eligible person under any written law relating to adoption or under any custom or usage, on satisfactory proof of such adoption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a child of any age who is mentally retarded or physically and permanently incapacitated and is incapable of supporting himself provided that such child is mentally retarded or physically and permanently incapacitated before the child reaches the age of twenty-one years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "\"dependant\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a widow of a deceased eligible person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a widower of a deceased eligible person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a child of a deceased eligible person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_10__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the mother of a deceased eligible person or if his mother is not living, his dependant father."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Where payment is made in good faith under section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "9 or 10 and in accordance with the provisions of this"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "such payment shall constitute a full and proper discharge of all the liability of the Government under the Ordinance and this Act and no eligible person shall be entitled to any further payment thereafter; and (Sabah) (Dissolution)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "no action, suit or proceedings calling such payment in question or the payment of any other amount shall be brought or shall lie against the Government or any of its officers or servants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The repeal of the Ordinance shall not affect any person's liability to be prosecuted or punished for offences committed under the Ordinance before the appointed date, or any proceedings brought or sentence imposed before that date in respect of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings (whether civil or criminal) or cause of action pending or existing immediately before the appointed date by or against the Board or any person or body acting on its behalf may be continued or instituted by or against the Government as it might have been continued or instituted by or against the Board or such person or body as if this Act had not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought, or any leave to appeal applied for, on or after the appointed date, against a decision given before the appointed date in any legal proceedings to which the Board or any person or body acting on its behalf was a party may be brought by or against the Government as it might have been brought by or against the Board as if this Act had not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "If any difficulty or anomaly arises in connection with the implementation of this Act, the Minister may by order make such modifications to any provision of this Act as may appear to him to be necessary for removing or preventing such difficulty or anomaly: Provided that the Minister shall not exercise the powers conferred by this section after the expiration of three years from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"modifications\" amendments, additions, deletions, substitutions, adaptations, variations, alteration and non-application of any provision of this Act. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All regulations made under section 18 of the Teachers'"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Superannuation Ordinance 1963 (Sabah) shall cease to have effect on the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Teachers' Superannuation Fund (Sabah) (Dissolution) Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into force on a date to be appointed by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"appointed date\" means the date appointed by the Minister under section 1; \"Board\" means the Board of Management established under subsection 4(1) of the Ordinance; \"eligible person\" means a person entitled to a superannuation allowance, a gratuity, a pension or any other retirement benefit under the Ordinance; \"Fund\" means the Teachers' Superannuation Fund established under section 3 of the Ordinance; \"Government\" means the Federal Government; \"Minister\" means the Minister charged with the responsibility for finance; \"Ordinance\" means the Teachers' Superannuation Ordinance 1963 (Sabah); \"pension\" means an annual superannuation allowance payable under section 7 of the Ordinance, and includes any gratuity, pension, or other retirement benefit payable under the Ordinance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Ordinance is repealed and the Board and the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Fund established thereunder are dissolved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All powers, rights, privileges, duties, liabilities and"
      },
      "schema:text": {
        "@language": "en",
        "@value": "obligations which immediately before the appointed date were those of the Board shall, as from that date, devolve on the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All immovable property and assets which immediately"
      },
      "schema:text": {
        "@language": "en",
        "@value": "before the appointed date were vested in the Fund or in any person or body acting on its behalf shall, on the appointed date, vest in the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All moneys standing in, or due to be paid to, the Fund"
      },
      "schema:text": {
        "@language": "en",
        "@value": "shall, on the appointed date, be transferred to, and vest in the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "All deeds, bonds, agreements, instruments and working"
      },
      "schema:text": {
        "@language": "en",
        "@value": "arrangements subsisting immediately before the appointed date and affecting any of the property and moneys transferred under sections 5 and 6 shall be of full force and effect against or in favour of the Government and enforceable as fully and effectually as if, instead of the Board or the Fund, or any person or body acting on its behalf, the Government had been named therein or had been a party thereto."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The State Treasurer of Sabah shall be the officer"
      },
      "schema:text": {
        "@language": "en",
        "@value": "responsible for effecting the payment of the amounts provided for in section 9. (Sabah) (Dissolution)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A person who was, on 15 February 1983, an eligible person shall be paid the amount as recommended in the actuary's report dated 30 August 1996 and any subsequent revision thereof made by the actuary and an additional forty per cent of that amount."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The lump sum amount to be paid under subsection (1) shall be paid out of the moneys referred to in section 6 and, if such moneys are insufficient for such purpose, the property and assets referred to in section 5."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/2/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"actuary\" means the actuary appointed under the Ordinance by the Board for the purpose of determining the amount to be paid under this Act."
      }
    }
  ]
}
