      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kebankrapan (Pindaan) 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kebankrapan (Pindaan) 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Kebankrapan 1967, yang disebut \"Akta ibu\""
      },
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Akta ini, adalah dipinda dalam seksyen 33—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotbng subseksyen (11); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan memasukkan selepas perkataan \"bankrupt\" perkataan \"by order of court\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/20/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ibu adalah dipinda dengan memasukkan selepas"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 33 seksyen yang berikut: Discharge 33A. (1) The Official Assignee may, in his of discretion but subject to section 33B, issue a bankrupt by certificate discharging a bankrupt from Certificate bankruptcy. of Official Assignee. KERTAS PEMBERITAHU Notis Tentang Pindaan Kepada RANG UNDANG-UNDANG KEBANKRAPAN (PINDAAN) 1998 (D.R. 20/98) Pindaan yang akan dicadangkan dalam Jawatankuasa oleh Y.B. Timbalan Menteri di Jabatan Perdana Menteri Pindaan Kepada Teks Bahasa Kebangsaan Fasal 3 Rang Undang-Undang adalah dipinda dengan menggantikan subseksyen 33A (2) yang dicadangkan dengan subseksyen yang berikut: \"(2) The Official Assignee shall not issue a certificate discharging a bankrupt from bankruptcy under subsection (1) unless a period of five years has lapsed since the date the receiving order and the order by which he was adjudged bankrupt were made.\""
      }
    }
  ]
