      "schema:text": {
        "@language": "en",
        "@value": "FRANCHISE AGREEMENT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise agreement shall be in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise agreement shall contain but is not limited to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the name and description of the product and business under the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the territorial rights granted to the franchisee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the franchise fee, promotion fee, royalty or any related type of payment which may be imposed on the franchisee, if any;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the obligations of the franchisor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the obligations of the franchisee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisee's rights to use the mark or any other intellectual property, pending the registration or after the registration of the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions under which the franchisee may assign the rights under the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a statement on the cooling off period as provided in subsection (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a description pertaining to the mark or any other intellectual property owned or related to the franchisor which is used in the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if the agreement is related to a master franchisee, the franchisor's identity and the rights obtained by the master franchisee from the franchisor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the type and particulars of assistance provided by the franchisor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the duration of the franchise and the terms of renewal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the effect of termination or expiration of the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Failure to comply with subsection (2) shall render a franchise agreement null and void."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise agreement shall have a cooling off period, which shall be determined by both contracting parties but shall not be less than seven working days, during which the franchisee has the option to terminate the agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Upon termination of the franchise agreement under subsection (4), an amount to cover the reasonable expenses incurred by the franchisor to prepare the agreement may be retained by the franchisor from the initial fees paid under section 19; however, all other monies shall be refunded to the franchisee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with subsection (5) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "If a franchisor requires that a franchisee makes a"
      },
      "schema:text": {
        "@language": "en",
        "@value": "payment before signing a franchise agreement, including a payment which is part of a franchise fee, the franchisor shall state in writing the purpose for the payment and the conditions for the use and refund of the monies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "It shall be an unfair franchise and a contravention of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "this Act for any franchisor to unreasonably and materially discriminate between franchisees operating a franchise in the charges offered or made for franchise fees, royalties, goods, services, equipment, rentals or advertising services if such discrimination will cause competitive harm to a franchisee who competes with a franchisee who receives the benefit of the discrimination, unless and to the extent that any classification of or discrimination between franchisees is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "based on franchises granted at different times, and such discrimination is reasonably related to the differences in time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "related to one or more programmes for making franchises available to persons with insufficient capital, training, business experience or education, or lacking other qualifications;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "related to efforts by the Government or any of its agencies to promote variation in products or service lines or business formats or designs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "related to efforts by one or more franchisees to cure deficiencies in the operation of franchised businesses or defaults in franchise agreements; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "based on other reasonable distinctions considering the purposes of this Act and is not arbitrary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "If a franchisee is required to pay any franchise fees"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or royalty to a franchisor, the rate of franchise fees or royalty shall be the rate as provided in the disclosure documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor who requires a franchisee to make any payment for the purpose of the promotion of a franchise shall establish a Promotion Fund (\"Fund\")."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be managed under a separate account and shall only be used for the promotion of the product under the franchise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "If a franchisee is required to make any payment under section 23, the franchisor shall submit a financial statement of the Fund, which has been endorsed by a registered public accountant, to the Registrar within thirty days after the conclusion of the last financial term."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The financial statement in subsection (3) shall be submitted to the Registrar together with the annual report under section 16."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with this section commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "If a franchisee is required to make any payment for promotional purposes or pay promotion fees to the franchisor, the payment shall be at the rate as provided in the disclosure documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The payment required to be made under subsection (1) shall be deposited into the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_24__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor is required to register his trade mark or service mark relevant to his franchise in accordance with the Trade Marks Act 1976 (if they are registrable under the Act) before applying for the registration of the franchise under section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise term shall not be less than five years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisee shall give a written guarantee to a franchisor that the franchisee and his employees shall not disclose to any person any information contained in the operation manual or obtained while undergoing training organized by the franchisor during the franchise term and for two years after the expiration or earlier termination of the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The franchisee and his employees shall comply with the terms of the written guarantee given under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with subsection (J) or (2) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisee shall give a written guarantee to a franchisor that the franchisee and his employees shall not carry on any other business similar to the franchised business operated by the franchisee during the franchise term and for two years after the expiration or earlier termination of the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The franchisee and his employees shall comply with the terms of the written guarantee given under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with subsection (1) or (2) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any condition, stipulation or provision in a franchise agreement purporting to bind a franchisee to waive compliance with any provision of this Act is void."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_III__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not prevent any person from entering into a settlement agreement or executing a general release regarding a potential or actual civil action filed in respect of the franchise nor shall it prevent the arbitration of any claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The registration of a franchise shall continue to be"
      },
      "schema:text": {
        "@language": "en",
        "@value": "effective unless the Registrar issues an order made by written notice to the applicant or the franchisor to suspend, terminate, prohibit or deny the sale or registration of the franchise under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "If there is any material change in the disclosure documents mentioned in paragraphs 7( 1 ) ( a) and (f), the applicant or his director or manager shall amend the documents according to the prescribed form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The documents in subsection (1) shall be filed with the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may, at any time, require additional information on the amendments made under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 13, if the Registrar proposes to suspend, terminate, prohibit or deny the sale or registration of a franchise, he shall give the applicant or the franchisor written notice of his intention to do so, specifying the nature of the proposed action and the grounds on which he proposes to take such action, and he shall give the applicant or the franchisor an opportunity to make a written representation on the matter within fourteen days from the date of service of the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "After the expiry of the period of fourteen days mentioned in subsection (1) and after considering any representation made by the applicant or franchisor under that subsection, the Registrar shall decide whether to proceed with the proposed action or to take no further action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall give the applicant or franchisor written notice of his decision under subsection (2) and the decision shall take effect from the date on which the written notice is served on the applicant or franchisor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor may, at any time after the franchise term, apply to the Registrar for cancellation of the registration of the franchise from the register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall accordingly cancel the registration of the franchise from the register if he is satisfied that the franchisor is no longer granting rights under the franchise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise broker shall register himself with the Registrar in the following manner:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by using the prescribed application form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by filing with the Registrar any information, which shall be determined by the Registrar, in respect of any representative or agent appointed by the franchise broker."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The franchise broker must meet all the requirements as prescribed on the qualifications of a franchise broker before he can be registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may impose conditions on the registration of a franchise broker."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The conditions in subsection (3) may include conditions governing the sale of a franchise by a franchise broker and conditions on the conduct, suspension, termination, prohibition or denial of registration of a franchise broker."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The registration under this section shall be effective for one year from the date of registration, unless determined otherwise by the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions relating to confidential information and the prohibition on carrying on a similar business in sections 26 and 27 are also applicable to a franchise broker."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor shall submit to a franchisee a copy of the franchise agreement and disclosure documents at least ten days before the franchisee signs the agreement with the franchisor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The disclosure documents in subsection (1) shall be the same documents submitted to the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with this section commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Annually the franchisor shall, within thirty days from the anniversary date of the registration, submit a report to the Registrar in the prescribed form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The report shall contain the disclosure documents which have been updated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may review the report and disclosure documents and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "notify the franchisor if any additional information or modification of the disclosure documents is to be included or deleted; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "issue an order to suspend, terminate, prohibit or deny the sale or registration of the franchise in the public interest or for the purpose of protecting prospective franchisees until any deficiencies specified by the Registrar have been corrected."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is aggrieved by any decision of the Registrar under this Part may appeal to the Minister in the prescribed manner within one month from the date the decision is communicated to the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister's decision on the appeal shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint a public officer as a Registrar of Franchises and such number of Deputy Registrars of Franchises, Assistant Registrars of Franchises and other officers as may be necessary for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall, subject to the general direction and control of the Minister, perform the duties imposed and exercise the powers conferred on him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Registrar, Assistant Registrars and other officers appointed under subsection (1) shall be under the direction and control of the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Registrar may perform all the duties and exercise all the powers conferred upon the Registrar under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar or Deputy Registrar may perform all the duties imposed and exercise all the powers conferred upon an Assistant Registrar under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All officers appointed under this section shall be deemed to be public servants within the meaning of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor shall register his franchise with the Registrar before he can make an offer to sell the franchise to any person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with this section commits an offence unless he has been exempted by the Minister under section 58 from the requirement to register under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor shall make an application to register his franchise by submitting to the Registrar the application in the prescribed form together with—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the complete disclosure documents with all the necessary particulars filled in;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a sample of the franchise agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the operation manual of the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the training manual of the franchise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a copy of the latest audited accounts, financial statements, and the reports, if any, of the auditors and directors of the applicant; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such other additional information or documents as may be required by the Registrar for the purpose of determining the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "At any time after receiving an application and before it is determined, the Registrar may, by written notice, require the applicant, or the director or manager of the applicant, to provide additional information or documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The matters specified under paragraph (1)(f) or the requirements under subsection (2) may differ as between different applicants, or different classes, categories or descriptions of applicants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An application under this section may be withdrawn at any time before it is approved or refused."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If any additional information or document required under subsection (2) is not provided by the applicant or his director or manager within the time specified in the requirement or any extension of time granted by the Registrar, the application shall be deemed to have been withdrawn and shall not be further proceeded with, but without affecting any fresh application being made by the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A person who submits false or misleading information or documents under this section commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application for registration together with the information or documents required under section 7, the Registrar may approve or refuse the application, and shall give the reason for the refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An application for registration which is approved under this section may be subject to such conditions as the Registrar may impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Upon approving an application under subsection (1), the Registrar may require the applicant to pay such amount of fees as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall give the applicant a written notice of his decision under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "If the registration of a franchise is approved under"
      },
      "schema:text": {
        "@language": "en",
        "@value": "section 8, the registration shall be effective on the date stated in the written notice given by the Registrar and such date shall be after the date of the filing of all required information or documents unless, prior to it, one of the following events has taken place:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar has notified the applicant that the applicant has failed to comply with the requirements of section 6 and subsections 7(1), (2) and (3); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar has issued an order under section 10 or paragraph \\6(3)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CONDUCT OF PARTIES AND TERMINATION OF FRANCHISE AGREEMENT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor and a franchisee shall act in an honest and lawful manner and shall endeavour to pursue the best franchise business practice of the time and place."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor and a franchisee in their dealings with one another shall avoid the following conduct:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "substantial and unreasonable overvaluation of fees and prices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "conduct which is unnecessary and unreasonable in relation to the risks to be incurred by one party; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "conduct that is not reasonably necessary for the protection of the legitimate business interests of the franchisor, franchisee or franchise system."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor shall give a written notice about a breach of contract by a franchisee and allow the franchisee time to remedy the breach."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisee shall pay the franchise fees, royalty, promotion fees or any other payment as provided in the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor shall provide assistance to a franchisee to operate his business, such as the provision or supply of materials and services, training, marketing, and business or technical assistance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A franchisor and a franchisee shall protect the consumer's interests at all times."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "No franchisor shall terminate a franchise agreement before the expiration date except for good cause as provided in subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "\"Good cause\" shall include, but is not limited to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the failure of a franchisee to comply with any terms of the franchise agreement or any other relevant agreement entered into between the franchisor and franchisee; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the failure of the franchisee to remedy the breach committed by him or any of his employees within the period stated in a written notice given by the franchisor, which shall not be less than fourteen days, for the breach to be remedied."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "\"Good cause\" shall include, but without the requirement of notice and an opportunity to remedy the breach, circumstances in which the franchisee—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "makes an assignment of the franchise rights for the benefit of creditors or a similar disposition of the assets of the franchise to any other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "voluntarily abandons the franchised business;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is convicted of a criminal offence which substantially impairs the goodwill associated with the franchisor's mark or other intellectual property; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "repeatedly fails to comply with the terms of the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "A franchisor commits an offence if he refuses to"
      },
      "schema:text": {
        "@language": "en",
        "@value": "renew a franchise agreement or extend a franchise term without compensating a franchisee either by a repurchase or by other means at a price to be agreed to between the franchisor and the franchisee after considering the diminution in the value of the franchised business caused by the expiration of the franchise where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisee is barred by the franchise agreement, or by the refusal of the franchisor at least six months before the expiration date of the franchise agreement to waive any portion of the franchise agreement which prohibits the franchisee, from continuing to conduct substantially the same business under another mark in the same area subsequent to the expiration of the franchise agreement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisee has not been given a written notice of the franchisor's intent not to renew the franchise agreement at least six months prior to the expiration date of the franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 25, a franchise term may be terminated before the expiry of the minimum term of five years in the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where both parties to the franchise agreement agree to a termination; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where the court has decided that there are certain conditions in the franchise agreement which merit the agreement to be terminated earlier than the minimum term."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "At any time before the expiration of the franchise term, a franchisee shall at his option give written notice to the franchisor to extend the franchise term."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Except when a franchisee has breached the terms of a previous franchise agreement, a franchisor shall extend the franchise term to another period if the franchisee has applied for the extension of term under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A franchise agreement which franchise term has been extended shall contain conditions which are similar or not less favourable than the conditions in the previous franchise agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Franchise Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies throughout Malaysia to the sale of any franchise in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The sale of a franchise is deemed to be in Malaysia where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an offer to sell or buy a franchise—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "is made in Malaysia and accepted within or outside Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "is made outside Malaysia and accepted within Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the franchised business is operated or will be operating in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall affect the provisions of any other written laws, but if there is any conflict between the provisions of this Act and the provisions of the other written laws, the provisions of this Act shall prevail."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"advertisement\" means any publication, circular, notice, or any oral or written communication, whether broadcasted by electronic or any other publishing media, or any form of electronic communications to the public for the purpose of offering the sale of a franchise or promoting the sale of a franchise; \"authorised officer\" means an officer authorised in writing by the Minister under section 42 to exercise the powers of enforcement under this Act; \"disclosure documents\" means such disclosure documents as may be prescribed by the Minister; \"franchise\" means a contract or an agreement, either expressed or implied, whether oral or written, between two or more persons by which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisor grants to the franchisee the right to operate a business according to the franchise system as determined by the franchisor during a term to be determined by the franchisor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisor grants to the the franchisee the right to use a mark, or a trade secret, or any confidential information or intellectual property, owned by the franchisor or relating to the franchisor, and includes a situation where the franchisor, who is the registered user of, or is licensed by another person to use, any intellectual property, grants such right that he possesses to permit the franchisee to use the intellectual property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisor possesses the right to administer continuous control during the franchise term over the franchisee's business operations in accordance with the franchise system; Franchise 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisor has the responsibility to provide assistance to the franchisee to operate his business including such assistance as the provision or supply of materials and services, training, marketing, and business or technical assistance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in return for the grant of rights, the franchisee may be required to pay a fee or other form of consideration; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the franchisee operates the business separately from the franchisor, and the relationship of the franchisee with the franchisor shall not at anytime be regarded as a partnership, service contract or agency; \"franchise agreement\" means a contract or an agreement made between a franchisor and a franchisee in respect of a franchise in return for any form of consideration but does not include any contract or agreement made for the purpose of direct selling as provided by the Direct Sales Act 1993; \"master franchisee\" means a person who has been granted rights by a franchisor to sub-franchise to another person, at his own expense, the franchise of the franchisor; \"Minister\" means the Minister for the time being charged with the responsibility for matters relating to franchises; \"person\" includes a natural person, corporation, partnership, association, firm, joint venture or trust; \"prescribed\" means prescribed by regulations made under this Act; \"Registrar\", \"Deputy Registrar\" and \"Assistant Registrar\" mean respectively the Registrar of Franchises, a Deputy Registrar of Franchises and an Assistant Registrar of Franchises appointed under section 5; \"regulations\" means regulations made under this Act; \"this Act\" includes any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FRANCHISE ADVISORY BOARD"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES AND PENALTIES"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_52"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_61"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "A franchisor who intends to sell a franchise to a"
      },
      "schema:text": {
        "@language": "en",
        "@value": "person who is not a Malaysian citizen shall obtain the approval of, and be subject to the conditions which may be imposed by, the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign person who intends to sell a franchise in Malaysia or to any Malaysian citizen shall submit an application to the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may approve or refuse an application under subsection (1) without giving any reason for the refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "An application which is approved under this section may be subject to such conditions as the Registrar may impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 6, a franchisee of a foreign franchisor shall register his franchise with the Registrar by using the prescribed application form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may impose conditions on the registration of a franchisee referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "The Registrar may allow the public inspection of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "any disclosure documents filed with the Registrar unless, in his opinion, the inspection may bring harm to a franchisor or franchisee or any person involved in the franchised business related to the inspection or the inspection is not necessary or appropriate in the public interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "A person who wishes to publish, distribute or use any advertisement offering to sell or to buy a franchise under this Act shall file with the Registrar one original copy of the advertisement at least five days before the first publication, distribution or use of the advertisement or such shorter period as may be approved by the Registrar, or unless the advertisement has been exempted from this section by the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may, by order, prohibit the use of any advertising deemed to be false, fraudulent, misleading or deceptive."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with subsection (1) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette,"
      },
      "schema:text": {
        "@language": "en",
        "@value": "exempt, subject to such conditions as he deems fit to impose, any person or class of persons or business or industry from all or any of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "No action or prosecution shall be brought, instituted"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar, Deputy Registrar, Assistant Registrar or any officer or person duly authorised under this Act for or on account of or in respect of any act ordered or done for the purpose of carrying into effect this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "any other person for or on account of or in respect of any act done or purported to be done by him under the order, direction or instruction of the Minister, Registrar, Deputy Registrar, Assistant Registrar, or any officer or person duly authorised under this Act if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served by it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for all or any of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the forms, procedure and other requirements for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the form and content of disclosure documents;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the fees or charges to be paid to the Registrar in respect of the registration of a franchise and the manner for collecting and disbursing such fees or charges;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure for appeal under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure and requirements for the registration of any franchise granted or sold in or outside Malaysia by a franchisor or a franchise broker before the commencement of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the remuneration for the services of the Franchise Advisory Board; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "providing for such other matters as are contemplated by, or necessary for giving full effect to, the provisions of this Act and for their due administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under subsection (1) may prescribe any act in contravention of the regulations to be an offence and may prescribe penalties of a fine not exceeding ten thousand ringgit or imprisonment for a term not exceeding five years or both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "A franchisor or a franchise broker who has granted"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or sold in or outside Malaysia a franchise to a franchisee before the commencement of this Act shall, not later than twelve months from the commencement, register his franchise with the Registrar in accordance with the prescribed procedure and requirements under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in writing, authorise the Registrar or any Deputy Registrar, Assistant Registrar or public officer to exercise the powers of enforcement under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising any of the powers of enforcement under this Act, an authorised officer shall on demand produce to the person against whom he is acting the authority card signed by the Minister and issued to him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "An authorised officer may investigate the activities of a franchisor, franchise broker or franchisee for the purpose of determining whether he is complying with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), the authorised officer may issue orders to a franchisor, franchise broker or franchisee to further his investigation and secure compliance with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "In addition to his powers under subsections (1) and (2), in any case relating to the commission of an offence under this Act, an authorised officer carrying on an investigation may exercise all or any of the powers in relation to police investigation in seizable cases given by the Criminal Procedure Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath and after such inquiry as he considers necessary, that there is reasonable cause to believe that an offence under this Act is being or has been committed on any premises, the Magistrate may issue a warrant authorising any authorised officer named therein, to enter the premises at any reasonable time by day or by night, with or without assistance and if need be by force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An authorised officer may, in the premises entered under subsection (1), search and seize—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "copies of any books, accounts or other documents, including computerised data, which contain or are reasonably suspected to contain information as to any offence so suspected to have been committed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any mark, signboard, card, letter, pamphlet or other device or thing representing or implying that the person is a franchisor, franchise broker or franchisee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other document or item that is reasonably believed to furnish evidence of the commission of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An authorised officer conducting a search under subsection (1) may, if in his opinion it is reasonably necessary to do so for the purpose of investigating into the offence, search any person who is in or on such premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An authorised officer making a search of a person under subsection (3) may seize, detain or take possession of any book, accounts, document, computerised data, mark, card, letter, pamphlet, device or thing found on such person for the purpose of the investigation being carried out by such officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where, by reason of its nature, size or amount, it is not practicable to remove any book, accounts, document, computerised data, mark, signboard, card, letter, pamphlet, device or thing seized under this section, the seizing officer shall, by any means, seal such book, accounts, document, computerised data, mark, signboard, card, letter, pamphlet, device or thing in the premises or container in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (5) or removes any book, accounts, document, computerised data, mark, signboard, card, letter, pamphlet, device or thing under seal or attempts to do so commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "If an authorised officer in any of the circumstances"
      },
      "schema:text": {
        "@language": "en",
        "@value": "referred to in section 44 has reasonable cause to believe that by reason of delay in obtaining a search warrant under that section the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, such officer may enter the premises and exercise in, upon and in respect of the premises all the powers referred to in section 44 in as full and ample a manner as if he were authorised to do so by a warrant issued under that section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "No female person shall be searched under section 44"
      },
      "schema:text": {
        "@language": "en",
        "@value": "or 45 except by another female person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "An authorised officer conducting a search under section"
      },
      "schema:text": {
        "@language": "en",
        "@value": "44 or 45 or shall be given access to computerised data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any book, accounts, document, computerised data, mark, signboard, card, letter, pamphlet, device or thing is seized under section 44 or 45, the seizing officer shall prepare a list of the things seized and immediately deliver a copy of the list signed by him to the occupier of the premises which have been searched, or to his agent or servant, at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where the premises are unoccupied, the seizing officer shall whenever possible post a list of the things seized conspicuously on the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_49__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "(I) An authorised officer making an investigation under this Act may by order in writing require the attendance before himself of a person who appears to the authorised officer to be acquainted with the circumstances of the case, and the person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "If the person fails to attend as required, the authorised officer may report the failure to a Magistrate who shall issue a warrant to secure the attendance of the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "An authorised officer making an investigation under this Act may examine orally a person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall be legally bound to answer all questions relating to the case put to him by the authorised officer, but the person may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not the statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The authorised officer obtaining information from a person shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by a person under this section shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumb print after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "An authorised officer shall, for the purposes of the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "execution of this Act, have power to do all or any of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of records, accounts, computerised data and documents kept by a franchisor, franchise broker or franchisee and to inspect, examine and copy any of them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of any identification document from any person in relation to any case or offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "to make such inquiry as may be necessary to ascertain whether the provisions of this Act have been complied with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution shall be instituted under this Act without the consent in writing of the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "A person who, whether directly or indirectly— Offence for"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "employs any device or scheme in order to defraud;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "makes any untrue statement of a material fact or omits to state a material fact which renders his statement to be misleading;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "engages in any act, practice or course of business, which operates or would operate as a fraud or deceit upon any person, in relation to an offer to sell or a sale of a franchise, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "A person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "obstructs any person appointed under this Act acting in pursuance of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with any requirement properly made to him by an authorised officer under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "without reasonable cause fails to give to an authorised officer any assistance or information which may reasonably be required by the officer for the purpose of the performance of his duties under this Act, commits an offence and shall, on conviction, be liable to a fine not exceeding two thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "A person who commits an offence under this Act for which no penalty is expressly provided shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, to a fine of not less than five thousand ringgit and not more than fifty thousand ringgit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "for a second or subsequent offence, to a fine of not less than ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Upon sentencing a franchisor for a first offence, the court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "declare the franchise agreement between the franchisor and any franchisee to be null and void;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "order that the franchisor refunds any form of payment which he has obtained from any franchisee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prohibit the franchisor from making any new franchise agreement or appointing any new franchisee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "If an offence against any provision of this Act has"
      },
      "schema:text": {
        "@language": "en",
        "@value": "been committed by a body corporate, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity, or was in any manner or to any extent responsible for the management of any of the affairs of such body corporate, or was assisting in such management, shall be deemed to have committed that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "that he had taken all reasonable precautions and had exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may, with the consent in writing of the Public Prosecutor, compound any offence committed by any person under this Act and prescribed by the Minister to be a compoundable offence by making a written offer to the person suspected to have committed the offence to compound the offence upon payment to the Registrar of an amount of money not exceeding fifty per cent of the amount of maximum fine for that offence within the time specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "If the amount specified in the offer is not paid within the time specified in the offer or within such extended period as the Registrar may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made. 24 Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "If an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the Registrar under this section shall be paid into and form part of the Federal Consolidated Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "There is established a Franchise Advisory Board. Franchise"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Franchise Advisory Board shall consist of such persons, not exceeding fifteen in number, as the Minister may, from time to time, appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The members to be appointed under subsection (1) shall be persons who have wide knowledge and experience in matters relating to franchises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Franchise Advisory Board may receive such remuneration as may be prescribed for their services."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Franchise Advisory Board shall advise the Minister and the Registrar on matters relating to franchises, and the due administration and enforcement of laws relating to franchises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister and the Registrar shall not be bound to act upon the advice or report of the Franchise Advisory Board."
      }
    }
  ]
}
