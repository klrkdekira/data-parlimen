    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 69M Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Five thousand\" dengan perkataan \"One million\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Five hundred\" dengan perkataan \"Fifty thousand\". Pindaan seksyen 69o"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 69o Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6), dengan menggantikan perkataan \"five thousand\" dengan perkataan \"one million\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (7) subseksyen yang berikut: \"(8) A stock exchange or the Securities Commission may by notice in writing direct a company to which this section applies to invoke its powers under subsections ( 1) and ( 2) and to forthwith provide it with the information so obtained. (9) Where a company to which this section applies fails to comply with the direction of a stock exchange or the Securities Commission, the company and every officer of the company who is in default shall be guilty of an offence against this Act. Penalty: One million ringgit.\". Seksyen baru 69p"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 69o seksyen yang berikut: 69p. (1) Notwithstanding that a person who is a bare trustee is not regarded as having an interest in the share held by him under subsection 6A(9), he shall be deemed to be a substantial shareholder for the purposes of this Division if the aggregate of the nominal value of the shares held by him is not less than two per centum of the aggregate of the nominal amounts of all the voting shares in the company or, if the share capital of the company is divided into two or more classes of shares and the shares held by him are in one or more of those classes, of the aggregate all the voting shares included in that class or those classes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "With regard to the nature of the interest in the relevant notice to be given under section 69E, the fact that he is a bare trustee shall be stated and, in relation to the particulars of the voting shares, the full name and address, the nationality and the number of the identity card issued under the National Registration Act 1959, or the passport number or other identification number, of each of the beneficiaries and the number of shares held by each of the beneficiaries shall be disclosed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "The notice under section 69E shall be given—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "if the person was a substantial shareholder on the date on which this section came into operation, within fourteen days after that date; or Syarikat (Pindaan) (No. 2)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "if the person becomes a substantial shareholder after that date, within seven days after becoming a substantial shareholder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "This section shall not apply to a central depository as defined in the Securities Industry (Central Depositories) Act 1991 or its nominee company.\". Pecahan baru 6A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 107 Pecahan yang berikut: \"DIVISION 6A PROVISIONS APPLICABLE TO COMPANIES WHOSE SECURITIES ARE DEPOSITED WITH THE CENTRAL DEPOSITORY 107A. In this Division, unless the contrary intention appears— \"central depository\" has the same meaning as is assigned to that expression under subsection 2(1) of the Securities Industry (Central Depositories) Act 1991; \"deposited securities\" has the same meaning as is assigned to that expression under subsection 2(1) of the Securities Industry (Central Depositories) Act 1991; \"depositor\" has the same meaning as is assigned to that expression under subsection 2(1) of the Securities Industry (Central Depositories) Act 1991; \"security\" has the same meaning as is assigned to that expression under subsection 2(1) of the Securities Industry (Central Depositories) Act 1991; \"stock exchange\" has the same meaning as is assigned to that expression under subsection 2(1) of the Securities Industry Act 1983. 107B. (1) Notwithstanding section 100, adepositor whose name appears in the record of depositors maintained by the central depository pursuant to section 34 of the Securities Industry (Central Depositories) Act 1991 in respect of the securities of a company which have been deposited with the central depository shall be deemed to be a member, debenture holder, interest holder or option holder, as the case may be, of the company, and shall, subject to the provisions of the Securities Industry (Central Depositories) Act 1991 and any regulations made thereunder, be entitled to the number of securities stated in the record of depositors and all rights, benefits, powers and privileges and be subject to all liabilities, duties and obligations in respect of, or arising from, such securities (whether conferred or imposed by the Act or the memorandum or articles of association of the company). (2) Nothing in this Division shall be construed as affecting the obligation of the company to keep a register of its members under section 158, a register of holders of debentures under section 70, a register of interest holders under section 92 and a register of option holders under section 68A and to open them for inspection in accordance with the provisions of this Act except that the company shall not be obliged to enter in such registers the names and particulars of depositors who are deemed to be members, debenture holders, interest holders or option holders. (3) Notwithstanding any other provision of this Act, a depositor shall not be regarded as a member of a company entitled to attend any general meeting and to speak and vote thereat unless his name appears on the record of depositors not less than three market days before the general meeting. (4) The record of depositors shall be prima facie evidence of any matters inserted therein as required or authorized by this Act. (5) For the purpose of this section, \"market day\" means any day between Mondays and Fridays which is not a market holiday of the stock exchange or public holiday. Syarikat (Pindaan) (No. 2) 107c. (1) On or after the coming into operation of this section, the transfer of any securities or class of securities of a company whose securities or any class of whose securities have been deposited with a central depository shall be by way of book entry by the central depository in accordance with the rules of the central depository and, notwithstanding sections 103 and 104, such company shall be precluded from registering and effecting any transfer of securities. (2) Subsection (1) shall not apply to a transfer of securities to a central depository or its nominee company. 107D. (1) Notwithstanding anything in this Act or any written law or rule of law, no order shall be made by the Court for the rectification of the record of depositors except in the circumstances and subject to the conditions specified in subsection (2). (2) If the Court is satisfied that— (a) a depositor did not consent to a transfer of any securities; (b) a depositor should not have been registered as having title to any securities, it may award to the depositor mentioned in paragraph (a) or any person who would have been entitled to be registered as having the title to such securities, as the case may be, on such terms as the Court deems to be equitable or make such other order as the Court deems fit, including an order for the transfer of such securities to such depositor or person. 107E. Section 223 shall not apply to a disposition of property made by way of book entry by a central depository, but where the Court is satisfied that a party to the disposition, other than the central depository, had notice that a petition had been presented for the winding up of the other party to the disposition, it may award damages against that party on such terms as it thinks equitable or make such other orders as the Court thinks fit, including an order for the transfer of deposited securities by that party but not an order for the rectification of the record of depositors. 107F. The Minister may, by notice published in the Gazette, exempt any company or class of companies, subject to such terms and conditions as he deems fit to impose, from complying with all or any provisions of this Division in relation to any securities of a company or any class of companies to which this Division applies and may, by notice published in the Gazette, revoke such a notice or vary it in such manner as he thinks fit.\". Pindaan seksyen 176"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 176 Akta ibu dipinda dengan memasukkan selepas subseksyen (10) subseksyen yang berikut: \"(10A) The Court may grant a restraining order under subsection (10) to a company for a period of not more than ninety days or such longer period as the Court may for good reason allow if and only if— (a) it is satisfied that there is a proposal for a scheme of compromise or arrangement between the company and its creditors or any class of creditors representing at least one-half in value of all the creditors; (b) the restraining order is necessary to enable the company and its creditors to formalise the scheme of compromise or arrangement for the approval of the creditors or members pursuant to subsection (1); (c) a statement in the prescribed form as to the affairs of the company made up to a date not more than three days before the application is lodged together with the application; and (d) it approves the person nominated by a majority of the creditors in the application by the company under subsection (10) to act as a director or if that person is Syarikat (Pindaan) (No. 2) not already a director, notwithstanding the provisions of this Act or the memorandum and articles of the company, appoints the person to act as a director. (10B) The person approved or appointed by the Court to act as a director of the company under subsection (10A) shall have a right of access at all reasonable times to the accounting and other records (including registers) of the company, and is entitled to require from any officer of the company such information and explanation as he may require for the purposes of his duty. (l0c) Any disposition of the property of the company, including things in action and any acquisition of property by the company, other than those made in the ordinary course of business, made after the grant of the restraining order by the Court shall, unless the Court otherwise orders, be void. (10D) Where a company disposes or acquires any property, other than in the ordinary course of its business, without leave of the Court, every officer of the company who is in default shall be guilty of an offence against this Act. Penalty: Imprisonment for five years or one million ringgit or both. (10E) Where an order is made under subsection (10), every company in relation to which the order is made shall, within seven days— (a) lodge an office copy of the order with the Registrar; and (b) publish a notice of the order in a daily newspaper circulating generally throughout Malaysia, and every company which makes default in complying with this subsection and every officer of the company who is in default shall be guilty of an offence against this Act. Penalty: One hundred thousand ringgit.\". Pindaan seksyen 365"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 365 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) A company is allowed to declare dividends (after making deductions for income tax, if any) for a financial year only up to an amount— (a) not exceeding the after-tax profit of that financial year; or (b) not exceeding the average dividends declared in respect of the two financial years immediately preceding that financial year, whichever is the greater. (1B) Any after-tax profit not declared as dividends for any financial year commencing on or after 1 July 1997 may be accumulated and paid out as dividends in any financial year subsequent to that financial year. (lc) Subsections (1A) and (lB) shall not apply to— (a) subsidiaries of any holding company; (b) private companies which are wholly-owned by Malaysians; and (c) a company whose financial year commenced before 1 July 1997. (lD) The Minister of Finance may exempt any company from the provisions of subsection (1A).\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dengan memasukkan selepas perkataan \"not profits\" perkataan \"or are profits not permitted or exempted under subsection (1A), (lB), (lc) or (1D)\". Syarikat (Pindaan) (No. 2)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Syarikat (Pindaan) (No.2) 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini. Pindaan seksyen 67A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 67A Akta Syarikat 1965 [Akta 125], yang disebut \"Akta ibu\" dalam Akta ini, dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan \"or give financial assistance to any person for the purpose of purchasing its shares\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan ( a ), dengan menggantikan perkataan \"or the giving of financial assistance\" dengan perkataan \"and will not become insolvent by incurring the debts involved in the obligation to pay for the shares so purchased\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memasukkan selepas perkataan \"quoted\" perkataan \"and in accordance with the relevant rules of the Stock Exchange\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan \"or the giving of financial assistance\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Notwithstanding section 60, the company may apply its share premium account to provide the consideration for the purchase of its own shares.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: \"(3A) Where a company has purchased its own shares, the directors of the company may resolve— (a) to cancel the shares so purchased; (b) to retain the shares so purchased in treasury (in this Act referred to as \"treasury shares\"); or (c) to retain part of the shares so purchased as treasury shares and cancel the remainder. (3B) The directors of the company may— (a) distribute the treasury shares as dividends to shareholders, such dividend to be known as \"share dividends\"; or (b) resell the treasury shares on the market of the Stock Exchange on which the shares are quoted, in accordance with the relevant rules of the Stock Exchange. (3c) While the shares are held as treasury shares, the rights attached to them as to voting, dividends and participation in other distribution and otherwise are suspended and the treasury shares shall not be taken into account in calculating the number or percentage of shares or of a class of shares in the company for any purposes including, without limiting the generality of this provision, the provisions of any law or requirements Syarikat (Pindaan) (No. 2) of the articles of association of the company or the listing rules of a Stock Exchange on substantial shareholding, takeovers, notices, the requisitioning of meetings, the quorum for a meeting and the result of a vote on a resolution at a meeting. (3D) Where the directors decide to distribute the treasury shares as share dividends, the costs of the shares on the original purchase shall be applied in the reduction of either the share premium account or the funds otherwise available for distribution as dividends or both. (3E) Where the directors resolve to cancel the shares so purchased, or cancel any treasury shares, the issued capital of the company shall be diminished by the shares so cancelled and the amount by which the company's issued capital is diminished shall be transferred to the capital redemption reserve.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan \"(3)\" dengan perkataan \"(3E)\". Pindaan seksyen 68"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 68(1) Akta ibu dipinda dengan menggantikan perkataan \"five\" dengan perkataan \"ten\". Seksyen baru 68A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 68 seksyen yang berikut: F 68A, (1) A company shall keep a register of options granted to persons to take up unissued shares in the company."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "The company shall, within fourteen days after the grant of an option to take up unissued shares in the company, enter in the register the following particulars:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the name, address and the number of the identity card issued under the National Registration Act 1959, or the passport number or other identification number, and the nationality of the holder of the option;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the date on which the option was granted;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the number and description of the shares in respect of which the option was granted;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the period during which, the time at which or the occurrence upon the happening of which the option may be exercised;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the consideration, if any, for the grant of the option;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the consideration, if any, for the exercise of the option or the manner in which that consideration is to be ascertained or determined; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "such other particulars as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Division 4 of Part V shall apply to a register kept under this section as if the register was the register of members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "A company shall keep at the place where the register under this section is kept a copy of every instrument by which an option to take up unissued shares in the company is granted, and for the purposes of subsection (3) those copies shall be deemed to be part of the register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Failure by the company to comply with any provision in this section shall not affect any rights in respect of the option."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "If default is made in complying with this section, the company and any officer of the company who is in default shall be guilty of an offence against this Act. Penalty: One hundred thousand ringgit. Default penalty: Ten thousand ringgit.\". Pindaan seksyen 69A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 69A(3) Akta ibu dipinda dengan menggantikan perkataan \"fifty thousand\" dengan perkataan \"one million\". Syarikat (Pindaan) (No. 2) Pindaan seksyen 69D"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 69D Akta ibu dipinda dengan menggantikan perkataan \"five\" di mana-mana juga terdapat dengan perkataan \"two\". Pindaan seksyen 69E"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 69E(2)(b) Akta ibu dipinda dengan menggantikan perkataan \"fourteen\" dengan perkataan \"seven\". Pindaan seksyen 69F"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 69F(2) Akta ibu dipinda dengan menggantikan perkataan \"fourteen\" dengan perkataan \"seven\". Pindaan seksyen 69G"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 69G(2) Akta ibu dipinda dengan menggantikan perkataan \"fourteen\" dengan perkataan \"seven\". Pindaan seksyen 69M"
      }
    }
  ]
}
