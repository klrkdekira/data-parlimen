      "schema:name": {
        "@language": "en",
        "@value": "Section 38 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: \"(1) If an Investigating Officer of the Commission carrying out an investigation under any securities law suspects or believes on reasonable grounds that any person can give information relevant to a matter that he is investigating, the Investigating Officer of the Commission may by notice in writing to such person require such person— (a) to give to the Investigating Officer of the Commission all reasonable assistance in connection with the investigation; and (b) to appear before a specified Investigating Officer of the Commission or specified Investigating Officers of the Commission to be examined orally.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: \"(1 A) An Investigating Officer of the Commission exercising his authority under paragraph (1)(b) shall reduce into writing any statement made by the person examined under subsection (1).\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(3A) An examination of a person under subsection (1) shall take place in private and the Investigating Officer of the Commission or Investigating Officers of the Commission examining him may give directions about who may be present during the examination, or during any part of it.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"fifty thousand\" the words \"one million\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_7__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"three\" the word \"five\". Securities Commission (Amendment) New section 38A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Part V of the principal Act is amended by inserting after section 38 the following section: 38A. Any person who— (a) destroys, conceals, mutilates or alters; or (b) sends or attempts to send or conspires with any other person to remove from his premises or send out of Malaysia, any record or account in his possession that is required to be produced under this Part with intent to defraud any person, or to prevent, delay or obstruct the carrying out of an examination, audit or investigation, or the exercise of any power under this Act shall be guilty of an offence and shall be liable on conviction to a fine not exceeding ten million ringgit or to imprisonment for a term not exceeding ten years or to both.\". Amendment of section 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 39 of the principal Act is amended by deleting subsection"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(2). New sections 39c, 39D, 39E, 39F and 39G"
      }
    }
  ]
}
