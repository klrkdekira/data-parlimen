      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian V Akta ibu dipinda dengan memasukkan selepas seksyen 38 seksyen yang berikut: 38A. Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, menyembunyikan, mencacatkan atau mengubah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "menghantar atau cuba untuk menghantar atau berkomplot dengan mana-mana orang lain untuk mengalihkan dari premisnya atau menghantar keluar dari Malaysia, apa-apa rekod atau akaun dalam pemilikannya yang dikehendaki supaya dikemukakan di bawah Bahagian ini dengan niat untuk memfraud mana-mana orang, atau untuk menahan, melengahkan atau menghalang penjalanan sesuatu pemeriksaan, pengauditan atau penyiasatan, atau penjalanan mana-mana kuasa di bawah Akta ini adalah melakukan suatu kesalahan dan, apabila disabitkan, boleh didenda tidak melebihi sepuluh juta ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya.\". Suruhanjaya Sekuriti (Pindaan) Pindaan seksyen 39"
      }
    },
