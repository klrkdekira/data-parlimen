        "@language": "ms",
        "@value": "dalam subseksyen (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_7__para_d__subpara_i",
