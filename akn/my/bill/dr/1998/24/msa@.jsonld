      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"lima puluh ribu\" dengan perkataan \"satu juta\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/24/msa@/~cl_7__para_d__subpara_ii",
