      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan (1999) 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 1999. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi tiga puluh satu bilion sembilan ratus enam puluh sembilan juta lima ratus dua puluh tiga ribu sembilan ratus empat puluh (RM31,969,523,940) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 1999 adalah dengan ini dibenarkan, dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 1 Parlimen B. 2 Pejabat Penyimpan Mohor Besar Raja-Raja B. 3 Jabatan Audit B. 4 Suruhanjaya Pilihanraya B. 5 Suruhanjaya Perkhidmatan Awam B. 6 Suruhanjaya Perkhidmatan Pendidikan B. 7 Jabatan Perdana Menteri . B. 8 Jabatan Perkhidmatan Awam B. 9 Jabatan Perangkaan B. 10 Jabatan Peguam Negara B. 11 Badan Pencegah Rasuah B. 12 Pejabat Setiausaha Persekutuan Sabah B. 13 Pejabat Setiausaha Persekutuan Sarawak B. 14 Kementerian Perumahan dan Kerajaan Tempatan B. 15 Jabatan Perancangan Bandar dan Desa B. 16 Jabatan Bomba dan Penyelamat B. 17 Kementerian Bella dan Sukan B. 18 Kementerian Perusahaan Utama B. 19 Kementerian Pertanian B. 20 Kementerian Perdagangan Antarabangsa dan Industri B. 21 Kementerian Perdagangan Dalam Negeri dan Hal Ehwal Pengguna B. 22 Kementerian Kebudayaan, Kesenian dan Pelancongan B. 23 Jabatan Arkib Negara B. 24 Jabatan Muzium dan Antikuiti B. 25 Kementerian Pertahanan B. 26 Kementerian Pendidikan B. 27 Jabatan Perpustakaan Negara B. 28 Perbendaharaan B. 29 Perkhidmatan Am Perbendaharaan B. 30 Peruntukan kepada Kumpulan Wang Terkanun Perbekalan Maksud Tajuk B. 31 Jabatan Kastam dan Eksais Diraja B. 32 Jabatan Hasil Dalam Negeri B. 33 Jabatan Penilaian dan Perkhidmatan Harta B. 34 Kementerian Kesihatan B. 35 Kementerian Dalam Negeri B. 36 Polis Diraja Malaysia B. 37 Jabatan Imigresen B. 38 Jabatan Pendaftaran Pertubuhan B. 39 Jabatan Pendaftaran Negara B. 40 Jabatan Penjara B. 41 Jabatan Pertahanan Awam B. 42 Kementerian Perpaduan Negara dan Pembangunan Masyarakat B. 43 Kementerian Tanah dan Pembangunan Koperasi B. 44 Kementerian Penerangan B. 45 Kementerian Sumber Manusia B. 46 Kementerian Sains, Teknologi dan Alam Sekitar 214,735,600 B. 47 Kementerian Pengangkutan B. 48 Kementerian Pembangunan Luar Bandar B. 49 Kementerian Tenaga, Telekom dan Pos B. 50 Kementerian Pembangunan Usahawan B. 51 Kementerian Luar Negeri B. 52 Kementerian Kerja Raya JUMLAH"
      }
    }
  ]
