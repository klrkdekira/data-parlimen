        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Windfall Profit Levy Bill 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to any other remedy, any levy due and payable and any penalty accruing under this Act may be recovered as a civil debt due to the Government. Submission of return"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who produces prescribed goods shall within the precribed time deliver to the proper officer of customs a return in the prescribed form stating the amount of levy payable, quantity or volume of prescribed goods produced, and such other particulars as the Director General may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Every return submitted in accordance with subsection (1) shall be accompanied by payment of the amount due as levy. Assessment of levy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any return submitted under section 11 may be accepted by the proper officer of customs as sufficient proof of the matters contained therein, and levy may be assessed accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If the proper officer of customs has reason to believe that the amount of levy shown in a return made by any person under section 11 is less than the amount payable under this Act, he may assess the levy at such greater amount as he deems fit. Refund of levy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, if he is satisfied that it would be just and proper to do so as regards a levy paid under this Act, direct the refund of the whole or any part of such levy during such period as he may specify in the direction, and in directing such refund may impose such conditions as he deems fit. Refund of levy overpaid or erroneously paid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), if the Director General is satisfied that any money has been overpaid or erroneously paid as a levy under this Act, he may order the refund of the money so overpaid or erroneously paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall not order such refund unless a claim in respect thereof is made within one year after the overpayment or erroneous payment was made. Payment of levy or penalty shortpaid or erroneously refunded"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Where the whole or any part of any levy or penalty under section 9 has not been paid, or after having been paid has been erroneously refunded, then, provided a demand is made within three years from the date on which such levy or penalty were paid, or the refund was made, as the case may be, the person liable to pay such levy or penalty, or the person to whom such refund has erroneously been made, as the case may be, shall pay the deficiency or repay the amount paid to him in excess. Duty to keep records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every producer of prescribed goods shall keep such books of accounts or other records as the Director General may direct showing full and true records written up to date of all transactions which affect or may affect his liability to levy under this Act and shall keep those books of accounts or other records in the national language or English language."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The books of accounts and other records which are required to be kept in accordance with this section shall be preserved for a period of six years from the latest date in respect of the production of prescribed goods to which such documents relate. Persons bound to give information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Every person having information about any matter into which it is the duty of the proper officer of customs to inquire shall, upon being required by him to do so, give such information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Every person required by the proper officer of customs to produce a document or other thing which is within the power of such person to produce and which is a document or thing required under this Act or a document or thing used in any transaction or other matter relating to levy or a document or thing into which it is the duty of the proper officer of customs to enquire under this Act shall produce such document or thing. Access to place or premises"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, any senior officer of customs shall at all times have access to any place or premises where a producer of prescribed goods carries on his business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where any senior officer of customs enters upon any place or premises in accordance with this section, he may do all or any of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "require the producer to produce any book, document, or thing, which such producer is required to keep under the provisions of this Act, or which relate to any prescribed goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "examine any book, document or thing and take copies of any book or document;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "seize and detain any book, document or thing, if in his opinion it may afford evidence of the commission of any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "require any producer or any person employed by the producer to answer question relating to any book, document or thing or to any entry in any book or document;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "take and retain without payment such samples of any goods or materials as he may think necessary for the performance of his duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where the senior officer of customs acting under this section is unable to obtain free access to any premises where a producer carries on his business, he may at any time enter such premises in such manner, if necessary by force, as he may think necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any prescribed goods are found on any premise entered under this section;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "such prescribed goods are produced by a producer who is liable to pay the levy; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "such levy has not been paid, such goods may be seized and shall be liable to forfeiture. Penalty on making incorrect return and on falsifying documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes, orally or in writing, or signs any return, or other document required by this Act which is untrue or incorrect in any material particular;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes, orally or in writing, or signs any return or document made for the consideration of any proper officer of customs on any application presented to him which is untrue or incorrect in any material particular;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "counterfeits or falsifies, or uses, when counterfeited or falsified, any document which is or may be required under this Act or any document used in the conduct of any business or matter relating to the levy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fraudulently alters any document, or counterfeits the seal, signature, or initials or other mark of, or used by, any proper officer of customs for the verification of any such document or for the security of any goods or any other purpose in the conduct of any business or matter relating to the levy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being so required by this Act to make a return, fails to make such return as so required; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to produce to a proper officer of customs any document required to be produced under this Act, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is convicted of an offence under subsection (1) shall be liable to a fine of not less than ten times the amount of the levy payable and of not more than twenty times the amount of the levy payable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "When any such return, whether oral or written, or any such document as is referred to in paragraphs (l)(a), (b) and (c) has been proved to be untrue or incorrect or counterfeited or falsified in whole or in part, it shall be no defence to allege that such return or document was made or used inadvertently or without criminal or fraudulent intent, or that the person signing the return or document was not aware of or did not understand the contents of such document, or where any return was made or recorded in the national language or in the English language by interpretation from any other language, that such return was misinterpreted or not fully interpreted by an interpreter provided by the person making the return or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"falsified\" in relation to a document shall be deemed to include a document which is untrue or incorrect in any material particular, and \"falsifies\" shall be construed accordingly. Penalty on refusing to answer questions or on giving false information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Windfall Profit Levy Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on 1 January 1999. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Department\" means the Royal Malaysian Customs and Excise Department; \"Director General\" means the Director General of Customs and Excise appointed under subsection 3(1) of the Customs Act 1967 [Act 235]; \"Fund\" means the Federal Consolidated Fund; \"goods\" means all kinds of movable and immovable property; \"levy\" means a levy imposed under section 6; \"Minister\" means the Minister charged with the responsibility for finance; \"prescribed\", unless otherwise stated, means prescribed by regulations made under section 28; \"prescribed goods\" means goods prescribed by order made under section 6; \"proper officer of customs\" shall have the same meaning as is assigned to that expression in section 2 of the Customs Act 1967. Powers of Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being required by this Act to give any information which may reasonably be required by a proper officer of customs and which it is in his power to give, refuses to give such information or furnishes as true information which he knows or has reason to believe to be false, commits an offence and shall be liable on conviction to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "When any such information is proved to be untrue or incorrect in whole or in part it shall be no defence to allege that such information or any part thereof was furnished inadvertently or without criminal or fraudulent intent, or was misinterpreted or not fully interpreted by an interpreter provided by the informant. Failure to comply with requirement of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to any other liability incurred under this Act, any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to comply with the requirements of section 8, 11, 12, 15 or 16;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to produce any book or document for the examination or retention by the proper officer of customs in accordance with the requirements of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to give correct information or refuses to give any information which he is required to give relating to the levy; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "pays a lesser amount of levy than is required by this Act, commits an offence, and shall be liable on conviction to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both. General offence and penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who omits or neglects to comply with, or does or attempts to do any act contrary to, the provisions of this Act commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A person convicted of an offence under subsection (1) shall be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Power to compound"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "A proper officer of customs may, with the consent in writing of the Public Prosecutor, compound any offence committed by any person under this Act or its subsidiary legislation and prescribed to be a compoundable offence by making a written offer to the person suspected to have committed the offence to compound the offence upon payment to the proper officer of customs of an amount of money not exceeding fifty per cent of the amount of maximum fine for that offence within the time specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and if the amount specified in the offer is not paid within the period specified in the offer or within such extended period as the proper officer of customs may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "If an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer was made and any thing seized in connection with the offence may be released or forfeited by the proper officer of customs, subject to such terms and conditions as he thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the proper officer of customs under this section shall be paid into and form part of the Fund. Offences by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If a body corporate commits an offence under this Act or its subsidiary legislation, a person who at the time of the commission of the offence was a director, chief executive officer, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the body corporate is found guilty of the offence, shall be deemed to be guilty of that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If any person would be liable under this Act to any punishment or penalty for his act, omission, neglect or default, he shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his, or of the employee of the agent, if the act, ommission, neglect or default was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person's employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the agent when acting on behalf of that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of the agent in the course of his employment by the agent or otherwise on behalf of the agent acting on behalf of that person. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to any offence under this Act shall be instituted without the written consent of the Public Prosecutor. Abetting an offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person wilfully makes on behalf of another person, or aids, abets, assists, incites or induces any other person to make an incorrect return, account or statement resulting in a short payment of the levy by the person liable for the payment of the levy such first-mentioned person commits an offence and shall be liable on conviction to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Power of Minister to apply Customs Act 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe any provision in the Customs Act 1967 to be a provision which shall apply for the purpose of carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "In prescribing the provisions of the Customs Act 1967 under subsection (1), the Minister may make such modifications as are necessary and expedient for the purpose of ensuring the proper and efficient implementation of this Act. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for the purpose of carrying out or giving effect to the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "In particular and without prejudice to the generality of the power conferred by subsection (1), such regulations may provide for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedures for the payment and collection of levy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the form required for the collection of levy; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the place and time relating to collection of levy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the direction and control of the Minister, the Director General shall have the superintendence of all matters relating to the levy under this Act. Powers of a proper officer of customs"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any proper officer of customs shall, in addition to the duties and powers conferred under the Customs Act 1967, have all the duties and powers to enforce and ensure due compliance with the provisions of this Act. Authority card to be produced"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Every proper officer of customs when acting against any person under this Act shall, if not in uniform, on demand declare his office and produce to the person against whom he is acting such document establishing his identity as the Director General may direct to be carried by such officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "It shall not be an offence for any person to refuse to comply • with any demand made by any officer acting or purporting to act under this Act if such officer is not in uniform and refuses to declare his office and produce his identification document on demand being made by such person. Imposition of levy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be charged and levied a levy to be known as windfall profit levy on such amount as may be prescribed by the Minister by order published in the Gazette which exceeds the amount of such gains as may be prescribed by the Minister in such order and derived from the production of prescribed goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "An order made under subsection (1) may prescribe different amounts and rates for different types of goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A levy shall be paid by the producer of the prescribed goods and shall be paid into the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to pay any levy imposed under this section commits an offence and shall on conviction be liable to a fine not exceeding ten times the amount of levy due or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The prosecution of any person under this section shall not relieve such person from liability for the payment of any levy for which he is or may be liable or from liability to make any return which he is required by this Act to make. Order to be tabled"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An order determining the amount of levy to be levied under this Act shall, at the next meeting of the Dewan Rakyat, be laid on the table of the Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An order laid on the table of the Dewan Rakyat shall cease to have effect on the expiration of the period of 120 days from the date it is so laid or of such extended period as the Dewan Rakyat may by resolution direct, if it is not confirmed by a resolution passed by the Dewan Rakyat within such period or extended period. Registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who produces the prescribed goods shall register with the Department. Penalty for late payment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where any amount of levy remains unpaid after the last day on which it was payable then a penalty equal to ten per cent of such unpaid amount shall thereupon be payable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "If the levy due and payable remains unpaid for more than thirty days after the last day on which it was so payable the rate of penalty under subsection (1) on such unpaid levy shall be increased by ten per cent for the second period of thirty days after such last day and for every succeeding period of thirty days or part thereof during which such amount remains unpaid to a maximum of fifty per cent. Levy may be recovered as civil debt"
      }
    }
  ]
}
