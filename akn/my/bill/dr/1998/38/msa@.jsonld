        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Levi Keuntungan Luar Biasa 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan apa-apa remedi lain, apa-apa levi yang genap masa dan kena dibayar dan apa-apa penalti yang terakru di bawah Akta ini boleh dituntut sebagai suatu hutang sivil yang terhutang kepada Kerajaan. Pengemukaan penyata"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang mengeluarkan barang-barang ditetapkan hendaklah dalam masa yang ditetapkan menyerahkan kepada pegawai kastam yang hak suatu penyata dalam bentuk yang ditetapkan yang menyatakan amaun levi yang kena dibayar, kuantiti atau jumlah barang-barang ditetapkan yang dikeluarkan dan apa-apa butir lain sebagaimana yang dikehendaki oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap penyata yang dikemukakan mengikut subseksyen (1) hendaklah disertakan dengan bayaran amaun yang kena dibayar sebagai levi. Pentaksiran levi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penyata yang dikemukakan di bawah seksyen 11 boleh disetuju terima oleh pegawai kastam yang hak sebagai bukti yang cukup mengenai perkara-perkara yang terkandung dalamnya, dan levi bolehlah ditaksirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pegawai kastam yang hak itu ada mempercayai bahawa amaun levi yang ditunjukkan dalam suatu penyata yang dibuat oleh mana-mana orang di bawah seksyen 11 adalah kurang daripada amaun yang kena dibayar di bawah Akta ini, maka dia boleh mentaksirkan levi mengikut apa-apa arnaun yang lebih besar sebagaimana yang difikirkannya patut. Pembayaran batik levi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, jika dia berpuas hati bahawa adalah adil dan patut untuk berbuat demikian berkenaan dengan levi yang telah dibayar di bawah Akta ini, mengarahkan supaya dibayar balik keseluruhan atau apa-apa bahagian levi itu dalam apa-apa tempoh sebagaimana yang ditentukannya dalam arahan itu, dan dalam mengarahkan pembayaran balik sedemikian boleh mengenakan apa- apa syarat sebagaimana yang difikirkannya patut. Pembayaran balik levi yang terlebih bayar atau tersilap bayar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), jika Ketua Pengarah berpuas hati bahawa apa-apa wang telah terlebih bayar atau tersilap bayar sebagai levi di bawah Akta ini, dia boleh memerintahkan pembayaran balik wang yang terlebih bayar atau tersilap bayar itu. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah tidak boleh mengarahkan pembayaran balik sedemikian melainkan jika suatu tuntutan berkenaan dengannya dibuat dalam masa satu tahun selepas pembayaran lebih atau pembayaran silap itu dibuat. Pembayaran levi atau penalti yang terkurang bayar atau tersilap dibayar balik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika keseluruhan atau mana-mana bahagian apa-apa levi atau penalti di bawah seksyen 9 belum lagi dibayar, atau setelah dibayar telah tersilap dibayar balik, maka, dengan syarat suatu tuntutan dibuat dalam tempoh tiga tahun dari tarikh levi atau penalti itu dibayar, atau bayaran balik dibuat, mengikut mana-mana yang berkenaan, orang yang bertanggungan membayar levi atau penalti itu, atau orang yang kepadanya bayaran balik itu telah tersilap dibuat, mengikut mana-mana yang berkenaan, hendaklah membayar kekurangan atau membayar balik amaun yang terlebih dibayar kepadanya itu. Kewajipan menyimpan rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pengeluar barang-barang ditetapkan hendaklah menyimpan buku akaun atau rekod lain sebagaimana yang diarahkan oleh Ketua Pengarah yang menunjukkan rekod yang penuh dan benar yang dikemaskinikan mengenai semua transaksi yang menyentuh atau mungkin menyentuh liabilitinya untuk membayar levi di bawah Akta ini dan hendaklah menyimpan buku akaun atau rekod lain itu dalam bahasa kebangsaan atau bahasa Inggeris."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Buku akaun dan rekod lain yang dikehendaki supaya disimpan mengikut seksyen ini hendaklah dikekalkan selama tempoh enam tahun dari tarikh yang terakhir berkenaan dengan pengeluaran barang-barang ditetapkan yang berkaitan dengan rekod itu. Orang-orang terikat untuk memberikan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang mempunyai maklumat tentang apa-apa perkara yang menjadi kewajipan pegawai kastam yang hak menyiasatnya hendaklah, apabila dikehendaki olehnya supaya berbuat demikian, memberikan maklumat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang dikehendaki oleh pegawai kastam yang hak supaya mengemukakan dokumen atau benda lain yang orang itu berkuasa mengemukakannya, dan dokumen itu ialah dokumen atau benda yang dikehendaki di bawah Akta ini atau suatu dokumen atau benda yang digunakan dalam apa-apa transaksi atau perkara lain yang berhubungan dengan levi atau suatu dokumen atau benda yang menjadi kewajipan pegawai kastam yang hak itu menyiasatnya di bawah Akta ini hendaklah mengemukakan dokumen atau benda itu. Akses ke tempat atau premis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, mana-mana pegawai kanan kastam hendaklah setiap masa mempunyai akses ke mana-mana tempat atau premis di mana seseorang pengeluar barang-barang ditetapkan menjalankan perniagaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pegawai kanan kastam memasuki mana- mana tempat atau premis mengikut seksyen ini, dia boleh melakukan semua atau mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengeluar itu mengemukakan apa-apa buku, dokumen, atau benda yang dikehendaki supaya disimpan oleh pengeluar itu di bawah peruntukan Akta ini, atau yang ada kaitan dengan mana-mana barang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa apa-apa buku, dokumen atau benda dan mengambil salinan apa-apa buku atau dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyita dan menahan apa-apa buku, dokumen atau benda, jika pada pendapatnya buku, dokumen atau benda itu dapat memberi keterangan mengenai pelakuan apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki mana-mana pengeluar atau mana-mana orang yang digaji oleh pengeluar itu supaya menjawab soalan- soalan berhubung dengan mana-mana buku, dokumen atau benda, atau berhubung dengan apa-apa catatan dalam mana-mana buku atau dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil dan menyimpan tanpa bayaran apa-apa contoh barang atau bahan yang difikirkannya perlu bagi melaksanakan kewajipannya. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pegawai kanan kastam yang bertindak di bawah seksyen ini tidak dapat memperoleh akses bebas ke mana-mana premis tempat seseorang pengeluar menjalankan perniagaannya dia boleh pada bila-bila masa memasuki premis itu dengan cara yang difikirkannya perlu, jika perlu dengan kekerasan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana barang ditetapkan dijumpai di mana-mana premis yang dimasuki di bawah seksyen ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "barang ditetapkan itu dikeluarkan oleh pengeluar yang bertanggungan membayar levi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "levi itu belum dibayar, barang itu boleh disita dan boleh dilucuthakkan. Penalti kerana membuat penyata yang tidak betul dan kerana memalsukan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat, secara lisan atau bertulis, atau menandatangani apa-apa penyata atau dokumen lain yang dikehendaki oleh Akta ini yang tidak benar atau tidak betul tentang apa-apa butir matan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat, secara lisan atau bertulis, atau menandatangani apa-apa penyata atau dokumen yang dibuat bagi pertimbangan mana-mana pegawai kastam yang hak tentang apa-apa permohonan yang dikemukakan kepadanya yang tidak benar atau tidak betul tentang apa-apa butir matan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melancungkan atau memalsukan, atau menggunakan apabila dilancungkan atau dipalsukan, apa-apa dokumen yang dikehendaki atau mungkin dikehendaki di bawah Akta ini atau apa-apa dokumen yang digunakan dalam perjalanan apa-apa urusan atau perkara yang berhubungan dengan levi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara fraudan mengubah apa-apa dokumen, atau melancungkan meterai, tandatangan atau tandatangan ringkas atau tanda lain kepunyaan, atau yang digunakan oleh, mana-mana pegawai kastam yang hak bagi penentusahan apa-apa dokumen sedemikian atau bagi keselamatan apa-apa barang atau apa-apa maksud lain dalam perjalanan apa-apa perniagaan atau perkara yang berhubungan dengan levi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dikehendaki oleh Akta ini supaya membuat suatu penyata, tidak membuat penyata itu sebagaimana yang dikehendaki; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak atau enggan mengemukakan kepada seorang pegawai kastam yang hak apa-apa dokumen yang dikehendaki supaya dikemukakan di bawah Akta ini, adalah melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang disabitkan atas suatu kesalahan di bawah subseksyen (1) boleh didenda tidak kurang daripada sepuluh kali amaun levi yang kena dibayar dan tidak lebih daripada dua puluh kali amaun levi yang kena dibayar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila apa-apa penyata sedemikian, sama ada lisan atau bertulis, atau apa-apa dokumen sebagaimana yang disebut dalam perenggan (l)(a), (b) dan (c) telah dibuktikan tidak benar atau tidak betul atau dilancungkan atau dipalsukan pada keseluruhan atau sebahagiannya, tidaklah menjadi suatu pembelaan untuk mengatakan bahawa penyata atau dokumen digunakan dengan tidak sengaja atau tanpa niat jenayah atau fraudan, atau bahawa orang yang menandatangani penyata atau dokumen itu tidak mengetahui atau tidak memahami kandungan dokumen itu, atau jika apa-apa penyata dibuat atau direkodkan dalam bahasa kebangsaan atau dalam bahasa Inggeris melalui terjemahan daripada mana-mana bahasa lain, bahawa penyata itu telah disalahterjemahkan atau tidak diterjemahkan dengan sepenuhnya oleh penterjemah yang disediakan oleh orang yang membuat penyata atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, \"dipalsukan\" berhubung dengan sesuatu dokumen hendaklah disifatkan sebagai termasuk sesuatu dokumen yang tidak benar atau tidak betul dalam apa-apa butir matan, dan \"memalsukan\" hendaklah ditafsirkan dengan sewajarnya. Rang Undang-Undang Penalti kerana enggan menjawab soalan atau kerana memberikan maklumat palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Levi Keuntungan Luar Biasa 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada 1 Januari 1999. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"barang-barang\" ertinya segala jenis harta alih dan harta tak alih; \"barang-barang ditetapkan\" ertinya barang-barang yang ditetapkan melalui perintah yang dibuat di bawah seksyen 6; \"ditetapkan\", melainkan jika dinyatakan selainnya, ertinya ditetapkan melalui peraturan-peraturan yang dibuat di bawah seksyen 28; \"Jabatan\" ertinya Jabatan Kastam dan Eksais Diraja Malaysia; \"Ketua Pengarah\" ertinya Ketua Pengarah Kastam dan Eksais yang dilantik di bawah subseksyen 3(1) Akta Kastam l961[Akta 235]; \"Kumpulan Wang\" ertinya Kumpulan Wang Disatukan Persekutuan; \"levi\" ertinya levi yang dikenakan di bawah seksyen 6; \"Menteri\" ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan; \"pegawai kastam yang hak\" hendaklah mempunyai erti yang sama seperti yang diberikan kepada ungkapan itu dalam seksyen 2 Akta Kastam 1967. Kuasa Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang, yang dikehendaki oleh Akta ini supaya memberikan apa-apa maklumat yang secara yang munasabah dikehendaki oleh seorang pegawai kastam yang hak dan yang dia berkuasa untuk memberikannya, enggan untuk memberikan maklumat itu atau memberikan sebagai benar maklumat yang diketahuinya atau dia mempunyai sebab untuk percaya adalah palsu, adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua belas bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat sedemikian dibuktikan tidak benar atau tidak betul pada keseluruhan atau sebahagiannya maka tidaklah menjadi suatu pembelaan untuk mengatakan bahawa maklumat itu atau mana-mana bahagian daripadanya diberikan dengan tidak sengaja atau tanpa niat jenayah atau fraudan, atau telah disalahterjemahkan atau telah tidak diterjemahkan dengan sepenuhnya oleh penterjemah yang disediakan oleh pemberi maklumat itu. Tidak mematuhi kehendak Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan apa-apa liabiliti lain yang ditanggung di bawah Akta ini, mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mematuhi atau enggan mematuhi kehendak-kehendak seksyen 8, 11, 12, 15 atau 16;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengemukakan atau enggan mengemukakan mana- mana buku atau dokumen untuk diperiksa atau disimpan oleh pegawai kastam yang hak mengikut kehendak- kehendak Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak memberikan atau enggan memberikan maklumat yang betul atau enggan memberikan apa-apa maklumat yang dia dikehendaki supaya memberinya berhubung dengan levi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar levi yang amaunnya kurang daripada yang dikehendaki di bawah Akta ini, Levi Keuntungan Luar Biasa adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Kesalahan dan penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak atau abai untuk mematuhi, atau melakukan atau cuba untuk melakukan apa-apa perbuatan yang bertentangan dengan Akta ini adalah melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang telah disabitkan atas suatu kesalahan di bawah subseksyen (1) boleh didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Kuasa untuk mengkompaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai kastam yang hak boleh, dengan keizinan secara bertulis Pendakwa Raya, mengkompaunkan apa-apa kesalahan dilakukan oleh mana-mana orang di bawah Akta ini atau perundangan subsidiarinya dan ditetapkan sebagai kesalahan boleh kompaun dengan membuat tawaran secara bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaunkan kesalahan itu apabila dibayar kepada pegawai kastam yang hak itu suatu amaun wang yang tidak melebihi lima puluh peratus amaun de'nda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam tempoh masa yang dinyatakan dalam tawaran itu atau dalam apa-apa tempoh lanjutan yang dibenarkan oleh pegawai kastam yang hak itu, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan dikompaunkan di bawah subseksyen (1), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran itu dibuat dan apa- Rang Undang-Undang apa benda yang disita berkaitan dengan kesalahan itu boleh dilepaskan atau dilucuthakkan oleh pegawai kastam yang hak, tertakluk kepada apa-apa terma dan syarat yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang diterima oleh pegawai kastam yang hak di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini atau perundangan subsidiarinya, seseorang yang pada masa pelakuan kesalahan itu merupakan seorang pengarah, ketua pegawai eksekutif, pengurus, setiausaha atau pegawai seumpama itu yang lain bagi pertubuhan perbadanan itu atau berupa seperti bertindak atas apa-apa sifat sedemikian atau telah dengan apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan mana-mana hal ehwal pertubuhan perbadanan itu atau telah membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh didakwa secara berasingan atau bersesama dalam prosiding yang sama dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati bersalah atas kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu melainkan jika, setelah mengambil kira jenis fungsinya atas sifat itu dan semua hal keadaan, dia membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan itu telah dilakukan tanpa pengetahuan, kebenaran atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah mengambil semua langkah berjaga-jaga yang munasabah dan telah menjalankan usaha yang wajar untuk mengelakkan pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang akan boleh dikenakan di bawah Akta ini apa-apa hukuman atau penalti bagi apa-apa perbuatan, peninggalan, pengabaian atau kegagalannya, dia boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau kegagalan mana-mana pekerja atau Levi Keuntungan Luar Biasa ejennya, atau pekerja ejen itu, jika tindakan, peninggalan, pengabaian atau kegagalan itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam perjalanan pekerjaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen itu apabila bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen itu semasa dia digajikan oleh ejen itu atau selainnya bagi pihak ejen itu yang bertindak bagi pihak orang itu. Pemulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi atau yang berhubungan dengan apa- apa kesalahan di bawah Akta ini boleh dimulakan tanpa keizinan secara bertulis Pendakwa Raya. Menyubahati kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dengan sengaja membuat bagi pihak seorang lain, atau membantu, menyubahati, menolong, mengapikan atau mendorong mana-mana orang lain membuat suatu penyata, akaun atau pernyataan yang tidak betul yang mengakibatkan levi kurang dibayar oleh orang yang bertanggungjawab membayar levi itu maka orang yang mula-mula disebut itu adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh melebihi satu tahun atau kedua-duanya. Kuasa Menteri untuk memakai Akta Kastam 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan mana-mana peruntukan dalam Akta Kastam 1967 menjadi suatu peruntukan yang hendaklah terpakai bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menetapkan peruntukan Akta Kastam 1967 di bawah subseksyen (1), Menteri boleh membuat apa-apa ubahsuaian yang perlu dan suaimanfaat bagi maksud memastikan perjalanan wajar dan cekap Akta ini. Peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi maksud melaksanakan atau memberikan kuat kuasa kepada peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Khususnya dan tanpa menjejaskan keluasan kuasa yang diberikan oleh subseksyen (1), peraturan-peraturan itu boleh mengadakan peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara bagi pembayaran dan pemungutan levi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "borang yang diperlukan untuk bagi pemungutan levi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_28__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat dan masa berhubung dengan pemungutan levi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada arahan dan kawalan Menteri, Ketua Pengarah hendaklah mempunyai pengawasan ke atas semua perkara yang berhubungan dengan levi di bawah Akta ini. Kuasa pegawai kastam yang hak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai kastam yang hak hendaklah, sebagai tambahan kepada kewajipan dan kuasa yang diberikan di bawah Akta Kastam 1967, mempunyai segala kewajipan dan kuasa untuk menguatkuasakan dan memastikan pematuhan wajar peruntukan Akta ini. Kad kuasa hendaklah ditunjukkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai kastam yang hak apabila bertindak terhadap mana-mana orang di bawah Akta ini hendaklah, jika tidak berpakaian seragam, apabila diminta menyatakan jawatannya dan mengemukakan kepada orang yang terhadapnya dia bertindak itu dokumen yang membuktikan identitinya sebagaimana yang diarahkan oleh Ketua Pengarah supaya dibawa bersama oleh pegawai itu. Levi Keuntungan Luar Biasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tidaklah menjadi suatu kesalahan jika inana-mana orang enggan mematuhi apa-apa tuntutan yang dibuat oleh mana-mana pegawai yang bertindak atau berupa sebagai bertindak di bawah Akta ini jika pegawai itu tidak berpakaian seragam dan enggan menyatakan jawatannya dan mengemukakan dokumen pengenalannya apabila diminta berbuat demikian oleh orang itu. Pengenaan levi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dikenakan dan dilevikan suatu levi yang dinamai levi keuntungan luar biasa atas apa-apa amaun yang ditetapkan oleh Menteri melalui perintah yang disiarkan dalam Warta yang melebihi apa-apa amaun untung yang ditetapkan oleh Menteri dalam perintah itu dan diperoleh daripada pengeluaran barang-barang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perintah yang dibuat di bawah subseksyen (1) boleh menetapkan amaun dan kadar yang berlainan bagi jenis barang yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Levi hendaklah dibayar oleh pengeluar barang-barang ditetapkan dan hendaklah dibayar ke dalam Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak membayar apa-apa levi yang dikenakan di bawah seksyen ini adalah melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi sepuluh kali amaun levi yang kena dibayar atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendakwaan mana-mana orang di bawah seksyen ini tidaklah melepaskan orang itu daripada liabiliti untuk membayar apa-apa levi yang baginya dia bertanggungan atau mungkin bertanggungan atau daripada liabiliti untuk membuat apa-apa penyata yang dia dikehendaki supaya membuatnya oleh Akta ini. Perintah hendaklah dibentangkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Perintah yang menentukan amaun levi yang hendaklah dilevikan di bawah Akta ini hendaklah dibentangkan dalam mesyuarat Dewan Rakyat yang berikutnya. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perintah yang dibentangkan dalam mesyuarat Dewan Rakyat hendaklah terhenti berkuat kuasa apabila habis tempoh 120 hari dari tarikh pembentangannya atau apa-apa tempoh lanjutan sebagaimana yang diarahkan oleh Dewan Rakyat melalui ketetapan jika perintah itu tidak disahkan oleh suatu ketetapan yang diluluskan oleh Dewan Rakyat dalam tempoh atau tempoh lanjutan itu. Pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang mengeluarkan barang-barang ditetapkan hendaklah mendaftar dengan Jabatan. Penalti kerana pembayaran lambat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa amaun levi masih belum dibayar selepas hari terakhir levi itu kena dibayar, maka suatu penalti yang bersamaan dengan sepuluh peratus daripada amaun yang belum dibayar itu hendaklah dengan itu kena dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/38/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika levi yang genap masa dan kena dibayar itu masih belum dibayar selama lebih daripada tiga puluh hari selepas hari terakhir levi itu kena dibayar maka kadar penalti di bawah subseksyen (1) atas levi yang belum dibayar itu hendaklah ditambah sebanyak sepuluh peratus bagi tempoh tiga puluh hari yang kedua selepas hari terakhir itu dan bagi tiap-tiap tempoh tiga puluh hari yang berikutnya atau apa-apa bahagian daripadanya selama masa amaun itu masih belum dibayar hingga kepada maksimum sebanyak lima puluh peratus. Levi boleh dituntut sebagai hutang sivil"
      }
    }
  ]
}
