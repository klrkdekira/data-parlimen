      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply short title. (1997) Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~cl_2",
