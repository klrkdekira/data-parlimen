    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is authorized of a sum not exceeding Further seven billion and twenty million four hundred and twenty expenditure thousand and two hundred and sixty-three ringgit for the year (RM7,020,420,263) from the Consolidated Fund for 1997 expenditure on the services specified in the Schedule for the service of the year 1997, not provided for or not fully provided for by the Supply Act 1997, Supplementary Supply (1996 and 1997) Act 1997, the Act A990. Supplementary Supply (1997) Act 1997 and the Act A1002. Supplementary Supply (1997) (No. 2) Act 1997."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The said sum is appropriated for the purposes specified in the Schedule, Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/eng@/~sched_1",
