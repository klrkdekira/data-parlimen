      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (1997) 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tajuk Tambahan (1997) 1998 ringkas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dibenarkan supaya dikeluarkan Perbelanjaan sejumlah wang yang tidak melebihi tujuh bilion dua puluh tambahan juta empat ratus dua puluh ribu dua ratus enam puluh bagi tahun tiga ringgit (RM7,020,420,263) daripada Kumpulan Wang 1997 Disatukan bagi perbelanjaan untuk perkhidmatan yang dinyatakan dalam Jadual bagi perkhidmatan tahun 1997, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1997, Akta Akta A976. Perbekalan Tambahan (1996 dan 1997) 1997, Akta Akta A990 Perbekalan Tambahan (1997) 1997 dan Akta Perbekalan Akta A1002. Tambahan (1997) (No. 2) 1997. Akta A1008 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah wang yang tersebut itu adalah diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 2) Maksud Tajuk kepada Maksud B. 8 Jabatan Perkhidmatan Awam 30,308,862 B. 13 Pejabat Setiausaha Persekutuan, Sarawak B. 16 Jabatan Perkhidmatan Bomba 15,341,224 B. 24 Jabatan Muzium dan Antikuiti B. 25 Kementerian Pertahanan 138,027,952 B. 26 Kementerian Pendidikan 39,818,633 B. 27 Jabatan Perpustakaan Negara B. 30 Peruntukan kepada Kumpulan 6,692,199,889 Wang Terkanun B. 34 Kementerian Kesihatan B. 36 Polis Diraja Malaysia B. 40 Jabatan Penjara B. 45 Kementerian Sumber Manusia B. 47 Kementerian Pengangkutan B. 51 Kementerian Luar Negeri JUMLAH 7,020,420,263"
      }
    }
