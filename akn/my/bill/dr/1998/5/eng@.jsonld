      ],
      "schema:name": {
        "@language": "en",
        "@value": "Dangerous Drugs (Amendment) Bill 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Dangerous Drugs short title (Amendment) Act 1998 and shall come into force on a and date to be appointed by the Minister by notification in commence the Gazette. ment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Dangerous Drugs Act 1952, which in this Act Amendment is referred to as the \"principal Act\", is amended in section of section 2 2 by inserting after the definition of \"in transit\" the act 234 following definition: '\"licensed pharmacist\" means a registered pharmacist who is the holder of a Type A Licence Act 366. issued under the Poisons Act 1952;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3) by substituting for the word \"twenty\" the words \"one hundred\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(4) Any person who is a public officer employed at any prison, rehabilitation centre, police lock-up or place of detention shall, on his conviction under subsection (3) for contravening the provisions of subsection (2), be liable to whipping of not more than three strokes in addition to the punishment to which he is liable under subsection (3).\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 16(2) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for the words \"person who is licensed to 16. sell by retail poisons\" the words \"licensed pharmacist\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/5/eng@/~cl_5",
      "@type": "akn:clause",
