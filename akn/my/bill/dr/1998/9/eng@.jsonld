      ],
      "schema:name": {
        "@language": "en",
        "@value": "Courts of Judicature (Amendment) Bill 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Courts of Judicature (Amendment) Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Courts of Judicature Act 1964, which in this Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "is referred to as the \"principal Act\", is amended in section 3 by substituting for the definition of \"decision\" the following definition: ' \"decision\" means judgment, sentence or order, but does not include any ruling made in the course of a trial or hearing of any cause or matter which does not finally dispose of the rights of the parties;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 10(1) of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "inserting after the words \"the Yang di-Pertuan Agong\" the words \"on the recommendation of the Chief Justice\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by deleting the words \", if the parties consent,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 44 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for subsection (3) the following subsection: \"(3) Every order made under subsection (1) may, upon application by the aggrieved party made within ten days after the order is served, be affirmed, yaried or discharged by the Court.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 78 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by deleting the words \", if the parties consent,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 80 of the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for subsection (3) the following subsection: \"(3) Every order made under subsection (1) may, upon application by the aggrieved party made within ten days after the order is served, be affirmed, varied or discharged by the Court.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Section 96 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"granted in accordance with section 97\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words \"; and\" the words \"involving a question of general principle decided for the first time or a question of importance upon which further argument and a decision of the Federal Court would be to public advantage; or\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The amendment in subsection (1) shall apply to any application for leave to appeal pending in the Federal Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The amendment in subsection (1) shall not affect any order previously made by the Federal Court in respect of any application for leave to appeal and no such order shall be nullified. Courts of Judicature (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 97 of the principal Act is amended by inserting"
      },
      "schema:text": {
        "@language": "en",
        "@value": "after subsection (2) the following subsections: \"(3) Notwithstanding section 74, an application for leave to appeal to the Federal Court may be heard by a Judge of the Court, and any direction or order that could be given or made by the Court on such application may be given or made by such Judge. (4) Any direction or order given or made under subsection (3) may, upon application by the aggrieved party made within ten days after the direction or order is given or made, be affirmed, varied or discharged by the Court,\"."
      }
    }
  ]
}
