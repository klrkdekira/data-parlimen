      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 80 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Every order made under subsection (1) may, upon application by the aggrieved party made within ten days after the order is served, be affirmed, varied or discharged by the Court.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8",
