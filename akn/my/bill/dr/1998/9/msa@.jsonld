      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 96 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"granted in accordance with section 97\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan \"; and\" dengan perkataan \"involving a question of general principle decided for the first time or a question of importance upon which further argument and a decision of the Pederal Court would be to public advantage; or\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan dalam subseksyen (1) adalah terpakai bagi apa-apa permohonan bagi kebenaran untuk merayu yang masih belum selesai di Mahkamah Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan dalam subseksyen (1) tidaklah menyentuh apa-apa perintah yang dibuat sebelum ini oleh Mahkamah Persekutuan berkenaan dengan apa-apa permohonan bagi kebenaran untuk merayu dan tiada perintah sedemikian boleh dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 97 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(3) Notwithstanding section 74, an application for leave to appeal to the Federal Court may be heard by a Judge of the Court, and any direction or order that could be given or made by the Court on such application may be given or made by such Judge. (4) Any direction or order given or made under subsection (3) may, upon application by the aggrieved party made within ten days after the direction or order is given or made, be affirmed, varied or discharged by the Court.\"."
      }
    }
  ]
}
