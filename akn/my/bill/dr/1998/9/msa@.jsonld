      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Mahkamah Kehakiman (Pindaan) 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Mahkamah"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kehakiman (Pindaan) 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Mahkamah Kehakiman 1964, yang disebut \"Akta"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "ibu\" dalatn Akta ini, adalah dipinda dalam seksyen 3 dengan menggantikan takrif \"decision\" dengan takrif yang berikut: \"decision\" means judgment, sentence or order, but does not include any ruling made in the course of a trial or hearing of any cause or matter which does not finally dispose of the rights of the parties;'."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 10(1) Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan selepas perkataan \"the Yang di-Pertuan Agong\" perkataan \"on the recommendation of the Chief Justice\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu adalah dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan \", if the parties consent,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 44 Akta ibu adalah dipinda dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Every order made under subsection (1) may, upon application by the aggrieved party made within ten days after the order is served, be affirmed, varied or discharged by the Court.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1998/9/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
