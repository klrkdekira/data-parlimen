      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (1998 dan 1999) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (1998 dan 1999) 1999. Perbelanjaan tambahan bagi tahun 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi sembilan bilion enam ratus lima puluh sembilan juta tujuh ratus lima puluh ribu sembilan ratus enam belas ringgit (RM9,659,750,916) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual Pertama bagi tahun 1998, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1998[Akta A1009] dan Akta Perbekalan Tambahan (1998) 1998[Akta A1033]. Rang Undang-Undang Perbelanjaan tambahan bagi tahun 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi enam puluh juta ringgit (RM60,000,000) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual Kedua bagi tahun 1999, yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan l999[Akta A1044]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk Amaun B. 16 Jabatan Bomba dan Penyelamat 4,568,230 B. 20 Kementerian Perdagangan Antarabangsa 3,746,400 dan Industri B. 29 Perkhidmatan Am Perbendaharaan 206,420,560 B. 30 Peruntukan kepada Kumpulan Wang 9,409,450,403 Terkanun B. 32 Jabatan Hasil Dalam Negeri B. 40 Jabatan Penjara 1,641,163 B. 51 Kementerian Luar Negeri 33,502,298 JUMLAH 9,659,750,916"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk Amaun B. 49 Kementerian Tenaga, Komunikasi 60,000,000 dan Multimedia JUMLAH 60,000,000 Perbekalan Tambahan (1998 dan 1999)"
      }
    }
  ]
}
