      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Penyemakan Undang-Undang (Pindaan) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Penyemakan Undang- Undang (Pindaan) 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah disifatkan telah mula berkuat kuasa pada 1 Oktober 1998. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Penyemakan Undang-Undang 1968[Akta 1], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif \"enakmen\" takrif yang berikut: ' \"cetakan semula\" ertinya edisi cetakan semula mana- mana undang-undang, atau mana-mana jilid undang- undang sedemikian, yang disediakan dan diterbitkan menurut seksyen 3;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"undang-undang\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"atau mana-mana perundangan kecil\"; dan Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah dengan koma bertitik; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"undang-undang\" takrif yang berikut: ' \"undang-undang yang disemak\" ertinya edisi semakan mana-mana undang-undang yang disediakan dan diterbitkan menurut seksyen 3.'. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \", melalui pemberitahuan dalam Warta,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"bagi maksud menyemak undang-undang dari semasa ke semasa\" dengan perkataan \"dan Timbalan Pesuruhjaya Penyemak Undang-Undang untuk menyediakan dan menerbitkan undang-undang yang disemak dan cetakan semula\". Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 6(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (i)(a) subperenggan yang berikut: \"(aa) mana-mana peruntukan, atau bahagian sesuatu peruntukan, dalam mana-mana undang-undang yang tidak lagi berkuat kuasa;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (vii), dengan menggantikan perkataan \"dan hasyiah-hasyiah\" di mana-mana jua terdapat dengan perkataan \", susunan-susunan kronologi, rujukan-rujukan dan nota-nota\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (xx) perenggan yang berikut: \"(xxa) mengemaskinikan istilah dan ejaan dalam teks bahasa kebangsaan mana-mana undang-undang supaya selaras dengan istilah dan ejaan yang diluluskan oleh Dewan Bahasa dan Pustaka; (xxb) memotong apa-apa perkataan, ungkapan, tatanama atau peruntukan lain dalam mana-mana undang-undang yang tidak lagi digunakan atau tidak lagi berkuat kuasa, termasuk rujukan kepada undang-undang yang dimansuhkan, dan untuk menggantikannya jika perlu, dengan perkataan, ungkapan, tatanama atau peruntukan yang sesuai atau rujukan kepada undang-undang yang sesuai;\". Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 14(2) Akta ibu dipinda dengan menggantikan perkataan \"dan (xx)\" dengan perkataan \", (xx), (xxa) dan (xxb)\". Seksyen baru 14A, 14B dan 14c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 14 seksyen yang berikut: 14A. (1) Pesuruhjaya boleh, jika difikirkannya Penerbitan jilid demi suaimanfaat, membenarkan cetakan semula disediakan jilid. dan diterbitkan jilid demi jilid, mengikut apa-apa susunan dan pada bila-bila masa yang difikirkannya suaimanfaat. (2) Mana-mana jilid sesuatu cetakan semula boleh mengandungi apa-apa susunan, lampiran dan perkara tambahan yang lain, termasuk indeks, sebagaimana yang difikirkan perlu oleh Pesuruhjaya. Pengemas,- 14B. Pesuruhjaya boleh, jika difikirkannya suaimanfaat, kinian membenarkan penyediaan dan penerbitan laporan kemas cetakan semula. kini yang mengandungi pindaan terkini kepada sesuatu cetakan semula, mengikut apa-apa susunan dan pada bila- bila masa yang difikirkannya suaimanfaat. Pewakilan 14c. Pesuruhjaya boleh mewakilkan mana-mana kuasanya kuasa. di bawah seksyen 14(2), 1 4A dan 14B kepada Timbalan Pesuruhjaya.\". Rang Undang-Undang Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dalam teks bahasa kebangsaan dengan tnenggantikan perkataan \"perundangan kecil\" di mana-mana jua terdapat dengan perkataan \"perundangan subsidiari\"."
      }
    }
  ]
}
