      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Penerbangan Awam (Pindaan) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Penerbangan Awam (Pindaan) 1999. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Penerbangan Awam 1969[Akta 3], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam perenggan 3(2)(nn) dengan memasukkan selepas perkataan \"lapangan terbang\" perkataan \"atau selainnya\". Pindaan Bahagian VIIIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Bahagian VIIIA Akta ibu dipinda dengan memotong perkataan \"DI SESUATU LAPANGAN TERBANG\". Pindaan seksyen 24A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 24A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai dengan memotong perkataan \"di sesuatu lapangan terbang\"; Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dengan memasukkan selepas perkataan \"lapangan terbang\" perkataan \"atau selainnya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Pengeluaran lesen kepada sesuatu syarikat di bawah subseksyen (1) tidaklah mengenakan apa-apa tanggungan pada Kerajaan Malaysia bagi apa-apa kerugian, kerosakan, kecederaan atau kematian yang disebabkan oleh, atau berakibat daripada apa-apa insiden atau kemalangan kena lapor akibat, apa-apa perbuatan, ketinggalan atau kemungkiran syarikat itu. (4) Dalam seksyen ini— \"insiden\" ertinya sesuatu kejadian yang dikaitkan dengan pengendalian sesuatu kapal udara yang menjejaskan atau boleh menjejaskan keselamatan pengendaliannya; \"kemalangan kena lapor\" ertinya sesuatu kejadian yang berkaitan dengan pengendalian sesuatu kapal udara yang berlaku antara masa mana-mana orang menaiki kapal udara itu bagi maksud penerbangan sehingga suatu masa bila semua orang sudah turun dari kapal udara itu, dan dalam kejadian itu— (a) seseorang mati atau cedera parah atau serius akibat— (i) berada dalam kapal udara itu; (ii) bersentuhan secara langsung dengan mana-mana bahagian kapal udara itu, termasuklah bahagian yang menjadi terpisah daripada kapal udara itu; atau (iii) pendedahan langsung kepada bagas jet, kecuali apabila kematian atau kecederaan itu adalah disebabkan oleh sebab semula jadi, disengajakan atau disebabkan oleh orang lain, atau apabila kematian atau kecederaan itu berlaku Penerbangan Awam (Pindaan) kepada penumpang gelap yang bersembunyi di luar ruang yang kepadanya penumpang dan krew pada lazimnya ada akses; (b) kapal udara itu mengalami kerosakan atau kegagalan struktur yang— (i) memudaratkan kekuatan struktur, prestasi atau ciri-ciri penerbangan kapal udara itu; dan (ii) pada lazimnya memerlukan pembaikan yang besar atau penggantian komponen yang terjejas, kecuali bagi kegagalan enjin atau kerosakan, apabila kerosakan itu terhad kepada enjin atau penutup atau aksesorinya, atau bagi kerosakan yang terhad kepada bebaling, hujung sayap, antena, tayar, brek, reraut, kemek kecil atau lubang tebuk pada kulit kapal udara itu; atau (c) kapal udara itu hilang atau sama sekali tiada akses kepadanya.\". Penggantian seksyen 24B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 24B dengan seksyen yang berikut: 'caj dan 24B. Walau apa pun apa-apa peruntukan Akta ini atau fee yang Akta Prosedur Kewangan 1957, segala caj dan fee yang g n u p i d d i t e t a p k an di b a w ah p e r a t u r a n - p e r a t u r an y a ng d i b u at ut syarikat menurut seksyen 3, yang berkaitan dengan penjalanan mana-mana fungsi atau perkhidmatan oleh syarikat berlesen, hendaklah dipungut oleh, dan menjadi sebahagian daripada hasil, syarikat berlesen itu.\". Pindaan seksyen 24c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 24c(l) Akta ibu dipinda dengan menggantikan perkataan \"perenggan 3(2)(n) dan (nn)\" dengan perkataan \"seksyen 3, yang berkait dengan penjalanan mana-mana fungsi atau perkhidmatannya,\". Rang Undang-Undang Pindaan seksyen 24D"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 24D Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_a__subpara_nn",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"perenggan 3(2)(n) dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_a__subpara_nn",
      "@type": "akn:subparagraph",
      "eli:number": "nn",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "\" dengan perkataan \"seksyen 3\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/11/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"sedia ada\" perkataan \"yang berkait dengan penjalanan mana-mana fungsi atau perkhidmatan oleh syarikat berlesen\"."
      }
    }
  ]
}
