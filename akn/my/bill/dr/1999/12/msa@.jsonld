        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENUBUHAN SURUHANJAYA HAK ASASI MANUSIA MALAYSIA Penubuhan Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUASA SIASATAN SURUHANJAYA Suruhanjaya boleh menyiasat atas kehendak sendiri atau atas aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, atas kehendaknya sendiri atau atas suatu aduan yang dibuat kepada Suruhanjaya oleh orang atau kumpulan orang yang terkilan atau seseorang yang bertindak bagi pihak orang atau sekumpulan orang yang terkilan, menyiasat pengataan mengenai pelanggaran hak asasi manusia orang atau kumpulan orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya tidaklah boleh menyiasat apa-apa aduan yang berhubungan dengan apa-apa pengataan pelanggaran hak asasi manusia yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan hal perkara apa-apa prosiding yang belum selesai di mana-mana mahkamah, termasuklah apa-apa rayuan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "telah diputuskan secara muktamad oleh mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya menyiasat suatu pengataan di bawah subseksyen 12(1) dan sementara menunggu penyelesaian siasatan itu, pengataan itu menjadi hal perkara mana-mana prosiding di mana-mana mahkamah, Suruhanjaya hendaklah berhenti dengan serta-merta daripada melakukan siasatan itu. Tatacara jika pelanggaran tidak didedahkan atau didedahkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu siasatan yang dijalankan oleh Suruhanjaya di bawah seksyen 12 tidak mendedahkan pelanggaran hak asasi manusia, Suruhanjaya hendaklah merekodkan dapatan itu dan hendaklah dengan serta-merta memberitahu orang yang membuat aduan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu siasatan yang dijalankan oleh Suruhanjaya di bawah seksyen 12 mendedahkan pelanggaran hak asasi manusia, Suruhanjaya hendaklah mempunyai kuasa untuk merujuk perkara itu, jika berkenaan, kepada pihak berkuasa atau orang yang berkaitan itu dengan syor yang perlu. Kuasa yang berhubungan dengan siasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, bagi maksud sesuatu siasatan di bawah Akta ini, mempunyai kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan dan menerima segala keterangan, bertulis atau lisan, dan untuk memeriksa semua orang sebagai saksi, sebagaimana yang difikirkan oleh Suruhanjaya perlu atau patut didapatkan atau diperiksa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki supaya keterangan itu, sama ada bertulis atau lisan, mana-mana saksi dibuat dengan bersumpah atau berikrar, sumpah atau ikrar itu yang berupa sumpah atau ikrar yang dikehendaki daripada saksi itu jika saksi itu memberikan keterangan dalam mahkamah undang- undang, dan untuk mentadbirkan atau menyebabkan di- tadbirkan oleh seseorang pegawai yang diberi kuasa bagi maksud itu oleh Suruhanjaya, suatu sumpah atau ikrar kepada tiap-tiap saksi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memanggil mana-mana orang yang bermastautin di Malaysia supaya menghadiri mana-mana mesyuarat Suruhanjaya bagi memberikan keterangan atau mengemukakan apa-apa dokumen atau benda lain yang ada dalam miliknya, dan untuk memeriksa orang itu sebagai saksi atau menghendakinya mengemukakan apa-apa dokumen atau benda lain yang ada dalam miliknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima, walau apa pun apa-apa peruntukan Akta Keterangan 1950 [Akta 56], apa-apa keterangan, sama ada bertulis atau lisan, yang tidak boleh diterima dalam prosiding sivil atau jenayah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membenarkan atau tidak membenarkan orang ramai mengikuti siasatan itu atau mana-mana bahagian siasatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (1)(c), jika orang yang dipanggil ialah seseorang yang berada dalam tahanan di bawah mana-mana undang-undang bertulis lain, saman itu hendaklah dikeluarkan mengikut undang-undang yang terpakai yang berhubungan dengan tempat tahanan itu. Keterangan di hadapan Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang memberikan keterangan di hadapan Suruhanjaya hendaklah, berkenaan dengan keterangan itu, berhak mendapat segala keistimewaan yang berhak diberikan kepada seseorang saksi yang memberikan keterangan di hadapan mahkamah undang-undang berkenaan dengan keterangan yang diberikan olehnya di hadapan mahkamah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, berkenaan dengan apa-apa keterangan, bertulis atau lisan, yang diberikan oleh orang itu kepada atau di hadapan Suruhanjaya, dikenakan apa-apa tindakan atau prosiding, sivil atau jenayah dalam mana-mana mahkamah kecuali apabila orang itu dipertuduh memberikan atau merekakan keterangan palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya boleh dipecat daripada jawatan oleh Yang di-Pertuan Agong jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota itu dihukumkan tak solven oleh mahkamah berbidang kuasa berwibawa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong, setelah berunding dengan seorang pegawai perubatan atau pengamal perubatan berdaftar, berpendapat bahawa anggota itu tidak berupaya dari segi fizikal atau mental untuk terus memegang jawatannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota itu tidak menghadiri tiga kali berturut-turut mesyuarat Suruhanjaya tanpa mendapat kebenaran Suruhanjaya atau, dalam hal Pengerusi, tanpa kebenaran Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong, atas syor Perdana Menteri, berpendapat bahawa anggota itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melibatkan diri dalam apa-apa jawatan atau pekerjaan bergaji yang bercanggah dengan kewajipannya sebagai seorang anggota Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "telah berkelakuan salah atau berkelakuan sedemikian cara hingga mencemarkan nama Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_10__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "telah bertindak melanggar Akta ini dan bercanggah dengan kewajipannya sebagai anggota Suruhanjaya. Peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya boleh pada bila-bila masa meletakkan jawatannya melalui surat yang ditujukan kepada Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka adalah dengan ini ditubuhkan suatu Suruhanjaya yang hendaklah dikenali sebagai Suruhanjaya Hak Asasi Manusia Malaysia (\"Suruhanjaya\")."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menjadi suatu pertubuhan perbadanan yang kekal turun-temurun dan mempunyai suatu meterai biasa, yang boleh mendakwa dan didakwa atas namanya dan tertakluk kepada dan bagi maksud Akta ini, boleh membuat kontrak dan boleh memperoleh, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih dan harta tak alih dan boleh memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai janji, mendemis, menyerahhakkan semula, memindahkan hakmilik atau dengan apa-apa cara lain melupuskan, atau membuat apa-apa urusan mengenai, apa-apa harta alih atau harta tak alih atau apa-apa kepentingan mengenainya yang terletak hak pada Suruhanjaya, atas apa-apa terma sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai suatu meterai biasa yang mengandungi apa-apa peranti sebagaimana yang diluluskan oleh Suruhanjaya dan meterai itu boleh dipecahkan, ditukar, diubah atau dibuat baharu sebagaimana yang difikirkan patut oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa itu hendaklah disimpan dalam jagaan Setiausaha kepada Suruhanjaya atau mana-mana orang lain yang diberi kuasa oleh Suruhanjaya dan hendaklah disahkan oleh Setiausaha atau orang yang diberi kuasa itu atau oleh mana-mana pegawai yang diberi kuasa oleh Setiausaha atau orang yang diberi kuasa itu secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala surat ikatan, dokumen dan surat cara lain yang berupa sebagai dimeteraikan dengan meterai biasa itu, yang disahkan sebagaimana yang dinyatakan dalam subseksyen (4), hendaklah disifatkan telah disempurnakan dengan sah sehingga dibuktikan sebaliknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai biasa Suruhanjaya hendaklah diberikan pengiktirafan rasmi dan kehakiman. Fungsi dan kuasa Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi membantu melindungi dan memajukan hak asasi manusia di Malaysia, fungsi Suruhanjaya adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memupuk kesedaran dan menyediakan pendidikan yang berhubungan dengan hak asasi manusia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati dan membantu Kerajaan dalam merumuskan perundangan dan arahan dan tatacara pentadbiran dan mengesyorkan langkah-langkah perlu yang hendaklah diambil;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengesyorkan kepada Kerajaan berkenaan dengan penandatanganan atau penyertaan dalam triti dan surat cara antarabangsa yang lain dalam bidang hak asasi manusia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyiasat aduan berkenaan dengan pelanggaran hak asasi manusia yang disebut dalam seksyen 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud melaksanakan fungsinya, Suruhanjaya boleh menjalankan mana-mana atau kesemua kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memupuk kesedaran mengenai hak asasi manusia dan untuk mengaku janji mengadakan penyelidikan dengan mengendalikan program, seminar dan bengkel dan untuk menyebarkan dan mengedarkan hasil penyelidikan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Kerajaan dan/atau pihak berkuasa yang berkaitan mengenai aduan terhadap pihak berkuasa itu dan mengesyorkan kepada Kerajaan dan/atau pihak berkuasa itu langkah-langkah sesuai yang hendaklah diambil;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji dan menentusahkan apa-apa pelanggaran hak asasi manusia mengikut peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melawat tempat tahanan mengikut tatacara yang ditetapkan oleh undang-undang yang berhubungan dengan tempat tahanan itu dan untuk membuat syor yang perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengeluarkan pernyataan awam mengenai hak asasi manusia apabila perlu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengaku janji apa-apa aktiviti sesuai lain yang perlu mengikut undang-undang bertulis yang berkuat kuasa, jika ada, berhubung dengan aktiviti itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Lawatan oleh Suruhanjaya ke mana-mana tempat tahanan di bawah perenggan (2)(d) tidaklah boleh dihalang oleh orang yang menjaga tempat tahanan itu jika tatacara yang diperuntukkan oleh undang-undang yang mengawal selia tempat tahanan itu dipatuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, perhatian hendaklah diberikan kepada Perisytiharan Sejagat Hak Asasi Manusia 1948 setakat yang perisytiharan itu tidak tak selaras dengan Perlembagaan Persekutuan. Anggota Suruhanjaya dan tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah terdiri daripada tidak lebih daripada dua puluh orang anggota."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota-anggota Suruhanjaya hendaklah dilantik oleh Yang di-Pertuan Agong, atas syor Perdana Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota-anggota Suruhanjaya hendaklah dilantik daripada kalangan tokoh terkenal termasuk mereka yang datang daripada berbagai latar belakang agama dan kaum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota hendaklah memegang jawatan selama tempoh dua tahun dan layak dilantik semula. Pengerusi dan Naib Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong hendaklah menetapkan salah seorang daripada anggota yang dilantik di bawah seksyen 5 menjadi Pengerusi Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh jawatan Pengerusi adalah selama tempoh keanggotaannya dalam Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Naib Pengerusi bolehlah dipilih oleh anggota Suruhanjaya daripada kalangan mereka sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi Suruhanjaya atas apa-apa sebab tidak dapat melaksanakan fungsi Pengerusi, atau semasa apa-apa tempoh kekosongan jawatan Pengerusi, Naib Pengerusi hendaklah melaksanakan fungsi Pengerusi. Mesyuarat Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Suruhanjaya hendaklah mempengerusikan kesemua mesyuarat Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak menghadiri mesyuarat, Naib Pengerusi Suruhanjaya hendaklah mempengerusikan mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum dalam semua mesyuarat ialah dua pertiga daripada bilangan anggota Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota-anggota Suruhanjaya hendaklah berusaha untuk mencapai segala keputusan mesyuarat secara sebulat suara yang jika gagal, keputusan oleh majoriti dua pertiga anggota yang hadir adalah dikehendaki."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menentukan perjalanan prosidingnya sendiri. Saraan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Suruhanjaya hendaklah dibayar saraan dan elaun yang ditentukan oleh Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Suruhanjaya hendaklah dibayar elaun pada kadar yang ditentukan oleh Yang di-Pertuan Agong. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Suruhanjaya hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila anggota itu mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila anggota itu meletakkan jawatan melalui surat yang ditujukan kepada Yang di-Pertuan Agong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila tamat tempoh jawatannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila anggota itu dipecat daripada jawatan atas apa- apa alasan yang dinyatakan dalam seksyen 10. Kehilangan kelayakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KAKITANGAN SURUHANJAYA Pelantikan Setiausaha dan kakitangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah melantik seorang Setiausaha kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh melantik pegawai dan pekhidmat lain yang perlu bagi membantu Suruhanjaya menjalankan fungsinya di bawah Akta ini. Pewakilan kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mewakilkan kepada mana-mana pegawai yang disebut dalam subseksyen 16(2) mana-mana kuasanya, dan pegawai yang kepadanya kuasa itu diwakilkan boleh menjalankan kuasa itu tertakluk kepada arahan Suruhanjaya. Pelindungan anggota, pegawai dan pekhidmat Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding boleh dimulakan dalam mana-mana mahkamah terhadap Suruhanjaya atau terhadap mana-mana anggota, pegawai, atau pekhidmat Suruhanjaya berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang telah dilakukan olehnya atas sifat itu dengan syarat bahawa pada masa itu, dia menjalankan fungsinya dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota, pegawai atau pekhidmat Suruhanjaya tidaklah boleh dikehendaki mengemukakan dalam mana-mana mahkamah, apa-apa dokumen yang diterima oleh, atau mendedahkan kepada mana-mana mahkamah, apa-apa perkara atau benda yang sampai kepada pengetahuan, Suruhanjaya dalam perjalanan apa- apa siasatan yang dijalankan oleh Suruhanjaya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding, sivil atau jenayah boleh dimulakan dalam mana-mana mahkamah terhadap mana-mana anggota Suruhanjaya berkenaan dengan apa-apa laporan yang dibuat oleh Suruhanjaya di bawah Akta ini atau terhadap mana-mana orang lain berkenaan dengan penyiaran oleh orang itu suatu keterangan yang pada matannya benar mengenai laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab IX dan X Kanun Keseksaan [Akta 574] hendaklah terpakai bagi anggota, pegawai dan pekhidmat Suruhanjaya seolah-olah sebutan mengenai \"pekhidmat awam\" telah digantikan dengan \"anggota, pegawai atau pekhidmat Suruhanjaya\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Hak Asasi Manusia Malaysia 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan yang disiarkan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "\"hak asasi manusia\" merujuk kepada kebebasan asasi sebagaimana yang termaktub dalam Bahagian II Perlembagaan Persekutuan; \"Kerajaan\" ertinya Kerajaan Malaysia; \"Menteri\" ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi hak asasi manusia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Dana"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan hendaklah menyediakan bagi Suruhanjaya, dana yang mencukupi secara tahunan bagi membolehkan Suruhanjaya menjalankan fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya tidaklah boleh menerima apa-apa dana asing. Suruhanjaya HakAsasi Manusia Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), Suruhanjaya boleh menerima dana tanpa apa-apa syarat daripada mana-mana individu atau pertubuhan hanya bagi maksud memupuk kesedaran dan menyediakan pendidikan berhubungan dengan hak asasi manusia sebagaimana yang diluluskan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyebabkan akaun beraudit yang sepatutnya mengenai pendapatan dan perbelanjaannya, dan aset dan liabilitinya disimpan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Suruhanjaya ialah tahun kalendar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dilakukan oleh Suruhanjaya dalam mana-mana tindakan atau prosiding, sivil atau jenayah, yang dibawa oleh atau terhadap Suruhanjaya di hadapan mana-mana mahkamah hendaklah dibayar daripada dana Suruhanjaya dan apa-apa kos yang dibayar kepada, atau didapatkan oleh, Suruhanjaya dalam mana-mana tindakan atau prosiding, sivil atau jenayah, hendaklah dikreditkan ke dalam dana Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dilakukan oleh mana-mana anggota, pegawai atau pekhidmat Suruhanjaya, dalam mana-mana tindakan atau prosiding sivil, yang dibawa terhadapnya dalam mana- mana mahkamah berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa dilakukan olehnya di bawah Akta ini atau atas arahan Suruhanjaya hendaklah dibayar daripada dana Suruhanjaya, melainkan jika perbelanjaan itu didapatkan olehnya dalam tindakan atau prosiding sivil itu. Pemakaian Akta 240"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Suruhanjaya. Laporan tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah tidak terkemudian daripada mesyuarat pertama Parlimen bagi tahun yang berikutnya, mengemukakan suatu laporan tahunan kepada Parlimen mengenai segala aktivitinya di sepanjang tahun yang dimaksudkan oleh laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Laporan itu hendaklah mengandungi suatu senarai segala perkara yang dirujuk kepada Suruhanjaya, dan tindakan yang diambil berkenaan dengannya berserta syor Suruhanjaya berkenaan dengan setiap perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, bila mana dianggapnya perlu berbuat demikian, mengemukakan laporan khas kepada Parlimen berkenaan dengan apa-apa perkara tertentu yang dirujuk kepadanya dan tindakan yang diambil berkenaan dengan perkara itu. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi maksud menjalankan atau melaksanakan peruntukan Akta ini, termasuklah menetapkan tatacara yang kena diikuti dalam menjalankan siasatan di bawah Akta ini. Kuasa untuk membuat peraturan-peraturan tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dengan kelulusan Menteri, membuat apa-apa peraturan sebagaimana yang difikirkannya perlu atau suaimanfaat untuk mengadakan peruntukan bagi tatatertib pegawai dan pekhidmat Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_V__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana peraturan tatatertib dibuat di bawah seksyen ini, Suruhanjaya hendaklah menyebabkan notis mengenai kuat kuasa peraturan-peraturan itu diberikan mengikut apa-apa cara sebagaimana yang difikirkannya perlu bagi membawanya kepada perhatian kesemua pegawai dan pekhidmat Suruhanjaya yang tersentuh oleh peraturan-peraturan itu dan peraturan-peraturan itu hendaklah, walau apa pun seksyen 19 dan 20 Akta Tafsiran 1948 dan 1967 [Akta 388], mempunyai kuat kuasa sebaik sahaja notis itu diberikan tanpa disiarkan dalam Warta."
      }
    }
  ]
}
