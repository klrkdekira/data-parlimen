      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Suruhanjaya Hak Asasi Manusia Malaysia 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_I",
