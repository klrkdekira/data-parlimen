      "schema:text": {
        "@language": "ms",
        "@value": "PERMULAAN Tajuk ringkas dan permulaan kuat kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/12/msa@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
