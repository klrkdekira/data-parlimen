        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "South Indian Labour Fund (Dissolution) Bill 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, all written laws, including subsidiary legislation, affecting or for the protection of the Board and in force immediately before the appointed date shall, until amended or revoked by the appropriate authority having power so to do, continue in force and be construed as if this Act had not been enacted; and any reference in such written laws to the Board shall, unless the context otherwise requires, be construed as a reference to the Government, and expressions importing such a reference shall be construed accordingly. Prevention of difficulties or anomalies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "If any difficulty or anomaly arises in connection with the implementation of this Act, the Minister may by order make such modifications to any provision of this Act as may appear to him to be necessary for removing or preventing such difficulty or anomaly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall not exercise the powers conferred by subsection (1) after the expiration of three years from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"modifications\" includes amendments, additions, deletions, substitutions, adaptations, variations, alteration and non-application of any provision of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the South Indian Labour Fund (Dissolution) Act 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"appointed date\" means the date appointed by the Minister under section I; \"Board\" means the South Indian Labour Fund Board established under section 3 of the South Indian Labour Fund Act 1958 [Act 496]; \"Fund\" means the South Indian Labour Fund established under section 6 of the South Indian Labour Fund Act 1958; \"Government\" means the Federal Government; \"Minister\" means the Minister charged with the responsibility for human resources. Repeal and dissolution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The South Indian Labour Fund Act 1958 is repealed and the Board and the Fund established under that Act are dissolved. Transfer of powers, rights, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All powers, rights, privileges, duties, liabilities and obligations which immediately before the appointed date were those of the Board shall, as from that date, devolve on the Government. Transfer of property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All lands which immediately before the appointed date were vested in the Board shall, on the appointed date, vest in the Federal Lands Commissioner for the purposes of the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All property and assets other than land which immediately before the appointed date were vested in the Board or in any person or body acting on its behalf shall on that date vest in the Government. Transfer of funds"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All moneys in the Fund or due to the Board shall, on the appointed date, be transferred to and vest in the Government. Existing contracts, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, bonds, agreements, instruments and working arrangements subsisting immediately before the appointed date and affecting any property or money transferred under sections 5 and 6 shall be of as full force and effect against or in favour of the Government and enforceable as fully and effectually as if, instead of the Board or any person or body acting on its behalf, the Government had been named therein or had been a party thereto. Payment of allowance, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every South Indian labourer who, immediately before the appointed date, was—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "residing in the Home for Aged South Indian Labourers; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "registered with the Board, and receiving any allowance, maintenance or other financial assistance or any welfare assistance or other benefit from the Fund shall, on and after the appointed date, be entitled to continue to receive such allowance, maintenance, financial assistance, welfare assistance or benefit from the Government at such rates as may be approved by the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"South Indian labourer\" means any labourer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whose mother tongue is, or the mother tongue of either of whose parents was, Tamil, Telegu, Malayalam, Canarese or Uriya; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who was born in, or is descended from persons who were born in, South India. Continuation of civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings or cause of action pending or existing immediately before the appointed date by or against the Board or any person or body acting on its behalf may be continued or instituted by or against the Government as it might have been continued or instituted by or against the Board or such person or body if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/14/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought, or any leave to appeal applied for, on or after the appointed date against a decision given before the appointed date in any legal proceedings to which the Board or any person or body acting on its behalf was a party may be brought by or against the Government as it might have been brought by or against the Board if this Act had not been enacted. Continuance of laws, etc."
      }
    }
  ]
}
