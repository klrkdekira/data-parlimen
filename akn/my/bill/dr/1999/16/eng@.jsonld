      "schema:name": {
        "@language": "en",
        "@value": "Supplementary Supply (1999) Bill 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (1999) Act 1999. Further expenditure for the year 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding five hundred and fifty-six million seven hundred and fifty-two thousand and three hundred ringgit (RM556,752,300) from the Consolidated Fund for expenditure on the services and purposes specified in the Schedule for the year 1999, not provided for or not fully provided for by the Supply Act 1999 [Act A1044] and the Supplementary Supply (1998 and 1999) Act 1999 [Act A1047]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 4 Election Commission B. 7 Prime Minister's Department B. 8 Public Services Department B. 17 Ministry of Youth and Sports B. 18 Ministry of Primary Industries Bill Purpose Title B. 19 Ministry of Agriculture B. 21 Ministry of Domestic Trade and Consumer Affairs B. 25 Ministry of Defence B. 26 Ministry of Education B. 29 Treasury General Services B. 36 Royal Malaysia Police B. 47 Ministry of Transport B. 48 Ministry of Rural Development B. 50 Ministry of Entrepreneur Development B. 52 Ministry of Works TOTAL"
      }
    }
