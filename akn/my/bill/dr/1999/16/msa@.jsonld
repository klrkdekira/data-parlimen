      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (1999) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (1999) 1999. Perbelanjaan tambahan bagi tahun 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi lima ratus lima puluh enam juta tujuh ratus lima puluh dua ribu tiga ratus ringgit (RM556,752-,300) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi perkhidmatan tahun 1999 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 1999 [Akta A1044] dan Akta Perbekalan Tambahan (1998 dan 1999) 1999 [Akta A1047]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 4 Suruhanjaya Pilihanraya B. 7 Jabatan Perdana Menteri Rang Undang-Undang Maksud Tajuk B. 8 Jabatan Perkhidmatan Awam B. 17 Kementerian Belia dan Sukan B. 18 Kementerian Perusahaan Utama B. 19 Kementerian Pertanian B. 21 Kementerian Perdagangan Dalam Negeri dan Hal Ehwal Pengguna B. 25 Kementerian Pertahanan B. 26 Kementerian Pendidikan B. 29 Perkhidmatan Am Perbendaharaan B. 36 Polis Diraja Malaysia B. 47 Kementerian Pengangkutan B. 48 Kementerian Pembangunan Luar Bandar B. 50 Kementerian Pembangunan Usahawan B. 52 Kementerian Kerja Raya JUMLAH"
      }
