        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VII__cl_52"
      ],
