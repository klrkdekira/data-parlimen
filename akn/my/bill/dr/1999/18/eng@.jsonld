        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "goods attached to, or incorporated in, any real or personal property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "animals, including fish;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "vessels and vehicles;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "utilities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "trees, plants and crops whether on, under or attached to land or not, but does not include choses in action, including negotiable instruments, shares, debentures and money; \"healthcare facility\" means any premises in which one or more members of the public receive healthcare services; \"healthcare professional\" includes a medical practitioner, dental practitioner, pharmacist, clinical psychologist, nurse, midwife, medical assistant, physiotherapist, occupational therapist and other allied healthcare professional and any other person involved in the giving of medical, health, dental, pharmaceutical or any other healthcare services; \"healthcare services\" includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "medical, dental, nursing, midwifery, allied health, pharmacy, and ambulance services and any other service provided by a healthcare professional;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "accommodation for the purpose of any healthcare sevice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any service for the screening, diagnosis or treatment of persons suffering from, or believed to be suffering from any disease, injury or disability of mind or body;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any service for preventive or promotive health purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any service by any healthcare para-profesional;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any service for curing or alleviating any abnormal condition of the human body by the application of any apparatus, equipment, instrument or device or any other medical technology; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any health related services including alternative and traditional medical services; \"manufacturer\" means a person who carries on a business of assembling, producing or processing goods, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6",
      "@type": "akn:list",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "any person who holds himself out to the public as a manufacturer of the goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "any person who affixes his brand or mark, or causes or permits his brand or mark to be affixed, to the goods; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "where goods are manufactured outside Malaysia and the foreign manufacturer of the goods does not have an ordinary place of business in Malaysia, a person who imports or distributes those goods; \"premises\" means any place, building or vehicle, whether permanent or temporary; \"prescribed\" means prescribed by or under this Act or any regulations made under this Act, and where no mode is mentioned, means prescribed from time to time by order published in the Gazette; \"price\" includes consideration in any form, whether direct or indirect, and includes any consideration that in effect relates to the acquisition or supply of goods or services although ostensibly relating to any other matter or thing; \"publication\" includes advertisement to the public or any member of the public by any means, and \"publish\" shall be construed accordingly; \"record\" includes account books, bank books, vouchers, receipts, correspondence and any other document regardless of whether the record is on paper or is in electronic, photographic or other form but does not include patient medical record; \"regulations\" means regulations made under this Act; \"security\" includes any charge or encumbrance; \"services\" includes any rights, benefits, privileges or facilities that are or are to be provided, granted or conferred under any contract but does not include rights, benefits or privileges in the form of the supply of goods or the performance of work under a contract of service; \"subsidiary\" has the same meaning as given in the Companies Act 1965 [Act 125]; \"supplier\" means a person who, in trade—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7",
      "@type": "akn:list",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "supplies goods to a consumer by transferring the ownership or the possession of the goods under a contract of sale, exchange, lease, hire or hire-purchase to which that person is a party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "supplies services to a consumer, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where the rights of the supplier have been transferred by assignment or by operation of law, the person for the time being entitled to those rights;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a financier who has lent money on the security of goods supplied to a consumer, if the whole or any part of the price of the goods is to be paid out of the proceeds of the loan and if the loan was arranged by a person who, in trade, supplied the goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a person who, in trade, assigns or procures the assignment of goods to a financier to enable the financier to supply those goods, or goods of that kind, to the consumer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a person who, in trade, is acting as agent for another person where that other person is not supplying in trade; \"supply\", in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8",
      "@type": "akn:list",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "goods, means to supply or resupply by way of sale, exchange, lease, hire or hire-purchase;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "services, means to provide, grant or confer; \"this Act\" includes any subsidiary legislation made under this Act; \"trade\" means any trade, business, industry, profession, occupation, activity of commerce or undertaking relating to the supply or acquisition of goods or services; \"Tribunal\" means the Tribunal for Consumer Claims established under section 85."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, a reference to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "engaging in a conduct shall be read as a reference to doing or refusing to do an act, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "omitting to do an act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "making it known that an act will or, as the case may be, will not, be done;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the acquisition of goods includes a reference to the acquisition of property in or rights in relation to goods pursuant to a supply of the goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the supply or acquisition of goods or services includes a reference to the agreement to supply or acquire goods or services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the supply or acquisition of goods includes a reference to the supply or acquisition of goods together with other goods or services or both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the supply or acquisition of services includes a reference to the supply or acquisition of services together with other goods or services or both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the resupply of goods acquired from a person includes a reference to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "a supply of goods to another person in an altered form or condition; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "a supply to another person of other goods in which the acquired goods have been incorporated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, where it is necessary to determine the time at which a guarantee commences to apply—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "goods shall be treated as supplied at the time when the consumer acquires the right to possess the goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "services shall be treated as supplied at the time when the services are provided, granted or conferred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, an undertaking, assertion or representation by any name shall be deemed to be an express guarantee if it has the same or substantially the same effect as an express guarantee. Ouster of choice of law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall have effect notwithstanding any contract term which applies or purports to apply the law of another country where the term appears to the court to have been imposed wholly or mainly for the purpose of enabling the party imposing it to evade the operation of this Act. Savings for other relevant legislation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall remove or restrict the effect of, or prevent reliance on—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any written law which imposes on the supplier a duty stricter than that imposed under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any written law by which any term not inconsistent with this Act is to be implied in a contract for the supply of any goods or services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any written law relating to contracts of employment or contracts of apprenticeship; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any term in any agreement in writing between a supplier and a consumer to the extent that the term—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "imposes a stricter duty on the supplier than that imposed under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_5__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "provides a remedy more advantageous to the consumer than the remedies provided under this Act. No contracting out"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this Act shall have effect notwithstanding anything to the contrary in any agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every supplier and every manufacturer who purports to contract out of any provision of this Act commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) shall prevent a consumer who has a claim under this Act from agreeing to settle or compromise that claim. Appointment of Controller, Deputy Controllers, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint, from among public officers, a Controller of Consumer Affairs and such number of Deputy Controllers of Consumer Affairs, Assistant Controllers of Consumer Affairs and other officers as may be necessary for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Controller shall, subject to the general direction and control of the Minister, perform the functions and duties imposed and exercise the powers conferred upon him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Controllers, Assistant Controllers and other officers appointed under subsection (1) shall be under the direction and control of the Controller."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A Deputy Controller may perform all the functions and duties imposed and exercise all the powers conferred upon the Controller under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "All officers appointed under this section shall be deemed to be public servants within the meaning of the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_V__cl_38"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GUARANTEES IN RESPECT OF SUPPLY OF GOODS Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI",
