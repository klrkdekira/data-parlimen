      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the display of notices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by means of catalogues, price lists, circulars, labels, cards or other documents or materials;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the exhibition of films or of pictures or photographs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "by means of radio, television, telecommunication or any other similar means; \"business\" means any undertaking that is carried on whether for gain or reward or not and in the course of which goods or services are acquired or supplied whether at a price or otherwise; \"consumer\" means a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "acquires or uses goods or services of a kind ordinarily acquired for personal, domestic or household purpose, use or consumption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "does not acquire or use the goods or services, or hold himself out as acquiring or using the goods or services, primarily for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "resupplying them in trade;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "consuming them in the course of a manufacturing process; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of goods, repairing or treating, in trade, other goods or fixtures on land; \"Controller\", \"Deputy Controller\" and \"Assistant Controller\" mean persons appointed as such under section 7; \"Council\" or \"National Consumer Advisory Council\" means the council established under section 73; \"credit instrument\" means any agreement, oral or written, acknowledging an obligation to pay a sum or sums of money on demand, or at any future time or times; \"goods\" means goods which are primarily purchased, used or consumed for personal, domestic or household purposes, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4",
      "@type": "akn:list",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_4__para_a",
