    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_123",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_124",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_126",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_135",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_136",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_138",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller shall have the power to investigate the commission of any offence under this Act. Authority cards"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller when acting under this Act shall on demand declare his office and produce to the person against whom he is acting or from whom he seeks any information such authority card as the Controller may direct to be carried by such officer. Search by warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath and after such enquiry as he considers necessary, that there is reasonable cause to believe that in any premises there is or has been any contravention of this Act, the Magistrate may issue a warrant authorizing any Assistant Controller named therein to enter the premises at any reasonable time by day or by night, with or without assistance and if need be by force, and there to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "search for and seize any goods, thing, book, document, record or other article that is reasonably believed to furnish evidence of the contravention of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "take samples of any goods or thing found in the premises for the purpose of ascertaining, by testing or otherwise, whether an offence has been committed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make copies of or take extracts from any book, document, record or other article found in the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "Where, by reason of their nature, size or amount, it is not practicable to remove any goods, thing, book, document, record or other article seized under subsection (1), the Assistant Controller shall, by any means, seal such goods, thing, book, document, record or other article in the premises or container in which they are found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be an offence for.any person without lawful authority to break, tamper with or damage the seal referred to in subsection (2) or to remove any goods, thing, book, document, record or other article under seal or to attempt to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller entering any premises under this section may take with him such other persons and equipment as may appear to him to be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller may in the exercise of his powers under this section, if it is necessary so to do,—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door of the premises and enter, into the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "forcibly enter the premises and every part of the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to entry, search, seizure or removal as he is empowered to effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_125__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "detain every person found in the premises until the place has been searched. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "If an Assistant Controller in any of the circumstances referred to in section 125 has reasonable cause to believe that by reason of delay in obtaining a search warrant under that section the investigation would be adversely affected or evidence of the contravention is likely to be tampered with, removed, damaged or destroyed, such officer may enter such premises and exercise in, upon and in respect of, the premises all the powers referred to in section 125 in as full and ample a manner as if he were authorized to do so by a warrant issued under that section. List of things seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsections (2) and (3), where any goods, things, books, documents, records or other articles are seized under this Part, the seizing officer shall prepare a list of the things seized and immediately deliver a copy signed by him to the occupier of the premises which has been searched under section 125 or 126, or to his agent or servant, at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "Where goods are seized from a vending machine, the seizing officer shall immediately deliver a copy of the list signed by him to the person whose name and address are stated on the machine as being the proprietor or, if no name or address is so stated, the occupier of the premises on which the machine is installed or to which it is affixed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "Where the premises are unoccupied, the seizing officer shall whenever possible post a list of the things seized conspicuously on the premises. Power to require attendance of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller making an investigation under this Act may by order in writing require the attendance before himself of any person who appears to the Assistant Controller to be acquainted with the facts and circumstances of the case, and such person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "If any such person refuses to attend as so required, the Assistant Controller may report such refusal to a Magistrate who shall issue a summons to secure the attendance of such person as may be required by the order made under subsection (1). Examination of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller making an investigation under this Act may examine orally any person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "Such person shall be legally bound to answer all questions relating to such case put to him by the Assistant Controller, but such person may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not such statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "An Assistant Controller examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by any person under this section, whether or not a caution has been administered to him under subsection 130(2) shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumb-print, as the case may be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after it has been read to him in the language in which he made it; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_129__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after he has been given an opportunity to make any correction he may wish. Statement to be admissible in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is charged with an offence under this Act, any statement, whether the statement amounts to a confession or not or is oral or in writing, made at any time, whether before or after the person is charged and whether in the course of an investigation under this Act or not and whether or not wholly or partly in answer to questions, by that person to or in the hearing of an Assistant Controller and whether or not interpreted to him by another Assistant Controller or other person shall, notwithstanding any other written law to the contrary, be admissible in evidence at his trial and, if the person charged tenders himself as a witness, any such statement may be used in cross- examination and for the purpose of impeaching his credit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "The statement referred to in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_a__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be admissible or used under that subsection—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "if the making of the statement appears to the court to have been caused by any inducement, threat or promise having reference to the charge proceeding from a person in authority and sufficient in the opinion of the court to give the person charged grounds which would appear to him reasonable for supposing that by making it he would gain any advantage or avoid any evil of a temporal nature in reference to the proceeding against him; or (ii) in the case of a statement made by the person after his arrest, unless the court is satisfied that a caution was administered to him in the following words or words to the like effect: \"It is my duty to warn you that you are not obliged to say anything or to answer any question, but anything you say, whether in answer to a question or not, may be given in evidence.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if made by any person before there is time to caution him, shall not be rendered inadmissible in evidence merely by reason of no such caution having been administered if it has been administered as soon as possible."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary contained in any written law, a person charged for an offence to which subsection (1) applies shall not be bound to answer any question relating to the case after a caution under subsection (2) has been administered to him. Forfeiture of goods, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "Any goods, thing, book, document, record or other article seized in exercise of any power conferred under this Act shall be liable to forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "An order for the forfeiture or for the release of any goods, thing, book, document, record or other article seized in exercise of any power conferred under this Act shall be made by the court before which the prosecution with regard thereto has been held and an order for the forfeiture of the goods, thing, book, document, record or other article shall be made if it is proved to the satisfaction of the court that an offence under this Act has been committed and that the goods, thing, book, document, record or other article was the subject-matter of or was used in the commission of the offence, notwithstanding that no person may have been convicted of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "If there is no prosecution with regard to any goods, thing, book, document, record or other article seized in exercise of any power conferred under this Act, such goods, thing, book, document, record or other article shall be taken and deemed to be forfeited at the expiration of one calendar month from the date of service of a notice to the last-known address of the person from whom the goods, thing, book, document, record or other article was seized indicating that there is no prosecution in respect of such goods, thing, book, document, record or other article, unless before that date a claim thereto is made in the manner set out in subsections (4), (5) and (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "Any person asserting that he is the owner of the goods, thing, book, document, record or other article referred to in subsection (3) and that they are not liable to forfeiture may personally or by his agent authorized in writing, give written notice to the Assistant Controller in whose custody such goods, thing, book, document, record or other article is held that he claims the same."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of the notice referred to in subsection (4), the Assistant Controller shall refer the matter to a Magistrate for a decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate to whom a matter is referred under subsection (5) shall issue a summons requiring the person asserting that he is the owner of the goods, thing, book, document, record or other article and the person from whom they were seized, to appear before the Magistrate and on their appearance or default to appear, due service of the summons having been proved, the Magistrate shall proceed to the examination of the matter and on proof that an offence under this Act has been committed and that such goods, thing, book, document, record or other article was the subject- matter of or was used in the commission of such offence, shall order the same to be forfeited and shall, in the absence of such proof, order their release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "Any goods, thing, book, document, record or other article forfeited or deemed to be forfeited shall be delivered to the Assistant Controller and shall be disposed of in accordance with the directions of the Magistrate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "Where any goods, thing, book, document, record or other article seized in exercise of the powers conferred under this Act are of a perishable nature or is subject to speedy and natural decay or where the custody of such goods, thing, book, document, record or other article involves unreasonable expense and inconvenience, or is believed to cause obstruction or hazard to the public, the Controller may direct that such goods, thing, book, document, record or other article be sold at any time and the proceeds of the sale held to abide by the result of any prosecution under this Act. Cost of holding goods, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "Where any goods, thing, book, document, record or other article seized under this Act is held in the custody of the Government pending completion of any proceedings in respect of an offence under this Act, the cost of holding such thing in custody shall, in the event of any person being found guilty of an offence, be a debt due to the Government by such person and shall be recoverable accordingly. No costs or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of the seizure of any goods, thing, book, document, record or other article seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Protection of informers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134",
      "schema:text": {
        "@language": "en",
        "@value": "Except as hereinafter provided, no witness in any civil or criminal proceedings shall be obliged or permitted to disclose the name or address of any informer or the substance and nature of the information received from him or to state any matter which may lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134",
      "schema:text": {
        "@language": "en",
        "@value": "If any books, documents, records or papers which are in evidence or are liable to inspection in any civil or criminal proceedings contain any entry in which any informer is named or described or which might lead to his discovery, the court shall cause all such passages to be concealed from view or to be obliterated so far only as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_134",
      "schema:text": {
        "@language": "en",
        "@value": "If on trial for any offence under this Act the court after full inquiry into the case believes that the informer wilfully made in his complaint a material statement which he knew or believed to be false or did not believe to be true, or if in any other proceeding the court is of the opinion that justice cannot be fully done between the parties thereto without the discovery of the informer, it shall be lawful for the court to require the production of the original complaint, if in writing, and permit inquiry, and require full disclosure, concerning the informer. Reward for information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a conviction involving a fine, the court imposing the fine may, on the application of the prosecuting officer, direct the payment of any part of the fine not exceeding one half of such fine in such proportion as the court thinks fit to the person who gave the information leading to the conviction. Disappearance or destruction of goods, etc., to be seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_136",
      "@type": "akn:clause",
      "eli:number": "136",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who causes the disappearance or destruction of any goods, thing, book, document, record or other article to be seized under this Act with the intent to prevent the seizure thereof commits an offence and shall on conviction be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Offences with respect to information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137",
      "@type": "akn:clause",
      "eli:number": "137",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "submits false information in any application, report or other document under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "furnishes or causes to be furnished to any Assistant Controller any false particular, information or statement in respect of any matter which such officer requires to be given under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to answer or gives a false answer to any question put to him by any Assistant Controller for the purpose of obtaining any particulars, information or statement required to be given under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to produce any document as may be required by any Assistant Controller, commits an offence and shall on conviction be liable to a fine not exceeding two thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_137",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) shall be construed as requiring a person to answer any question or to give any information if the answer or information would have a tendency to expose him to a criminal charge or penalty or forfeiture. Obstruction of Assistant Controller"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_138",
      "@type": "akn:clause",
      "eli:number": "138",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who obstructs, impedes, assaults or interferes with any Assistant Controller in the performance of his functions under this Act commits an offence. Use of confidential information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139",
      "@type": "akn:clause",
      "eli:number": "139",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who makes use of any confidential information obtained by virtue of the provisions of this Act commits an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) shall operate to prevent the disclosure of information where the disclosure is made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for or in connection with the due administration of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of any legal proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of any investigation conducted under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to any consultant to the Government or to any officer who is approved in writing by the Minister as a proper person to receive the information; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIII__cl_139__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for or in connection with the preparation by the Government of statistics in respect of the operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding that the amount or value of the subject- matter claimed or in issue exceeds ten thousand ringgit, the Tribunal shall have jurisdiction to hear and determine the claim if the parties have entered into an agreement in writing that the Tribunal shall have jurisdiction to hear and determine the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "An agreement may be made under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "before a claim is lodged under section 97; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_100__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a claim has been lodged under section 97, at any time before the Tribunal has recorded an agreed settlement in respect of the claim under subsection 107(3) or has determined the claim under section 114, as the case may require. Abandonment to bring claim within jurisdiction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101",
      "schema:text": {
        "@language": "en",
        "@value": "A claimant may abandon so much of a claim as exceeds ten thousand ringgit in order to bring the claim within the jurisdiction of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101",
      "schema:text": {
        "@language": "en",
        "@value": "Where a part of a claim has been abandoned under subsection (1), the Tribunal's record of an agreed settlement under subsection 107(3) or the Tribunal's award under section 112, as the case may require, in relation to the claim shall operate to discharge the person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who is a party to that agreed settlement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_101__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "against whom the claim and the subsequent award are made, from liability in respect of the amount so abandoned. Cause of action not to be split"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Claims may not be split, nor more than one claim brought, in respect of the same matter against the same party for the purpose of bringing it within the jurisdiction of the Tribunal. Additional jurisdiction of the Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103",
      "schema:text": {
        "@language": "en",
        "@value": "Without affecting sections 98 and 99 or the generality of this Act, the Minister may by order published in the Gazette prescribe any additional matters to be within the jurisdiction of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_103",
      "schema:text": {
        "@language": "en",
        "@value": "The power of the Minister in subsection (1) shall not extend to any matter to which any written law applies if that written law provides for a mechanism by which consumers may obtain redress in relation to such matter. Exclusion of jurisdiction of court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104",
      "schema:text": {
        "@language": "en",
        "@value": "Where a claim is lodged with the Tribunal and the claim is within the Tribunal's jurisdiction, the issues in dispute in that claim, whether as shown in the initial claim or as emerging in the course of the hearing, shall not be the subject of proceedings between the same parties in any court unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings before the court were commenced before the claim was lodged with the Tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the claim before the Tribunal is withdrawn, abandoned or struck out."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_104",
      "schema:text": {
        "@language": "en",
        "@value": "Where paragraph (1)(a) applies, the issues in dispute in the claim to which those proceedings relate, whether as shown in the initial claim or emerging in the course of the hearing, shall not be the subject of proceedings between the same parties before the Tribunal unless the claim before the court is withdrawn, abandoned or struck out. Disposal of perishable goods"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Where the subject-matter of the claim is goods of perishable nature and storage of such goods pending final disposal of the claim involves unreasonable expense and inconvenience, the Tribunal may, on the application of a party to the proceedings, at any time order that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105",
      "schema:text": {
        "@language": "en",
        "@value": "the goods be sold; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_105",
      "schema:text": {
        "@language": "en",
        "@value": "the proceeds of the sale be held to abide by the award of the Tribunal under section 112. Notice of claim and hearing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Upon a claim being lodged under section 97, the Secretary to the Tribunal shall give notice of the details of the day, time and place of hearing in the prescribed form to the claimant and the respondent. Negotiation for settlement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal shall, as regards every claim within its jurisdiction, assess whether, in all the circumstances, it is appropriate for the Tribunal to assist the parties to negotiate an agreed settlement in relation to the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107",
      "schema:text": {
        "@language": "en",
        "@value": "Without limiting the generality of subsection (1), in making an assessment the Tribunal shall have regard to any factors that, in the opinion of the Tribunal, are likely to impair the ability of either or both of the parties to negotiate an agreed settlement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties reach an agreed settlement, the Tribunal shall approve and record the settlement and the settlement shall then take effect as if it is an award of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "it appears to the Tribunal that it would not be appropriate for it to assist the parties to negotiate an agreed settlement in relation to the claim; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_107__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the parties are unable to reach an agreed settlement in relation to the claim, the Tribunal shall proceed to determine the dispute. Right to appear at hearings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "At the hearing of a claim every party shall be entitled to attend and be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "No party shall be represented by an advocate and solicitor at a hearing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2) but notwithstanding section 37 of the Legal Profession Act 1976—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a corporation or an unincorporated body of persons may be represented by its full time paid employee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a minor or any other person under a disability may be represented by his next friend or guardian ad litem."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "Where a party is represented as provided under subsection (3), the Tribunal may impose such conditions as it considers necessary to ensure that the other party to the proceedings is not substantially disadvantaged. Proceedings to be public"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "All proceedings before the Tribunal shall be open to the public. Evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "procure and receive evidence on oath or affirmation, whether written or oral, and examine all such persons as witnesses, as the Tribunal thinks necessary to procure, receive or examine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require the production before it of books, papers, documents, records and things;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "administer the oath, affirmation or statutory declaration, as the case may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "seek and receive such other evidence and make such other inquiries as it thinks fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "summon the parties to the proceedings or any other person to attend before it to give evidence or to produce any document, records or other thing in his possession or otherwise to assist the Tribunal in its deliberations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "receive expert evidence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "generally direct and do all such things as may be necessary or expedient for the expeditious determination of the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_110",
      "schema:text": {
        "@language": "en",
        "@value": "A summons issued under this section shall be served and enforced as if it were a summons issued by a subordinate court. Tribunal may act in absence of party"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal may hear and determine the claim before it notwithstanding the absence of any party to the proceedings if it is proved to the satisfaction of the Tribunal that a notice of the hearing has been duly served on the absent party. Awards of Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal shall make its award without delay and, where practicable, within sixty days from the first day the hearing before the Tribunal commences."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "An award of the Tribunal under subsection (1) may require one or more of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that a party to the proceedings pay money to any other party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that goods be supplied or resupplied in accordance with this Act or the contract to which the consumer is a party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that goods supplied or resupplied to the consumer be replaced or repaired;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the price or other consideration paid or supplied by the consumer or any other person be refunded to the consumer or that person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that a party comply with the guarantee; 74 Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that money be awarded to compensate for any loss or damage suffered by the claimant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the contract be varied or set aside, wholly or in part;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that costs to or against any party be paid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that interest be paid on any sum or monetary award at a rate not exceeding eight per centum per annum, unless it has been otherwise agreed between the parties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the claim is dismissed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in paragraph (1)(f) shall be deemed to empower the Tribunal to award any damages for any non-pecuniary loss or damage. Reference to a Judge of the High Court on a question of law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "Before the Tribunal makes an award under section 112, it may, in its discretion, refer to a Judge of the High Court a question of law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "which arose in the course of the proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "which, in the opinion of the Tribunal, is of sufficient importance to merit such reference; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the determination of which by the Tribunal raises, in the opinion of the Tribunal, sufficient doubt to merit such reference."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "If the Tribunal refers any question of law under subsection (1) for the decision of a Judge of the High Court, it shall make its award in conformity with such decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A Federal Counsel authorized by the Attorney General for the purpose may appear on behalf of the Tribunal in any proceedings before a Judge of the High Court under this section. Reasons for decision"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal shall in all proceedings give its reasons for its award in the proceedings. Orders and settlements to be recorded in writing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:name": {
        "@language": "en",
        "@value": "The Tribunal shall make or cause to be made a written record of the terms of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "every agreed settlement reached by the parties under subsection 107(3); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "every award made by it under section 112. Decisions of Tribunal to be final"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "Every agreed settlement recorded by the Tribunal under subsection 107(3) and every award made by the Tribunal under section 112—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall be final and binding on all parties to the proceedings; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall be deemed to be an order of a Magistrate's Court and be enforced accordingly by any party to the proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of paragraph (1}(b), the Secretary to the Tribunal shall send a copy of the award made by the Tribunal to the Magistrate's court having jurisdiction in the place to which the award relates or in the place where the award was made and the Court shall cause the copy to be recorded. Criminal penalty for failure to comply"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who after fourteen days fails to comply with an award made by the Tribunal commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_117",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a continuing offence, the offender shall, in addition to the penalties under subsection (1), be liable to a fine not exceeding one thousand ringgit for each day or part of a day during which the offence continues after conviction. Procedure where no provision is made"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act and to any regulations, the Tribunal shall adopt such procedure as it thinks fit and proper. Want of form"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "No proceedings of the Tribunal or award or other document of the Tribunal shall be set aside or quashed for want of form. Disposal of documents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal may, at the conclusion of the proceedings before it, order that any document, record, material or other property produced during the proceedings be delivered to the rightful owner or be disposed of in such manner as it thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "Where no person has taken delivery of the document, record, material or other property referred to in subsection (1) after a period of six months, the ownership in the document, record, material or other property shall be deemed to have passed to and become vested in the Government. Act or omission done in good faith"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:name": {
        "@language": "en",
        "@value": "No action or suit shall be instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "a person authorized to act for or on behalf of the Tribunal, for any act or omission done in good faith in the performance of its or his functions and the exercise of its or his powers under this Act. Regulations in respect of the Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be necessary or expedient in respect of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the responsibilities and control of members of the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure of the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing forms;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing and imposing fees and providing for the manner for collecting and disbursing such fees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_122__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing anything required to be prescribed under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:name": {
        "@language": "en",
        "@value": "There shall be established a tribunal to be known as the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Tribunal for Consumer Claims\". Membership of Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal shall consist of the following members who shall be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman and a Deputy Chairman from among members of the Judicial and Legal Service; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not less than five members—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "being person who are qualified persons within the meaning of the Legal Profession Act 1976 [Act 166], Advocates Ordinance Sabah [Cap. 2] or Advocates Ordinance Sarawak [Cap. 110], as the case may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "persons not falling within subparagraph (i) but are holding or have held the posts specified in the Fourth Schedule to the Subordinate Courts Act 1948 [Act 92]; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any combination of members from subparagraph (i) or (ii)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "The members referred to in paragraph (1)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall hold office for a term not exceeding three years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be eligible for reappointment upon expiry of his term of office but shall not be appointed for more than three consecutive terms. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Chairman is for any reason unable to perform his functions or during any period of vacancy in the office of the Chairman, the Deputy Chairman shall perform the functions of the Chairman. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Tribunal shall become vacant-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "upon the death of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "upon the member resigning from such office by giving three months' written notice to the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "upon expiration of his term of office. Revocation of appointment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may revoke the appointment of a member of the Tribunal appointed under paragraph 86(1 )(£)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a member of the Tribunal or otherwise, has been such as to bring discredit to the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if he has become incapable of properly carrying out his duties as a member of the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under a law relating to corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if he is adjudicated a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if he has been found or declared to be of unsound mind or has otherwise become incapable of managing his affairs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "if he absents himself from three consecutive sittings of the Tribunal without leave of the Chairman. Resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Tribunal appointed under paragraph 86(1 )(6) may at any time resign his office by giving three months' written notice to the Minister. Filling of vacancy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member ceases to be a member of the Tribunal, the Minister may appoint another person to fill the vacancy for the remainder of the term for which the vacating member was appointed. Remuneration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Tribunal appointed under paragraph 86(1 )( a) shall be paid such fixed allowances and other allowances as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Tribunal appointed under paragraph 86(1)(b) shall be paid—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a daily sitting allowance during the sitting of the Tribunal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a lodging, travelling and subsistence allowance, as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "The remuneration provided under subsections (1) and (2) shall be charged on the Consolidated Fund. Secretary to Tribunal and other officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed a Secretary to the Tribunal and such number of officers as may be necessary for carrying out the functions of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall have general control of the officers of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Secretary to the Tribunal shall be deemed to be an officer of the Tribunal. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "All members and officers of the Tribunal while discharging their duties as such members and officers, shall be deemed to be public servants within the meaning of the Penal Code. No action to lie against Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Tribunal or against any member or officer of the Tribunal in respect of any act, neglect or default done or committed by him in such capacity. Sittings of Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "The jurisdiction of the Tribunal shall be exercised by any of the following persons sitting alone:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman of the Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Chairman of the Tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Tribunal selected by the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "The Tribunal may sit in two or more sittings on such day and at such time and place as the Chairman may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "If the person presiding over any proceedings in respect of a claim dies or becomes incapacitated, or is for any other reason unable to complete the hearing or dispose of the proceedings, the proceedings shall be heard afresh by another member of the Tribunal, unless the parties agree that the proceedings be continued by another member of the Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "Where the term of appointment of any member of the Tribunal under this section expires during the pendency of any proceedings in respect of a claim, the term of his appointment shall be deemed to be extended until the final disposal of the claim. Commencement of proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "A consumer may lodge with the Tribunal a claim in the prescribed form together with the prescribed fee claiming for any loss suffered on any matter concerning his interests as a consumer under this Act. Jurisdiction of Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to sections 99 and 100, the Tribunal shall have jurisdiction where the total amount in respect of which an award of the Tribunal is sought does not exceed ten thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (1), a respondent to a claim may raise a debt or liquidated demand as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a defence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a counter-claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Where a respondent raises a debt or liquidated claim in the manner set out in subsection (2) the Tribunal shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "give effect to the defence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "hear and determine the counter-claim notwithstanding that the original claim is withdrawn, abandoned or struck out."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Any claim lodged with the Tribunal may include loss or damage of a consequential nature. Limitation of jurisdiction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "Except as expressly provided under this Act, the Tribunal shall have no jurisdiction in respect of any claim—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "for the recovery of land, or any estate or interest in land;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in which the title to any land, or any estate or interest in land, or any franchise, is in question; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in which there is a dispute concerning—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the entitlement of any person under a will or settlement, or on any intestacy (including a partial intestacy);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "goodwill;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any chose in action; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any trade secret or other intellectual property."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "The jurisdiction of the Tribunal shall be limited to a claim that is based on a cause of action which accrues within three years of the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to authorize the Tribunal to deal with a claim arising from personal injury or death."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), \"land\" does not include fixtures. Extension of jurisdiction by agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "@type": "akn:part",
      "eli:number": "XIV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_142",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_143",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_147",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_148",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL AND MISCELLANEOUS Receipts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "@type": "akn:clause",
      "eli:number": "140",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "A person who supplies or offers to supply any goods or services shall provide the consumer with a receipt for any purchase of goods or services exceeding the prescribed value."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in subsection (1), a consumer shall be supplied with a receipt for any purchase of goods or services if the consumer so requests."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "A receipt issued under this section shall contain the following particulars:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the trade name and address of the supplier;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the date of purchase;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the amount of money paid for each item of purchase;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the total amount of money paid including a separate statement of any amount paid as tax;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where applicable, the make and model number of the goods; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any other particulars as may be prescribed in the regulations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, exempt any business or class of business from this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence. Power to order compliance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
      "@type": "akn:clause",
      "eli:number": "141",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Controller has reasonable grounds to believe that a person is contravening, has contravened or is about to contravene this Act, the Controller may make an order requiring the person to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "cease the contravention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "refrain from the contravention or contemplated contravention; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "refrain from any further contravention, of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the order made under subsection (1) shall be served on every person named in it together with written reasons for the order, and such order shall take effect immediately on the service thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, service may be made personally or by A.R. registered post, telegram, facsimile transmission or by any other electronic or other means of transmission which results in the order being transmitted in writing to the person named in it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "The power to issue an order under subsection (1) may be exercised by the Controller personally or by any officer authorized in writing by the Controller. Failure to comply with lawful order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_142",
      "@type": "akn:clause",
      "eli:number": "142",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with any written order issued by the Controller or any officer authorized in writing by the Controller commits an offence under this Act. Offences by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_143",
      "@type": "akn:clause",
      "eli:number": "143",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence under this Act has been committed by a body corporate, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or who was purporting to act in any such capacity shall, as well as the body corporate, be deemed to have committed that offence unless he proves that the offence was committed without his knowledge, consent or connivance and that he took reasonable precautions and had exercised due diligence to prevent the commission of the offence. Offences by employees, agents or employees of agents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144",
      "@type": "akn:clause",
      "eli:number": "144",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:name": {
        "@language": "en",
        "@value": "Where an offence under this Act has been committed by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "an employee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "an agent; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "an employee of the agent, of any person (the \"principal\"), the principal shall be deemed to have committed that offence unless he proves that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the offence was committed without his knowledge or that he took reasonable precautions to prevent its commission; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the offence was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an employee, outside the course of his employment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an agent, when the agent was not acting on the principal's behalf; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_144__para_c__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an employee of the agent, outside the course of his employment by the agent or otherwise on behalf of the agent. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145",
      "@type": "akn:clause",
      "eli:number": "145",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is convicted of an offence under this Act for which no penalty is expressly provided shall be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both, and for a second or subsequent offence to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145",
      "schema:text": {
        "@language": "en",
        "@value": "Any body corporate which is convicted of an offence under this Act for which no penalty is expressly provided shall be liable to a fine not exceeding one hundred thousand ringgit, and for a second or subsequent offence to a fine not exceeding two hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_145",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who or body corporate which is convicted of an offence under this Act shall, in the case of a continuing offence, in addition to any fine provided under this Act, be liable to a fine not exceeding one thousand ringgit for each day or part of a day during which the offence continues after conviction. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146",
      "@type": "akn:clause",
      "eli:number": "146",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "( 1) The Controller or a Deputy Controller or any person authorized in writing by the Controller may compound any offence, except offences under Part III, sections 138 and 139, committed by any person under this Act by making a written offer to such person to compound the offence upon payment to the Controller or the Deputy Controller or any person authorized in writing by the Controller such amount not exceeding fifty per centum of the amount of maximum fine for that offence within such time as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection ( 1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer or within such extended period as the Controller or the Deputy Controller or any person authorized in writing by the Controller may grant, prosecution for the offence may be instituted at any time thereafter against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "no prosecution shall thereafter be instituted in respect of such offence against the person to whom the offer to compound was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any goods, thing, book, document, record or other article seized in connection with such offence shall be released immediately."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_146",
      "schema:text": {
        "@language": "en",
        "@value": "Any monies paid to the Controller or the Deputy Controller or any person authorized in writing by the Controller, as the case may be, under this section shall be paid into and form part of the Federal Consolidated Fund. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_147",
      "@type": "akn:clause",
      "eli:number": "147",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to any offence under this Act shall be instituted without the written consent of the Public Prosecutor. Jurisdiction to try offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_148",
      "@type": "akn:clause",
      "eli:number": "148",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, a Court of a Magistrate of the First Class shall have jurisdiction to try any offence under this Act and to impose the full punishment for any such offence. Protection of officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149",
      "@type": "akn:clause",
      "eli:number": "149",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "No action or prosecution shall be brought, instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149",
      "schema:text": {
        "@language": "en",
        "@value": "the Controller, Deputy Controllers, Assistant Controllers or any other officer duly appointed under this Act for or on account of or in respect of any act ordered or done for the purpose of carrying this Act into effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_149",
      "schema:text": {
        "@language": "en",
        "@value": "any other person for or on account of or in respect of any act done or purported to be done by him under the order, direction or instruction of the Controller, a Deputy Controller, an Assistant Controller or any other officer* duly appointed under this Act if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served by it. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150",
      "@type": "akn:clause",
      "eli:number": "150",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150",
      "schema:text": {
        "@language": "en",
        "@value": "In particular and without prejudice to the generality of subsection (1), such regulations may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribe, in respect of goods or services of any description or of any class or classes of goods or services, a consumer information standard concerning any or all of the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure of information relating to the kind, grade, quantity, origin, performance, care, composition, contents, design, construction, use, price, finish, packaging, promotion or supply of the goods or services; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the form or manner in which the information is to be disclosed on or in relation to or in connection with the supply or resupply or promotion of the supply of the goods or services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribe any forms for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "generally prescribe and provide for fees under this Act and the manner for collecting and disbursing such fees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribe the particulars required to be contained in receipts and the value of transactions for which receipts shall be required and for this purpose may prescribe different values for different transactions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XIV__cl_150__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide for any matter which under this Act is required or permitted to be prescribed or which are necessary or expedient to be prescribed to give effect to this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may establish the National Consumer Advisory Council to advise him on the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of consumer issues and the operation of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the promotion of consumer protection and awareness in consumer affairs; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_73__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matter which may be referred to it by the Minister for the proper and effective implementation of this Act and for the protection of consumers. Membership of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for consumer affairs or his representative; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not more than sixteen other persons to represent the interests of consumers, manufacturers, suppliers, other non-governmental organizations and academicians."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The members referred to in paragraph (1)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be appointed by the Minister for a term not exceeding two years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be eligible for reappointment upon expiry of his term of office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint from among the members of the Council a Chairman and a Deputy Chairman. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Chairman is for any reason unable to perform his functions or during any period of vacancy in the office of the Chairman, the Deputy Chairman shall perform the functions of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Where both the Chairman and the Deputy Chairman are for any reason unable to perform the functions of the Chairman or during any period of vacancy in the offices of the Chairman and Deputy Chairman, the Minister may appoint any member of the Council to perform the functions of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Chairman or the member appointed under subsection (2), as the case may be, shall, during the period in which he is performing the functions of the Chairman under this section, be deemed to be the Chairman. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Council referred to in paragraph 14(1)(b) shall become vacant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "upon the death of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "upon the member resigning from such office by letter addressed to the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "upon the expiration of his term of office. Revocation of appointment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may revoke the appointment of a member of the Council referred to in paragraph 74(1 )(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a member of the Council or otherwise, has been such as to bring discredit to the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if he has become incapable of properly carrying out his duties as a member of the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under a law relating to corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if he is adjudicated a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if he has been found or declared to be of unsound mind or has otherwise become incapable of managing his affairs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "if he absents himself from three consecutive meetings of the Council without obtaining leave in writing from the Chairman of the Council. Resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Council appointed under paragraph 74(1 )(b) may at any time resign his office by a letter addressed to the Minister. Filling of vacancy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member appointed under paragraph 14(1)(b) ceases to be a member of the Council, the Minister may appoint another person to fill the vacancy for the remainder of the term for which the vacating member was appointed. Secretary to Council and other officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed a Secretary to the Council and such other officers as may be necessary to assist the Council. Allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:name": {
        "@language": "en",
        "@value": "The members of the Council appointed under paragraph 74(1)(b)"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Council may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any person to attend a meeting or deliberation of the Council for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subsection (1) shall be paid such fee as the Council may determine. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceeding taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "a vacancy in the membership of, or a defect in the constitution of, the Council; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "an omission, a defect or an irregularity not affecting the merit of the case. Regulations relating to the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as he thinks necessary or expedient in respect of this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "In this Part, unless the context otherwise requires— \"agricultural produce\" means any produce of the soil, of stock farming or of fisheries; \"damage\" means death or personal injury, or any loss of or damage to any property, including land, as the case may require; \"dependant\" has the same meaning as in the Civil Law Act 1956 [Act 67]' \"producer\", in relation to a product, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the person who manufactured it;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a substance which is not manufactured out is won or abstracted, the person who won or abstracted it;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a product which is not manufactured, won or abstracted but the essential characteristics of which are attributable to an industrial or other process having been carried out, the person who carried out that process; \"product\" means any goods and, subject to subsection (2), includes a product which is comprised in another product, whether by virtue of being a component part, raw material or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Part, a person who supplies any product in which other products are comprised therein, whether by virtue of being a component part, raw material or otherwise, shall not be treated by reason only of his supply of that product as supplying any of the products so comprised therein. Meaning of \"defect\""
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsections (2) and (3), there is a defect in a product for the purposes of this Pan if the safety of the product is not such as a person is generally entitled to expect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "In determining what a person is generally entitled to expect in relation to a product, all relevant circumstances shall be taken into account including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the manner in which, and the purposes for which, the product has been marketed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the get-up of the product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of any mark in relation to the product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "instructions for or warnings with respect to doing or refraining from doing anything with or in relation to the product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "what may reasonably be expected to be done with, or in relation to, the product; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the time when the product was supplied by its producer to another person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall require a defect to be inferred from the mere fact that the safety of a product which is subsequently supplied is greater than the safety of the product in question."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"safety\", in relation to a product, shall include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "safety with respect to products comprised therein;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "safety in the context of risk of damage to property; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_67__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "safety in the context of risk of death or personal injury. Liability for defective products"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where any damage is caused wholly or partly by a defect in a product, the following persons shall be liable for the damage:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the producer of the product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the person who, by putting his name on the product or using a trade mark or other distinguishing mark in relation to the product, has held himself out to be the producer of the product; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the person who has, in the course of his business, imported the product into Malaysia in order to supply it to another person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where damage is caused wholly or partly by a defect in a product, the person who suffered the damage may within a reasonable period after the damage occurs request the supplier to identify any or all of the persons referred to in subsection (1), whether or not he is or they are still in existence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose, of subsection (2), it is immaterial whether the supplier supplied the defective product to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person who suffered the damage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the producer of a product in which the defective product is comprised therein; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where the supplier fails to comply with a request under subsection (2) within a reasonable time having regard to all the circumstances, the supplier shall be held liable for the loss or damage."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to a person in respect of any defect in agricultural produce if the only supply of the agricultural produce by the person to another person was at a time when the agricultural produce has not undergone any industrial process."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more persons are liable under this Part for the same damage, their liability shall be joint and several."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall be without prejudice to any liability arising otherwise than under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, declare that no proceeding shall be brought before the Tribunal or any court in respect of any defect in any goods after the expiry of such period calculated from the date of manufacture of such goods or class or both of such goods as may be specified in the order; and upon the making of such declaration, no proceeding shall be brought in respect of such defect before the Tribunal or any court. Extent of liability for loss or damage"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where any damage is caused wholly or partly by a defect in a product, the liability of the person liable for the damage under section 68 shall not include the loss of or damage to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the defective product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the whole or any part of the product which comprises the defective product; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any property which at the time it is lost or damaged is not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "of a description of property ordinarily intended for private use, occupation or consumption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "intended by the person suffering the loss or damage mainly for his own private use, occupation or consumption."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph (1)(c), loss or damage to property shall be deemed to have occurred at the earliest time at which a person with an interest in the property has knowledge of the material facts about the loss or damage."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the material facts about any loss of or damage to any property are such facts about the loss or damage as would lead a reasonable person with an interest in the property to consider the loss or damage sufficiently serious to justify his instituting proceedings for damages against a defendant who does not dispute liability and is able to satisfy a judgment against him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a person's knowledge includes knowledge which he may reasonably be expected to acquire—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "from facts observable or ascertainable by him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_69__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "from facts ascertainable by him with the help of appropriate expert advice which it is reasonable for him to seek: Provided that a person shall not be deemed to have knowledge of a fact ascertainable by him only with the help of expert advice unless he has failed to take all reasonable steps to obtain and where appropriate, to act on that advice. Application of other written law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of a claim under the Civil Law Act 1956 [Act 68], any damage for which a person is liable under section 69 shall be deemed to have been caused by the person's wrongful act, neglect or default."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person who suffered the damage caused wholly or partly by a defect in a product dies after suffering the damage, the request to the supplier under subsection 68(3) may, for the purposes of a claim under the Civil Law Act 1956, be made by the personal representative or dependant, as the case may be, of the deceased person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where any damage is caused partly by a defect in a product and partly by the fault of the person who suffered the damage, the Civil Law Act 1956 shall have effect as if the defect were the fault of every person liable under this Part for the damage caused by the defect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of any written law conferring jurisdiction on any court with respect to any matter, liability for damage under this Part shall be treated as liability in tort."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (3), \"fault\" has the same meaning as in the Civil Law Act 1956. Prohibition on exclusion from liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The liability of a person under this Part to a person who has suffered damage caused wholly or partly by a defect in a product, or to a dependant of such a person, shall not be limited or excluded by any contract term, notice or other provision. Defences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "In any civil proceeding under this Part against any person in respect of a defect in a product, it shall be a defence for that person to show—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the defect is attributable to compliance with any requirement imposed under any written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that he did not at any time supply the defective product to another person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the defect did not exist in the product at the relevant time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the state of scientific and technical knowledge at the relevant time was not such that a producer of products of the same description as the product in question may reasonably be expected to discover the defect if it had existed in his product while it was under his control; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the defect— (i) is a defect in a product in which the product in question is comprised therein (the \"subsequent product\"); and (ii) is wholly attributable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the design of the subsequent product; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "compliance by the producer of the product in question with instructions given by the producer of the subsequent product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), \"relevant time\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to electricity, means the time at which it was generated, being a time before it was transmitted or distributed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to any other product, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where section 68 applies, the time when the producer supplied the product to another person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where section 68 does not apply, the time when the product was last supplied by a person to whom section 68 applies to another person."
      }
    }
  ]
}
