        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2__para_c",
