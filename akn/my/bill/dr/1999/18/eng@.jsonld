        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "RIGHTS AGAINST SUPPLIERS IN RESPECT OF GUARANTEES IN THE SUPPLY OF GOODS Consumer's right of redress against suppliers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
