        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_X__cl_72"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@",
      "schema:text": {
