        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_VI__cl_43",
