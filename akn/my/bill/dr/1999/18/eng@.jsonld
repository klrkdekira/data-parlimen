        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "goods, includes obtaining goods by way of purchase, exchange or taken on lease, hire or hire-purchase;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "services, includes accepting a service in any manner, and \"acquire\" and \"acquisition\" shall be construed accordingly; \"advertisement\" includes every form of advertisement, whether or not accompanied by or in association with spoken or written words or other writing or sounds and whether or not contained or issued in a publication, and includes advertisement—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/18/eng@/~part_I__cl_3__subsec_1__list_2",
      "@type": "akn:list",
