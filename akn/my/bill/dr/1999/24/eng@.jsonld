      "schema:text": {
        "@language": "en",
        "@value": "all offences under the Dangerous Drugs Act 1952 [Act 234] punishable with imprisonment for more than five years or with death; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "all offences under the Kidnapping Act 1961 [Act 365]; \"guardian\", in relation to a child, includes any person who, in the opinion of the Court For Children having cognizance of any case in relation to the child or in which the child is concerned, has for the time being the charge of or control over the child; \"Henry Gurney School\" means a school—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_4",
