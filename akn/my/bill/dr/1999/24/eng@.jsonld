      "schema:text": {
        "@language": "en",
        "@value": "the lessee, including a sublessee, of the place whether registered or otherwise; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_6__para_a__subpara_iii",
