      "schema:text": {
        "@language": "en",
        "@value": "means any place of detention established or appointed under section 58; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_7__para_b",
