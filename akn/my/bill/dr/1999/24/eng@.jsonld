        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53"
      ],
