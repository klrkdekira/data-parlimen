        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "INVESTIGATION, ARREST, SEARCH, SEIZURE, ETC. Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector or police officer may investigate the commission of any offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector when acting under this Part shall, on demand, declare his office to the person against whom he is acting or from whom he seeks any information. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109",
      "schema:text": {
        "@language": "en",
        "@value": "Every person required by a Protector or police officer to give information or produce any document or other things relating to the commission of any offence which is in that person's power to give shall be legally bound to give the information or produce the document or other things. Power to arrest without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110",
      "schema:text": {
        "@language": "en",
        "@value": "Any police officer may arrest without a warrant any person whom he reasonably believes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has committed or attempted to commit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "employed or aided any other person to commit or abet, the commission of an offence against this Act, and may search any person so arrested."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_110",
      "schema:text": {
        "@language": "en",
        "@value": "Any person arrested under subsection (1) shall, after the arrest, be dealt with as provided for by the Criminal Procedure Code. Search by warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate upon written information on oath that there is reasonable cause to believe that in any premises there is any evidence of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a child who is in need of protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a child who is being concealed, confined or detained in contravention of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_cc",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the commission of an offence against this Act, the Magistrate may issue a search warrant authorizing a Protector or police officer to whom it is directed, at any reasonable time by day or night and with or without assistance, to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "enter and search the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "inspect, make copies of, ,or take extracts from, any book, record or document; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "search any person who is in or on the premises, and for the purposes of that search detain the person and remove him to any place as may be necessary to facilitate the search, and seize and detain any article found on that person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd",
      "@type": "akn:subparagraph",
      "eli:number": "dd",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "search and remove the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd",
      "schema:text": {
        "@language": "en",
        "@value": "who is in need of protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd",
      "schema:text": {
        "@language": "en",
        "@value": "who is being concealed, confined or detained in contravention of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_1__para_c__subpara_dd",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of whom an offence against this Act has been committed, to a place of safety or place of refuge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "If a child has been placed in a place of safety pursuant to paragraph (1)(dd), the Protector shall, as soon as practicable, inform the parent or guardian who has lawful custody of the child the whereabouts of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it is necessary to do so, a Protector or police officer exercising any power under subsection (1) may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door or window of any premises in order to effect entry into the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "forcibly enter any premises and any part of the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to entry, search, seizure, detention or removal as he is empowered to effect under subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "detain any person found in or on any premises searched under subsection (1) until the search is completed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "A female person shall not be searched under this section or section 110 except by another female person and a male person shall not be searched except by another male person and such search shall be carried out with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "A person who by force, restraint, threats, inducement or other means causes any child who is in need of protection to conceal himself in or to leave any premises being searched or about to be searched by a Protector or a police officer under this Bill section, with the intent that the search by such Protector or police officer may be evaded or obstructed, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the owner or occupier of any premises searched under this section and any person found in or on the premises to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "provide the Protector or police officer with all such facilities and assistance as he may reasonably require; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_111__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "give the Protector or police officer all reasonable information required by him. Search without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "If a Protector or police officer has reasonable cause to believe that by reason of delay in obtaining a search warrant under section 111—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "the investigation would be adversely affected; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "the object of the entry is likely to be frustrated, he may exercise in, and in respect of, the premises all the powers referred to in that section in as full and ample a manner as if he were authorized to do so by a warrant issued under that section. Power to examine person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector or police officer investigating an offence under this Act may order any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "acquainted with the facts and circumstances of an offence to attend before him to be examined orally in relation to any matter which may assist in the investigation into the offence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to produce any child or any book, article or document which may assist in the investigation into the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order has been given under paragraph (a) shall attend in accordance with the terms of the order to be examined; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "during such examination—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "shall disclose all information which is within his knowledge or which is available to him in respect of the matter in relation to which he is being examined;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "shall answer any question put to him truthfully and to the best of his knowledge and belief; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "shall not refuse to answer any question on the ground that it tends to incriminate him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order has been given under paragraph (a) shall produce the child unless it can be shown to the satisfaction of the Protector that the child —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall not conceal, destroy, alter or dispose of any book, article or document specified in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is no longer under the custody or control of that person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the whereabouts of the child are not known to that person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order is given under subsection (1) shall comply with the order and with subsections (2) and (3) notwithstanding any written law or rule of law to the contrary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector examining a person under paragraph (1)(a) shall record in writing any statement made by the person so examined and the statement so recorded shall be signed by the person making it or affixed with his thumb-print, as the case may be, after—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "it has been read to him in the language in which he made it; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "he has been given an opportunity to make any correction he may wish."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "If a person examined under this section refuses to sign or affix his thumb-print on the statement, the Protector shall endorse on the record under his hand the fact of such refusal and the reason for it, if any, stated by the person examined. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law or rule of law to the contrary, the record of an examination under paragraph (1)(a) and any book, article or document produced under paragraph ( l ) ( b) shall be admissible in evidence in any proceedings in any Court for or in relation to an offence under this Act, regardless of whether such proceedings are against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the person who was examined;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the person who produced the book, article or document; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence. Inspection"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "If an order is made placing a child in the care of a fit and proper person or requiring the parent or guardian of the child to exercise proper care and guardianship over him, the Protector or probation officer or any Social Welfare Officer authorized in writing by the Protector or probation officer may, so long as the order is in effect—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114",
      "schema:text": {
        "@language": "en",
        "@value": "at any time visit and inspect the place where such child in respect of whom the order is made lives or is believed to live or to be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_114",
      "schema:text": {
        "@language": "en",
        "@value": "inquire into the conditions and circumstances of the child, and for the purposes of such inquiry, may require any person to answer any questions as he may think proper to ask and such person shall be legally bound to answer such question truthfully to the best of his knowledge or belief. Obstruction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "refuses the Protector or Social Welfare Officer access to any premises, or fails to submit to a search by a person authorized to search him under this Act; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders, delays or attempts to assault, obstruct, hinder or delay the Protector or Social Welfare Officer in the execution of his duty under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with any lawful demand, order or requirement of a Protector or Social Welfare Officer in the execution of his duty under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "omits, refuses or neglects to give to a Protector or Social Welfare Officer any information which may be reasonably required of him and which he is empowered to give;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "fails to produce to, or conceals or attempts to conceal from, a Protector or Social Welfare Officer, any child or any book, article or document in relation to which the Protector or Social Welfare Officer has reasonable grounds for believing that an offence under this Act has been or is being committed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "rescues or endeavours to rescue or causes to be rescued any thing which has been duly seized; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "destroys any thing to prevent the seizure of the thing, or the securing of the thing, commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Protection of informers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who gives any information that a child is in need of protection shall not incur any liability for defamation or otherwise in respect of the giving of such information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "The giving of any information that a child is in need of protection shall not, in any proceedings before any Court or in any other respect, be held to constitute—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a breach of professional etiquette or ethics; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a departure from accepted standards of professional conduct. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsections (4) and (6), a witness in any civil or criminal proceedings shall not be obliged or permitted to disclose the name and address of an informer or the substance of the information received from him or to state any matter which might lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "If any book, record or document which is in evidence or liable to inspection in any civil or criminal proceedings contains any entry in which any informer is named or described or which might lead to his discovery, the Court shall cause all such passages to be concealed from view or to be obliterated so far as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall apply to a registered medical practitioner, any member of the family or a child care provider who gives information under section 27, 28 or 29 respectively in the same manner as they apply to a person who gives information that a child is in need of protection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_116",
      "schema:text": {
        "@language": "en",
        "@value": "If during the trial for any offence against this Act, the Court after full inquiry into the case believes that the informer wilfully made in his complaint a material statement which he knew or believed to be false or did not believe to be true, or if in any other proceedings the Court is of the opinion that justice cannot be fully done between the parties in that proceedings without the discovery of the informer, it shall be lawful for the Court to require the production of the original.complaint, if in writing, and permit inquiry and require full disclosure concerning the informer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "If an order is made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "If any person wilfully neglects to comply with a contribution order, a Magistrate may, for every breach of the order—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "by warrant, direct the amount due to be levied in the manner by law provided for levying fines imposed by Magistrate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "sentence the person to imprisonment for a term not exceeding one month for each month's contribution remaining unpaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "The term of imprisonment imposed under paragraph (10)(b) shall terminate when the amount of contribution due is paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "placing a child in the care of a fit and proper person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sending a child to a probation hostel, an approved school, a Henry Gurney School, or an approved institution or centre; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_cc"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "placing a child in a place of refuge, the Court For Children making the order may, at the same time or subsequently, make a contribution order requiring the parent or guardian or other person having custody of the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "at the time of the commission of the offence resulting in the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "prior to an order made under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "immediately before the commencement of any proceedings, to make such contribution or monthly contributions in such manner as the Court thinks fit, having regard to the means of the parent or guardian or other person. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall not make any contribution order under subsection (1) if the Court considers that it would not be just for the contribution order to be made having regard to the circumstances and means of the parent or guardian or other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "If a contribution order is made pursuant to subsection (1), it shall be the duty of the parent or guardian or other person against whom the contribution order is made to comply with the contribution order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "All sums payable under a contribution order shall be paid into such Court or to such authority as the Court making the order shall direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children making any such contribution order may, from time to time, on an application made by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian or other person against whom the contribution order is made;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the Protector; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the probation officer, rescind, make anew or vary the order as the Court deems fit on proof of change in circumstances of the person against whom the order is made or for other good cause being shown to the satisfaction of the Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "An order under subsection (1) shall not be made without giving the parent or guardian of the child or the other person having custody of the child an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (6), an order under subsection (1) may be made if the Court is satisfied on information given by a Protector or probation officer, as the case may be, that the parent or guardian or other person, having been required to attend, has failed to do so, or is not available or cannot be found within a reasonable time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "A contribution order shall remain in force—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a child ordered to be placed in the care of a fit and proper person, so long as the order is in force; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a child ordered to be sent to a place of refuge, a probation hostel, an approved school, a Henry Gurney School, or an approved institution or centre, until he ceases to be under the care of the person in charge for the time being of the place of refuge, probation hostel, approved school, Henry Gurney School, or approved institution or centre."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108",
      "schema:text": {
        "@language": "en",
        "@value": "A contribution is not payable under a contribution order in respect of any period during which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "a child ordered to be sent to an approved school or a Henry Gurney School is out with permission or under the supervision of a probation officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII__cl_108__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "a child ordered to be sent to a place of refuge is on leave of absence from the place of refuge or from being under the supervision of a Social Welfare Officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "@type": "akn:part",
      "eli:number": "XIV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_118",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_121",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_122",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_124",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_125",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Power of Court For Children conferred on High Court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act other than sections 96 and 97 shall affect the powers of the High Court and all the powers which may be exercised under this Act by a Court For Children in respect of a child may in like manner be exercised by the High Court. Child Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall cause to be kept and maintained, in such form as may be prescribed, a register to be known as the \"Register of Children in Need of Protection\". Contents of Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:name": {
        "@language": "en",
        "@value": "The Register shall contain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119",
      "schema:text": {
        "@language": "en",
        "@value": "details of every case or suspected case of a child in need of protection; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_119",
      "schema:text": {
        "@language": "en",
        "@value": "such other matters in relation to such case or suspected case as the Director General may from time to time determine. Access to Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "Details contained in the Register shall be furnished to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any Court when there is before the Court any proceedings concerning a child in need of protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any Court when so requested by the Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General, a Protector, any police officer or any member of a Child Protection Team or Child Welfare Committee when any of them requires such details for the purposes of any proceedings under this Act or for the purposes of taking action in respect of, or providing assistance to, a child in need of protection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "Details contained in the Register may be furnished to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "persons engaged in bona fide research whose access to the Register is authorized by the Director General for that purpose; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "persons or classes of persons authorized by the Director General to have access to the Register on the grounds that their access to the Register will promote the protection of a child or children. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "Details furnished under this section shall not include any information which discloses or likely to lead to the disclosure of the identity of any person who has given any information that a child is in need of protection. Offence in respect of Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who furnishes to any other person any details contained in the Register other than pursuant to section 120 commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both. Certificate of Registrar to be evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate purporting to be under the hand of the Registrar as to any entry in the Register, or as to any matter or thing which he is authorized by this Act or any regulation made under this Act to do or to make shall, until the contrary is proved, be admitted in evidence as proof of the facts stated therein as at the date of the certificate. Protection against suit and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "An action shall not lie and prosecution shall not be brought, instituted or maintained in any Court against the Government, Minister, Director General, Protector, Social Welfare Officer, probation officer, police officer or medical officer for anything done or omitted to be done under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "in good faith;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "in the reasonable belief that it was necessary for the purpose intended to be served thereby; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "for carrying into effect the provisions of this Act. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "All officers appointed or authorized under this Act shall be deemed to be public servants within the meaning of the Penal Code. Child General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV",
      "schema:text": {
        "@language": "en",
        "@value": "If no penalty is expressly provided for an offence under this Act, a person who commits such offence shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Institution and conduct of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126",
      "schema:text": {
        "@language": "en",
        "@value": "A prosecution in respect of an offence under this Act shall not be instituted except by or with the consent in writing of the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_126",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding that he has been authorized under the Criminal Procedure Code to prosecute, a person who is the investigating officer of an offence under this Act shall not prosecute the case in respect of that offence. Service of document"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "Service of document on any person shall be effected by-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "delivering the document to that person or by delivering the document at the last known place of residence of that person to an adult member of his family;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "leaving the document at the usual or last known place of residence or business of that person in a cover addressed to that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "forwarding the document by registered post in a prepaid letter addressed to that person at his usual or last known place of residence or business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "If a document is served by pre-paid registered post it shall be deemed to have been served on the day succeeding the day on which the document would have been received in the ordinary course of post. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as appears to him to be necessary or expedient for carrying out the provisions of this Act. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_q",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_r",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_s",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_t",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_u",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the powers conferred by subsection (1), the Minister may make regulations for all or any of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the conduct, management, discipline and control of approved schools, Henry Gurney Schools, probation hostels or centres;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the maintenance, discipline, treatment and education, vocational or otherwise, of the children or other persons detained in approved schools or Henry Gurney Schools including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the powers, duties and functions of the Board of Visitors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the grant of leave of absence to children and other persons detained;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "visits to, and inspections of, the schools by persons or bodies of persons appointed by the Minister from time to time for any area or areas; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the order or punishment for breaches of discipline of children or other persons detained;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the duties and responsibilities of probation officers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the constitution and duties of Child Welfare Committees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the qualifications, duties and training of advisers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the care, control, detention, discipline, admission, discharge and aftercare, temporary absence, maintenance, education and training of children placed in places of safety and places of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the management, administration, visitation and inspection of places of safety and places of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the care, maintenance and education of children placed in the care, custody or control of any fit and proper person under the provisions of this Act; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i__subpara_ii__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i",
      "schema:text": {
        "@language": "en",
        "@value": "the duties of such fit and proper person in taking care of the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i__subpara_ii__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_i__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the selection and qualifications of fit and proper persons with whom a child in need of care and protection may be placed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require the persons in charge of places of safety and places of refuge to submit to the Director General returns, reports and information in respect of children placed therein;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the duties and responsibilities of foster parents;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the composition, duties, functions and procedures of conducting the business of Boards of Visitors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedures and practice of Child Protection Teams;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the particulars, photographs or other means of identification to be furnished in relation to a child in need of protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require the furnishing of information as to changes of address of every child in need of protection and of the persons having custody of the child, and the transfer of records and registers in such cases;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the records to be kept in respect of every child in need of protection and the manner in which the records shall be kept;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the keeping and maintenance of Registers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the forms to be used and information to be furnished for any of the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the form of notices, orders, warrants, suramonses and bonds under this Act and the manner of service thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the functions, powers and duties of officers and persons conferred with powers under this Act and the manner and conditions in and under which the powers conferred by this Act shall be exercised by the officers or persons; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_u",
      "@type": "akn:paragraph",
      "eli:number": "u",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any other matter required or permitted to be prescribed under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2__para_v",
      "@type": "akn:paragraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for any other matter which the Minister deems expedient or necessary for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIV__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "Regulations made under subsection (1) may provide that the contravention of any provisions in the regulations is an offence and that the person who commits the offence is punishable on conviction with a fine or a term of imprisonment or both but may not provide for the fine to exceed five thousand ringgit or the term of imprisonment to exceed two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall apply in relation to an order made under this Act placing a child in the care of a fit and proper person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105",
      "schema:text": {
        "@language": "en",
        "@value": "An order placing a child in the care of a fit and proper person may be varied or revoked by the Court For Children or the Supervising Court on an application made by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Protector; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the probation officer, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "on an application made by the parent or guardian or any near relative of a child ordered to be placed in the care of a fit and proper person under subsection (1); and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_105__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Court For Children or the Supervising Court having power to vary or revoke the order is satisfied that the child is not being brought up in accordance with his religion as decided by his parent or guardian, the Court For Children or the Supervising Court, as the case may be, shall, unless a satisfactory undertaking is given by the person in whose care the child has been placed, either revoke the order or vary the order in such manner as the Court thinks best to secure that the child is from that time onwards brought up in accordance with that religion. Child who escapes or is removed from the care of fit and proper person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106",
      "schema:text": {
        "@language": "en",
        "@value": "A child who escapes from a person in whose care he has been placed under this Act may be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "arrested without a warrant; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "brought before the Court For Children by which the order was made or before the Supervising Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children or the Supervising Court before which a child is brought under subsection (1) shall immediately inquire into the case and after taking into account the recommendation of the Protector or probation officer, as the case may be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to be brought back to that person, if he is willing to receive the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_106__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make an order which the Court could have made if the child had been brought before the Court as being a child having no parent or guardian. Offence of removing or helping a child to escape from the care of fit and proper person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "removes a child from the care of a fit and proper person without lawful authority; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a child to escape from the person in whose care he has been placed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI__cl_107__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a child who has so escaped, or prevents him from returning to the care of such person, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV",
      "@type": "akn:part",
      "eli:number": "XV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_129",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_130",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SAVINGS AND TRANSITIONAL PROVISIONS Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV",
      "schema:name": {
        "@language": "en",
        "@value": "In this Part—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"appointed date\" means the date on which this Act comes into operation; \"Juvenile Court\" means the Juvenile Court established under the Juvenile Courts Act 1947 [Act 90]; \"repealed Acts\" means the Juveniles Court Act 1947 and the Child Protection Act 1991 [Act 468] repealed under this Act. Repeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV",
      "schema:text": {
        "@language": "en",
        "@value": "The Juvenile Courts Act 1947 and the Child Protection Act 1991 are repealed. References to Juvenile Court, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "All references to the Juvenile Court in any written law, or in any judgment, sentence, order, ruling or decision made under the repealed Acts and subsisting immediately before the appointed date shall, on the appointed date, be construed as references to the Court For Children established under this Act. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "The judgment, sentence, order, ruling or decision of the Juvenile Court, Supervising Court, High Court, Sessions Court or Magistrate Court under the repealed Act shall on the appointed date be deemed to have been made under this Act and continue to be in force and have effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "Any inquiry, trial or proceedings done, taken or commenced in or before the Courts referred to in subsection (2) before the appointed date shall be deemed to have been done, taken or commenced in or before the Court For Children, Supervising Court, High Court, Sessions Court or Magistrate Court under this Act and may accordingly be continued or concluded on and after the appointed date. Continuance of Council, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "The Co-ordinating Council for the Protection of Children, Child Protection Teams, Juvenile Welfare Committees, Boards of Visitors and committees established, and officers and persons appointed, under the repealed Acts shall, on the appointed date, be deemed to have been established or appointed under this Act and shall have the powers, rights, privileges, liabilities, duties and obligations conferred on the Council, Child Protection Teams, Child Welfare Committees, Boards of Visitors and committees established under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Council, Teams, Committees, Boards and committees established under the repealed Acts and any officers and persons appointed under the repealed Acts holding office on the day preceding the appointed date shall continue to hold office under this Act until their terms of appointment expire or they resign or their appointments are revoked in accordance with this Act and shall have the same powers, rights, privileges, liabilities, duties and obligations as if they had been appointed under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "Every act or thing done, taken or commenced by the members of the Council, Teams, Committees, Boards, committees, officers and persons referred to subsections (1) and (2), and the Board of Bill Yisiting Justices, under the repealed Acts before the appointed date shall, on and after the appointed date, be deemed to have been done, taken or commenced under this Act. Continuance of rules, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV",
      "schema:text": {
        "@language": "en",
        "@value": "All rules, regulations, orders, notices, forms, directions and authorization letters made, issued or given under the repealed Acts shall, in so far as they are consistent with this Act, continue in force until revoked or replaced by this Act. Institutions established or appointed"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV",
      "schema:text": {
        "@language": "en",
        "@value": "All approved schools, Henry Gurney Schools, places of detention, probation hostels, places of safety, places of refuge and other institutions or centres established or appointed under the repealed Acts shall on the appointed date be deemed to have been established or appointed under this Act. Prevention of anomalies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, whenever it appears to him necessary or expedient to do so, whether for the purpose of removing difficulties or preventing anomalies in consequence of the enactment of this Act, by order published in the Gaiette make such modifications to any prcwisions in this Act as he thinks fit but the Minister shall not exercise the powers conferred by this section after the expiration of two years from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XV__cl_135",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"modifications\" includes amendments, additions, deletions, substitutions, adaptations, variations, alterations and non-application of any provisions of this Act PlRST SCHEDULE (Section 15 and Paragraph 17(l)(i)) Offences under sections 299 to 301, 304 to 304A, 305 to 309A, 312 to 319, 321 to 322, 324, 326 to 340, 345 to 351, 353 to 358, 360 to 362, 364 to 373A, 374 to 375, 377, 377A, 377c to 377e of the Penal Code. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "CHARGE, BAIL, ETC. Trials of children to be in conformity with this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in any written law relating to the arrest, detention and trial of persons committing any offence but subject to subsections (3) and (4), a child who is alleged to have committed an offence shall not be arrested, detained or tried except in accordance with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "When a child is charged with an offence before a Court For Children and during the pendency of the case he attains the age of eighteen years the Court For Children shall, notwithstanding any provisions of this Act, continue to hear the charge against the child and may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "exercise the power under section 76;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "exercise the power under paragraph 91(1)(a), (b), (c), (d) or (g); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if the offence is punishable with imprisonment, impose any term of imprisonment with could be awarded by a Sessions Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "When an offence is committed by a child but a charge in respect of that offence is made against the child after he has attained the age of eighteen years, the charge shall be heard by a Court other than a Court For Children and that other Court may exercise the power mentioned in paragraph (2)(a), (b) or (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "A charge made jointly against a child and a person who has attained the age of eighteen years shall be heard by a Court other than a Court For Children and that other Court shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "exercise in respect of the child all the powers which may be exercised under this Act by a Court For Children; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_83__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "before exercising the powers referred to in paragraph (a), consider the probation report. Bail"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is arrested with or without a warrant, the child shall be brought before a Court For Children within twenty-four hours exclusive of the time necessary for the journey from the place of arrest to the Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring a child before a Court For Children within the time specified in subsection (1), the child shall be brought before a Magistrate who may direct that the child be remanded in a place of detention until such time as the child can be brought before the Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children before whom a child is brought shall inquire into the case and unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the charge is one of murder or other grave crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "it is necessary in the best interests of the child arrested to remove him from association with any undesirable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Court For Children has reason to believe that the release of the child would defeat the ends of justice, the Court For Children shall release the child on a bond with sureties, for such amount as will, in the opinion of the Court For Children, secure the attendance of that child upon the hearing of the charge, being executed by his parent or guardian or other responsible person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to affect the powers of a police officer to release the child arrested on bail in accordance with the Criminal Procedure Code. Separation of child from adult in police stations or Courts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "Appropriate arrangements shall be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "to prevent a child while—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "being detained in a police station; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "being conveyed to or from any Court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "waiting before or after attendance in any Court, from associating with an adult who is charged with an offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that a child, if a girl, while being so detained or conveyed, or waiting, is under the care of a woman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "to prevent the picture of a child while—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "being detained in a police station;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "being conveyed to or from any Court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_85__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "waiting before or after attendance in any Court, from being recorded in any manner on tape or film or by any electronic medium. Custody of child not discharged on bail after arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "If a child having been arrested and while awaiting trial before a Court For Children is not released under section 84, the Court For Children before whom the child is brought shall cause him to be detained in a place of detention provided under this Act until he can be brought before the Court having jurisdiction unless the Court For Children certifies that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it is impracticable to do so;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of so unruly or depraved a character that he cannot be safely so detained; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by reason of his state of health or of his mental or bodily condition it is inadvisable so to detain him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "Under the circumstances referred to in paragraph (1)(a), (b) or (c), the Court For Children shall have the power to order the child to be detained—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in a police station, police cell or police lock-up, separate or apart from adult offenders; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in a mental hospital, as the case may require. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "If an order for detention in a mental hospital is made under subsection (1), Chapter XXXIII of the Criminal Procedure Code shall apply with such modifications as may be necessary. Submission of information by police officer after arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1",
      "schema:text": {
        "@language": "en",
        "@value": "After the arrest of a child, the police officer or other person making the arrest shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "immediately inform a probation officer and the child's parent or guardian of the arrest; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_1__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is charged with any offence, cause to be transmitted to the probation officer a copy of the charge and other information necessary to enable the probation officer to take such action as may be necessary to prepare or obtain, as the case may be, a probation report."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_89",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "TRIALS Parent or guardian required to attend"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is charged with any offence, the Court For Children shall require the child's parents or guardian to attend at the Court For Children before which the case is heard or determined during all the stages of the proceedings, unless the Court For Children is satisfied that it would be unreasonable to require the attendance of the parents or guardian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "Any parent or guardian of a child who fails to attend the Court For Children when required to do so under subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Parents or guardian may be required to withdraw"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "If in any case the Court For Children considers it necessary in the best interests of the child, the Court may require his parents or guardian, as the case may be, to withdraw from the Court. Child Procedure in Court For Children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is brought before a Court For Children for any offence, it shall be the duty of the Court to explain to him in simple language suitable to his age, maturity and understanding the substance of the alleged offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children finds the child is not guilty, the Court shall record an order of acquittal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "a finding of guilt has been recorded; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "the Court is satisfied that the offence is proved, the child and the child's parent or guardian or other responsible person, if present, shall then be asked if they desire to say anything in extenuation or mitigation of the penalty or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children shall, before deciding how to deal with the child, consider the probation report."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "A probation report referred to in subsection (12) shall be prepared by a probation officer and the report—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "shall contain such information as to the child's general conduct, home surroundings, school record and medical history as may enable the Court For Children to deal with the case in the best interests of the child; and may put to him any question arising out of the probation report; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "may include any written report of a Social Welfare Officer, a registered medical practitioner or any other person whom the Court For Children thinks fit to provide a report on the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of obtaining a probation report, the Court For Children may from time to time release the child on bail or remand him in a place of detention."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15",
      "@type": "akn:subsection",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children has considered the probation report, the Court shall explain to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15",
      "schema:text": {
        "@language": "en",
        "@value": "the child the substance of any part of the report bearing on his character or conduct which the Court considers to be material to the manner in which he should be dealt with; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_15",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian, if present, the substance of any part of the report which the Court considers to be material to the manner in which the child should be dealt with and which has reference to the character, conduct, home surroundings, or health of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16",
      "@type": "akn:subsection",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If the child or his parent or guardian, having been explained the substance of any part of any such probation report under subsection (15), desires to produce information with respect to the report, the Court shall, if it thinks that the inforraation is material—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "adjourn the hearing for the production of further information; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "if necessary, require the person who made the report to attend the hearing when it resumes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_17",
      "@type": "akn:subsection",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "Before deciding on the order to be imposed, the Court shall ascertain from each of the advisers his opinion and all such opinions shall be recorded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18",
      "@type": "akn:subsection",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "After having recorded and considered the opinions of the advisers, the Court shall decide on the order to be imposed, but in so doing the Court—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be bound to conform to the opinions of the advisers or either of them; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_18",
      "schema:text": {
        "@language": "en",
        "@value": "shall record its reasons for dissenting from such opinions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "The duty referred to in subsection (1) may be undertaken, under the supervision of the Court by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the defence counsel acting for the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other responsible person as determined by the Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "After the substance of the alleged offence has been explained to the child, the Court shall ask the child whether he admits the facts constituting the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If the child admits the facts constituting the offence, the Court shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "ascertain that the child understands the nature and consequences of his admission; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "record a finding of guilt."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If the child does not admit the facts constituting the offence, the Court shall then hear the evidence of the witnesses in support thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "At the close of the evidence in chief of each witness, the witness may be cross-examined by or on behalf of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children shall, except if the child is legally represented, allow the child's parents or guardian or any relative or other responsible person to assist him in conducting his defence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If in any case where the child is not legally represented or assisted in his defence as provided for in subsection (7), the child, instead of asking questions by way of cross-examination, makes assertions, the Court For Children—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "may put to the child such questions as may be necessary in order to bring out, or explain anything in, the assertions of the child; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "shall then put to the witness such questions as the Court thinks necessary on behalf of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to the Court that a prima facie case is made out—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "the Court shall explain to the child the substance of the evidence against him and, in particular, any points in the evidence which specially tell against him or require explanation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "the child shall be allowed to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "give evidence upon oath or affirmation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "make any statement if he so desires; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_2__cl_90__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "the evidence of any witnesses for the defence shall be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "POWERS OF THE COURT FOR CHILDREN AT THE CONCLUSION OF THE TRIAL Powers of Court For Children on proof of offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children is satisfied that an offence has been proved the Court shall, in addition to any other powers exercisable by virtue of this Act, have power to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "admonish and discharge the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "discharge the child upon his executing a bond to be of good behaviour and to comply with such conditions as may be imposed by the Court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to be placed in the care of a relative or other fit and proper person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "for such period to be specified by the Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "with such conditions as may be imposed bv the Court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to pay a fine, compensation or costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make a probation order under section 98;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to be sent to an approved school or a Henry Gurney School;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the child, if a male, to be whipped with not more than ten strokes of a light cane—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g",
      "schema:text": {
        "@language": "en",
        "@value": "within the Court premises; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_g",
      "schema:text": {
        "@language": "en",
        "@value": "in the presence, if he desires to be present, of the parent or guardian of the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "impose on the child, if he is aged fourteen years and above and the offence is punishable with imprisonment and subject to subsection 96(2), any term of imprisonment which could be awarded by a Sessions Court. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91",
      "schema:text": {
        "@language": "en",
        "@value": "The words \"conviction\" and \"sentence\" shall not be used in relation to a child dealt with by the Court For Children and any reference in any written law to a person convicted, a conviction and a sentence shall, in the case of a child, be construed as a child found guilty, a finding of guilt and an order made upon a finding of guilt respectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91",
      "schema:text": {
        "@language": "en",
        "@value": "A finding of guilt of a child shall be disregarded for the purposes of any written law which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "imposes any disqualification or disability upon a convicted person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_91__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "authorizes or requires the imposition of any such disqualification or disability. Manner of executing whipping"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "The following provisions shall be followed when executing the order of whipping:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "before executing the whipping, the child shall be examined by a medical officer to certify that the child is in a fit state of health to undergo the whipping;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "the person shall use the light cane with average force without lifting his hand over his head so that the child's skin is not cut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "after inflicting a stroke, he shall lift the cane upward and not pull it;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "whipping may be inflicted on any part of the body except the face, head, stomach, chest or private parts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "the child shall wear clothes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "if during the execution of the whipping the medical officer certifies that the child is not in a fit state of health to undergo the remainder of the whipping, the whipping shall be finally stopped. Bill Parent or guardian to execute bond"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children shall, in addition to exercising any of the powers provided for in subsection 91(1), order the parent or guardian of the child to excute a bond for the child's good behaviour with or without security and with one or more of the following conditions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the parent or guardian accompanied by the child shall report at regular intervals to be determined by the Court, at the welfare department or police station situated nearest to the parent's or guardian's place of residence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the parent or guardian accompanied by the child shall attend interactive workshops organized at designated centres established for such purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is in an educational institution, that the parent or guardian shall consult with the child's teacher and head teacher or principal once a month for the duration of the bond;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is sent to an approved school or a Henry Gurney School, that the parent or guardian shall visit the child on a regular basis to be determined by the Court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other condition as the Court thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "If any parent or guardian fails to comply with any of the conditions of the bond referred to in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Court may order the security, if any, to be forfeited; and the provisions of the Criminal Procedure Code relating to the forfeiture of bonds shall apply in relation to the security."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "An order under subsection (1) shall not be made against a parent or guardian without giving the parent or guardian an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), an order under subsection (1) may be made if the Court For Children is satisfied on information Child given by a probation officer that the parent or guardian of the child, having been required to attend, has failed to do so, or is not available or cannot be found within a reasonable time. Power to order parent or guardian to pay fine, etc., instead of child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a child is charged before a Court For Children with any offence for the commission of which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a fine may be imposed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "compensation or costs or both compensensation and costs may be awarded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Court is of the opinion that the case would be best met by the imposition of all or any of those penalties, whether with or without any other punishment. the Court shall order that the fine imposed and compensation or costs awarded be paid by the parent or guardian of the child instead of by the child, unless the Court is satisfied that the parent or guardian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is not available or cannot be found within a reasonable time; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has not conduced to the commission of the offence by neglecting to exercise due care of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "If-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Court For Children thinks that a charge against a child is proved; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a child admits the facts constituting the offence in the charge, the Court may make an order requiring the parent or guardian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to pay compensation or costs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to give security for the good behaviour of the child, without proceeding to record a finding of guilt against the child. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "When the Court requires the parent or guardian to give security for the good behaviour of a child under subsection (2), one or more of the conditions mentioned in subsection 93(1) shall be imposed on the parent or guardian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "If the parent or guardian fails to comply with the conditions of the security, the Court may order the security to be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "An order under this section shall not be made against the parent or guardian of the child without giving the parent or guardian an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), an order under this section may be made if the Court For Children is satisfied on information given by a probation officer that the parent or guardian of the child, having been required to attend, has failed to do so or is not available or cannot be found within a reasonable time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "Any sum imposed and ordered to be paid by a parent or guardian of a child under this section or on forfeiture of any such security may be recovered from the parent or guardian in the manner provided by the Criminal Procedure Code in like manner as if the order had been made on the conviction of the parent or guardian of the offence with which the child was charged. Appeals"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Prosecutor or any child or his parent or guardian, if aggrieved by any finding or order of a Court For Children, may appeal to the High Court against such finding or order in accordance with the provisions of the Criminal Procedure Code relating to criminal appeals to the High Court from a Sessions Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "Except in the case of whipping, the execution of which shall be stayed pending appeal, no appeal shall operate as a stay of execution, but the Court For Children may stay execution on any judgement or order pending appeal, on such terms as to security for the payment of any money or the performance or non- performance of any act or the suffering of any punishment ordered by or in such judgement or order as the Court For Children may deem reasonable. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court shall, in all criminal appeals originating from a Court For Children, make its final decision within twelve months after the notice of appeal has been filed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal under this section shall, notwithstanding any other written law, be intituled \"Appeal By Children\" and in dealing with any such appeal, sections 12 and 15 shall apply, with such modifications as may be necessary, to the High Court. Restrictions on order of imprisonment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "A child under the age of fourteen years shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "be ordered to be imprisoned for any offence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "be committed to prison in default of payment of a fine, damages or costs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "A child aged fourteen years or above shall not be ordered to be imprisoned if he can be suitably dealt with in any other way whether by probation, or fine, or being sent to a place of detention or an approved school, or a Henry Gurney School, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "A child aged fourteen years or above shall not, if ordered to be imprisoned, be allowed to associate with adult prisoners. Death"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "A sentence of death shall not be pronounced or recorded against a person convicted of an offence if it appears to the Court that at the time when the offence was committed he was a child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "In lieu of a sentence of death, the Court shall order a person convicted of an offence to be detained in a prison during the pleasure of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Yang di-Pertuan Agong if the offence was committed in the Federal Territory of Kuala Lumpur or the Federal Territory of Labuan; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Ruler or the Yang di-Pertua Negeri, if the offence was committed in the State. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court makes an order under subsection (2), that person shall, notwithstanding anything in this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "be liable to be detained in such prison and under such conditions as the Yang di-Pertuan Agong or the Ruler or the Yang di-Pertua Negeri may direct; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "while so detained, be deemed to be in lawful custody."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "If a person is ordered to be detained at a prison under subsection (1), the Board of Visiting Justices for that prison—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "shall review that person's case at least once a year; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_3__cl_97__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "may recommend to the Yang di-Pertuan Agong or the Ruler or the Yang di-Pertua Negeri on the early release or further detention of that person, and the Yang di-Pertuan Agong or the Ruler or the Yang di-Pertua Negeri may thereupon order him to be released or further detained, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "PROBATION When probation may be ordered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to the Supervising Court that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a probationer has been found guilty by a Court of an offence committed during the probation period; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the probationer has been dealt with in respect of that offence, the Supervising Court may issue—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a summons requiring the probationer to appear at the place and time specified in the summons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a warrant for his arrest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "A warrant under subsection (1) shall not be issued except on information in writing and on oath submitted by the probation officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "A summons or warrant issued under this section shall direct the probationer to appear or to be brought before the Supervising Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_100",
      "schema:text": {
        "@language": "en",
        "@value": "If it is proved to the satisfaction of the Supervising Court that a probationer in whose case the order was made has been found guilty and dealt with in respect of an offence committed during the probation period, the Court may deal with him for the offence for which the order was made in any manner in which the Court could deal with him if the Court had just found him guilty of that offence. Child Effects of probation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101",
      "schema:text": {
        "@language": "en",
        "@value": "The finding of guilt for an offence for which an order is made under this Chapter placing the offender on probation shall be deemed not to be a conviction for any purpose other than for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings in which the order is made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any subsequent proceedings which may be taken against a child under this Chapter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not affect—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the right of any such child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to appeal against a finding of guilt; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to rely on a finding of guilt in bar of any subsequent proceedings for the same offence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_101__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the revesting or restoration of any property in consequence of the finding of guilt of any such child. Amendment of probation order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "schema:text": {
        "@language": "en",
        "@value": "If the Supervising Court is satisfied that a probationer proposes to change or has changed his residence from the district or area named in the probation order to another district or area, the Court may, and if an application on that behalf is made by the probation officer, shall, by order amend the probation order by substituting for the district or area named therein the district or area where the probationer proposes to reside or is residing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "schema:text": {
        "@language": "en",
        "@value": "If the probation order contains requirements which, in the opinion of the Supervising Court, cannot be complied with unless the probationer continues to reside in the district or area named in the order, the Supervising Court shall not amend the order except in accordance with subsection (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "schema:text": {
        "@language": "en",
        "@value": "If a probation order is amended under subsection (1), the Supervising Court shall send to the Court For Children for the new district or area named in the order a copy of the order together with such documents and information relating to the case as the Supervising Court considers likely to be of assistance to the Court For Children. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to subsections (1) and (3) the Supervsing Court may, on an application made by the probation officer or by the probationer, by order amend the probation order by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "revoking any of the requirements in the probation order; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "inserting in the probation order, either in addition to or in substitution for any such requirement, any requirement which could be included in the order if the order were then being made by the Court in accordance with section 98."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102",
      "schema:text": {
        "@language": "en",
        "@value": "The Supervising Court shall not amend a probation order under subsection (4) by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "reducing the probation period; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_102__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "extending that period such that the probation period becomes more than three years. Discharge of probation order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children by which a probation order was made or the Supervising Court may, on an application made by the probation officer, the parent or guardian of the probationer or the probationer, discharge the probation order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children shall not deal with an application under subsection (1) without summoning the probationer unless the application is made by the probation officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Court discharges a probation order under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_103__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a probationer is dealt with under section 99 or 100 for the offence for which he was placed on probation, the probation order shall cease to have effect. Child Court to give copies of amending or discharging order to probation officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4",
      "schema:text": {
        "@language": "en",
        "@value": "On the making of an order amending or discharging a probation order under section 102 or 103 respectively—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104",
      "schema:text": {
        "@language": "en",
        "@value": "the Court shall forthwith give sufficient copies of the amending or discharging order to the probation officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104",
      "schema:text": {
        "@language": "en",
        "@value": "the probation officer shall give a copy of the amending or discharging order to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the probationer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_104__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person in charge of the probation hostel or place in which the probationer is or was required by the order to reside."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children by or before which a child is found guilty of an offence other than—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any grave crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "voluntarily causing grievous hurt, rape, incest or outraging modesty; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under section 377B, 377c, 377D or 377E of the Penal Code, is of opinion that having regard to the circumstances, including the nature of the offence and the character of the child, it is appropriate to do so, the Court For Children may make a probation order. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Before making the probation order under subsection (1), the Court For Children shall explain to the child in simple language suitable to his age, maturity and understanding—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the effect of the order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that if he—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with the probation order; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "commits another offence, he shall be liable to be dealt with for the original offence as well as for the other offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "A probation order shall have effect for such period not less than one year and not more than three years from the date of the order as may be specified in the probation order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of securing the good conduct and supervision of the probationer or preventing a repetition by him of the same offence or the commission of other offences, a probation order shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "require the probationer to submit during that period to the supervision of a probation officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "specify that the probationer is not to commit any offence during the probation order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "contain such other requirements, as the Court having regard to the circumstances of the case considers necessary including any one or more of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "that the probationer shall reside at a probation hostel, at the home of his parent or guardian or relative or at some other place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "that the probationer shall attend an educational institution to be recommended by the probation officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "that the probationer shall remain indoors at his place of residence, be it at the probation hostel or at a home, during hours to be specified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the powers of the Court to make an order under section 91, the payment of sums by way of damages Bill for injury or compensation for loss shall not be included amongst the requirements of a probation order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "Before making a probation order containing requirements as to residence, the Court—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "shall consider the home surroundings of a child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "if the order requires a child to reside in a probation hostel, shall specify in the order the period for which he is so required to reside, but that period shall not extend beyond twelve months from the date of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children which makes a probation order shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "immediately give a copy of the order—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to the probationer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to the probation officer or other person under whose supervision the probationer is placed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to the person in charge of the probation hostel or other place in which the probationer is required by the order to reside; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "except if it is itself the Supervising Court, send to the Court For Children for the district or area named in the order in which the probationer is required to reside during the probation period a copy of the order together with such documents and information relating to the case as it considers likely to be of assistance to that Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_98",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children on making a probation order may, if it thinks it is expedient for the reformation of the probationer, give the probationer to the charge of any person who consents to accept the probationer, on that person's giving security for the good behaviour of the probationer; and the provisions of the Criminal Procedure Code on forfeiture of bonds shall apply in relation to the security. Failure to comply with probation order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "If at any time during the probation period it appears to a Supervising Court that a probationer has failed to comply with Child any of the requirements of the probation order under paragraph 98(4)(a) or (c), the Supervising Court may issue—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a summons requiring the probationer to appear at the place and time specified in the summons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a warrant for his arrest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A warrant under subsection (1) shall not be issued except on information in writing and on oath submitted by the probation officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A summons or warrant issued under this section shall direct the probationer to appear or be brought before the Supervising Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A probationer when arrested under subsection (1) may, if not brought immediately before the Supervising Court under subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "be detained in a place of detention; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "be released on bail, with or without sureties, until such time as he can be brought before the Supervising Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "If it is proved to the satisfaction of the Supervising Court that a probationer has failed to comply with any of the requirements of the probation order under paragraph 98(4)(a) or (c) the Court may, without prejudice to the continuance of the probation order—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "impose on him a fine not exceeding five thousand ringgit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "deal with the probationer for the offence in respect of which the probation order was made in any manner in which the Court could deal with him if the Court had just found him guilty of that offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A fine imposed under this section for failing to comply with any of the requirements of a probation order shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "deemed for the purpose of any written law to be a sum adjudged to be paid on a corviction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "taken into account in making any subsequent order upon the probationer under this section or section 100. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph (6)(a), \"sum adjudged to be paid on a conviction\" includes any costs, damages or compensation adjudged to be paid on a conviction, of which the amount is ascertained by the conviction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A probationer who fails to comply with paragraph 98(4)(b) shall be dealt with under section 100. Commission of further offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Section 45)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "Offences punishable under Part VI of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2",
      "schema:name": {
        "@language": "en",
        "@value": "Offences—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "punishable under sections 309, 312 to 313, 354, 370 to 373, 373A, 376 to 377 of the Penal Code; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "involving any acts or matters defined in sections 321 to 322, 339 to 340, 350 to 351, 360 to 362 of the Penal Code."
      }
    }
  ]
}
