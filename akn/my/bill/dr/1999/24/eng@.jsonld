      "schema:text": {
        "@language": "en",
        "@value": "established or appointed under section 73; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_4__para_b",
