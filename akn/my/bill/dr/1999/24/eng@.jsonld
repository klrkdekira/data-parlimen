      "schema:text": {
        "@language": "en",
        "@value": "CONTRIBUTION ORDERS Contribution by parent or guardian or other person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XIII__cl_109",
