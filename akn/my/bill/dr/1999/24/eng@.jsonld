      "schema:text": {
        "@language": "en",
        "@value": "the agent or trustee of any of the persons described in subparagraphs (i) and (ii); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to any conveyance, means the registered owner of the conveyance; Bill \"place\" includes any building, house, office, shop, flat, room or cubicle or part thereof, any open or enclosed space, and any conveyance; \"place of assignation\" means any place where communication is established with any child either directly or through intermediary for purposes of prostitution; \"place of detention\"—"
      }
