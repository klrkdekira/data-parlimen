      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "IN THE CARE OF FIT AND PROPER PERSON Child placed in the care of fit and proper person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XII",
      "@type": "akn:part",
