      "schema:text": {
        "@language": "en",
        "@value": "TRAFFICK1NG IN AND ABDUCTION OF CHILDREN Unlawful transfer of possession, custody or control of child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who takes part in any transaction the object or one of the objects of which is to transfer or confer, wholly or partly, temporarily or permanently, the possession, custody or control of a child for any valuable consideration commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who without lawful authority or excuse harbours or has in his possesston, custody or control a child with respect to whom the temporary or permanent possession, custody or control has been transferred or conferred for valuable consideration by any other person within or outside Malaysia commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2), if any person harbours or has in his possession, custody or control a child without lawful authority or excuse, the child shall, until the contrary is proved, be presumed to be a child with respect to whom the temporary or permanent possession, custody or control has been transferred or conferred for valuable consideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be a defence in any prosecution under this section to prove that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer took place in contemplation of or pursuant to a bona fide marriage or adoption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_48__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "at least one of the natural parents of the child or the guardian of the child was a consenting party to the marriage or to the adoption by the adopting party. and had expressly consented to the particular marriage or adoption. Importation of child by false pretences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "by or under any false pretence or representation made; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "by fraudulent or deceitful means used, either within or outside Malaysia, brings or assists in bringing a child into Malaysia commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Examination of child and person in charge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "A Protector or any person authorized in writing by a Protector may require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "a child who has entered or been brought into Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "any person who may appear to have the custody or control of such child, to appear before him, at any reasonable time and at any convenient place, to be examined pursuant to section 113. Bill Protector may require security"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "If a Protector has reasonable cause to believe that a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "has been brought into Malaysia either—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "after having been transferred for valuable consideration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by fraud, misrepresentation or any false pretence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "has been transferred to the custody or control of any person for valuable consideration either within or outside Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "is being detained against his will by some person other than his parent or guardian,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "require any person in whose custody or under whose control the child appears to be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa",
      "schema:text": {
        "@language": "en",
        "@value": "to furnish him with copies of the child's and that person's own photographs; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_C"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa",
      "schema:text": {
        "@language": "en",
        "@value": "to furnish security to the satisfaction of the Protector that the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "will not leave the area or the State in which he then is without the prior written consent of the Protector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "will not be transferred to the care or custody of any other person without the prior written consent of the Protector; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_aa__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "will be produced before the Protector whenever the Protector requires; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "in the first instance, or if default be made in complying with any order made under paragraph (aa), make an order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "the child be taken out of the custody of the person in whose care, custody or control the child is and placed the child in a place of safety; or Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_51__para_c__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "on such security and on such conditions as the Protector may require, the child be placed in the custody of a relative or other fit and proper person, until the child attains the age of eighteen years or for any shorter period. Offence of taking or sending out a child without appropriate consent of person having lawful custody"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Any parent or guardian who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "does not have the lawful custody of a child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "takes or sends out a child, whether within or outside Malaysia, without the consent of the person who has the lawful custody of the child commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "A person has lawful custody of a child under this section if he has been conferred custody of the child by virtue of any written law or by an order of a Court, including a Syariah Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be a defence under this section if a parent or guardian takes or sends a child away without the consent of the person having lawful custody of the child if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "does it in the belief that the other person consented, or would have consented, if he was aware of all the relevant circumstances; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "has taken all reasonable steps to communicate with the other person but has been unable to communicate with him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian has reasonable grounds to believe that the child is being abused, neglected, abandoned or exposed in a manner likely to cause the child physical or emotional injury; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_52__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the other person has unreasonably refused to consent although he was aware of all the relevant circumstances. Bill Recovery order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to the Court that there is reason to believe that a child had been taken or sent away without the consent of the person who has lawful custody of the child as described in section 52, the Court may make a recovery order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "A recovery order may be made by the Court on application being made by or on behalf of any person who has the lawful custody of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, a \"recovery order\" may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "direct any person who is in a position to do so to produce the child on request to any authorized person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "authorize the removal of the child by any authorized person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require any person who has information as to the child's whereabouts to disclose that information to the authorized person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "authorize any police officer to enter into any premises specified in the order and search for the child, using reasonable force if necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intentionally obstructs an authorized person from exercising the powers under subsection (3) commits an offence and shall on conviction be liable to imprisonment for a term not exceeding three years and to whipping not exceeding six strokes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "If the parent or guardian of a child requests the Court For Children in writing to detain a child in an approved school, place of refuge, probation hostel or centre on the ground that the parent or guardian is unable to exercise proper control over the child, the Court For Children—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall immediately inquire into the circumstances of the child's case;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall direct the probation officer to submit a probation report to the Court For Children for the Court to determine whether an order under subsection (2) may be made in respect of the child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may order the child to be temporarily detained in an approved school, place of refuge, probation hostel or centre if it deems it necessary to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "If after considering the report referred to in paragraph (1)(b) the Court For Children is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is expedient so to deal with the child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian understands the results which will follow from and consents to the making of the order, the Court For Children may, on the recommendation of the probation officer, order that the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "be sent to an approved school, place of refuge, probation hostel or centre, as may be appropriate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "be placed for such period not exceeding three years under the supervision of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "a probation officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_46__subsec_2__para_b__subpara_bb",
      "schema:text": {
        "@language": "en",
        "@value": "some other person appointed for the purpose by the Court, and any such order may require the child to reside for a period not exceeding twelve months in a probation hostel. Bill Supervision by probation officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children makes an order under paragraph 46(2)(bb) placing a child under the supervision of a probation officer or of some other person, that officer or other person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall, while the order remains in force, visit, advise and befriend the child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may, if it appears necessary to do so, at any time while the order remains in force, bring the child before the Supervising Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Supervising Court before whom a child is brought under paragraph (1}(b) may, if it deems it expedient to do so, amend the order made under section 46 and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "send the child, subject to the consent of the child's parent or guardian, to an approved school, place of refuge or centre, whichever is appropriate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "place the child in the care of a fit and proper person, whether a relative or not, who is willing to undertake the care of the child, for the unexpired period of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Meaning of child in need of protection and rehabilitation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "A child is in need of protection and rehabilitation if the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "is being induced to perform any sexual act, or is in any physical or social environment which may lead to the performance of such act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "lives in or frequents any brothel or place of assignation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "is habitually in the company or under the control of brothel-keepers or procurers or persons employed or directly interested in the business carried on in brothels or in connection with prostitution. Removal of a child to place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any Protector or police officer who is satisfied on reasonable grounds that a child is in need of protection and rehabilitation may order the child to be removed to a place of refuge and the child shall be temporarily detained in such place of refuge. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Every child who is temporarily detained under subsection (1) shall be brought before a Court For Children within twenty- four hours exclusive of the time necessary for the journey from the place where the child was so removed to the Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring a child before a Court For Children within the time specified in subsection (1), the child shall be brought before a Magistrate who may direct that the child be placed in a place of refuge until such time as the child can be brought before a Court For Children,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children is satisfied that a child brought before it is in need of protection and rehabilitation, the Court For Children may order the child to be detained in a place of refuge until—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an inquiry under section 40 to inquire into the circumstances of the child's case has been completed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a report of the inquiry has been submitted to the Court For Children by the Protector under subsection 40(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children is not satisfied that a child brought before it is in need of protection and rehabilitation, the Court For Children shall order the child to be returned to the care and custody of his parent or guardian. Orders upon completion of an inquiry"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An inquiry mentioned in subsection 39(4) shall be made by a Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The period of supervision for the purpose of subsection (9) shall be determined by the Board of Visitors of the place of refuge on the recommendation of the Protector but shall not in any case exceed one year from the date of expiration of the period of detention of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may on the application of the child or his parent or guardian exempt the child from the application of subsection (9) if he is satisfied that the case warrants such exemption. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the powers of the Board of Visitors pursuant to subsection (6) the Court For Children may, on the application in writing made by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "a Protector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of the child to whom an order made under this section relates; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "the child, amend, vary or revoke any order made under this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "if the Court For Children is satisfied that it is in the best interests of the child to do so; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_12__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "upon proof that the circumstances under which the order was made have changed after the making of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An order under subsection (3) shall not be made without giving the parent or guardian of the child an opportunity to attend and be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (13), an order under subsection (3) may be made if the Court For Children is satisfied on information given by a Protector that the parent or guardian of the child, having been required to attend, has failed to do so, or is not available or cannot be found within a reasonable time. Children in urgent need of protection"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector shall complete the inquiry and submit the report of the inqury to the Court For Children within a period not exceeding one month from the date of the admission of a child to a place of refuge under subsection 39(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "If after considering the report submitted under subsection (2) the Court For Children is satisfied that any child brought Bill before it is a child in need of protection and rehabilitation the Court may, subject to the other provisions in this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to be detained in a place of refuge for a period of three years from the date of the admission of the child into a place of refuge under subsection 39(1) and the order shall be an authority for his detention in a place of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make an order placing the child for such period not exceeding three years from the date of the order in the care of a person whether a relative or not who is willing and whom the Court For Children considers to be a fit and proper person to undertake the care of such child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make an order requiring the parent or guardian of the child to execute a bond, with or without sureties, as the Court For Children may determine, for such period not exceeding three years from the date of the order subject to such conditions as the Court thinks fit for the proper care and guardianship of the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make an order placing the child under the supervision of a Social Welfare Officer appointed for the purpose by the Court For Children, subject to such conditions as the Court thinks fit and for such period not exceeding three years from the date of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The order made under paragraph (3)(a) or (d) may have the effect of extending the period of such detention or supervision, as the case may be, beyond the date on which the child attains the age of eighteen years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "In determining what order to be made under subsection (3), the Court For Children shall treat the best interests of a child as the paramount consideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (3)(a), the Board of Visitors of the place of refuge in which a child is being detained may reduce the period of detention of the child but no reduction shall be made which will have the effect of enabling the child to be released from the place of refuge within twelve months from the date of his admission into the place of refuge as specified in that paragraph, except by the authority of the Minister. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children shall, when making an order under paragraph (3)(a) or (d), order the parent or guardian of a child to execute a bond for the.duration of the order with such conditions which may include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraph (3)(a), regular visits to the place of refuge where the child is placed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraph (3)(d), ensuring that the child remains indoors within stipulated times."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "is ordered to execute a bond under subsection (3) or (7), as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with any of the conditions of such bond, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any child sent to a place of refuge for detention under paragraph (3)(a) shall, on the expiration of the period of his detention whether by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "effluxion of time; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_40__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "reason of any reduction made pursuant to subsection (6), be placed under the supervision of a Social Welfare Officer or other person appointed by the Protector for such purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any child who is in urgent need of protection may on his own application in the prescribed form be received by the Protector into a place of refuge if the Protector is satisfied that the child is in urgent need of protection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A child is in urgent need of protection if there is reasonable cause to believe that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the child is being threatened or intimidated for purposes of prostitution or for purposes of having sexual intercourse with another or for any immoral purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the child is to be confined or detained by another in contravention of this Part; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an offence against this Part is being or likely to 'be committed in respect of the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is a female, that she is pregnant out of wedlock."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsections (4) and (5), and if circumstances warrant it, the person in charge of any place of refuge may receive into the place of refuge any child who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is in urgent need of protection; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "makes an application under this section to the person in charge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "If the person in charge of a place of refuge receives any child under subsection (3), that child shall be brought before a Protector within twenty-four hours of his admission into the place of refuge with a full report of the circumstances."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A child admitted under this section is permitted to reside in the place of refuge only so long as the Protector is satisfied that the child is in urgent need of protection under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Protector—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "who receives a child under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_41__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "before whom a child is brought under subsection (4), shall immediately inform the Court For Children of such admission with a full report of the circumstances and shall in the like manner inform the Court of his departure. Inquiries and detention of a child who has been bought or acquired under false pretences, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "If the Protector has reasonable cause to believe that a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children is not satisfied that the child brought before it is in need of protection and rehabilitation, the Court For Children shall order the child to be returned to the care and custody of his parent or guardian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been brought into or is to be sent out of Malaysia and the custody of the child has been acquired either—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "after having been purchased; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by fraud, false representation or false pretence, whether or not for the purpose of prostitution; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been procured either within or outside Malaysia for the purpose of being used, trained or disposed of as a prostitute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is being detained against his will for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "prostitution or for immoral purposes; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "being sent out of Malaysia for the purposes of prostitution or for immoral purposes, the Protector may order the child to be removed to a place of refuge and the child shall be temporarily detained in such place of refuge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Every child who is temporarily detained under subsection (1) shall be brought before a Court For Children within twenty-four hours exclusive of the time necessary for the journey from the place where the child was so removed to the Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring a child before a Court For Children within the time specified in subsection (1), the child shall be brought before a Magistrate who may direct that the child be placed in a place of refuge until such time as the child can be brought before a Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children before whom a child is brought shall order the child to be detained in a place of refuge until—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an inquiry into the circumstances of the child's case has been completed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a report of the inquiry has been submitted to the Court For Children by the Protector under subsection (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "An inquiry referred to in subsection (4)(a) shall be made by a Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Protector shall complete the inquiry and submit the report of the inquiry to the Court For Children within a period not exceeding one month from the date of the admission of the child to the place of refuge. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "If after considering the report submitted under subsection (6) the Court For Children is satisfied that a child brought before it is in need of protection and rehabilitation, the Court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "order the child to be detained in a place of refuge for such period not exceeding three years from the date of the order as the Court may in the best interests of the child deem fit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "make an order placing the child under the supervision of a Social Welfare Officer appointed by the Court for such period not exceeding three years from the date of the order as the Court may in the interest of such child deem fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The order made under subsection (7) may have the effect of extending the period of such detention or supervision, as the case may be, beyond the date on which the child attains the age of eighteen years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_1__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections 40(12) to (14) shall apply in respect of any order made under subsection (7) as they apply to an order made under section 40."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES Offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sells, lets for hire or otherwise disposes of, or buys or hires or otherwise obtains possession of, a child with intent that the child is to be employed or used for the purpose of prostitution, either within or outside Malay sia, or knowing or having reason to believe that the child will be so employed or used; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "procures a child for purposes of prostitution or for the purposes of sexual intercourse, except by way of marriage, with any other person, either within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by or under any false pretence, false representation, or fraudulent or deceitful means made or used, either within or outside Malaysia, brings or assists in bringing into, or takes out of or assists in taking out of, Malaysia, a child with intent that the child is to be employed or used for purposes of prostitution, either within or outside Malaysia, or knowing or having reason to believe that the child will be so employed or used;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "brings into Malaysia, receives or harbours a child knowing or having reason to believe that the child has been procured for purposes of prostitution or for the purpose of having sexual intercourse, except by way of marriage, with any other person, either within or outside Malaysia, and with intent to aid such purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowing or having reason to believe that a child has been brought into Malaysia in the circumstances as set out in paragraph (c) or has been sold, let for hire, or hired or purchased in the circumstances as set out in paragraph (a), or in contravention of any other written law receives or harbours the child with intent that he is to be employed or used for purposes of prostitution either within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "detains a child in a brothel against the child's will;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "detains a child in any place against the child's will with intent that the child is to be employed or used for purposes of prostitution or for any unlawful or immoral purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by means of any advertisement or other notice published in any manner or displayed in any place offers a child for purposes of prostitution or seeks information for that purpose or any person who accepts such advertisement or notice for publication or display;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "acts as an intermediary on behalf of another or exercises control or influence over the movements of another in such a manner as to show that the person is aiding or abetting or controlling the prostitution of that other; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "engages or hires, for any valuable consideration, a child to provide services for his sexual gratification;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "attempts to do any act in contravention of this section, commits an offence and shall on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of offences under paragraphs (a) to (h) or paragraph (k), be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding fifteen years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_1__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an offence under paragraph (i) or (j), be liable to a fine not exceeding fifty thousand ringgit and to imprisonment for a term of not less than three years but not more than fifteen years and shall also be punished with whipping of not more than six strokes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is convicted of a second or subsequent offence—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "under paragraphs (1 )(a) to (g) or paragraph (1 )(k), shall be liable to whipping of not more than ten strokes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "under paragraphs (1)(i) or (j), shall be punished with whipping of not less than six strokes but not more than ten strokes, in addition to any term of imprisonment imposed in relation to such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 173A and 294 of the Criminal Procedure Code shall not apply in respect of offences under paragraphs (1)(i) and (j). Presumptions relating to section 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of section 43, it shall be presumed until the contrary is proved that a person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "who takes or causes to be taken into a brothel a child has disposed of the child with the intent or knowledge mentioned in paragraph 43(1 )(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "who receives a child into a brothel or harbours a child in a brothel has obtained possession of the child with the intent or knowledge mentioned in paragraph 43(1)(a); Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "has detained a child in any brothel or in any place against the child's will if, with intent to compel or induce him to remain in the brothel or the place, that person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "withholds from the child any wearing apparel or any other property belonging to the child or any wearing apparel commonly or last used by the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "threatens the child with legal proceedings if the child takes away any wearing apparel or any other property which has been lent or hired out or supplied to the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "threatens the child with legal proceedings for the recovery of any debt or alleged debt or uses any other threat; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_44__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "without any lawful authority detains the child's identity card issued under the law relating to national registration or the child's passport. Detention pending proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Any Court inquiring into or trying any offence specified in the Second Schedule (in this Act referred to as \"scheduled offence\") may order a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with respect to whom a scheduled offence is alleged to have been committed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whom the Court considers to be in need of protection, to be detained temporarily in a place of safety until the determination of the proceedings against the person charged but the detention shall not extend beyond the date on which the child attains the age of eighteen years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_VI__chp_2__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the determination of the proceedings, the Court may, on an application made by the Protector and if the Court is satisfied that a child is in need of protection, order the detention of the child in a place of safety in accordance with paragraph 30(1)(d). Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Meaning of child in need of care and protection"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A child is in need of care and protection if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child has been or there is substantial risk that the child will be physically injured or emotionally injured or sexually abused by his parent or guardian or a member of his extended family;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child has been or there is substantial risk that the child will be physically injured or emotionally injured or sexually abused and his parent or guardian, knowing of such injury or abuse or risk, has not protected or is unlikely to protect the child from such injury or abuse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of the child is unfit, or has neglected, or is unable, to exercise proper supervision and control over the child and the child is falling into bad association;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of the child has neglected or is unwilling to provide for him adequate care, food, clothing and shelter;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_e__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child— (i) has no parent or guardian; or Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "has been abandoned by his parent or guardian and after reasonable inquiries the parent or guardian cannot be found, and no other suitable person is willing and able to care for the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child needs to be examined, investigated or treated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of restoring or preserving his health; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "his parent or guardian neglects or refuses to have him so examined, investigated or treated;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child behaves in a manner that is, or is likely to be, harmful to himself or to any other person and his parent or guardian is unable or unwilling to take necessary measures to remedy the situation or the remedial measures taken by the parent or guardian fail;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is such a conflict between the child and his parent or guardian, or between his parents or guardians, that family relationships are seriously disrupted, thereby causing him emotional injury;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child is a person in respect of whom any of the offences specified in the First Schedule or any offence of the nature described in sections 31, 32 and 33 has been or is suspected to have been committed and his parent or guardian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i",
      "schema:text": {
        "@language": "en",
        "@value": "is the person who committed such offence or is suspected to have committed such offence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_i",
      "schema:text": {
        "@language": "en",
        "@value": "has not protected or is unlikely to protect him from such offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the same household as the child referred to in paragraph (i);or Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_bb",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_cc"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the same household as the person who has been convicted of the offence referred to in paragraph (i), and appears to be in danger of the commission upon or in respect of him of a similar offence and his parent or guardian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "is the person who committed or is suspected to have committed the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "is the person who is convicted of such offence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii__subpara_cc",
      "@type": "akn:subparagraph",
      "eli:number": "cc",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_j__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "is unable or unwilling to protect him from such offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the child is allowed to be on any street, premises or place for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "begging or receiving alms, whether or not there is any pretence of singing, playing, performing or offering anything for sale; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_1__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "carrying out illegal hawking, illegal lotteries, gambling or other illegal activities detrimental to the health and welfare of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Part, a child is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "physically injured if there is substantial and observable injury to any part of the child's body as a result of the non-accidental application of force or an agent to the child's body that is evidenced by, amongst other things, a laceration, a contusion, an abrasion, a scar, a fracture or other bone injury, a dislocation, a sprain, haemorrhaging, the rupture of a viscus, a burn, a scald, the loss or alteration of consciousness or physiological functioning or the loss of hair or teeth;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "emotionally injured if there is substantial and observable impairment of the child's mental or emotional functioning that is evidenced by, amongst other things, a mental or behavioural disorder, including anxiety, depression, withdrawal, aggression or delayed development; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sexually abused if he has taken part, whether as a participant or an observer, in any activity which is sexual in nature for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any pornographic, obscene or indecent material, photograph, recording, film, videotape or performance; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_1__cl_17__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "sexual exploitation by any person for that person's or another person's sexual gratification."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "TEMPORARY CUSTODY AND MEDICAL EXAMINATION AND TREATMENT Taking a child into temporary custody"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "Any Protector or police officer who is satisfied on reasonable grounds that a child is in need of care and protection may take the child into temporary custody, unless the Protector or police officer is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the taking of proceedings in relation to the child is undesirable in the best interests of the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings are about to be taken by some other person. Production before Court For Children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 20, every child who is taken into temporary custody under section 18 shall be brought before a Court For Children within twenty-four hours exclusive of the time necessary for the journey from the place the child was so taken into custody to the Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring a child before a Court For Children within the time specified in subsection (1), the child shall be brought before a Magistrate who may direct that the child be placed in—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a place of safety; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the care of a fit and proper person, until such time as the child can be brought before a Court For Children. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is placed in a place of safety or in the care of a fit and proper person under subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person in charge of the place of safety or such fit and proper person shall have the like control over, and responsibility for the maintenance of, the child as the parent of the child would have had; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the child shall continue in the care of the person referred to in paragraph (a) notwithstanding that the child is claimed by his parent or guardian or any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector who takes a child into temporary custody under this section shall, immediately upon such taking, cause the parent or guardian of the child to be notified of such taking."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A police officer who takes a child into temporary custody under this section shall, immediately upon such taking, notify the Protector of such taking. Child in need of medical examination or treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If a Protector or police officer who takes a child into temporary custody under section 18 is of the opinion that the child is in need of medical examination or treatment, the Protector or police officer may, instead of bringing the child before a Court For Children or Magistrate, as the case may be, present the child before a medical officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If at the time of being taken into custody a child is a patient in a hospital, the Protector or police officer who takes the child into custody may leave the child in the hospital."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If a Protector or police officer does not take a child into temporary custody under section 18 but he is satisfied on reasonable grounds that the child is in need of medical examination or treatment, he may direct in writing the person who appears to him to have the care of the child for the time being to immediately take the child to a medical officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If the person referred to in subsection (3) fails to comply within forty-eight hours with a direction made under that subsection, a Protector or police officer may take the child into temporary Bill custody for the purpose of presenting the child before a medical officer. Medical examination and treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "A medical officer before whom a child is presented under subsection 20(1) or (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "shall conduct or cause to be conducted an examination of the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "may, in examining the child and if so authorized by a Protector or police officer, administer or cause to be administered such procedures and tests as may be necessary to diagnose the child's condition; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "may provide or cause to be provided such treatment as he considers necessary as a result of the diagnosis. Authorization of hospitalization"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "If the medical officer who examines a child under section 21 is of the opinion that the hospitalization of the child is necessary for the purposes of medical care or treatment, a Protector or police officer may authorize the child to be hospitalized. Control over hospitalized children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is hospitalized under section 22, the Director General shall have the like control over, and responsibility for the maintenance of, that child as a person in charge of a place of safety would have had if the child had been placed in that place of safety. Authorization of medical treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If, in the opinion of a medical officer, the child referred to in section 21 requires treatment for a minor illness, injury or condition, a Protector or police officer may authorize such treatment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If, in the opinion of a medical officer, the child referred to in section 21 is suffering from a serious illness, injury or condition Child or requires surgery or psychiatric treatment, a Protector or police officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall immediately notify or take reasonable steps to notify and consult the parent or guardian of the child or any person having authority to consent to such treatment; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may, with the written consent of the parent or guardian or such person, authorize such medical or surgical or psychiatric treatment as may be considered necessary by a medical officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "If a medical officer has certified in writing that there is immediate risk to the health of a child, a Protector may authorize, without obtaining the consent referred to in subsection (2), such medical or surgical or psychiatric treatment as may be considered necessary by the medical officer but only under any of the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the parent or guardian of the child or any person having authority to consent to such treatment has unreasonably refused to give, or abstained from giving, consent to such treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the parent or guardian or the person referred to in paragraph (a) is not available or cannot be found within a reasonable time; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_24__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Protector believes on reasonable grounds that the parent or guardian or the person referred to in paragraph (a) has ill-treated, neglected, abandoned or exposed, or sexually abused, the child. Steps to be taken after medical examination or treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A child who is taken into custody under section 18 and is medically examined or treated under section 21 shall be brought before a Court For Children within twenty-four hours—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the completion of such examination or treatment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is hospitalized, of his discharge from the hospital. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring the child before a Court For Children within the time specified in subsection (1), the child shall be brought before a Magistrate who may direct that the child be placed in—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a place of safety; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the care of a fit and proper person, until such time as the child can be brought before a Court For Children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A child who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is taken into custody under subsection 20(4); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "subsequently undergoes medical examination or treatment, shall be returned to the person from whose care the child was taken—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "upon the completion of such examination or treatment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_25__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is hospitalized, upon his discharge from the hospital. No liability incurred for giving authorization"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is examined or treated pursuant to section 21 or 24—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Protector or police officer who authorizes such examination or treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the medical officer who examines or treats the child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all persons acting in aid of the medical officer, shall not incur any liability at law by reason only that a child is examined or treated pursuant to that section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing contained in subsection (1) relieves a medical officer from liability in respect of the examination or treatment of a child which liability he would have been subject to had the examination or treatment been carried out or administered with the consent of Child the parent or guardian of the child or person having authority to consent to the examination or treatment. Duty of medical officer or medical practitioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If a medical officer or a registered medical practitioner believes on reasonable grounds that a child he is examining or treating is physically or emotionally injured as a result of being ill-treated, neglected, abandoned or exposed, or is sexually abused, he shall immediately inform a Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any medical officer or registered medical practitioner who fails to comply with subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If the registered medical practitioner referred to in subsection (1) is a medical officer, he may take the child referred to in that subsection into temporary custody until such time as the temporary custody of the child is assumed by a Protector or police officer. Duty of member of the family"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "If any member of the family of a child believes on reasonable grounds that the child is physically or emotionally injured as a result of being ill-treated, neglected, abandoned or exposed, or is sexually abused, he shall immediately inform a Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the family who fails to comply with subsection (1) commits an offence and shall on conviction be released on a bond on conditions to be determined by the Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the family who fails to comply with any of the conditions of the bond provided for in subsection (2) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Bill Duty of child care provider"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "If a child care provider believes on reasonable grounds that a child is physically or emotionally injured as a result of being ill-treated, neglected, abandoned or exposed, or is sexually abused, he shall immediately inform a Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any child care provider who fails to comply with subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Powers of Court For Children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children is satisfied that any child brought before it under section 19 or 25 is a child in need of care and protection, the Court For Children may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An order under subsection (1) shall not be made without giving the parent or guardian of the child an opportunity to attend and be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (10), an order under subsection (1) may be made if the Court For Children is satistled on information given by a Protector that the parent or guardian of the child, having been required to attend, has failed to do so, or is not available or cannot be found within a reasonable time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children is not satisfied that a child brought before it under section 19 or 25 is in need of care and protection, the Court For Children shall order the child to be returned to the care and custody of his parent or guardian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children may on the application of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "a Protector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "the person in charge of a place of safety; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of a child. amend, vary or revoke any order made under this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "if the Court For Children is satisfied that it is in the best interests of the child to do so; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_13__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "upon proof that the circumstances under which the order was made have changed after the making of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order his parent or guardian to execute a bond to exercise proper care and guardianship for a period specified by the Court For Children;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make an order placing the child in the custody of a fit and proper person for a period specified by the Court For Children;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "without making any other order or in addition to an order made under paragraph (a) or (b), make an order placing the child under the supervision of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "a Protector; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "some other person appointed for the purpose by the Court For Children, for a period specified by the Court For Children;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make an order placing the child in a place of safety for a period of three years from the date of the order or until he attains the age of eighteen years, whichever is the shorter; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a child who has no parent or guardian or who has been abandoned as described in paragraph , make an order placing the child in the care, Child custody and control of a foster parent found to be suitable hy the Director General for a period of two years or until he attains the age of eighteen years, whichever is the shorter, and pending that, place the child in a place of safety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children makes an order under paragraph (1)(e), the Director General shall, in order to give effect to the order, immediately endeavour to place the child in the care, custody and control of a foster parent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If at any subsequent time the foster parent intends to return the child who has been placed in his care, custody and control under paragraph (1)(e), he shall report in person to the Protector and bring the child before the Protector, and the Protector shall place the child in a place of safety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If during the period mentioned in paragraph (1)(e) the parent or guardian of the child concerned has not claimed the child or made any appearance, the Court For Children may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "at the expiry of that period; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b__subpara_bb"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "if the Court is satisfied that reasonable steps have been taken by the Protector to trace the parent or guardian of the child, make an order placing the child for adoption by the foster parent or any person who wishes to adopt the child and in any such case—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the parent's or guardian's consent for the adoption of the child shall be dispensed with; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b__subpara_bb",
      "@type": "akn:subparagraph",
      "eli:number": "bb",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the Adoption Act 1952 [Act 257} (in the case of a child not professing the religion of Islam) and the Registration of Adoptions Act 1952 [Act 253] shall be construed accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In determining what order to be made under subsection (1), the Court For Children shall treat the best interests of a child as the paramount consideration. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Before making an order under subsection (1) or (4), the Court For Children shall consider and take into account any report prepared by the Protector which—-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "shall contain such information as to the family background, general conduct, home surrounding, school record and medical history of a child as may enable the Court For Children to deal with the case in the best interests of the child; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "may include any written report of a Social Welfare Officer, a registered medical practitioner or any other person whom the Court For Children thinks fit to provide a report on the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In order to enable the Protector to prepare and submit the report referred to in subsection (6), the Court For Children may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "from time to time, adjourn the case for such periods not exceeding two months at a time; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "make in respect of the child, as an interim order having effect only during the period of adjournment, any order which the Court For Children could have made under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children may, in making any order under subsection (1), impose such conditions or give such directions as the Court may deem fit for the purpose of ensuring the safety and well-being of the child in respect of whom such order is made, and such conditions or directions may include the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "that the parent or guardian of the child accompanied by the child shall attend interactive workshops organized at designated centres established for such purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is placed at a place of safety, that the parent or guardian shall visit the child on a regular basis as determined by the Court For Children; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "if the child is in an educational institution, that the parent or guardian shall consult with the child's teacher and head teacher or principal once a month."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any parent or guardian who fails to comply with any of the conditions imposed or directions given under subsection (8) Child commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES IN RELATION TO THE HEALTH AND WELFARE OF CHILDREN Ill-treatment, neglect, abandonment or exposure of children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being a person having the care of a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "abuses, neglects, abandons or exposes the child in a manner likely to cause him physical or emotional injury or causes or permits him to be so abused, neglected, abandoned or exposed; or Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sexually abuses the child or causes or permits him to be so abused, commits an offence and shall on conviction be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding ten years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Court—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall, in addition to any punishment specified in subsection (1), order the person convicted of an offence under that subsection to execute a bond with sureties to be of good behaviour for such period as the Court thinks fit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may include in the bond executed under paragraph (a) such conditions as the Court thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If a person who is ordered to execute a bond to be of good behaviour under subsection (2) fails to comply with any of the conditions of such bond, he shall be liable to a further fine not exceeding ten thousand ringgit or to a further imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A parent or guardian or other person legally liable to maintain a child shall be deemed to have neglected him in a manner likely to cause him physical or emotional injury if, being able to so provide from his own resources, he fails to provide adequate food, clothing, medical or dental treatment, lodging or care for the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A person may be convicted of an offence against this section notwithstanding that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "suffering or injury to the health of the child in question or the likelihood of suffering or injury to the health of the child in question was avoided by the action of another person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_31__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the child in question has died. Children not to be used for begging, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who causes or procures any child or, being a person having the care of a child, allows that child to be on any street, premises or place for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "begging, receiving alms, whether or not there is any pretence of singing, playing, performing or offering anything for sale; or Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "carrying out illegal hawking, illegal lotteries, gambling or other illegal activities detrimental to the health and welfare of the child, commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both. Offence to Ieave child without reasonable supervision"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being a parent or a guardian or a person for the time being having the care of a child, leaves that child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "without making reasonable provision for the supervision and care of the child;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "for a period which is unreasonable having regard to all the circumstances; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_3__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "under conditions which are unreasonable having regard to all the circumstances, commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "NOTIFICATION ON TAKING A CHILD INTO CARE, CUSTODY OR CONTROL Application and interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "This Chapter shall not apply to the taking of a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "into the care, custody or control of any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in pursuance of an order of a Court of competent jurisdiction; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by any Protector or police officer acting under this Act; Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "as an inmate of a place of safety or of an orphanage, hospital, institution or centre—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "maintained by the Federal Government or by any of the State Governments; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "approved by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "as a boarder at an educational institution registered under any written law relating to education; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "who is regularly attending an educational institution registered under any written law relating to education into the custody of a friend or relative of his parent or guardian with the consent of his parent or guardian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "In this Chapter, \"guardian\" of a child means a person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "lawfully appointed by deed or will or by the order of a competent Court to be the guardian of the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has lawfully adopted the child. Notification of taking a child into care, custody or control"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "If a person takes a child into his care, custody or control—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the person in whose care the child was at the time of such taking, shall, not later than one week thereafter, notify the Protector of such taking."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "On receiving any notification under subsection (1), the Protector shall make such inquiry as he thinks fit as to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the circumstances and the reasons for the taking; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the suitability for that purpose of the person who has taken the child into his care, custody or control. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "If, after the inquiry referred to in subsection (2), the Protector deems it expedient to do so in the best interests of the child, he may either—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order that the child be returned to the care, custody or control of his parent or guardian or the person in whose care he was at the time of such taking; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "permit the taking of the child on such terms and conditions as the Protector may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "If the taking of a child by any person has been permitted under paragraph (3)(b) subject to any term or condition and default is made in complying with such term or condition, the Protector may by warrant under his hand order that the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "be taken out of the care, custody or control of such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "be placed in a place of safety or in the custody of a relative or other fit and proper person on such terms and conditions as the Protector may require until the child attains the age of eighteen years or for any shorter period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, a \"person\" includes an institution or a centre—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "not maintained by the Federal Government or by any of the State Governments; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "not approved by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A Protector shall, on receiving any notification under this section, record the particulars of such notification in a register in such form as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Bill Subsequent obligations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "If the taking of a child has been notified to and permitted by a Protector under section 35, the person who has taken the child shall, if at any subsequent time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he intends to return the child to the care, custody or control of the parent or guardian of the child or any other person from whom the child was taken; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "without his knowledge or consent, the child has left his care, custody or control, report in person to the Protector and shall, whenever practicable, bring or cause to be brought before the Protector the child and the parent or guardian of the child or any other person from whom the child was taken."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "On receiving a report under subsection (1), the Protector shall make a note of the report and shall if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the child and the parent or guardian of the child or any other person from whom the child was taken are present at the time such report is received, return the child to his parent or guardian or such person, as the case may be; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parent or guardian of the child or any other person from whom the child was taken is not present at the time such report is received—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "take the child into temporary custody until he can be returned to his parent or guardian or such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "immediately send written information to the last known place of residence of his parent or guardian or of such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Child Power of Protector to require child to be produced before him"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "If a Protector has reason to believe that there is, within the area or the State within which he exercises jurisdiction, a child in respect of whose taking no notification has been made pursuant to section 35, he may, by summons under his hand addressed to the person who has or is believed to have the care, custody or control of the child, require that person to appear and to produce the child before him at the time and place specified in the summons for the purposes of an inquiry under subsection (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "If a person on whom a summons has been served under subsection (1) fails to produce the child at the time and place specified in the summons, the Protector may apply to a Magistrate for a search warrant under section 111 to be issued to search for the child and to produce him before the Protector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Any child named or described in such warrant may be temporarily—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "detained in a place of safety; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "placed in the custody of a relative or other fit and proper person on such terms and conditions as the Protector may require, until the Protector has completed his inquiry under this Chapter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Protector shall make such inquiry as he thinks fit as to-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the circumstances and the reasons for the taking of the child referred to in subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the suitability of the person who has taken the child into his care, custody or control."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "If, after the inquiry mentioned in subsection (4), the Protector deems it expedient in the best interests of the child, he may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "order that the child be returned to the care, custody or control of his parent or guardian or the person in whose care he was at the time of such taking; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "permit the taking of the child on such terms and conditions as the Protector may require. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "If the taking of a child by any person has been permitted under paragraph (5)(b) subject to any term or condition and default is made in complying with such term or condition, the Protector may by warrant under his hand order that the child —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "be taken out of the care, custody or control of such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_V__chp_4__cl_37__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "be placed in a place of safety or in the custody of a relative or other fit and proper person on such terms and conditions as the Protector may require until the child attains the age of eighteen years or for any shorter period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
