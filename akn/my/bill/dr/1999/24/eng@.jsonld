        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_X__chp_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CRIMINAL PROCEDURE IN COURT FOR CHILDREN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_XI",
      "@type": "akn:part",
