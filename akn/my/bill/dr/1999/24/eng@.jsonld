        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General who shall be the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Director General who shall be the Deputy Chairman; Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry responsible for child protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry responsible for health;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry responsible for education;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry responsible for human resources;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry responsible for information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Attorney General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Inspector General of Police;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "two representatives from the Department of Social Welfare;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the ministry, in the State of Sabah, charged with the responsibility for welfare services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the ministry, in the State of Sarawak, charged with the responsibility for welfare services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not more than seven persons with appropriate experience, knowledge and expertise on matters relating to the welfare and development of children including any person qualified to advise on relevant indigenous, ethnic, cultural or religious factors, to be appointed by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Registrar who shall be the Secretary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Each member of the Council appointed under paragraph (l)(m) shall, unless he sooner resigns, hold office for a period not exceeding three years and is eligible for reappointment. Meeting of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet at least four times in a year at such time and place as the Chairman may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Council shall be presided over—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the absence of the Chairman, by the Deputy Chairman; or Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the absence of the Chairman and Deputy Chairman, by a member elected by the members present from amongst themselves."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members of the Council shall form a quorum at any meeting of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "If on any question to be determined there is an equality of votes, the Chairman, or the Deputy Chairman or the member referred to in paragraph (2)(c) if he is presiding over the meeting, shall have a casting vote in addition to his deliberative vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Council may determine its own procedure. Establishment of committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish such committees as it deems necessary or expedient to assist it in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be chaired by a member of the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall conform to and act in accordance with any direction given to it by the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Members of the committees established under subsection (1) may be appointed from amongst members of the Council or such other persons as the Council thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may revoke the appointment of any member of a committee without assigning any reason therefor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign by giving notice in writing to the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, at any time, discontinue or alter the constitution of a committee. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall hold its meetings at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend a meeting of the committee for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting. Establishment of Child Protection Teams"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall establish throughout Malaysia groups of persons, each group to be known as a \"Child Protection Team\", for the purpose of co-ordinating locally-based services to families and children if children are or are suspected of being in need of protection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A Child Protection Team shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Protector to be named by the Council on the advice of the Director General, who shall be the chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a medical officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a senior police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A Child Protection Team shall have the authority to co- opt from time to time such other persons as it may reasonably require to assist it in the performance of its functions and duties or as the circumstances of each case may require, including any person qualified to advise on relevant indigenous, ethnic, cultural or religious factors."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "COURTS FOR CHILDREN Constitution and jurisdiction of Court For Children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Courts constituted in accordance with this Act and sitting for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "hearing, determining or disposing of any charge against a child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "exercising any other jurisdiction conferred or to be conferred on Courts For Children by or under this Act or by any other written law, shall be known as the \"Courts For Children\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall consist of a Judge of the Sessions Court who, in the exercise of his functions as a Court For Children except when making an order under subsection 39(4), 42(4), 84(2) or 86(1), as the case may require, shall be assisted by two advisers to be appointed by the Minister from a panel of persons resident in the State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "One of the two advisers mentioned in subsection (2) shall be a woman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the advisers are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "to inform and advise the Court For Children with respect to any consideration affecting the order made upon a finding of guilt or other related treatment of any child brought before it; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "if necessary, to advise the parent or guardian of the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall have jurisdiction to try all offences except offences punishable with death."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Except as modified or extended by this Part, the Criminal Procedure Code [Act 593] shall apply to Courts For Children as if Courts For Children were Sessions Courts. Place of sitting and persons who may be present in Court For Children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall, if practicable, sit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "either in a different building or room from that in which sittings of Courts other than Courts For Children are held; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on different days from those on which sittings of those other Courts are held."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children sits in the same building as other Courts, the Court For Children shall have a different entrance and exit from those of the other Courts to enable children to be brought to and from the Court For Children with privacy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be present at any sitting of a Court For Children except —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "members and officers of the Court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the children who are parties to the case before the Court, their parents, guardians, advocates and witnesses, and other persons directly concerned in that case; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "such other responsible persons as may be determined by the Court. Period specified in any order made by Court For Children not to extend beyond the date child attains the age of eighteen years"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Except as specified in this Act, any period specified in any order made by a Court For Children under this Act shall not extend beyond the date on which the child to whom the order relates attains the age of eighteen years. Child Court For Children may order detention, etc. to extend beyond the date child attains the age of eighteen years"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything in this Act or any written law or any rule of law, a Court For Children may, if the Court finds that circumstances warrant it, make an order relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the detention of a child in a place of detention, probation hostel, approved school or Henry Gurney School, approved institution or centre;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the supervision of a child by a Social Welfare Officer or probation officer, as the case may be; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any probation period, which has the effect of extending the period of such detention, supervision or probation beyond the date on which the child attains the age of eighteen years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The order referred to in subsection (1) shall be complied with by the child and all parties to whom the order relates so long as the order remains in force and have effect. Restrictions on media reporting and publication"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, any mass media report regarding—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any step taken against a child concerned or purportedly concerned in any criminal act or omission, be it at the pre-trial, trial or post-trial stage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any child in respect of whom custody is taken under Part V;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any child in respect of whom any of the offences specified in the First Schedule has been or is suspected to have been committed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any proceedings under Part VI, shall not reveal the name, address or educational institution or include any particulars calculated to lead to the identification of any child so concerned either as being the person against or in respect of whom action is taken or as being a witness to the action. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A picture of any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "child concerned in any of the matters mentioned in subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "other person, place or thing which may lead to the identification of any child so concerned. shall not be published in any newspaper or magazine or transmitted through any electronic medium."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children, in any case—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "may, if the Court For Children is satisfied that it is in the interest of justice to do so; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall, in the case of an application by or with the authority of a Protector, dispense with the requirements of this section to such an extent as the Court may deem expedient."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, \"transmit\" includes broadcast by radio or television. Presumption as to age"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "If in a charge for an offence triable under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it is alleged that the person who committed the offence was under or had attained any specified age; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that person appears to the Court For Children to have been at the date of the commission of the alleged offence under or to have attained the specified age, as the case may be, he shall, for the purposes of this Act, be presumed at that date to have been under or to have attained that age, as the case may be, and any order made therein shall not be invalidated by any subsequent proof that the age has been incorrectly stated. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "If the Court For Children is in doubt as to the exact age of the person who is alleged to have committed an offence, the certificate of a medical officer to the effect that, in his opinion, the person has or has not attained a specified age may be given in evidence, and the Court For Children shall declare that person's age for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The age so declared by the Court For Children under subsection (2) shall be deemed to be the true age of that person, unless and until the contrary is proved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "INSTITUTIONS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "PLACES OF SAFETY AND PLACES OF REFUGE Places of safety"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint any place, institution or centre to be a place of safety for the care and protection of children. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time direct the closing of any place of safety established or appointed under subsection (1). Places of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint any place, institution or centre to be a place of refuge for the care and rehabilitation of children."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time direct the closing of any place of refuge established or appointed under subsection (1). Child who escapes or is removed from place of safety or place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1",
      "schema:text": {
        "@language": "en",
        "@value": "Any child who escapes or is removed from a place of safety or place of refuge without lawful authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "may be arrested without a warrant by any Protector or police officer and shall be brought back to the place of safety or place of refuge; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "shall be detained-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a place of safety, for such period which is equal to the unexpired residue of his stay under the order originally made by the Court For Children; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a place of refuge, for such period which is equal to the period during which he was unlawfully at large and for the unexpired residue \" of his term of detention under the order originally made by the Court For Children. Offence of removing or heiping a child to escape from place of safety or place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "removes a child from a place of safety or place of refuge without lawful authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a child to escape from a place of safety or a place of refuge; or Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_1__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a child who has so escaped, or prevents him from returning to the place of safety or place of refuge, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "PLACES OF DETENTION Places of detention"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint such places of detention as may be required for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "A child shall ordinarily be remanded in custody in a place of detention established or appointed under this Act and situated in the same State in which is situated the Court For Children by which the child is remanded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The order or judgment in pursuance of which a child is committed to custody in a place of detention shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "delivered with the child to the person in charge of the place of detention; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an authority for his detention in the place of detention in accordance with the terms of the order or judgement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "A child while being detained and while being conveyed to and from the place of detention shall be deemed to be in lawful custody."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "shall cause places of detention to be inspected; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "may make regulations—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "as to the classification, treatment, employment and control of children detained in such places of detention; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_58__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the appointment of fit and proper persons to visit periodically children detained in such places of detention. Child who escapes or is removed from place of detention"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "Any child who escapes or is removed from a place of detention without lawful authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "may be arrested without a warrant by any Protector or police officer and be brought back to the place of detention; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "shall be detained in the place of detention for the unexpired residue of his term of detention under the order originally issued by the Court For Children. Offence of removing or helping a child to escape from place of detention"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "removes a child from a place of detention without lawful authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a child to escape from a place of detention; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_2__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a child who has so escaped, or prevents him from returning to the place of detention, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "PROBATION HOSTELS Probation hostels"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint such probation hostels as may be required for the purposes of this Act. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for the regulation, management and inspection of probation hostels. Chiid under ten years of age not to be sent to probation hostel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall not make an order requiring a child under the age of ten years to be sent to a probation hostel. Child who escapes or is removed from probation hostel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any child who escapes or is removed from a probation hostel without lawful authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "may be arrested without a warrant by any probation officer or police officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "be brought back to that hostel or before the Supervising Court, and the Supervising Court may deal with him for the offence for which he was sent to the probation hostel in the same manner in which the Supervising Court could deal with him if it had just found him guilty of that offence. Offence of removing or helping a child to escape from probation hostel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "removes a child from a probation hostel without lawful authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a child to escape from a probation hostel; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_3__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a child who has so escaped, or prevents him from returning to the probation hostel, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "APPROVED SCHOOLS Approved schools"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint such approved schools as may be required for the education, training and detention of children to be sent there in pursuance of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may classify such approved schools—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "according to the ages of the persons for whom they are intended; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_65__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in such other ways as he may think fit so as to ensure that a child sent to an approved school is sent to a school appropriate to his case. Child under ten years of age not to be sent to approved school"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall not make an order requiring a child under the age of ten years to be sent to an approved school. When a child can be sent to approved school"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a child is found guilty of any offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the probation report submitted to the Court For Children shows that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the parents or guardian of the child can no longer exercise or is incapable of exercising any proper control over him; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the child is in need of institutional rehabilitation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it appears to the Court For Children that although the offence committed is not serious in nature but it is expedient that the child be subject to detention for such Bill term and under such instruction and discipline as appears most conducive to his reformation, the Court For Children shall, on the recommendation of the probation officer, send the child to an approved school."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children orders a child to be sent to an approved school, the order shall be an authority for his detention in that approved school for a period of three years from the date of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2) the Board of Visitors of the approved school to which a child is sent may, in their discretion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shorten the period of detention for reasons which appear to them to be sufficient; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "permit any such child to be released for such period and upon such conditions as they may deem fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "A child shall not be permitted to be released from an approved school under paragraph (3)(b) during the first twelve months of the period of detention without the consent in writing of the Minister. Approved school order to be delivered to the authority, etc. who conveys child to the school"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children which makes an approved school order shall cause it to be delivered to the authority or person responsible for conveying the child to the school, and the authority or person who conveys the child to the school shall deliver the approved school order to the person for the time being in charge of the school."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Court For Children which makes an approved school order shall cause all such information in the possession of the Court with respect to a child as is in the opinion of the Court should be known by the person for the time being in charge of the school, to be transmitted to the person for the time being in charge of the school."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "If a child has been ordered to be sent to an approved school, any person who knowingly harbours or conceals him after the Child time has come for him to go to the school commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "If a person authorized to take a child to an approved school is, when the time has come for him to go to the school, unable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "find the child; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "obtain possession of the child. the Court For Children may, if satisfied by information on oath or affirmation that there is reasonable ground for believing that some person named in the information can produce the child, issue a summons requiring the person so named to attend at the Court on such day as may be specified in the summons and produce the child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "If the person referred to in subsection (4) fails to comply with the requisition under that subsection without reasonable excuse he shall, in addition to any other liability to which he may be subject to under this Act, on conviction be liable to a fine not exceeding ten thousand ringgit. Further detention in approved school beyond period of order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
      "schema:text": {
        "@language": "en",
        "@value": "If the person for the time being in charge of an approved school is satisfied that a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "whose period of detention in the approved school is about to expire needs further care or training; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "cannot be placed in suitable employment without such further care or training, he may, if the Board of Visitors of the approved school consent, detain him for a further period not exceeding six months but any such period shall not extend beyond the date the child attains the age of eighteen years. Bill Aftercare of child released from approved school"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
      "schema:text": {
        "@language": "en",
        "@value": "If a child is sent to an approved school, the Court For Children making the order shall, at the same time, make an order that after the expiration of the period of his detention he shall, for a period of one year, be under the supervision of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "a probation officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "such other person as the Child Welfare Committee may appoint. Escape from approved school, etc. or failure to return to approved school after expiry of leave, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Any child who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "escapes from the approved school in which he is detained, or from any hospital, home or place in which he is receiving medical attention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being absent from the approved school on temporary leave of absence or with permission—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "runs away from the person in whose charge he is; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "fails to return to the approved school upon the expiration of his leave, or upon the revocation of such permission; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being absent from the approved school under supervision, fails to return to the approved school upon being recalled, may be arrested without a warrant and be brought before the Court For Children where the child is found or the approved school is situated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "If a child brought before a Court For Children under subsection (1) is under the age of fourteen years, the Court For Children shall order the child to be brought back to the approved school or to be sent to another approved school for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a period which is equal to the period during which he was unlawfully at large;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the remainder of his period of detention; and Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such period not exceeding six months as the Court may direct, in addition to the periods mentioned in paragraphs (a) and (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "If a child brought before the Court For Children under subsection (1) has attained the age of fourteen years, the Court For Children may order the child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to be brought back to the approved school or to be sent to another approved school for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a period equal to the period during which he was unlawfully at large;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the remainder of his period of detention; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "such further period not exceeding six months as the Court may direct; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_71__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if circumstances warrant it and on the recommendation of the probation officer the Court thinks it necessary to do so, to be sent to a Henry Gurney School for such period as the Court may direct. Offence of removing or helping a child to escape from approved school"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "removes a child from an approved school without lawful authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a child to escape from an approved school; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_4__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a child who has so escaped, or prevents him from returning to the approved school, commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5",
      "@type": "akn:chapter",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_74",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "HENRY GURNEY SCHOOLS Henry Gurney Schools"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, establish or appoint such Henry Gurney Schools as may be required for the purposes of this Act. Child under fourteen years of age not to be sent to Henry Gurney School"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5",
      "schema:text": {
        "@language": "en",
        "@value": "A Court For Children shall not make an order requiring a child under the age of fourteen years to be sent to a Henry Gurney School. When a child can be sent to Henry Gurney School"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "If—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a child is found guilty of any offence punisbable with imprisonment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the probation report submitted to the Court For Children shows that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the parents or guardian of the child can no longer exercise or is incapable of exercising any proper control over him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the child is habitually in the company of persons of bad character; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the child is not suitable to be rehabilitated in an approved school; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it appears to the Court For Children—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence committed is serious in nature; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by reason of the nature of the child's criminal habits and tendencies it is expedient that the child be Child subject to detention for such term and under such instruction and discipline as appears most conducive to his reformation and the repression of crime, the Court For Children shall, on the recommendation of the probation officer, send the child to a Henry Gurney School."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "If a Court For Children orders a child aged fourteen years or above to be sent to a Henry Gurney School—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the order shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "an authority for his detention for a period of three years from the date of the order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "valid for his detention up to but not after he has attained the age of twenty-one years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sections 68 to 72 shall apply with the following modifications:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the words \"approved school\" wherever appearing there shall be substituted the words \"Henry Gurney School\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in section 69, for the words \"the Board of Visitors of the approved school consent\" there shall be substituted the words \"the Director General of Prisons in the case of a Henry Gurney School consents\" and the age referred to in that section shall be increased by three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the Director General of Prisons may, in his discretion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shorten the period of detention of a child in a Henry Gurney School for reasons which appear to him to be sufficient; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_5__cl_75__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "release any such child with permission for such period and upon such conditions as he may deem fit to impose. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6",
      "@type": "akn:chapter",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_76",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_80"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "SPECIAL PROVISIONS IN RELATION TO PLACES OF SAFETY, PLACES OF REFUGE, APPROVED SCHOOLS AND HENRY GURNEY SCHOOLS Power in respect of persons of eighteen years but under twenty- one years of age"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything in this Act, the High Court, a Sessions Court and a Magistrate's Court shall have the power to order the detention, in a Henry Gurney School, up to but not after he has attained the age of twenty-one years, of any person who has attained the age of eighteen years but has not attained the age of twenty- one years at the date of making such order. Power of Minister to remove person undergoing imprisonment to Henry Gurney School"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by warrant under his hand, direct any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has attained the age of eighteen years but has not attained the age of twenty-one years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is in prison under a sentence of imprisonment, to be removed to a Henry Gurney School."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "If a warrant is made under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the unexpired residue of that person's prison sentence shall be deemed to be cancelled; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such warrant shall be an authority for the detention of that person in the Henry Gurney School under this Act until the date when his sentence, less any remission for good conduct earned while serving his sentence in prison, would, but for this section, have expired."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "A warrant under subsection (1) shall not be made unless the age of the person and the unexpired residue of his sentence of imprisonment permit him to be detained in the Henry Gurney School for not less than two years. Child Power of Minister to remove child undergoing imprisonment to approved school or Henry Gurney School"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by warrant under his hand, direct a child who is in prison under an order of imprisonment to be removed to an approved school or a Henry Gurney School."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "If a warrant is made under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the unexpired residue of that child's prison order shall be deemed to be cancelled; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such warrant shall be an authority for the detention of that child in the approved school or the Henry Gurney School, as the case may be, under this Act until the date when his prison order, less any remission for good conduct earned while serving his term of imprisonment, would, but for this section, have expired."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time for reasons which appear to him to be sufficient, by order in writing direct the removal of any child from—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an approved school to any other approved school or to a Henry Gurney School; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_78__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a Henry Gurney School to any other Henry Gurney School or to an approved school, as may be specified in the order. Power to substitute term of detention to term of imprisonment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6",
      "schema:text": {
        "@language": "en",
        "@value": "If it is made to appear to any Court For Children upon the application of the person in charge of any approved school or Henry Gurney School that any child detained in the approved school or Henry Gurney School under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "has been guilty of a serious and wilful breach of the rules of the approved school or Henry Gurney School;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "has been guilty of inciting other inmates of the approved school or Henry Gurney School to such a breach; or Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "is incorrigible or exercising a bad influence on the other inmates of the approved school or Henry Gurney School, the Court For Children may substitute for the unexpired residue of the term of detention of that child such term of imprisonment not exceeding the unexpired residue as the Court may determine. Transfer of child from one place of safety or place of refuge to another place of safety or place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_6",
      "schema:name": {
        "@language": "en",
        "@value": "Without prejudice to any written"
      },
      "schema:text": {
        "@language": "en",
        "@value": "immigration,whenever an order has been made under this Act for the detention of a child in a place of safety or place of refuge and it appears to the Director General that in the best interests of the child it is expedient that he be transferred from that place of safety or place of refuge to another place of safety or place of refuge within Malaysia, it shall be lawful for the Director General to issue an order that the child shall be so transferred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7",
      "@type": "akn:chapter",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7__cl_81",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7__cl_82"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Child or person detained to be subject to regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7",
      "schema:text": {
        "@language": "en",
        "@value": "Every child detained in any place of safety or place of refuge, place of detention, probation hostel, approved school or Henry Gurney School, or every person detained in a Henry Gurney School under this Act shall during the period of the child's or person's detention, be subject to such regulations as may be prescribed. Board of Visitors"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_IX__chp_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint for each place of safety, place of refuge and approved school a Board of Visitors to perform such duties and functions as the Minister may prescribe. Child"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Child Act 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies throughout Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— \"approved school\" means a school established or appointed under section 65 and includes a centre; \"approved school order\" means an order made by a Court For Children sending a child to an approved school; \"Board of Visiting Justices\" means the Board of Visiting Justices appointed under section 64 of the Prison Act 1995 [Act 537]; \"Board of Visitors\" means the Board of Visitors appointed by the Minister under section 82; \"brothel\" means any place occupied or used by any two or more persons whether at the same time or at different times for the purpose of prostitution; Child \"centre\" means a privately-owned shelter or institution approved by the Minister, set up for the care, protection and rehabilitation of children; 'child\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "means a person under the age of eighteen years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to criminal proceedings, means a person who has attained the age of criminal responsibility as prescribed in section 82 of the Penal Code [Act 574]; \"child care provider\" means a person who looks after one or more children for valuable consideration for any period of time; \"Child Protection Team\" means a team established by the Council under section 7; \"Child Welfare Committee\", in relation to a State, means a Committee appointed by the Minister to oversee the welfare of persons coming within the purview of Part X and to assist the probation officer in any district or area; \"contribution order\" means a contribution order made under section 108; \"conveyance\" includes an aircraft, a ship, a boat or a vessel whether afloat or not, and any vehicle; \"Council\" means the Co-ordinating Council for the Protection of Children established under section 3; \"Court\" means the Court For Children or any other Court, as the case may require; \"Court For Children\" means the Court For Children constituted under section 11; \"Deputy Director General\" means the Deputy Director General of Social Welfare; \"Director General\" means the Director General of Social Welfare; Bill \"extended family\", in relation to a person, means persons related by consanguinity, affinity or adoption to that person; \"foster parent\" means a person, not being a parent or a relative of a child—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "to whom the care, custody and control of a child has been given by order of a Court under paragraph 30(l)(e); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "permitted by the Protector under section 35 or 37, as the case may be, to receive a child into his care, custody and control; \"grave crime\" includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "the offences of murder, culpable homicide not amounting to murder or attempted murder;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "all offences under the Firearms (Increased Penalties) Act 1971 [Act 37];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "all offences under the Internal Security Act 1960 [Act 82] punishable with imprisonment for life or with death;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/24/eng@/~part_I__cl_2__subsec_1__list_3__para_d",
