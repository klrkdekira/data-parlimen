      "schema:name": {
        "@language": "en",
        "@value": "Consolidated Fund (Expenditure on Account) Bill 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Consolidated Fund (Expenditure on Account) Act 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 January 2000. Authorisation of expenditure of RM18,429,403,000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In conformity with paragraph (a) of Article 102 of the Federal Constitution, expenditure of an amount not exceeding the sum of eighteen billion four hundred and twenty-nine million four hundred and three thousand ringgit (RM18,429,403,000) to be issued from the Consolidated Fund for the service of that part of the year 2000 preceding the date of coming into operation of the Supply Act in respect of that year is hereby authorised."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The amount authorised for each service specified in Column (1) of the Schedule is as specified in Column (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Column (1) Purpose Title B. 1 Parliament B. 2 Office of the Keeper of the Rulers' Seal B. 3 Audit Department B. 4 Election Commission B. 5 Public Services Commission B. 6 Education Service Commission B. 7 Prime Minister's Department B. 8 Public Services Department B. 9 Statistics Department B. 10 Attorney General's Chambers B. 11 Anti-Corruption Agency B. 12 Office of the Federal Secretary Sabah B. 13 Office of the Federal Secretary Sarawak B. 14 Ministry of Housing and Local Government B. 15 Town and Country Planning Department B. 16 Fire and Rescue Department B. 17 Ministry of Youth and Sports B. 18 Ministry of Primary Industries B. 19 Ministry of Agriculture B. 20 Ministry of International Trade and Industry B. 21 Ministry of Domestic Trade and Consumer Affairs B. 22 Ministry of Culture, Arts and Tourism B. 23 Department of National Archives B. 24 Museum and Antiquities Department B. 25 Ministry of Defence B. 26 Ministry of Education B. 27 Department of National Library Consolidated Fund (Expenditure on Account) Column (1) Purpose Titte B. 28 Treasury B. 29 Treasury General Services B. 30 Contribution to Statutory Funds B. 31 Royal Customs and Excise Department B. 32 Valuation and Property Services Department B. 33 Ministry of Works B. 34 Ministry of Health B. 35 Ministry of Home Affairs B. 36 Royal Malaysia Police B. 37 Immigration Department B. 38 Registration of Societies Department B. 39 National Registration Department B. 40 Prison Department B. 41 Civil Defence Department B. 42 Ministry of National Unity and Social Development B. 43 Ministry of Land and Co-operative Development B. 44 Ministry of Information B. 45 Ministry of Human Resources B. 46 Ministry of Science, Technology and the Environment B. 47 Ministry of Transport B. 48 Ministry of Rural Development B. 49 Ministry of Energy, Communications and Multimedia B. 50 Ministry of Entrepreneur Development B. 51 Ministry of Foreign Affairs TOTAL"
      }
    }
