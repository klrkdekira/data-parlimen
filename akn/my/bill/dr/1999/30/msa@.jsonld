      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2000. Pembenaran perbelanjaan sebanyak RM18,429,403,000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menepati perenggan (a) Perkara 102 Perlembagaan Persekutuan, perbelanjaan sebanyak yang tidak melebihi lapan belas bilion empat ratus dua puluh sembilan juta empat ratus tiga ribu ringgit (RM18,429,403,000) yang akan dikeluarkan daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi bahagian tahun 2000 sebelum tarikh mula berkuat kuasanya Akta Perbekalan berkenaan dengan tahun itu adalah dengan ini dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Amaun yang dibenarkan bagi setiap perkhidmatan yang dinyatakan dalam Ruang (1) Jadual ialah yang dinyatakan dalam Ruang (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Ruang ( I) Ruang (2) Tajuk Amaun (RM) Parlimen 19,499,000 Pejabat Penyimpan Mohor Besar Raja-Raja 569,000 Jabatan Audit 20,903,000 Suruhanjaya Pilihan Raya 9,867,000 Suruhanjaya Perkhidmatan Awam 7,942,000 Suruhanjaya Perkhidmatan Pendidikan 3,407,000 Jabatan Perdana Menteri 597,865,000 Jabatan Perkhidmatan Awam 237,247,000 Jabatan Perangkaan 26,244,000 Jabatan Peguam Negara 14,774,000 Badan Pencegah Rasuah 20,877,000 Pejabat Setiausaha Persekutuan Sabah 665,000 Pejabat Setiausaha Persekutuan Sarawak 487,000 Kementerian Perumahan dan Kerajaan 51,010,000 Tempatan Jabatan Perancangan Bandar dan Desa 8,279,000 Jabatan Bomba dan Penyelamat 94,174,000 Kementerian Belia dan Sukan 50,446,000 Kementerian Perusahaan Utama 64,687,000 Kementerian Pertanian 542,191,000 Kementerian Perdagangan Antarabangsa 82,675,000 dan Industri Kementerian Perdagangan Dalam Negeri 47,521,000 dan Hal Ehwal Pengguna Kementerian Kebudayaan, Kesenian dan 101,349,000 Pelancongan Jabatan Arkib Negara 7,425,000 Jabatan Muzium dan Antikuiti 3,064,000 Kementerian Pertahanan 1,959,988,000 Kementerian Pendidikan 5,845,683,000 Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) Ruang (1) Ruang (2) Tajuk Amaun (RM) Jabatan Perpustakaan Negara 12,943,000 Perbendaharaan 215,616,000 Perkhidmatan Am Perbendaharaan 1,338,444,000 Peruntukan kepada Kumpulan Wang 1,280,896,000 Terkanun Jabatan Kastam dan Eksais Diraja 141,503,000 Jabatan Penilaian dan Perkhidmatan Harta 20,155,000 Kementerian Kerja Raya 597,768,000 Kementerian Kesihatan 2,011,581,000 Kementerian Dalam Negeri 71,982,000 Polis Diraja Malaysia 934,392,000 Jabatan Imigresen 117,953,000 Jabatan Pendaftaran Pertubuhan 3,640,000 Jabatan Pendaftaran Negara 45,448,000 Jabatan Penjara 88,358,000 Jabatan Pertahanan Awam 5,212,000 Kementerian Perpaduan Negara dan 119,613,000 Pembangunan Masyarakat Kementerian Tanah dan Pembangunan 129,998,000 Koperasi Kementerian Penerangan 318,331,000 Kementerian Sumber Manusia 68,873,000 Kementerian Sains, Teknologi dan Alam 119,704,000 Sekitar Kementerian Pengangkutan 169,867,000 Kementerian Pembangunan Luar Bandar 175,429,000 Kementerian Tenaga, Komunikasi dan 16,630,000 Multimedia Kementerian Pembangunan Usahawan 468,281,000 Kementerian Luar Negeri 137,948,000 JUMLAH 18,429,403,000"
      }
    }
  ]
