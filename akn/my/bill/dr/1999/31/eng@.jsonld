      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 96 of the principal Act is amended -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
