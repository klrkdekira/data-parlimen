        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 112 of the principal Act is amended -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the words \"section 77(1)\" the words \"or 77(lA)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: \"(2A) Where a person has been corvicted of an offence under subsection (1), the court may make a further order that the person shall comply with the relevant provision of this Act under which the offence has been committed within thirty days, or such other period as the court deems fit, from the date the order is made.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by inserting after the words \"section 77(1)\" the words \"or 77(1A)\". Amendment of section 114"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Section 114 of the principal Act is amended by inserting after subsection (1) the following subsection: \"(1A) Any person who assists in, or advises with respect to, the preparation of any return where the return results in an understatement of the liability for tax of another person shall, unless he satisfies the court that the assistance or advice was given with reasonable care, be guilty of an offence and shall, on corviction, be liable to a fine of not less than two thousand ringgit and not more than twenty thousand ringgit or to imprisonment for a term not exceeding three years or to both.\". Amendment of section 116"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_15__para_a",
