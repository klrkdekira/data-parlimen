      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 96A(1) of the principal Act is amended -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"Where\" the words \"Without prejudice to section 91, where\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
