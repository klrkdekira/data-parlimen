      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subparagraph (4)(c)(ii) the following subparagraph: \"(ii) the increase for late payment imposed by section 103(4), 103(5A), 103A(6) or 103A(7); and\". Amendment of section 96A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
