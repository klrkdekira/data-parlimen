      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the words \"after an assessment\" the words \", other than an assessment under section 90(lA),\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/eng@/~part_II__cl_6__para_b",
      "@type": "akn:paragraph",
