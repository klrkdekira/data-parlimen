      "schema:text": {
        "@language": "ms",
        "@value": "PEMULAAN Tajuk ringkas dan pemulaan kuat kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/msa@/~part_II",
