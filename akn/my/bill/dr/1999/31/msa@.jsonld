      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], yang disebut \"Akta tbu\" dalam Akta ini, dipinda dalam seksyen 77"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/31/msa@/~part_II__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
