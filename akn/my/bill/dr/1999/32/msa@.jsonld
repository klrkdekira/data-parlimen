      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Cukai Jualan (Pindaan) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Jualan (Pindaan) 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2000. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, \"tarikh yang ditetapkan\" ertinya 1 Januari"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2000. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Jualan 1972 [Akta 64], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_1__para_a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"pengilangan\" dengan takrif yang berikut: Rang Undang-Undang ' \"pengilangan\" ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan barang-barang selain petroleum, kerja mengubah jadi dengan cara manual atau jentera bahan-bahan organik atau bukan organik kepada suatu keluaran baharu dengan mengubah saiz, bentuk atau jenis bahan- bahan itu dan termasuklah kerja memasang bahagian-bahagian hingga menjadi suatu jentera atau keluaran lain, tetapi tidak termasuk kerja memasang jentera atau alat kelengkapan bagi maksud pembinaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan petroleum, menapis atau mensebatikan dan termasuklah menambahkan apa-apa bahan asing;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_3__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_3__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"pertukaran data elektronik\" takrif yang berikut: \"petroleum\" hendaklah mempunyai erti yang diberikan kepadanya di bawah seksyen 2(1) Akta Kastam 1967;'. Fenggantian seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 16 dengan seksyen yang berikut: 16. Tertakluk kepada Akta ini, cukai jualan hendaklah dilevi—— (a) atas nilai jualan mengikut kadar yang berkuat kuasa pada masa cukai jualan itu kena dibayar; atau (b) atas kuantiti barang-barang yang dijual, digunakan atau dilepaskan, atau yang diimport, mengikut kadar yang berkuat kuasa pada masa cukai jualan itu kena dibayar.\". Pindaan seksyen 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 17(1) Akta ibu dipinda dengan memasukkan selepas perkataan \"dijual\" perkataan \"dan juga kuantiti barang-barang yang dijual\". Pindaan seksyen 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 69(1) Akta ibu dipinda dengan memasukkan selepas perkataan \"pengilang berlesen\" perkataan \"atau pengimport\". Pindaan seksyen 70"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 70( 1) Akta ibu dipinda dengan memasukkan selepas perkataan \"pengilang berlesen\" di mana-mana jua terdapat perkataan \"atau pengimport\". Bahagian baru XVIII"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_8__para_c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas Bahagian XVII Bahagian yang berikut: 'BAHAGIAN XVIII PERUNTUKAN KHAS BERKENAAN DENGAN PETROLEUM 91. Tertakluk kepada seksyen 92 hingga 95, Akta ini hendaklah terpakai bagi petroleum. 92. Walau apa pun yang berlawanan yang terkandung dalam Akta ini, Menteri boleh melalui perintah, membuat mana-mana atau semua yang berikut: (a) menentukan tempoh yang berlainan bagi cukai jualan yang terhutang dan kena dibayar berkenaan dengan petroleum; (b) menentukan tempoh cukai yang berlainan berkenaan dengan petroleum; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan syarat-syarat yang hendaklah dipatuhi bagi kuat kuasa tempoh cukai jualan terhutang dan kena dibayar yang berlainan dan juga tempoh cukai yang berlainan. 93. Walau apa pun seksyen 25, mana-mana orang boleh menerima penyerahan daripada kawalan Kastam petroleum kena cukai yang diimport sama ada atau tidak mana- mana bahagian atau kesemua cukai jualan atas barang- barang itu telah dibayar. 94. Seksyen 29 tidak terpakai bagi petroleum. 95. Bagi maksud petroleum, Labuan dan Langkawi hendaklah dianggap sebagai sebahagian daripada Malaysia dan Bahagian I hingga XVIII hendaklah terpakai berkenaan dengan petroleum yang dikilang di atau diimport ke dalam atau dieksport dari atau diangkut ke atau dari Labuan atau Langkawi seolah-olah Bahagian XIV dan XVII tidak diperbuat.\". Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu hendaklah terpakai bagi petroleum—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dikilang tetapi tidak digunakan atau dipergunakan atau dipindahkan di bawah seksyen 28 Akta Eksais 1976 [Akta 176]; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diimport dan masih digudangkan di bawah seksyen 65 Akta Kastam 1967, sebaik sebelum tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu tidaklah terpakai jika, sebaik sebelum tarikh yang ditetapkan, petroleum telah dikilang dan digunakan atau dipergunakan atau dipindahkan di bawah seksyen 28 Akta Eksais 1976 tetapi duti eksais berhubung dengan petroleum belum dibayar, dan dalam keadaan sedemikian, Akta Eksais 1976 hendaklah terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/32/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang yang dilesenkan di bawah seksyen 20 Akta Eksais 1976 untuk mengilang petroleum di bawah Akta itu hendaklah pada tarikh yang ditetapkan disifatkan telah dilesenkan di bawah subseksyen 13(3) Akta ibu, dan bagi maksud ini Ketua Pengarah seperti yang ditakrifkan di bawah Akta ibu hendaklah mengeluarkan suatu lesen kepada orang itu pada tarikh yang ditetapkan."
      }
    }
  ]
}
