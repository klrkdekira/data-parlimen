      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the word \"penalty\" the words \"or surcharge\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/6/eng@/~cl_8__list_1__para_b",
      "@type": "akn:paragraph",
