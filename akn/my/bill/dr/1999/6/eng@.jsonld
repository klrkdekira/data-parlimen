      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/6/eng@/~cl_8__list_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/6/eng@/~cl_8__list_4__para_a__subpara_ii"
