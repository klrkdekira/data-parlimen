      ],
      "schema:name": {
        "@language": "en",
        "@value": "Valuers, Appraisers and Estate Agents (Amendment) Bill 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Valuers, Appraisers and Estate Agents (Amendment) Act 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Valuers, Appraisers and Estate Agents Act 1981[Act 242], which in this Act is referred to as the \"principal Act\", is amended in section 4—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (b) the following paragraph: \"(b) to collect and collate— (i) such information as the Director General thinks necessary to assist officers and valuers in the making of valuation; and ( i i) such information as the Director General thinks necessary on all or any property-related matters;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"and\" at the end of paragraph (ba); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (ba) the following paragraphs: \"(bb) to provide information and advice to the Government and any State Government or any person on property-related matters; (bc) to provide education services, training services, research services and other services that are related to the functions of the Director General under this Act to the Government and any State Government or any person; and\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: \"(3) With regard to paragraphs (b) and (bb) of subsection ( 1 ), the Director General may, except where such information has been classified as confidential by or on behalf of the Government or any State Government, in his discretion supply any person or class of persons with any information collected or collated by him upon payment of such fees or charges as may be prescribed by the Minister.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(3A) The information that may be supplied under subsection (3) may include— (a) the details of any sale or transfer of land, buildings and any interest therein; (b) information on the status of supply and demand of property; (c) information on the availability of financing for the purchasing or development of property; (Amendment) (d) information on movements in the price and rental of property; (e) information on property development (including development costs), property investment and property management in all or any of the sectors of the property market; and (f) information necessary for the development of property market indices and cost indices.\". Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 5 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words \"any work undertaken by him in accordance with\" the words \"carrying out the Director General's functions under\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the word \"work\" the words \"functions under this Act\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by substituting for the words \"such work\" the words \"carrying out his functions under this Act\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the word \"work\" the words \"functions under this Act\". Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words \"his work\" the words \"the carrying out of his functions under this Act\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) The information required under subsection (1) shall include— (a) details of sales, purchases, results of auctions and tenders, lettings and leases; and (b) such other information as the Director General thinks necessary for the carrying out of his functions under this Act.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"such form\" the words \"the required information\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/7/eng@/~cl_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"he\" the words \"that person\"."
      }
    }
  ]
}
