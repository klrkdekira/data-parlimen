      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Eksais (Pindaan) 1999"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 90 Akta ibu dipinda dengan menggantikan perkataan \"28(c)\" dengan perkataan \"28(d)\". Pindaan seksyen 91D"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 91 D Akta ibu dipinda dengan menggantikan perkataan \"28(c)\" dengan perkataan \"28(d)\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Eksais (Pindaan) 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Eksais 1916[Akta 176], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam subseksyen 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"penduduk\" takrif yang berikut: ' \"pengangkut berlesen\" mempunyai erti yang diberikan oleh seksyen 2(1) Akta Kastam 1967;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"petroliam\" dengan takrif yang berikut: ' \"petroleum\" mempunyai erti yang diberikan oleh seksyen 2(1) Akta Kastam 1967;'. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dalam teks bahasa kebangsaan dengan menggantikan perkataan \"petroliam\" di mana-mana jua terdapat dengan perkataan \"petroleum\". Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan memasukkan selepas perkataan \"Kad-kad kuasa\" perkataan \", dll.,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"apa-apa dokumen mempastikan identitinya sebagaimana yang diarahkan oleh Ketua Pengarah, atau mengenai seseorang pegawai polis, oleh Ketua Polis Negara, supaya dibawa oleh pegawai itu\" dengan perkataan \"sesuatu lencana atau kad kuasa yang dia telah diarahkan supaya membawanya di bawah seksyen 9(1) Akta Kastam 1967\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"dokumen pengenalannya\" dengan perkataan \"lencana atau kad kuasanya\". Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 15(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"membayar duti eksais atau lain-lain wang itu\" dengan perkataan \"membayar duti eksais atau wang lain itu, atau duti eksais atau wang lain yang terkurang dibayar itu,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"kekurangan itu\" dengan perkataan \"duti eksais atau wang lain itu, atau duti eksais atau wang lain yang terkurang dibayar itu,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"duti eksais itu kena dibayar atau dari tarikh duti eksais itu telah terkurangbayar\" dengan perkataan \"duti eksais atau wang lain itu kena dibayar, atau duti eksais atau wang lain yang kurang itu telah dibayar\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"wang-wang yang tersebut\" dengan perkataan \"duti eksais atau wang lain\". Seksyen baru 1 5A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 15 seksyen yang berikut: 15A. (1) Jika Ketua Pengarah mempunyai sebab untuk mempercayai bahawa mana-mana orang hendak atau berkemungkinan meninggalkan Malaysia tanpa membayar apa-apa duti eksais yang kena dibayar olehnya, dia boleh mengeluarkan kepada mana-mana Pengarah Imigresen suatu perakuan yang mengandungi butir-butir mengenai duti eksais yang kena dibayar sedemikian dengan suatu permintaan supaya orang itu dihalang daripada meninggalkan Malaysia melainkan jika dan sehingga dia membayar duti eksais yang kena dibayar sedemikian, atau memberikan cagaran yang memuaskan hati Ketua Pengarah bagi pembayarannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa perintah yang dikeluarkan atau dibuat di bawah mana-mana undang-undang bertulis yang sedang berkuat kuasa berhubung dengan buang negeri atau imigresen, mana-mana Pengarah Imigresen yang menerima suatu permintaan di bawah subseksyen (1) berkenaan dengan seseorang hendaklah menjalankan segala langkah yang boleh termasuk pengambilan dan penyimpanan apa-apa perakuan pengenalan, pasport, permit keluar atau dokumen perjalanan lain yang berhubungan dengan orang itu sebagaimana yang perlu untuk melaksanakan permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah menyebabkan notis mengenai pengeluaran sesuatu perakuan di bawah subseksyen (1) disampaikan ke diri atau melalui pos berdaftar kepada orang yang kepadanya perakuan ini berkaitan: Dengan syarat bahawa ketidakterimaan notis itu oleh orang itu tidak boleh mentaksahkan apa-apa yang dibuat di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang berkenaan dengannya suatu perakuan telah dikeluarkan di bawah subseksyen (1) mengemukakan pada atau selepas tarikh perakuan itu suatu pernyataan bertulis yang ditandatangani oleh Ketua Pengarah yang menyatakan bahawa semua duti eksais yang dinyatakan dalam perakuan itu telah dibayar, atau bahawa cagaran telah diberikan bagi pembayarannya, pernyataan itu hendaklah menjadi kuasa yang cukup bagi membenarkan orang itu meninggalkan Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa prosiding undang-undang boleh dimulakan atau disenggarakan terhadap Kerajaan, sesuatu Kerajaan Negeri atau mana-mana pegawai awam lain berkenaan dengan apa-apa jua yang dibuat dengan sah di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, \"Pengarah Imigresen\" ertinya mana-mana Pengarah Imigresen yang dilantik di bawah subseksyen 3 ( 1 A) Akta Imigresen 1959-1963.\". Pindaan seksyen 23A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan \"berkenaan dengan syarikat itu\" perkataan \", dan hendaklah membayar duti eksais itu\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Mana-mana penyelesai syarikat yang tidak mematuhi subseksyen (1) adalah bersalah atas suatu kesalahan terhadap Akta ini dan boleh, apabila disabitkan, dikenakan denda tidak lebih daripada sepuluh ribu ringgit.\". Pindaan seksyen 23B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23B Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan \"sebelum perlantikan penerima itu\" perkataan \", dan hendaklah membayar duti eksais itu\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Mana-mana penerima yang tidak mematuhi subseksyen (1) adalah bersalah atas suatu kesalahan terhadap Akta ini dan boleh, apabila disabitkan, dikenakan denda tidak lebih daripada sepuluh ribu ringgit.\". Penggantian seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 42 dengan seksyen yang berikut: 42. (1) Tiap-tiap notis atau dokumen lain yang dikehendaki oleh Akta ini supaya disampaikan kepada mana-mana orang boleh disampaikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "ke diri orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantarnya kepada orang itu melalui pos berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu notis atau dokumen lain yang dihantar melalui pos berdaftar kepada seseorang hendaklah disifatkan telah disampaikan kepada orang itu pada masa ia sepatutnya telah diserahkan kepadanya dalam perjalanan biasa pos itu jika notis atau dokumen lain itu telah dialamatkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat, firma atau persatuan orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke pejabat berdaftarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke alamatnya yang terakhir diketahui; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang yang diberi kuasa olehnya untuk menerima penyampaian proses; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/1999/8/msa@/~cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang perseorangan, ke alamatnya yang terakhir diketahui.\". Pindaan seksyen 90"
      }
    }
  ]
}
