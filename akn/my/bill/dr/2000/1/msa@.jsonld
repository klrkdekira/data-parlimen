      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2000. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/1/msa@/~cl_2",
      "@type": "akn:clause",
