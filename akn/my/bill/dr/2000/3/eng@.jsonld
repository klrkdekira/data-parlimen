      ],
      "schema:name": {
        "@language": "en",
        "@value": "Public Service Tribunal (Dissolution) Bill 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Dissolution) Act 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be deemed to have come into operation on I January 2000. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires-"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"appointed date\" means the date specified in subsection 1(2); \"Tribunal\" means the Public Service Tribunal established under section 3 of the Public Service Tribunal Act 1977 [Act 186]. Repeal and dissolution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Service Tribunal Act 1977 is repealed and the Tribunal established under that Act is dissolved. Transfer of powers, rights, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_4__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All powers, rights, privileges, duties, liabilities and obligations which immediately before the appointed date were those of the Tribunal shall, as from that date, devolve on the Government. Prevention of difficulties or anomalies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_5__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "If any difficulty or anomaly arises in connection with the implementation of the provisions of this Act, the Minister may by order make such modifications to any provision of this Act as may appear to him to be necessary for removing or preventing such difficulty or anomaly: Provided that the Minister shall not exercise the powers conferred by this section after the expiration of three years from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/3/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"modifications\" includes amendments, additions, deletions, substitutions, adaptations, variations, alterations and non-application of any provision of this Act."
      }
    }
  ]
}
