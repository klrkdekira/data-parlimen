      "schema:text": {
        "@language": "en",
        "@value": "This· Act may be cited as the Environmental Quality (Amendment) Act 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on the date of its publication in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Environmental Quality Act 1974 [Act 127] is amended in section 2 by inserting after the definition of \"inland waters\" the following definition: , \"local authority\" includes any person or body of persons appointed under any written law to exercise and perform the powers and duties which are conferred and imposed on a local authority under any written law;'."
      }
