      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kualiti Alam Sekeliling (Pindaan) 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/6/msa@/~cl_1__subsec_2",
