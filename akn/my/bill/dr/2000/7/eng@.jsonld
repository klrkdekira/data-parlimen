      "schema:text": {
        "@language": "en",
        "@value": "The Employment Act 1955 [Act 265], which in this Act is f' [.; referred to as the \"principal Act\", is amended in subsection 31 (1)- I; ~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_2__para_a",
