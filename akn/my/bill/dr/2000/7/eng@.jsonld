    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 60A(4) of the principal Act is amended in the first proviso to paragraph (a) by deleting the word \"ten\". Amendment of section 60D"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 60D of the principal Act is amended-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: \"( 1) Every employee shall be entitled to a paid holiday at his ordinary rate of pay on the following days in anyone calendar year: (a) on ten of the gazetted public holidays, four of which shall be- (i) the National Day; (ii) the Birthday of the Yang di-Pertuan Agong; (iii) the Birthday of the Ruler or the Yang di-Pertua Negeri, as the case may be, of the State in which the employee wholly or mainly works under his contract of service, or the Federal Territory Day, if the employee wholly or mainly works in the Federal Territory; and (iv) the Workers' Day; and (b) on any day declared as a public holiday under Act 369. section 8 of the Holidays Act 1951: Provided that if any of the public holidays referred to in paragraphs (a) and (b) falls on a rest day the working day following immediately the rest day shall be a paid holiday in substitution ofthat public holiday.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (lA)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"remaining six gazetted public holidays\" the words \"provided for in subsection (l)(a)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_ii",
