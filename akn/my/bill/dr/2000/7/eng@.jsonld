      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"(hereinafter referred to as !: \"the secured creditor\")\" the words \"or in the exercise of ~. rights under a debenture\"; t ~ ~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_2__para_b",
