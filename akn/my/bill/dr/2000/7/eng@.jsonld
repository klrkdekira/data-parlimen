      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"paid holidays\" the words \"under subsection (l)(a)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"said remaining six gazetted public holidays\" in the proviso the words \"remaining six gazetted public holidays provided for in subsection (l)(a)\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting the full stop at the end of the existing proviso with a colon and by inserting after the proviso the following proviso: \"And provided further that the employer may grant the employee any other day as a paid public holiday in substitution for any of the public holidays referred to in subsection (l)(b).\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (l B) by deleting the words \"said ten gazetted\". Amendment of section 601"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_6",
      "@type": "akn:clause",
