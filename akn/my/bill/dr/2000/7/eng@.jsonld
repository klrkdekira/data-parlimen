      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"attached or garnished, the t court\" the words \"or the receiver or manager\"; and ~ ~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_2__para_c",
