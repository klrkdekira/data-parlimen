      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"The Director General may\" the words \", by notification in the Gazette or by notice in writing\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@/~cl_7__para_c",
