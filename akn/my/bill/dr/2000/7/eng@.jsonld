      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 601 of the principal Act is amended by inserting after subsection (2) the following subsection: \"(3) For the purpose of this section, the Director General may, on application made to him in writing by an employer, approve in writing any incentive payment scheme as an approved incentive payment scheme.\". Amendment of section 63"
      }
    },
