      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kerja (Pindaan) 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kerja (Pindaan) 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kerja 1955 [Akta 265], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam subseksyen 31 (1)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"(hereinafter referred to as \"the secured creditor\")\" perkataan \"or in the exercise of rights under a debenture\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"attached or garnished, the court\" perkataan \"or the receiver or manager\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"the secured creditor until the court\" dengan perkataan \"the secured creditor or the debenture holder until the court or the receiver or manager\". Pindaan seksyen 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 32(1) Akta ibu dipinda dengan memasukkan selepas perkataan \"the court\" di mana-mana jua terdapat perkataan \"or the receiver or manager\". Pindaan seksyen 60A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 60A(4) Akta ibu dipinda dalam proviso pertama kepada perenggan (a) dengan memotong perkataan \"ten\". Pindaan seksyen 60D"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 60D Akta ibu dipinda-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Every employee shall be entitled to a paid holiday at his ordinary rate of pay on the following days in anyone calendar year: (a) on ten of the gazetted public holidays, four of which shall be- (i) the National Day; (ii) the Birthday of the Yang di-Pertuan Agong; (iii) the Birthday of the Ruler or the Yang di-Pertua Negeri, as the case may be, of the State in which the employee wholly or mainly works under his contract of service, or the Federal Territory Day, if the employee wholly or mainly works in the Federal Territory; and (iv) the Workers' Day; and (b) on any day declared as a public holiday under Act 369. section 8 of the Holidays Act 1951: Provided that if any of the public holidays referred to in paragraphs (a) and (b) falls on a rest day the working day following immediately the rest day shall be a paid holiday in substitution of that public holiday.\"; Kerja (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1A)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"remaining six gazetted public holidays\" perkataan \"provided for in subsection (1)(a)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"paid holidays\" perkataan \"under subsection (1)(a)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"said remaining six gazetted public holidays\" dalam proviso dengan perkataan \"remaining six gazetted public holidays provided for in subsection (1)(a)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung proviso sedia ada dengan noktah bertindih dan memasukkan selepas proviso itu proviso yang berikut: \"And provided further that the employer may grant the employee any other day as a paid public holiday in substitution for any of the public holidays referred to in subsection (1)(b).\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (la) dengan memotong perkataan \"said ten gazetted\". Pindaan seksyen 601"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 601 Akta ibu dipinda dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(3) For the purpose of this section, the Director General may, on application made to him in writing by an employer, approve in writing any incentive payment scheme as an approved incentive payment scheme.\". Pindaan seksyen 63"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 63 Akta ibu dipinda-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula peruntukan sedia ada seksyen itu sebagai subseksyen (1) seksyen 63;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"The Director General may\" perkataan \", by notification in the Gazette or by notice in writing\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (l) subseksyen yang berikut: \"(2) Notwithstanding the provisions of this Act, the powers of the Director General under subsection (1) extends to every employee employed under a contract of service irrespective of the monthly wages of the employee.\" . Pindaan seksyen 69c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 69c Akta ibu dipinda"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (l)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"due to the employer by the employee\" dengan perkataan \"due to the employer or employee\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"terminated by the employee\" dengan perkataan \"terminated by either party\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"the employer\" perkataan \"or employee\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/7/msa@/~cl_8__para_b__subpara_ii",
