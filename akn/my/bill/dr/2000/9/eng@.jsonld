      "schema:name": {
        "@language": "en",
        "@value": "Industrial Designs (Amendment) Bill 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Amendment) Act 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Industrial Designs Act 1996 [Act 552], which in this Act is referred to as the \"principal Act\", is amended in subsection 3( 1) in the definition of \"article\"-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word \"separately\" the words \"but does not include an integrated circuit or part of an integrated circuit within the meaning of the Layout-Designs of Integrated Circuits Act 2000, or a mask used to make such an integrated circuit\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting the marginal reference \"Act...\" against the words \"Layout-Designs of Integrated Circuits Act 2000\". New section 13A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 13 the following section: \"Certain 13A. Notwithstanding any other provision of this Act, regis where before the commencement of the Layout-Designs trations of Integrated Circuits Act 2000 an industrial design not to be extended applicable to an integrated circuit or part of an integrated or circuit within the meaning of that Act or an industrial restored. design applicable to a mask used to make such an integrated circuit was registered under this Act, registration shall not be extended or restored at any time on or after that commencement.\"."
      }
    }
  ]
