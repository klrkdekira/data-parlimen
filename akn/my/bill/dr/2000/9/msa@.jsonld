      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Reka Bentuk Perindustrian (Pindaan) 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Reka Bentuk Perindustrian (Pindaan) 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Reka Bentuk Perindustrian 1996 [Akta 552], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam subseksyen 3(1) dalam takrif \"barang\"-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"berasingan\" perkataan \"tetapi tidak termasuk suatu litar bersepadu atau suatu bahagian suatu btar bersepadu mengikut pengertian Akta Reka Bentuk Susun Atur Litar Bersepadu 2000, atau suatu pencontoh yang digunakan untuk membuat litar bersepadu sedemikian\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan rujukan birai \"Akta...\" bertentangan dengan perkataan \"Akta Reka Bentuk Susun Atur Litar Bersepadu 2000\". ' Seksyen barn 13A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2000/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 13 seksyen yang berikut: \"Pendaftaran 13A. Walau apa pun mana-mana peruntukan lain Akta ~~~~ntu ini, jika sebelum Akta Reka Bentuk Susun Atur Litar boleh Bersepadu 2000 mula berkuat kuasa suatu reka bentuk dilanjutkan perindustrian yang terpakai bagi sesuatu litar bersepadu ~~:asuk- atau suatu bahagian sesuatu litar bersepadu mengikut kan pengt;rtian Akta itu atau suatu reka bentuk perindustrian semula. yang terpakai bagi sesuatu pencontoh yang digunakan untuk membuat litar bersepadu sedemikian telah didaftarkan di bawah Akta ini, pendaftaran itu tidak boleh dilanjutkan atau dimasukkan semula pada bila-bila masa pada atau selepas permulaan kuat kuasa itu.\"."
      }
    }
  ]
}
