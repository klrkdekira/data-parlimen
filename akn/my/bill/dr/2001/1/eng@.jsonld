      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Gas Supply (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of this Act in different parts of Malaysia. Amendment of long title"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Gas Supply Act 1993 [Act 501], which in this Act is referred to as the \"principal Act\", is amended in the long title by deleting the words \"the appointment and functions of a Director General of Gas Supply, \". Amendment of section 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections 30(2) and (8) of the principal Act are amended by substituting for the words \"Director General\" wherever appearing the word \"Cbmmission\". Amendment of section 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 34 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) The Chairman may, with the consent in writing of the Public Prosecutor, compound any offence prescribed under subsection (1) by collecting from the person reasonably suspected of having committed the offence a sum of money not exceeding fifty per cent of the amount of the maximum fine for that offence.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: \"(3) All sums of moneys received by the Commission under this section shall be paid into and form part of the Consolidated Fund.\". Amendment of section 36"
      }
