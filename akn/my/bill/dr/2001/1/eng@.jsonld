    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the commencement of this Act, references to the Director General of Gas Supply, a Director of Gas Supply or an authorised officer in any written law, including any subsidiary legislation, or in any document, registration, approval, certificate, directive, order, guideline, notification or other document made, issued or given before the commencement of this Act shall be construed as provided for in subsections (2), (3), (4) and (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "References to the Director General of Gas Supply or a Director of Gas Supply in relation to the functions of such Director General or Director which upon the commencement of this Act become the functions of the Commission shall be construed as references to the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "References to the Director General of Gas Supply or a Director of Gas Supply in relation to the functions of such Director General or Director which upon the commencement of this Act become the functions of the Chairman shall be construed as references to the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "References to a Director of Gas Supply in relation to the functions of such Director which upon the commencement of this Act become the functions of an authorised officer shall be construed as references to the authorised officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "References to an authorised officer shall be construed as references to an authorised officer as defined in the principal Act as amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Every licence, registration, approval, certificate, directive, order, guideline, notification and other document made, issued or given by the Director General of Gas Supply or a Director of Gas Supply before the commencement of this Act shall be construed as having been made, issued or given by the Commission, the Chairman or an authorised officer, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for paragraph l(3)(b) the following paragraph: \"(b) from the filling connection of a storage tank or cylinder specifically used for reticulation or delivery of gas to any apparatus in any premises.\". Amendment of section 2"
      }
    },
