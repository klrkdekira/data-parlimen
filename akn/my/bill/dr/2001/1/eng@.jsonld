      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 17 the following section: Return of I7A. Notwithstanding any other provisions in this Act, security a licensee shall pay to a person subject to such conditions with interest. and at such rates as may be prescribed, a sum equivalent to the annual interest on the security given under section 17.\". Amendment of section 18"
      }
    },
