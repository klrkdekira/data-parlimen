      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan menggantikan perkataan \"di bawah tandatangan\" dengan perkataan \"di bawah meterai\". Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_11",
