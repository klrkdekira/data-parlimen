      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Pengarah\" dengan perkataan \"Suruhanjaya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
