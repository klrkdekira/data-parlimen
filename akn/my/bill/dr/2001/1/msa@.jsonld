        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_c__subpara_i",
