      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), (3), (6) dan (7), dengan menggantikan perkataan \"Ketua Pengarah\" di mana-mana jua terdapat dengan perkataan \"Suruhanjaya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
