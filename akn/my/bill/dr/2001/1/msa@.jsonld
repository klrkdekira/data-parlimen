      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 21 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"seorang Pengarah\" dengan perkataan \"Suruhanjaya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Pengarah itu hendaklah dengan segera terus\" dengan perkataan \"Suruhanjaya hendaklah dengan segera mengarahkan seorang pegawai diberi kuasa\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"dan hendaklah, dalam masa dua puluh empat jam selepas pemeriksaan itu, membentuk pendapat\" dengan perkataan \"dan secepat yang mungkin selepas pemeriksaan itu, Suruhanjaya hendaklah membentuk pendapat\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/1/msa@/~cl_18__para_c",
      "@type": "akn:paragraph",
