      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"society\" yang kedua terdapat perkataan \", association\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/10/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
