      ],
      "schema:name": {
        "@language": "en",
        "@value": "Sales Tax (Amendment) Bill 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Sales Tax (Amendment) Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "2001. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 48 the following section: \"Proportional examination of goods seized to be accepted by courts 48. (1) When any goods suspected of being taxable goods or otherwise liable to seizure have been seized, it shall be sufficient to open and examine five per centum only of each description of the package or receptacle in which such goods are contained. (2) If it is necessary to test any goods seized under this Act, it shall be sufficient to test only a sample not exceeding five per centum in volume or weight of the goods examined under subsection ( I ). (3) The court shall presume that the goods contained in the unopened packages or receptacles are of the same nature, quantity and quality as those found in the similar packages or receptacles which have been opened.\". New section 5lA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 51 the following section: \"Obligation of secrecy 51A. (1) Except as provided under section 52, the name and address of an informer and the substance of the information received from an informer shall be kept secret and shall not be disclosed by any proper officer or any person who in the ordinary course of his duties comes into possession of or has control of or access to such information to any person except the designated officer of sales tax authorized by the Director General. (2) Any person who fails to comply with subsection (1) shall be guilty of an offence against this Act and shall be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both.\". Amendment of section 62"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 62(2)(a) of the principal Act is amended by substituting for the words \"firm or association of persons\" the words \"a firm, a society, an association or other body of persons\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Sales Tax Act 1972 [Act 64], which in this Act is referred to as the \"principal Act\", is amended in section 2 in the definition of \"person\" by substituting for the words \"an association of persons\" the words \"a society, an association\". Amendment of section 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 23(3) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"Limitation Act 1953,\" the words \"the Limitation Ordinance of Sabah [Sabah Cap. 72] or the Limitation Ordinance of Sarawak [Swk. Cap. 49], as the case may be,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"section 6(4) of the Limitation Act 1953\" the words \", section 3 of the Limitation Ordinance of Sabah or section 3 of the Limitation Ordinance of Sarawak, as the case may require,\". Amendment of section 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 26 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (c) the following paragraph: \"(c) a society, an association or other body of persons,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"association of persons\" second appearing the words \"society, association or other body of persons\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"association\" third appearing the words \"society association or other body of persons\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"the person, company, firm or association of persons liable to pay the sales tax, penalty or surcharge\" the words \"such company, firm, society, association or other body of persons\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of the section a colon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting below the existing provisions the following proviso: \"Provided that in relation to a company that is being wound up, the directors of such company shall only be so liable where the assets of the company are insufficient to meet the amount due, after paying any sums having priority under the Companies Act 1965 in relation to the application of the assets of the company in such winding up over the sales tax, penalty or surcharge.\". Amendment of section 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 36 of the principal Act is amended by deleting subsections"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(2A) and (2B). New section 39A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 39 the"
      },
      "schema:text": {
        "@language": "en",
        "@value": "following section: \"Access to recorded information or computerized data 39A. (1) Any senior officer of sales tax exercising his powers under sections 36, 37, 38 and 39 shall be given access to any recorded information or computerized data, whether stored in a computer or otherwise. (2) In addition, an officer of sales tax exercising his powers under sections 36, 37, 38 and 39— (a) may inspect and check the operation of any computer and any associated apparatus or material which he has reasonable cause to suspect is or has been used in connection with that information or data; and (b) may require— ( i) the person by whom or on whose behalf the officer of sales tax has reasonable cause to suspect the computer is or has been so used; or (ii) the person having charge of, or is otherwise concerned with, the operation of the computer, apparatus or material, to provide him with such reasonable assistance as he may require for the purposes of this section. (3) For the purposes of subsection (1), \"access\" includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of recorded information or computerized data.\". Amendment of section 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c) of the proviso to subsection (1), by inserting after the words \"another female\" the words \"with strict regard to decency\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsections: \"(5) Every person so arrested may be released from custody— (a) on his depositing such reasonable sum of money as the proper officer may require; (b) on his executing a bond with such surety or sureties, as the proper officer may require; or (c) on his depositing such reasonable sum of money as the proper officer may require and his executing a bond, with such surety or sureties, as the proper officer may require. (6) Any person who has been released from custody under subsection (5) may be arrested without warrant by any officer of sales tax— (a) if such officer has reasonable grounds for believing that any condition on or subject to which such person was released or otherwise admitted to bail has been or is likely to be breached; or (b) on being notified in writing by the surety of such person that such person is likely to breach any condition on or subject to which such person was released and that the surety wishes to be relieved of his obligation as surety.\". Amendment of section 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 45(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"firm, society or other body of persons\" first appearing the words \"a firm, a society, an association or other body of persons\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"society or other body of persons\" second appearing the words \"society, association or other body of persons\". Deletion of section 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 46. Substitution of section 48"
      }
    }
  ]
}
