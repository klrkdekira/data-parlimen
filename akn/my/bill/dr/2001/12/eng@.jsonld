      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
