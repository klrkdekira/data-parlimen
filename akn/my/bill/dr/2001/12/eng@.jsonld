      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"issued an invoice\" the words \"or a receipt\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words \"computer invoice\" the words \"invoices or receipts produced by computer\". Amendment of section 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_4",
