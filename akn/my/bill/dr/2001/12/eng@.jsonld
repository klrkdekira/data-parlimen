      "schema:text": {
        "@language": "en",
        "@value": "by inserting the marginal references \"Sabah Cap. 72.\" and \"Swk. Cap. 49.\" against the words \"Limitation Ordinance of Sabah\" and \"Limitation Ordinance of Sarawak\" respectively; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
