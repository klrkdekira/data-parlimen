      "schema:name": {
        "@language": "en",
        "@value": "Section 10A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3__para_a",
