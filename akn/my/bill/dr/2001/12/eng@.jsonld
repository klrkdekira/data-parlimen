      "schema:text": {
        "@language": "en",
        "@value": "in the marginal note, by inserting after the word \"invoices\" the words \"or receipts\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3__para_b",
