      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"in relation to an invoice\" the words \"or a receipt\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/eng@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
