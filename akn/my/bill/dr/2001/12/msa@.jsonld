      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Cukai Perkhidmatan (Pindaan) 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Perkhidmatan (Pindaan) 2001. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 36. Seksyen baru 37A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 37 seksyen yang berikut: \" Kewajipan 37A. (1) Kecuali sebagaimana yang diperuntukkan di kerahsiaan. bawah seksyen 38, nama dan alamat seseorang informer dan kandungan maklumat yang diterima daripada seseorang informer hendaklah dirahsiakan dan tidak boleh dizahirkan oleh mana-mana pegawai yang berpatutan atau mana- mana orang yang dalam perjalanan biasa tugasnya memperoleh atau mengawal atau mendapat akses kepada maklumat itu kepada mana-mana orang kecuali pegawai yang berpatutan ditetapkan yang diberi kuasa oleh Ketua Pengarah. (2) Mana-mana orang yang melanggar subseksyen (1) adalah bersalah atas suatu kesalahan terhadap Akta ini dan boleh apabila disabitkan didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya.\". Pindaan seksyen 41"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 41(cc) Akta ibu dipinda dengan memasukkan selepas perkataan \"invois\" perkataan \"atau resit\". Pindaan seksyen 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 46(2)(a) Akta ibu dipinda dengan menggantikan perkataan \"firma atau persatuan orang\" dengan perkataan \"suatu firma, suatu pertubuhan, suatu persatuan atau kumpulan orang yang lain\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Perkhidmatan 1975 [Akta 151], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1) seksyen itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"orang\", dengan menggantikan perkataan \"persatuan orang-orang\" dengan perkataan \"pertubuhan, sesuatu persatuan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"perkhidmatan yang kena dibayar cukai yang dieksportkan\" dengan takrif yang berikut: \"perkhidmatan yang kena dibayar cukai yang dieksportkan\"—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan penyediaan polisi insurans untuk melindungi pengangkutan antarabangsa barang-barang, ertinya jika polisi insurans itu disediakan untuk melindungi risiko yang berhubungan dengan pengangkutan barang-barang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dari sesuatu tempat di luar Malaysia ke sesuatu tempat di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dari sesuatu tempat di dalam Malaysia ke sesuatu tempat di luar Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dari sesuatu tempat di luar Malaysia ke sesuatu tempat di dalam Malaysia, dan termasuklah penyediaan polisi insurans untuk melindungi risiko yang berhubungan dengan pengangkutan barang-barang di dalam Malaysia yang merupakan sebahagian daripada pengangkutan yang disebut dalam subperenggan (ii) dan (iii) yang perlindungan itu disediakan oleh orang yang sama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan penyediaan polisi insurans kredit eksport kepada pengeksport tempatan, bank dan pelabur, ertinya jika polisi insurans kredit eksport itu disediakan untuk melindungi risiko di luar Malaysia yang berhubungan dengan pengeksportan barang-barang, perkhidmatan dan pelaburan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal lain, ertinya apa- apa perkhidmatan yang kena dibayar cukai yang dibekalkan untuk dan kepada seseorang di sesuatu negara selain Malaysia, dengan syarat bahawa perkhidmatan itu tidak dibekalkan berkaitan dengan barang atau tanah yang terletak di Malaysia dan orang itu tidak berada di Malaysia semasa perkhidmatan dilaksanakan;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_3__para_c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_2__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(2) Bagi mengelakkan apa-apa keraguan adalah ditetapkan bahawa walau apa pun subseksyen 1(1) dan 1(1A) dan tanpa menjejaskan seksyen 2A, bagi maksud takrif ungkapan \"perkhidmatan yang kena dibayar cukai yang dieksportkan\" Labuan, Langkawi, Kawasan Pembangunan Bersama dan zon bebas hendaklah disifatkan sebagai tempat di luar Malaysia.\". Pindaan seksyen 10A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 1 0A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan memasukkan selepas perkataan \"invois\" perkataan \"atau resit\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"berhubung dengan invois\" perkataan \"atau resit\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"mengeluarkan suatu invois\" perkataan \"atau resit\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"invois berkomputer\" dengan perkataan \"invois atau resit yang dikeluarkan dengan menggunakan komputer\". Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
