        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 15(3) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"Akta Had Masa 1953,\" perkataan \"Ordinan Had Masa Sabah atau Ordinan Had Masa Sarawak, mengikut mana-mana yang berkenaan,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan rujukan birai \"Sabah Bab 72.\" dan \"Swk. Bab 49\" masing-masing bersetentangan dengan perkataan \"Ordinan Had Masa Sabah\" dan \"Ordinan Had Masa Sarawak\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"seksyen 6(4) Akta Had Masa 1953\" perkataan \", seksyen 3 Ordinan Had Masa Sabah atau seksyen 3 Ordinan Had Masa Sarawak, mengikut mana-mana yang berkenaan,\". Pindaan seksyen 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (c) dengan perenggan yang berikut: \"(c) suatu pertubuhan, suatu persatuan atau kumpulan orang yang lain,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"persatuan orang-orang\" yang kedua terdapat dengan perkataan \"pertubuhan, persatuan atau kumpulan orang yang lain\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"orang, syarikat, firma atau persatuan orang-orang yang kena membayar cukai perkhidmatan, penalti atau surcaj\" dengan perkataan \"syarikat, firma, pertubuhan, persatuan atau kumpulan orang yang lain\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung seksyen itu dengan titik bertindih; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan di bawah peruntukan yang sedia ada proviso yang berikut: \"Dengan syarat bahawa berhubung dengan sesuatu syarikat yang sedang digulungkan, pengarah syarikat itu hanya bertanggungan sedemikian jika aset syarikat itu tidak mencukupi untuk menjelaskan amaun yang kena dibayar, selepas membayar apa-apa jumlah yang mempunyai keutamaan di bawah Akta Syarikat 1965 berhubung dengan penggunaan aset syarikat itu dalam penggulungan itu, berbanding cukai perkhidmatan atau penalti itu.\". Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 24 Akta ibu dipinda dengan memotong subseksyen (3) dan (4). Seksyen baru 26A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 26 seksyen yang berikut: \" Akses 26A. (1) Mana-mana pegawai yang berpatutan yang kepada menjalankan kuasanya di bawah seksyen 24, 25 dan 26 maklumat berekod hendaklah diberi akses kepada apa-apa maklumat berekod atau data atau data berkomputer, sama ada disimpan dalam komputer berkomputer. atau selainnya. (2) Sebagai tambahan, seseorang pegawai yang berpatutan yang menjalankan kuasanya di bawah seksyen 24, 25 dan 26— (a) boleh memeriksa dan meneliti pengendalian mana-mana komputer dan apa-apa perkakas atau bahan yang berkaitan yang dia mempunyai sebab yang munasabah untuk mengesyaki digunakan atau telah digunakan berkaitan dengan maklumat atau data itu; dan (b) boleh menghendaki— (i) orang yang pegawai yang berpatutan itu mempunyai sebab yang munasabah untuk mengesyaki menggunakan atau telah menggunakan komputer itu atau yang bagi pihaknya komputer itu digunakan atau telah digunakan sedemikian; atau (ii) orang yang menjaga, atau selainnya terlibat dalam, pengendalian komputer, perkakas atau bahan itu, supaya memberinya bantuan yang munasabah sebagaimana yang dikehendaki olehnya bagi maksud seksyen ini. (3) Bagi maksud subseksyen (1), \"akses\" termasuklah diberi kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang diperlukan untuk membolehkan maklumat berekod atau data berkomputer itu difahami.\". Pindaan seksyen 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 28 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c) proviso kepada subseksyen (1), dengan memasukkan selepas perkataan \"seseorang perempuan lain\" perkataan \"dengan betul-betul mengambil kira kehendak kesopanan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: \"(4) Tiap-tiap orang yang ditangkap sedemikian boleh dilepaskan daripada jagaan— (a) apabila dia mendepositkan apa-apa jumlah wang yang munasabah sebagaimana yang dikehendaki oleh seorang pegawai yang berpatutan; Cukai Perkhidmatan (Pindaan) 7 (b) apabila dia menyempurnakan suatu bon, dengan suatu penjamin atau penjamin-penjamin, sebagaimana yang dikehendaki oleh seorang pegawai yang berpatutan; atau (c) apabila dia mendepositkan apa-apa jumlah wang yang munasabah sebagaimana yang dikehendaki oleh seorang pegawai yang berpatutan dan dia menyempurnakan suatu bon, dengan suatu penjamin atau penjamin-penjamin, sebagaimana yang dikehendaki oleh seorang pegawai yang berpatutan. (5) Mana-mana orang yang telah dilepaskan daripada jagaan di bawah subseksyen (4) boleh ditangkap tanpa waran oleh mana-mana pegawai yang berpatutan— (a) jika pegawai itu mempunyai alasan yang munasabah untuk mempercayai bahawa mana- mana syarat yang berdasarkannya atau yang tertakluk kepadanya orang itu telah dilepaskan atau selainnya dibenarkan dijamin telah atau mungkin dilanggar; atau (b) apabila diberitahu secara bertulis oleh penjamin orang itu bahawa orang itu mungkin melanggar mana-mana syarat yang berdasarkannya atau yang tertakluk kepadanya orang itu telah dilepaskan dan bahawa penjamin itu hendak dibebaskan daripada obligasinya sebagai penjamin.\". Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 35(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"firma, persatuan atau lain-lain kumpulan orang\" yang pertama terdapat dengan perkataan \"sesuatu firma, sesuatu pertubuhan, sesuatu persatuan atau kumpulan orang yang lain\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/12/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"persatuan atau lain-lain kumpulan orang\" yang kedua terdapat dengan perkataan \"pertubuhan, persatuan atau kumpulan orang yang lain\". Pemotongan seksyen 36"
      }
    }
  ]
}
