      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
