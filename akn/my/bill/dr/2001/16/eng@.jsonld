      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 11 the following section: \" Appeal. 11. (1) Any person who is aggrieved by any decision of the Registrar under section 5, 5A, 5B, 5C, 5D or 5E may appeal to the Minister in the prescribed manner within thirty days from the date the decision is communicated to such person. (2) The Minister's decision on an appeal under subsection (1) shall be final.\". New section 11A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 11 the following section: Display of 11A. The certificate of registration issued in respect of certificate a business registered under this Act shall be kept exhibited of registration. in a conspicuous place at the principal place of business and the certificate issued for each branch of the business shall be kept exhibited in a conspicuous place at that branch.\". Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/16/eng@/~cl_12__para_a",
