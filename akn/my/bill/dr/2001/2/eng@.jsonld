      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 10(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the colon appearing after the words \"section 8\" a full stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the proviso to that subsection. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 14(2) of the principal Act is amended by inserting after the words \"government agency\" the words \"or agency of the Commission\". Amendment of section 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 15(1) of the principal Act is amended by substituting for the words \"certain classes of persons\" the words \"the Government, its agencies or any class of persons\". Amendment of section 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 20 of the principal Act is amended in the marginal note and in subsection (1), by substituting for the words \"Director General\" the word \"Commission\". Amendment of section 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections 21(1), (2), (3) and (4) of the principal Act are amended by substituting for the words \"Director General\" wherever appearing the word \"Commission\". Amendment of section 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 29 of the principal Act is amended by substituting for the words \"Director General\" the word \"Commission\". Amendment of section 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 32 of the principal Act is amended by substituting for the words \"Director General\" the word \"Commission\". Amendment of section 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 34 of the principal Act is amended by substituting for the words \"Director General\" the word \"Commission\". Substitution of section 40"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 40 the following section: 40. (1) The Chairman of the Commission may, with the consent in writing of the Public Prosecutor, compound any offence committed by any person under this Act or any rules made thereunder and determined by the Minister to be a compoundable offence by rules made under this Act by making a written offer to the person suspected to have committed the offence to compound the offence upon payment to the Chairman of an amount of money not exceeding fifty per cent of the amount of the maximum fine for that offence within the time specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and if the amount specified in the offer is not paid within the time specified in the offer or within such extended period as the Chairman may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "If an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made and any thing seized in connection with the offence may be released or forfeited by the Chairman, subject to such terms and conditions as he thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the Chairman under this section shall be paid into and form part of the Federal Consolidated Fund.\". Bill Substitution of section 41"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 41 the following section: 41. (1) The Minister may in writing authorize any public officer or officer of the Commission to exercise the powers of enforcement under this Act or any rules made thereunder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any such officer shall be deemed to be a public servant within the meaning of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising any of the powers of enforcement under this Act or any rules made thereunder, an officer authorized under subsection (1) shall, on demand, produce to the person against whom he is acting the authorization issued to him by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), any police officer not below the rank of Inspector shall have and may exercise the powers of enforcement conferred under this Act or any rules made thereunder to an officer authorized under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising any of the powers of enforcement conferred under this Act or any rules made thereunder on a police officer not below the rank of Inspector, such police officer shall, if not in uniform, on demand, declare his office and produce to the person against whom he is acting such authority card as the Inspector General of Police may direct to be carried by such police officer.\". Amendment of section 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Postal Services (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Postal Services Act 1991 [Act 465], which in this Act is referred to as the \"principal Act\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
