        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words \"making an investigation under section 41\" the words \"authorized under section 41 who is exercising the powers of enforcement conferred under this Act or any rules made thereunder\"; Postal Services (Amendment) 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words \"such officer\" the words \"the officer referred to in subsection (1)\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/eng@/~cl_20__para_c",
      "@type": "akn:paragraph",
