      "schema:text": {
        "@language": "en",
        "@value": "Section 44 of the principal Act is amended by substituting for the words \"the Director General or an authorized officer and whether or not interpreted to him by an authorized officer\" the words \"an officer authorized under section 41 and whether or not interpreted to him by an officer authorized under section 41\". Amendment of section 45"
