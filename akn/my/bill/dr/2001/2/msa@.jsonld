      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 43 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"membuat sesuatu penyiasatan di bawah seksyen 41\" dengan perkataan \"diberi kuasa di bawah seksyen 41 yang menj alankan kuasa penguatkuasaan yang diberikan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"pegawai tersebut\" dengan perkataan \"pegawai yang disebut dalam subseksyen (1)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam proviso, dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Menteri\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan memasukkan selepas perkataan \"pegawai\" perkataan \"yang diberi kuasa di bawah seksyen 41\". Pindaan seksyen 44"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 44 Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah atau seorang pegawai diberikuasa dan sama ada atau tidak diterjemahkan kepadanya oleh seorang pegawai diberikuasa\" dengan perkataan \"seseorang pegawai yang diberi kuasa di bawah seksyen 41 dan sama ada atau tidak diterjemahkan kepadanya oleh seorang pegawai yang diberi kuasa di bawah seksyen 41\". Pindaan seksyen 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 45 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Ketua Pengarah atau mana-mana pegawai diberikuasa\" dengan perkataan \"seseorang pegawai yang diberi kuasa di bawah seksyen 41\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Ketua Pengarah, atau pegawai diberikuasa tersebut\" dengan perkataan \"pegawai tersebut\". Penggantian seksyen 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 46 dengan seksyen yang berikut: Menghalang 46. Mana-mana orang yang menghalang Suruhanjaya atau pelaksanaan menyerang, menggalang, merintangi atau menghalang tugas. Pengerusi Suruhanjaya, mana-mana pegawai diberikuasa atau mana-mana pegawai yang diberi kuasa di bawah seksyen 41 dalam melaksanakan tugas-tugasnya di bawah Akta ini adalah melakukan suatu kesalahan.\". Penggantian seksyen 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 47 dengan seksyen yang berikut: Pendak- 47. Tiada pendakwaan boleh dimulakan bagi suatu waan kesalahan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya kecuali melalui atau dengan keizinan bertulis Pendakwa Raya.\". Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, sebutan tentang Kerajaan, Menteri, Ketua Pengarah Pos atau pegawai diberikuasa dalam mana-mana undang-undang bertulis termasuk mana-mana perundangan subsidiari, atau dalam apa-apa surat cara, lesen, perakuan, dokumen, pendaftaran, kelulusan, arahan, perintah, garis panduan, pemberitahuan, perjanjian atau dokumen lain yang dibuat, dikeluarkan atau diberikan sebelum permulaan kuat kuasa Akta ini hendaklah ditafsirkan sebagaimana yang diperuntukkan dalam subseksyen (2), (3), (4), (5) dan (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang Kerajaan atau Ketua Pengarah Pos berhubung dengan fungsi Kerajaan atau Ketua Pengarah itu yang apabila Akta ini mula berkuat kuasa menjadi fungsi Suruhanjaya hendaklah ditafsirkan sebagai sebutan tentang Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang Ketua Pengarah Pos berhubung dengan fungsi Ketua Pengarah itu yang apabila Akta ini mula berkuat kuasa menjadi fungsi Menteri hendaklah ditafsirkan sebagai sebutan tentang Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang Ketua Pengarah Pos berhubung dengan fungsi Ketua Pengarah itu yang apabila Akta ini mula berkuat kuasa menjadi fungsi Pengerusi Suruhanjaya hendaklah ditafsirkan sebagai sebutan tentang Pengerusi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang pegawai diberikuasa hendaklah ditafsirkan sebagai sebutan tentang pegawai diberikuasa sebagaimana yang ditakrifkan dalam Akta ibu seperti yang dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua lesen, perakuan, dokumen, pendaftaran, kelulusan, arahan, perintah, garis panduan, pemberitahuan, perjanjian, dan apa-apa dokumen lain yang dibuat, dikeluarkan atau diberikan oleh Ketua Pengarah Pos, sebelum permulaan kuat kuasa Akta ini hendaklah, apabila Akta ini mula berkuat kuasa, ditafsirkan sebagai telah dibuat, dikeluarkan atau diberikan oleh Suruhanjaya atau Pengerusi Suruhanjaya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Jabatan Pos\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Ketua Pengarah\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"pegawai diberikuasa\" dengan takrif yang berikut: ' \"pegawai diberikuasa\" ertinya mana-mana pegawai yang diambil bekerja oleh Suruhanjaya dan diberi kuasa bagi maksud-maksud Akta ini oleh Suruhanjaya;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"surat\" takrif yang berikut: ' \"Suruhanjaya\" ertinya Suruhanjaya Komunikasi dan Multimedia Malaysia yang Akta 589. ditubuhkan di bawah Akta Suruhanjaya Komunikasi dan Multimedia Malaysia 1998;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa Inggeris, dengan menggantikan koma bertitik yang terdapat di hujung takrif \"postal article\" dengan noktah. Pindaan Bahagian II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian II Akta ibu dipinda dengan menggantikan tajuknya dengan tajuk yang berikut: \"FUNGSI DAN TUGAS SURUHANJAYA\". Penggantian seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 4 dengan seksyen yang berikut: Suruhan- 4. Suruhanjaya hendaklah melaksanakan fungsi-fungsi jaya dan tugas-tugas yang diberikan kepadanya di bawah Akta hendaklah ini.\". melaksana- kan fungsi dan tugas. Pemotongan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 5. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)— (i) dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas koma bertitik di hujung perenggan (j) perkataan \"dan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (k); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
