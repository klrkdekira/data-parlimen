      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_7__para_a",
