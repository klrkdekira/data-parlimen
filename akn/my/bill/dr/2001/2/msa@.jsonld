      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
