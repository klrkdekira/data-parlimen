      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan \"Kerajaan\" dengan perkataan \"Suruhanjaya\". Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 8(2) Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_9",
