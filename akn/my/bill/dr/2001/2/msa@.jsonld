      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_6__para_a__subpara_iv__subpara_A",
