      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"Kerajaan\" perkataan \"dan Suruhanjaya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
