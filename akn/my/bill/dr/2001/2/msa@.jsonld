      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_9__para_a",
