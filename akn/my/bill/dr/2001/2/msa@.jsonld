      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan memotong perkataan \"Kerajaan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
