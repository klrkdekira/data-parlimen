      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memasukkan selepas perkataan \"oleh\" perkataan \"Suruhanjaya atau\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
