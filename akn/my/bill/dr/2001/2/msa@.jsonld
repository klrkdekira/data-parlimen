    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 10(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan titik bertindih yang terdapat selepas perkataan \"seksyen 8\" dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong proviso kepada subseksyen itu. Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 14(2) Akta ibu dipinda dengan memasukkan selepas perkataan \"agensi kerajaan\" perkataan \"atau agensi Suruhanjaya\". Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 15(1) Akta ibu dipinda dengan menggantikan perkataan \"golongan-golongan orang tertentu\" dengan perkataan \"Kerajaan, agensi-agensinya atau mana-mana golongan orang\". Pindaan seksyen 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 20 Akta ibu dipinda dalam nota birai dan subseksyen"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(1), dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Pindaan seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 21(1), (2), (3) dan (4) Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah\" di mana-mana jua terdapat dengan perkataan \"Suruhanjaya\". Pindaan seksyen 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 29 Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Pindaan seksyen 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 32 Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Findaan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 34 Akta ibu dipinda dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Penggantian seksyen 40"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 40 dengan seksyen yang berikut: Kuasa 40. (1) Pengerusi Suruhanjaya boleh, dengan keizinan Pengerusi bertulis Pendakwa Ray a, mengkompaun apa-apa kesalahan Suruhan- yang dilakukan oleh mana-mana orang di bawah Akta ini jaya untuk meng- atau mana-mana kaedah yang dibuat di bawahnya dan kompaun yang ditetapkan oleh Menteri sebagai suatu kesalahan kesalahan. boleh kompaun melalui kaedah-kaedah yang dibuat di bawah Akta ini dengan membuat suatu tawaran secara bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaun kesalahan itu dengan membayar kepada Pengerusi suatu amaun wang yang tidak melebihi lima puluh peratus daripada amaun maksimum denda bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau dalam apa-apa tempoh lanjutan yang diberikan oleh Pengerusi, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan Rang Undang-Undang berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat dan apa-apa benda yang disita berkaitan dengan kesalahan itu boleh dilepaskan atau dilucuthakkan oleh Pengerusi, tertakluk kepada apa-apa terma dan syarat yang difikirkan patut olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Pengerusi di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan Persekutuan.\". Penggantian seksyen 41"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 41 dengan seksyen yang berikut: 41. (1) Menteri boleh secara bertulis memberi kuasa mana-mana pegawai awam atau pengawai Suruhanjaya untuk menjalankan kuasa penguatkuasaan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai yang sedemikian hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan mana-manakuasapenguatkuasaan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya, seseorang pegawai yang diberi kuasa di bawah subseksyen (1) hendaklah, apabila diminta, menunjukkan kepada orang yang terhadapnya dia bertindak kuasa yang dikeluarkan kepadanya oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Walauapapun subseksyen (1), mana-mana pegawai polis yang berpangkat tidak rendah daripada Inspektor hendaklah mempunyai dan boleh menjalankan kuasa penguatkuasaan yang diberikan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya kepada seseorang pegawai yang diberi kuasa di bawah subseksyen (1). Perkhidmatan Pos (Pindaan) 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan mana-mana kuasa penguatkuasaan yang diberikan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya kepada seseorang pegawai polis yang berpangkat tidak rendah daripada Inspektor, pegawai polis itu hendaklah, jika tidak berpakaian seragam, apabila diminta, menyatakan jawatannya dan menunjukkan kepada orang yang terhadapnya dia bertindak kad kuasa yang diarahkan oleh Ketua Polis Negara supaya dibawa oleh pegawai polis itu.\". Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perkhidmatan Pos (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perkhidmatan Pos 1991 [Akta 465], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"membuat sesuatu penyiasatan di bawah seksyen 41\" dengan perkataan \"diberi kuasa di bawah seksyen 41 yang menj alankan kuasa penguatkuasaan yang diberikan di bawah Akta ini atau mana-mana kaedah yang dibuat di bawahnya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"pegawai tersebut\" dengan perkataan \"pegawai yang disebut dalam subseksyen (1)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"Ketua Pengarah\" dengan perkataan \"Suruhanjaya\". Pindaan seksyen 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/2/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
