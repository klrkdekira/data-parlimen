        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Pensions (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 October 2001. Amendment of section 6A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Pensions Act 1980 [Act 227], which is referred to as \"the principal Act\" in this Act, is amended in section 6A —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5), by substituting for the word \"fifty- five\" the word \"fifty-six\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (5) the following subsection: \"(5A) Subsection (5) shall not apply to an officer who was appointed before 1 October 2001 and had been given an option before such date and had not opted for the compulsory age of retirement of fifty- six years.\". Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 10 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsections (1), (2) and (3), by substituting for the word \"fifty-five\" the word \"fifty-six\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by inserting after the semi-colon the word \"and\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words \"; or\" a full stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (c)\\ and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (6) the following subsections: \"(7) The compulsory age of retirement of fifty-six years provided for in subsection (1) shall apply to an officer who is appointed on or after 1 October 2001. (8) The compulsory age of retirement of fifty-six years provided for in subsection (1) shall not apply to an officer who was appointed before 1 October 2001 and who had been given an option before such date and had not opted for the compulsory age of retirement of fifty-six years. (9) The option for the compulsory age of retirement of fifty-six years exercised by an officer referred to in subsection (8) shall be irrevocable.\". Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the word \"fifty- five\" the word \"fifty-six\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3A) the following subsection: \"(3e) Where an officer referred to in subsection (3) who was appointed before 1 October 2001 had been given an option before such date and had not opted for the compulsory age of retirement of fifty- six years, subsection (3) shall apply to him with the word 'fifty-five' being substituted for the word 'fifty- six'.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words \"or fifty- five\" the words \", fifty-five years of age or fifty-six\". Amendment of section 12A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
