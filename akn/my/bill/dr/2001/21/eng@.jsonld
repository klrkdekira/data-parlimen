      "schema:name": {
        "@language": "en",
        "@value": "Section 12A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/21/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the word \"fifty- five\" the word \"fifty-six\"; and"
      }
    },
    {
