      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan seksyen 352 dengan seksyen yang berikut: \"352.In this Chapter— (a) \"psychiatric hospital\" means an approved psychiatric hospital established under the Mental Health Act 2001; and (b) \"Visitors\" means the members of the Board of Visitors appointed under section 38 of the Mental Health Act 2001 and for the time being acting under section 40 of that Act.\". Pemotongan seksyen 352A"
      }
    },
