      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 352A Akta ibu dipotong. Pindaan Jadual Pertama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kanun Tatacara Jenayah (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan dalam Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun Tatacara Jenayah [Akta 593], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2, dengan menggantikan takrif \"Medical Superintendent\" dengan takrif yang berikut: ' \"Medical Director\" of a psychiatric hospital includes a Deputy Medical Director;'. Pin da an seksyen 108A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Pertama kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran yang berkaitan dengan seksyen 372 Kanun Keseksaan —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam ruang 2, dengan menggantikan perkataan \"Selling or letting to hire a minor for the purpose of prostitution, etc.\" dengan perkataan \"Exploiting any person for purposes of prostitution\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam ruang 7, dengan menggantikan perkataan \"Imprisonment for ten years, and fine\" dengan perkataan \"Imprisonment for fifteen years and whipping, and fine\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas butiran yang berkaitan dengan seksyen 372 Kanun Keseksaan, butiran yang berikut di bawah ruangan masing-masing: \"372A Persons living on do do. do do do or trading in prostitution 372B Soliciting for do. do do. do. Imprisonment for purposes of one year, or fine, prostitution or both\","
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran yang berkaitan dengan seksyen 373 Kanun Keseksaan —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam ruang 2, dengan menggantikan perkataan \"Buying or obtaining possession of a minor for the same purposes\" dengan perkataan \"Suppression of brothels\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam ruang 7, dengan menggantikan perkataan \"do.\" dengan perkataan \"Imprisonment for fifteen years, and fine\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong butiran yang berkaitan dengan seksyen 373A Kanun Keseksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan tajuk\"Rape and Unnatural Offences\" dengan tajuk \"Rape, Incest and Unnatural Offences\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan, selepas butiran yang berkaitan dengan seksyen 376 Kanun Keseksaan, butiran yang berikut di bawah ruang masing-masing: \"376B Incest do do. do. do. Imprisonment for not less than six years and not more than twenty years, and whipping\" Kanun Tatacara Jenayah (Pindaan) 7 Pemotongan Jadual Ketiga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Ketiga kepada Akta ibu dipotong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 108A Akta ibu dipinda dengan memotong perkataan \"or 108\". Pindaan seksyen 117"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 117(2) Akta ibu dipinda dengan menggantikan perkataan \"committal\" dengan perkataan \"transmission\". Pemotongan seksyen 157"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 157 Akta ibu dipotong. Pindaan seksyen 255"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 255 Akta ibu dipinda dengan memotong perkataan \"the provisions of section 8, and to\". Pindaan seksyen 316"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 316 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan \"or committed for trial\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (b)(i), dengan memotong perkataan \"or committed for trial\". Pindaan seksyen 332"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 332(2) Akta ibu dipinda dengan memotong perkataan \"and also in any inquiry held under Chapter XVII\". Pindaan seksyen 334"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 334 Akta ibu dipinda dengan menggantikan perkataan \"mental\" di mana-mana jua terdapat dengan perkataan \"psychiatric\". Pindaan seksyen 340"
      }
    }
  ]
}
