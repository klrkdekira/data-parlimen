      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu kepada seksyen 352 dengan nota bahu yang berikut: \"Interpretation of \"psychiatric hospital\" and \"Visitors\" \"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/27/msa@/~cl_18__para_b",
