      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Ahli Parlimen (Saraan) (Pindaan) (No.2) 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen (Saraan) (Pindaan) (No. 2) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah disifatkan telah mula berkuat kuasa pada 1 Januari 2001. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Ahli Parlimen (Saraan) 1980 [Akta 237], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2 dengan menggantikan takrif \"Ahli atau Anggota\" dengan takrif yang berikut: ' \"Ahli atau Anggota\" ertinya Anggota Pentadbiran, Ahli Parlimen, Yang di-Pertua dan Timbalan Yang di-Pertua Dewan Negara dan Yang di-Pertua dan Timbalan Yang di-Pertua Dewan Rakyat;'. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a) dan (b), dengan menggantikan perkataan \"sepuluh ribu dua ratus lapan puluh lima\" dengan perkataan \"sebelas ribu lima ratus tujuh puluh dua\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c) dan (d), dengan menggantikan perkataan \"elaun bulanan sebanyak tiga ribu tiga ratus sembilan puluh sembilan ringgit\" dengan perkataan \"gaji bulanan sebanyak lapan ribu ringgit\". Pembayaran gaji walau apa pun seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 7 Akta ibu, gaji bulanan yang dinyatakan dalam pindaan kepada Akta ibu dalam seksyen 4, dan yang kena dibayar, hendaklah bermula dari 1 Januari 2001 atau dari tarikh pelantikan atau pemilihan, mengikut mana-mana yang terkemudian, Yang di-Pertua atau Timbalan Yang di-Pertua Dewan Negara atau Yang di-Pertua atau Timbalan Yang di-Pertua Dewan Rakyat, mengikut mana-mana yang berkenaan. Pindaan Jadual Kedua"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Kedua kepada Akta ibu dipinda dalam Ruang II dengan memasukkan selepas perkataan \"Ahli Parlimen\" perkataan \", Timbalan Yang di-Pertua Dewan Negara dan Timbalan Yang di-Pertua Dewan Rakyat\"."
      }
    }
  ]
}
