      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words \"The Controller and all officers and servants appointed by the Controller under subsection (3)\" the words \"The Commission and its employees\". Amendment of section 8"
      }
    },
    {
