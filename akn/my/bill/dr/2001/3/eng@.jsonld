    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 24(1) of the principal Act is amended in the English language text by substituting for the word \"he\" the word \"it\". Amendment of section 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 47(2) of the principal Act is amended in the English language text by deleting the words \"his or\". Amendment of section 68"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 68(3) of the principal Act is amended in the English language text by substituting for the word \"he\" the word \"it\". Amendment of section 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 69(2)(f) of the principal Act is amended in the English language text by substituting for the word \"his\" the word \"its\". Amendment of section 70"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 70(3) of the principal Act is amended in the English language text by substituting for the word \"he\" the word \"it\". Amendment of section 71"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 71(8) of the principal Act is amended in the English language text by substituting for the word \"his\" the word \"its\". Amendment of section 75"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 75(2) of the principal Act is amended by substituting for the words \"such officer\" the words \"officer authorised under subsection (1)\". New section 75A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_17__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 75 the following section: Enforce- 75A. (1) Notwithstanding subsection 75(1), any police ment by police officer not below the rank of Inspector shall have and officers. may exercise the powers of enforcement conferred by this Act on an authorised officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising any of the powers of enforcement conferred under this Act on a police officer not below the rank of Inspector, such police officer shall, if not in uniform, on demand declare his office and produce to the person against whom he is acting the authority card as the Inspector General of Police may direct to be carried by such police officer.\". Digital Signature (Amendment) 5 Amendment of section 88"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 88 of the principal Act is amended in the marginal note by inserting after the words \"Protection of the words \"Commission and\". Saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the commencement of this Act, references to the Controller of Certification Authorities (\"Controller\") or any officer and servant appointed by the Controller in any written law, including any subsidiary legislation, or in any document, instrument, licence, bond, security, registration, approval, certificate, directive, order, guideline, notification, agreement or other document made, issued or given the commencement of this Act shall be construed as provided for in subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "References to the Controller in relation to the functions of such Controller which upon the commencement of this Act become the functions of the Commission shall be construed as references to the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "References to the officer and servant appointed by the Controller in relation to the functions of such officer and servant which upon the commencement of this Act become the functions of an authorised officer shall be construed as references to the authorised officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "All documents, instruments, licences, bonds, securities, certificates, directives, orders, guidelines, approvals, notifications, agreements and such other documents that have been made, issued or given by the Controller or any officer and servant appointed by the Controller before the commencement of this Act shall be construed as having been made, issued or given by the Commission or any authorised officer, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Digital Signature (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Digital Signature Act 1997 [Act 562], which in this Act is referred to as the \"principal Act\", is amended by substituting for the word \"Controller\" wherever it appears the word \"Commission\". Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"certify\" the following definition: ' \"Commission\" means the Malaysian Communications and Multimedia Commission Act 589. established under the Malaysian Communications and Multimedia Commission Act 1998;'; and 2 Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"Controller\". Amendment of Part II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The heading of Part II of the principal Act is amended by substituting for the words \"CONTROLLER OF CERTIFICATION AUTHORITIES\" the words \"THE COMMISSION\". Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_5",
      "@type": "akn:clause",
