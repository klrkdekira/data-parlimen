      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: \"(1) The Commission shall be responsible for administering, enforcing, carrying out and giving effect to the provisions of this Act and shall exercise, discharge and perform the powers, duties and functions under this Act for the purpose of monitoring and overseeing the activities of certification authorities.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
