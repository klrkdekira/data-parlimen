      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 24( 1) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"he\" dengan perkataan \"it\". Pindaan seksyen 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 47(2) Akta ibu dipinda dalam teks bahasa Inggeris dengan memotong perkataan \"his or\". Pindaan seksyen 68"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 68(3) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikarr perkataan \"he\" dengan perkataan \"it\". Pindaan seksyen 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 69(2)(j) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"his\" dengan perkataan \"its\". Pindaan seksyen 70"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 70(3) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"he\" dengan perkataan \"it\". Pindaan seksyen 71"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 71 (8) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"his\" dengan perkataan \"its\". Pindaan seksyen 75"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 75(2) Akta ibu dipinda dengan menggantikan perkataan \"pegawai sedemikian\" dengan perkataan \"pegawai yang diberi kuasa di bawah subseksyen (1)\". Seksyen baru 75A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_17__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 75 seksyen yang berikut: Penguat- 75A. (1) Walau apa pun subseksyen 75(1), mana-mana kuasaan pegawai polis yang pangkatnya tidak rendah daripada oleh pegawai Inspektor hendaklah mempunyai dan boleh menjalankan polis. kuasa penguatkuasaan yang diberikan oleh Akta ini kepada seorang pegawai diberikuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan mana-mana kuasa penguatkuasaan yang diberikan di bawah Akta ini kepada seseorang pegawai polis yang pangkatnya tidak rendah daripada Inspektor, pegawai polis itu, jika tidak berpakaian seragam, hendaklah, apabila diminta, menyatakan jawatannya dan menunjukkan kepada orang yang terhadapnya dia bertindak kad kuasa sebagaimana yang diarahkan oleh Ketua Polis Negara supaya dibawa oleh pegawai polis itu.\". Pindaan seksyen 88"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 88 Akta ibu dipinda dalam nota birai dengan memasukkan selepas perkataan \"Perlindungan\" perkataan \"Suruhanjaya dan\". Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, sebutan tentang Pengawal Pihak Berkuasa Pemerakuan (\"Pengawal\") atau mana- mana pegawai dan pekhidmat yang dilantik oleh Pengawal dalam mana-mana undang-undang bertulis, termasuk mana-mana perundangan subsidiary atau dalam mana-mana dokumen, surat cara, lesen, bon, sekuriti, pendaftaran, kelulusan, perakuan, arahan, perintah, garis panduan, pemberitahuan, perjanjian atau dokumen lain yang dibuat, dikeluarkan atau diberikan sebelum permulaan kuat kuasa Akta ini hendaklah ditafsirkan sebagaimana yang diperuntukkan dalam subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang Pengawal berhubung dengan fungsi Pengawal itu yang apabila Akta ini mula berkuat kuasa menjadi fungsi Suruhanjaya hendaklah ditafsirkan sebagai sebutan tentang Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan tentang pegawai dan pekhidmat yang dilantik oleh Pengawal berhubung dengan fungsi pegawai dan pekhidmat itu yang apabila Akta ini mula berkuat kuasa menjadi fungsi pegawai diberikuasa hendaklah ditafsirkan sebagai sebutan tentang pegawai diberikuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua dokumen, surat cara, lesen, bon, sekuriti, perakuan, arahan, perintah, garis panduan, kelulusan, pemberitahuan, perjanjian dan apa-apa dokumen lain yang dibuat, dikeluarkan atau diberikan oleh Pengawal atau mana-mana pegawai dan pekhidmat yang dilantik oleh Pengawal sebelum permulaan kuat kuasa Akta ini hendaklah ditafsirkan sebagai telah dibuat, dikeluarkan atau diberikan oleh Suruhanjaya, atau mana-mana pegawai diberikuasa, mengikut mana- mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Tandatangan Digital (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Tandatangan Digital 1997 [Akta 562], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dengan menggantikan perkataan \"Pengawal\" di mana-mana jua terdapat dengan perkataan \"Suruhanjaya\". Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"sistem kripto tak simetri\" takrif yang berikut: ' \"Suruhanjaya\" ertinya Suruhanjaya Komunikasi dan Multimedia Malaysia yang Akta 589. ditubuhkan di bawah Akta Suruhanjaya Komunikasi dan Multimedia Malaysia 1998;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Pengawal\". Pindaan Bahagian II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Bahagian II Akta ibu dipinda dengan menggantikan perkataan \"PENGAWAL PIHAK BERKUASA PEMERAKUAN\" dengan perkataan \"SURUHANJAYA\". Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Suruhanjaya hendaklah bertanggungjawab bagi pentadbiran, penguatkuasaan, penjalanan dan pelaksanaan peruntukan Akta ini dan hendaklah menjalankan, menunaikan dan melaksanakan kuasa, kewajipan dan fungsi di bawah Akta ini bagi maksud mengawasi dan menyelia aktiviti pihak berkuasa pemerakuan.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2) dan (3); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan \"Pengawal dan semua pegawai dan pengkhidmat yang dilantik oleh Pengawal di bawah subseksyen (3)\" dengan perkataan \"Suruhanjaya dan pekerjanya\". Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/3/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"dia\" dengan perkataan \"ia\"; dan"
      }
    },
