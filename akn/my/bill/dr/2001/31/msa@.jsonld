      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Hakcipta (Pindaan) 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Hakcipta (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Hakcipta 1987 [Akta 332], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 3 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Menteri\" dengan takrif yang berikut: ' \"Menteri\" ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi harta intelek;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif ' \"Pengawal\", \"Timbalan Pengawal\" dan \"Penolong Pengawal\" ' dengan takrif yang berikut: ' \"Pengawal\" ertinya Pengawal Hakcipta yang ditetapkan dalam subseksyen (1) seksyen 5;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"pengeluaran semula\" takrif yang berikut: ' \"Penolong Pengawal\" ertinya orang yang dilantik atau disifatkan telah dilantik untuk menjadi Penolong Pengawal di bawah subseksyen (2) atau (3) seksyen 5;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"penyesuaian\" takrif yang berikut: ' \"Perbadanan\" ertinya Perbadanan Harta Intelek Akta . Malaysia yang ditubuhkan di bawah Akta Perbadanan Harta Intelek Malaysia 2001;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"skim pelesenan\" takrif yang berikut: ' \"tarikh yang ditetapkan\" mempunyai erti yang sama sebagaimana yang diberikan kepada ungkapan itu dalam Akta Perbadanan Harta Intelek Malaysia 2001;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"tarikh yang ditetapkan\" takrif yang berikut: ' \"Timbalan Pengawal\" ertinya orang yang dilantik atau disifatkan telah dilantik untuk menjadi Timbalan Pengawal di bawah subseksyen (2) atau (3) seksyen 5;'. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 5 dengan seksyen yang berikut: Pengawal, 5. (1) Ketua Pengarah Perbadanan hendaklah menjadi Timbalan Pengawal Pengawal Hakcipta. dan Penolong Pengawal Hakcipta (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh melantik, atas apa-apa terma dan syarat yang ditentukannya, daripada kalangan mana- mana pegawai awam dan orang dalam penggajian Perbadanan, apa-apa bilangan Timbalan Pengawal Hakcipta, Penolong Pengawal Hakcipta dan pegawai lain yang perlu bagi pentadbiran yang sepatutnya Akta ini, dan boleh membatalkan pelantikan mana-mana orang yang dilantik sedemikian atau disifatkan telah dilantik sedemikian di bawah subsekyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang memegang jawatan sebagai Timbalan Pengawal, Penolong Pengawal dan pegawai lain di bawah Akta ini sebelum tarikh yang ditetapkan hendaklah pada tarikh yang ditetapkan disifatkan telah dilantik sebagai Timbalan Pengawal, Penolong Pengawal dan pegawai lain sedemikian di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada arahan dan kawalan am Pengawal dan kepada apa-apa syarat atau sekatan yang dikenakan oleh Pendaftar dan tertakluk kepada seksyen 41 A , seseorang Timbalan Pengawal atau seseorang Penolong Pengawal boleh menjalankan apa-apa fungsi Pengawal di bawah Akta ini, dan apa-apa jua yang ditetapkan atau diberi kuasa atau dikehendaki oleh Akta ini supaya dilakukan atau ditandatangani oleh Pengawal boleh dilakukan atau ditandatangani oleh mana-mana Timbalan Pengawal atau Penolong Pengawal dan perbuatan atau tandatangan seseorang Timbalan Pengawal atau seseorang Penolong Pengawal hendaklah sama sah dan kuat kuasanya seolah- olah telah dilakukan atau ditandatangani oleh Pengawal.\". Pindaan seksyen 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta ibu dipinda dengan memotong perkataan \"atau mula-mula dijadikan tersedia kepada orang awam atau dibuat, mengikut mana-mana yang paling kemudian\". Pindaan seksyen 41 A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 lA Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"boleh mengkompaun\" dengan perkataan \"atau mana- mana orang yang diberi kuasa oleh Pengawal secara bertulis boleh dengan keizinan bertulis Pendakwa Raya mengkompaunkan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3). Penggantian seksyen 53"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 53 dengan seksyen yang berikut: Pemulaan 53. Tiada pendakwaan bagi apa-apa kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan secara bertulis Pendakwa Raya.\"."
      }
    }
  ]
}
