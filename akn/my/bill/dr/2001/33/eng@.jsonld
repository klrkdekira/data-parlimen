      ],
      "schema:name": {
        "@language": "en",
        "@value": "Geographical Indications (Amendment) Bill 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Geographical Indications (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Geographical Indications Act 2000 [Act 602], which in this Act is referred to as the \"principal Act\", is amended in section 2 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting before the definition of \"appointed date\" the following definition: ' \"agent\" means a Geographical Indication agent registered in accordance with this Act and the regulations made under it;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"Minister\" the following definition: ' \"Minister\" means the Minister for the time being charged with the responsibility for intellectual property;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definitions of' \"Registrar\", \"Deputy Registrar\" and \"Assistant Registrar\" ' the following definition: ' \"Registrar\" means the Registrar of Geographical Indications as designated in subsection 8(1);';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"appointed date\" the following definition: ' \"Assistant Registrar\" means the person appointed or deemed to have been appointed to be an Assistant Registrar under subsection 8(2) or (3);';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"competent authority\" the following definition: ' \"Corporation\" means the Intellectual Property Corporation of Malaysia established under the Intellectual Property Corporation of Malaysia Act 2001;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the national language text, by substituting for the full stop at the end of the definition of \"pihak berkuasa yang berwibawa\" a semicolon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting before the definition of \"competent authority\" the following definition: ' \"appointed date\" has the same meaning as is assigned to that expression in the Intellectual Property Corporation of Malaysia Act 2001 [Act];';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Court\" the following definition: ' \"Deputy Registrar\" means the person appointed or deemed to have been appointed to be a Deputy Registrar under subsection 8(2) or (3);'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Register\" the following definition: ' \" registered proprietor\", in relation to a geographical indication, means the person for the time being entered in the Register as proprietor of the geographical indication;'. Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 8 the following section: \"Registrar, Deputy Registrars and Assistant Registrars 8. (1) The Director-General of the Corporation shall be the Registrar of Geographical Indications. (2) The Corporation may appoint, on such terms and conditions as it may determine, from amongst persons in the employment of the Corporation, such number of Deputy Registrars of Geographical Indications, Assistant Registrars of Geographical Indications and other officers as may be necessary for the proper administration of this Act, and may revoke the appointment of any person so appointed or deemed to have been so appointed under subsection (3). (3) The persons holding office as Deputy Registrars, Assistant Registrars and other officers under this Act before the appointed date who were given an option by the Government of Malaysia to serve as employees of the Corporation and have so opted shall on the appointed date be deemed to have been appointed as Deputy Registrars, Assistant Registrars and such other officers under subsection (2). 4 Bill (4) Subject to the general direction and control of the Registrar and to such conditions or restrictions as may be imposed by the Registrar, a Deputy Registrar or an Assistant Registrar may exercise any function of the Registrar under this Act, and anything by this Act appointed or authorized or required to be done or signed by the Registrar may be done or signed by any Deputy Registrar or Assistant Registrar and the act or signature of a Deputy Registrar or an Assistant Registrar shall be as valid and effectual as if done or signed by the Registrar. (5) The Registrar shall have a seal of such device as may be approved by the Corporation and the impressions of such seal shall be judicially noticed and admitted in evidence.\". Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: \"(1A) An applicant may file an application for registration of a geographical indication personally or through an agent,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) Notwithstanding subsection (1A), where an applicant does not reside or carry on business in Malaysia, he shall appoint an agent to act on his behalf.\". New section 1 1A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 11 the following section: \"Agent 11A. (1) Any person, firm or company may apply to act as an agent for the purposes of this Act if— (a) that person is domiciled or resident in Malaysia; or (b) the firm or company is constituted under the laws of Malaysia; and (c) such person, firm or company carries on business or practice principally in Malaysia. (2) The qualifications and the mode of registration of an agent shall be as prescribed.\". Amendment of section 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 19 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the section as subsection (1) of that section; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: \"(2) The period of registration of a geographical indication shall be ten years and the registration is renewable upon an application made under section I9A.\". New sections 19A and 19B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 19 the following sections: \"Renewal of registration 19A. (1) During the prescribed time before the date of expiry of the registration of a geographical indication the Registrar shall send a notice in the prescribed manner to the registered proprietor of such date of expiry. (2) An application for the renewal of the registration of a geographical indication shall be made by the registered proprietor in the prescribed manner to the Registrar within the prescribed time before the date of expiry of the registration. (3) An application under subsection (2) shall be accompanied by the prescribed fee. (4) Subject to subsection (5), upon receipt of an application under subsection (2) and the prescribed fee, the Registrar shall renew the registration of the geographical indication for a period which shall not exceed ten years at each renewal. (5) For the purpose of renewing the registration of a geographical indication, the Registrar may require additional particulars and may refuse to renew the registration if the applicant does not furnish the additional particulars required. (6) If the Registrar refuses to renew the registration under subsection (5) the Registrar shall notify the applicant in writing of the decision. (7) Subject to section 19s, the Registrar may remove a geographical indication from the Register if the applicant fails to apply for the renewal of the geographical indication within the prescribed time. Restoration of geographical indication removed from the Register 19B. The Registrar may restore a geographical indication that has been removed from the the Register under subsection 19A(7) if- (a) the applicant files an application for such restoration within twelve months from the date of expiry of the registration of the geographical indication; and (b) the Registrar is satisfied that— (i) there has been no use in bad faith of the geographical indication during the year immediately preceding its removal from the Register; or (ii) no deception or confusion is likely to arise from the use of the geographical indication by reason of its previous use.\". Geographical Indications (Amendment) 7 Amendment of section 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 32 (2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"and\" at the end of paragraph (g); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (g) the following paragraphs: \"(ga) to prescribe the qualifications of agents and other matters relating to such qualifications; (gb) to provide for the registration of agents; and \". Saving provision"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The amendments to the principal Act shall not affect any application for registration of a geographical indication or for the renewal of the registration of a geographical indication or the registration of a geographical indication or the renewal of the registration of a geographical indication, as the case may be, made under the principal Act before the appointed date and the relevant provisions of the principal Act, shall apply to the application or registration or renewal, as the case may be, as if the provisions had not been amended by this Act."
      }
    }
  ]
}
