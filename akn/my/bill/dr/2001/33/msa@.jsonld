      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Petunjuk Geografi (Pinddan) 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Petunjuk Geografi (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Petunjuk Geografi 2000 [Akta 602], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"Daftar\" takrif yang berikut: ' \"ejen\" ertinya seorang ejen Petunjuk Geografi yang berdaftar mengikut Akta ini dan peraturan-peraturan yang dibuat di bawahnya;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Menteri\" dengan takrif yang berikut: ' \"Menteri\" ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi harta intelek;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif ' \"Pendaftar\", \"Timbalan Pendaftar\" dan \"Penolong Pendaftar\" ' dengan takrif yang berikut: ' \"Pendaftar\" ertinya Pendaftar Petunjuk Geografi yang ditetapkan dalam subseksyen 8(1);';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"pengeluar\" takrif yang berikut: \" \"Penolong Pendaftar\" ertinya orang yang dilantik atau disifatkan telah dilantik untuk menjadi Penolong Pendaftar di bawah subseksyen 8(2) atau (3);'; (e) dengan memasukkan selepas takrif \"Penolong Pendaftar\" takrif yang berikut: ' \"Perbadanan\" ertinya Perbadanan Harta Intelek Malaysia yang ditubuhkan di bawah Akta Perbadanan Harta Intelek Malaysia 2001 [A k t a] ; '; (f) dalam teks bahasa kebangsaan, dengan menggantikan noktah di akhir takrif \"pihak berkuasa yang berwibawa\" dengan koma bertitik; (g) dengan memasukkan selepas takrif \"pihak berkuasa yang berwibawa\" takrif yang berikut: ' \"tarikh yang ditetapkan\" mempunyai erti yang sama sebagaimana yang diberikan kepada ungkapan itu dalam Akta Perbadanan Harta Intelek Malaysia 2001;'; (h) dengan memasukkan selepas takrif \"tarikh yang ditetapkan\" takrif yang berikut: ' \"Timbalan Pendaftar\" ertinya orang yang dilantik atau disifatkan telah dilantik untuk menjadi Timbalan Pendaftar di bawah subseksyen 8(2) atau (3);'; dan (i) dengan memasukkan selepas takrif \"Timbalan Pendaftar\" takrif yang berikut: ' \"tuan punya berdaftar\", berhubung dengan sesuatu petunjuk geografi, ertinya orang yang pada masa ini tercatat dalam Daftar sebagai tuan punya petunjuk geografi itu;'. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 8 dengan seksyen yang berikut: \"Pendaftar, Timbalan Pendaftar dan Penoiong Pendaftar 8. (1) Ketua Pengarah Perbadanan hendaklah menjadi Pendaftar Petunjuk Geografi. (2) Perbadanan boleh melantik, atas apa-apa terma dan syarat yang ditentukannya, daripada kalangan orang dalam penggajian Perbadanan, apa-apa bilangan Timbalan Pendaftar Petunjuk Geografi, Penoiong Pendaftar Petunjuk Geografi dan pegawai lain yang perlu bagi pentadbiran yang sepatutnya Akta ini, dan boleh membatalkan pelantikan mana-mana orang yang dilantik sedemikian atau disifatkan telah dilantik sedemikian di bawah subseksyen (3). (3) Orang yang memegang jawatan sebagai Timbalan Pendaftar, Penoiong Pendaftar dan pegawai lain di bawah Akta ini sebelum tarikh yang ditetapkan yang telah diberi pilihan oleh Kerajaan Malaysia untuk berkhidmat sebagai pekerja Perbadanan dan telah memilih sedemikian hendaklah pada tarikh yang ditetapkan disifatkan telah dilantik sebagai Timbalan Pendaftar, Penoiong Pendaftar dan pegawai lain sedemikian di bawah subseksyen (2). (4) Tertakluk kepada arahan dan kawalan am Pendaftar dan kepada apa-apa syarat atau sekatan yang dikenakan oleh Pendaftar, seseorang Timbalan Pendaftar atau seseorang Penolong Pendaftar boleh menjalankan apa-apa fungsi Pendaftar di bawah Akta ini, dan apa-apa jua yang ditetapkan atau diberi kuasa atau dikehendaki oleh Akta ini supaya dilakukan atau ditandatangani oleh Pendaftar boleh dilakukan atau ditandatangani oleh mana-mana Timbalan Pendaftar atau Penolong Pendaftar dan perbuatan atau tandatangan seseorang Timbalan Pendaftar atau seseorang Penolong Pendaftar hendaklah sama sah dan kuat kuasanya seolah- olah telah dilakukan atau ditandatangani oleh Pendaftar. (5) Pendaftar hendaklah mempunyai meterai dengan reka bentuk yang diluluskan oleh Perbadanan dan teraan meterai itu hendaklah diberi pengiktirafan kehakiman dan diterima sebagai keterangan.\". Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) Seseorang pemohon boleh memfailkan permohonan untuk mendaftarkan sesuatu petunjuk geografi secara sendiri atau melalui seorang ejen.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut; \"(2) Walau apa pun subseksyen (1A), jika pemohon tidak bermastautin atau tidak menjalankan perniagaan di Malaysia, dia hendaklah melantik seorang ejen untuk bertindak bagi pihaknya.\". Seksyen baru 1 1A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 11 seksyen yang berikut: 11A. (1) Mana-mana orang, firma atau syarikat boleh memohon untuk bertindak sebagai seorang ejen bagi maksud Akta ini jika— (a) orang itu berdomisil atau bermastautin di Malaysia; atau (b) firma atau syarikat itu diperbadankan di bawah undang- undang Malaysia; dan (c) orang, firma atau syarikat itu menjalankan perniagaan atau amalannya terutamanya di Malaysia. (2) Kelayakan dan cara pendaftaran seseorang ejen hendaklah sebagaimana yang ditetapkan.\". Pindaan seksyen 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 19 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen itu sebagai subseksyen (1) seksyen itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \" (2) Tempoh pendaftaran sesuatu petunjuk geografi hendaklah sepuluh tahun dan pendaftaran itu boleh diperbaharui apabila permohonan dibuat di bawah seksyen 19A.\". Seksyen baru 19A dan 19B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 19 seksyen yang berikut: \"Pembaharuan pendaftaran 19A. (1) Dalam masa yang ditetapkan sebelum tarikh habis tempoh pendaftaran sesuatu petunjuk geografi Pendaftar hendaklah menghantar suatu notis mengikut cara yang ditetapkan kepada tuan punya berdaftar tentang tarikh habis tempoh itu. (2) Sesuatu permohonan bagi pembaharuan pendaftaran sesuatu petunjuk geografi hendaklah dibuat oleh tuan punya berdaftar mengikut cara yang ditetapkan kepada Pendaftar dalam masa yang ditetapkan sebelum tarikh habis tempoh pendaftaran itu. (3) Sesuatu permohonan di bawah subseksyen (2) hendaklah disertakan dengan fi yang ditetapkan. (4) Tertakluk kepada subseksyen (5), apabila menerima sesuatu permohonan di bawah subseksyen (2) dan fi yang ditetapkan, Pendaftar hendaklah memperbaharui pendaftaran petunjuk geografi itu bagi suatu tempoh yang tidak melebihi sepuluh tahun bagi setiap pembaharuan. (5) Bagi maksud memperbaharui pendaftaran sesuatu petunjuk geografi, Pendaftar boleh menghendaki butir-butir tambahan dan boleh enggan untuk memperbaharui pendaftaran itu jika pemohon tidak memberikan butir-butir tambahan yang dikehendaki. (6) Jika Pendaftar enggan untuk memperbaharui pendaftaran di bawah subseksyen (5) Pendaftar hendaklah memberitahu pemohon secara bertulis tentang keputusan itu. (7) Tertakluk kepada seksyen 19B, Pendaftar boleh mengeluarkan sesuatu petunjuk geografi daripada Daftar jika pemohon tidak memohon pembaharuan petunjuk geografi itu dalam masa yang ditetapkan. Kemasukan semula petunjuk geografi yang dikeluarkan daripada Daftar 19B. Pendaftar boleh memasukkan semula petunjuk geografi yang telah dilkeluarkan daripada Daftar di bawah subseksyen 19A(7) jika- (a) pemohon memfailkan permohonan bagi kemasukan semula itu dalam masa dua belas bulan dari tarikh habis tempoh pendaftaran petunjuk geografi itu; dan (b) Pendaftar berpuas hati bahawa— (i) tidak ada penggunaan dengan niat jahat petunjuk geografi itu dalam tahun sebaik sebelum pengeluarannya daripada Daftar; atau (ii) tiada perdayaan atau kekeliruan yang mungkin berbangkit daripada penggunaan petunjuk geografi itu disebabkan oleh penggunaan terdahulunya.\". Pindaan seksyen 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 32(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"dan\" di hujung perenggan (g); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (g) perenggan yang berikut: \"(ga) menetapkan kelayakan ejen dan perkara lain yang berhubungan dengan kelayakan itu ; (gb) mengadakan peruntukan bagi pendaftaran ejen; dan\". Peruntukan kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan kepada Akta ibu tidaklah menyentuh apa-apa permohonan untuk mendapatkan pendaftaran sesuatu petunjuk geografi atau untuk pembaharuan pendaftaran sesuatu petunjuk geografi atau pendaftaran sesuatu petunjuk geografi atau pembaharuan pendaftaran sesuatu petunjuk geografi, mengikut mana-mana yang berkenaan, yang dibuat di bawah Akta ibu sebelum tarikh yang ditetapkan dan peruntukan yang berkaitan dalam Akta ibu, hendaklah terpakai bagi permohonan atau pendaftaran atau pembaharuan itu, mengikut mana-mana yang berkenaan, seolah-olah peruntukan itu telah tidak dipinda melalui Akta ini."
      }
    }
  ]
}
