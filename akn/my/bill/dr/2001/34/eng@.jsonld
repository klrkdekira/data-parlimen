      "schema:text": {
        "@language": "en",
        "@value": "FUNCTIONS AND POWERS OF THE CORPORATION Functions of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Corporation shall be —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that the provisions of this Act and the Intellectual Property Legislation are administered, enforced, given effect to, carried out and complied with;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to act as agent of the Government and to provide services in administering, collecting and enforcing payment of prescribed fees or any other charges under the Intellectual Property Legislation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate and supervise issues or matters relating to intellectual property in relation to the Intellectual Property Legislation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to advise on the review and updating of the Intellectual Property Legislation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to encourage and promote the training and the diffusion of knowledge and information on intellectual property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to hold, encourage and provide co-operation programme at national or international level on intellectual property issues or matters;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to safeguard the interest of Malaysia in respect of any agreement or international convention to which Malaysia is a party, and shall to the extent necessary give effect to any provision of such agreement or convention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Government on developments at international level on issues or matters relating to intellectual property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out research and to commission studies on issues or matters relating to intellectual property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister generally on issues or matters relating to intellectual property; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out such activities and do such things as are necessary or advantageous and proper for the administration of the Corporation, or for such other purposes, consistent with this Act, as may be directed by the Minister. Powers of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have power to do all things necessary or expedient for or in connection with the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the powers of the Corporation shall include power-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to utilize all the properties of the Corporation, movable and immovable, in such manner as the Corporation may think expedient;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to impose fees or charges for services rendered by the Corporation as may be prescribed by the Minister by regulations made under section 41;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint such agents, experts or consultants as it deems fit to assist the Corporation in the exercise of its functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to grant loans to employees of the Corporation for such purposes as may be approved by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to co-operate with any corporate body or government agency for the purpose of performing the Corporation's functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint and regulate Examiners under the Patents Act 1983 [Act 291]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to do anything incidental to any of its functions and powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have all such powers as may be necessary for or in connection with, or reasonably incidental to, the performance of the functions and the exercise of the powers under the Intellectual Property Legislation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt it is declared that the powers of the Corporation shall not include the powers of the Director General under the Intellectual Property Legislation. The Corporation may establish committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may establish such committees as it considers necessary or expedient to assist it in the performance of its functions and the exercise of its powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Members of a committee established under subsection (1) may be appointed from amongst members of the Corporation or such other persons as the Corporation thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may revoke the appointment of any member of a committee without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may resign by giving notice in writing to the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under this section may elect any of its members to be chairman and may regulate its own procedure, and in the exercise of its powers such committee shall be subject to and act in accordance with any direction given to the committee by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The members of a committee or any person invited to attend any meeting of a committee may be paid such allowances and other expenses as the Corporation may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of a committee shall be held at such times and places as the chairman of the committee may, subject to subsection (5), determine. Delegation of the Corporation's functions or powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may delegate any of its functions or powers to any committee established under section 19 as it may deem necessary or desirable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any function or powers delegated under this section —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may be so delegated subject to such conditions or restrictions as the Corporation may either generally or specifically impose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be exercised by the committee in the name and on behalf of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Corporation itself from performing or exercising at any time any of the functions or powers so delegated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Corporation shall be paid such remuneration and allowance as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Corporation shall be paid allowances at such rates as the Minister may determine. The Director General and Deputy Directors General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a suitable person who has knowledge or experience in intellectual property or intellectual property related matters to be the Director General; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such number of persons as may be necessary to be the Deputy Directors General, on such terms and conditions as the Minister may determine, for the proper administration of this Act and the Intellectual Property Legislation, and may revoke the appointment of any person so appointed without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall be responsible for the day-to-day administration of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Directors General shall be subject to the direction and control of the Director General and they may perform all the duties of the Director General under this Act and the Intellectual Property Legislation as may be specified by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In the event that the Director General is temporarily unable to perform his duties due to illness or any other cause, either of the Deputy Directors General may attend any meeting of the Corporation or any committee in his place. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall meet as often as may be necessary for the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Five members of the Corporation, one of whom is a member representing the Government, shall form the quorum of a meeting of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If on a question to be determined by the Corporation there is an equality of votes, the Chairman shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of the Chairman being absent or unable to act due to illness or any other cause, any member of the Corporation other than the Director General may be elected by the members present to preside over the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, in respect of each member of the Corporation who represents the Government, appoint an alternate member who may attend any meeting of the Corporation which the member is for any reason whatsoever unable to attend and the alternate member, when so attending, shall for all purposes be deemed to be a member of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, the Corporation shall determine its own procedure. The Corporation may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may invite any other person to attend any meeting or deliberation of the Corporation for the purpose of advising it on any matter under discussion, but any person so attending shall have no right to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited to any meeting or deliberation of the Corporation under subsection (1) may be paid such remuneration or allowance as the Minister may determine. Power of Minister to give directions and require information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, give to the Corporation such directions of a general character consistent with the provisions of this Act relating to the performance of the Corporation's functions and the Corporation shall give effect to such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall furnish the Minister with such returns, accounts and information with respect to the performance of any of its functions under this Act or the Intellectual Property Legislation as the Minister may, from time to time, require or direct. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation or any committee established under section 19 who has or acquires a direct or indirect interest by himself, a member of his family or his associate in relation to any matter under discussion by the Corporation or committee shall disclose to the Corporation or committee, as the case may be, the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Corporation or committee, as the case may be, in which the matter is discussed and, after the disclosure, the member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the meeting of the Corporation or committee, as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not take part in or be present during any discussion or decision of the Corporation or committee, as the case may be, when the matter is discussed or decided upon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Corporation or committee who fails to disclose his interest as provided under subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No act or proceeding of the Corporation or committee shall be invalidated on the ground that any member of the Corporation or committee has contravened the provisions of this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "\"a member of his family\", in relation to a member of the Corporation or a committee, includes —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his parent (including a parent of his spouse);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his child (including an adopted child or stepchild);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his brother or sister (including a brother or sister of his spouse); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a spouse of his child, brother or sister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "\"associate\", in relation to a member of the Corporation or a committee, means —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any person who is a nominee or an employee of such member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any firm of which such member or any nominee of his is a partner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a partner of such member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a trust under which such member or a member of his family is a beneficiary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_15__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any corporation, within the meaning of the Companies Act 1965 [Act 125], of which such member or any nominee of his or a member of his family is a director or has a controlling interest or shares to the total value of not less than thirty per cent of the total issued capital of the corporation. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation and every committee shall maintain minutes of all their meetings in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of meetings of the Corporation or a committee, if duly signed, shall, in any proceedings, be admissible as prima facie evidence of the facts stated in the minutes without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Corporation or a committee of which minutes have been made in accordance with subsection (1) and (2) shall be deemed to have been duly convened and held and all members at the meeting to have been duly qualified to act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of \"Intellectual Property Corporation of Malaysia\" is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may sue and be sued in its name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Corporation may, upon such terms as the Corporation deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase, take, hold and enjoy movable and immovable property of every description; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer, or otherwise dispose of, or deal with any movable or immovable property or any interest in such property vested in the Corporation. Vesting provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Minister may, from time to time, by order published in the Gazette, appoint a vesting date and on such date all properties of the Government of Malaysia and all the rights or liabilities of the Government of Malaysia, the Registrar or the Controller specified by the Minister in such order shall, by virtue of this Act, be transferred to and vested in the Corporation without any conveyance, assignment or transfer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every property vested by virtue of subsection (1) in the Corporation shall be so vested in the Corporation for the like title, estate or interest and on the like tenure as the property was vested or held immediately before the vesting date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every chose-in-action vested by virtue of subsection (1) in the Corporation may, on and after the vesting date, be sued on, recovered or enforced by the Corporation in its own name and it shall not be necessary for the Corporation, the Government of Malaysia, the Registrar or the Controller to give notice to the person bound by the chose-in-action of the vesting effected under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every right or liability vested by virtue of subsection (1) in the Corporation may, on and after the vesting date, be sued on, recovered or enforced by or against the Corporation in its own name and it shall not be necessary for the Corporation, the Government of Malaysia, the Registrar or the Controller to give notice to the person whose right or liability is affected by the vesting effected under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any pending legal proceedings by or against the Government of Malaysia, the Registrar or the Controller which relate to any property, right or liability transferred to and vested in the Corporation by virtue of subsection (1) may, on and after the vesting date, be continued by or against the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of rights or liabilities arising under any loans which is vested in the Corporation on the vesting date, the Corporation may enter into such arrangements or agreements over such rights and liabilities with the Government of Malaysia or any third party,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "On and after the vesting date, any agreement relating to any property, rights and liabilities transferred to and vested in the Corporation under subsection (1) to which the Government of Malaysia, the Registrar or the Controller was a party immediately before the vesting date, whether in writing or not, and whether or not of such a nature that rights and liabilities thereunder could be assigned by the Government of Malaysia, the Registrar or the Controller shall have effect as if the Corporation has been a party to the agreement. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Corporation shall bear such device as the Corporation may approve and such seal may, from time to time, be broken, changed, altered or made anew as the Corporation thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Corporation, a stamp bearing the words \"The Intellectual Property Corporation of Malaysia\" may be used and shall be deemed to be the common seal of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Chairman or any other person authorized by the Corporation and shall be authenticated by either the Chairman or by such authorized person or by any officer authorized by the Chairman in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purporting to be sealed with the common seal and authenticated in accordance with subsection (3) shall, until the contrary is proved, be deemed to have been validly executed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), any document or instrument which, if executed by a person who is not a body corporate, is not required to be under seal may in like manner be executed by the Corporation; and any such document or instrument may be executed on behalf of the Corporation by any member, employee or agent of the Corporation generally or specially authorized by the Corporation in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Corporation shall be officially and judicially noticed. Membership of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "four members representing the Government, one of whom shall be the Secretary-General of the Ministry for the time being charged with the responsibility for intellectual property or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "three other members who have relevant knowledge or experience in intellectual property and intellectual property related matters; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint the members specified under paragraphs (1)(a), (b) and (c). Terms of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such conditions as may be specified in his instrument of appointment, a member of the Corporation shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for a term not exceeding three years and may be eligible for reappointment. Resignation and revocation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation, may, at any time, resign his office by giving notice in writing to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member of the Corporation appointed by the Minister, except the Secretary-General of the Ministry for the time being charged with the responsibility for intellectual property, may, at any time, be revoked by the Minister without assigning any reason for the revocation. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Corporation shall be vacated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "if he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "if he has been convicted of any offence and sentenced to imprisonment for a term not less than two months;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "if he is of unsound mind or is otherwise incapable of performing his duties; or Intellectual Property Corporation of Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "if he absents himself from three consecutive meetings of the Corporation without the leave of the Chairman, or in the case of the Chairman, without the leave of the Minister. Remuneration and allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROVISIONS RELATING TO EMPLOYEES Employment of Government employees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall, on the appointed date, accept into its employment every person who immediately before that date is in the employment or service of the Intellectual Property Division, Ministry of Domestic Trade and Consumer Affairs, Malaysia and who was given an option by the Government of Malaysia and has opted to serve as an employee of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Every such person who opts under subsection (1) to serve as an employee of the Corporation shall be employed by the Corporation on terms and conditions of service not less favourable than the terms and conditions of service to which he was entitled to immediately before the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Until such time as the terms and conditions of service of its employees are drawn up by the Corporation, the scheme and terms and conditions of service of employees of the Government shall continue to apply to every person employed by the Corporation under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may by order make such modifications as may be necessary to the scheme and terms and conditions referred to in subsection (3) for the purpose of removing any difficulties as a consequence of the provisions of that subsection. Salaries, terms and conditions of service of Government employees to be taken into account"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The terms and conditions to be drawn up by the Corporation shall take into account the salaries and terms and conditions of service, including any accrued rights to leave, enjoyed by the persons while in the employment of the Government before opting into the service of the Corporation; and any such term and condition relating to the length of service with the Corporation shall provide for the recognition of service with the Government by the persons making the option as service with the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person in the service of the Corporation whose case does not fall within the scope of any pension or other schemes established under this section retires or dies whilst in the service of the Corporation or is discharged from such service, the Corporation may grant to him or to such other person or persons wholly or partly dependent on him, as the Corporation thinks fit, such allowance or gratuity as the Corporation may determine. Appointment of other employees, agents and consultants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such regulations as may be made under section 24, the Corporation may, from time to time, appoint and employ on such terms and conditions as the Corporation may think fit such other employees as may be necessary for the proper administration of this Act and the Intellectual Property Legislation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may appoint and employ consultants and agents to transact any business or to do any act required to be transacted or done in the execution of its functions or for the better carrying into effect the purposes of this Act. Regulations with respect to employment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, from time to time, make regulations with respect to the employment of employees of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section may include provisions for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the manner of appointment, and the terms and conditions of service of the employees of the Corporation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of gratuities, pensions and other benefits to the employees of the Corporation. Continuation and completion of disciplinary proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where on the appointed date any disciplinary proceedings is pending or existing against any employee of the Government who has opted into the service of the Corporation, such proceedings shall be continued and completed by the Corporation, and the law applicable to such employee immediately before the appointed date in relation to such proceedings shall apply to the proceedings continued and completed under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "An order, ruling or direction made or given by a disciplinary authority of the Corporation pursuant to this section shall in respect of such employee have the same force or effect as an order, ruling or direction made or given by the Disciplinary Authority, Disciplinary Board or Disciplinary Appeal Board, as the case may be, under the laws referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may by order make such modifications to the laws referred to in subsection (1) in their application to such employee as may be necessary for the purpose of removing difficulties as a consequence of the provisions of that subsection. Protection from personal liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No suit or other legal proceedings shall lie personally against any member or employee of the Corporation or any other person under the direction of the Corporation for anything which is done or intended to be done in good faith in the execution or purported execution of this Act or any of the Intellectual Property Legislation. Public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "All members of the Corporation and its committees and all employees and agents of Corporation while discharging their duties as such members, employees or agents shall be deemed to be public servants within the meaning of the Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Corporation or against any employee or agent of the Corporation in respect of any act, neglect or default done or committed by him in such capacity or in the capacity of those officers described in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Intellectual Property Corporation of Malaysia Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister, by notification in the Gazette, and the Minister may appoint different dates for different provisions of this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"this Act\" includes any subsidiary legislation made under this Act; \"prescribed\", where no manner of prescribing is provided, means prescribed from time to time by rules, regulations or orders published in the Gazette; \"rights\" means all rights, powers, privileges and immunities, whether actual, contingent or prospective; \"committee\" means any committee established under section 19; \"Director General\" means the Director General of the Corporation appointed under section 11; \"Fund\" means the Fund established under section 29; \"liabilities\" means liabilities, debts, charges, duties and obligations of every description whether present or future, actual or contingent, and whether payable or to be observed or performed in Malaysia or elsewhere; \"Minister\" means the Minister for the time being responsible for intellectual property; \"Registrar\" means the Registrar of Trade Marks, the Registrar of Patents, the Registrar of Industrial Designs and the Registrar of Geographical Indications under the relevant Intellectual Property Legislation; \"Controller\" means the Controller of Copyright appointed under subsection 5(1) of the Copyright Act 1987 [Act 332]; \"Chairman\" means the Chairman appointed under section 6; \"Corporation\" means the Intellectual Property Corporation of Malaysia established under section 3; \"Intellectual Property Legislation\" means the legislation specified in the First Schedule; \"record\" includes record stored or recorded by means of a computer; \"vesting date\" means the date on which properties, rights and liabilities specified by the Minister in the order under subsection 4(1) to which the Government of Malaysia, the Registrar or Controller under the relevant Intellectual Property Legislations, was entitled or subject to, are transferred to and vested in the Corporation; Intellectual Property Corporation of Malaysia 7 \"appointed date\" means the date on which this Act comes into operation; \"vested\", in relation to property, includes having rights to property which are future or contingent and rights in reversion or remainder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE The Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for any offence under this Act shall be instituted except by or with the consent in writing of the Public Prosecutor. Proceedings conducted by officers of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "A legal officer as defined in the Government Proceedings Act 1956 [Act 359] or a legal officer of the Corporation who has been admitted as an advocate and solicitor under the Legal Profession Act 1976 [Act 166] may appear in any civil proceedings involving the Corporation or any person holding any of the offices specified in the Second Schedule in the performance of his functions under the Intellectual Property Legislation and may make and do all acts and applications in respect of such proceedings on behalf of the Corporation or such person, as the case may be. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this Act or for the purpose of any civil or criminal proceedings under any written law, no member, employee or agent of the Corporation, whether during his tenure of office or during his employment or after that, and no other person who has by any means access to any classified information or document relating to the affairs of the Corporation shall give or otherwise disclose such information or document to any person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Power of Minister to amend the First and Second Schedules"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the First and Second Schedules. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Corporation, make such regulations as may be expedient or necessary for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A Fund to be known as the \"Intellectual Property Fund\" to be administered and controlled by the Corporation is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys received by the Corporation for services rendered by the Corporation to the Government as its agent or for services rendered by the Corporation to any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys received by the Corporation by way of grants;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived from the disposal, lease or hire of, or any other dealings with, any property vested in or acquired by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived as income from investments by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys borrowed by the Corporation under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys lawfully received by the Corporation. Expenditure to be charged on the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Fund shall be expended for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Corporation, including legal fees and costs and other fees and costs, and the remuneration of employees of the Corporation, including the granting of loans, superannuation allowances, pensions or gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs or expenditure properly incurred or accepted by the Corporation in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and materials, acquiring land and erecting buildings, and carrying out any other works and undertakings in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under this Act and the interest due on such moneys; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Corporation up to such amount as may be authorized by the Corporation for any one financial year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Before the beginning of each financial year, an estimate of the expenditure for the following financial year in such form and containing such particulars as the Minister may direct shall be submitted by the Corporation to the Minister for his approval, and the Minister shall, before the beginning of that following financial year, notify the Corporation of the amount authorized for expenditure generally or of the amounts authorized for each description of expenditure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, at any time, submit to the Minister a supplementary estimate for any one financial year and the Minister may allow the whole or any part of the additional expenditure included in the supplementary estimate. Conservation of the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Corporation to conserve the Fund by so performing, exercising and discharging its functions, powers and duties under this Act as to secure that the total revenues of the Corporation are sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest in capital, taking one year with another. Statutory Bodies (Accounts and Annual Reports) Act 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240] shall apply to the Corporation. Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, from time to time, with the prior approval of the Minister and the Minister of Finance, borrow, at such rate of interest and for such period and upon such terms as to the time and method of repayment and otherwise as the Minister and the Minister of Finance may approve, any sums required by the Corporation for meeting any of its obligations or performing any of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, from time to time, with the prior approval of the Minister and the Minister of Finance, borrow money by the issue of bonds, debenture, debenture stocks or such other securities upon such terms as it deems expedient for meeting any of its obligations or performing any of its functions under this Act. Investment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Funds of the Corporation may, in so far as they are not required to be expended by the Corporation under this Act, be invested in such manner as the Corporation deems fit after consultation with the Minister. Payment to the Federal Consolidated Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may on the instruction of the Government cause to be paid to the Federal Consolidated Fund an amount not exceeding thirty per cent of its current annual surplus after the third year of its operation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/34/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
