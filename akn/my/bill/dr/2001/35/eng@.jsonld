      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 4 Election Commission B. 7 Prime Minister's Department B. 26 Ministry of Education B. 29 Treasury General Services B. 33 Ministry of Works B. 48 Ministry of Rural Development TOTAL"
      }
    }
