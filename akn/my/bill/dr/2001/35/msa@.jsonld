      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan Tambahan (2001) (No.2) 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2001) (No. 2) 2001. Perbelanjaan tambahan bagi tahun 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi satu bilion lima ratus tiga puluh tujuh juta lapan ratus ribu ringgit (RM1,537,800,000) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi perkhidmatan tahun 2001 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2001 [Akta A1092], Akta Perbekalan Tambahan (2000 dan 2001) 2001 [Akta A1100] dan Akta Perbekalan Tambahan (2001) 2001 [Akta A1115]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 4 Suruhanjaya Pilihan Raya B. 7 Jabatan Perdana Menteri B. 26 Kementerian Pendidikan B. 29 Perkhidmatan Am Perbendaharaan B. 33 Kementerian Kerja Raya B. 48 Kementerian Pembangunan Luar Bandar JUMLAH"
      }
    }
