      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting before section 5 the following heading: \"PART II LICENSING HOUSING DEVELOPERS\". Amendment of section 5"
      }
    }
