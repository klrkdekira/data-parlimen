      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan 2002"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/37/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/37/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2002. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2002"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/37/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/37/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi empat puluh sembilan bilion sembilan ratus lapan juta tujuh ratus tujuh puluh dua ribu lima ratus dua puluh ringgit (RM49,908,772,520) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2002 adalah dengan ini dibenarkan, dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/37/msa@/~sched_1",
