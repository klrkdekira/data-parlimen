        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 4, 5, 7, paragraphs 8(a), 8( b ), 8(d), 8(e), 8(f), 8( g ), 8(h), 8(i), 8(j), 8(l), and 8(m), section 9 and paragraphs 10(a), 1 0( b) and l0(c) of this Chapter shall have effect for the year of assessment 2002 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 8(c) of this Chapter shall be deemed to have come into operation on 1 January 2000 and shall have effect for the year of assessment 2000 in respect of basis period ending in the year 2000 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 37F of Schedule 3 to the Income Tax Act 1967, which in this Chapter is referred to as the \"principal Act\", as inserted by paragraph 8(k) of this Chapter shall have effect for the year of assessment 2002 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 37G and 37H of Schedule 3 to the principal Act as inserted by paragraph 8( k) of this Chapter shall be deemed to have effect for the year of assessment 2001 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/39/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 1 0( d) shall be deemed to have effect for the year of assessment 1998 and subsequent years of assessment. Amendment of section 34"
      }
    },
