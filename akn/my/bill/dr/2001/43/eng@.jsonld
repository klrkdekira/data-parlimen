      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Islamic Banking (Amendment) Act 2001. (2) This Act shall come into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/43/eng@/~cl_2",
