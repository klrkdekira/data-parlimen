      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bank dan Institusi-Institusi Kewangan (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/44/msa@/~cl_1__subsec_2",
