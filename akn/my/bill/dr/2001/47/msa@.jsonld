      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II__cl_19__para_b__subpara_i",
