      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 106(3) Akta ibu dipinda dengan menggantikan perkataan \"103(4), 103(5), 103(5A), 103A(4), 103A(5), 103A(6), 103A(7), 103A(8) or 103A(9)\" dengan perkataan \"103(3), (4), (5), (6), (7) or (8)\". Pindaan seksyen 107B"
      }
    },
    {
