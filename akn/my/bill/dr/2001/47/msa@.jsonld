      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"21(3)\" perkataan \"or 2lA(3)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II__cl_25__para_b__subpara_ii",
