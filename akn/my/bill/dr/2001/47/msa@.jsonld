      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 107B Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Subject to this section, every person chargeable to tax for a year of assessment, other than a company, trust body or co-operative society to which section 107c applies shall make payment by instalments on account of tax, excluding tax in respect of gains or profits from an employment, which is or may be payable by that person for that year of assessment, at such times and in such amounts as the Director General may direct, whether or not the tax has been assessed.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/47/msa@/~part_II__cl_19__para_b",
      "@type": "akn:paragraph",
