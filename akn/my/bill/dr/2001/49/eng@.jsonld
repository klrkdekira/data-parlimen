      ],
      "schema:name": {
        "@language": "en",
        "@value": "Education (Amendment) Bill 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Education (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Education Act 1996 [Act 550], which in this Act is referred to as the \"principal Act\", is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"pre-school curriculum\" the following definition: ' \"pre-school curriculum\" means the National Pre- school Curriculum prescribed by the Minister under section 22;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Chinese language\" the following definition: ' \"compulsory education\" means primary education which is prescribed to be compulsory education under subsection 29 A(1);'. Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 5(3) of the principal Act is amended by inserting after the words \"each State\" the words \"and for such area within Malaysia as may be determined by the Minister\". Amendment of section 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 15 of the principal Act is amended by inserting after the words \"expatriate schools\" the words \"or international schools\". Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 22 the following section: National 22. (1) The Minister shall prescribe a curriculum, to be Pre-school known as the National Pre-school Curriculum, that shall Curriculum to be used be used by all kindergartens in the National Education by all System. kinder- gartens. (2) The National Pre-school Curriculum prescribed under subsection (1) shall specify the knowledge, skills and values that are expected to be acquired by the pupils at the end of their respective period of pre-school education."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any kindergarten intending to implement any curriculum in addition to the National Pre-school Curriculum shall, before implementing such additional curriculum, inform the Registrar General of such intention in such manner as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) or (3) shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding one year or to both.\". Amendment of section 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 29 of the principal Act is amended by substituting for the words \"national or national-type school\" the words \"national school, national-type school or private school\". New section 29A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/49/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 29 the following section: \"compulsory 29A. (1) The Minister may, by order published in the education. Gazette, prescribe primary education to be compulsory education. (2) Every parent who is a Malaysian citizen residing in Malaysia shall ensure that if his child has attained the age of six years on the first day of January of the current school year that child is enrolled as a pupil in a primary school in that year and remains a pupil in a primary school for the duration of the compulsory education. (3) The Minister may, if he considers it desirable and in the interest of the pupils or the public to do so, by order published in the Gazette, exempt any pupil or any class of pupils from the requirement to attend compulsory education, either absolutely or subject to such conditions as he may think fit to impose, and may at any time in his discretion revoke the exemption or revoke or alter or add to such conditions. (4) A parent who contravenes subsection (2) shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding six months or to both. (5) The Minister may make regulations for the carrying into effect of the provisions of this section.\"."
      }
    }
  ]
}
