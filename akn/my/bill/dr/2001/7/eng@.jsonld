        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (1)(b), by deleting the words \"of Kuala Lumpur and Labuan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by inserting after the word \"payment\" the words \"of the whole or any part\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the words \"five hundred\" the words \"two thousand\". Amendment of section 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 18 of the principal Act is amended by substituting for the words \"one thousand\" the words \"three thousand\". Amendment of section 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_7",
      "@type": "akn:clause",
