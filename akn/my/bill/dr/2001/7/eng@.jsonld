      ],
      "schema:name": {
        "@language": "en",
        "@value": "Entertainments Duty (Amendment) Bill 2001"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
