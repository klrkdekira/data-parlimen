        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Entertainments Duty (Amendment) Act 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 October 2001. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Entertainments Duty Act 1953 [Act 103], which is referred to as the \"principal Act\" in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the section as subsection (1) of that section;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_b__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"admission\" the following definition: ' \"admission\" means admission as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a spectator;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "one of an audience; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a user of an entertainment facility;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"admission to an entertainment\" the following definition: ' \"admission to an entertainment\" includes admission to any place in which an entertainment is held or any other place from which a person would be able to be a spectator or one of the audience of an entertainment, and also includes being given the right to use an entertainment facility;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of \"entertainment\" the following definition: ' \"entertainment\" includes any exhibition, performance, amusement, game or sport, or any other activity as may be declared to be entertainment by the Minister of Finance under subsection (2), to which persons are admitted for payment;'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_3__para_c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: \"(2) The Minister of Finance may, from time to time, by order published in the Gazette, declare any activity to which a person is admitted for payment to be an entertainment.\". Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 3(2) of the principal Act is amended by substituting for the words \"Yang di-Pertuan Agong\" the words \"Minister of Finance\". Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended by substituting for the word \"twenty\" the word \"thirty\". Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
