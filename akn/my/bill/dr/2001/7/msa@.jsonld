      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 20 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
