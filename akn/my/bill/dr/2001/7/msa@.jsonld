      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Duti Hiburan (Pindaan) 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Oktober 2001. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Duti Hiburan 1953 [Akta 103], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen itu sebagai subseksyen (1) seksyen itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_b__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"admission\" dengan takrif yang berikut: ' \"admission\" means admission as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "a spectator;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "one of an audience; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "a user of an entertainment facility;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"admission to an entertainment\" dengan takrif yang berikut: ' \"admission to an entertainment\" includes admission to any place in which an entertainment is held or any other place from which a person would be able to be a spectator or one of the audience of an entertainment, and also includes being given the right to use an entertainment facility;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"entertainment\" dengan takrif yang berikut: ' \"entertainment\" includes any exhibition, performance, amusement, game or sport, or any other activity as may be declared to be entertainment by the Minister of Finance under subsection (2), to which persons are admitted for payment;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_3__para_c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_2__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(2) The Minister of Finance may, from time to time, by order published in the Gazette, declare any activity to which a person is admitted for payment to be an entertainment.\". Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 3(2) Akta ibu dipinda dengan menggantikan perkataan \"Yang di-Pertuan Agong\" dengan perkataan \"Minister of Finance\". Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda dengan menggantikan perkataan \"twenty\" dengan perkataan \"thirty\". Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 12 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1 )(b), dengan memotong perkataan \"of Kuala Lumpur and Labuan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan \"payment\" perkataan \"of the whole or any part\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"five hundred\" dengan perkataan \"two thousand\". Pindaan seksyen 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 18 Akta ibu dipinda dengan menggantikan perkataan \"one thousand\" dengan perkataan \"three thousand\". Pindaan seksyen 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7",
