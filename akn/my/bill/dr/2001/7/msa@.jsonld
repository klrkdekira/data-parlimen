      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"two thousand\" dengan perkataan \"six thousand\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"five thousand\" dengan perkataan \"fifteen thousand\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2001/7/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
