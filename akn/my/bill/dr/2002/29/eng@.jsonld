      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 7 Prime Minister's Department B. 19 Ministry of Agriculture B. 21 Ministry of Domestic Trade and Consumer Affairs B. 28 Treasury B. 30 Contribution to Statutory Funds B. 35 Ministry of Home Affairs B. 38 Ministry of Transport B. 42 Ministry of National Unity and Social Development TOTAL"
