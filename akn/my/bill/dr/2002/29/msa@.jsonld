      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (2002)(No. 2) 2002"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2002) (No. 2) 2002. Perbelanjaan tambahan bagi tahun 2002"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi tiga ratus lima belas juta lapan ratus tiga ribu lapan ratus tiga puluh ringgit (RM315,803,830) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi perkhidmatan tahun 2002 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2002 [Akta A1135], Akta Perbekalan Tambahan (2001 dan 2002) 2002 [Akta A1147] dan Akta Perbekalan Tambahan (2002) 2002 [Akta A1156]. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/29/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 7 Jabatan Perdana Menteri B. 19 Kementerian Pertanian B. 21 Kementerian Perdagangan Dalam Negeri dan Hal Ehwal Pengguna B. 28 Perbendaharaan B. 30 Peruntukan kepada Kumpulan Wang Terkanun B. 35 Kementerian Dalam Negeri B. 38 Kementerian Pengangkutan B. 42 Kementerian Perpaduan Negara dan Pembangunan Masyarakat JUMLAH"
      }
    }
  ]
