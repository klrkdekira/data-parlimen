      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"be incurred\" the words \"during the campaign period,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2002/7/eng@/~cl_13__para_b__subpara_ii",
