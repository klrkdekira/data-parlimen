      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Mahkamah Kehakiman (Pindaan) 2004"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Mahkamah Kehakiman (Pindaan) 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Mahkamah Kehakiman 1964 [Akta 91], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam perenggan 22(l)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Chapter VI\" dengan perkataan \"Chapters VI and VIA\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"or\" di hujung subperenggan (ii);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung subperenggan (iii) dengan koma bernoktah; dan 2 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (iii) subperenggan yang berikut: \"(iv) by any person against a citizen of Malaysia; (v) by any person against property belonging to the Government of Malaysia or the Government of any State in Malaysia located outside Malaysia, including diplomatic or consular premises of Malaysia; (vi) by any person to compel the Government of Malaysia or the Government of any State in Malaysia to do or refrain from doing any act; (vii) by any stateless person who has his habitual residence in Malaysia; (viii) by any person against or on board a fixed platform while it is located on the continental shelf of Malaysia; or (ix) by any person who after the commission of the offence is present in Malaysia.\". Pindaan seksyen 50"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 50(3) Akta ibu dipinda dengan menggantikan perkataan \"given by, or with the consent in writing of, that officer only\" dengan perkataan \"signed by the Public Prosecutor, the Solicitor General or any other officer authorized by the Public Prosecutor\". Pindaan seksyen 87"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 87 Akta ibu dipinda dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: \"(2) Notice of any appeal by the Public Prosecutor shall be signed by the Public Prosecutor, the Solicitor General or any officer authorized by the Public Prosecutor.\". Mahkamah Kehakiman (Pindaan) 3"
      }
    }
  ]
}
