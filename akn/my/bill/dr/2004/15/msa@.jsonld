    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kanun Keseksaan (Pindaan) 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Seksyen baru 377CA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun Keseksaan [Akta 574], dipinda dengan memasukkan selepas seksyen 377c seksyen yang berikut: \"Sexual connection by object 377CA. Any person who has sexual connection with another person by the introduction of any object into the vagina or anus of the other person shall be punished with imprisonment for a term which may extend to twenty years and shall also be liable to whipping.\"."
      }
    }
  ]
