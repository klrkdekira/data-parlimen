        "@value": "by substituting for the words \"Chapter VI\" the words \"Chapters VI and VIA\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_10__para_b",
