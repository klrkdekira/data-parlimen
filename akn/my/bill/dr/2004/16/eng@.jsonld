      "schema:name": {
        "@language": "en",
        "@value": "The First Schedule to the Code is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in the items relating to sections 121, 121A, 121B, 121C, 121D, 122, 123, 124, 125, 125A, 126, 127, 128, 129 and 130 of the Penal Code, in column 3, by substituting for the words \"Shall not arrest without warrant\" the words \"May arrest without warrant\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20",
      "schema:text": {
