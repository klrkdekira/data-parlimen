      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 289fcJ of the Code is amended by inserting after the word \"age\" the words \", except males sentenced to whipping under section 376, 377c or 377E of the Penal Code\". Amendment of section 291"
      }
    },
