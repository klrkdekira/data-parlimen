        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/eng@/~cl_20__para_f"
      ],
