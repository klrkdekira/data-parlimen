      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 127A(1) Kanun dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Chapter VI\" dengan perkataan \"Chapters VI and VIA\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"or\" di hujung perenggan (b)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan koma di hujung perenggan (c) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: \"(d) by any person against a citizen of Malaysia; (e) by any person against property belonging to the Government of Malaysia or the Government of any State in Malaysia located outside Malaysia, including diplomatic or consular premises of Malaysia; (f) by any person to compel the Government of Malaysia or the Government of any State in Malaysia to do or refrain from doing any act; (g) by any stateless person who has his habitual residence in Malaysia; (h) by any person against or on board a fixed platform while it is located on the continental shelf of Malaysia; or (i) by any person who after the commission of the offence is present in Malaysia,\". Pindaan seksyen 173"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 173 Kanun dipinda dengan memasukkan selepas perenggan (h) perenggan yang berikut: \"(ha) (i) When the Court calls upon the accused to enter on his defence under subparagraph (h)(i), the Court shall read and explain the three options for the defence to the accused which are as follows: (A) to give sworn evidence in the witness box; (B) to give unsworn evidence from the dock; or (C) to remain silent. (ii) If the accused elects to give unsworn evidence or to remain silent, he shall not be cross-examined by the prosecution: Provided that where the accused elects to give unsworn evidence from the dock and his defence relates to his cautioned statement which forms part of the prosecution's evidence, he may be cross-examined by the prosecution.\". Pindaan seksyen 256"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 256 Kanun dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5) dan (6), dengan menggantikan perkataan \"a prisoner\" dengan perkataan \"an accused\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan menggantikan perkataan \"prisoner\" dengan perkataan \"accused\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (8) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"in English\" dengan perkataan \"in the national language\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_12__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"English\" dengan perkataan \"national\". Seksyen baru 272B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab XXV Kanun dipinda dengan memasukkan selepas seksyen 272A seksyen yang berikut: \"Evidence through live video or live television links 272B. (1) Notwithstanding any other provision of this Code or the Evidence Act 1950, a person, other than the accused, may, with leave of the court, give video or live evidence through a live video or live television link in any trial or inquiry, if it is expedient in the interest of justice to do so. (2) Subsection (1) shall apply in relation to the following offences: (a) an offence which involves an assault on, or an injury or a threat of injury, to persons including but not limited to sections 319 to 338 of the Penal Code; (b) an offence under sections 354 to 358 and sections 376, 376B, 377, 377B, 377C, 377D and 377E of the Penal Code; and (c) such other offences as the Minister may, after consulting the Chief Justice and the Public Prosecutor, prescribe. (3) The Court may, in the exercise of its power under subsection (1), make an order on any or all of the following matters: (a) the persons who may be present at the place where the witness is giving evidence; (b) that a person be excluded from the place while the witness is giving evidence; (c) the persons in the courtroom who must be able to be heard, or seen and heard, by the witness, and by the persons with the witness; (d) the persons in the courtroom who must not be able to be heard, or seen and heard, by the witness and by the persons with the witness; (e) the persons in the courtroom who must be able to see and hear the witness and the persons with the witness; (f) the stages in the proceedings during which a specified part of the order is to have effect; (g) the method of operation of the live video or live television link system including compliance with such minimum technical standards as may be determined by the Chief Justice; and (h) any other order the court considers necessary in the interest of justice. (4) The Court shall not give leave under subsection (1) or make an order under subsection (3) if, in the opinion of the Court, to do so would be inconsistent with the court's duty to ensure that the proceedings are conducted fairly to the parties to the proceedings. (5) Evidence given by a witness through live video or live television link by virtue of this section shall be deemed for the purposes of sections 193, 194, 195, 196, 205 and 209 of the Penal Code as having been given in the proceedings in which it is given. (6) Where a witness gives evidence in accordance with this section, he shall for the purposes of this Code and the Evidence Act 1950 be deemed to be giving evidence in the presence of the Court, the accused person or his advocate, as the case may be. (7) Where any video or live evidence given under this section is recorded on any medium, electronic or otherwise, such recording shall form part of the record.\". Pindaan seksyen 289"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 289(c) Kanun dipinda dengan memasukkan selepas perkataan \"age\" perkataan \", except males sentenced to whipping under section 376, 377c or 377E of the Penal Code\". Pindaan seksyen 291"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 291(1) Kanun dipinda dengan menggantikan perkataan \"twelve\" dengan perkataan \"twenty-four\". Pindaan seksyen 293"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 293 Kanun dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"Juvenile Courts Act. 1947 [Act 90]\" dengan perkataan \"Child Act 2001 [Act 611]\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"Juvenile Courts Act 1947\" dengan perkataan \"Child Act 2001\". Pindaan seksyen 294"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 294(1) Kanun dipinda dengan menggantikan perkataan \"not being a youthful offender has been convicted of any offence punishable with imprisonment\" dengan perkataan \"has been convicted of any offence\". Pindaan seksyen 295"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 295 Kanun dipinda dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) When a person is convicted of an offence under section 376, 377c or 377E of the Penal Code before any Court, the Court shall direct that he be subject to the supervision of the police for a period of not less than one year and not more than three years commencing immediately after the expiration of the sentence passed on him.\". Pindaan seksyen 307"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 307 Kanun dipinda dalam subseksyen (1) dan (4) dan perenggan (5)(b) dengan menggantikan perkataan \"ten\" dengan perkataan \"fourteen\". Pindaan Jadual Pertama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh-tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan dalam Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun Tatacara Jenayah [Akta 593], yang disebut \"Kanun\" dalam Akta ini, dipinda dalam subseksyen 2(1) dengan menggantikan takrif \"youthful offender\" dengan takrif yang berikut: ' \"youthful offender\" means a person convicted of an offence punishable by fine or imprisonment who is of or above the age of eighteen and below the age of 21;'. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Pertama kepada Kanun dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_20__para_a",
