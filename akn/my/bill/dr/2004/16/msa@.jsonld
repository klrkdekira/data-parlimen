      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Kanun Tatacara Jenayah (Pindaan) 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/16/msa@/~cl_10",
      "@type": "akn:clause",
