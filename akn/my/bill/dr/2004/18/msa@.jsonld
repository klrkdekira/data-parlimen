      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Perbekalan 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2005. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi enam puluh lapan bilion enam ratus tujuh puluh enam juta dua ratus lapan puluh satu ribu ringgit (RM68,676,281,000) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2005 adalah dengan ini dibenarkan, dan jumlah wang itu diperuntukkan bagi maksud- maksud yang dinyatakan dalam Jadual. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Amaun Maksud Tajuk (RM) B. 1 Parlimen 54,590,800 B. 2 Pejabat Penyimpan Mohor Besar Raja-Raja 1,457,300 B. 3 Jabatan Audit 70,264,900 B. 4 Suruhanjaya Pilihan Raya 27,650,000 B. 5 Suruhanjaya Perkhidmatan Awam 32,218,000 B. 6 Jabatan Perdana Menteri 1,922,091,000 B. 7 Jabatan Perkhidmatan Awam 1,067,628,200 B. 8 Jabatan Peguam Negara 73,469,700 B. 9 Badan Pencegah Rasuah 76,414,000 B. 10 Perbendaharaan 1,788,714,700 B. 11 Perkhidmatan Am Perbendaharaan 9,806,603,600 B. 12 Peruntukan kepada Kumpulan Wang 2,469,000,300 Terkanun B. 13 Kementerian Luar Negeri 431,064,700 B. 20 Kementerian Perusahaan Perladangan dan 118,749,900 Komoditi B. 21 Kementerian Pertanian dan Industri Asas 1,469,228,200 Tani B. 22 Kementerian Kemajuan Luar Bandar dan 576,866,500 Wilayah B. 23 Kementerian Sumber Asli dan Alam Sekitar 613,130,600 B. 24 Kementerian Perdagangan Antarabangsa dan 272,027,900 Industri B. 25 Kementerian Perdagangan Dalam Negeri dan 213,761,800 Hal Ehwal Pengguna B. 26 Kementerian Pembangunan Usahawan dan 1,303,546,600 Koperasi B. 27 Kementerian Kerja Raya 1,338,169,000 B. 28 Kementerian Pengangkutan 746,169,600 B. 29 Kementerian Tenaga, Air dan Komunikasi 68,299,000 B. 30 Kementerian Sains. Teknologi dan Inovasi 349,078,900 B. 31 Kementerian Pelancongan 514,193,000 B. 32 Kementerian Wilayah Persekutuan 71,354,100 B. 40 Suruhanjaya Perkhidmatan Pendidikan 8,264,200 B. 41 Kementerian Pelajaran 16,321,292,000 Maksud Tajuk B. 42 Kementerian Kesihatan 6,778,264,700 B. 43 Kementerian Perumahan dan Kerajaan 800,617,900 Tempatan B. 44 Kementerian Kebudayaan, Kesenian dan 234,923,200 Warisan B. 45 Kementerian Belia dan Sukan 247,727,500 B. 46 Kementerian Sumber Manusia 365,681,300 B. 47 Kementerian Penerangan 865,649,300 B. 48 Kementerian Pembangunan Wanita, 407,815,200 Keluarga dan Masyarakat B. 49 Kementerian Pengajian Tinggi 5,247,115,000 B. 60 Kementerian Pertahanan 7,069,815,000 B. 61 Kementerian Hal Ehwal Dalam Negeri 937,044,600 B. 62 Kementerian Kesela