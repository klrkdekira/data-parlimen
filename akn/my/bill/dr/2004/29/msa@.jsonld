    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Pelabuhan Pulau Pinang (Pindaan) 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Seksyen baru 59c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/29/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Suruhanjaya Pelabuhan Pulau Pinang 1955 [Akta 140] dipinda dengan memasukkan selepas seksyen 59B seksyen yang berikut: \"Powers of the Commission to carry on activities which are commercial in nature 59c. The Commission may with the approval of the Minister, carry on all activities, particularly activities which are commercial in nature, as may appear to the Commission to be requisite, advantageous, convenient or beneficial.\". 2 Rang Undang-Undang"
      }
    }
  ]
