      ],
      "schema:name": {
        "@language": "en",
        "@value": "Constitution (Amendment) Bill 2004"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette and the Yang di-Pertuan Agong may appoint different dates for the coming into operation of different provisions of this Act. Amendment of Article 122"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in Article 122 in the proviso to Clause (1A) by substituting for the words \"sixty-five years\" the words \"sixty-six years\". Amendment of Article 125"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 125 of the Federal Constitution is amended in Clause"
      },
      "schema:text": {
        "@language": "en",
        "@value": "(1) by substituting for the words \"sixty-five years\" the words \"sixty-six years\". Amendment of Ninth Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in the Ninth Schedule—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the State List (List II) in item 6, by substituting for paragraph (c) the following paragraph: \"(c) Subject to the Federal List, water (including rivers and canals but excluding water supplies and services); control of silt; riparian rights.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the Supplement to State List for States of Sabah and Sarawak (List IIA), by inserting after item 19 the following item: \"20. Subject to the Federal List, water supplies and services.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the Concurrent List (List III), by inserting after item 9c the following items: \"9D. Subject to the Federal List, water supplies and services. 9E. Preservation of heritage.\". Amendment of Tenth Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Tenth Schedule to the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in Part III—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in item 3, by inserting after the words \"connected with\" the words \"water supplies and services,\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for item 8 the following item: \"8. Receipts in respect of raw water.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in Part V, by inserting after item 8 the following items: \"9. Receipts in respect of water supplies and services, including water rates. 10. Revenue from licenses connected with water supplies and services.\"."
      }
    }
  ]
}
