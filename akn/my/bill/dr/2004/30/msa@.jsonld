      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Perlembagaan (Pindaan) 2004"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlembagaan (Pindaan) 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta dan Yang di-Pertuan Agong boleh menetapkan tarikh permulaan kuat kuasa yang berlainan bagi peruntukan yang berlainan dalam Akta ini. Pindaan Perkara 122"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perlembagaan Persekutuan dipinda dalam Perkara 122 dalam proviso kepada Fasal (1A) dengan menggantikan perkataan \"enam puluh lima tahun\" dengan perkataan \"enam puluh enam tahun\". Pindaan Perkara 125"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 125 Perlembagaan Persekutuan dipinda dalam Fasal (1) dengan menggantikan perkataan \"enam puluh lima tahun\" di mana-mana jua terdapat dengan perkataan \"enam puluh enam tahun\". Pindaan Jadual Kesembilan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perlembagaan Persekutuan dipinda dalam Jadual Kesembilan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Senarai Negeri (Senarai II) dalam butiran 6, dengan menggantikan perenggan (c) dengan perenggan yang berikut: \"(c) Tertakluk kepada Senarai Persekutuan, air (termasuk sungai dan terusan tetapi tidak termasuk bekalan dan perkhidmatan air); pengawalan kelodak; hak riparia.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Tambahan kepada Senarai Negeri bagi Negeri Sabah dan Sarawak (Senarai IIA), dengan memasukkan selepas butiran 19 butiran yang berikut: \"20. Tertakluk kepada Senarai Persekutuan, bekalan dan perkhidmatan air.\"; dan ,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Senarai Bersama (Senarai III), dengan memasukkan selepas butiran 9c butiran yang berikut: \"9D . Tertakluk kepada Senarai Persekutuan, bekalan dan perkhidmatan air. 9E. Pemeliharaan warisan\". Pindaan Jadual Kesepuluh"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Kesepuluh kepada Perlembagaan Persekutuan dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Bahagian III— \"8. Terimaan berkenaan dengan air mentah.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran 3, dengan memasukkan selepas perkataan \"yang berkaitan dengan\" perkataan \"bekalan dan perkhidmatan air,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan butiran 8 dengan butiran yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/30/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Bahagian V, dengan memasukkan selepas butiran 8 butiran yang berikut: \"9. Terimaan berkenaan dengan bekalan dan perkhidmatan air, termasuk kadar air. 10. Hasil daripada lesen yang berkaitan dengan bekalan dan perkhidmatan air.\"."
      }
    }
  ]
}
