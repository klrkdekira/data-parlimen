      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/4/msa@/~cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (e)(i)~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/4/msa@/~cl_4__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
