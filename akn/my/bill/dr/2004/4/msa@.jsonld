      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memotong perkataan \"atau kedua-duanya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2004/4/msa@/~cl_4__para_b__subpara_ii",
