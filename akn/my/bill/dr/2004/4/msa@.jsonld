      "schema:text": {
        "@language": "ms",
        "@value": "Akta Insurans Luar Pesisir 1990 [Akta 444], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam subseksyen 2(1) —"
      }
    },
    {
