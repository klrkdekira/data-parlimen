      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kawalan Pertukaran Wang (Pindaan) 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kawalan Pertukaran Wang (Pindaan) 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kawalan Pertukaran Wang 1953 [Akta 17], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 4—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Except with the permission of the Controller, no person, other than an authorized dealer, shall, in Malaysia— (a) buy or borrow any gold or foreign currency from; (b) sell or lend any gold or foreign currency to; or (c) do any act which involves, is in association with, or is preparatory to, buying or borrowing any gold or foreign currency from, or selling or lending any gold or foreign currency to, any person other than an authorized dealer.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Where a person buys or borrows any gold or foreign currency or does any act which involves, is in association with, or is preparatory to, buying or borrowing any gold or foreign currency in Malaysia, or being a person resident in the scheduled territories, does any act which involves, is in association with, or is preparatory to, the buying or borrowing of gold or foreign currency outside Malaysia, he shall comply with such conditions as to the use to which it may be put or the period for which it may be retained as may from time to time be notified to him by the Controller.\". Seksyen baru 4A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 4 seksyen yang berikut: \"Advertisements relating to dealings in gold and foreign currency 4A. (1) Except with the permission of the Controller, no person, other than an authorized dealer, shall issue or publish, or otherwise facilitate the issuance or publication by any person of, an advertisement containing — (a) an invitation or an offer to buy, borrow, sell or lend any gold or foreign currency; or (b) information which is intended or might reasonably be presumed to be intended to lead, directly or indirectly, to the buying, borrowing, selling or lending of any gold or foreign currency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "For the purposes of this section, \"advertisement\" means the disseminating or conveying of information, invitation or solicitation by any means or in any form, including by means o f -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "any newspaper, magazine, journal or other periodical;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "posters, notices or signboards;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "circulars, handbills, brochures, pamphlets, books or other documents;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "letters addressed to individuals or bodies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "photographs or cinematograph films; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sound broadcasting, television, computers or other electronic means.\". Seksyen baru 10A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian III Akta ibu dipinda dengan memasukkan selepas seksyen 10 seksyen yang berikut: \"Guarantees 10A. (1) Except with the permission of the Controller, no person resident in the scheduled territories shall give any guarantee or do any act which involves, is in association with, or is preparatory to the giving of any guarantee, indemnity or similar undertaking in respect of any debt, obligation or liability— (a) of a person resident in the scheduled territories and due or owing to a person resident outside the scheduled territories; or (b) of a person resident outside the scheduled territories. (2) Except with the permission of the Controller, no person resident in the scheduled territories shall obtain any guarantee or do any act which involves, is in association with, or is preparatory to the obtaining of a guarantee, indemnity or similar undertaking from a person resident outside the scheduled territories in respect of any debt, obligation or liability. (3) For the purpose of this section, the giving or obtaining of a guarantee shall include a renewal or extension of such guarantee. (4) In this section, the expression \"guarantee\" includes the pledging of any security issued or registered in Malaysia or any other property in Malaysia to secure the repayment of a debt, obligation or liability referred to in subsection (1) or (2).\". Pindaan Jadual Kelima"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Kelima kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Bahagian I—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 1(3), dengan memasukkan selepas perkataan \"in that capacity\" perkataan \"for the purpose of any pending proceedings\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 2(1), dengan memasukkan selepas perkataan \"authorizing\" perkataan \"any officer of Bank Negara Malaysia appointed under subsection 3(2) or\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 3(1), dengan menggantikan perkataan \"three\" dengan perkataan \"twelve\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Bahagian II —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan 7(2) subperenggan yang berikut: \"(2A) Notwithstanding subparagraph (2), any person who commits an offence under subsection 4(1) or (2) punishable under this Part shall, on conviction, be liable to a fine not exceeding one million ringgit or to imprisonment for a term not exceeding five years or to both and the court may order any currency, gold or any property involved in respect of the commission of the offence to be forfeited.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 7(4) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"(2)\" di mana-mana jua terdapat perkataan \"or (2A)\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"goods or property\" perkataan \", whichever is higher\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 8(1), dengan menggantikan perkataan \"one thousand ringgit\" dengan perkataan \"fifty per centum of the amount of the maximum fine to which that person would have been liable if he had been convicted of such offence\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 10 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"Attorney General or the Controller\" dengan perkataan \"Public Prosecutor\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/1/msa@/~cl_5__para_b__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam proviso kepada perenggan itu, dengan menggantikan perkataan \"Attorney General\" dengan perkataan \"Public Prosecutor\"."
      }
    }
  ]
}
