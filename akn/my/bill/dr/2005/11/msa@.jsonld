      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"Jika\" perkataan \"tanpa sebab-sebab yang boleh diterima oleh Ketua Pengarah,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/11/msa@/~cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/11/msa@/~cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"peraturan- peraturan yang dibuat di bawah seksyen ini\" perkataan \"dan gagal untuk meremedi pelanggaran atau kegagalan sedemikian dalam tempoh masa yang dinyatakan\". Pendaftaran Kapal Layar Antarabangsa Langkawi 15 (Pindaan) Pindaan seksyen 60"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/11/msa@/~cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/11/msa@/~cl_39__para_a",
