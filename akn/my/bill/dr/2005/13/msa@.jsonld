      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memotong perkataan \"atau\" di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan noktah di hujung perenggan itu dengan perkataan \"; atau\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: \"(d) perniagaan nasihat kewangan.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan di hujung subseksyen itu peruntukan yang berikut: \"Penasihat kewangan - Pemenjaraan selama dua tahun atau dua juta ringgit atau kedua-duanya. Penalti ingkar.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(3) Perenggan (l)(d) tidak terpakai bagi — (a) seseorang penanggung insurans berlesen atau broker insurans berlesen; (b) suatu institusi berlesen sebagaimana yang ditakrifkan di bawah Akta Bank dan Institusi- Institusi Kewangan 1989 [Akta 372]; (c) suatu bank Islam yang dilesenkan di bawah Akta Bank Islam 1983 [Akta 276]; (d) seseorang pengendali takaful atau broker takaful sebagaimana yang ditakrifkan di bawah Akta Takaful 1984 [Akta 312]; (e) seseorang ejen insurans atau ejen pengendali takaful; (f) suatu syarikat yang didaftarkan di bawah Akta Syarikat Amanah 1949 [Akta WO]; (g) seseorang peguam bela dan peguam cara atau akauntan yang menjalankan amalan yang menjalankan perniagaan itu semata-mata bersampingan dengan amalan profesionnya; (h) seseorang yang merupakan tuan punya suatu surat khabar dan pemegang sesuatu permit yang dikeluarkan di bawah Akta Mesin Cetak dan Penerbitan 1984 [Akta 301] yang- (i) setakat surat khabar itu diedarkan secara am kepada orang awam, ia diedarkan hanya kepada pelanggan dan pembeli surat khabar itu kerana nilai; (ii) nasihat itu diberi, atau analisis atau laporan itu dikeluarkan atau diisytiharkan hanya melalui surat khabar tersebut; (iii) orang itu tidak menerima komisen atau balasan lain bagi memberi nasihat itu, atau mengeluarkan atau mengisytiharkan analisis atau laporan itu; dan (iv) nasihat itu diberi, atau analisis atau laporan itu dikeluarkan atau diisytiharkan semata- mata bersampingan dengan perjalanan perniagaan orang itu sebagai tuan punya surat khabar; (i) seseorang yang memiliki, mengendalikan atau memberikan sesuatu perkhidmatan maklumat melalui perantaraan elektronik, penyiaran atau telekomunikasi yang— (i) perkhidmatan itu secara am boleh didapati oleh orang awam di Malaysia; (ii) nasihat itu diberi, atau analisis atau laporan itu dikeluarkan atau diisytiharkan hanya melalui perkhidmatan itu; (iii) orang itu tidak menerima komisen atau balasan lain bagi memberi nasihat itu, atau bagi mengeluarkan atau mengisytiharkan analisis atau laporan itu; dan (iv) nasihat itu diberi, atau analisis atau laporan itu dikeluarkan atau diisytiharkan semata- mata bersampingan dengan pemilikan orang itu, pengendalian atau pemberian perkhidmatan itu; atau (j) mana-mana orang lain yang Bank boleh tentukan.\". Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"atau ajuster\" dengan perkataan \", ajuster atau penasihat kewangan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"atau ajuster\" dengan perkataan \", ajuster atau penasihat kewangan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan di hujung seksyen itu peruntukan yang berikut: \"Penasihat kewangan - Pemenjaraan selama dua tahun atau dua juta ringgit atau kedua-duanya. Penalti ingkar.\". Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 11 dengan seksyen yang berikut: \"Penggunaan perkataan \"insurans\", \"asurans\", \"pengunderait\" atau \"penasihat kewangan\" 11. (1) Kecuali dengan kelulusan bertulis Bank terlebih dahulu— (a) tiada seorang pun selain pemegang lesen boleh menggunakan perkataan \"insurans\", \"asurans\" atau \"pengunderait\"; dan (b) tiada seorang pun yang tidak dilesenkan di bawah Akta ini untuk menjalankan perniagaan nasihat kewangan boleh menggunakan perkataan \"penasihat kewangan\", atau apa-apa terbitannya dalam mana-mana bahasa, atau apa- apa perkataan lain dalam mana-mana bahasa yang boleh ditafsirkan sebagai menunjukkan perjalanan mana-mana perniagaan berlesen dalam nama, perihalan atau hakmilik yang di bawahnya dia menjalankan perniagaan atau membuat apa- apa representasi yang bermaksud sedemikian dalam apa-apa kepala bil, kertas surat, notis atau iklan atau dengan apa-apa cara lain. Penalti: Lima ratus ribu ringgit. Penalti ingkar. (2) Subseksyen (1) tidak terpakai bagi— (a) seseorang yang menyertakan kepada namanya suatu kelayakan insurans yang diberikan kepadanya oleh suatu badan yang ditetapkan, jika kelayakan yang disertakan sedemikian diikuti dengan nama ringkas badan itu; (b) sesuatu persatuan pemegang lesen atau persatuan pekerja pemegang lesen; (c) seseorang ejen insurans yang didaftarkan dengan Persatuan Insurans Hayat Malaysia dan Persatuan Insurans Am Malaysia berhubung dengan penggunaan perkataan \"insurans\", \"asurans\" atau \"pengunderait\" dalam perenggan (l)(a); dan (d) orang yang disebut dalam perenggan 9(3)(a) hingga (d) berhubung dengan penggunaan perkataan \"penasihat kewangan\" dalam perenggan [l)(b)\". Pindaan seksyen 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 13(2) Akta ibu dipinda dengan menggantikan perkataan \"atau perniagaan pengajusteran\" dengan perkataan \", perniagaan pengajusteran atau perniagaan nasihat kewangan.\". Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 14(b) Akta ibu dipinda dengan menggantikan perkataan \"atau perniagaan pengajusteran\" dengan perkataan \", perniagaan pengajusteran atau perniagaan nasihat kewangan\". 7 Pindaan seksyen 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"dan ajuster\" dengan perkataan \", ajuster dan penasihat kewangan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"atau perniagaan pengajusteran\" dengan perkataan \", perniagaan pengajusteran atau perniagaan nasihat kewangan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"atau ajuster\" dengan perkataan \", ajuster atau penasihat kewangan\". Pindaan seksyen 18"
      }
    }
  ]
}
