      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 28 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_14__para_a",
