      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"atau pengurus\" dengan perkataan \", pengurus atau wakil penasihat kewangan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_19__para_b",
