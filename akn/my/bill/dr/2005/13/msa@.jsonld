    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Insurans (Pindaan) 2005. Pindaan tajuk panjang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 18(3) Akta ibu dipinda dengan menggantikan perkataan \"atau ajuster berlesen\" dengan perkataan \", ajuster berlesen atau penasihat kewangan berlesen\". Pindaan seksyen 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu dipinda dengan menggantikan perkataan \"atau ajuster berlesen\" dengan perkataan \", ajuster berlesen atau penasihat kewangan berlesen\". ■ Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/13/msa@/~cl_12",
      "@type": "akn:clause",
