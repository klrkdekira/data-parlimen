      ],
      "schema:name": {
        "@language": "en",
        "@value": "Syariah Court Evidence (Federal Territories)(Amendment) Bill 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Syariah Court Evidence (Federal Territories) (Amendment) Act 2005. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Syariah Court Evidence (Federal Territories) Act 1997 [Act 561], which is referred to as the \"principal Act\" in this Act, is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the English language text, by substituting for the words \"Islamic Law\" wherever they appear, except in the definition of \"Administration Act\" in subsection 3(1), the words \"Hukum Syarak\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the national language text, by substituting for the word \"prosedur\" wherever it appears the word \"tatacara\". Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 3( 1) of the principal Act is amended by substituting for the definition of \"Hukum Syarak\" the following definition: ' \"Hukum Syarak\" means Hukum Syarak according to the Mazhab Shafie, or according to any one of the Mazhab Maliki, Hanafi or Hanbali;'. Amendment of section 76"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 76 of the principal Act is amended in the English language text by deleting the word \"to\" appearing after the words \"evidence of any\". Amendment of section 83"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 83(1) of the principal Act is amended in the English language text by inserting a comma after the word \"'adil\". Amendment of section 97"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 97(2) of the principal Act is amended in the English language text by substituting for the word \"cross-examination\" the word \"cross-examining\". Amendment of section 130"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 130 of the principal Act is amended by substituting for subsection (2) the following subsection: \"(2) In the event of a lacuna or where any matter is not expressly provided for in this Act, the Court shall apply Hukum Syarak\"."
      }
    }
  ]
}
