        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_7"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Akta Keterangan Mahkamah Syariah (Wilayah-Wilayah Persekutuan) (Pindaan) 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Keterangan Mahkamah Syariah (Wilayah-Wilayah Persekutuan) (Pindaan) 2005. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Keterangan Mahkamah Syariah (Wilayah-Wilayah Persekutuan) 1997 [Akta 561], yang disebut \"Akta ibu\" dalam Akta ini, dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa Inggeris, dengan menggantikan perkataan \"Islamic Law\" di mana-mana jua terdapat, kecuali dalam takrif \"Administration Act\" dalam subseksyen 3(1), dengan perkataan \"Hukum Syarak\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan \"prosedur\" di mana-mana jua terdapat dengan perkataan \"tatacara\". Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 3(1) Akta ibu dipinda dengan menggantikan takrif \"Hukum Syarak\" dengan takrif yang berikut: 4 \"Hukum Syarak\" ertinya Hukum Syarak mengikut Mazhab Shafie, atau mengikut mana-mana satu Mazhab Maliki, Hanafi atau Hanbali;'. Pindaan seksyen 76"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 76 Akta ibu dipinda dalam teks bahasa Inggeris dengan memotong perkataan \"to\" yang terdapat selepas perkataan \"evidence of any\". Pindaan seksyen 83"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 83(1) Akta ibu dipinda dalam teks bahasa Inggeris dengan memasukkan koma selepas perkataan u'adil\". Pindaan seksyen 97"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 97(2) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"cross-examination\" dengan perkataan \"cross-examining\". Pindaan seksyen 130"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130 Akta ibu dipinda dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: \"(2) Jika terdapat lakuna atau jika apa-apa perkara tidak diperuntukkan dengan nyata dalam Akta ini, Mahkamah hendaklah memakai Hukum Syarak.\"."
      }
    }
  ]
}
