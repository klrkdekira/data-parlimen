      "schema:name": {
        "@language": "en",
        "@value": "Syariah Court Civil Procedure (Federal Territories)(Amendment) Bill 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Syariah Court Civil Procedure (Federal Territories) (Amendment) Act 2005. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 167 (d) of the principal Act is amended by inserting after the words \"costs of the execution;\" the word \"and\". Syariah Court Civil Procedure (Federal Territories) 3 (Amendment) Amendment of Third Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Third Schedule to the principal Act is amended, in the English language text, in Form MS 5—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in the heading, by substituting for the words \"MEMORANDUM OF APPOINTMENT OF\" the words \"WAKALAH\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"memorandum of appointment\" the word \"wakalah\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Syariah Court Civil Procedure (Federal Territories) Act 1998 [Act 585], which is referred to as the \"principal Act\" in this Act, is amended in the English language text by substituting for the words \"Islamic law\" and \"Islamic Law\" wherever they appear, except in the definition of \"Administration Act\" in subsection 3(1), the words \"Hukum Syarak\". Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 22(b) of the principal Act is amended by inserting after the words \"defective;\" the word \"or\". Amendment of section 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 34 of the principal Act is amended in the English language text—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words \"Memorandum of appointment\" the word \"wakalah\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words \"memorandum of appointment\" the word \"wakalah\". Amendment of section 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 39 of the principal Act is amended in the English language text by substituting for the words \"memorandum of appointment\" the word \"wakalah\". Amendment of section 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 43 of the principal Act is amended in the English language text by substituting for the words \"memorandum of appointment\" the word \"wakalah\". Amendment of section 112"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 112(b) of the principal Act is amended by substituting for the word \"Qadi\" the word \"Registrar\". Amendment of section 150"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 150(2)(b) of the principal Act is amended by inserting after the words \"specific delivery;\" the word \"or\". Amendment of section 151"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 151(1)(aa) of the principal Act is amended by inserting after the words \"committal;\" the word \"or\". Amendment of section 167"
      }
    }
