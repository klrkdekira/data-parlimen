      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Tatacara Mal Mahkamah Syariah(Wilayah-Wilayah Persekutuan)(Pindaan) 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Tatacara Mal Mahkamah Syariah (Wilayah-Wilayah Persekutuan) (Pindaan) 2005. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 161 (d) Akta ibu dipinda dengan memasukkan selepas perkataan \"kos pelaksanaan itu;\" perkataan \"dan\". Tatacara Mal Mahkamah Syariah (Wilayah-Wilayah 3 Persekutuan) (Pindaan) Pindaan Jadual Ketiga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Ketiga kepada Akta ibu dipinda, dalam teks bahasa Inggeris, dalam Borang MS 5—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam tajuk, dengan menggantikan perkataan \"MEMORANDUM OF APPOINTMENT OF\" dengan perkataan \"WAKALAH\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"memorandum of appointment\" dengan perkataan \"wakalah\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Tatacara Mal Mahkamah Syariah (Wilayah-Wilayah Persekutuan) 1998 [Akta 585], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"Islamic law\" dan \"Islamic Law\" di mana-mana jua terdapat, kecuali dalam takrif \"Administration Act\" dalam subseksyen 3(1), dengan perkataan \"Hukum Syarak\". Pindaan seksyen 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 22(b) Akta ibu dipinda dengan memasukkan selepas perkataan \"cacat;\" perkataan \"atau\". Pindaan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 34 Akta ibu dipinda dalam teks bahasa Inggeris—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"Memorandum of appointment\" dengan perkataan \"wakalah\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"memorandum of appointment\" dengan perkataan \"wakalah\". Pindaan seksyen 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"memorandum of appointment\" dengan perkataan \"wakalah\". Pindaan seksyen 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 43 Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"memorandum of appointment\" dengan perkataan \"wakalah\". Pindaan seksyen 112"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 112(b) Akta ibu dipinda dengan menggantikan perkataan \"Qadi\" dengan perkataan \"Pendaftar\". Pindaan seksyen 150"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 150(2)(b) Akta ibu dipinda dengan memasukkan selepas perkataan \"penghantarserahan khusus;\" perkataan \"atau\". Pindaan seksyen 151"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 151(l)(aa) Akta ibu dipinda dengan memasukkan selepas perkataan \"pengkomitan;\" perkataan \"atau\". Pindaan seksyen 167"
      }
    }
  ]
}
