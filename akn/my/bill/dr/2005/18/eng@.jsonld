      ],
      "schema:name": {
        "@language": "en",
        "@value": "Islamic Banking Act (Amendment) Bil 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Islamic Banking (Amendment) Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Islamic Banking Act 1983 [Act 276], which is referred to as the \"principal Act\" in this Act, is amended in section 2 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"Islamic banking business\" the following definition: ' \"Islamic deposit\" means a sum of money or monies worth received by or paid to any person, under which the receipt and repayment shall be in accordance with the terms of an agreement made under any Syariah principle on any basis including custody or profit sharing;'; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definitions of \"investment account liabilities\", \"other deposit liabilities\", \"saving account liabilities\", \"sight liabilities\" and \"time liabilities\". Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended by inserting after subsection (5) the following subsection: \"(5A) Any Islamic bank licensed under this section shall be deemed to be a member institution under the Malaysia Deposit Insurance Corporation Act 2005 [Act ].\". Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 11(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" at the end of paragraph (d);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the comma at the end of paragraph (e) the words \"; or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (e) the following paragraph: \"(/) has ceased to be a member institution under the Malaysia Deposit Insurance Corporation Act 2005,\". Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 16 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) The minimum amount or amounts of the assets so prescribed to be held shall be expressed in the form of a percentage which such assets shall bear to the Islamic deposit of each Islamic bank.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5), by substituting for the words \"sight, savings account, investment account, time and other deposit liabilities\" the words \"Islamic deposit\". Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 22 of the principal Act is amended by inserting after subsection (2) the following subsection: \"(3) Subsection (1) shall not apply to any arrangement, agreement or scheme to be carried out by any Islamic bank under the Malaysia Deposit Insurance Corporation Act 2005.\". Amendment of section 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 34 of the principal Act is amended by substituting for subsection (4) the following subsection: \"(4) Subsection (3) shall not apply to the disclosure of information or document to— (a) any director, officer, employee or agent of the Malaysia Deposit Insurance Corporation (hereinafter in this paragraph referred to as \"the Corporation\") established under the Malaysia Deposit Insurance Corporation Act 2005 where such disclosure is for the purpose of the exercise of powers, the performance of functions or the discharge of duties of the Corporation or of the directors, officers, employees or agents of the Corporation under that Act; or (b) auditors appointed under section 17, officers and employees of the bank who are resident in Malaysia.\". Amendment of section 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 45 the following section: \"Priority of Islamic deposits 45. (1) Where an Islamic bank is wound-up under paragraph 37(2)f/J, the proceeds of the liquidation of the Islamic bank shall, subject to section 10 of the Government Proceedings Act 1956 [Act 359] and subsection (2), be paid to the depositors in priority over all other unsecured liabilities in the following manner: (a) Islamic deposits based on custody; and (b) other Islamic deposits. Bill (2) Where a person has been appointed under paragraph 31(2)(d) or (e), as the case may be, or an Islamic bank is wound-up under paragraph 37(2)(f), all proper costs, charges and expenses, including the remuneration, of such appointed person shall be payable out of the assets of the Islamic bank in priority over all other claims.\"."
      }
    }
  ]
}
