      ],
      "schema:name": {
        "@language": "en",
        "@value": "Banking and Financial Intitutions Act (Amendment) Bil 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Banking and Financial Institutions (Amendment) Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Banking and Financial Institutions Act 1989 [Act 372], which is referred to as the \"principal Act\" in this Act, is amended in section 4—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering section 4 as subsection (1) of that section; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: \"(2) A bank or a finance company licensed under subsection 6(4) shall be deemed to be a member institution under the Malaysia Deposit Insurance Corporation Act 2005 [Act ].\". Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 7(1) of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word \"or\" at the end of paragraph (j);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (k) the words \"; or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (k) the following paragraph: \"(I) the licensed bank or licensed finance company has ceased to be a member institution under the Malaysia Deposit Insurance Corporation Act 2005 .\". Amendment of section 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 45 of the principal Act is amended by inserting after subsection (3) the following subsection: \"(4) This section shall not apply to any acquisition or disposal by any person under the Malaysia Deposit Insurance Corporation Act 2005.\". Amendment of section 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 46 of the principal Act is amended by inserting after subsection (1) the following subsection: \"(1A) Subsection (1) shall not apply to any person who holds interests in shares of a licensed bank or licensed finance company pursuant to the provisions of the Malaysia Deposit Insurance Corporation Act 2005.\". Amendment of section 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended by inserting after subsection (9) the following subsection: \"(9A) Subsection (9) shall not apply to any agreement or arrangement carried out by any person pursuant to the Malaysia Deposit Insurance Corporation Act 2005.\". Amendment of section 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 69 of the principal Act is amended by inserting after the words \"The Bank shall,\" the words \"whether under this Act or the Malaysia Deposit Insurance Corporation Act 2005,\". Amendment of section 81"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 81 of the principal Act is amended by substituting for subsection (1) the following subsection: \"(1) Subject to section 10 of the Government Proceedings Act 1956 [Act 359] and subsection 74(5), where a licensed institution becomes unable to meet all or any of its obligations, suspends payment to any extent or is wound-up under paragraph 13(2)(c), the properties of the institution in Malaysia shall be available to meet all liabilities of that institution in respect of all deposits in Malaysia in priority over all other unsecured liabilities of that institution in Malaysia.\". New section 98A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 98 the following section: \"Disclosure for facilitating performance of functions by Malaysia Deposit Insurance Corporation 98A. The provisions of section 97 shall not apply to the disclosure of any information or document to any director, officer, employee or agent of the Malaysia Deposit Insurance Corporation (hereinafter in this section referred to as \"the Corporation\") established under the Malaysia Deposit Insurance Corporation Act 2005 where the disclosure is for the purposes of the exercise of powers, the performance of functions or the discharge of duties of the Corporation or of the directors, officers, employees or agents of the Corporation under that Act.\"."
      }
    }
  ]
}
