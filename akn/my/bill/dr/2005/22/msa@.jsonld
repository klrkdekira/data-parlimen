      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dalam subseksyen (4), dengan menggantikan perkataan \"(1)\" dengan perkataan \"(2)\". Pindaan seksyen 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_8",
      "@type": "akn:clause",
