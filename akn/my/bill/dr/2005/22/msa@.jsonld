      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Undang-Undang Keluarga Islam (Wilayah-Wilayah Persekutuan) (Pindaan) 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 42(1) Akta ibu dipinda dengan menggantikan perkataan \"akuan berkanun\" dengan perkataan \"suatu iqrar\". (Pindaan) Pindaan seksyen 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
