        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_e",
