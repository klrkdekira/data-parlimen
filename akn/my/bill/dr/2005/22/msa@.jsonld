      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 52 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"perempuan\" perkataan \"atau lelaki, mengikut mana-mana yang berkenaan,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), (c) dan (f), dengan memasukkan selepas perkataan \"suami\" perkataan \"atau isteri\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (d) dengan perenggan yang berikut: \"(d) bahawa suami atau isteri telah tidak menunaikan, tanpa sebab yang munasabah, kewajipan perkahwinan (nafkah batin) suami atau isteri itu, mengikut mana-mana yang berkenaan, selama tempoh satu tahun;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (h) dengan perenggan yang berikut: \"(h) bahawa suami atau isteri menganiayai isteri atau suaminya, mengikut mana-mana yang berkenaan, iaitu, antara lain— (i) secara lazim menyakitinya atau menjadikan kehidupannya menderita disebabkan oleh kelakuan aniaya; (ii) berkawan dengan perempuan atau lelaki yang berperangai jahat atau hidup berperangai keji mengikut pandangan Hukum Syarak; (iii) cuba memaksa isteri hidup secara tidak bermoral; (iv) melupuskan harta isteri atau suami atau melarang isteri atau suami menggunakan haknya di sisi undang- undang terhadap harta itu; (v) menghalang isteri atau suami daripada menunaikan atau menjalankan kewajipan atau amalan agamanya; atau (vi) jika suami mempunyai isteri lebih daripada seorang, dia tidak melayani isteri secara adil mengikut kehendak Hukum Syarak;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (i) dengan perenggan yang berikut: “(i) bahawa walaupun selepas empat bulan berlalu, perkahwinan itu masih belum disatukan kerana suami atau isteri dengan sengaja enggan disetubuhi;\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (k), dengan memasukkan selepas perkataan \"tidak layak untuk berkahwin;\" perkataan \"atau\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: \"(2) Tiada perintah boleh dibuat atas alasan yang dinyatakan dalam perenggan (l)fcj sehingga hukuman itu telah menjadi muktamad dan suami atau isteri itu telah pun menjalani satu tahun daripada hukuman itu.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"atas alasan\" perkataan \"yang dinyatakan\"; dan (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"enam\" dengan perkataan \"dua belas\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan memasukkan selepas perkataan \"mana-mana alasan\" perkataan \"yang dinyatakan\". Pemotongan seksyen 58"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 58. Pindaan seksyen 59"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 59(2)(b) Akta ibu dipinda dalam teks bahasa kebangsaan dengan memasukkan selepas perkataan \"kemahuan suaminya;\" perkataan \"atau\". Pindaan seksyen 61"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 61 Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan \"regardless of dengan perkataan \"having regard to\". Pindaan seksyen 73"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 73(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan \"atau\" yang terdapat selepas koma bernoktah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan menggantikan noktah dengan perkataan \"; atau\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (d) perenggan yang berikut: \"(e) apabila memberikan kebenaran kepada lelaki itu untuk berpoligami di bawah subseksyen 23(1).\". Pindaan seksyen 79"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 79(cj(i) Akta ibu dipinda dengan memasukkan selepas perkataan \"dirinya;\" perkataan \"atau\". Pindaan seksyen 81"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 81(2) Akta ibu dipinda daiam tek oahasa kebangsaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan \"peringkatnya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan \"peringkatnya\". Pindaan seksyen 107"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 107 Akta ibu dipinda dalam nota bahu dengan menggantikan perkataan \"Injunksi terhadap gangguan\" dengan perkataan \"Perintah tegahan\". Seksyen baru 107A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Undang-Undang Keluarga Islam (Wilayah-Wilayah Persekutuan) 1984 [Akta 303], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 107 seksyen yang berikut: \"Perintah larangan terhadap pelupusan harta sepencarian 107A. (1) Mahkamah boleh, atas permohonan mana-mana pihak kepada sesuatu perkahwinan— (a) jika mana-mana prosiding hal ehwal suami isteri masih belum selesai; atau (b) dalam mana-mana prosiding yang Mahkamah boleh membuat perintah di bawah seksyen 122, membuat suatu perintah melarang isteri atau suami, mengikut mana-mana yang berkenaan, daripada melupuskan apa-apa aset yang telah diperoleh mereka, secara usaha bersama atau (Pindaan) usaha satu pihak semata-mata, semasa perkahwinan mereka berkuat kuasa jika Mahkamah berpuas hati adalah perlu untuk berbuat demikian. (2) Kegagalan untuk mematuhi perintah yang dibuat di bawah subseksyen (1) boleh dikenakan hukuman sebagai suatu penghinaan kepada Mahkamah.\". Pindaan seksyen 114"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 1 \\4(g) Akta ibu dipinda dengan memasukkan selepas perkataan \"kesahtarafan;\" perkataan \"atau\". Pindaan seksyen 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 121 dengan seksyen yang berikut: \"Rayuan 121. Apa-apa rayuan terhadap keputusan Mahkamah Rendah Syariah hendaklah dibuat kepada Mahkamah Tinggi Syariah, dan apa-apa rayuan terhadap apa-apa keputusan Mahkamah Tinggi Syariah hendaklah dibuat kepada Mahkamah Rayuan Syariah.\". Seksyen baru 122"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 121 tajuk dan seksyen yang berikut: \"Pembahagian Harta Sepencarian Kuasa Mahkamah untuk memerintahkan pembahagian harta sepencarian 122. (1) Mahkamah hendaklah mempunyai kuasa, apabila membenarkan lafaz talaq atau membuat suatu perintah perceraian, untuk memerintahkan supaya apa-apa aset yang diperoleh pihak-pihak semasa perkahwinan mereka melalui usaha bersama mereka dibahagikan antara mereka atau supaya apa-apa aset itu dijual dan hasil jualan itu dioahagikan antara pihak-pihak itu. (2) Pada menjalankan kuasa yang diberikan oleh subseksyen (1), Mahkamah hendaklah mengambil kira tentang— (a) takat sumbangan yang dibuat oleh setiap pihai; dalam bentuk wang, harta, atau kerja bagi memperoieh aset itu; (b) apa-apa hutang yang belum dijelaskan oleh salah satu pihak yang telah dilakukan bagi manfaat bersama mereka; dan (c) keperluan anak-anak yang belum dewasa daripada perkahwinan itu, jika ada, dan, tertakluk kepada pertimbangan itu, Mahkamah hendaklah membuat pembahagian yang sama banyak. (3) Mahkamah hendaklah mempunyai kuasa, apabila membenarkan lafaz talaq atau membuat suatu perintah perceraian, untuk memerintahkan supaya apa-apa aset yang diperoleh semasa perkahwinan melalui usaha satu pihak kepada perkahwinan itu semata-mata dibahagikan antara pihak-pihak itu atau supaya apa-apa aset itu dijual dan hasil jualan itu dibahagikan antara pihak-pihak itu. (4) Pada menjalankan kuasa yang diberikan oleh subseksyen (3), Mahkamah hendaklah mengambil kira tentang— (a) takat sumbangan yang dibuat oleh pihak yang tidak memperoieh aset itu kepada kebajikan keluarga dengan memelihara rumahtangga atau menjaga keluarga; dan (b) keperluan anak-anak yang belum dewasa daripada perkahwinan itu, jika ada, dan, tertakluk kepada pertimbangan itu, Mahkamah boleh membahagikan aset itu atau hasil jualan itu mengikut apa-apa kadar yang difikirkan oleh Mahkamah sebagai munasabah, tetapi, dalam apa-apa hal, pihak yang melalui usahanya aset itu telah diperoleh hendaklah menerima kadar yang lebih besar. (Pindaan) (5) Bagi maksud seksyen ini, sebutan tentang aset yang diperoleh semasa sesuatu perkahwinan termasuklah aset yang dipunyai oleh satu pihak sebelum perkahwinan itu yang telah dimajukan sebahagian besarnya dalam masa perkahwinan itu oleh pihak yang satu lagi atau melalui usaha bersama mereka.\". Pindaan seksyen 127"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan raenggantikan seksyen 127 dengan seksyen yang berikut: \"Menganiayai isteri atau suami 127. (1) Seseorang lelaki yang menganiayai isterinya atau menipu isterinya akan hartanya, atau seseorang perempuan yang menganiayai suaminya atau menipu suaminya akan hartanya, melakukan suatu kesalahan dan hendaklah apabila disabitkan dihukum dengan denda tidak melebihi satu ribu ringgit atau pemenjaraan selama tempoh tidak melebihi enam bulan atau kedua-duanya. (2) Mahkamah boleh sebagai perintah tambahan mengarahkan lelaki atau perempuan yang telah disabitkan di bawah subseksyen (1) untuk membayar pampasan kepada isteri atau suami yang telah ditipu hartanya, mengikut mana-mana yang berkenaan.\". Pindaan seksyen 130"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 130 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"Jadi murtad\" dengan perkataan \"Percubaan untuk menjadi murtad\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa Inggeris, dengan menggantikan perkataan \"an apostate\" dengan perkataan \"murtad\". Pindaan seksyen 134"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 134 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"Enakmen\" dengan perkataan \"Akta\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"Enakmen\" dengan perkataan \"Akta\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (3)(c), dengan menggantikan perkataan \"akuan\" dengan perkataan \"iqrar\". Seksyen baru 134A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 134 seksyen yang berikut: \"Hukum Syarak 134A. (1) Mana-mana peruntukan atau tafsiran peruntukan di bawah Akta ini yang tidak selaras dengan Hukum Syarak adalah tidak sah setakat ketidakselarasan itu. (2) Jika terdapat lakuna atau jika apa-apa perkara tidak diperuntukkan dengan nyata dalam Akta ini, Mahkamah hendaklah memakai Hukum Syarak.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_vii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_viii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"darar syarie\", dengan menggantikan perkataan \"akhlak\" dengan perkataan \"maruah\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"fasakh\" takrif yang berikut: \"Hakim Mahkamah Rayuan Syariah\" ertinya seseorang Hakim Mahkamah Rayuan Syariah yang dilantik di bawah subseksyen 42(1) Akta Pentadbiran;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif ' \"Hak? n Syarie\" atau \"Hakim\" ' dengan takrif yang berikut: ' \"Hakim Syarie\" atau \"Hakim\" ertinya seseorang Hakim Mahkamah Rendah Syariah atau Hakim Mahkamah Tinggi Syariah, mengikut mana-mana yang berkenaan, yang dilantik masing-masing di bawah subseksyen 44(1) atau 43(1) Akta Pentadbiran;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Hukum Syarak\" dengan takrif yang berikut: ' \"Hukum Syarak\" ertinya Hukum Syarak mengikut Mazhab Shafie, atau mengikut mana- mana satu Mazhab Maliki, Hanafi atau Hanbali;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"Hukum Syarak\" takrif yang berikut; ' \"iqrar\" ertinya suatu pengakuan yang dibuat oleh seseorang secara bertulis atau lisan atau dengan isyarat, yang menyatakan bahawa dia mempunyai kewajipan atau tanggungan terhadap seseorang lain berkenaan dengan sesuatu hak;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"nasab\" takrif yang berikut: ' \"Negeri\" termasuklah Wilayah-Wilayah Persekutuan Kuala Lumpur, Labuan dan Putrajaya;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"Wilayah Persekutuan\", dengan menggantikan perkataan \"atau Labuan\" dengan perkataan \", Labuan atau Putrajaya\"; dan (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a__subpara_viii",
      "@type": "akn:subparagraph",
      "eli:number": "viii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"Wilayah-Wilayah Persekutuan\", dengan menggantikan perkataan \"dan Labuan\" dengan perkataan \", Labuan dan Putrajaya\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan \"masing-masing oleh Akta itu\" perkataan \"setakat yang erti sedemikian tidak bercanggah dengan Hukum Syarak\". Pindaan seksyen 9"
      }
    },
    {
