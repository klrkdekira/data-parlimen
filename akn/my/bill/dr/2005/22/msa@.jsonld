        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \"(1) Tiada seorang pun lelaki semasa wujudnya suatu perkahwinan boleh, kecuali dengan mendapat kebenaran terlebih dahulu secara bertulis daripada Mahkamah, membuat akad nikah perkahwinan yang lain dengan perempuan lain.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: \"(1A) Sesuatu perkahwinan yang diakadnikahkan tanpa kebenaran Mahkamah di bawah subseksyen (1) tidak boleh didaftarkan di bawah Akta ini melainkan jika Mahkamah berpuas hati bahawa perkahwinan itu adalah sah mengikut Hukum Syarak dan Mahkamah telah memerintahkan supaya perkahwinan itu didaftarkan tertakluk kepada seksyen 123.\"; (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
