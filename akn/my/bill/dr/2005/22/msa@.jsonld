      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 31(2)(c) Akta ibu dipinda dengan menggantikan perkataan \"akuan\" dengan perkataan \"iqrar\". Pindaan seksyen 38"
      }
    },
