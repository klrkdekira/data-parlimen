      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"akuan\" dengan perkataan \"iqrar\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"dan\" yang terdapat selepas perkataan \"dikatakan patut\" dengan perkataan \"atau\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/22/msa@/~cl_6__para_d",
      "@type": "akn:paragraph",
