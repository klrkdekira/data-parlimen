      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 2006. Issue and appropriation for the service of the year 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/23/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/23/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding eighty-one billion one hundred"
      },
      "schema:text": {
        "@language": "en",
        "@value": "and twenty million and fifty-seven thousand and seven hundred and thirty ringgit (RM81,120,057,730) from the Consolidated Fund for the service of the year 2006 is hereby authorised, and that sum is appropriated for purposes specified in the Schedule. Bill"
      }
    },
