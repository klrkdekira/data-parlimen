        "@value": "Constitution Act (Amendment) (No.2) Bill 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1__subsec_1",
