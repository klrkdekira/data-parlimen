        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) (No. 2) Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Except for paragraph 3{b), this Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 3(b) is deemed to have come into operation on 10 October 2003. Amendment of Article 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in Article 46—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1), by substituting for the words \"two hundred and nineteen\" the words \"two hundred and twenty-two\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (2)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words \"two hundred and six\" the words \"two hundred and nine\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (xi), by substituting for the word \"twenty-eight\" the word \"thirty-one\". Amendment of Article 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 121 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a) of Clause (1), by substituting for the words \"in Kuala Lumpur\" the words \"at such place in the States of Malaya as the Yang di-Pertuan Agong may determine\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in Clauses (1B) and (2), by substituting for the words \"in Kuala Lumpur\" wherever they appear the words \"at such place as the Yang di-Pertuan Agong may determine\". Amendment of Article 124"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 124 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (2) the following Clause: \"(2A) A person taking the oath on becoming the President of the Court of Appeal shall do so in the presence of the senior judge available of the Court of Appeal.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (4), by substituting for the words \"Subject to Clause (3), a person\" the words \"A person\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (4) the following Clause: \"(4A) A person taking the oath on becoming a judge of the Court of Appeal shall do so in the presence of the President of the Court of Appeal, or in his absence, the next senior judge available of the Court of Appeal.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (5), by deleting the words \"the Court of Appeal or\". Amendment of Article 125"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 125 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (3), by substituting for the words \"Clause (3A)\" the words \"Clause (3B)\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for Clause (3A) the following Clause: \"(3A) Where a judge has committed a breach of any provisions of the code of ethics prescribed under Clause (3B) but the Chief Justice- is of the opinion that the breach does not warrant the judge being referred to a tribunal appointed under Clause (4), the Chief Justice may refer the judge to a body constituted under federal law to deal with such breach.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (3A) the following Clauses: \"(3B) The Yang di-Pertuan Agong on recommendation of the Chief Justice, the President of the Court of Appeal and the Chief Judges of the High Courts may, after consulting the Prime Minister, prescribe in writing a code of ethics which shall also include provisions on the procedure to be followed and sanctions which can be imposed other than the removal of a judge from office under Clause (3), in relation to a breach of any provision of the code of ethics. (3c) The code of ethics prescribed under Clause (3B) shall be observed by every judge of the Federal Court and every judicial commissioner.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/24/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (4), by substituting for the words \"The said tribunal\" the words \"The tribunal appointed under Clause (3)\"."
      }
    }
  ]
}
