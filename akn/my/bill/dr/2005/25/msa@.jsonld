      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Akta Saraan Hakim (Pindaan) 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Saraan Hakim (Pindaan) 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini disifatkan telah mula berkuat kuasa pada 21 Mac 2005. Pindaan seksyen 1A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Saraan Hakim 1971 [Akta 45], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 1A dalam takrif \"persaraan\" dengan menggantikan perenggan (a) dengan perenggan yang berikut: \"(a) persaraan daripadajawatan Hakim di bawah seksyen 8(a);\". Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut: \"(a) bersara daripada jawatan Hakim apabila mencapai umur enam puluh enam tahun atau sehingga suatu masa kemudiannya tetapi masa itu tidak boleh kemudian daripada enam bulan selepas dia mencapai umur itu menurut Fasal (1) Perkara 125 Perlembagaan Persekutuan;\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan menggantikan perkataan \"enam puluh lima tahun\" dengan perkataan \"enam puluh enam tahun atau pada bila-bila masa selepas dia mencapai umur itu jika dia sedang memegang jawatan itu menurut Fasal (1) Perkara 125 Perlembagaan Persekutuan\". Pengekalan pencen dan faedah lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Hakim yang telah dilantik sebelum 21 Mac 2005 dan tidak memilih umur persaraan yang disebut dalam perenggan 8(a) Akta ibu hendaklah berhak mendapat pencen dan faedah lain di bawah Akta ibu seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan 8(d) Akta ibu, sebutan mengenai umur enam puluh lima tahun hendaklah terus terpakai bagi Hakim yang disebut dalam subseksyen (1) seolah-olah Akta ibu tidak dipinda oleh Akta ini. Pengesahan pemberian pencen dan faedah lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pencen dan faedah lain yang diberikan kepada Hakim bagi tempoh dia memegang jawatan itu selepas mencapai umur enam puluh lima tahun menurut Fasal (1) Perkara 125 Perlembagaan Persekutuan sebelum 21 Mac 2005, hendaklah disifatkan telah diberikan dengan sah."
      }
    }
  ]
}
