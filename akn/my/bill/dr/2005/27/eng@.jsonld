      "schema:text": {
        "@language": "en",
        "@value": "in paragraph 35, by inserting after the word \"Interest\" the words \"or discount\". Amendment of Schedule 7A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "Schedule 7A of the principal Act is amended by inserting after paragraph 6 the following paragraph: \"6A. Where in the case of a business of a person the basis periods for two years of assessment overlap, the period common to those periods shall be deemed for the purposes of this Schedule to fall into the earlier of those periods and not into the later of those periods.\". Saving and transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_38__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Where any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_38__para_a",
