      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (6). Amendment of section 60"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
