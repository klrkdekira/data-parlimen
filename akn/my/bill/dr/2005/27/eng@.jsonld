        "@value": "AMENDMENTS TO THE"
      },
      "schema:text": {
        "@language": "en",
        "@value": "PETROLEUM (INCOME TAX) ACT 1967 Commencement of amendments to the Petroleum (Income Tax) Act 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_VI",
      "@type": "akn:chapter",
      "eli:number": "VI",
