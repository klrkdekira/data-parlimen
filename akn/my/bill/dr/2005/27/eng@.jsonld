        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 39(1 )(e) of the principal Act is amended-—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/eng@/~chp_II__cl_7__para_a",
