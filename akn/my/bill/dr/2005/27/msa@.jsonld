      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Seksyen 51, 52, 53, 55 dan 56 disifatkan telah mulaberkuat kuasa pada 1 Oktober 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/msa@/~chp_IV__cl_50__subsec_2",
