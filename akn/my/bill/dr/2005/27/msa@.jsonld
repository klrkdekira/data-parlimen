      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 147 Akta ibu dipinda dengan memotong perkataan \", to the Director of Inland Revenue, Sabah, to the Director of Inland Revenue, Sarawak,\". Pindaan seksyen 153"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/27/msa@/~chp_II__cl_3",
      "@type": "akn:clause",
