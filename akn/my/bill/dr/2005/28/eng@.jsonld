      ],
      "schema:name": {
        "@language": "en",
        "@value": "Malaysian Examination Council (Amendment) Bill 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "( 1) This Act may be cited as the Malaysian Examinations Council (Amendment) Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysian Examinations Council Act 1980 [Act 225], which is referred to in this Act as the \"principal Act\" in this Act, is amended in section 7 by inserting after subsection (4) the following subsections: \"(5) Without prejudice to subsections (1), (2), (3) and (4), the Council may, with the approval of the Minister, conduct any examination, other than the specified examinations, and all matters that may be necessary or incidental to such examination, for any person, body, organization, institution or authority in or outside Malaysia. Bill (6) Notwithstanding any other provision in this Act or paragraph 69{A)(b) of the Education Act 1996 [Act 550], any person, body, organization, institution or authority in or outside Malaysia shall not conduct any examination other than the specified examination, which relates to academic matters, without a written approval of the Director of Examinations as required under subsection 69(1) of the Education Act 1996.\". Amendment of section 12A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 12A(l)of the principal Act is amended by substituting for the words ''section 12\" the words \"section 16.\". Amendment of section 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 26(1) of the principal Act is amended by substituting for the words \"a specified examination\" the words ''an examination conducted by the Council\". Amendment of section 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 28 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words \"a specified examination\" wherever they appear the words \"an examination conducted by the Council\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the words \"a specified examination\" the words \"an examination conducted by the Council.\". Deletion of section 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 30. Amendment of section 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 31 (d) of the principal Act is amended by substituting for the words \"a specified examination\" the words \"any examination conducted by the Council\"."
      }
    }
  ]
}
