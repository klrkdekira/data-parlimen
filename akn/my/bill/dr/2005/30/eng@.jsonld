      "schema:text": {
        "@language": "en",
        "@value": "ARBITRATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ADDITIONAL PROVISIONS RELATING TO ARBITRATION Consolidation of proceedings and concurrent hearings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The parties may agree—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the arbitration proceedings shall be consolidated with other arbitration proceedings; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that concurrent hearings shall be held, on such terms as may be agreed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Unless the parties agree to confer such power on the arbitral tribunal, the tribunal has no power to order consolidation of arbitration proceedings or concurrent hearings. Determination of preliminary point of law by court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any party may apply to the High Court to determine any question of law arising in the course of the arbitration —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the consent of the arbitral tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the consent of every other party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court shall not consider an application under subsection (1) unless it is satisfied that the determination—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is likely to produce substantial savings in costs; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "substantially affects the rights of one or more of the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The application shall identify the question of law to be determined and, except where made with the agreement of all parties to the proceedings, shall state the grounds that support the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "While an application under subsection (1) is pending, the arbitral proceedings may be continued and an award may be made. Reference on questions of law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Any party may refer to the High Court any question of law arising out of an award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "A reference shall be filed within forty-two days of the publication and receipt of the award, and shall identify the question of law to be determined and state the grounds on which the reference is sought."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court may order the arbitral tribunal to state the reasons for its award where the award—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "does not contain the arbitral tribunal's reasons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "does not set out the arbitral tribunal's reasons in sufficient detail."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court may, on the determination of a reference—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "confirm the award;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "vary the award;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "remit the award in whole or in part, together with the High Court's determination on the question of law to the arbitral tribunal for reconsideration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "set aside the award, in whole or in part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the award is varied by the High Court, the variation shall have effect as part of the arbitral tribunal's award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the award is remitted in whole or in part for reconsideration, the arbitral tribunal shall make a fresh award in respect of the matters remitted within ninety days of the date of the order for remission or such other period as the High Court may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the High Court makes an order under subsection (3), it may make such further order as it thinks fit with respect to any additional costs of the arbitration resulting from that order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "On a reference under subsection (1) the High Court may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "order the applicant to provide security for costs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_42__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "order that any money payable under the award shall be brought into the High Court or otherwise secured pending the determination of the reference. Appeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the High Court under section 42 shall be deemed to be a judgment of the High Court within the meaning of section 67 of the Courts of Judicature Act 1964 [Act 91]. Costs and expenses of an arbitration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the costs and expenses of an arbitration shall be in the discretion of the arbitral tribunal who may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "direct to and by whom and in what manner those costs or any part thereof shall be paid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "tax or settle the amount of such costs and expenses; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "award such costs and expenses to be paid as between solicitor and client;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any party may apply to the High Court for the costs to be taxed where an arbitral tribunal has in its award directed that costs and expenses be paid by any party, but fails to specify the amount of such costs and expenses within thirty days of having being requested to do so; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "each party shall be responsible for its own legal and other expenses and for an equal share of the fees and expenses of the arbitral tribunal and any other expenses relating to the arbitration in the absence of an award or additional award fixing and allocating the costs and expenses of the arbitration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, where a party makes an offer to the other party to settle the dispute or part of the dispute and the offer is not accepted and the award of the arbitral tribunal is no more favourable to the other party than was the offer, the arbitral tribunal, in fixing and allocating the costs and expenses of the arbitration, may take the fact of the offer into account in awarding costs and expenses in respect of the period from the making of the offer to the making of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An offer to settle made under subsection (2) shall not be communicated to the arbitral tribunal until it has made a final determination of all aspects of the dispute other than the fixing and allocation of costs and expenses."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where an arbitral tribunal refuses to deliver its award before the payment of its fees and expenses, the High Court may order the arbitral tribunal to deliver the award on such conditions as the High Court thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A taxation of costs, fees and expenses under this section may be reviewed in the same manner as a taxation of costs. Extension of time for commencing arbitration proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Where an arbitration agreement provides that arbitral proceedings are to be commenced within the time specified in the agreement, the High Court may, notwithstanding that the specified time has expired, extend the time for such period and on such terms as it thinks fit, if it is of the opinion that in the circumstances of the case undue hardship would otherwise be caused. Extension of time for making award"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Where the time for making an award is limited by the arbitration agreement, the High Court may, unless otherwise agreed by the parties, extend that time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "An application under subsection (1) may be made- fa ) upon notice to the parties, by the arbitral tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "upon notice to the arbitral tribunal and the other parties, by any party to the proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court shall not make an order unless —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all available tribunal processes for obtaining an extension of time have been exhausted; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the High Court is satisfied that substantial injustice would otherwise be done."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court may exercise its powers under subsection (1) notwithstanding that the time previously fixed by or under the arbitration agreement or by a previous order has expired."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "General provisions Receipt of written communications"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a written communication is deemed to have been received if it is delivered to the addressee personally or if it is delivered at his place of business, habitual residence or mailing address; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where the places referred to in paragraph (a) cannot be found after making a reasonable inquiry, a written communication is deemed to have been received if it is sent to the addressee's last known place of business, habitual residence or mailing address by registered post or any other means which provides a record of the attempt to deliver it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, a written communication sent electronically is deemed to have been received if it is sent to the electronic mailing address of the addressee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The communication is deemed to have been received on the day it is so delivered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to any communications in respect of court proceedings. Waiver of right to object"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "A party who knows —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "of any provision of this Act from which the parties may derogate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "that any requirement under the arbitration agreement has not been complied with, and yet proceeds with the arbitration without stating its objection to such non-compliance without undue delay or, if a time limit is provided for stating that objection, within that period of time, shall be deemed to have waived its right to object. Extent of court intervention"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_1",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise provided, no court shall intervene in any of the matters governed by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Arbitration agreement Definition and form of arbitration agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A court before which proceedings are brought in respect of a matter which is the subject of an arbitration agreement shall, where a party makes an application before taking any other steps in the proceedings, stay those proceedings and refer the parties to arbitration unless it finds —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that the agreement is null and void, inoperative or incapable of being performed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that there is in fact no dispute between the parties with regard to the matters to be referred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The court, in granting a stay of proceedings pursuant to subsection ( I ) , may impose any conditions as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where the proceedings referred to in subsection (1) have been brought, arbitral proceedings may be commenced or continued, and an award may be made, while the issue is pending before the court. Arbitration agreement and interim measures by High Court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A party may, before or during arbitral proceedings, apply to a High Court for any interim measure and the High Court may make the following orders for:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "security for costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "discovery of documents and interrogatories;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "giving of evidence by affidavit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "appointment of a receiver;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "securing the amount in dispute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the preservation, interim custody or sale of any property which is the subject-matter of the dispute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "ensuring that any award which may be made in the arbitral proceedings is not rendered ineffectual by the dissipation of assets by a party; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an interim injunction or any other interim measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where a party applies to the High Court for any interim measure and an arbitral tribunal has already ruled on any matter which is relevant to the application, the High Court shall treat any findings of fact made in the course of such ruling by the arbitral tribunal as conclusive for the purposes of the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, \"arbitration agreement\" means an agreement by the parties to submit to arbitration all or certain disputes which have arisen or which may arise between them in respect of a defined legal relationship, whether contractual or not."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitration agreement may be in the form of an arbitration clause in an agreement or in the form of a separate agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitration agreement shall be in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitration agreement is in writing where it is contained 1 1 1 \" ~ ~ ~ ~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a document signed by the parties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an exchange of letters, telex, facsimile or other means of communication which provide a record of the agreement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an exchange of statement of claim and defence in which the existence of an agreement is alleged by one party and not denied by the other."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A reference in an agreement to a document containing an arbitration clause shall constitute an arbitration agreement, provided that the agreement is in writing and the reference is such as to make that clause part of the agreement. Arbitration agreement and substantive claim before court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "Composition of"
      },
      "schema:text": {
        "@language": "en",
        "@value": "arbitrators Number of arbitrators"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The parties are free to determine the number of arbitrators."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties fail to determine the number of arbitrators, the arbitral tribunal shall —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an international arbitration, consist of three arbitrators; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a domestic arbitration, consist of a single arbitrator. Appointment of arbitrators"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, no person shall be precluded by reason of nationality from acting as an arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The parties are free to agree on a procedure for appointing the arbitrator or the presiding arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties fail to agree on the procedure referred to in subsection (2), and the arbitration consists of three arbitrators, each party shall appoint one arbitrator, and the two appointed arbitrators shall appoint the third arbitrator as the presiding arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where subsection (3) applies and —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a party fails to appoint an arbitrator within thirty days of receipt of a request in writing to do so from the other party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the two arbitrators fail to agree on the third arbitrator within thirty days of their appointment or such extended period as the parties may agree, either party may apply to the Director of the Kuala Lumpur Regional Centre for Arbitration for such appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where in an arbitration with a single arbitrator—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the parties fail to agree on the procedure referred to in subsection (2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the parties fail to agree on the arbitrator, either party may apply to the Director of the Kuala Lumpur Regional Centre for Arbitration for the appointment of an arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where, the parties have agreed on the procedure for appointment of the arbitrator—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "a party fails to act as required under such procedure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the parties, or two arbitrators, are unable to reach an agreement under such procedure; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "a third party, including an institution, fails to perform any function entrusted to it under such procedure, any party may request the Director of the Kuala Lumpur Regional Centre for Arbitration to take the necessary measures, unless the agreement on the appointment procedure provides other means for securing the appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director of the Kuala Lumpur Regional Centre for Arbitration is unable to act or fails to act under subsections (4), (5) and (6) within thirty days from the request, any party may apply to the High Court for such appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "In appointing an arbitrator the Director of the Kuala Lumpur Regional Centre for Arbitration or the High Court, as the case may be, shall have due regard to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "any qualifications required of the arbitrator by the agreement of the parties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "other considerations that are likely to secure the appointment of an independent and impartial arbitrator; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an international arbitration, the advisability of appointing an arbitrator of a nationality other than those of the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "No appeal shall lie against any decision of the Director of the Kuala Lumpur Regional Centre for Arbitration or the High Court under this section. Grounds for challenge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is approached in connection with that person's possible appointment as an arbitrator shall disclose any circumstances likely to give rise to justifiable doubts as to that person's impartiality or independence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitrator shall, without delay, from the time of appointment and throughout the arbitral proceedings, disclose any circumstances referred to in subsection (1) to the parties unless the parties have already been informed of such circumstances by the arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitrator may be challenged only if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the circumstances give rise to justifiable doubts as to that arbitrator's impartiality or independence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that arbitrator does not possess qualifications agreed to by the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A party may challenge an arbitrator appointed by that party, or in whose appointment that party has participated, only for reasons which that party becomes aware of after the appointment has been made. Challenge procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, any party who intends to challenge an arbitrator shall, within fifteen days after becoming aware of the constitution of the arbitral tribunal or of any reasons referred to in subsection 14(3), send a written statement of the reasons for the challenge to the arbitral tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Unless the challenged arbitrator withdraws from office or the other party agrees to the challenge, the arbitral tribunal shall make a decision on the challenge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where a challenge is not successful, the challenging party may, within thirty days after having received notice of the decision rejecting the challenge, apply to the High Court to make a decision on the challenge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "While such an application is pending, the arbitral tribunal, including the challenged arbitrator, may continue the arbitral proceedings and make an award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No appeal shall lie against the decision of the High Court under subsection (3). Failure or impossibility to act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where an arbitrator becomes in law or in fact unable to perform the functions of that office, or for other reasons fails to act without undue delay, that arbitrator's mandate terminates on withdrawal from office or if the parties agree on the termination."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any party disagrees on the termination of the mandate of the arbitrator, any party may apply to the High Court to decide on such termination and no appeal shall lie against the decision of the High Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where, under this section or subsection 15(2), an arbitrator withdraws from office or a party agrees to the termination of the mandate of an arbitrator, it shall not imply acceptance of the validity of any ground referred to in this section or subsection 14(3). Appointment of substitute arbitrator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A substitute arbitrator shall be appointed in accordance with the provisions of this Act where —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the mandate of an arbitrator terminates under section 15 or 16;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an arbitrator withdraws from office for any other reason;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the mandate of the arbitrator is revoked by agreement of the parties; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in any other case of termination of mandate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a single or the presiding arbitrator is replaced, any hearings previously held shall be repeated before the substitute arbitrator; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where an arbitrator other than a single or the presiding arbitrator is replaced, any hearings previously held may be repeated at the discretion of the arbitral tribunal,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, any order or ruling of the arbitral tribunal made prior to the replacement of an arbitrator under this section shall not be invalid solely on the ground there has been a change in the composition of the arbitral tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Jurisdiction of arbitral tribunal Competence of arbitral tribunal to rule on its jurisdiction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may rule on its own jurisdiction, including any objections with respect to the existence or validity of the arbitration agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "No appeal shall lie against the decision of the High Court under subsection (8). Power of arbitral tribunal to order interim measures"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an arbitration clause which forms part of an agreement shall be treated as an agreement independent of the other terms of the agreement; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a decision by the arbitral tribunal that the agreement is null and void shall not ipso jure entail the invalidity of the arbitration clause."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A plea that the arbitral tribunal does not have jurisdiction shall be raised not later than the submission of the statement of defence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A party is not precluded from raising a plea under subsection (3) by reason of that party having appointed or participated in the appointment of the arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A plea that the arbitral tribunal is exceeding the scope of its authority shall be raised as soon as the matter alleged to be beyond the scope of its authority is raised during the arbitral proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsections (3) and (5), the arbitral tribunal may admit such plea if it considers the delay justified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may rule on a plea referred to in subsection (3) or (5), either as a preliminary question or in an award on the merits."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where the arbitral tribunal rules on such a plea as a preliminary question that it has jurisdiction, any party may, within thirty days after having received notice of that ruling appeal to the High Court to decide the matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "While an appeal is pending, the arbitral tribunal may continue the arbitral proceedings and make an award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, a party may apply to the arbitral tribunal for any of the following orders:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "security for costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "discovery of documents and interrogatories;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "giving of evidence by affidavit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the preservation, interim custody or sale of any property which is the subject-matter of the dispute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may require any party to provide appropriate security in connection with such measure as ordered under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_4__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, sections 38 and 39 shall apply to orders made by an arbitral tribunal under this section as if a reference in those sections to an award were a reference to such an order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5",
      "@type": "akn:chapter",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Conduct of arbitral proceedings Equal treatment of parties"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5",
      "schema:name": {
        "@language": "en",
        "@value": "The parties shall be treated with equality and each party shall"
      },
      "schema:text": {
        "@language": "en",
        "@value": "be given a fair and reasonable opportunity of presenting that party's case. Determination of rules of procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, the parties are free to agree on the procedure to be followed by the arbitral tribunal in conducting the proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties fail to agree under subsection (1), the arbitral tribunal may, subject to the provisions of this Act, conduct the arbitration in such manner as it considers appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The power conferred upon the arbitral tribunal under subsection (2) shall include the power to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "determine the admissibility, relevance, materiality and weight of any evidence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "draw on its own knowledge and expertise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the provision of further particulars in a statement of claim or statement of defence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the giving of security for costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "fix and amend time limits within which various steps in the arbitral proceedings must be completed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the discovery and production of documents or materials within the possession or power of a party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the interrogatories to be answered;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order that any evidence be given on oath or affirmation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make such other orders as the arbitral tribunal considers appropriate. Seat of arbitration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The parties are free to agree on the seat of arbitration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties fail to agree under subsection (1), the seat of arbitration shall be determined by the arbitral tribunal having regard to the circumstances of the case, including the convenience of the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsections (1) and (2), the arbitral tribunal may, unless otherwise agreed by the parties, meet at any place it considers appropriate for consultation among its members, for hearing witnesses, experts or the parties, or for inspection of goods, other property or documents. Commencement of arbitral proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, the arbitral proceedings in respect of a particular dispute shall commence on the date on which a request in writing for that dispute to be referred to arbitration is received by the respondent. Language"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The parties are free to agree on the language to be used in the arbitral proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Where the parties fail to agree under subsection (1), the arbitral tribunal shall determine the language to be used in the arbitral proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The agreement or the determination referred to in subsections (1) and (2) respectively shall, unless otherwise specified in the agreement or determination, apply to any written statement made by a party, any hearing and any award, decision or other communication by the arbitral tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may order that any documentary evidence shall be accompanied by a translation into the language agreed upon by the parties or determined by the arbitral tribunal. Statements of claim and defence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Within the period of time agreed by the parties or, failing such agreement, as determined by the arbitral tribunal, the claimant shall state—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the facts supporting his claim;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the points at issue; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the relief or remedy sought, and the respondent shall state his defence in respect of the particulars set out in this subsection, unless the parties have otherwise agreed to the required elements of such statements."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The parties may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "submit with their statements any document the parties consider relevant; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "add a reference to the documents or other evidence that the parties may submit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, either party may amend or supplement the claim or defence during the course of the arbitral proceedings, unless the arbitral tribunal considers it inappropriate to allow such amendment having regard to the delay in making it. Hearings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, the arbitral tribunal shall decide whether to hold oral hearings for the presentation of evidence or oral arguments, or whether the proceedings shall be conducted on the basis of documents and other materials."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Unless the parties have agreed that no hearings shall be held, the arbitral tribunal shall upon the application of any party hold oral hearings at an appropriate stage of the proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The parties shall be given reasonable prior notice of any hearing and of any meeting of the arbitral tribunal for the purposes of inspection of goods, other property or documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "All statements, documents or other information supplied to the arbitral tribunal by one party shall be communicated to the other party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any expert report or evidentiary document on which the arbitral tribunal may rely in making its decision shall be communicated to the parties. Default of a party"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5",
      "schema:name": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, if without showing sufficient cause —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "the claimant fails to communicate the statement of claim in accordance with subsection 25(1), the arbitral tribunal shall terminate the proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "the respondent fails to communicate the statement of defence in accordance with subsection 25(1), the arbitral tribunal shall continue the proceedings without treating such failure in itself as an admission of the claimant's allegations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "any party fails to appear at a hearing or to produce documentary evidence, the arbitral tribunal may continue the proceedings and make the award on the evidence before it; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "the claimant fails to proceed with the claim, the arbitral tribunal may make an award dismissing the claim or give directions, with or without conditions, for the speedy determination of the claim. Expert appointed by arbitral tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, the arbitral tribunal may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "appoint one or more experts to report to it on specific issues to be determined by the arbitral tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require a party to give the expert any relevant information or to produce or to provide access to any relevant documents, goods or other property for the expert's inspection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, if a party so requests or if the arbitral tribunal considers it necessary, the expert shall, after delivery of a written or oral report, participate in a hearing where the parties have the opportunity to put questions to the expert and to present other expert witnesses in order to testify on the points at issue. Court assistance in taking evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any party may with the approval of the arbitral tribunal, apply to the High Court for assistance in taking evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_5__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court may order the attendance of a witness to give evidence or, where applicable, produce documents on oath or affirmation before an officer of the High Court or any other person, including the arbitral tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6",
      "@type": "akn:chapter",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Making of award and termination of proceedings Law applicable to substance of dispute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In respect of a domestic arbitration where the seat of arbitration is in Malaysia, the arbitral tribunal shall decide the dispute in accordance with the substantive law of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In respect of an international arbitration, the arbitral tribunal shall decide the dispute in accordance with the law as agreed upon by the parties as applicable to the substance of the dispute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any designation by the parties of the law of a given State shall be construed, unless otherwise expressed, as directly referring to the substantive law of that State and not to its conflict of laws rules."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Failing any agreement under subsection (2), the arbitral tribunal shall apply the law determined by the conflict of laws rules."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal shall, in all cases, decide in accordance with the terms of the agreement and shall take into account the usages of the trade applicable to the transaction. Decision making by panel of arbitrators"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, in any arbitral proceedings with more than one arbitrator, any decision of the arbitral tribunal shall be made by a majority of all its members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where so authorized by the parties or by all the members of the arbitral tribunal, questions of procedure may be decided by the presiding arbitrator. Settlement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "If, during arbitral proceedings, the parties settle the dispute, the arbitral tribunal shall terminate the proceedings and, if requested by the parties and not objected to by the arbitral tribunal, record the settlement in the form of an award on agreed terms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "An award on agreed terms shall be made in accordance with the provisions of section 33 and shall state that it is an award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "An award made under subsection (1) shall have the same status and effect as an award on the merits of the case. Form and contents of award"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "An award shall be made in writing and subject to subsection (2) shall be signed by the arbitrator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "In arbitral proceedings with more than one arbitrator, the signatures of the majority of all members of the arbitral tribunal shall be sufficient provided that the reason for any omitted signature is stated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "An award shall state the reasons upon which it is based, unless —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the parties have agreed that no reasons are to be given; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the award is an award on agreed terms under section 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "An award shall state its date and the seat of arbitration as determined in accordance with section 22 and shall be deemed to have been made at that seat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "After an award is made, a copy of the award signed by the arbitrator in accordance with subsections (1) and (2) shall be delivered to each party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise provided in the arbitration agreement, the arbitral tribunal may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "award interest on any sum of money ordered to be paid by the award from the date of the award to the date of realisation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_33__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "determine the rate of interest. Termination of proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral proceedings shall be terminated by a final award or by an order of the arbitral tribunal in accordance with subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal shall order the termination of the arbitral proceedings where —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the claimant withdraws the claim, unless the respondent objects to the withdrawal and the arbitral tribunal recognises the respondent's legitimate interest in obtaining a final settlement of the dispute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parties agree on the termination of the proceedings; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitral tribunal finds that the continuation of the proceedings has for any other reason become unnecessary or impossible."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of section 35 and subsection 37(6), the mandate of the arbitral tribunal shall terminate with the termination of the arbitral proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise provided by any written law, the death of a party does not terminate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitral proceedings; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_34__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the authority of the arbitral tribunal. Correction and interpretation of award or additional award"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A party, within thirty days of the receipt of the award, unless any other period of time has been agreed upon by the parties —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon notice to the other party, may request the arbitral tribunal to correct in the award any error in computation, any clerical or typographical error or other error of similar nature; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon notice to and with the agreement of the other party, may request the arbitral tribunal to give an interpretation of a specific point or part of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where the arbitral tribunal considers the request made under subsection (1) to be justified, it shall make the correction or give the interpretation within thirty days of the receipt of the request and such interpretation shall form part of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may correct any error of the type referred to in paragraph (1)(a) on its own initiative within thirty days of the date of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise agreed by the parties, a party may, within thirty days of the receipt of the award and upon notice to the other party, request the arbitral tribunal to make an additional award as to claims presented in the arbitral proceedings but omitted from the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where the arbitral tribunal considers the request under subsection (4) to be justified, it shall make the additional award within sixty days from the receipt of such request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal may, where it thinks necessary, extend the period of time within which it shall make a correction, interpretation or an additional award under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of section 33 shall apply to a correction or interpretation of the award or to an additional award. An award is final and binding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "An award made by an arbitral tribunal pursuant to an arbitration agreement shall be final and binding on the parties and may be relied upon by any party by way of defence, set-off or otherwise in any proceedings in any court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_6__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitral tribunal shall not vary, amend, correct, review, add to or revoke an award which has been made except as specifically provided for in section 35."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7",
      "@type": "akn:chapter",
      "eli:number": "7",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Recourse against award Application for setting aside"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An award may be set aside by the High Court only if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the party making the application provides proof that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a party to the arbitration agreement was under any incapacity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitration agreement is not valid under the law to which the parties have subjected it, or, failing any indication thereon, under the laws of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the party making the application was not given proper notice of the appointment of an arbitrator or of the arbitral proceedings or was otherwise unable to present that party's case;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the award deals with a dispute not contemplated by or not falling within the terms of the submission to arbitration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (3), the award contains decisions on matters beyond the scope of the submission to arbitration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the composition of the arbitral tribunal or the arbitral procedure was not in accordance with the agreement of the parties, unless such agreement was in conflict with a provision of this Act from which the parties cannot derogate, or, failing such agreement, was not in accordance with this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the High Court finds that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the subject-matter of the dispute is not capable of settlement by arbitration under the laws of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the award is in conflict with the public policy of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Without limiting the generality of subparagraph an award is in conflict with the public policy of Malaysia where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the making of the award was induced or affected by fraud or corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_b__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a breach of the rules of natural justice occurred —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "during the arbitral proceedings; or (ii) in connection with the making of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where the decision on matters submitted to arbitration can be separated from those not so submitted, only that part of the award which contains decisions on matters not submitted to arbitration may be set aside."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An application for setting aside may not be made after the expiry of ninety days from the date on which the party making the application had received the award or, if a request has been made under section 35, from the date on which that request had been disposed of by the arbitral tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (4) does not apply to an application for setting aside on the ground that the award was induced or affected by fraud or corruption."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "On an application under subsection (1) the High Court may, where appropriate and so requested by a party, adjourn the proceedings for such period of time as it may determine in order to allow the arbitral tribunal an opportunity to resume the arbitral proceedings or to take such other action as in the arbitral tribunal's opinion will eliminate the grounds for setting aside."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_7__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where an application is made to set aside an award, the High Court may order that any money made payable by the award shall be brought into the High Court or otherwise secured pending the determination of the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8",
      "@type": "akn:chapter",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Recognition and enforcement of awards Recognition and enforcement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "On an application in writing to the High Court, an award made in respect of a domestic arbitration or an award from a foreign State shall, subject to this section and section 39 be recognised as binding and be enforced by entry as a judgment in terms of the award or by action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "In an application under subsection (1) the applicant shall produce —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the duly authenticated original award or a duly certified copy of the award; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the original arbitration agreement or a duly certified copy of the agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where the award or arbitration agreement is in a language other than the national language or the English language, the applicant shall supply a duly certified translation of the award or agreement in the English language."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, \"foreign State\" means a State which is a party to the Convention on the Recognition and Enforcement of Foreign Arbitral Awards adopted by the United Nations Conference on International Commercial Arbitration in 1958. Grounds for refusing recognition or enforcement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Recognition or enforcement of an award, irrespective of the State in which it was made, may be refused only at the request of the party against whom it is invoked —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_vii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where that party provides to the High Court proof that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a party to the arbitration agreement was under any incapacity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitration agreement is not valid under the law to which the parties have subjected it, or, failing any indication thereon, under the laws of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the party making the application was not given proper notice of the appointment of an arbitrator or of the arbitral proceedings or was otherwise unable to present that party's case;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the award deals with a dispute not contemplated by or not falling within the terms of the submission to arbitration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (2), the award contains decisions on matters beyond the scope of the submission to arbitration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the composition of the arbitral tribunal or the arbitral procedure was not in accordance with the agreement of the parties, unless such agreement was in conflict with a provision of this Act from which the parties cannot derogate, or, failing such agreement, was not in accordance with this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the award has not yet become binding on the parties or has been set aside or suspended by a court of the country in which, or under the law of which, that award was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the High Court finds that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the subject-matter of the dispute is not capable of settlement by arbitration under the laws of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the award is in conflict with the public policy of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_II__chp_8__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "If an application for setting aside or suspension of an award has been made to the High Court on the grounds referred to in subparagraph (l)(a)(\\ii), the High Court may, if it considers it proper, adjourn its decision and may also, on the application of the party claiming recognition or enforcement of the award, order the other party to provide appropriate security."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Liability of arbitrator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "An arbitrator shall not be liable for any act or omission in respect of anything done or omitted to be done in the discharge of his functions as an arbitrator unless the act or omission is shown to have been in bad faith. Immunity of arbitral institutions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Director of the Kuala Lumpur Regional Centre for Arbitration or any other person or institution designated or requested by the parties to appoint or nominate an arbitrator, shall not be liable for anything done or omitted in the discharge of the function unless the act or omission is shown to have been in bad faith. Bankruptcy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Where a party to an arbitration agreement is a bankrupt and the person having jurisdiction to administer the property of the bankrupt adopts the agreement, the arbitration agreement shall be enforceable by or against that person. Arbitration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The High Court may direct any matter in connection with or for the purpose of bankruptcy proceedings to be referred to arbitration if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the matter is one to which the arbitration agreement applies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitration agreement was made by a person who has been adjudged a bankrupt before the commencement of the bankruptcy proceedings; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person having jurisdiction to administer the property does not adopt the agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "An application under subsection (2) may be made by —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any other party to the arbitration agreement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_49__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any person having jurisdiction to administer the property of the bankrupt. Mode of application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any application to the High Court under this Act shall be by an originating summons as provided in the Rules of the High Court 1980 [P.U. (A) 50/1980]. Repeal and savings 5 1. (1) The Arbitration Act 1952 [Act 93] and the Convention on the Recognition and Enforcement of Foreign Arbitral Awards Act 1985 [Act 320] are repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where the arbitral proceedings were commenced before the coming into operation of this Act, the law governing the arbitration agreement and the arbitral proceedings shall be the law which would have applied as if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall affect any proceedings relating to arbitration which have been commenced in any court before the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) This Act may be cited as the Arbitration Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires — \"award\" means a decision of the arbitral tribunal on the substance of the dispute and includes any final, interim or partial award and any award on costs or interest but does not include interlocutory orders; \"High Court\" means the High Court in Malaya and the High Court in Sabah and Sarawak or either of them, as the case may require; \"Minister\" means the Minister charged with the responsibility for arbitration; \"State\" means a sovereign State and not a component state of Malaysia, unless otherwise specified; \"presiding arbitrator\" means the arbitrator designated in the arbitration agreement as the presiding arbitrator or chairman of the arbitral tribunal, a single arbitrator or the third arbitrator appointed under subsection 13(3); \"arbitration agreement\" means an arbitration agreement as defined in section 9; \"party\" means a party to an arbitration agreement or, in any case where an arbitration does not involve all the parties to the arbitration agreement, means a party to the arbitration; . . ■ ■ > - \"seat of arbitration\" means the place where the arbitration is based as determined in accordance with section 22; \"international arbitration\" means an arbitration where —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "one of the parties to an arbitration agreement, at the time of the conclusion of that agreement, has its place of business in any State other than Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "one of the following is situated in any State other than Malaysia in which the parties have their places of business:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the seat of arbitration if determined in, or pursuant to, the arbitration agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any place where a substantial part of the obligations of any commercial or other relationship is to be performed or the place with which the subject-matter of the dispute is most closely connected; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the parties have expressly agreed that the subject-matter of the arbitration agreement relates to more, than one State; \"domestic arbitration\" means any arbitration which is not an international arbitration; \"arbitral tribunal\" means a sole arbitrator or a panel of arbitrators."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"international arbitration\" —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "where a party has more than one place of business, reference to the place of business is that which has the closest relationship to the arbitration agreement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "where a party does not have a place of business, reference to the place of business is that party's habitual residence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a provision of this Act, except sections 3 and 30, leaves the parties free to determine a certain issue, such freedom shall include the right of the parties to authorize a third party, including an institution, to determine that issue;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a provision of this Act refers to the fact that the parties have agreed or that they may agree or in any other way refers to an agreement of the parties, that agreement shall include any arbitration rules referred to in that agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a provision of this Act refers to a claim, other than in paragraphs 27(a) and 34(2)(a), it shall also apply to a counterclaim, and where it refers to a defence, it shall also apply to a defence to that counterclaim. Application to arbitrations and awards in Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply throughout Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In respect of a domestic arbitration, where the seat of arbitration is in Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "Parts I, II and IV of this Act shall apply; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "Part III of this Act shall apply unless the parties agree otherwise in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In respect of an international arbitration, where the seat of arbitration is in Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "Parts I, II and IV of this Act shall apply; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "Part III of this Act shall not apply unless the parties agree otherwise in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraphs (2)(b) and (3)(b), the parties to a domestic arbitration may agree to exclude the application of Part III of this Act and the parties to an international arbitration may agree to apply Part III of this Act, in whole or in part. Arbitrability of subject-matter"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any dispute which the parties have agreed to submit to arbitration under an arbitration agreement may be determined by arbitration unless the arbitration agreement is contrary to public policy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The fact that any written law confers jurisdiction in respect of any matter on any court of law but does not refer to the determination of that matter by arbitration shall not, by itself, indicate that a dispute about that matter is not capable of determination by arbitration. Government to be bound"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/30/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to any arbitration to which the Federal Government or the Government of any component state of Malaysia is a party."
      }
    }
  ]
}
