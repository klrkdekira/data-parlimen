      "schema:name": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2004) Act"
      },
      "schema:text": {
        "@language": "en",
        "@value": "2005. Further expenditure for the year 2004"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding nine billion seven hundred and thirty-eight million seven hundred and eight thousand and fifty-five ringgit (RM9,738,708,055) from the Consolidated Fund for expenditure on the services and purposes specified in the Schedule for the year 2004, not provided for or not fully provided for by the Supply Act 2004 [Act A1206] and the Supplementary Supply (2004) Act 2004 [Act A1227]. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/7/eng@/~sched_1",
