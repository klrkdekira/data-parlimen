    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Private Employment Agencies (Amendment) Act 2005."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Private Employment Agencies Act 1981 [Act 246], which is referred to as the \"principal Act\" in this Act, is amended in section 3, in the definition of \"Director General\" by substituting for the words \"Director General of Manpower\" the words \"Director General of Labour\". Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2005/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 4 of the principal Act is amended by substituting for the words \"Yang di-Pertuan Agong\" the word \"Minister\"."
      }
    }
  ]
