      ],
      "schema:name": {
        "@language": "en",
        "@value": "Safeguards Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
