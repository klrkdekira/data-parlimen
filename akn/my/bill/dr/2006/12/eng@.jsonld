      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PRELIMINARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "THE INVESTIGATING AUTHORITY Appointment of the investigating authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DETERMINATION OF SERIOUS INJURY OR THREAT OF SERIOUS INJURY AND CAUSAL LINK Serious injury and causal link"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A determination of whether increased imports have caused or are threatening to cause serious injury to a domestic industry under this Act, all relevant factors of an objective and quantifiable nature of the product under investigation, the like products and directly competitive products of the domestic industry shall be evaluated in the prescribed manner, having a bearing on the situation of that industry."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The determination referred to in subsection (1) shall not be made unless this investigation demonstrates, on the basis of objective evidence, the existence of the causal link between increased imports of the product under investigation and serious injury or threat thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "When factors other than increased imports of the product under investigation are at the same time causing or threatening to cause injury to the domestic industry, such injury shall not be attributed to the increased imports. Threat of serious injury and causal link"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A determination of a threat of serious injury caused by increased imports shall be based on facts and not merely on allegation, conjecture or remote possibility."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "In considering whether increased imports threaten to cause serious injury, the relevant factors, which shall be evaluated, shall be as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint and authorize an investigating authority to conduct an investigation under this Act. Appointment of officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, appoint and authorize such officers as are necessary to perform the functions and powers under this Act. Protection of officers and persons acting under the Act and regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "No action or prosecution shall be brought, instituted or maintained in any court against any officer or person authorized under this Act and the regulations made under this Act for or on account of or in respect of any act ordered or done for the purpose of carrying into effect this Act and the regulations made under this Act, and no suit or prosecution shall lie in any court against any other person for or on account of or in respect of any act done or purported to be done by him under the order, direction or instruction of any such officer or person if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served thereby. Duties and powers of the investigating authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The investigating authority shall perform such duties and functions and exercise such powers as may be provided under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The conduct of investigation relating to serious injury or threat thereof, shall be as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The investigating authority shall be subject to the provisions of the Act in performing the functions assigned to it under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "With respect to any proceeding under this Act, the investigating authority shall not disclose any information, which is entitled to confidential treatment under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The investigating authority may request directly from the participating interested parties, customs agents, inspection companies, forwarders, and other enterprises and entities of the public and private sectors such data and information as the investigating authority considers relevant to the performance of its task. The recipients of such requests shall provide the requested information, and such information shall be placed in the public file."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The investigating authority may decide to verify the accuracy of any information submitted during an investigation or review as prescribed. Power to delegate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Minister may, in writing, delegate any of his functions under this Act and the regulations made under this Act, subject to such conditions, limitations or restrictions as he thinks fit, to a person or class of persons and the person or class of persons to whom those functions are delegated may perform those functions in the manner and with the same effect as if those functions had been conferred on him or them under this Act and the regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A person purporting to act pursuant to a delegation made under this section shall, in the absence of proof to the contrary, be presumed to be acting in accordance with the terms of the delegation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation made under this section may at any time be revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "INVESTIGATION Petition for initiation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A request for an investigation to determine whether increased imports of the product under investigation have caused or threaten to cause serious injury to a domestic industry may be initiated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "upon a written petition addressed to the Ministry of International Trade and Industry by or on behalf of a domestic industry; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "on the initiative of the Government. Requirements for a written petition"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A petition under paragraph 10(a) shall include such information as prescribed. Withdrawal of the petition before initiation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A petition under section 10 may be withdrawn prior to initiation, in which case it shall be considered not to have been made. Amendments to the petition"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A petition requesting an investigation be initiated may be amended subject to such conditions as the Government deems fit. Decision to initiate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Government may initiate an investigation, whether at the request of a domestic industry or on its own initiative, only when the Government has determined that there is sufficient evidence of serious injury or threat thereof caused by increased imports."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "If the Government decides to initiate an investigation under subsection (1), the Government may seek such additional information, as the Government deems necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Government decides not to initiate an investigation, the Government shall notify the petitioner in writing of the reasons for not initiating the investigation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Where a petition has been received, the Government shall, from the date of receipt of the petition, decides whether or not to initiate an investigation within such period as prescribed. When the petition involves complex issues, or if the Government has to seek additional information as provided for in subsection (2) the said period may be extended for another period as prescribed. Notice of initiation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The decision to initiate an investigation shall be notified to the Committee. Such notification shall be made immediately after the initiation of the investigation. Publication of the notice of initiation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of initiation shall be published by the Government. Contents of the notice of initiation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The contents of the notice of initiation shall be as prescribed. Public hearings and written arguments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "All participating interested parties shall have the opportunity in accordance with the provisions of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to public hearings or other appropriate means in which importers, exporters and other interested parties could present evidence and their views; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to respond to a written and oral presentation of other participating interested parties and to submit views as to whether or not the application of a safeguard measure would be in the public interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The procedures for public hearing or other appropriate means shall be as prescribed. Treatment of confidential information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any information which is by its nature confidential or which is provided on a confidential basis shall, upon cause shown, be treated as such by the Government. Such information shall not be disclosed without specific written permission from the party submitting the confidential information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Parties providing confidential information shall be requested to furnish non-confidential summaries thereof or, if such parties indicate that such information cannot be summarized, the reasons why a summary cannot be provided."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "If the Government finds that a request for confidential treatment is not warranted, and if the provider of the information is unwilling to make the information public, or to authorize its disclosure in generalized or summary form, the Government may disregard such information unless it can be demonstrated to the Government's satisfaction from appropriate sources that the information is correct. Preliminary determination"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall, within such period as prescribed, make a preliminary determination regarding —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether the product under investigation is being imported into Malaysia in such increased quantities, absolute or relative to domestic production; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether under such conditions, it causes or threatens to cause serious injury to the domestic industry that produces like or directly competitive products."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If the Government makes a negative preliminary determination with regard to subsection (1), the Government shall publish a notice stating the reasons for the negative determination and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "continue the investigation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "terminate the investigation if the Government deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If the Government makes an affirmative preliminary determination with regard to subsection (1), the Government shall continue the investigation and publish a notice of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the affirmative preliminary determination, stating the reasons for its determination with respect to paragraphs \\(a) and (b)\\ and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the provisional safeguard measure applicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If the decision is to apply a provisional safeguard measure, the notice regarding the application of a provisional safeguard measure shall be as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "If the Government decides not to apply a provisional safeguard measure, the notice of negative preliminary determination shall be as prescribed. Notification and consultation of a provisional safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_21__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) Once a decision has been taken to apply a provisional safeguard measure and before the measure takes effect, the Government shall notify the Committee in conformity with the requirements established by the Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Before the measure is applied, the opportunity to be consulted as referred to in the Agreement shall be provided. Provisional safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Government may apply a provisional safeguard measure with regard to the product under investigation imported into Malaysia on or after the publication of the notice of affirmative preliminary determination where the Government determines that such measures are necessary to prevent the injury referred to in subsections 8(1) and 9(1) from occurring during the period of investigation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A provisional safeguard measure shall take the form of provisional safeguard duties guaranteed by a bond or security equal to the amount determined by the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The provisional safeguard measure imposed under this section shall not exceed two hundred days."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "If the subsequent investigation does not result in a determination that increased imports have caused or threaten to cause serious injury to the domestic industry, any bond or security shall be promptly released."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The collection of any provisional safeguard duties imposed under this Act shall be conducted by an officer of customs. Final determination"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall, within such period as prescribed, make a final determination regarding—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether the product under investigation is being imported into Malaysia in such increased quantities, absolute or relative to domestic production; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether under such conditions, it causes or threatens to cause serious injury to the domestic industry that produces like or directly competitive products."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Government makes a negative final determination with regard to subsection (1), the Government shall —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "terminate the investigation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "terminate the provisional safeguard measure applied under section 22, and release the bond or security required by such measure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "publish a notice of the negative final determination, stating the reasons for its negative determination."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Government makes an affirmative final determination with regard to subsection (1), the Government shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "publish a notice of affirmative final determination; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "impose a definitive safeguard measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall immediately notify the Committee if the Government determines that increased imports have caused or threaten to cause serious injury to the domestic industry. Any such notification shall conform to the requirement established by the Committee. Notice of final determination"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall publish a notice of final determination regarding serious injury and causal link as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Safeguards Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"threat of serious injury\" means serious injury that is clearly imminent; \"Member\" means a Member of the World Trade Organization; \"ASEAN\" means the Association of South East Asian Nations; \"prescribed\" means prescribed by regulations made under this Act; \"GATT 1994\" means the General Agreement on Tariffs and Trade 1994 set out in Annex 1A to the World Trade Organization Agreement; \"domestic industry\" means —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the domestic producers as a whole of products which are like or directly competitive with the product under investigation, operating in Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the domestic producers operating in Malaysia whose collective output of like products or products directly competitive with the product under investigation constitutes a major proportion of the total domestic production of those products; \"Committee\" means the Committee on Safeguards of the World Trade Organization; \"like products\" means products that are identical or alike in all respect to the product under investigation or, in the absence of such products, another product that although not alike in all respect have characteristics closely resembling the product under investigation; \"directly competitive products\" means products that are in competition despite differences in characteristics or composing materials, substitutability in terms of utility purpose or commercial competitiveness; \"product under investigation\" means the class or kind of products imported or sold for importation into Malaysia that is subject of safeguard action under this Act, as determined by the Government to be appropriate for establishing the scope of action; \"serious injury\" means a significant overall impairment in the position of a domestic industry; \"Government\" means the Government of Malaysia; \"Minister\" means the Minister charged with the responsibility for international trade and industry; \"Country\" includes all WTO Members and any other country or autonomous customs territory; \"officer of customs\" has the same meaning as is assigned to that expression under section 2 of the Customs Act 1967 [Act 235]; \"Agreement\" means the Agreement on Safeguards of the World Trade Organization; \"interested parties\" means —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign exporter and producer of the product under investigation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the importer of the product under investigation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the government(s) of the exporting country or countries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the domestic producers of the like products or directly competitive products;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "relevant trade and business associations registered in Malaysia; \"participating interested parties\" means those interested parties that have indicated their interest in participating in an investigation in accordance with section 10; \"investigating authority\" means the investigating authority appointed under section 3; \"WTO\" means the World Trade Organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_35"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "DEFINITIVE SAFEGUARD"
      },
      "schema:text": {
        "@language": "en",
        "@value": "MEASURE Determination of definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_38"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REVIEW OF SAFEGUARD MEASURE Review"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REAPPLICATION OF A SAFEGUARD MEASURE Reapplication"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_42"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS International obligations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be applied in conformity with the obligations of Malaysia under the Agreement Establishing the World Trade Organization, done at Marrakesh, on 15 April 1994, including the GATT 1994, and the Agreement on Safeguards. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations in respect of any matter to be prescribed and such other regulations as are necessary or expedient to give full effect to or for carrying out the provisions of this Act. Publication of notices"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "All notices required to be published under this Act shall be published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "No new safeguard measure shall be applied for a period of at least two years to imports of a product, which were the subject of a definitive safeguard measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of subsection (1), a definitive safeguard measure with a duration of hundred and eighty days or less may be applied to the imports of a product under investigation which was the subject of an earlier safeguard measure if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at least one year lapsed since the date of imposition of the earlier safeguard measure on the imports of that product; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such a safeguard measure has not been applied on the same product more than twice in the five year period immediately preceding the date of introduction of the measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "If the duration of a definitive safeguard measure, including the period of application of any provisional safeguard measure, exceeds three years, the Government applying such a measure shall review the situation not later than the mid-term of the application of the measure or increase the pace of liberalization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "A notice to maintain, liberalize or withdraw a definitive safeguard measure, summarizing the results of the review, may be published. Extension of a definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the Government's own initiative or upon duly substantiated request, an extension of a definitive safeguard measure beyond the initial period and in conformity with the procedures set out in sections 8, 9, 16, 21, 23 and 25 may be granted—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the safeguard measure continues to be necessary to prevent or remedy serious injury; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is evidence that the industry is adjusting, provided that the provisions of the Agreement are fulfilled."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An extended definitive safeguard measure shall not be more restrictive than at the end of the initial period of application. During the extension period, the measure shall continue to be progressively liberalized in accordance with the schedule published in a notice to extend a definitive safeguard measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "In extending a definitive safeguard measure exceeding three years, the Government shall endeavour to maintain a substantially equivalent level of concessions and other obligation to that existing under GATT 1994 between Malaysia and the exporting Members, which would be affected by such measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The requirements pertaining to notification to the Committee and to the WTO Council for Trade in Goods as provided in subsections 21(1), 23(4), and 27(3), and the requirements pertaining to consultations with those Members having a substantial interest as exporters of the product concerned as provided for in subsection 27(2) shall apply to any extension of a safeguard measure. Notification to extend"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Once a decision has been taken to extend the safeguard measure, the Government shall notify the Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "Where the Government determines during a provisional safeguard measure that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "the product under investigation is being imported into Malaysia in such increased quantities, absolute or relative to domestic production; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "under such conditions, it causes or threaten to cause serious injury to the domestic industry that produces like or directly competitive products, the Government shall apply a definitive safeguard measure. Notice of definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Immediately upon taking a decision regarding the application of a definitive safeguard measure, the Government shall publish a notice regarding application of a definitive safeguard measure, and such notice shall contain information as prescribed. Notification and consultation of a definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Immediately upon a decision to apply a definitive safeguard measure, but before such measure takes effect, the Government shall notify the Committee regarding —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the evidence of serious injury or threat thereof caused by increased imports;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the precise description of the product under investigation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the form, level and duration of the proposed measure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the proposed date of application of the measure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the proposed date of introduction, expected duration and timetable for progressive liberalization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Before a definitive safeguard measure is applied, the Government shall provide adequate opportunity for consultation with those Members having a substantial interest as exporters of the product under investigation, with a view to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "reviewing the information notified to the Committee regarding the finding of serious injury or threat thereof caused by increased imports and the proposed measure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "exchanging views about the measure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "reaching an understanding on ways to achieve the objective to maintain a substantially equivalent level of concessions and other obligations to that existing under GATT 1994 between Malaysia and the exporting Members which would be affected by such a measure. The Government may endeavour to provide any adequate means of trade compensation for the adverse effects of the measure on their trade."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall notify the Council for Trade in Goods of the WTO immediately, through the Committee, of the results of the consultation. Form and application of a definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A definitive safeguard measure can be applied in the form o f -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a safeguard duty; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a quota on imports; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a safeguard duty and a quota on imports."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 34, any definitive safeguard measure under paragraphs (t)(a) and (b) shall be applied to all imports of the product under investigation, irrespective of source, entered on or after the date on which the measure takes effect. Administrative matters"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any petition to be submitted under Part IV shall be submitted to the Ministry of International Trade and Industry."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, any action to be conducted or taken under this Act shall be conducted or taken by any officer or person authorized in writing in that behalf by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any finding of an investigation, whether for the purpose of a preliminary or final determination, or a review, under this Act, shall be forwarded to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall decide and such decision shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall make a recommendation to the Minister of Finance to impose a definitive safeguard measure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The implementation of a definitive safeguard measure in the form as provided in subsection 28(1) shall be conducted by an officer of customs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "If any question arises as to whether any particular product is or is not included in any notification given under this Act, such question shall be referred to the investigating authority who shall make a decision on the matter. Transhipment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "In cases where products are not imported into Malaysia directly from the country of origin, but are exported to Malaysia from an intermediate country, the provisions of the Act shall be fully applicable and the transaction, for the purposes of this Act, shall be regarded as having taken place between the country of origin and Malaysia. Customs clearance not to be hindered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Any investigation conducted under this Act shall not hinder procedures for customs clearance. Application of the Customs Act 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be construed as one with the Customs Act 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "If there is any inconsistency between the provisions of the Customs Act 1967 and the provisions of this Act, the provisions of this Act shall prevail. Developing country Member"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other provisions of this Act, a definitive safeguard measure shall not be applied against the product under investigation originating in a developing country Member as long as its share of imports of the product concerned in Malaysia does not exceed three per cent of total imports of the product concerned, provided that developing country Members with less than three per cent import share collectively account for not more than nine per cent of total imports of the product concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "An action taken pursuant to subsection (1) must be notified to the Committee. Duration of a definitive safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A definitive safeguard measure shall be applied for a period of not more than four years unless it is extended as provided for in section 37."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The total duration of a definitive safeguard measure, including the period of application of any provisional safeguard measure and any extension thereof pursuant to section 37, shall not exceed ten years, in accordance with the provisions of the Agreement. Liberalization of safeguard measure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where the period of application exceeds one year, the measure applied shall be progressively liberalized at regular intervals during the period of application."
      }
    }
  ]
}
