      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Emergency (Essential Powers) Ordinance, No. 7 (Amendment) Act 2006. (2) This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Deletion of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Emergency (Essential Powers) Ordinance, No. 7 1969 [P.U. (A)307A/1969\\, which is referred to as the \"Ordinance\" in this Act, is amended by deleting section 5. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 6 of the Ordinance is amended by deleting the words \"; and any modification so made shall be indicated in a large-scale map and a copy thereof shall be published in the Gazette for general information\". Deletion of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Ordinance is amended by deleting section 7."
      }
    }
