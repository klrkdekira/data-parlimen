      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang- Undang Ordinan No.7 (Kuasa-Kuasa Perlu) Dharurat (Pindaan) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ordinan No. 7 (Kuasa2 Perlu) Dharurat, (Pindaan) 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pemotongan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Ordinan No. 7 (Kuasa2 Perlu) Dharurat, 1969 [P.U. (A)307A/69l yang disebut \"Ordinan\" dalam Akta ini, dipinda dengan memotong seksyen 5. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 6 Ordinan dipinda dengan memotong perkataan \"; dan apa2 pengubahsuaian yang di-buat itu hendak-lah di-tandakan dalam suatu peta sekil-besar dan satu salinan peta itu hendak-lah di-siarkan dalam Warta untuk perma'aloman umum\". Pemotongan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Ordinan dipinda dengan memotong seksyen 7."
      }
    }
  ]
}
