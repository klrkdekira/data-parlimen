  "@graph": [
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "@type": "akn:bill",
      "eli:is_realized_by": {
        "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15"
      },
      "eli:jurisdiction": {
        "@id": "http://publications.europa.eu/resource/authority/country/MYS"
      },
      "eli:language": "en",
      "eli:number": "DR-15-2006",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_9"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Baseline Of Maritime Zones Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) This Act may be cited as the Baselines of Maritime Zones Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"chart\" means a nautical chart specifically designed to meet the needs of marine navigation, showing depth of water, nature of the seabed, configuration and nature of the coast, dangers and aids to navigation, in a standardized format and such chart is also referred to as marine chart or hydrographic chart; \"low-water line\" means the intersection of the plane of low-water with the shore; the line along a coast or beach to which the sea recedes at low water; \"baselines\" means the baselines as determined under section 5; \"geodesic\" means a curve giving the shortest distance between two points on a given surface; \"low-tide elevation\" means a naturally formed area of land which is surrounded by and above water at low-tide but submerged at high tide; \"territorial sea\" means the territorial waters of Malaysia as determined in accordance with the Emergency (Essential Powers) Ordinance, No. 7 1969 [P.U. (A) 307A/I969]; \"Minister\" means the Minister charged with the responsibility for maritime; \"continental shelf\" means the continental shelf of Malaysia as defined in section 2 of the Continental Shelf Act 1966 [Act 831; \"exclusive economic zone\" means the exclusive economic zone of Malaysia as determined in accordance with the Exclusive Economic Zone Act 1984 [Act 311\\; \"maritime zones\" means the territorial sea, the continental shelf and the exclusive economic zone of Malaysia, or any of them, as the case may be. Prevailing law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any conflict or inconsistency between the provisions of this Act and those of any other written law, the provisions of this Act shall prevail and the conflicting or inconsistent provisions of such other written law shall, to the extent of the conflict or inconsistency, be deemed to be superceded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of any written law that is not in conflict or is consistent with the provisions of this Act shall otherwise continue to apply."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, the expression \"written law\" shall not include the Federal Constitution and the Constitutions of the States. Geographical co-ordinates of base points"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(l)The Yang di-Pertuan Agong, on the recommendation of the Minister may by order published in the Gazette, declare the geographical coordinates of base points from which the baselines of Malaysia may be determined under section 5."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the Yang di-Pertuan Agong may declare the geographical coordinates of base points of the specified areas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "An order made under subsection (1) shall be laid before each House of Parliament as soon as possible after its publication. Baselines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the baselines for the purpose of determining the maritime zones of Malaysia shall be -"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the low-water line along the coast as marked on large scale charts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the seaward low-water line of a reef as shown by the appropriate symbol on charts; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the low-water line on a low-tide elevation that is situated wholly or partly at a distance not exceeding the breadth of the territorial sea from the mainland or an island."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), in respect of any area for which geographical co-ordinates of base points have been declared under section 4, the method of straight baselines interpreted as geodesies joining the consecutive geographical coordinates of base points so declared may be employed for determining the maritime zones of Malaysia. Limits of maritime zones"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(l)The maritime zones of Malaysia shall be measured from the baselines."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Yang di-Pertuan Agong, on the recommendation of the Minister may, by order published in the Gazette, declare the outer limit lines or the lines of delimitation of the whole or any part of any of the maritime zones of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "An order made under subsection (2) shall be laid before each House of Parliament as soon as possible after its publication. Maps and charts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(l)The Yang di-Pertuan Agong may, on the recommendation of the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "cause to be prepared and issued any map as he thinks fit showing any matter relating to the geographical co-ordinates of base points, the baselines, the outer limit lines and the lines of delimitation of the maritime zones of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "cause to be prepared and issued a large-scale chart or appropriate scale chart for ascertaining position, as he thinks fit, showing the low-water line along the coast and may cause to be shown on such chart any other matter referred to in paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of paragraphs (l)faj and (b), such map or chart shall be —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the map prepared and issued by the Director General of Survey and Mapping, Malaysia or the chart prepared and issued by the Director General of the Royal Malaysian Navy Hydrographic Department respectively;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "dated and certified as a true and correct copy of a map or chart in relation to the matters contained in it by the Director General of Survey and Mapping, Malaysia or the Director General of the Royal Malaysian Navy Hydrographic Department respectively; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "deposited in the office of the Director General of Survey and Mapping, Malaysia or the Director General of the Royal Malaysian Navy Hydrographic Department respectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any map or chart prepared and issued under paragraph (2)(a) or (b) shall be published in the Gazette and, if necessary, in such other form as the Yang di-Pertuan Agong on the recommendation of the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any map or chart prepared and issued under paragraph (2)(a) or (b) may be made available to the public upon the payment of prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings before any court, any map or chart prepared and issued under subsection (1) or (2) shall be admissible in evidence as prima facie proof of the contents of such map or chart. Certificate of Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_8__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "In any legal or other proceedings, a certificate issued by or under the authority of the Minister containing a statement that any geographic location specified in the certificate was, at any time material to the proceedings, situated within any of the maritime zones of Malaysia shall be — {a) a conclusive proof of the contents of the statement without formal proof of the signature or official title of the person appearing to have issued the certificate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "admissible in evidence in such proceedings, but its production cannot be compelled. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations as may be necessary or expedient for giving full effect to the provisions of this Act and such regulations may provide for any matter which under this Act is required or permitted to be prescribed or which is necessary or expedient to be prescribed."
      }
    }
  ]
}
