        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 20 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"licensed business premises\" dengan perkataan \"premises specified in the licence\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"licensed premises\" di mana-mana jua terdapat dengan perkataan \"premises specified in the licence\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_c__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)— fii) dengan menggantikan perkataan \"Sub-Inspector\" dengan perkataan \"Inspector\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"Controller,\" perkataan \"any supplies officer\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"licensed premises\" dengan perkataan \"premises specified in the licence\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan \"licensed premises\" dengan perkataan \"premises specified in the licence\". Pindaan seksyen 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"fifteen thousand\", \"twenty-five thousand\" dan \"two\" masing-masingnya detigan perkataan \"one hundred thousand\", \"two hundred and fifty thousand\" dan \"three\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subsekyen (2), dengan menggantikan perkataan \"twenty-five\" dan \"fifty\" masing-masingnya dengan perkataan \"two hundred and fifty\" dan \"five hundred\". Pindaan seksyen 22A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \", in his absence, the Deputy Controller of Supplies\" dengan perkataan \"supplies officer authorized by him in writing, with the consent in writing of the Public Prosecutor,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kawalan Bekalan (Pindaan) 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalarn Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kawalan Bekalan 1961 [Akta 1221 yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Controller\" dengan takrif yang berikut: ' \"Controller\" means the officer appointed to be the Controller of Supplies under section 3';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"licensed premises\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"offences against this Act\" takrif yang berikut: ' \"premises\" includes any house, shop, store, room, shed, conveyance, structure or any place whether opened or closed;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"prescribed\" dengan takrif yang berikut: ' \"prescribed\" means prescribed by the regulations;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"supplies officer\", dengan memasukkan selepas perkataan \"section 3\" perkataan \"other than the Controller of Supplies\". Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 5 dengan seksyen yang berikut: \"5. The Minister may, by order published in the Gazette, declare, either generally or with reference to some specified part of Malaysia-fa) any article or food to be a controlled article or to be a rationed article or both; or (b) any controlled article or rationed article to be marked with any marking as he may specify.\". Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"and\" di hujung perenggan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah yang terdapat di hujung perenggan 2(p) dengan perkataan \"; and\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (2)(p) perenggan yang berikut: \"(t/J regulating the marking of any controlled article.\". Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 7(4) Akta ibu dipinda dengan menggantikan perkataan \"person acting\" dengan perkataan \"supplies officer acting\". Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"person authorized by him in writing in that behalf\" dengan perkataan \"supplies officer\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3) dan perenggan 4(a), dengan menggantikan perkataan \"person authorized by him\" dengan perkataan \"supplies officer\". Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/16/msa@/~cl_7",
      "@type": "akn:clause",
