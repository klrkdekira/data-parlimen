      ],
      "schema:name": {
        "@language": "en",
        "@value": "Central Bank Of Malaysia (Amendment) Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Central Bank of Malaysia (Amendment) Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Except for section 3, this Act comes into operation on a date to be appointed by the Minister by notification in the Gazette,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 is deemed to have come into operation on 16 February 2006. Amendment of section 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Central Bank of Malaysia Act 1958 [Act 579], which is referred to as the \"principal Act\" in this Act, is amended in subsection 30(1) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (bb)(i)~"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"the Minister, securities\" the words \"other than securities issued under subparagraph (bbb)(\\)\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the proviso the following proviso: \"Provided that the total amount of securities so issued shall not at any time exceed fifty per centum of the amount of the General Reserve Fund of the Bank;\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (bb) the following paragraph: \"(bbb) (i) issue securities in its own name for the purpose of conducting monetary policy operations and the issue, holding and sale of such securities shall be subject to such terms and conditions as the Bank may determine at the time of the issue of such securities: Provided that the total amount of securities so issued shall not at any time exceed the amount of the Bank's reserve of external assets; ( i i) purchase, sell and redeem securities issued by the Bank pursuant subparagraph (bbb)(i) for the purpose of conducting monetary policy operations;\". Amendment of section 30A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 30A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the shoulder note the following shoulder note: \"Establishment of body corporate for training, credit counselling, etc.\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection ( 1) the following subsection: \"(1) Notwithstanding section 31, the Bank may — (a) establish a body corporate for the purposes of training, research and development of human resource in relation to banking and financial services; and Central Bank of Malaysia (Amendment) 3 (b) establish a body corporate for the purposes of providing financial counselling, debt management services and education on financial management.\". Amendment of section 44A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 44A of the principal Act is amended in the definition"
      },
      "schema:text": {
        "@language": "en",
        "@value": "of \"debt securities\" by substituting for the words \"paragraph 30(\\)(bb)\" in paragraph (d) the words \"paragraphs 30(l)(bb) and 30(\\)(bbb)\"."
      }
    }
  ]
}
