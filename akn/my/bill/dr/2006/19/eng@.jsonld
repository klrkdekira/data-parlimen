      "schema:name": {
        "@language": "en",
        "@value": "Tunku Abdul Rahman Foundation Fund (Amendment) Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) This Act may be cited as the Tunku Abdul Rahman Foundation Fund (Amendment) Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act is deemed to have come into operation on 27 March 2004. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Tunku Abdul Rahman Foundation Fund Act 1966 [Act 389], which is referred to as the \"principal Act\" in this Act, is amended in section 2 in the definition of \"Minister\", by substituting for the words \"Minister of Education\" the words \"Minister of Higher Education\" . Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 5( I )(b) of the principal Act is amended by substituting for the words \"Ministry of Education\" the words \"Ministry of Higher Education\"."
      }
    }
  ]
