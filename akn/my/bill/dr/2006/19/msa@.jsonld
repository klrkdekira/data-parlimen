        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kumpulan Wang Yayasan Tunku Abdul Rahman (Pindaan) 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini disifatkan telah mula berkuat kuasa pada 27 Mac 2004. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kumpulan Wang Yayasan Tunku Abdul Rahman 1966 [Akta 389], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2 dalam takrif \"Minister\", dengan menggantikan perkataan \"Minister of Education\" dengan perkataan \"Minister of Higher Education\". Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 5(1)(b) Akta ibu dipinda dengan menggantikan perkataan \"Ministry of Education\" dengan perkataan \"Ministry of Higher Education\"."
      }
    }
  ]
