        "@value": "Rang Undang-Undang Kumpulan Wang Yayasan Tunku Abdul Rahman (Pindaan) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
