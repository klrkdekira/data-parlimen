      ],
      "schema:name": {
        "@language": "en",
        "@value": "Care Centres (Amendment) Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 21 the following section: \"Compounding of offences 21A. (1) The Director General may, with the consent of the Public Prosecutor, compound any offence committed by any person against this Act or any regulations made under this Act by making a written offer, in the form as may be prescribed, to the person reasonably suspected of having committed the offence to compound the offence upon payment to the Director General of an amount of money not exceeding fifty per centum of the amount of maximum fine for that offence within the time specified in the offer. (2) An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time as specified in the offer, or within such extended period as the Director General may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made. (3) Where the offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Care Centres (Amendment) Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Care Centres Act 1993 [Act 506], which is referred to as the \"principal Act\" in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"residential care centre\" the following definition: ' \"State Director\" means the Director of Social Welfare of a State and includes the Director of Social Welfare of the Federal Territory of Kuala Lumpur, the Federal Territory of Labuan and the Federal Territory of Putrajaya respectively.'; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the English language text, by substituting for the full stop at the end of the definition of \"residential care centre\" a semicolon. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended—"
      }
    },
