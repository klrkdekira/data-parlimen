        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 18 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_8__para_a",
