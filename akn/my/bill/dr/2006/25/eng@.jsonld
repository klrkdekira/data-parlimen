      "schema:name": {
        "@language": "en",
        "@value": "Section 10 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/eng@/~cl_4__para_a",
