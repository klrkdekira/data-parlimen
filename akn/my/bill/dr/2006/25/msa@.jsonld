        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 18 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan memotong perkataan \"atau\" yang terdapat selepas koma bernoktah; 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f)% dengan menggantikan koma dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (f) perenggan yang berikut: \"(g) gagal menyebabkan suatu salinan perakuan pendaftaran itu dipamerkan mengikut subseksyen 10(4); (h) gagal memberitahu Ketua Pengarah tentang apa-apa perubahan dalam apa-apa hal keadaan yang butir-butirnya dinyatakan dalam perakuan itu mengikut subseksyen 10(5); atau (i) gagal menyerahkan perakuan pendaftaran itu apabilaberhenti mengendalikan suatu pusat jagaan mengikut subseksyen 10(6),\". Penggantian seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 21 dengan seksyen yang berikut: \"Pemulaan pendakwaan 21. Tiada pendakwaan bagi suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya.\". Seksyen baru 21A"
      }
    }
  ]
}
