      ],
      "schema:name": {
        "@language": "en",
        "@value": "Customs (Amendment) Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) This Act may be cited as the Customs (Amendment) Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 2(1) of the Customs Act 1967 [Act 235], which is referred to as the \"principal Act\" in this Act, is amended in the definition of \"customs duty\", by inserting after the words \"Countervailing and Anti-Dumping Duties Act 1993 [Act 504]\" the words \", any safeguard duty imposed by or under the Safeguards Act 2006 [Act ]\". Amendment of section 122c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 122c of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words \"and antidumping\" the words \", anti-dumping and safeguard\"; and Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"or anti-dumping duty\" the words \", anti-dumping duty or safeguard duty\"."
      }
    }
  ]
}
