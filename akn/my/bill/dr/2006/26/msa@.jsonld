      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kastam (Pindaan) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/26/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
