      ],
      "schema:name": {
        "@language": "en",
        "@value": "Bank Kerjasama Rakyat Malaysia Berhad (Special Provisions)(Amendment) Bill 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Bank Kerjasama Rakyat Malaysia Berhad (Special Provisions) (Amendment) Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank Kerjasama Rakyat Malaysia Berhad (Special Provisions) Act 1978 [Act 202], which is referred to as the \"principal Act\" in this Act, is amended by substituting for the word \"Ordinance\" wherever appearing the words \"Co-operative Societies Act 1993\". Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"Ordinance\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of ''Chairman\" the following definition: 1 \"Commission\" means the Malaysia Co-operative Societies Commission established under the Malaysia Co-operative Societies Commission Act 2006 [Act ];'. Amendment section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended by substituting for the word \"Registrar-General\" wherever appearing the word \"Commission\". Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 7(2) of the principal Act is amended in the national language text, by substituting for the words \"dan tanggungan\" the words \", tanggungan dan obligasi\". Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 14(4) of the principal Act is amended by substituting for the word \"33\" the word \"54\". Amendment of section 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 24(1) of the principal Act is amended in the national language text, by inserting after the words \"kepada Menteri\" the words \"dan Menteri Kewangan\". Bank Kerjasama Rakyat Malaysia Berhad 3 (Special Provisions) (Amendment) Amendment of First Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/28/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The First Schedule to the principal Act is amended by"
      },
      "schema:text": {
        "@language": "en",
        "@value": "substituting for subparagraph 1(2) the following subparagraph: '\"(2) The Minister may appoint the Chairman and other members of the Board.\"."
      }
    }
  ]
}
