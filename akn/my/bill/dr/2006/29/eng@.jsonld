    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/29/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2006) Act 2006. Further expenditure for the year 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/29/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding four billion one hundred and twenty-seven million four hundred and eighty-three thousand four hundred and forty-three ringgit (RM4,127,483,443) from the Consolidated Fund for expenditure on the services and purposes specified in the Schedule for the year 2006 not provided for or not fully provided for by the Supply Act 2006 [Act A1259] ."
      }
    },
