      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan AktaPerbekalan Tambahan (2006)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2006. Perbelanjaan tambahan bagi tahun 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/29/msa@/~cl_2",
      "@type": "akn:clause",
