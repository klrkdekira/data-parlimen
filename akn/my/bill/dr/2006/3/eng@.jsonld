      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROVISIONS RELATING TO STUDENTS Discipline of students of the Akademi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI",
