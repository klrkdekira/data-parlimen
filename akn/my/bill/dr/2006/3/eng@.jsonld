      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_52"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "TRANSITIONAL Revocation of registration of the Akademi Seni Kebangsaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "The registration of the Akademi Seni Kebangsaan under section 79 of the Education Act 1996 [Act 550] is revoked. Transfer of powers, rights, duties, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, all powers, rights, privileges, duties, liabilities or obligations which immediately before the appointed date were those of the Akademi Seni Kebangsaan, shall, as from that date, devolve on the Akademi established by this Act. Transfer of property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, any land which immediately before the appointed date was held in the name of the Federal Lands Commissioner and occupied by the Akademi Seni Kebangsaan, shall on that date, by virtue of this Act be transferred to and vested in the Akademi without any conveyance, assignment or transfer whatever."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, and to any direction of the Minister, all property and assets other than land which immediately before the appointed date were vested—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the Government of Malaysia on behalf of the Akademi Seni Kebangsaan; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in any person on behalf of or in respect of the Akademi Seni Kebangsaan; shall, on that date, vest in the Akademi established by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "It is hereby declared that any property, whether movable or immovable, which, immediately before the appointed date, was used for the purposes which after that date become the purposes of the Akademi established by this Act shall, on that date, be vested in the Akademi. Existing contracts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, and to any direction of the Minister, all deeds, bonds, agreements, instruments and working arrangements subsisting immediately before the appointed date and affecting any of the property transferred under section 46 shall have full force and effect against or in favour of the Akademi established by this Act and shall be enforceable as fully and effectually as if, instead of the Akademi Seni Kebangsaan or Government of Malaysia in respect of the Akademi Seni Kebangsaan, the Akademi established by this Act had been named therein or had been a party thereto. Continuance of civil and criminal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, any proceedings, whether civil or criminal, or any cause of action pending or existing immediately before the appointed date by or against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Akademi Seni Kebangsaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Government of Malaysia in respect of the Akademi Seni Kebangsaan; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person acting on behalf of the Akademi Seni Kebangsaan, may be continued or instituted by or against the Akademi as it might have been by or against the same respectively as if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought or any leave to appeal applied for on or after the appointed date against a decision given in any legal proceedings before that date to which the Akademi Seni Kebangsaan, the Government of Malaysia in respect of the Akademi Seni Kebangsaan or any person acting on behalf of the Akademi Seni Kebangsaan was a party, may be brought by or against the Akademi established by this Act. Transfer of fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "All moneys standing in, belonging or due to be paid to, the fund of the Akademi Seni Kebangsaan or the Government of Malaysia in respect of the Akademi Seni Kebangsaan, shall on the appointed date be vested in the Akademi established by this Act, be transferred to and be deemed to be part of the Fund established under section 27 of this Act. Continuance of officers and staff"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who immediately before the appointed date was employed as an officer or staff of the Akademi Seni Kebangsaan shall, on that date, be deemed to have been employed by the Akademi established by this Act as if the said Akademi had existed prior to that date throughout the service of such officer or staff in the Akademi Seni Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who immediately before the appointed date was employed as an officer or staff of the Akademi Seni Kebangsaan shall, on that date, be employed as an officer or staff, as the case may be, of the Akademi established by this Act upon terms and conditions of service not less favourable than the terms and conditions of service to which he was entitled immediately before the appointed date. Students"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "All persons who immediately before the appointed date were students of the Akademi Seni Kebangsaan shall, on that date, be deemed to be students of the Akademi. Pending disciplinary proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "All disciplinary proceedings which, immediately before the appointed date, were pending against any student of the Akademi Seni Kebangsaan may, on or after that date, be continued against the student by the appropriate authority of the Akademi under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may issue directions of a general character consistent with the provisions of this Act to the Board and the Board shall give effect to such directions. Power of Minister to delegate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, subject to such conditions, limitations or restrictions as he may specify, delegate to the Board the exercise or performance of any of his powers or functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may be revoked at any time by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not prevent the Minister from himself exercising, discharging or performing such delegated powers, duties or functions in any case where it appears to him expedient to do so. Convocation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "A convocation for the conferment of academic and professional qualifications or awards, diplomas, certificates and other academic distinctions shall be held annually, or as often as the Rector may direct, on such date as may be approved by the Minister. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceeding against the Akademi or against the Board or any member of the Board, or against the Rector, or against any officer, member of the staff or agent of the Akademi in respect of any act, neglect or default done or committed by it or by him, as the case may be, in such capacity. Public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All members of the Board, the Rector, the officers, members of the staff or agents of the Akademi while discharging their duties or carrying out their functions or exercising their powers shall be deemed to be public servants within the meaning of the Penal Code [Act 574]. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the purpose of this Act or of any civil or criminal proceedings, a member of the Board, or the Rector, or an officer or a member of the staff or agent of the Akademi shall not disclose any information in respect of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection ( 1) commits an offence and shall be liable on conviction to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding twelve months or to both. Civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any written law to the contrary, in civil proceedings by or against the Akademi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "any person holding the appointment of a Federal Counsel and authorized by the Attorney General for the purpose; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "any officer of the Akademi authorized in that behalf by special or general directions of the Rector, may, on behalf of the Akademi, commence, appear in and conduct such proceedings and may make and do all appearances, acts, and applications in respect of such proceedings. Act or omission done in good faith"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "No action or suit shall be instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Rector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Rector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Registrar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Bursar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "the Board of Studies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the Board of Studies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "a staff of the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "a person authorized to act for or on behalf of any of the bodies or persons under paragraphs (a) to (i), for any act or omission done in good faith in the exercise or discharge of its or his powers or duties under this Act in a reasonable belief that it was necessary for the purpose intended to be served thereby. Service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Service of any notice under this Act or any subsidiary legislation made thereunder shall be effected by registered post to the person affected thereby and shall be deemed to have been served on the day succeeding the day on which the notice would have been delivered in the ordinary course of post."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person to whom there has been addressed a registered letter containing any notice which may be given under this Act or any subsidiary legislation made thereunder is informed orally or in writing of the fact that there is a registered letter awaiting him at a post office, and such person refuses, neglects or fails to take delivery of such registered letter, such notice shall be deemed to have been served upon him on the date on which he is so informed. Power of Board to make rules"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Board may make all such rules as may be necessary for the purpose of giving effect to the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "In particular, and without prejudice to the generality of subsection (1), such rules may provide for all or any of the following matters, namely —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the preparation, audit, and submission to the Minister of estimates, budgets, statements and returns;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the functions and duties of the staff;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the determination of the principles governing the award of academic and professional qualifications, recognitions or awards, diplomas, certificates and other academic distinctions to be conferred by the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions of admission and welfare of students;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the discipline of the students of the Akademi, including prescribing the disciplinary offences, disciplinary punishments and the procedure for disciplinary proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the forms required for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any matter within the powers of the Akademi under section 5 or under any other provision of this Act. Amendment of Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may from time to time amend the Schedule by order published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act a fund to be known as the Akademi Seni Budaya dan Warisan Kebangsaan Fund which shall be administered and controlled by the Board is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided from time to time by Parliament;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may from time to time be lent to the Akademi by the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any voluntary gift to the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys earned by the operation of any project, scheme or enterprise financed from the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any property, investment, subvention, lease, mortgage, charge or debenture acquired by or vested in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys earned or arising from any property, investment, subvention, lease, mortgage, charge acquired by or vested in the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other sums or property which may in any manner become payable to or vested in the Akademi in respect of any matter incidental to its powers, functions and duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "All the moneys paid to the Akademi shall be applied or expended by the Akademi for all or any of the purposes of the Akademi in accordance with the estimates approved by the Minister. Conservation of Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Board and the Rector to conserve the Fund by so exercising, performing and discharging their powers, functions and duties under this Act so as to secure that the total revenues of the Akademi are, subject to any direction given by the Minister under section 33, sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest on capital taking one year with another. Power to invest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi may invest in securities of the Government or such other securities as may be approved in advance in writing by the Minister of Finance such moneys of the Fund as may not be immediately required for current expenditure, with power from time to time to vary any such investment subject to the prior approval in writing by the Minister of Finance being obtained in respect of any variation resulting in any investment in securities other than Government securities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi may deposit, either in fixed deposit or in current account, any moneys for the time being uninvested with any bank in Malaysia holding a valid licence under the provisions of the Banking and Financial Institutions Act 1989 [Act 372] or the Islamic Banking Act 1983 [Act 276] and approved in advance in writing for the purpose by the Minister. Annual estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector shall, not later than April in each year, lay before the Board detailed estimates of revenue and expenditure of the Akademi, including capital expenditure, for the ensuing financial year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall not incur expenditure otherwise than in accordance with the estimates or supplementary estimates approved by the Minister: Provided that the Board may transfer all or any part of the moneys assigned—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "to one item of annually recurrent expenditure to another item of annually recurrent expenditure; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "to one item of capital expenditure to another item of capital expenditure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The annual and supplementary estimates shall show in separate parts, the annually recurrent expenditure and the capital expenditure of the Akademi. Statutory Bodies (Accounts and Annual Reports) Act 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The estimates shall contain all such details as the Board may require and shall be in such form as the Board may determine, or as may be prescribed by rules made under section 42."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of such estimates shall be sent to each member of the Board not less than fourteen days prior to the meeting before which the estimates are to be laid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall consider the estimates so submitted and shall sanction the same either unaltered or subject to such alteration as it thinks fit, and such alteration may include the addition, modification or the rejection of any item appearing in the estimates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may before sanctioning the estimates under subsection (4) refer any item back to the Rector for his reconsideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Such estimates as sanctioned by the Board shall be submitted to the Minister, who may disallow or alter such estimates or any portion thereof, or modify any item thereof, or add any item thereto, or reject any item therefrom."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where additional financial provision is required in any year the Board may, from time to time, during the year cause a supplementary estimate to be prepared by the Rector and submitted to it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Every such supplementary estimate shall be considered and sanctioned by the Board, and submitted to the Minister, who shall deal with it as if it were an original annual estimate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A supplementary estimate prepared under this section shall show the sources from which the additional expenditure shown in the supplementary estimate is to be met."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240] shall apply to the Akademi. Imposition of surcharge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) A person who is or was a staff of the Akademi may be surcharged if it appears to the Board that the person-fa) has failed to collect moneys owing to the Akademi for the collection of which he is or was responsible;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "is or was responsible for any improper payment of money from the Fund or for any payment of moneys which is not duly approved;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "is or was responsible, directly or indirectly, for any deficiency in, or for the destruction of, any moneys, stamps, securities, stores or other property of the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "being or having been an accounting officer, fails or has failed to keep proper accounts or records; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "has failed to make any payment, or is or was responsible for any delay in the payment from the Akademi, of moneys to any person to whom the payment is due under any law, contract, agreement or arrangement entered into between that person and the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall, before a person is surcharged under subsection (1), serve on him a written notice calling on him to show cause why he should not be surcharged."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "If a satisfactory explanation is not received within thirty days from the date of service of the notice under subsection (2), the Board may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraphs (l)(a), (b) and (c), surcharge against the person a sum not exceeding the amount not collected, or of the improper payment made, or of the deficiency in the value of, or loss of, the moneys, stamp, security, store or other property of the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraphs (l)(d) and (e), surcharge against the person such sum as the Board may think fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall notify the person surcharged in respect of any surcharge made under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsections (3) and (4), the Board may at any time withdraw any surcharge in respect of which a satisfactory explanation has been received or if it otherwise appears that no surcharge should have been made, and the Board shall at once notify the person surcharged of the withdrawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The amount of any surcharge made under subsection (3) and not withdrawn under subsection (5) shall be a debt due to the Akademi from the person surcharged and may be sued for and recovered in any court at the suit of the Akademi and may also if the Board so directs be recovered by deduction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "from the salary of the person surcharged; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "from the pension of the person surcharged, by equal monthly instalments not exceeding one-fourth of the total monthly salary or pension, as the case may be, of that person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "In any action for surcharge against the Rector, the composition of the Board for the purposes of subsections (1) to (6) shall not include the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph (\\)(d), \"accounting officer\" includes every staff of the Akademi charged with the duty of collecting, receiving, or accounting for, or who in fact collects, receives or accounts for, any money of the Akademi, or who is charged with the duty of disbursing, or who does in fact disburse, any such money, and every staff who is charged with the receipt, custody or disposal of, or the accounting for, any money, stamp, security, store or property of the Akademi or who in fact receives, holds or di sposes of such money, stamp, security, store or property."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector shall have disciplinary authority over every student."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector shall have the power to take disciplinary action and impose any disciplinary punishment provided under the rules made under section 42."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector may delegate any of his disciplinary powers, duties or functions to the Deputy Rector or any member of the staff, in respect of any particular student, or any class or category of students of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Rector or the member of the staff to whom disciplinary powers, duties or functions under subsection (3) have been delegated shall exercise, discharge or perform them under the direction and control of the Rector who shall have the power to review, rescind or vary any decision or finding of the Deputy Rector or such member of the staff."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any student dissatisfied with the decision of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the Rector; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "any person delegated with powers, duties or functions under subsection (3), may appeal against such decision to the Minister and the Minister may, if he deems fit, reject the appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Minister does not reject the appeal under subsection (5), he shall appoint a committee of two or more persons, from within or outside the Akademi, to consider the appeal and make its recommendations to him, and, upon receiving such recommendations, the Minister may give such decision on the appeal as he considers fit and proper. Students' Representative Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall have a Students' Representative Committee (the \"SRC\")."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Second Schedule shall apply to the SRC. Establishment of other student bodies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 18, it shall be lawful for not less than ten students —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the prior written approval of the Rector given after obtaining the concurrence of the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "subject to such terms and conditions as the Rector may specify, to establish a student body consisting of students for the promotion of a specific object or interest within the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Second Schedule, except paragraphs 1 and 7, shall apply with such modifications as may be necessary to a student body under this section as they apply to the SRC. Dissolution of the SRC or other student body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector may, in his absolute discretion, without assigning any reason therefor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "suspend or dissolve the SRC, or any student body established under section 19; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "give such consequential directions or instructions or take such consequential steps as may be necessary or expedient to give effect to the suspension or dissolution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The suspension or dissolution of the SRC, or a student body established under section 19 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall take immediate effect upon the making of the decision to suspend or dissolve the same; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be final. Prohibition on student or students' organization, body or group associating with societies, etc. except as approved by the Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) No person, while he is a student, shall be a member of, or shall in any manner associate with, any society, political party, trade union or any other organization, body or group of persons —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "whether or not it is established under any law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "whether it is within or outside the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "whether it is within or outside Malaysia, except as may be provided by or under this Act, or except as may be approved in advance in writing by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "No organization, body or group of students established by, under or in accordance with this Act, shall have any affiliation, association or other dealing with, any society, political party, trade union or any other organization, body or group of persons —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whether or not it is established under any law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whether it is within or outside the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whether it is within or outside Malaysia, except as may be provided by or under this Act, or except as may be approved in advance in writing by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "No person, while he is a student and no organization, body or group of students which is established by, under or in accordance with this Act, shall express or do anything which may be construed as expressing —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "support, sympathy or opposition to any political party or trade union; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "support or sympathy to any unlawful organization, body or group of persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1), (2) or (3) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding six months or to both. Prohibition on collection of money by student or by organization, body or group of students"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "No student, organization, body or group of students which is established by, under or in accordance with this Act, shall, within or outside the campus, or within or outside Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "collect or attempt to collect;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "promote or attempt to promote any collection of; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make or attempt to make any appeal orally or in writing or otherwise for, any money or other property from any person, not being money or property due or about to fall due under or by virtue of any written law, contract or other legal obligation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in any particular case, in his absolute discretion, grant exemption to any person from the application of subsection (1), subject to such terms and conditions and for such period as he may, in his absolute discretion, deem fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the provisions of this Act or any other written law relating to the delegation of powers, the Minister may, by notification in the Gazette, delegate the exercise of his powers under subsection (3) to the Rector in respect of the collection of money within the campus from persons within the campus, subject to such conditions and restrictions as may be specified in such notification."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section shall be in addition to and not in derogation of the provisions of any written law relating to house to house and street collections, public collections, or collection of money or sale of badges. Criminal liability of office-bearers, etc., of a students' organization, body or group"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where any offence has been committed under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether or not any person has been convicted in respect thereof; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such offence has been committed or purports to have been committed in the name or on behalf of any organization, body or group of students which is established by, under or in accordance with this Act; every office-bearer of such organization, body or group of students and every person managing or assisting in the management of such organization, body or group of students at the time of the commission of such offence shall be deemed to be guilty of such offence and shall be liable to the punishment prescribed by law, unless he establishes to the satisfaction of the court that the offence was committed without his knowledge and that he had exercised all due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any office-bearer of, or any person managing or assisting in the management of, any organization, body or group referred to in subsection (1) shall be liable to be prosecuted under this section, notwithstanding that he may not have taken part in the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "In any prosecution under this section of an office-bearer of, or any person managing or assisting in the management of, any organization, body or group referred to in subsection (1), any document found in the possession of any office-bearer of, or person managing or assisting in the management of, such organization, body or group, or in the possession of a member of such organization, body or group shall be prima facie evidence of the contents thereof for the purpose of proving that anything has been done or purports to have been done by or on behalf of such organization, body or group. Presumptions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "In any prosecution under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "it shall not be necessary for the prosecution to prove that an organization, a body or group of persons possesses a name or that it has been constituted or is usually known under a particular name;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "where any books, accounts, writings, lists of members, seals, banners or insignia of, or relating to, or purporting to relate to, any organization, body or group of persons are found in the possession, custody or under the control of any person, it shall be presumed, until the contrary is proved, that such person is a member of such organization, body or group and such organization, body or group shall be presumed, until the contrary is proved, to be in existence at the time such books, accounts, writings, lists of members, seals, banners or insignia are so found; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "where any books, accounts, writings, lists of members, seals, banners or insignia of, or relating to, any organization, body or group of persons are found in the possession, custody or under the control of any person, it shall be presumed, until the contrary is proved, that such person assists in the management of such organization, body or group. Suspension and expulsion of student charged with a criminal offence or against whom a criminal offence is proved"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_1__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where a student is charged with a criminal offence- fa) he may, immediately thereupon, be suspended from being a student; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he shall not, if so suspended under paragraph (a), pending the criminal proceedings, remain in or enter the campus of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where a court finds that a charge for a criminal offence is proved against a student- fa) the student shall, immediately thereupon, cease to be a student; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the student shall not, immediately thereupon, remain in or enter the campus of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A student who is detained or who is subjected to any order imposing restrictions on him under any written law relating to preventive detention or internal security—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall, immediately thereupon, cease to be a student; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall not, immediately thereupon, remain in or enter the campus of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A student who ceases to be a student under subsection (2) or (3) shall not, after the expulsion, be admitted as a student of the Akademi without the prior written approval of the Minister, and if the Minister grants such approval, the Minister may impose such terms and conditions as he may, in his absolute discretion, deem fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any person —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "who remains in or enters the campus of the Akademi in contravention of subsection (1), (2) or (3); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "who obtains admission to the Akademi in contravention of subsection (4), commits an offence and shall on conviction be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1), (2), (3), (4) and (5) shall apply to a person notwithstanding that there may be pending in any court or before any other authority any application, petition, appeal or other proceedings by him or by any other person in respect of the criminal proceedings, the detention or the order imposing restrictions, as the case may be: Provided that upon the determination of such application, petition, appeal or other proceedings the Minister may, in his absolute discretion, have regard to such determination and grant exemption to the student from the application of subsection (1), (2), (3), (4) or (5), as the case may be, upon such terms and conditions as he may, in his absolute discretion, deem fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, in any particular case, in his absolute discretion, grant exemption to any person from the application of subsection (1), (2), (3), (4) or (5), as the case may be, either—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "unconditionally;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "upon such terms and conditions; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_25__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "for such period, as he may, in his absolute discretion, deem fit. Board's power to suspend or expel a student from the Akademi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon representations made by the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_b__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "after hearing the student, if it is satisfied that it is desirable to do so in the interest of the Akademi, order in writing that any student— (i) be suspended from being a student for such period as the Board may specify in the order; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "be expelled from the Akademi, and such student shall, immediately thereupon, be so suspended or expelled, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A student in respect of whom the Board has given an order in writing under subsection (1) may, within thirty days from the date of such order, appeal to the Minister for the revocation or variation of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give such decision with regard to any appeal made under subsection (2) as it may deem fit and proper, and such decision shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "An order to suspend a student under subsection (1) may, from time to time, be extended for such period as the Board may specify in respect of each extension."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A student—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "who is suspended from being a student; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "who is expelled from the Akademi, under subsection (1), shall not, during the suspension, or after the expulsion, as the case may be, remain in or enter the campus of the Akademi except with the prior written approval of the Board, and if the Board grants such approval, the Board may impose such conditions as it may, in its absolute discretion, deem fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A student who is expelled from the Akademi under subsection (1) shall not, after the expulsion, be admitted as a student of the Akademi without the prior written approval of the Board, and if the Board grants such approval, the Board may impose such conditions as it may, in its absolute discretion, deem fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A student—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "who remains in or enters the campus of the Akademi in contravention of subsection (5); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_26__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "who obtains admission to the Akademi in contravention of subsection (6), commits an offence and shall on conviction be liable to a fine not exceeding one thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 8] Disqualification"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "A person shall be disqualified from being appointed or being a member of the Board—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceedings taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of, or of any defect in the constitution of, the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "the contravention by a member of the Board of paragraph 9; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity not affecting the merits of the matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted on, a charge in respect of— (i) an offence involving fraud, dishonesty or moral turpitude; ( i i) an offence under a law relating to corruption; (iii) an offence under this Act; or (iv) any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes a bankrupt; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "if he has been found or declared to be of unsound mind or has otherwise become incapable of managing his affairs. Cessation from being a member"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "A member of the Board shall cease to be a member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "if he fails to attend three consecutive meetings of the Board without leave of the Chairman; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "if his appointment is revoked. Resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Board may resign at any time by giving one month's notice in writing to the Chairman. Filling of vacancies *"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person ceases to be a member of the Board by reason of any of the provisions of this Act, another person may be appointed by the Minister to fill the vacancy for the remainder of the term for which the member was appointed. Allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Members of the Board shall be paid such allowances as the Minister may determine. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside over all meetings of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and every member of the Board shall have and may exercise one vote each, but in the event of an equality of votes, the Chairman shall have and may exercise a casting vote in addition to his original vote. s. Board may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may invite any person to attend a meeting or deliberation of the Board for the purpose of advising it on any matter under discussion but any person so attending shall not have the right to vote at the said meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subparagraph (1) shall be paid such allowances as the Board may determine. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of meetings of the Board shall, if duly signed, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Board in respect of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "( 1 ) A member of the Board having, directly or indirectly—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "any interest in any company or undertaking with which the Board proposes to enter into a contract; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "any interest in any such contract or in any matter under discussion by the Board, shall disclose to the Board the fact of his interest and its nature."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subparagraph (1) shall be recorded in the minutes of the Board and, unless specifically authorized by the Chairman, such member shall take no part in any deliberation or decision of the Board relating to the contract or matter. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Sections 18 and 19] STUDENTS' REPRESENTATIVE COMMITTEE Election of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "In electing a Students' Representative Committee, the students of each particular field shall elect, by secret ballot conducted by the Rector, such uniform number of students studying in the respective fields to be representatives in the SRC as may be determined by the Rector; and the division of the education provided in the Akademi into various fields of study for the purposes of this paragraph shall be made by the Rector. Office-bearers of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "The SRC shall hold meetings from time to time as it may deem necessary and it shall be the duty of the Secretary to keep minutes of every meeting of the SRC and such minutes shall be confirmed at a subsequent meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "The SRC or an ad hoc committee of the SRC shall, not less than forty- eight hours before holding any meeting, give notice of the date and time of the meeting and its agenda to the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the SRC or of an ad hoc committee of the SRC shall be held only at a place provided for the purpose of such meetings by the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector or his representative shall be present at each meeting of the SRC or of an ad hoc committee of the SRC, unless the Rector decides otherwise in respect of any particular meeting. Inspection of records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "The records of the SRC or of an ad hoc committee of the SRC shall at all times be open to inspection by the Rector or his representative. Disputes as to elections"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) If any dispute arises as to whether any member or office-bearer of the SRC or of an ad hoc committee of the SRC-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12",
      "schema:text": {
        "@language": "en",
        "@value": "has been duly elected or appointed, as the case may be; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12",
      "schema:text": {
        "@language": "en",
        "@value": "is entitled to be or to remain a member or office-bearer thereof, the dispute shall be decided by the Rector or by a person appointed by him for that purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_12",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Rector or of the person appointed by him under subparagraph (1) shall be final. Definition of \"student\" for the purpose of this Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13",
      "@type": "akn:paragraph",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this Schedule, \"student\" does not include a public officer who is following a course of study in the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13",
      "schema:text": {
        "@language": "en",
        "@value": "A person shall cease to be a student within the meaning of this paragraph —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "upon the publication of the results of the final examination of such course of study, if he passes such examination; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "upon the publication of the results of any examination for such course of study, if he fails such examination, until he is, thereafter, registered again for that or another course of study applicable to a registered student under this paragraph."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:name": {
        "@language": "en",
        "@value": "The SRC shall elect from amongst its members —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "a President;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Vice-President;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Secretary; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Treasurer, who shall be its only office-bearers. Term of office of SRC and its office-bearers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the SRC and its office-bearers shall be elected for one year. Decisions by majority vote"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "The SRC's decisions shall be taken by a majority vote with not less than two-thirds of the members being present and voting. Ad hoc committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "The SRC may form, from time to time, with the prior written approval of the Rector, ad hoc committees from amongst its members for specific purposes or objects. Disqualification in respect of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:name": {
        "@language": "en",
        "@value": "(1J No student—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "against whom disciplinary proceedings are pending; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "who has been found guilty of a disciplinary offence, shall be elected or remain a member of the SRC unless authorized in writing by the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "A student—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has not yet appeared for his first examination in respect of his course of studies; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has failed, or who did not appear for, the last examination held in respect of his course of studies, immediately prior to any proposed election or elections to the SRC or by the SRC shall be disqualified from being elected at such election or elections. Objects and functions of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:name": {
        "@language": "en",
        "@value": "The objects and functions of SRC shall be —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "to assist and encourage, subject to the direction of the Rector, the development of the facilities for students such as recreational facilities and the supply of meals and refreshments;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "to make representations to the Rector on matters relating to the conditions in which the students live and study; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake such other activities as may be determined by the Rector from time to time. Expenses of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The SRC shall not-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "maintain any fund; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make any collection of any money or property, from any source."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any reasonable expenses as the SRC may be authorized in advance in writing by the Rector to incur may be paid by the Akademi where reasonable written claims supported by receipts and vouchers are submitted by the SRC to, and are approved by, the Rector. Accounts of SRC"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_9__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Treasurer shall keep proper accounts of the SRC which shall be audited by a person appointed by the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~sched_2__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the accounts kept under subparagraph (1) shall be submitted by the SRC for approval to the Rector not later than three months after the end of each financial year, being a financial year as specified by the Rector. Meetings of SRC"
      }
    }
  ]
}
