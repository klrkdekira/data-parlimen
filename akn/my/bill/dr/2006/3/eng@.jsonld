        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "THE AKADEMI SENI BUDAYA DAN WARISAN KEBANGSAAN Establishment of the Akademi Seni Budaya dan Warisan Kebangsaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CONSTITUTION AND POWERS OF BOARD OF DIRECTORS The Board of Directors"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, subject to such conditions, limitations or restrictions as it thinks fit, delegate to any member or any committee of its members the power and authority to exercise and carry out on its behalf such powers or functions vested in the Board under this Act as the Board may determine; and any power or function so delegated may be exercised or performed by such member or by such committee, as the case may be, in the name and on behalf of the Board, but subject to the direction and control of the Board. Committees of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) For the purpose of enabling it to exercise its powers and perform its functions, the Board may appoint such committees as it thinks necessary or desirable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under subsection (1) shall deliberate upon matters referred to it by the Board and make appropriate recommendations thereon to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The chairman of a committee established under subsection (1) shall be appointed by the Board or, where the Board so directs, by the members of the committee from amongst themselves."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, and to any direction given by the Board, a committee established under subsection (1) may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under subsection (1) shall conform to any direction or instruction given to it from time to time by the Board and the Board may, at any time, discontinue, or alter the constitution of, the committee so appointed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the First Schedule, except paragraph 7, shall apply to a committee established under subsection (1) as they apply to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_7__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In the application of the First Schedule to a committee- fa) references to the Board shall be construed as references to the committee; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_11__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "references to the Chairman shall be construed as references to the chairman of the committee. The Board of Studies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be constituted a Board of Studies of the Akademi to advise the Board on all academic matters of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board of Studies may delegate any of its functions or duties to its committees or subcommittees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board of Studies may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the First Schedule, except paragraph 7, shall apply to the Board of Studies established under this section as they apply to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "In the application of the First Schedule to the Board of Studies—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "references to the Board shall be construed as references to the Board of Studies; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_13",
      "schema:text": {
        "@language": "en",
        "@value": "references to the Chairman shall be construed as references to the chairman of the Board of Studies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board of Studies shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Rector as chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all the Deputy Rectors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all Heads of Faculties, Departments or Centres, as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "three senior members of the academic staff of the Akademi appointed by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall be the Secretary of the Board of Studies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The appointments under paragraph 2(d) shall be for a period specified in the appointment letter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector may co-opt any other persons to be members of the Board of Studies or to attend the meetings of the Board of Studies, but a person co-opted shall not have the right to vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "In the absence of the Rector, a Deputy Rector shall preside at any meeting of the Board of Studies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board of Studies shall make recommendations to the Board on all matters relating to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the content and organization of the courses of study provided in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the method of education, instructions and training conducted in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the educational standards in the courses of study provided in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the curricula and courses of study conducted in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the feasibility or otherwise of any proposal in respect of any curriculum or course of study conducted or to be conducted in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the determination of the qualifications required for admission into any course of study provided in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the proposals for the establishment of any new course of study to be conducted, or the discontinuance of any existing course of study conducted, in the Akademi; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the awards of academic honours, fellowships, professional qualifications, prizes, scholarships and other academic distinctions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No resolution shall be passed by the Board relating to any matter referred to in subsection (7) unless the Board of Studies has first been given the opportunity of recording and transmitting to the Board its opinion thereon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of enabling it to perform its functions and discharge its duties, the Board of Studies may appoint such committees or subcommittees consisting of its members as well as any persons co-opted as members under subsection (5), provided that any person co-opted shall not have the right to vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be constituted a Board of Directors of the Akademi to be known as the Board of Directors of the Akademi Seni Budaya dan Warisan Kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the First Schedule shall apply to the Board. Powers and functions of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Rector;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "two persons to represent the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "seven persons who in the opinion of the Minister possess the qualification and experience to be of assistance to the Board, and the well-being of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of the members of the Board, except the Rector, shall be made by the Minister for a period not exceeding three years and upon expiry of such period the members of the Board shall be eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member may at any time be revoked by the Minister without giving reasons for such revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint any member of the Board to exercise the functions of the Chairman—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "if the Chairman is unable, by reason of illness, leave of absence or any other cause, to perform his functions; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "during any period of vacancy in the office of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed as the Chairman under subsection (5) shall, during the period in which he is performing the functions of the Chairman under this section, be deemed to be the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall be the Secretary of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Five members of the Board shall form a quorum at any meeting of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_9__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Board shall be the executive body of the Akademi and may exercise all the powers conferred on the Akademi, save as otherwise provided by this Act or by any subsidiary legislation made hereunder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Board shall include the carrying on of all such activities and the doing of all such things as are necessary or advantageous and proper for the government, control and administration of the Akademi. Delegation of powers and functions of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be established an academy to be known as the \"Akademi Seni Budaya dan Warisan Kebangsaan\" (hereinafter referred to as \"the Akademi\")."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall be a body corporate with perpetual succession, and with full power and authority under such name —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to sue and be sued;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to have and use a common seal and from time to time to break, change, alter or make anew such seal as it shall deem fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to enter into contracts, to acquire, take, hold and enjoy movable and immovable property of every description, including any such property which may become vested in it by purchase, or by any exchange, grant, donation, lease, testamentary disposition or otherwise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to convey, assign, surrender, yield up, charge, sell, mortgage, lease, exchange, demise, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property of any description or any interest therein vested in the Akademi upon such terms as it deems fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to exercise, perform and discharge, in accordance with the provisions of this Act, all powers, functions and duties conferred, provided or imposed upon the Akademi by such provisions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the approval of the Minister, the Akademi may provide studies, courses and training in the fields of culture, arts and heritage which in particular may include fine art, cinematography or filming, choreography, drama, stage or cinematic acting, stage management, photography, designing, creative arts, dance, creative writing, screen play, script writing, archiving or subject pertaining to the archives, library science or subjects pertaining to library, museum subjects, television or electronic media productions, music and such other studies, course or training as the Board may decide from time to time. Non-application of Act 30, Act 550 and Act 555"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Universities and University Colleges Act 1971 [Act 30], Education Act 1996 [Act 550] and Private Higher Educational Institutions Act 1996 [Act 555] shall not apply to the Akademi. Powers of the Akademi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall, subject to the provisions of this Act, have the following powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to provide courses of study, to make provision for research, to hold examinations and to take such other steps as may appear necessary or desirable for education and training in the fields enumerated under subsection 3(3) or as determined by the Board and approved by the Minister from time to time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to confer internationally recognised academic and professional qualifications or awards, diplomas, certificates and other academic distinctions upon persons who have followed courses of study approved by the Akademi and have satisfied such other requirements as may be determined by the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to confer awards on persons who have contributed to the advancement or dissemination of knowledge or who have rendered distinguished public service as may be recommended by the Board, in the fields of culture, arts and heritage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to determine and prescribe the qualifications for the purpose of admission to the courses of study and examinations of the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to set up posts for academic and training purposes, lectureships, and other posts and offices, and to make appointments thereto;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to award recognitions, medals, prizes and other forms of distinctions or assistance in respect of the education and training provided by or in the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to enter into contracts and to appoint such staff either local or foreign, on terms agreed by both parties as may be required for the purposes of the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to grant loans or advances to the staff of the Akademi in pursuit of academic excellence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to grant loans or financial assistance to deserving students on such terms and conditions as may be approved by the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct research and production for the effective promotion and utilization of the research findings of the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to market and franchise the services, research findings, and products, of the Akademi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to demand and receive such fees as may from time to time be determined by the Board, or as may be prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to do all such acts and things, whether or not incidental to the powers aforesaid, as may be requisite in order to supplement, complement, improve or fulfil the objectives of the Akademi. Faculties, Departments or Centres"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi may establish faculties, departments or centres as may, from time to time, be determined by the Board, and such faculties, departments or centres shall bear such names as the Board may assign to them."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A faculty, department or centre shall be headed by a person to be appointed by the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The head of a faculty, department or centre shall be responsible to the Rector and shall perform such duties as may be assigned to him by the Rector. Conduct of study, jointly, etc., with any University, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi may, with the prior written approval of the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "conduct any course of study jointly or in association, affiliation, collaboration or by way of franchise or otherwise, with any University, University College, higher educational institution, or professional body, or any organization, within or outside Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "conduct any such course of study either wholly or partly within or outside Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The approval of the Minister under subsection (1) may be made subject to such terms and conditions as the Minister may deem fit to specify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall not give approval under subsection (1) unless he is satisfied that the Akademi has made all necessary arrangements with the University, University College, higher educational institution, or professional body, or organization concerned for the conduct of the course of study."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"affiliation\" includes the conduct of twinning programmes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFICERS AND OTHER STAFF OF THE AKADEMI Appointment, powers and duties of Rector and Deputy Rector"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a Rector of the Akademi who shall be appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Rector nominated under subsection (9) shall act during any period that the post of Rector is vacant. Registrar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, revoke the appointment of the Rector without assigning any reason therefor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the terms of office and other conditions of service of the Rector shall be determined by the Minister and shall be binding on the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector shall be the chief executive, administrative and academic officer of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Rector to ensure that the provisions of this Act and the subsidiary legislation made under this Act are observed, and he shall have all such powers as may be necessary for this purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Rector shall, subject to the provisions of this Act and the subsidiary legislation made under this Act, exercise general supervision over the arrangements for education, instruction, training, finance, administration, welfare and discipline in the Akademi, and may exercise such other powers as may be conferred upon him by this Act and any subsidiary legislation made thereunder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be one or more Deputy Rectors who shall be appointed by the Minister, after consultation with the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any fit and proper person either from within or outside the Akademi may be appointed as a Deputy Rector, and the terms of office and other conditions of service of a Deputy Rector shall be determined by the Minister after consultation with the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "If the Rector is unable by reason of illness, leave of absence or any other cause to exercise any of the functions of his office, the Deputy Rector or, if there is more than one Deputy Rector, any one of them as may be nominated by the Minister shall exercise such functions, and in the event of the absence or disability of the Deputy Rector or all the Deputy Rectors (if there be more than one), the Minister shall make such temporary arrangements as he may think fit for the exercise of such functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall have a Registrar who shall be appointed by the Board on such terms and conditions of service as may be approved by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall be the principal registry officer of the Akademi with such functions and duties as may be determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall perform his functions and discharge his duties under the direction and control of the Rector. Bursar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Akademi shall have a Bursar who shall be appointed by the Board on such terms and conditions of service as may be approved by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Bursar shall be the principal financial officer of the Akademi with such functions and duties as shall be assigned to him by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Bursar shall perform his functions and discharge his duties under the direction and control of the Rector. Appointment of other staff"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint, on such terms and conditions of service as may be approved by the Board, such other staff including appropriate academic staff as may be necessary for carrying out the purposes of the Akademi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the staff appointed under subsection (1) shall be under the general direction and control of the Rector."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Akademi Seni Budaya dan Warisan Kebangsaan Act 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Akademi\" means the Akademi Seni Budaya dan Warisan Kebangsaan established under section 3; \"Board\" means the Board of Directors of the Akademi Seni Budaya dan Warisan Kebangsaan constituted under section 8; \"Board of Studies\" means the Board of Studies of the Akademi established under section 12; \"Chairman\" means the Chairman of the Board; \"Rector\" means the Rector of the Akademi appointed under section 13 as the chief executive officer of the Akademi and \"Deputy Rector\" shall be construed accordingly; \"appointed date\" means the date appointed by the Minister under subsection 1(2). ■"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/3/eng@/~part_V__cl_17",
