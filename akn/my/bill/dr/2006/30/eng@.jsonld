        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29 of the principal Act is amended—"
      }
    },
