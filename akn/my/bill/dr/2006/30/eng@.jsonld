      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"in writing by the\" the words \"Perbadanan or\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@/~cl_8__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@/~cl_8__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by inserting after the words \"as notified by the\" the words \"Perbadanan or\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@/~cl_8__para_b__subpara_iii",
