      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by inserting after the words \"deducted to the\" the words \"Perbadanan or\". Amendment of section 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 32 of the principal Act is amended by substituting for subsection (2) the following subsection: \" (2) In the absence of the Chairman for any reason, the Minister shall appoint a member of the Board, except the Chief Executive, to carry out the duties of the Chairman.\". (Amendment) Deletion of sections 36, 37, 38, 39, 40, 41, 42, 43 and 44"
      }
    }
  ]
}
