      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Ahli Parlimen (Saraan) 1980 [Akta 237], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam Jadual Kedua di Ruang II di bawah tajuk \"Ahli Parlimen, Timbalan Yang di-Pertua Dewan Negara dan Timbalan Yang di-Pertua Dewan Rakyat\" seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan A, dengan menggantikan angka \"60,000\" dengan angka \"100,000\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan B(i), dengan menggantikan angka \"120,000\" dengan angka \"200,000\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
