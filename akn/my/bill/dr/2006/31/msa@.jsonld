      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen (Saraan) (Pindaan) 2006. Pindaan Jadual Kedua"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2",
