      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan B(ii), dengan menggantikan angka \"60,000\" dengan angka \"100,000\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/31/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
