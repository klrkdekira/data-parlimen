      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2007. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi sembilan puluh"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "satu bilion dua ratus lima puluh lima juta satu ratus lapan puluh sembilan ribu ringgit (RM91,255,189,000) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2007 adalah dengan ini dibenarkan, dan jumlah wang itu diperuntukkan bagi maksud- maksud yang dinyatakan dalam Jadual. /taftg Undang-Undang"
      }
    },
