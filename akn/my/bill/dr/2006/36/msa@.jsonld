      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Persatuan Nelayan (Pindaan) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Persatuan Nelayan (Pindaan) 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Persatuan Nelayan 1971 [Akta 44], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam teks bahasa kebangsaan, dengan menggantikan perkataan \"syarikat kerjasama\" di mana-mana jua terdapat dengan perkataan \"koperasi\". Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dalam seksyen 2, dalam takrif \"Persatuan Nelayan Kawasan\", dengan memotong perkataan \"dan termasuklah sesuatu syarikat kerjasama nelayan\". Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda dengan memotong subseksyen (7). Pemotongan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 34. Pemotongan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 35. Pemotongan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 36. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding untuk membubarkan secara paksa syarikat kerjasama nelayan yang masih belum selesai di bawah Akta ibu sebelum tarikh mula berkuat kuasanya Akta ini hendaklah, selepas tarikh mula berkuat kuasanya Akta ini diteruskan oleh Pendaftar Persatuan Nelayan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dibuat ketika pembubaran secara paksa syarikat kerjasama nelayan di bawah subseksyen (1) sebelum tarikh mula berkuat kuasanya Akta ini hendaklah, selepas tarikh mula berkuat kuasanya Akta ini, dibayar oleh Lembaga Kemajuan Ikan Malaysia seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/36/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, pertukaran nama \"syarikat kerjasama nelayan\" dalam teks bahasa kebangsaan kepada \"koperasi nelayan\", tidaklah menyentuh apa-apa hak atau obligasi syarikat kerjasama nelayan atau menjadikan cacat apa-apa prosiding undang- undang oleh atau terhadapnya, dan apa-apa prosiding undang-undang yang mungkin telah diteruskan atau dimulakan olehnya atau terhadapnya sebelum tarikh mula berkuat kuasanya Akta ini bolehlah diteruskan atau dimulakan di bawah namanya yang baru."
      }
    }
  ]
}
