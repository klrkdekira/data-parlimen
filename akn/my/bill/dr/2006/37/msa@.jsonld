      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pertubuhan Peladang (Pindaan) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Pertubuhan Peladang (Pindaan) 2006."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pemotongan seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pertubuhan Peladang 1973 [Akta 109], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dengan memotong seksyen 33. Pemotongan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 34. Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 35 Akta ibu dipinda dengan memotong subperenggan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding untuk membubarkan secara paksa koperasi berasaskan pertanian yang masih belum selesai di bawah Akta ibu sebelum tarikh mula berkuat kuasanya Akta ini hendaklah, selepas tarikh mula berkuat kuasanya Akta ini diteruskan oleh Pendaftar Pertubuhan Peladang seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/37/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dibuat ketika pembubaran secara paksa koperasi berasaskan pertanian di bawah subseksyen (1) sebelum tarikh mula berkuat kuasanya Akta ini hendaklah, selepas tarikh mula berkuat kuasanya Akta ini, dibayar oleh Lembaga Pertubuhan Peladang seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    }
  ]
}
