        "@value": "by inserting after the words \"the Board\" the words \"or Disciplinary Committee\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/eng@/~cl_13__para_a__subpara_ii",
