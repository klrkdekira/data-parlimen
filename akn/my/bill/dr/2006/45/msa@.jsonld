      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 24 Akta ibu dipinda dengan menggantikan perkataan \"ten thousand ringgit in the case of an individual, or fifty thousand ringgit in the case of a sole proprietorship, partnership or body corporate,\" dengan perkataan \"fifty thousand ringgit\". Pindaan seksyen 24B"
      }
