      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memasukkan selepas perkataan \"the Board\" perkataan \"or Disciplinary Committee,\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_13__para_d",
      "@type": "akn:paragraph",
