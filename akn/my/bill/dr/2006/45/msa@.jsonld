        "@value": "dalam subperenggan (2)(a)(i), dengan menggantikan perkataan \"Board\" dengan perkataan \"Disciplinary Committee\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_5__para_c",
