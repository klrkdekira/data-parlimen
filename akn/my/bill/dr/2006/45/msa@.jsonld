      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan ( l ) ( i ) , dengan menggantikan perkataan \"Board\" di mana-mana jua terdapat dengan perkataan \"Disciplinary Committee\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_f",
      "@type": "akn:paragraph",
