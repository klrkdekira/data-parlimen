      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan memasukkan selepas perkataan \"the Board\" perkataan \"or Disciplinary Committee\". Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_14",
