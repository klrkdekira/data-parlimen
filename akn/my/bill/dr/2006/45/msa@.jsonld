      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (lA)(b), dengan menggantikan perkataan \"five\" dengan perkataan \"fifty\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
