      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (l)(g), dengan menggantikan perkataan \"Board\" dengan perkataan \"Disciplinary Committee\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_e",
