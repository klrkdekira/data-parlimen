      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
