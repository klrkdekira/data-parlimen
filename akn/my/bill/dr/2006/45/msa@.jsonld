        "@value": "dengan memasukkan selepas perkataan \"The\" perkataan \"Disciplinary Committee or\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_i__subpara_ii",
