        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 4(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4__para_a",
