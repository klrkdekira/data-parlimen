    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"Board\" dengan perkataan \"Disciplinary Committee\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (l)(a), dengan menggantikan perkataan \"involving fraud or\" dengan perkataan \", including offences involving false or negligent certification, fraud,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1 )(b), dengan menggantikan perkataan \"Board\" dengan perkataan \"Disciplinary Committee\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_10__para_d",
      "@type": "akn:paragraph",
