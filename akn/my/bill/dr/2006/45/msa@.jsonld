      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (ec), dengan memasukkan selepas perkataan \"programmes\" perkataan \", including continuing professional development programmes,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (ed), dengan menggantikan perkataan \"accredited\" dengan perkataan \"recognized\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/45/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (ee) perenggan yang berikut: \"(ef) to appoint a body consisting of members from the Board, Professional Engineers and other persons as may be determined by the Board to advise the Government and the public on matters relating to engineering education, including the certification of such programmes;\". Pindaan seksyen 6"
      }
    },
