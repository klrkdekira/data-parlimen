      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 75 Akta ibu dipinda dengan menggantikan perkataan \"orang yang mengemukakan pelan\" dengan perkataan \"pemunya\" di mana-mana jua terdapat. Pindaan seksyen 85A"
      }
    },
