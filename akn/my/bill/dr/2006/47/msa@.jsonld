      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 70A(17)(C) Akta ibu dipinda dengan menggantikan perkataan \"orang yang berkelayakan untuk mengemukakannya\" dengan perkataan \"orang yang mengemukakan\". Pindaan seksyen 70B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/47/msa@/~cl_7",
