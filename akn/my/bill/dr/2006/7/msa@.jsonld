      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Akta Perbekalan Tambahan (2005) 2006"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/7/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2005)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2006. Perbeianjaan tambahan bagi tahun 2005"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/7/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi sepuluh bilion satu ratus lima puluh dua juta lapan ratus tujuh puluh empat ribu lima ratus sembilan puluh tiga ringgit (RM10,152,874,593) daripada Kumpulan Wang Disatukan bagi perbeianjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2005 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2005 [Akta A1230]. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2006/7/msa@/~sched_1",
