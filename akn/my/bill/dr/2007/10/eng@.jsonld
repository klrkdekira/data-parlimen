        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_6"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "International Islamic Trade Finance Corporation Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the International Islamic Trade Finance Corporation Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date the Agreement comes into operation for the Government of Malaysia pursuant to Article 53 of the Agreement. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Member\" means a country or an institution, which is a member of the Corporation; \"Government\" means the Government of Malaysia; \"Chief Executive Officer\" means the Chief Executive Officer of the Corporation; \"Board of Directors\" means the Board of Directors of the Corporation; \"Minister\" means the Minister charged with the responsibility for finance; \"Corporation\" means the International Islamic Trade Finance Corporation established by the Agreement; \"General Assembly\" means the General Assembly of the Corporation; \"Agreement\" means the international agreement for the establishment and operation of the International Islamic Trade Finance Corporation signed in Kuwait City, Kuwait on 30 May 2006. Juridical personality of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have juridical personality and such legal capacities as are necessary for the exercise of its powers and the performance of its functions in accordance with the Agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Corporation shall have the capacity to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, hold and dispose of movable and immovable property; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "institute legal proceedings in its name and defend any action brought against the Corporation in a court of competent jurisdiction. Power to subscribe to shares of the capital stock of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister is authorized to subscribe on behalf of the Government—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to shares of the authorized capital stock of the Corporation in accordance with paragraph (1) of Article 10 of the Agreement in such amount which shall not exceed the equivalent value of thirty million United States dollars;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "where the authorized capital stock of the Corporation is increased at the request of the General Assembly in accordance with paragraph (3) of Article 10 of the Agreement, to a proportion of the increase of stock as provided in that paragraph; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "where the shares of the Government have been increased at the request of the Government under paragraph (6) of Article 11 of the Agreement, to the amount of such increase. Sums payable to the Corporation to be charged on the Consolidated Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be charged on the Consolidated Fund of the Government—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Corporation by way of subscription to its capital stock under and in accordance with the method of payment thereof as provided in Article 12 of the Agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Corporation by way of increased subscription by the Government to the Corporation's capital stock in accordance with paragraph (6) of Article 11 of the Agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any sum which the Government wishes to make as deposit with the Corporation under subparagraph (2)(b) of Article 8 of the Agreement; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Corporation under any other provision of the Agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All the sums charged on the Consolidated Fund of the Government under this section shall be paid in United States dollars. Receipt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All sums received by or on behalf of the Government from the Corporation shall be paid into the Consolidated Fund of the Government."
      }
    }
  ]
}
