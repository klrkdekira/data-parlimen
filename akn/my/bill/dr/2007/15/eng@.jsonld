    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/15/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 12. Amendment of section 14c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/15/eng@/~cl_11",
      "@type": "akn:clause",
