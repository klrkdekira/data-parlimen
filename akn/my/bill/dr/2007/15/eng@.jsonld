      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/15/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph 6(3)(a), by substituting for the words \"or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/15/eng@/~cl_7__subsec_1AC",
      "@type": "akn:subsection",
