      ],
      "schema:name": {
        "@language": "en",
        "@value": "Hire Purchase Registration (Sarawak)(Repeal) Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Hire Purchase Registration (Sarawak) (Repeal) Act 2007. Repeal of Ordinance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Hire Purchase Registration Ordinance (Chapter 71), which is referred to as the \"Ordinance\" in this Act, is repealed. Savings and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The repeal of the Ordinance under section 2 shall not affect any document or instrument of hire purchase executed prior to the date of the coming into operation of this Act. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Where an application for the registration of any document or instrument of hire purchase has been made and the process of its registration is still pending immediately before the repeal of the Ordinance, proceedings in respect of the said application may be continued under the repealed Ordinance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), any fee paid for the registration of any document or instrument of hire purchase, shall not be refunded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/17/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection 10(2), sections 11 and 12 of the Ordinance, upon the repeal of the Ordinance under section 2, the Registrar shall, subject to the provisions of the Sarawak State Library Ordinance 1999 (Chapter 29), retain a copy of the registered document or instrument of hire purchase and within six months from the date of the repeal submit such documents to the State Depository established under Part IV of Chapter 29."
      }
    }
  ]
}
