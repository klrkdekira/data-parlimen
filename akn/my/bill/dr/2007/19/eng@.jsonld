      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of \"Malaysian Primary Standards\". Amendment of Part II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The heading of Part II of the principal Act is amended by substituting for the words \"UNITS OF MEASUREMENT\" the words \"TRACEABILITY OF MEASUREMENT\". Deletion of sections 3, 4, 5, 6, 7 and 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting sections 3, 4, 5, 6, 7 dan 8. New section 8A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 8 the following section: \"Traceability of measurement 8A. Any measurement made for the purpose of this Act shall be traceable to the National Measurement Standards as set out in the National Measurement System Act 2007.\". Amendment of section 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 9(2) of the principal Act is amended by substituting for the words \"Tertiary Standards\" the words \"National Measurement Standards\". Amendment of section 10"
      }
    },
