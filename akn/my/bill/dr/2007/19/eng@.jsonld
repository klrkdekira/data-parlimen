      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words \"Secondary Standards, all Tertiary Standards and all\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/eng@/~cl_8__para_e__subpara_ii",
