      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Timbang dan Sukat (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 25 dengan seksyen yang berikut: \"Penyimpan Timbang dan Sukat 25. (1) Makmal Standard Pengukuran Kebangsaan hendaklah menjadi Penyimpan Timbang dan Sukat bagi maksud menguatkuasakan peruntukan-peruntukan Akta ini. (2) Menteri boleh, melalui peraturan-peraturan, menetapkan kewajipan dan kuasa Penyimpan.\". Pindaan seksyen 25A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 25A dengan seksyen yang berikut: \"Penyimpan hendaklah menasihati Menteri 25A. Penyimpan Timbang dan Sukat hendaklah menasihati Menteri mengenai semua perkara yang berkaitan dengan penentukuran, penentuan dan pengujian timbang atau sukat atau alat-alat timbang atau sukat dan perkara-perkara lain yang berkaitan dengan metrologi kecuali Sistem Unit Antarabangsa dan sistem sukat.\". Pindaan seksyen 27A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 27A dengan seksyen yang berikut: \"Pemulaan pendakwaan 27A. Tiada pendakwaan bagi atau berhubung dengan apa-apa kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya.\". Pindaan seksyen 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 29(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan \"Standard-Standard Utama Malaysia, Standard-Standard Kedua, Standard-Standard Ketiga dan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memotong perkataan \"Standard-Standard Utama Malaysia, Standard-Standard Kedua, Standard-Standard Ketiga dan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan \"Standard-Standard Utama Malaysia, Standard-Standard Kedua, Standard-Standard Ketiga dan\". Pemotongan seksyen 33 dan 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 33 dan 34. Pindaan seksyen 34A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 34A dengan seksyen yang berikut: \"Pengkompaunan kesalahan 34A. (1) Ketua Inspektor boleh, dengan keizinan bertulis Pendakwa Raya, menawarkan untuk mengkompaun apa-apa kesalahan di bawah mana-mana peruntukan Akta ini atau di bawah peraturan-peraturan yang dibuat di bawah Akta ini dengan menerima daripada orang yang disyaki secara munasabah telah melakukan kesalahan itu suatu amaun wang yang tidak melebihi denda maksimum, yang boleh dikenakan ke atas orang itu jika dia disabitkan atas kesalahan itu, dalam masa sebagaimana yang boleh dinyatakan dalam tawaran itu. (2) Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau dalam apa-apa masa lanjutan sebagaimana yang diberikan oleh Ketua Inspektor, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu telah dibuat. (3) Apabila amaun di bawah subseksyen (1) diterima, tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu telah dibuat.\". Pemotongan Jadual Pertama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Jadual Pertama. Pemotongan Jadual Ketiga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Jadual Ketiga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Timbang dan Sukat (Pindaan) 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan tajuk panjang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Timbang dan Sukat 1972 [Akta 71], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dengan menggantikan tajuk panjang dengan tajuk panjang yang berikut: \"Suatu Akta bagi mengawal selia timbang dan sukat dan alat-alat timbang dan sukat dan bagi mengadakan peruntukan mengenai perkara-perkara yang berkaitan dengannya.\". Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 2(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"alat timbang dan sukat\" dengan takrif yang berikut: ' \"alat timbang atau sukat\" ertinya apa-apa alat atau mesin untuk menyukat mengikut panjang, luas, isi padu, muatan, masa, berat, bilangan atau apa-apa kuantiti lain, dan dalam hal alat timbang, termasuklah timbangan yang digunakan yang berkaitan dengannya;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"Ketua Inspektor\", \"Timbalan Ketua Inspektor\" dan \"Inspektor\" takrif yang berikut: \"Makmal Standard Pengukuran Kebangsaan\" mernpunyai erti yang sama sebagaimana yang diberikan kepada ungkapan itu dalam Akta Sistem Pengukuran Kebangsaan 2007 [Akta ];';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Menteri\" dengan takrif yang berikut: \"Menteri\" ertinya Menteri yang bertanggungjawab bagi perdagangan dalam negeri dan hal ehwal pengguna;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"Penyimpan\", dengan menggantikan perkataan \"dilantik di bawah\" dengan perkataan \"disebut dalam\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"Sistem Unit Antarabangsa\" dengan takrif yang berikut: \"Sistem Unit Antarabangsa\" mempunyai erti yang sama sebagaimana yang diberikan kepada ungkapan itu dalam Akta Sistem Pengukuran Kebangsaan 2007;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"Sistem Unit Antarabangsa\" takrif yang berikut: \"Standard Pengukuran Kebangsaan\" mempunyai erti yang sama sebagaimana yang diberikan kepada ungkapan itu dalam Akta Sistem Pengukuran Kebangsaan 2007;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Standard-Standard Kedua\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Standard-Standard Ketiga\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif \"Standard-Standard Utama Malaysia\". Pindaan Bahagian II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Bahagian II Akta ibu dipinda dengan menggantikan perkataan \"UNIT SUKATAN\" dengan perkataan \"KEBOLEHKESANAN PENGUKURAN\". Pemotongan seksyen 3, 4, 5, 6, 7 dan 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 3, 4, 5, 6, 7, dan 8. Seksyen baru 8A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 8 seksyen yang berikut: \"Kebolehkesanan pengukuran 8A. Apa-apa pengukuran yang dibuat bagi maksud Akta ini hendaklah mempunyai kebolehkesanan kepada Standard Pengukuran Kebangsaan sebagaimana yang dinyatakan dalam Akta Sistem Pengukuran Kebangsaan 2007.\". Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 9(2) Akta ibu dipinda dengan menggantikan perkataan \"Standard-Standard Ketiga\" dengan perkataan \"Standard Pengukuran Kebangsaan\". Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memotong perkataan \"Standard- Standard Utama Malaysia, Standard-Standard Kedua, Standard-Standard Ketiga dan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memotong perkataan \"Standard-Standard Kedua, Standard-Standard Ketiga dan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: \"(3) Perbandingan dan penentuan Standard-Standard Kerja hendaklah dilakukan oleh Penyimpan Timbang dan Sukat mengikut cara yang ditetapkan oleh Menteri dan apabila berpuas hati dengan ketepatan Standard- Standard Kerja itu, Penyimpan Timbang dan Sukat hendaklah mengeluarkan perakuan mengenai penentuan itu dan perakuan itu hendaklah disimpan oleh orang yang menjaga Standard-Standard Kerja yang berkaitan.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan \"Standard Kedua, Standard Ketiga dan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"tiap-tiap standard\" dengan perkataan \"Standard Kerja\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan memotong perkataan \"Standard Kedua atau Standard Ketiga atau\". Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 12(1)(a) Akta ibu dipinda dengan memasukkan selepas perkataan \"Jadual Pertama\" perkataan \"dan Jadual Kedua kepada Akta Sistem Pengukuran Kebangsaan 2007\". Pindaan seksyen 25"
      }
    }
  ]
}
