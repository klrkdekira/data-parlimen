      ],
      "schema:name": {
        "@language": "en",
        "@value": "Evidence of Child Witness Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I",
      "@type": "akn:part",
