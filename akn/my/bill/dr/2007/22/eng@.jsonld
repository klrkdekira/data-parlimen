        "@value": "PRELIMINARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
