        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MANNER OF GIVING EVIDENCE BY CHILD WITNESS How evidence of child witness may be given"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as are necessary or expedient to give full effect to or for carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection ( 1 ) , regulations may be made —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedures to be used for any of the purposes of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the management and administration of facilities to be given to child witnesses. Application of Evidence Act 1950 and Criminal Procedure Code"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Evidence Act 1950 and the Criminal Procedure Code [Act 593] shall continue to apply except in so far as those provisions are expressly modified by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Court may direct that the wearing of coats, jackets, gowns or other formal attire of a judge and Court officers to be dispensed with during the giving of evidence by a child witness. Presumption as to age of child witness"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_11__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) If the Court is in doubt as to the exact age of a child witness, a certificate of a medical officer to the effect that, in his opinion, the child witness has or has not attained a specified age may be given in evidence, and the Court shall declare the age of that child witness for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The age of a child witness as declared by the Court under subsection (1) shall be deemed to be the true age of that child witness, unless and until the contrary is proved. Child witness suffering from a disability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A child witness who is suffering from any disability may, apart from giving his evidence in any manner prescribed in subsection 3(1) or a combination of the manner as prescribed in that subsection, give his evidence in any other manner in which he can make it intelligible."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The evidence so given shall be deemed to be oral evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, ''disability\" includes activity limitation resulting from physical, intellectual or sensory impairment, medical conditions or mental illness which may be permanent or temporary in nature. Child witness attaining age of sixteen years while giving evidence during trial"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "When a child witness is giving evidence before the Court and in the course of giving evidence he attains the age of sixteen years, the Court shall continue to hear the evidence of that child witness and exercise all the powers under this Act. Restrictions on media reporting and publication"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall reveal or publish any particulars in any mass-media or transmit through any electronic medium that may lead to the identification of a child witness, in particular the name and address of the child witness, and the name and other particulars of the educational institution he attends."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A picture of the child witness or any other person, place or thing which may lead to the identification of the child witness in the proceedings mentioned in subsection (1) shall not be published in any mass-media or transmit through any electronic medium."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A child witness may, at any stage of a trial, give evidence in any one or a combination of the following manner:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by having a screen between him and the accused or a child charged with any offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by live link; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by video recording."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, any evidence given under subsection (1) shall be deemed to be evidence given in an open Court. Screening"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A child witness, while giving evidence in the Court, may be prevented by means of a screen or other arrangement from seeing and being seen by the accused or a child charged with any offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The screen or other arrangement shall not prevent the child witness from being able to see, and to be seen by —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the prosecutor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the advocate for the accused or the child charged with any offence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the interpreter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more advocates are acting for the accused or the child charged with any offence, the requirement of paragraph (2)(c) is satisfied if the child witness is able at all material times to see and be seen by at least one of them. Evidence by live link"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where a child witness gives evidence by means of a live link from a location other than the courtroom, that location is deemed to be part of the courtroom in which the proceeding is being held for the purposes of this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Court may make an order specifying —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that a member of the Court staff be present at that location;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the interpreter for the proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any adult permitted by the Court to accompany the child witness;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the persons in the courtroom who must not be heard, or seen and heard, by the child witness and by the persons accompanying the child witness;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the persons in the courtroom who must be able to see and hear the child witness and the persons accompanying the child witness;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the method of operation of the live link system including compliance with such minimum technical standards as may be determined by the Chief Justice of the Federal Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other matter as the Court considers necessary in the interest of justice. Video recording of a child witness"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where a video recording of a child witness is given in evidence, such video recording shall be admitted as evidence of examination-in-chief of the child witness: Provided that the contents of the video recording shall be subject to the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A video recording under subsection (1) shall not be admitted unless —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "accompanied by a transcript of the original language used in the video recording; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "accompanied by a translation of the transcript, if the language used in the video recording is other than the national language."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate by a person who did the video recording pursuant to subsection (1) shall, until the contrary is proven, be admitted as a prima facie evidence of the authenticity of the content of the video recording."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where a video recording is admitted under this section, the child witness shall be called to be further examined-in-chief by the party who tendered the video recording in evidence on any matter which, in the opinion of such party, has not been dealt with adequately in the child witnesses recorded testimony."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any provision of this Act, where a child witness is called to be further examined-in-chief under subsection (4), he may give evidence by means of having a screen between him and the accused or child charged with any offence or by means of a live link."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where a video recording is given in evidence under this section, any statement made by the child witness which is disclosed in the recording shall be treated as if given by that child witness in direct oral evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a child witness who has been sworn, the Court shall admit the statement made by the child witness in the video recording as sworn evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of evidence of a child witness of tender years, the Court, when considering the statement in the video recording as evidence shall assess and form an opinion as to whether the child witness possesses sufficient intelligence and understands the duty of speaking the truth, though not given upon oath. Previous video recording of a child witness may be proved"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "When a child witness attains the age of sixteen years before giving evidence in the Court, any previous video recording of evidence given by the child witness, made pursuant to section 6, may be proved. Examination of child witness through intermediary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any examination of a child witness may be conducted through the Court or an interpreter or any other person authorized by the Court, acting as an intermediary, for the purposes of this"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The function of an intermediary is to communicate —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to the child witness, questions put to the child witness; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to any person asking such questions, the answers given by the child witness in reply to them, and to explain such questions or answers so far as necessary to enable them to be understood by the child witness."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An intermediary shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "prompt the child witness to answer any question;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "influence the answers of the child witness; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "disrupt the questioning of the child witness."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An unrepresented accused shall not be entitled to question a child witness directly but may do so through an intermediary. Adults accompanying child witness"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Court may allow a child witness to be accompanied by an adult while giving evidence in any proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Court may permit more than one adult to accompany the child witness if the Court considers it in the interests of justice to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An adult accompanying the child witness shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "prompt the child witness to answer any question;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "influence the answers of the child witness; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_II__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "disrupt the questioning of the child witness. Formal attire may be dispensed with"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Evidence of Child Witness Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/22/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"Court\" means the High Court, the Sessions Court, the Magistrates' Court and the Court For Children; ''Minister\" means the Minister charged with the responsibility for law; \"medical officer\" means a registered medical practitioner in the public service and includes a registered medical practitioner in any teaching hospital of a university established under the Universities and University Colleges Act 1971 [Act 30]; \"police officer\" has the meaning assigned to it in the Police Act 1967 [Act 344]; \"video recording\", in relation to a child witness, means a video recording of the oral evidence of the child witness, in the form of an interview conducted between a police officer and the child witness, expressed upon any format, made with a view to its admission as evidence of examination-in-chief of the child witness; \"live link\" means a live television link or other arrangement whereby a child witness, while being absent from the courtroom or other place where the proceedings are being held, is able to see and hear a person in such courtroom or other place and to be seen and heard by the persons specified in paragraphs 4(2)(a) to (d); \"child witness\" means a person under the age of sixteen years who is called or proposed to be called to give evidence in any proceedings but does not include an accused or a child charged with any offence."
      }
    }
  ]
}
