      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_q"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have all the functions imposed on it under the solid waste and public cleansing management laws and shall also have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to recommend policies, plans and strategies including schemes in respect of solid waste management services and public cleansing management services to the Federal Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to implement such policies, plans and strategies including schemes as decided by the Federal Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to implement measures as decided by the Federal Government for the improvement of any existing solid waste management services and public cleansing management services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to recommend the standards, specifications and codes of practice relating to any aspect of solid waste management services and public cleansing management services to the Federal Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor compliance with the standards, specifications and codes of practice relating to any aspect of solid waste management services and public cleansing management services as set by the Federal Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to implement and enforce the solid waste and public cleansing management laws and to recommend reform to such laws to the Federal Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that the functions and obligations of any person carrying out solid waste management services or public cleansing management services are properly carried out;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to increase concerted efforts towards improving the operational efficiency of the solid waste management services and public cleansing management services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to implement measures to promote public participation and to improve public awareness on solid waste management services and public cleansing management services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate and implement human resource development and funding and cooperation programmes for the proper and effective performance of the functions of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to cooperate with any corporate body or government agency for the purpose of performing the functions of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to utilize all movable and immovable property of the Corporation in such manner as the Corporation may think expedient including the raising of loan by charging such property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to encourage, promote, facilitate and stimulate the growth of the solid waste management services and public cleansing management services by various means including arranging for the conduct of researches, assessments, studies and advisory services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to maintain and improve the standard and level of the solid waste management services and public cleansing management services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to establish institutions, centres and workshops for the undertaking of research and other activities necessary for or related to the development of the solid waste management services and public cleansing management services; Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to determine and impose fees, charges or other payment for services rendered by the Corporation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out any other functions conferred upon it under the solid waste and public cleansing management laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have all such powers as may be necessary for, or in connection with, or incidental to, the performance of its functions under this Act. Delegation of functions of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, in writing, delegate any of the functions imposed or conferred on it by the solid waste and public cleansing management laws to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the Corporation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person delegated with such function shall be bound to observe and have regard to all conditions and restrictions imposed by the Corporation and all requirements, procedures and matters specified by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any function delegated under this section shall be performed and exercised in the name and on behalf of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The delegation under this section shall not preclude the Corporation from itself performing or exercising at any time any of the delegated functions. Direction by Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall be responsible to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may from time to time give the Corporation directions of a general character consistent with the provisions of this Act relating to the performance of the functions of the Corporation and the Corporation shall as soon as possible give effect to such directions. Returns, reports, accounts and information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall furnish to the Minister, and any party as may be specified by the Minister, such returns, reports, accounts and information with respect to its activities and finances as the Minister may from time to time require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may from time to time request the Chief Executive Officer to furnish such returns, reports, accounts and information with respect to the discharge of the functions of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Corporation, other than the the members appointed under paragraphs 5(b) to (f), shall be vacated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted on, a charge in respect of— ( i ) an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a member of the Corporation or otherwise, has been such as to bring discredit on the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if he is of unsound mind or otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of the Chairman, if he absents himself from three consecutive meetings of the Corporation without leave of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a member of the Corporation other than the Chairman, if he absents himself from three consecutive meetings of the Corporation without leave in writing of the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if his appointment is revoked by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if his resignation is accepted by the Minister. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Corporation may establish any committee as it considers necessary or expedient to assist it in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The meetings of a committee shall be held at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "minutes of all its meetings to be maintained and kept in a proper form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "copies of the minutes of all its meetings to be submitted to the Corporation as soon as may be practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any of its meetings for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The members of a committee and any person invited under subsection (12) shall be paid such allowances and other expenses as the Corporation may determine. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may elect any of its members to be the chairman of a committee. Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may appoint any person to be a member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may revoke the appointment of any member of a committee without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign by giving a notice in writing to the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, at any time, discontinue or alter the constitution of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to, and act in accordance with, any direction given to it by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation or any committee who has or acquires a direct or indirect interest by himself, through a member of his family or his associate in relation to any matter under discussion by the Corporation or committee, as the case may be, shall disclose to the Corporation or committee, as the case may be, the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Corporation or committee, as the case may be, in which the matter is discussed and, after the disclosure —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the member shall not be present or take part in any discussion or decision of the Corporation or committee, as the case may be, about the matter; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the member shall be disregarded for the purpose of constituting a quorum of the Corporation or committee, as the case may be, when the matter is discussed or decided upon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation or committee who fails to disclose his interest as required under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No act or proceedings of the Corporation or a committee shall be invalidated on the ground that any member of the Corporation or committee has contravened this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1) — \"a member of his family\" includes —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his parent (including a parent of his spouse);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his child (including an adopted child or stepchild); Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his brother or sister (including a brother or sister of his spouse); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a spouse of his child, brother or sister; and \"his associate\" means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is a nominee or an employee of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a firm of which the member or any nominee of his is a partner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a partner of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a trust under which the member or a member of his family is a beneficiary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_12__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any corporation within the meaning of the Companies Act 1965, of which the member or any nominee of his or a member of the member's family is a director or has a substantial shareholding in the corporation. Disqualification and termination of members of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "No person shall be appointed or shall remain as a member of the Corporation if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "he is an officer of any company licensed under the Solid Waste and Public Cleansing Management Act 2007; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "he has any interest, financial or otherwise, in any undertaking involving solid waste and public cleansing management. Actions and proceedings of Corporation not affected by vacancy, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may act notwithstanding any vacancy in its membership and the validity of its proceedings shall not be affected by —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "the absence of any member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "any defect afterwards discovered in the appointment or qualification of any member or the constitution of the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity in the convening or conduct of a meeting; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "the presence or participation of a person who is not a member of the Corporation. Duties of members of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation shall, at all times, act honestly and in the best interest of the Corporation and use reasonable diligence in the discharge of the duties of his office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation or any other person who has been a member of the Corporation shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make improper use of any information acquired by virtue of his position as a member of the Corporation to gain, directly or indirectly, an advantage for himself or for any other person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "do, say or publish anything which may be detrimental to the interest of the Corporation. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall meet as often as may be required but not less than four times a year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Corporation and in his absence, the members present shall elect a chairman amongst them and the person so elected shall preside and have all the powers of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and four other members present at a meeting of the Corporation shall constitute a quorum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Corporation shall be adopted by a simple majority of the votes of the members present and voting. Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of an equality of votes the Chairman shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A resolution in writing, signed by all members for the time being entitled to receive notice of a meeting of the Corporation, shall be as valid and effectual as if it had been passed at a meeting of the Corporation duly convened and held and any such resolution may consist of several documents in like form, each signed by one or more members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall prevent the Chairman from authorizing a member to use live video, television links or other appropriate communication or multimedia facilities to participate in any meeting of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of \"Solid Waste and Public Cleansing Management Corporation\" is established. Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall have perpetual succession and shall have a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may sue and be sued in its corporate name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Corporation may, upon such terms as it deems fit-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of movable and immovable property and interest in movable and immovable property of every description —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase and take such property and interest; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_3__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "hold, enjoy, convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer, or otherwise dispose of or deal with, such property and interest vested in the Corporation. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Corporation shall bear a device as approved by the Corporation and the seal may from time to time be broken, changed, altered and made anew as the Corporation thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Corporation, a stamp bearing the words \"Solid Waste and Public Cleansing Management Corporation\" may be used and shall be deemed to be its common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Corporation shall be kept in the custody of the Chief Executive Officer or any officer of the Corporation authorized by the Corporation and shall be authenticated by either the Chairman or by such other members of the Corporation authorized by the Chairman in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purporting to be sealed with the common seal and authenticated in accordance with subsection (3) shall, until the contrary is proved, be deemed to have been validly executed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any deed, document and other instrument which is not required to be under seal may in like manner be executed by a member of the Corporation or an officer or employee of the Corporation authorized by the Corporation in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Corporation shall be officially and judicially noticed. Membership of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall consist of the following members who shall be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry charged with the responsibility for solid waste and public cleansing management;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Treasury;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Economic Planning Unit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Natural Resources and Environment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "not more than three other members who shall have relevant knowledge and experience. Statutory declaration by members of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be appointed as the Chairman or a member of the Corporation under paragraph 5(g) unless before such appointment the person makes a statutory declaration as to whether he has any interest, financial or otherwise, in any undertaking involving solid waste management services and public cleansing management services."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "If a member of the Corporation acquires any interest, financial or otherwise, in any undertaking involving solid waste management services and public cleansing management services he shall, within thirty days after such acquisition, give notice in Corporation writing to the Minister specifying the interest acquired, and the Minister may, after taking the matter into consideration, if he thinks fit, declare that the member has vacated his office. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and members of the Corporation appointed under paragraph 5(g) shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for a term not exceeding two years and shall be eligible for reappointment upon the expiry of his term of office, but shall not be appointed for more than three consecutive terms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to the Chief Executive Officer. Allowances of members of Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and members of the Corporation, other than the Chief Executive Officer, shall be paid such allowances and other expenses at such rates as the Minister may determine. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of any member of the Corporation, other than the members appointed under paragraphs 5(b) to (f), without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Corporation, other than the Chief Executive Officer, may at any time resign from his appointment by giving a written notice to the Minister. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_26"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROVISIONS RELATING TO OFFICERS AND EMPLOYEES Chief Executive Officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The Chief Executive Officer shall be appointed by the Minister, on the recommendation of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall hold office for a term not exceeding three years and shall be eligible for reappointment upon the expiry of his term of office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be deemed to be an officer or employee of the Corporation and be subject to the terms and conditions of service as may be determined by the Corporation with the approval of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall enjoy such compensation and such other amenities as approved by the Minister, upon recommendation of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall vest in the Chief Executive Officer such powers and impose upon him such duties as may be determined by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be responsible for the overall administration and management of the functions and the day to day affairs of the Corporation. Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall have general control of the officers and employees of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall perform such further duties as the Minister and the Corporation may from time to time direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "In discharging his duties, the Chief Executive Officer shall act under the general authority and direction of the Corporation. Temporary exercise of functions of Chief Executive Officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint temporarily any officer of the Corporation to act as the Chief Executive Officer for the period—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chief Executive Officer is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer is, for any reason, unable to perform the duties of his office. Appointment of officers and employees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may appoint such numbers of officers and employees as are necessary for carrying on the business and affairs of the Corporation and such officers and employees shall hold office for such period, receive such salaries, allowances and benefits, and shall be subject to such terms and conditions of service as may be determined by the Corporation with the approval of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "An officer or employee of the Corporation shall, at all times, act in good faith and comply with such requirements, standards, duties and code of conduct as may be determined by the Corporation. Loans, scholarship, advances, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Corporation —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "may provide loans, scholarships and advances to its officers and employees subject to such terms and conditions as the Corporation may determine; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "may provide donations to any person or body of persons in such amount and for such purposes as may be approved by the Minister. Payment of retirement benefits, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may make arrangements for the payment to its officers and employees and their dependants of such retirement benefits, gratuities and other allowances as the Corporation may determine. Corporation may adopt regulations, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may adopt with such modifications as it deems fit any regulations, rules, policies, circulars and directives enacted or issued by the Federal Government in relation to any matter under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Solid Waste and Public Cleansing Management Corporation Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies to Peninsular Malaysia and the Federal Territories of Putrajaya and Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"member of the Corporation\" means a member of the Corporation appointed under section 5; \"committee\" means a committee established by the Corporation under section 11; \"Chief Executive Officer\" means the chief executive officer of the Corporation; \"Director General\" has the meaning assigned to it in section 2 of the Solid Waste and Public Cleansing Management Act 2007 [Act ]; \"Fund\" means the Solid Waste and Public Cleansing Management Corporation Fund established under section 27; \"Minister\" means the Minister charged with the responsibility for solid waste and public cleansing management; \"Chairman\" means the Chairman of the Corporation appointed under section 5; \"Corporation\" means the Solid Waste and Public Cleansing Management Corporation established under section 3; \"public cleansing management services\" has the meaning assigned to it in section 2 of the Solid Waste and Public Cleansing Management Act 2007; \"solid waste management services\" has the meaning assigned to it in section 2 of the Solid Waste and Public Cleansing Management Act 2007; \"company\" has the meaning assigned to it in section 4 of the Companies Act 1965 [Act 125]; \"solid waste and public cleansing management laws\" means this Act and the Solid Waste and Public Cleansing Management Act 2007, and includes any subsidiary legislations made under those laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE Solid Waste and Public Cleansing Management Corporation Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_45"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution shall be instituted for any offence under this Act except by or with the consent in writing of the Public Prosecutor. Corporation Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman, members of the Corporation and of any committee, officers, employees and agents of the Corporation, while discharging their duties under this Act as Chairman, such members, officers, employees or agents, shall be deemed to be public servants within the meaning of the Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Corporation or any member of the Corporation, a committee, an officer, employee or agent of the Corporation in respect of any act, omission, neglect or default done or committed by him in good faith in such capacity. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law or where otherwise authorized by the Corporation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no member of the Corporation or any of its committees or any officer, employee or agent of the Corporation whether during or after his tenure of office or employment, and no person attending any meeting of the Corporation or any of its committees, shall disclose any information obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has by any means access to any information or documents relating to the affairs of the Corporation shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding six months or to both. Representation in civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding any other written law —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "in any civil proceedings by or against the Corporation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "in any other civil proceedings in which the Corporation is required or permitted by the court to be represented, or to be heard, or is otherwise entitled to be represented or to be heard, any person authorized by the Corporation for that purpose may, on behalf of the Corporation, institute such proceedings or appear in such proceedings and may make all appearances and applications and do all acts in respect of the proceedings on behalf of the Corporation. Power to employ"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may employ and pay agents and technical advisers, including advocates and solicitors, bankers, consultants and other persons, to transact any business or to do any act required to be transacted or done in the performance of its functions or for the better carrying into effect of the purposes of this Act. Power to establish companies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may, from time to time, with the approval of the Minister and the concurrence of the Minister of Finance, establish companies by such name as the Corporation may determine to carry out and have the charge, conduct and management on behalf of the Corporation of any project, scheme or enterprise as may be determined by the Corporation in the discharge of its functions. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "All things done by any person or authority on behalf of the Corporation in the preparation of and towards the proper administration of this Act, and any expenditure incurred in relation thereto, in anticipation of the enactment of this Act shall Corporation be deemed to have been authorized by this Act, and all rights acquired or obligations incurred on behalf of the Corporation from anything so done shall upon the coming into operation of this Act be deemed to be the rights and obligations of the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the \"Solid Waste and Public Cleansing Management Corporation Fund\" is established and shall be administered and controlled by the Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided by Parliament from time to time for the purposes of the management of solid waste and public cleansing; Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived as income from investments by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived from the sale, disposal, lease or hire, or any other dealing with, any property, mortgages, charges or debentures vested in or acquired by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys earned from consultancy and advisory services and any other services provided by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys and property which may in any manner become payable to or vested in the Corporation in respect of any matter incidental to its functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums borrowed by the Corporation under section 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys earned by the operation of any project, scheme or enterprise financed from the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all donations and contributions received from within or outside Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys lawfully received by the Corporation. Expenditure to be charged on the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Corporation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "paying for the allowances and other expenses of the members of the Corporation and members of the committees and the remunerations, allowances and other expenses of the officers and employees of the Corporation, including the granting of loans and advances, superannuation allowances, retirement benefits and gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "granting loans, scholarships and advances to its employees under section 24;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs or expenditure properly incurred or accepted by the Corporation for the purpose of the management of solid waste and public cleansing, including the engagement of consultants, legal fees and costs and other charges and costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other material, acquiring land and any assets, and erecting buildings and carrying out any other works and undertakings for the purpose of the management of solid waste and public cleansing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "repaying moneys borrowed under section 32 and the interest due on the borrowed moneys;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "investment under section 33; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for the purpose of the management of solid waste and public cleansing in general and carrying into effect the provisions of the solid waste and public cleansing management laws in particular. Conservation of the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation has the duty to conserve the Fund by so performing its functions and exercising its powers under this Act to secure that the total revenue of the Corporation are sufficient to meet all sums properly chargeable to its revenue account including depreciation and interest on capital taking one year with another. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Corporation up to such amount as may be authorized by the Minister for any one year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Before 1 September of each year, the Corporation shall submit to the Minister an estimate of its expenditure, including the expenditure for research and development programmes, for the following year in such form and containing such particulars as the Minister may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, before 1 January of the following year, notify the Corporation of the amount authorized for each description of expenditure based on the estimate prepared under subsection (2). Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may at any time submit to the Minister a supplementary estimate of its expenditure for any one year and the Minister may allow the whole or any part of the additional expenditure included in the supplementary estimate. Bank accounts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall open and maintain an account or accounts with such bank or banks in Malaysia as it thinks fit, after consulting the Minister, and every such account shall be operated upon as far as practicable by cheques signed by any person as may be authorized by the Corporation for such purpose from time to time. Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation may borrow, with the approval of the Minister and the Minister of Finance at such rate of interest and for such period and upon such terms as to the time and method of repayment and such other terms as the Minister and the Minister of Finance may approve, any sums required by the Corporation for meeting any of its obligations or discharging any of its duties. Investment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The moneys from the Corporation Fund shall, in so far as they are not required to be expended by the Corporation under this Act, be invested in such manner as the Minister and the Minister of Finance may approve."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Corporation may, with the approval of the Minister, acquire and develop land and properties for or in connection with the exercise of its powers and for this purpose may enter into such negotiations, arrangements or agreements as may be necessary for the effective and efficient operation of the Corporation. Limitations on contracts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall not, without the approval of the Minister and the Minister of Finance, enter into any contract under which the Corporation is to pay or receive an amount exceeding ten million ringgit. Financial procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act and the approval of the Minister, the Corporation shall determine its own financial procedure. Financial year"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The financial year of the Corporation shall begin on 1 January and end on 31 December of each year. Accounts and reports"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall cause proper accounts of the Fund and proper reports of its activities to be kept and shall, as soon as possible after the end of each financial year, cause to be prepared for that financial year—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of accounts of the Corporation which shall include a balance sheet and an account of income and expenditure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of its activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Corporation shall as soon as possible send a copy of the statement of accounts certified by the auditors and a copy of the auditors' report to the Minister and the Minister shall cause such statement and report to be laid before both Houses of Parliament."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/26/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Account and Annual Reports) Act 1980 [Act 240] shall apply to the Corporation."
      }
    }
  ]
}
