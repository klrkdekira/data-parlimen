      ],
      "schema:name": {
        "@language": "en",
        "@value": "Local Government (Amendment) Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act maybe cited as the Local Government (Amendment) Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies to Peninsular Malaysia and Federal Territory of Putrajaya,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date as the Minister may, after consultation with the State Authority appoint in relation to that State by notification in the Gazette and the Minister may, after consultation with the State Authority, appoint different dates —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of this Act in different local authority areas or parts of local authority areas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of different provisions of this Act: or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of different provisions of this Act in different local authority areas or parts of local authority area."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation in the Federal Territory of Kuala Lumpur and the Federal Territory of Putrajaya on a date to be appointed by the Minister responsible for the Federal Territory of Kuala Lumpur and the Federal Territory of Putrajaya by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), the State Authority may, by notification in the Gazette—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "exempt any part of any local authority area from any or all of the provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "extend any or all of the provisions of this Act to apply to the whole or any area or part of any area within the State which is not under any local authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_1__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "make such modifications, amendments or variations to the provisions of this Act as may be necessary for the purpose of its application under paragraph (k). Local Government (Amendment) 3 Amendment of section 72"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Local Government Act 1976 [Act 171], which is referred to as the 'principal Act\" in this Act, is amended in subsection 72(1)-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (a) the following paragraph; \"(a) to establish, maintain and carry out such sanitary services for dealing with effluent;\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subparagraph (f)J(ii). Amendment of section 73"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 73(1) of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (a)(i) the following paragraph: \"(a) (i) to establish, maintain and compel the use of any service for dealing with effluent and lo require the owners or occupiers of any premises to effect such dealing and to regulate and control the manner thereof;\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (a)(ii) the following paragraph: \"(ii) to keep public places clean and free from liquid waste and to prohibit the throwing, dropping, depositing or discharging of flushing water or other liquid waste, into any stream, channel or other water course, and prevent such liquid from flowing into any such place, and to regulate or prohibit the bathing or washing of persons, animals or things in any such place;\": and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (d){iii). Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that notwithstanding anything contained in this Act, any law relating to the management of controlled solid waste and public cleansing for the time being in force in any local authority area or non-local authority area shall continue to be in force unless and until this Act and the Solid Waste and Public Cleansing Management Act 2007 are brought into operation with respect to that area."
      }
    }
  ]
}
