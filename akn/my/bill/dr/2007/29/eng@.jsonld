      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Town and Country Planning (Amendment) Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies to Peninsular Malaysia and Federal Territory of Putrajaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation in a State on a date to be appointed by the State Authority, with the concurrence of the Minister, by notification in the State Gazette, and the State Authority may appoint different dates for the coming into operation of this Act in different areas or parts of the State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation in the Federal Territory of Kuala Lumpur and the Federal Territory of Putrajaya on a date to be appointed by the Minister responsible for the Federal Territory of Kuala Lumpur and the Federal Territory of Putrajaya by notification in the Gazette. Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Town and Country Planning Act 1976 [Act 172] is amended in subsection 22(2) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (bb), by deleting the word \"and\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (bb) the following paragraph: \"(be) the provisions of the Solid Waste and Public Cleansing Management Act 2007 [Act ]; and\". Town and Country Planning (Amendment)"
      }
    }
  ]
