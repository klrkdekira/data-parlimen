    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/29/eng@/~cl_1__subsec_1",
