      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perlindungan Pengguna (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/3/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
