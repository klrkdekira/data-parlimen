        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/30/msa@/~cl_16",
