    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: \"(2) The Yang di-Pertuan Agong — (a) shall appoint a Deputy Director General for Industrial Relations; and (b) may appoint such number of Directors of Industrial Relations, Principal Assistant Directors of Industrial Relations, Assistant Directors of Industrial Relations and Industrial Relations Officers as he considers necessary or expedient for the purposes of carrying out and giving effect to the provisions of this Act.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: \"(2A) The persons appointed under subsections (1) and (2) shall be persons from the Industrial Relations Officers Scheme of Service and such appointments shall be published in the Gazette\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: \"(4) Subject to such limitations, if any, as may be prescribed, an officer appointed under subsection (2) shall exercise all the powers, discharge all the duties and perform all the functions of the Director General under this Act, and every power so exercised, duty so discharged and function so performed shall be deemed to have been duly exercised, discharged and performed for the purposes of this Act.\". New section 2B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 2A the following section: \"All officers to be public servants 2B. All officers appointed under section 2A shall be deemed to be public servants for the purposes of the Penal Code [Act 574]:\\ Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 5(2)(b) of the principal Act is amended by inserting after the words \"a managerial\" wherever they appear the words \", an executive or a security\". Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 8 of the principal Act is amended by inserting after subsection (1) the following subsection: \"(1A) Where a complaint in subsection (1) relates to the dismissal of a workman, the provisions of section 20 shall apply to the exclusion of subsections 8(2) to 8(4).\". Amendment of section 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the principal Act is amended —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1A) the following subsections: \"(1B) The Director General, upon receipt of a reference under subsection (1A), may take such steps or make such enquiries as he may consider necessary or expedient to resolve the matter. (lc) Where the matter is not resolved under subsection (1B) the Director General shall notify the Minister. (ID) Upon receipt of the notification under subsection (lc), the Minister shall give his decision as to whether any workman or workmen are employed in a managerial, executive, confidential or security capacity and communicate in writing the decision to the trade union of workmen, to the employer and to the trade union of employers concerned.\";"
      }
    },
    {
