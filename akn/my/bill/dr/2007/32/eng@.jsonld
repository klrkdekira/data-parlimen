      "schema:text": {
        "@language": "en",
        "@value": "Section 54 of the principal Act is amended by inserting after subsection (3) the following subsection: \"(4) The exclusion specified in subsections (1), (2) and (3) shall also be applicable in any proceedings before any other court.\". Amendment of section 56"
      }
    },
