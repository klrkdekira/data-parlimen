      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_29__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: \"(2A) Notwithstanding the provisions of subsection 33(1), the Court shall, upon making the order under subsection (2), have the power to interpret any matter relating to the complaint made.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_29__para_b",
