      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif \"essential service\", dengan memasukkan selepas perkataan \"specified in the\" perkataan \"First\"; dan"
      }
    },
