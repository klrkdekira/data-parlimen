      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan \"(in proceedings under subsection 20(3))\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_20__para_b",
      "@type": "akn:paragraph",
