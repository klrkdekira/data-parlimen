      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 54 Akta ibu dipinda dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: \"(4) The exclusion specified in subsections (1), (2) and (3) shall also be applicable in any proceedings before any other court.\". Pindaan seksyen 56"
      }
    },
