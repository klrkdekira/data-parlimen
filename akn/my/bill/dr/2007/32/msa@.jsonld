      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan \"(in proceedings under subsection 20(3))\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_20__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
