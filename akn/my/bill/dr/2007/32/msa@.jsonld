      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (f) perenggan yang berikut: \"(fa) order a case to be struck off or reinstated; and\". Pindaan seksyen 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 30 Akta ibu dipinda dengan memasukkan selepas subseksyen (6) subseksyen yang berikut: \"(6A) Notwithstanding subsection (6), the Court in making an award in relation to a reference to it under subsection 20(3) shall take into consideration the factors specified in the Second Schedule.\". Pindaan seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 33(5) Akta ibu dipinda dengan memasukkan selepas perkataan \"section 22\" perkataan \"or 23\". Pindaan seksyen 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 38(1) Akta ibu dipinda dengan menggantikan perkataan \"Education Act 1961 [Act 43 of 1961]\" dengan perkataan \"Education Act 1996 [Act 550]\". Pindaan seksyen 40"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_25",
