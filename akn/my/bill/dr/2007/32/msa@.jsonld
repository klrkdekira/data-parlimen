      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (2)(c), dengan menggantikan perkataan \"a registered\" dengan perkataan \"an\". Pindaan seksyen 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21",
      "@type": "akn:clause",
