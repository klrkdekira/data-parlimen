        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 29 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21__para_a",
      "@type": "akn:paragraph",
