      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f), dengan memotong perkataan \"and\" di hujung perenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/32/msa@/~cl_21__para_b",
