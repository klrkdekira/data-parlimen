      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended-—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words \"promoting the training\" the words \"and development\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word \"employees\" the words \", apprentices and trainees\". Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 4(a) of the principal Act is amended by inserting after the word \"employees'\" the words \", apprentices' and trainees'\". Amendment of section 20"
      }
    },
