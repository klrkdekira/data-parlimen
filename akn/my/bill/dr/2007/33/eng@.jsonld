      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by inserting after the word \"employees\" the words \", apprentices and trainees\"; and Pembangunan Sumber Manusia Berhad (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/eng@/~cl_6__para_d",
