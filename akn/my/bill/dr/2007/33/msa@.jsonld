      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pembangunan Sumber Manusia Berhad (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pembangunan Sumber Manusia Berhad (Pindaan) 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan tajuk panjang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pembangunan Sumber Manusia Berhad 2001 [Akta 612], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam tajuk panjang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"penggalakan latihan\" perkataan \"dan pembangunan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"pekerja,\" perkataan \"perantis dan pelatih,\". Rang Undang-Undang Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 2 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"pekerja\" takrif yang berikut: ' \"pelatih\" ertinya seseorang yang sedang menjalani program latihan amali di premis seseorang majikan;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"penyedia latihan\" takrif yang berikut: ' \"perantis\" ertinya seseorang yang sedang menjalani latihan kemahiran dalam sesuatu bidang melalui kontrak perantisan dengan seseorang majikan dan terikat untuk bekerja dalam perkhidmatan majikan itu.'. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_4",
      "@type": "akn:clause",
