        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"penggalakan latihan\" perkataan \"dan pembangunan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
