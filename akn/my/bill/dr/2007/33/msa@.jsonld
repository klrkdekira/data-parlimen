      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
