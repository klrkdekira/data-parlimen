      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"penggalakan latihan\" perkataan \"dan pembangunan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan \"pekerja\" perkataan \", perantis dan pelatih\". Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 4(a) Akta ibu dipinda dengan memasukkan selepas perkataan \"pekerja\" perkataan \", perantis dan pelatih\". Pindaan seksyen 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_6",
