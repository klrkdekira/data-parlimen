      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"pekerjanya\" perkataan \"pekerja, perantis dan pelatihnya\"; Pembangunan Sumber Manusia Berhad (Pindaan)"
      }
    },
