        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"pekerjanya\" perkataan \"pekerja, perantis dan pelatihnya\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/33/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
