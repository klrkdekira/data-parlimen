      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Takaful (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Takaful (Pindaan) 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Takaful 1984 [Akta 312] yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"faedah takaful\" takrif yang berikut: \"institusi asing\" ertinya suatu syarikat asing yang menjalankan perniagaan di luar Malaysia yang serupa dengan perniagaan takaful sebagaimana yang diperuntukkan di bawah Akta ini atau suatu syarikat asing yang menjalankan apa-apa perniagaan kewangan lain sebagaimana yang ditentukan oleh Ketua Pengarah;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"pengendali\" dengan takrif yang berikut: \"pengendali\" ertinya suatu syarikat atau persatuan yang menjalankan perniagaan takaful yang didaftarkan di bawah seksyen 8 dan termasuklah suatu pengendali takaful antarabangsa yang didaftarkan di bawah seksyen 40B;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif ' \"pengendali takaful\", \"ejen takaful\" dan \"broker takaful\" ' dengan takrif yang berikut: \"pengendali takaful\", \"pengendali antarabangsa\", \"ejen takaful\" dan \"broker takaful\" ertinya seseorang yang menjalankan perniagaan takaful masing- masing sebagai pengendali takaful, pengendali takaful antarabangsa, ejen takaful dan broker takaful;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"perniagaan takaful\" takrif yang berikut: \"perniagaan takaful antarabangsa\" ertinya perniagaan takaful dalam mata wang selain ringgit;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"sijil takaful\" takrif yang berikut: ' \"syarikat asing\" mempunyai erti yang diberikan kepadanya oleh Akta Syarikat 1965;'. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 8(8) Akta ibu dipinda dengan menggantikan perkataan \"perniagaan\" dengan perkataan \"pengendali\". Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 11(1) Akta ibu dipinda dengan menggantikan perenggan (d) dengan perenggan yang berikut: \"(d) pengendali gagal mengekalkan lebihan aset daripada liabiliti mengikut perenggan 4(2)(b), atau, dalam hal pengendali takaful antarabangsa, pengendali takaful antarabangsa itu telah gagal mematuhi kehendak seksyen 40c, mengikut mana-mana yang berkenaan;\". Bahagian baru HA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas Bahagian II Bahagian yang berikut: \"BAHAGIAN IIA PERNIAGAAN TAKAFUL ANTARABANGSA Kehendak bagi menjalankan perniagaan sebagai pengendali takaful antarabangsa 40A. (1) Tiada seorang pun, selain seorang pengendali takaful yang mendaftar di bawah seksyen 8, boleh menjalankan atau melakukan transaksi atau mengemukakan dirinya sebagai menjalankan atau melakukan transaksi perniagaan takaful antarabangsa melainkan orang itu merupakan — (a) suatu syarikat sebagaimana yang ditakrifkan dalam Akta Syarikat 1965; atau (b) suatu institusi asing, dan didaftarkan di bawah Bahagian ini untuk menjalankan perniagaan itu. (2) Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lapan puluh ribu ringgit, dengan ditambah sebanyak enam belas ribu ringgit bagi tiap-tiap hari yang dia dibuktikan telah melakukan kesalahan itu, atau dipenjarakan selama tempoh tidak melebihi dua belas bulan atau kedua-duanya. Pendaftaran pengendali takaful antarabangsa oleh Ketua Pengarah 40B. (1) Suatu syarikat atau institusi asing yang membuat permohonan untuk pendaftaran di bawah Bahagian ini hendaklah membuat permohonan itu secara bertulis kepada Ketua Pengarah dan hendaklah membekalkan — (a) suatu salinan memorandum persatuan dan artikel persatuan atau surat cara lain yang di bawahnya syarikat atau institusi asing itu, mengikut mana-mana yang berkenaan, diperbadankan, yang ditentusahkan dengan sewajarnya melalui akuan berkanun yang dibuat oleh pegawai kanan syarikat atau institusi asing itu, mengikut mana-mana yang berkenaan; dan (b) apa-apa dokumen atau maklumat lain yang diperlukan oleh Ketua Pengarah. (2) Permohonan untuk didaftarkan berkenaan dengan perniagaan perpaduan keluarga atau perniagaan am boleh dibuat oleh pengendali takaful antarabangsa yang telah pun didaftarkan berkenaan dengan yang satu lagi itu. (3) Ketua Pengarah tidak dikehendaki untuk menimbangkan suatu permohonan di bawah Bahagian ini, melainkan jika dia berpuas hati bahawa tujuan dan pengendalian perniagaan takaful antarabangsa yang hendak dijalankan itu tidak akan melibatkan apa-apa unsur yang tidak diluluskan oleh Agama Islam. (4) Jika Ketua Pengarah berpuas hati bahawa seseorang pemohon telah mematuhi semua kehendak seksyen ini dan seksyen 40c, Ketua Pengarah hendaklah merujukkan permohonan itu kepada Menteri dan melainkan jika Menteri mengarahkan selainnya, Ketua Pengarah hendaklah mendaftarkan pemohon itu berkenaan dengan perniagaan perpaduan keluarga atau perniagaan am atau kedua-duanya— (a) tertakluk kepada pembayaran fi yang ditetapkan di bawah seksyen 9; dan (b) dengan atau tanpa syarat yang boleh dikenakan oleh Ketua Pengarah di bawah seksyen 10. (5) Ketua Pengarah hendaklah menyebabkan notis mengenai apa-apa pendaftaran suatu pengendali takaful antarabangsa disiarkan dalam Warta. Wang modal atau wang kerja bersih minimum 40c. (1) Tiada seorang pun boleh didaftarkan di bawah seksyen 40B dan tiada seorang pun yang didaftarkan di bawah seksyen itu boleh menjalankan perniagaan di Malaysia tanpa kebenaran bertulis Ketua Pengarah jika— (a) dalam hal suatu syarikat, wang modalnya yang tidak terjejas oleh kerugian atau selainnya adalah kurang daripada amaun minimum; atau (b) dalam hal suatu institusi asing, wang kerja bersihnya yang tidak terjejas oleh kerugian atau selainnya adalah kurang daripada amaun minimum. (2) Bagi maksud seksyen ini — \"amaun minimum\" ertinya apa-apa amaun wang modal atau apa-apa amaun wang kerja bersih yang disenggarakan oleh pengendali takaful antarabangsa sebagaimana yang ditetapkan oleh Menteri, atas syor Ketua Pengarah, melalui pemberitahuan dalam Warta; \"wang kerja bersih\" ertinya apa-apa liabiliti bersih institusi asing di luar Malaysia sebagaimana yang ditakrifkan dan dikira mengikut apa-apa cara yang dinyatakan melalui notis secara bertulis dari semasa ke semasa oleh Ketua Pengarah; dan \"wang modal\" ertinya modal berbayar dan rizab dan apa- apa sumber modal lain sebagaimana yang ditakrifkan dan dikira mengikut apa-apa cara yang dinyatakan melalui notis secara bertulis oleh Ketua Pengarah. (3) Penetapan amaun minimum yang hendaklah disenggarakan di bawah subseksyen (2) hendaklah dipatuhi dalam tempoh tangguhan yang sama yang tidak kurang daripada tiga bulan sebagaimana yang dinyatakan dalam pemberitahuan itu. (4) Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lapan puluh ribu ringgit, dengan ditambah sebanyak enam belas ribu ringgit bagi tiap-tiap hari yang dia dibuktikan telah melakukan kesalahan itu, atau dipenjarakan selama tempoh tidak melebihi dua belas bulan atau kedua-duanya. Kuasa Menteri untuk mengubah suai peruntukan tertentu yang hendak dijadikan terpakai bagi pengendali takaful antarabangsa 40D. ( 1 ) Bagi mengelakkan keraguan, diisytiharkan bahawa suatu pengendali takaful atau pengendali takaful antarabangsa hendaklah, berkenaan dengan perniagaan takaful antarabangsa yang dijalankan olehnya, menjadi tertakluk kepada peruntukan Akta ini dan mana-mana peruntukan Akta ini yang terpakai bagi pengendali takaful hendaklah terpakai bagi pengendali takaful antarabangsa seolah-olah sebutan mengenai pengendali takaful dalamnya ialah sebutan mengenai pengendali takaful antarabangsa. (2) Menteri boleh, atas syor Ketua Pengarah, berkenaan dengan perniagaan takaful antarabangsa yang dijalankan oleh suatu pengendali takaful atau pengendali takaful antarabangsa, melalui perintah yang disiarkan dalam Warta, membuat apa- apa ubah suaian kepada mana-mana peruntukan Akta ini sebagaimana yang difikirkannya patut.\". Pindaan seksyen 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 45(4) Akta ibu dipinda dengan memasukkan selepas perkataan \"subseksyen (3) seksyen 8\", perkataan \"atau dalam hal pengendali takaful antarabangsa, subseksyen 40B(1)\". Seksyen baru 59A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 59 seksyen yang berikut: \"Pengecualian 59A. Menteri boleh, atas syor Ketua Pengarah, jika difikirkannya selaras dengan maksud Akta ini, melalui perintah yang disiarkan dalam Warta, mengecualikan dengan atau tanpa syarat, mana-mana pengendali takaful, pengendali takaful antarabangsa atau mana-mana orang daripada semua atau mana-mana peruntukan Akta ini.\". Seksyen baru 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 68 seksyen yang berikut: \"Kuasa untuk mengeluarkan garis panduan, dsb. 69. Ketua Pengarah atau Menteri, boleh, dari semasa ke semasa, mengeluarkan apa-apa garis panduan, surat pekeliling atau nota sebagaimana yang difikirkan suai manfaat atau perlu oleh Ketua Pengarah atau Menteri bagi menguatkuasakan tujuan Akta ini.\"."
      }
    }
  ]
}
