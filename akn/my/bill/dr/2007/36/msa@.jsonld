      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pilihan Raya (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_1__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "( 1 ) Akta ini bolehlah dinamakan Akta Pilihan Raya (Pindaan)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalara Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pilihan Raya 1958 [Akta 19], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif \"pilihan raya Parlimen\" takrif yang berikut: \"pusat mengundi\" ertinya mana-mana bangunan, binaan, kenderaan atau vesel, di tempat yang ditetapkan di bawah seksyen 7, yang dikhaskan dan dilengkapkan bagi maksud mengundi dan mengira undi;'; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif \"tempat mengundi\" dengan takrif yang berikut: ' \"tempat mengundi\" ertinya mana-mana bilik atau ruangan yang dikenali juga sebagai saluran yang disediakan oleh Suruhanjaya Pilihan Raya dalam pusat mengundi.'. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalain nota bahu, dengan menggantikan perkataan \"tempat mengundi\" dengan perkataan \"pusat mengundi\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan \"tempat atau tempat-tempat\" dengan perkataan \"pusat atau pusat-pusat\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (d)(iii), dengan menggantikan perkataan \"tempat atau tempat-tempat\" dengan perkataan \"pusat atau pusat-pusat\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"tempat\" dengan perkataan \"pusat\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan \"tempat mengundi\" di mana-mana jua terdapat dalam subseksyen itu dengan perkataan \"pusat mengundi\". Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: \" (1) Suruhanjaya Pilihan Raya boleh, tertakluk kepada Fasal (1) Perkara 115 Perlembagaan, melantik— (a) seorang Ketua Pendaftar Pemilih bagi Malaysia; (b) seorang Timbalan Ketua Pendaftar Pemilih bagi Malaysia; (c) seorang Pendaftar Pemilih bagi setiap Negeri; (d) seorang Timbalan Pendaftar Pemilih bagi setiap Negeri; (e) apa-apa bilangan Penolong Pendaftar Pemilih sebagaimana yang difikirkannya perlu; dan Pilihan Raya (Pindaan) (f) seorang Pegawai Pengadil bagi setiap kawasan pendaftaran.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memotong perkataan \"di Negeri yang baginya dia dilantik\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (4) dengan subseksyen yang berikut: \"(4) Tertakluk kepada arahan, kawalan dan penyeliaan Timbalan Ketua Pendaftar, Pendaftar hendaklah mempunyai dan boleh menjalankan segala kuasa dan melaksanakan segala fungsi Ketua Pendaftar yang berhubungan dengan pendaftaran pemilih di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini di Negeri yang baginya dia dilantik.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (4) subseksyen yang berikut: \"(4A) Tertakluk kepada arahan, kawalan dan penyeliaan Pendaftar, Timbalan Pendaftar hendaklah mempunyai dan boleh menjalankan segala kuasa dan melaksanakan segala fungsi Ketua Pendaftar yang berhubungan dengan pendaftaran pemilih di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini di Negeri yang baginya dia dilantik.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (5) dengan subseksyen yang berikut: \"(5) Tertakluk kepada arahan, kawalan dan penyeliaan Timbalan Pendaftar, Penolong Pendaftar hendaklah membantu Pendaftar dan Timbalan Pendaftar dalam menjalankan kuasa mereka dan melaksanakan fungsi mereka.\". Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan \"tempat\" dengan perkataan \"pusat\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dan (2), dengan raenggantikan perkataan \"tempat\" dengan perkataan \"pusat\". Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 16(2) Akta ibu dipinda dengan menggantikan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan (e) dengan perenggan yang berikut: \"(e) menetapkan kemudahan yang hendaklah diadakan di pusat mengundi, dan orang yang boleh dibenarkan masuk ke pusat mengundi pada tarikh pungutan undi dijalankan, dan membuat peruntukan bagi pelantikan ketua tempat mengundi atau ketua-ketua tempat mengundi dan pegawai atau kakitangan lain berkenaan dengan setiap pusat mengundi;\"."
      }
    }
  ]
}
