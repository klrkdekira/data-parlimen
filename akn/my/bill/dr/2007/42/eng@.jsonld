      ],
      "schema:name": {
        "@language": "en",
        "@value": "Malaysia Tourism Promotion Board (Amendment) Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysia Tourism Promotion Board (Amendment) Act 2007. Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysia Tourism Promotion Board Act 1992 [Act 481] is amended in paragraph 5(\\)(d) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"of whom — \" the words \"as follows:\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subparagraph (ii) the following subparagraph: \"(ii) at least one representative of the Ministry charged with the responsibility for tourism;\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subparagraph (ii) the following subparagraph: \"(iia) one representative of the Ministry of Finance; and\"."
      }
    }
  ]
