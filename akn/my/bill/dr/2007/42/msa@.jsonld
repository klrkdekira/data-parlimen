      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Lembaga Penggalakan Pelancongan Malaysia (Pindaan) 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Penggalakan Pelancongan Malaysia (Pindaan) 2007. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Lembaga Penggalakan Pelancongan Malaysia 1992 [Akta 481] dipinda dalam perenggan 5(\\)(d) —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan \"yang—\" dengan perkataan \"seperti yang berikut:\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subperenggan (ii) dengan subperenggan yang berikut: \"(ii) sekurang-kurangnya seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi pelancongan;\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/42/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (ii) subperenggan yang berikut: \"(iia) seorang wakil daripada Kementerian Kewangan; dan\"."
      }
    }
  ]
}
