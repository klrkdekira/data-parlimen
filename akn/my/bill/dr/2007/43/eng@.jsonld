        "@value": "Supply Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 2008. Issue and appropriation for the service of the year 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding one hundred and five billion five hundred and seventy-five million and one hundred and forty thousand ringgit (RM105,575,140,000) from the Consolidated Fund for the service of the year 2008 is hereby authorized, and that sum is appropriated for purposes specified in the Schedule."
      }
    },
