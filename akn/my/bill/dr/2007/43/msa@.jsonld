      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2008. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi satu ratus lima bilion lima ratus tujuh puluh lima juta satu ratus empat puluh ribu ringgit (RM105,575,140,000) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2008 adalah dengan ini dibenarkan, dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual. Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/43/msa@/~sched_1",
