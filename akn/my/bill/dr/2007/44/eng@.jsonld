      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “books and other documents” the words “books, documents, objects, articles, materials and things”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV__cl_68__para_a__subpara_ii",
