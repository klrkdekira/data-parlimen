      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 22(1a) of the principal Act is amended by substituting for the words “Department of Museums and Antiquities” the words “Department of Museums Malaysia”. Amendment of section 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV__cl_68",
