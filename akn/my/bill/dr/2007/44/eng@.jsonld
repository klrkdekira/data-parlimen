      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subparagraph 1(3) the following subparagraph: “(3) Two or more hearing of appeals may be heard concurrently at any one time, and if the Chairman of the Special Commissioners— (a) is presiding at the hearing of one of the appeals, the Special Commissioners present at the hearing of the other appeals; or (b) has not been appointed or is not present at the hearing of any of the appeals, the Special Commissioners present at the hearing of the appeals, shall choose one of their number (who shall be a person with experience of the kind mentioned in subparagraph (1)) to preside at the hearing of the other appeal or appeals, as the case may be.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph 1 the following paragraph: “1a. If any one of the Special Commissioners who has commenced hearing any of the appeals is unable to complete the hearing due to expiration of the term of his appointment or other reason, the hearing may, with the consent of both parties, be heard afresh or continued by the remaining Special Commissioners with another Special Commissioner.”;"
      }
    },
