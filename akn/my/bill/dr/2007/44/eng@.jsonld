    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section �08 the following section: “Non-deduction of tax from dividend 108. Where a dividend is paid or credited by a company to any of its shareholders in the basis period for a year of assessment, the company shall not be entitled to deduct tax from such dividend paid or credited.”. Amendment of section 109"
      }
