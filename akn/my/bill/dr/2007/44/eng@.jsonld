      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “books or documents” the words “books, documents, objects, articles, materials and things”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “books or documents” the words “books, documents, objects, articles, materials and things”. Amendment of Third Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_IV__cl_69",
