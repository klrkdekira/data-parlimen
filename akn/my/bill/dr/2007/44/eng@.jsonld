      "schema:text": {
        "@language": "en",
        "@value": "Subparagraphs �2(a)(ii), (iii) and (iv) in respect of paragraph 46(�)(k) of the Income Tax Act �967, section �6 and paragraph 36(d) have effect for the year of assessment 2007 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
