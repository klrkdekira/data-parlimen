      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Finance Act 2007. Amendment of Acts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~chp_I",
      "schema:text": {
        "@language": "en",
        "@value": "The Income Tax Act �967 [Act 53], the Stamp Act �949 [Act 378], the Petroleum (Income Tax) Act �967 [Act 543] and the Labuan Offshore Business Activity Tax Act �990 [Act 445] are amended in the manner specified in Chapters II, III , IV and V respectively."
      }
    },
