      "schema:text": {
        "@language": "en",
        "@value": "AMENDMENTS TO THE LABUAN OFFSHORE BUSINESS ACTIVITY TAX ACT 1990 Commencement of amendments to the Labuan Offshore Business Activity Tax Act 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/44/eng@/~part_II__chp_V__cl_70",
