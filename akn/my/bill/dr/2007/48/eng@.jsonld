        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 8 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “having jurisdiction under section 4 a petition” the words “at any district wherever the immovable property comprised in the estate is situated a petition”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by inserting after the word “title” the words “or other documents evidencing title”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting before the words “shall value” the words “or a valuation officer”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word “situate” the words “, if any”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (6), by inserting before the word “under” the words “or a valuation officer”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (8) the following subsection: “(8) If the Land Administrator decides that the estate is a small estate, he shall deal with the petition in accordance with subsection 4(2) but if it appears to him that it would be more expedient for the petition to be heard by another Land Administrator, he may apply to the Director of Lands and Mines or the Director General of Lands and Mines, as the case may require, for an order to be made under subsection 4(2).”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (9)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word “If” the words “upon ascertaining from the principal registry of the High Court,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_6__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “that other petition has been transferred to him under subsection (8) or”. New section 8A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 8 the following section: “When any movable property is administered by the Corporation 8A. Where a petition for distribution is lodged with a Land Administrator and that any movable property comprised in the estate had been administered or is being administered by the Corporation, the Corporation shall deliver to the Land Administrator any document relating to the property for the purpose of determining whether the estate is or is not a small estate.”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 12(3) of the principal Act is amended by inserting after the words “any penghulu” the words “or a Settlement Officer”. New section 13A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 13 the following section: “Direction or declaration by the Corporation in respect of movable property 13A. Where any movable property comprised in a small estate has been administered by the Corporation, the Land Administrator shall accept any direction or declaration made by the Corporation in relation to the property.”. Amendment of section 15"
      }
    }
  ]
}
