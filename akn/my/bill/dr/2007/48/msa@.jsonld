      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum perkataan “shall value” perkataan “or a valuation officer”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “situate” perkataan “, if any”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6), dengan memasukkan sebelum perkataan “under” perkataan “or a valuation officer”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (8) dengan subseksyen yang berikut: “(8) If the Land Administrator decides that the estate is a small estate, he shall deal with the petition in accordance with subsection 4(2) but if it appears to him that it would be more expedient for the petition to be heard by another Land Administrator, he may apply to the Director of Lands and Mines or the Director General of Lands and Mines, as the case may require, for an order to be made under subsection 4(2).”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_f",
      "@type": "akn:paragraph",
