      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “If” perkataan “upon ascertaining from the principal registry of the High Court,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_f__subpara_ii",
