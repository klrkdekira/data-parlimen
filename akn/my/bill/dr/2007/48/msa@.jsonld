        "@value": "dalam subseksyen (9)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/48/msa@/~cl_6__para_f__subpara_i",
      "@type": "akn:subparagraph",
