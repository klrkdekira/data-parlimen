        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "National Productivity Corporation (Incorporation)(Amendment) Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All Committees and members of the Committees appointed by the National Productivity Corporation under section 5B of the principal Act shall, on the commencement date, be deemed to be the Committees and members thereof appointed by the Malaysia Productivity Corporation. Continuance of service of officers, servants, agents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "All officers and servants appointed by the National Productivity Corporation pursuant to section 5 of the principal Act immediately before the commencement date shall, on the commencement date, be deemed to have been appointed by the Malaysia Productivity Corporation on terms and conditions of service which are not less favourable than the terms and conditions of service applicable to them immediately before the commencement date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "All agents, technical advisors and other persons employed by the National Productivity Corporation pursuant to section 7A of the principal Act immediately before the commencement date shall, on the commencement date, be deemed to have been employed by the Malaysia Productivity Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Productivity Corporation (Incorporation) (Amendment) Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this Act, \"commencement date\" means the date specified in subsection 1(2). General amendments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The National Productivity Corporation (Incorporation) Act 1966, which in this Act is referred to as the \"principal Act\", is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"NATIONAL\" the word \"MALAYSIA\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word \"National\" wherever it appears the word \"Malaysia\". Construction of reference to the principal Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Where, on and after the commencement date, a reference is made in any written law to the \"National Productivity Corporation (Incorporation) Act 1966\", such reference shall be construed as a reference to the \"Malaysia Productivity Corporation (Incorporation) Act 1966\". Change of name of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The National Productivity Corporation under section 3 of the principal Act shall, on and after the commencement date, be known as the \"Malaysia Productivity Corporation\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "AH references to the National Productivity Corporation in any written law or in any instrument, deed, title, document, bond, agreement or working arrangement subsisting immediately before the commencement date, shall, on and after the commencement date, be construed as reference to the Malaysia Productivity Corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The change of name from \"National Productivity Corporation\" to the \"Malaysia Productivity Corporation\" shall not affect any powers, rights, privileges, liabilities, duties or obligations of the National Productivity Corporation, or render defective any legal proceedings by or against it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any legal proceedings that could have been continued or commenced by or against National Productivity Corporation prior to the commencement date may be continued or commenced on and after the commencement date in the name of the Malaysia Productivity Corporation. Liabilities enforceable against the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All existing liabilities incurred by or on behalf of or for the purposes of National Productivity Corporation may, on and after the commencement date, be enforced against the Malaysia Productivity Corporation. 3 (Incorporation) (Amendment) Vesting of land, property and asset in the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "All lands, property and assets that immediately before the commencement date were vested in or reserved for the National Productivity Corporation or any person acting on shall, on the commencement date, vest in or be reserved for the Malaysia Productivity Corporation or any person acting on its behalf without any conveyance, assignment or transfer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "All lands, property and assets vested in or reserved for the Malaysia Productivity Corporation by virtue of subsection (1) shall be so vested in or be so reserved for the Malaysia Productivity Corporation for the like title or interest and on the like tenure as the lands, property and assets were vested or reserved immediately before the commencement date. National Productivity Corporation Fund and loan fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "All moneys contained in or due to be paid to the National Productivity Corporation Fund established under section 10 of the principal Act shall, on the commencement date, be transferred to and be deemed to be part of the Malaysia Productivity Corporation Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any other property belonging to the National Productivity Corporation Fund immediately before the commencement date shall become, on the commencement date, the property of the Malaysia Productivity Corporation Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "All moneys contained in the loan fund and any other fund of the National Productivity Corporation shall, on the commencement date, be transferred to and deemed to be part of the loan fund or such other fund of the Malaysia Productivity Corporation. Members of the Corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/51/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All members of the National Productivity Corporation shall, on the commencement date, be deemed to be the members of the Malaysia Productivity Corporation. The Committees"
      }
    }
  ]
}
