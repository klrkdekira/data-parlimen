      "schema:name": {
        "@language": "en",
        "@value": "Inland Revenue Board of Malaysia (Amendment) Bill 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/6/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/6/eng@/~cl_1__subsec_1",
