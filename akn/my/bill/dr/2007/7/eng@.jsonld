        "@language": "en",
        "@value": "COUNCIL FOR ANTI-TRAFFICKING IN PERSONS Council for Anti-Trafficking in Persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "TRAFFICKING IN PERSONS OFFENCES, IMMUNITY, ETC. Offence of trafficking in persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, who traffics in persons not being a child, for the purpose of exploitation, commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding fifteen years, and shall also be liable to fine. Offence of trafficking in persons by means of threat, force, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, who traffics in persons not being a child, for the purpose of exploitation, by one or more of the following means:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "threat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "use of force or other forms of coercion;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "abduction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "fraud;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "deception;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "abuse of power;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "abuse of the position of vulnerability of a person to an act of trafficking in persons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "the giving or receiving of payments or benefits to obtain the consent of a person having control over the trafficked person, commits an offence and shall, on conviction, be punished with imprisonment for a term not less than three years but not exceeding twenty years, and shall also be liable to fine. Offence of trafficking in children"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, who traffics in persons being a child, for the purpose of exploitation, commits an offence and shall, on conviction, be punished with imprisonment for a term not less than three years but not exceeding twenty years, and shall also be liable to fine. Offence of profiting from exploitation of a trafficked person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who profits from the exploitation of a trafficked person commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding fifteen years, and shall also be liable to a fine of not less than fifty thousand ringgit but not exceeding five hundred thousand ringgit. Consent of trafficked person irrelevant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "In a prosecution for an offence under section 12, 13 or 14, it shall not be a defence that the trafficked person consented to the act of trafficking in persons. Past sexual behaviour irrelevant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A trafficked person's past sexual behaviour is irrelevant and inadmissible for the purpose of proving that the trafficked person was engaged in other sexual behaviour or to prove the trafficked person's sexual predisposition. Anti-Traffic king in Persons Fraudulent travel or identity documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who makes, obtains, gives, sells or possesses a fraudulent travel or identity document for the purpose of facilitating an act of trafficking in persons commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding ten years, and shall also be liable to a fine of not less than fifty thousand ringgit but not exceeding five hundred thousand ringgit. Recruiting persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who knowingly recruits, or agrees to recruit, another person to participate in the commission of an act of trafficking in persons, commits an offence and shall, on conviction be punished, with imprisonment for a term not exceeding ten years, and shall also be liable to fine. Providing facilities in support of trafficking in persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "Any person being —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "the owner, occupier, lessee or person in charge of any premises, room or place, knowingly permits a meeting to be held in that premises, room or place; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "the owner, lessee or person in charge of any equipment or facility that allows for recording, conferencing or meetings via technology, knowingly permits that equipment or facility to be used, for the purpose of committing an offence under this Act, commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding ten years, and shall also be liable to fine. Providing services for purposes of trafficking in persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, directly or indirectly, provides or makes available financial services or facilities —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "intending that the services or facilities will be used, or knowing or having reasonable grounds to believe that the services or facilities will be used, in whole or in part, for the purpose of committing or facilitating the commission of an act of trafficking in persons, or for the purpose of benefiting any person who is committing or facilitating the commission of an act of trafficking in persons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowing or having reasonable grounds to believe that, in whole or in any part, the services or facilities will be used by or will benefit any person involved in an act of trafficking in persons, commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding ten years and shall also be liable to fine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), \"financial services or facilities\" include the services or facilities offered by lawyers or accountants acting as nominees or agents for their clients. Harbouring persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "harbours a person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prevents, hinders or interferes with the arrest of a person, knowing or having reason to believe that such person has committed or is planning or is likely to commit an act of trafficking in persons, commits an offence and shall, on conviction, be punished with imprisonment for a term not exceeding ten years, and shall also be liable to fine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"harbour\" means supplying a person with shelter, food, drink, money or clothes, arms, ammunition or means of conveyance, or assisting a person in any way to evade apprehension. Obligation of owner, operator or master of conveyance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any person being the owner, operator or master of any conveyance, that engages in the transportation of goods or people for commercial gain shall ensure that every person travelling on board is in possession of travel documents for lawful entry of that person into the receiving country."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any owner, operator or master of any conveyance mentioned in subsection (1), who —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly permits or has reasonable grounds to believe that such conveyance is used for the purpose of bringing a person into a receiving country without travel documents required for the lawful entry of that person into the receiving country; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly permits or has reasonable grounds to believe that such conveyance is being used for the purpose of committing an act of trafficking in persons, commits an offence and shall, on conviction be liable —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding two hundred and fifty thousand ringgit or to imprisonment for a term not exceeding five years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not less than fifty thousand ringgit but not exceeding five hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings for an offence under this section, it shall be a defence for such owner, operator or master to prove that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he has reasonable grounds to believe that the travel documents of the person travelling on board are travel documents required for lawful entry of that person into the receiving country;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person travelling on board possessed travel documents required for lawful entry into the receiving country when that person boarded, or last boarded, the conveyance to travel to the receiving country; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the entry of the person into the receiving country occurred only because of illness or injury to that person, stress of weather or any other circumstances beyond the control of such owner, operator or master."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any person convicted of an offence under this section shall be liable to pay the costs of the trafficked person's detention in, and removal from, the receiving country. Intentional omission to give information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who knowing or having reason to believe, that any offence under this Act has been or will be committed, intentionally omits to give any information respecting that offence, commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred and fifty thousand ringgit or to imprisonment for a term not exceeding five years, or to both. Immunity from criminal prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "A trafficked person shall not be liable to criminal prosecution in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "his illegal entry into the receiving country;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "his period of unlawful residence in the receiving country; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "his procurement or possession of any fraudulent travel or identity document which he obtained, or with which he was supplied, for the purpose of entering the receiving country, where such acts are the direct consequence of an act of trafficking in persons that is alleged to have been committed or was committed. Protection of informers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no complaint as to an offence under this Act shall be admitted in evidence in any civil or criminal proceedings whatsoever, and no witness shall be obliged or permitted to disclose the name or address of any informer, or state any matter which might lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "If any book, document or paper which is in evidence or liable to inspection in any civil or criminal proceedings whatsoever contains any entry in which any informer is named or described or which might lead to his discovery, the court before which the proceedings is had shall cause all such entries to be concealed from view or to be obliterated so far as is necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "If in a trial for any offence under this Act, the Court, after full enquiry into the case, is of the opinion that the informer willfully made in his complaint a material statement which he knew or believe to be false or did not believe to be true, or if in any other proceedings the court is of the opinion that justice cannot be fully done between the parties without the discovery of the informer, the Court may require the production of the original complaint, if in writing, and permit enquiry and require full disclosure concerning the informer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_III__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who gives the information referred to in this section knowing that the information is false, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish such committees as it deems necessary or expedient to assist it in the performance of its functions and the exercise of its powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any meeting of the committee for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited under subsection (10) may be paid such allowance as the Minister may determine. Secretary of the Council and other officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be chaired by any member of the Council specified under paragraphs 6(2)(b) to (m);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall conform to and act in accordance with any direction given to it by the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Members of the committees established under subsection (1) may be appointed from amongst members of the Council or such other persons as the Council thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Except for members of the Committees appointed from amongst members of the Council, any other persons appointed as members of the Committees may be paid such allowance as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his letter of appointment and is eligible for reappointment. Anti-Traffic king in Persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may revoke the appointment of any member of a committee without assigning any reason therefor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign by giving notice in writing to the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, at any time, discontinue or alter the constitution of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall hold its meetings at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a public officer to be the Secretary of the Council and such other public officers as may be necessary to assist the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) A body to be known as Council for Anti-Trafficking in Persons shall be established for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for internal security, who shall be the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for foreign affairs, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for home affairs, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for women, family and community development, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for human resources, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for transport, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for information, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Attorney General of Malaysia, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Inspector General of Police, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director-General of Immigration, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director-General of Customs, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director-General of Malaysian Maritime Enforcement, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry responsible for internal security; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "not more than three persons from non-governmental organization or other relevant organizations having appropriate experience, knowledge and expertise in problems and on issues relating to trafficking in persons including the protection and support of trafficked persons, to be appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Each member of the Council appointed under paragraph (2)(n) shall, unless he sooner resigns, hold office for a period not exceeding two years and is eligible for re-appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Council appointed under paragraph (2)(n) may, at any time resign his office, by giving notice in writing to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Council specified under subsection (2) may be paid such allowances as the Minister may determine. Functions and powers of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall perform the functions of coordinating the implementation of this Act, formulating policies and programmes to prevent and suppress trafficking in persons including programmes in rendering assistance to trafficked persons, formulating protective programmes for trafficked persons and initiating education programmes to increase public awareness of the causes and consequences of the act of trafficking in persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), it shall be the responsibility of the Council to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "formulate and oversee the implementation of a national action plan on the prevention and suppression of trafficking in persons including the support and protection of trafficked persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make recommendations to the Minister on all aspects of prevention and suppression of trafficking in persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "monitor the immigration and emigration patterns in Malaysia for evidence of trafficking and to secure the prompt response of the relevant government agencies or bodies, and non-governmental organizations to problems on trafficking in persons brought to their attention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "coordinate in the formulation of policies and monitor its implementation on issues of trafficking in persons with relevant government agencies or bodies and non-governmental organizations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "formulate and coordinate measures to inform and educate the public, including potential trafficked persons, on the causes and consequences of trafficking in persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "cooperate and coordinate with international bodies and other similar regional bodies or committees in relation to the problems and issues of trafficking in persons including support and protection of trafficked persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "advise the government on the issues of trafficking in persons including developments at the international level against the act of trafficking in persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "collect and collate data and information, and authorise research, in relation to the prevention and suppression of trafficking in persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "perform any other functions as directed by the Minister for the proper implementation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have all such powers as may be necessary for, or in connection with, or incidental to, the performance of its functions under this Act. Power of Minister to issue directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, give the Council directions not inconsistent with this Act as to the performance of the functions and powers of the Council and the Council shall give effect to such directions. Meetings of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet as often as may be necessary for the performance of its functions at such time and place as the Chairman may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members, including the Chairman, shall form the quorum of a meeting of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside over all its meetings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is unable for any reason to preside any meeting of the Council, the meeting shall be presided by a member elected from amongst the members present."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any person to attend any meeting or deliberation of the Council for the purpose of advising it on any matter under discussion, but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "At any meeting of the Council, the Chairman shall have a deliberative vote and shall, in the event of an equality of votes, have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited under subsection (5) may be paid such allowance as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of this Act, the Council may make rules for regulating its meetings and proceedings. Establishment of Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Enforcement officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The following officers shall be enforcement officers for the purpose of this Act and may exercise all powers of enforcement:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any immigration officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any Officer of customs; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any officer of the Malaysian Maritime Enforcement Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer when acting against any person under this Act, shall declare his office and shall produce to the person against whom he is acting any authority card which has been issued to him. Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer shall have all the powers necessary to carry out an investigation for any offence under this Act. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer may arrest without warrant any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "found committing or attempting to commit or abetting the commission of an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whom the enforcement officer reasonably suspects of being engaged in committing or attempting to commit or abetting the commission of an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer making an arrest under subsection (1) shall, without unnecessary delay, bring the person arrested to the nearest police station, and thereafter the person shall be dealt with in accordance with the law relating to criminal procedure for the time being in force. Search and seizure with warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath and after such enquiry as the Magistrate considers necessary, that there is reasonable cause to believe that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any premises or conveyance has been used or is about to be used for; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is in any premises or conveyance evidence necessary to the conduct of an investigation into, the commission of an offence under this Act, the Magistrate may issue a warrant authorizing any enforcement officer named therein, at any reasonable time, by day or by night, to enter the premises or conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A warrant issued under subsection (1) may authorise the enforcement officer to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "search the premises or conveyance for, and to seize or remove from the premises or conveyance, any moveable, property, book, record, report or document, or any human organ that is reasonably believed to furnish evidence of the commission of such offence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make copies of, or take extracts from any book, record, report or document found in the premises or conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer entering any premises or conveyance under this section may take with him such other persons or equipment as may appear to him to be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer may, in the exercise of his powers under this section, if necessary —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door of the premises or conveyance or any obstruction to the premises or conveyance in order to effect entry into the premises or conveyance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to entry, search, seizure or removal as he is empowered to effect under this section; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "detain any person found in the premises or conveyance until the search has been completed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where, by reason of its nature, size or amount, it is not practicable to remove any moveable property, book, record, report or document or any human organ seized under this section, the enforcement officer shall, by any means, seal such moveable property, book, record, report or document or any human organ in the premises or conveyance in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (5) or removes the moveable property, book, record, report or document or any human organ under seal, or attempts to do so, commits an offence. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) Where an enforcement officer has reasonable grounds to believe that by reason of delay in obtaining a search warrant under section 30, the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, he may, without warrant, with such assistance and force as is necessary —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "enter and search any premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "stop and search any conveyance or person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "seize and detain such conveyance, raoveable property, book, record, report or document or human organ; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "inspect, make copies of or take extract from any book, record, report or document found in the premises or conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising his powers under this section, an enforcement officer shall have all the powers conferred upon him under subsections 30(3), (4) and (5). Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any enforcement officer conducting a search under this Act shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the enforcement officer shall be provided with the necessary password, encryption code, decryption code, software or hardware or any other means required for his access to enable comprehension of the computerized data. List of things seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any conveyance, moveable property, book, record, report or document or any human organ is seized under this Part, the enforcement officer shall prepare a list of the things seized and immediately deliver a copy signed by him to the occupier of the premises or the owner of the conveyance which has been searched, or to his agent or servant, at the premises or conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Where the premises is unoccupied, the enforcement officer shall, whenever possible, post a list of the things seized conspicuously at or on the place or premises. Power to examine persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "(1) An enforcement officer may, by notice in writing, require any person whom he believes to be acquainted with the facts and circumstances of the case to — (a) attend before him for examination; (b) produce before him any moveable property, record, report or document; or (c) furnish him a statement in writing made on oath or affirmation setting out such information as he may require. (2) Any person who contravenes subsection (1) commits an offence. (3) The person examined under subsection (1) shall be legally bound to answer all questions relating to such case put to him by the enforcement officer, but he may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture. (4) A person making a statement under paragraph (i)(c) shall be legally bound to state the truth, whether or not such statement is made wholly or partly in answer to the questions of the enforcement officer. (5) An enforcement officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (3) and (4). (6) A statement made by any person under subsection (3) or (4) shall be reduced into writing and signed by the person making it or affixed with his thumb print- fa) after it has been read to him in the language in which he made it; and (b) after he has been given an opportunity to make any correction he may wish. Admissibility of statement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no statement made by any person to an enforcement officer in the course of an investigation made under this Act shall be used in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "When any witness is called for the prosecution or for the defence, other than the accused, the Court shall, on the request of the accused or the prosecutor, refer to any statement made by that witness to an enforcement officer in the course of an investigation under this Act and may then, if the Court thinks fit in the interest of justice, direct the accused to be furnished with a copy of it and the statement may be used to impeach the credit of the witness in the manner provided by the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where the accused had made a statement during the course of an investigation, such statement may be admitted in evidence in support of his defence during the course of the trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to apply to any statement made in the course of an identification parade or falling within section 27 or paragraphs 32(1)(a), (i) and (j) of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with any offence in relation to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the making; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the contents, of any statement made by him to an enforcement officer in the course of an investigation made under this Act, that statement may be used as evidence in the prosecution's case. Forfeiture of conveyance, moveable property, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "All conveyance, moveable property, book, record, report or document, or any human organ seized in the exercise of any power conferred under this Act are liable to forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Court trying any person accused of an offence under this Act may at the conclusion of the trial, whether he is convicted or not, order that the conveyance, moveable property, book, record, report or document or any human organ seized from that person be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is no prosecution with regard to any offence under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of human organ seized, it shall be deemed to be forfeited; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of the conveyance, moveable property, book, record, report or document seized, the enforcement officer shall serve a notice in writing to the last known address of the person from whom the conveyance, moveable property, book, record, report or document was seized."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The notice in paragraph (3)(b) shall specify that there is no prosecution in respect of such conveyance, moveable property, book, record, report or document and that such conveyance, moveable property, book, record, report or document will be forfeited at the expiration of one calendar month from the date of service of the notice unless a claim is made by the person from whom the conveyance, moveable property, book, record, report or document was seized."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the notice issued under paragraph (3)(b), any person asserting that he is the owner of any conveyance, moveable property, book, record, report or document seized under this Act which is not liable to forfeiture may, personally or by his agent authorized in writing by him, give written notice to the enforcement officer in whose possession the conveyance, moveable property, book, record, report or document is held."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of a notice under subsection (5), the enforcement officer who made the seizure shall refer the matter to the Court for its determination."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Court to which the matter is referred shall issue a summons requiring the person asserting that he is the owner of the conveyance, moveable property, book, record, report or document and the person from whom it was seized to appear before the Court, and upon their appearance or default to appear, due service of the summons being proved, the Court shall proceed to the examination of the matter, and on proof that such conveyance, moveable property, book, record, report or document was the subject matter of or was used in the commission of an offence under this Act, shall order the conveyance, moveable property, book, record, report or document to be forfeited or may, in the absence of such proof, order the release of such conveyance, moveable property, book, record, report or document to the person entitled to it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any conveyance, moveable property, book, record, report or document or any human organ forfeited or deemed to be forfeited shall be disposed of in any manner as the enforcement officer deems fit. Cost of holding conveyance, moveable property, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Where any conveyance, moveable property, record, report or document or human organ seized under this Act is held in the custody of the enforcement officer pending completion of any proceedings in respect of an offence under this Act, the cost of holding such conveyance, moveable property, record, report or document or any human organ in custody shall, in the event of any person being found guilty of an offence, be a civil debt due to the Government by such person and shall be recoverable accordingly. No costs or damages arising from entry, search or seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in respect of any entry or search, or seizure of any conveyance, moveable property, record, report or document or any human organ seized in the exercise of any power conferred by this Act, be entitled to the costs of such entry, search, or seizure or to any damages or other relief unless such entry, search or seizure was made without reasonable cause. Obstruction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who obstructs, impedes, interferes or fails to comply with any lawful demand of an enforcement officer in the performance of his functions under this Act commits an offence. Tipping-off"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knows or has reasonable grounds to suspect that an enforcement officer is acting, or is proposing to act, in connection with an investigation which is being, or is about to be, conducted under or for the purposes of this Act and discloses to any other person information or any other matter which is likely to prejudice that investigation or proposed investigation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "knows or has reasonable grounds to suspect that a disclosure has been made to an enforcement officer under this Act and discloses to any other person information or any other matter which is likely to prejudice any investigation which might be conducted following the disclosure, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) makes it an offence for an advocate and solicitor or his employee to disclose any information or other matter—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to his client or the client's representative in connection with the giving of advice to the client in the course and for the purpose of the professional employment of the advocate and solicitor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to any person in contemplation of, or in connection with and for the purpose of, any legal proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (2) does not apply in relation to any information or other matter which is disclosed with a view to furthering any illegal purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "In a proceedings against a person for an offence under this section, it is a defence to prove that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "he did not know or suspect that the disclosure made under paragraph (1)(b) was likely to prejudice the investigation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_40__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "he had lawful authority or reasonable excuse for making the disclosure. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Anti-Trafficking in Persons Act 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires —"
      },
      "schema:text": {
        "@language": "en",
        "@value": "\"this Act\" includes any subsidiary legislation made under this Act; \"prescribed\" means prescribed by the Minister by regulations; \"fraudulent travel or identity document\" means a travel or identity document that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been made, or altered in a material way, by a person other than a person or agency lawfully authorised to make or issue the travel or identity document on behalf of a country;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been issued or obtained through misrepresentation, corruption or duress or in any other unlawful manner; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "is being improperly used by a person other than the rightful holder; \"exploitation\" means all forms of sexual exploitation, forced labour or services, slavery or practices similar to slavery, servitude, any illegal activity or the removal of human organs; \"child\" means a person who is under the age of eighteen years; \"Court\" means Sessions Court; \"Council\" means the Council for Anti-Trafficking in Persons established under section 6; \"Minister\" means the Minister charged with the responsibility for internal security; \"receiving country\" means any country into which a trafficked person is brought as part of an act of trafficking in persons; \"trafficked person\" means any person who is the victim or object of an act of trafficking in persons; \"coercion\" means —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "threat of serious harm to or physical restraint against any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any scheme, plan, or pattern intended to cause a person to believe that failure to perform an act would result in serious harm to or physical restraint against any person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the abuse or threatened abuse of the legal process; \"officer of the Malaysian Maritime Enforcement Agency\" has the same meaning assigned to it by the Malaysian Maritime Enforcement Agency Act 2004 [Act 633]; \"immigration officer\" has the same meaning assigned to it by the Immigration Act 1959/63 [Act 155]; \"Officer of customs\" has the same meaning assigned to it by the Customs Act 1967 [Act 235]; \"Social Welfare Officer\" means any Social Welfare Officer in the ministry or department responsible for welfare services and includes any Assistant Social Welfare Officer; \"Protection Officer\" means any officer appointed under section 43; \"enforcement officer\" means any officer specified in section 27; \"medical officer\" means a registered medical practitioner in the service of the Government and includes a registered medical practitioner in any teaching hospital of a University; \"permanent resident\" has the same meaning assigned to it by the Courts of Judicature Act 1964 [Act 91]; \"trafficking in persons\" or \"traffics in persons\" means the recruiting, transporting, transfering, harbouring, providing or receiving of a person for the purpose of exploitation; \"conveyance\" means any vehicle, vessel, ship, aircraft, or any other mode of transport whether by air, sea or land; \"Protection Order\" means an order made by a Magistrate for the care and protection of a trafficked person under paragraph \"premises\" means house, building, factory, land, tenement, easement of any tenure, whether open or enclosed, whether built on or not, whether public or private, and whether maintained or not under statutory authority, and includes any container. Scope of application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The offences under this Act apply, regardless of whether the conduct constituting the offence took place inside or outside Malaysia, in the following circumstances —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "if Malaysia is the receiving country or the exploitation occurs in Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the receiving country is a foreign country but the trafficking in persons starts in Malaysia or transits Malaysia. Extension of Act to extra territorial offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Any offence under this Act committed—."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "on the high seas on board any ship or on any aircraft registered in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by any citizen or permanent resident of Malaysia on the high seas on board any ship or on any aircraft; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by any citizen or any permanent resident in any place outside and beyond the limits of Malaysia, may be dealt with as if it had been committed at any place within Malaysia. Prevailing law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_5__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "( 1 ) The provisions of this Act shall be in addition to, and not in derogation of, the provisions of any other written law relating to trafficking in persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any conflict or inconsistency between the provisions of this Act and those of any other written laws, the provisions of this Act shall prevail and the conflicting or inconsistent provisions of such other written laws shall, to the extent of the conflict or inconsistency, be deemed to be superseded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_57"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CARE AND PROTECTION OF TRAFFICKED PERSONS Place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Restriction on media reporting and publication"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written laws to the contrary, any mass media report regarding —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any step taken in relation to a trafficked person in any proceedings be it at the pre-trial, trial or post-trial stage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any trafficked person in respect of whom custody or protection is accorded under Part V; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters under this Act, shall not reveal the name or address, or include any particulars calculated to lead to the identification of any trafficked person so concerned either as being the trafficked person or as being a witness to any proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "A picture of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any trafficked person in any of the matters mentioned in subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other person, place or thing which may lead to the identification of the trafficked person, shall not be published in any newspaper or magazine or transmitted through any electronic medium."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence. Evidence of agent provocateur admissible"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any law or rule of law to the contrary, in any proceedings against any person for an offence under this Act, no agent provocateur shall be presumed to be unworthy of credit by reason only of his having attempted to commit or to abet, or having abetted or having been engaged in a criminal conspiracy to commit, such offence if the main purpose of such attempt, abetment or engagement was to secure evidence against such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any law or rule of law to the contrary, a conviction for any offence under this Act solely on the uncorroborated evidence of any agent provocateur shall not be illegal and no such conviction shall be set aside merely because the court which tried the case has failed to refer in the grounds of its judgment to the need to warn itself against the danger of convicting on such evidence. Admissibility of documentary evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any enforcement officer has obtained any document or other evidence in exercise of his powers under this Act, such document or copy of the document or other evidence, as the case may be, shall be admissible in evidence in any proceedings under this Act, notwithstanding anything to the contrary in any written laws. Admissibility of translation of documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Where any document which is to be used in any proceeding against any person for an offence under this Act is in a language other than the national language or English language, a translation of such document into the national language or English language shall be admissible in evidence where the translation is accompanied by a certificate of the person who translated the document setting out that it is an accurate, faithful and true translation and the translation had been done by such person at the instance of any enforcement officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall apply to a document which is translated, regardless of whether the document was made in or outside Malaysia, or whether the translation was done in or outside Malaysia, or whether possession of such document was obtained by any enforcement officer in or outside Malaysia. Indemnity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted, or maintained in any court or before any other authority against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "any enforcement officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "any Protection Officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "any person lawfully acting in compliance with any direction or order of an enforcement officer or a Protection Officer, for or on account of, or in respect of, any act done or statement made or omitted to be done or made, or purporting to be done or made or omitted to be done or made, in pursuance of or in execution of, or intended pursuance of or execution of, this Act or any order in writing, direction or other thing issued under this Act if such act or statement was done or made, or was omitted to be done or made, in good faith. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under this Act for which no penalty is expressly provided shall, on conviction, be liable to a fine not exceeding one hundred and fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Offence by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any offence against any provision of this Act has been committed by a body corporate, any person who -at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate, or was purporting to act in any such capacity, or was in any manner responsible for the management of any of the affairs of such body corporate, or was assisting in such management, shall also be guilty of that offence unless he proves that the offence was committed without his knowledge, consent or connivance, and that he exercised all such diligence to prevent the commission of the offence as he ought to have exercised, having regard to the nature of his functions in that capacity and to all the circumstances. Offence by employee or agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable under this Act to any punishment or penalty for any act, omission, neglect or default, such person shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his or of the employee of such agent, if such act, omission, neglect or default was committed by the person's employee in the course of his employment, or by the agent when acting on behalf of the person, or by the employee of such agent in the course of his employment by such agent, or otherwise on behalf of the agent. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as are necessary or expedient to give full effect to, or for carrying out, the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection ( 1) , regulations may be made-fa) to prescribe the functions or any other matters in relation to the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for an offence, any act or omission which contravenes any provision of any regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the imposition of penalties for such offences;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe measures for the care and protection of trafficked persons at the place of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe for the powers and functions of a Protection Officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate the management, administration and control of place of refuge, including provisions for the powers, duties and functions of the person in charge of place of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for any matter which, under this Act, is required or permitted to be prescribed or which is necessary or expedient to be prescribed. Prevention of anomalies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, whenever it appears to him necessary or expedient to do so, whether for the purpose of removing difficulties or preventing anomalies in consequence of the enactment of this Act, by order published in the Gazette make such modifications to any provisions in this Act as he thinks fit, but the Minister shall not exercise the powers conferred by this section after the expiration of two years from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, \"modifications\" include amendments, additions, deletions, substitutions, adaptations, variations, alterations, and non-application of any provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by notification in the Gazette, declare any house, building or place, or any part thereof, to be a place of refuge for the care and protection of trafficked persons and may, in like manner, declare that such place of refuge ceases to be a place of refuge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, direct the separation of different categories of trafficked persons, among others, according to age and gender either at the same place of refuge or at different places of refuge. Appointment of Protection Officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister, after consultation with the Minister charged with the responsibility for women, family and community development may, by notification in the Gazette, appoint such number of Social Welfare Officers or any other public officers to exercise the powers and perform the duties of a Protection Officer under this Act subject to any condition as may be specified in the notification."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Protection Officer shall —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have control over and responsibility for the care and protection of the trafficked person at the place of refuge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "carry out an enquiry and cause to be prepared a report of the trafficked person as required under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have the power to supervise the trafficked person upon order by the Magistrate or direction by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have such other powers, duties and functions as the Minister may prescribe. Anti-Traffic king in Persons Taking a person into temporary custody"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer may, on reasonable suspicion that any person who is found or rescued is a trafficked person, take that person into temporary custody and produce him before a Magistrate within twenty-four hours, exclusive of the time necessary for the journey to the Magistrate's Court, for the purpose of obtaining an interim protection order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate may make an interim protection order for the person to be placed at a place of refuge for a period of fourteen days for the purpose of carrying out an investigation and enquiry under section 51."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The enforcement officer shall, upon obtaining the order issued under subsection (2), surrender the trafficked person to a Protection Officer to place that trafficked person at the place of refuge specified in the order. Person in temporary custody in need of medical examination or treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Where an enforcement officer who takes a person into temporary custody under subsection 44(1) is of the opinion that the person is in need of medical examination or treatment, the enforcement officer may, instead of taking that person before a Magistrate, present him to a medical officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "If at the time of being taken into temporary custody, the person is a patient in a hospital, the enforcement officer may leave that person in the hospital. Medical examination and treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "A medical officer before whom a person is presented under section 45 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "shall conduct or cause to be conducted an examination of the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "may in examining the person and if so authorised by an enforcement officer, administer or cause to be administered such procedures and tests as may be necessary to diagnose the person's condition; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "may provide or cause to be provided such treatment as he considers necessary as a result of the diagnosis. Authorization for hospitalization"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person taken into temporary custody under subsection 44(1) is a child and the medical officer who examines him is of the opinion that his hospitalization is necessary for the purpose of medical care or treatment, an enforcement officer may authorise that person to be hospitalised. Control over hospitalised person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person taken into temporary custody under subsection 44(1) is hospitalised, the enforcement officer shall have control over, and responsibility for, the security and protection of that person. Steps to be taken after medical examination or treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is taken into temporary custody under subsection 44(1) and is medically examined under section 46 shall be produced before a Magistrate within twenty-four hours —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the completion of such examination or treatment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the person is hospitalised, on his discharge from the hospital."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "If it is not possible to bring that person before a Magistrate within the time specified in subsection (1), that person shall be placed in a place of refuge until such time as he can be brought before a Magistrate. No liability incurred for giving authorization"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If a person is examined or treated under this Part—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the enforcement officer who authorises such examination or treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the medical officer who examines or treats the person; and Anti-Trajficking in Persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all persons acting in aid of the medical officer, shall not incur any liability at law by reason only that a person is examined or treated pursuant to this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing contained in subsection (1) relieves a medical officer from liability in respect of the examination or treatment of the person taken into temporary custody under subsection 44(1), which liability he would have been subject to had the examination or treatment been carried out or administered with the consent of the parent or guardian of the person or person having authority to consent to the examination or treatment. Investigation, enquiry and Protection Order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where an interim protection order is made under subsection 44(2), within fourteen days from the date of such order—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an enforcement officer shall investigate into the circumstances of the person's case for the purpose of determining whether the person is a trafficked person under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Protection Officer shall enquire into the background of that person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Upon completion of the investigation and enquiry under subsection (1), the enforcement officer and the Protection Officer shall prepare a report and produce the report together with the person before a Magistrate's Court for the purpose of satisfying the Magistrate that such person is a trafficked person under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Magistrate, having read the report produced under subsection (2), is satisfied that the person brought before him —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is a trafficked person and in need of care and protection, the Magistrate may make a Protection Order—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a trafficked person who is a citizen or permanent resident of Malaysia, ordering that such trafficked person be placed in a place of refuge for a period not exceeding two years from the date of the order; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a trafficked person who is a foreign national, ordering that such trafficked person be placed in a place of refuge for a period not exceeding three months from the date of the order, and thereafter to release him to an immigration officer for necessary action in accordance with the provisions of the Immigration Act 1959/63,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is not a trafficked person, the Magistrate may —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a person who is a citizen or permanent resident of Malaysia, order that person to be released; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a person who is a foreign national, order that person to be released to an immigration officer for necessary action in accordance with the provisions of the Immigration Act 1959/63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate may at any time, on the application of an enforcement officer or a Protection Officer, as the case may be, extend or revoke the Protection Order made under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), where the trafficked person is a foreign national, an extension of the Protection Order may be granted only for the purpose of completing the recording of his evidence under section 52 or for any exceptional circumstances as determined by the Magistrate. Recording of evidence of trafficked person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "At any time during the period of the Protection Order made under subparagraph 51 (3)(a)(ii), where a criminal prosecution has been instituted against any person for an offence under this Act, an enforcement officer may make an oral application for the production of the trafficked person before a Magistrate's Court for the purpose of recording that trafficked person's evidence on oath."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate may, upon such application, issue a summons or order directed to the person in charge of the place of refuge where such trafficked person is placed, requiring him to produce the trafficked person at the time and place specified in the summons or order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate shall record the evidence of the trafficked person and complete such recording within seven days from the date of the production of that trafficked person before him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "In the course of the recording of evidence of the trafficked person, he shall be examined in accordance with the provisions of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate shall cause the evidence taken by him to be reduced into writing and, at the end of that writing, shall sign the same."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in this Act or any other written laws to the contrary, the evidence recorded under this section shall be admissible in evidence in any proceedings under this Act and the weight to be attached to such evidence shall be the same as that of a witness who appears and gives evidence in the course of a proceeding. Application by parent, guardian or relative"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Where a trafficked person placed in a place of refuge is a citizen or permanent resident of Malaysia, the parent, guardian or relative of that person may, at any time, make an application to the Magistrate's Court to commit that person into the custody of the parent, guardian or relative."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "The parent, guardian or relative of the trafficked person shall serve a copy of the application to the Protection Officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application under subsection (2), the Protection Officer shall cause a report to be prepared in relation to —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the trafficked person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the status of any investigation or prosecution for any offence under this Act in relation to the trafficked person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the background of the trafficked person, his parent, guardian or relative; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any other matter as the Protection Officer deems relevant, to enable the Magistrate to determine the application in the best interest of the trafficked person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate shall, upon receipt of the application, fix a date for the hearing of the application, and shall, by notice in writing, inform the parent, guardian or relative of the trafficked person, as the case may be, the Protection Officer or other person the Magistrate deems fit, and shall require the production of the trafficked person before him on the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "After hearing the application and having read the report of the Protection Officer, and if the Magistrate is satisfied that it is in the best interest of the trafficked person, he may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "commit the person into the care and protection of the parent, guardian or relative of the person, upon such conditions as he may deems fit to impose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "require the parent, guardian or relative of the person to enter into a bond; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "require the person to be placed under the supervision of a Protection Officer, for a period to be determined by the Magistrate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate may, at any time, revoke any order made under subsection (5). Release of trafficked person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Upon revocation of a Protection Order or expiry of the period specified in a Protection Order, the Protection Officer shall-"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a trafficked person who is a citizen or permanent resident of Malaysia, release that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a trafficked person who is a foreign national, release that person to an immigration officer for necessary action in accordance with the provisions of the Immigration Act 1959/63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The immigration officer shall take all necessary steps to facilitate the return of that trafficked person to his country of origin without unnecessary delay, with due regard for his safety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (1)(a), the court may, upon an application made by the Protection Officer, and being satisfied that such person is in need of further care and protection, make an order that such trafficked person be placed in the place of refuge for any further period as the Magistrate deems fit. Trafficked person who escapes or is removed from place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Any trafficked person who escapes or is removed from a place of refuge without lawful authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "may be taken into custody by any enforcement officer and shall be brought back to the place of refuge; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "shall be placed for such period which is equal to the period during which he was unlawfully at large and for the unexpired residue of his term in the Protection Order originally made by the Magistrate. Offence of removing or helping a trafficked person to escape from place of refuge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "removes a trafficked person from a place of refuge without lawful authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly assists or induces, directly or indirectly, a trafficked person to escape from a place of refuge; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly harbours or conceals a trafficked person who has so escaped, or prevents him from returning to the place of refuge, commits an offence. Power of Minister to remove trafficked person from one place of refuge to another"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, for reasons which appear to him to be sufficient, by order in writing direct the removal of any trafficked person from a place of refuge to any other place of refuge as may be specified in the order."
      }
    }
  ]
}
