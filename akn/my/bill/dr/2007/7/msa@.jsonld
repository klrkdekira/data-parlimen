        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang berlawanan, apa-apa laporan media massa mengenai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa langkah yang diambil berhubung dengan orang yang diperdagangkan dalam mana-mana presiding sama ada pada peringkat sebelum perbicaraan, perbicaraan atau selepas perbicaraan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang diperdagangkan yang berkenaan dengannya jagaan atau perlindungan diberikan di bawah Bahagian V; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain di bawah Akta ini, tidak boleh mendedahkan nama atau alamat, atau memasukkan apa- apa butiran yang dikira boleh membawa kepada pengenalpastian mana-mana orang yang diperdagangkan yang terlibat sedemikian sama ada sebagai orang yang diperdagangkan atau sebagai seorang saksi dalam mana-mana prosiding."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Gambar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang diperdagangkan dalam mana-mana perkara yang disebut dalam subseksyen (1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang, tempat atau benda lain yang mungkin membawa kepada pengenalpastian orang yang diperdagangkan, tidak boleh disiarkan dalam mana-mana akhbar atau majalah atau disampaikan melalui apa-apa perantara elektronik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan. Keterangan agent provocateur boleh diterima"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang atau rukun undang-undang yang berlawanan, dalam mana-mana prosiding terhadap mana-mana orang bagi sesuatu kesalahan di bawah Akta ini, tiada agent provocateur boleh dianggap tidak boleh dipercayai semata-mata kerana dia telah cuba melakukan atau bersubahat, atau telah bersubahat atau terlibat dalam konspirasi jenayah untuk melakukan, kesalahan itu jika tujuan utama percubaan, persubahatan atau penglibatan itu ialah untuk mendapatkan keterangan terhadap orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang atau rukun undang-undang yang berlawanan, sesuatu sabitan bagi apa-apa kesalahan di bawah Akta ini yang berasaskan semata-mata pada keterangan tanpa sokongan mana-mana agent provocateur tidaklah menjadi tidak sah dan tiada sabitan sedemikian boleh diketepikan hanya kerana mahkamah yang membicarakan kes itu telah gagal untuk menyebut dalam alasan penghakimannya keperluan supaya mengingatkan dirinya tentang bahaya membuat sabitan berdasarkan pada keterangan sedemikian. Kebolehterimaan keterangan dokumentar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pegawai penguat kuasa telah memperoleh apa-apa dokumen atau keterangan lain dalam menjalankan kuasanya di bawah Akta ini, dokumen atau salinan dokumen itu atau keterangan lain, mengikut mana-mana yang berkenaan, hendaklah diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini, walau apa pun apa-apa jua yang berlawanan dalam mana-mana undang-undang bertulis. Kebolehterimaan terjemahan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa dokumen yang hendak digunakan dalam mana-mana prosiding terhadap mana-mana orang bagi sesuatu kesalahan di bawah Akta ini dalam suatu bahasa selain bahasa kebangsaan atau bahasa Inggeris, terjemahan dokumen itu ke dalam bahasa kebangsan atau bahasa Inggeris hendaklah diterima sebagai keterangan jika terjemahan itu disertakan dengan perakuan orang yang menterjemahkan dokumen itu yang menyatakan bahawa terjemahan itu ialah terjemahan yang tepat, benar dan betul dan terjemahan itu telah dibuat oleh orang itu atas kehendak mana- mana pegawai penguat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terpakai bagi sesuatu dokumen yang diterjemahkan, tidak kira sama ada dokumen itu telah dibuat di dalam atau di luar Malaysia, atau sama ada terjemahan itu telah dibuat di dalam atau di luar Malaysia, atau sama ada milikan dokumen itu telah diperoleh oleh mana-mana pegawai penguat kuasa di dalam atau di luar Malaysia. Tanggung rugi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan, atau dikekalkan dalam mana-mana mahkamah atau di hadapan mana-mana pihak berkuasa yang lain terhadap —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai penguat kuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana Pegawai Pelindung; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang bertindak menurut undang-undang dalam mematuhi apa-apa arahan atau perintah seseorang pegawai penguat kuasa atau Pegawai Pelindung, bagi atau oleh sebab, atau berkenaan dengan, apa-apa perbuatan yang dilakukan atau pernyataan yang dibuat atau ditinggalkan daripada dilakukan atau dibuat, atau yang berupa sebagai dilakukan atau dibuat atau ditinggalkan daripada dilakukan atau dibuat, menurut atau dalam melaksanakan, atau yang diniatkan menurut atau untuk melaksanakan, Akta ini atau mana-mana perintah bertulis, arahan atau benda lain yang dikeluarkan di bawah Akta ini jika perbuatan atau pernyataan itu dilakukan atau dibuat, atau ditinggalkan daripada dilakukan atau dibuat, dengan suci hati. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan, didenda tidak melebihi satu ratus lima puluh ribu ringgit atau pemenjaraan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa kesalahan terhadap mana-mana peruntukan Akta ini telah dilakukan oleh suatu pertubuhan perbadanan, mana-mana orang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi pertubuhan perbadanan itu, atau yang berupa sebagai bertindak dalam mana-mana kapasiti sedemikian, atau telah dalam apa-apa cara bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu, atau yang membantu dalam pengurusan sedemikian, juga melakukan kesalahan itu melainkan jika dia membuktikan bahawa kesalahan itu telah dilakukan tanpa pengetahuan, persetujuan atau pembiarannya, dan bahawa dia telah menjalankan segala usaha yang wajar dilakukannya untuk mencegah pelakuan kesalahan itu sebagaimana yang dia patut jalankan, dengan mengambil kira jenis fungsinya dalam kapasiti itu dan segala hal keadaan. Kesalahan oleh pekerja atau ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang boleh di bawah Akta ini dikenakan hukuman atau penalti bagi apa-apa perbuatan, peninggalan, keabaian atau keingkaran, orang itu bolehlah dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, keabaian atau keingkaran sedemikian oleh mana-mana pekerja atau ejennya atau ejen pekerja itu, jika perbuatan, peninggalan, keabaian atau keingkaran itu telah dilakukan oleh pekerja orang itu dalam masa penggajiannya, atau oleh ejen itu semasa bertindak bagi pihak orang itu, atau oleh pekerja ejen itu dalam masa penggajian pekerja itu oleh ejen itu, atau selainnya bagi pihak ejen itu. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan yang perlu atau suai manfaat untuk memberikan kuat kuasa penuh, atau bagi menjalankan, peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fungsi atau perkara lain berhubung dengan Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi suatu kesalahan, apa-apa perbuatan atau peninggalan yang bertentangan dengan mana-mana peruntukan mana-mana peraturan- peraturan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi pengenaan penalti bagi kesalahan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan langkah bagi jagaan dan perlindungan orang yang diperdagangkan di tempat perlindungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kuasa dan fungsi Pegawai Pelindung;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia pengurusan, pentadbiran dan kawalan tempat perlindungan, termasuk peruntukan bagi kuasa, kewajipan dan fungsi orang yang bertanggungjawab ke atas tempat perlindungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi apa-apa perkara yang, di bawah Akta ini, adalah dikehendaki atau dibenarkan untuk ditetapkan atau yang perlu atau suai manfaat untuk ditetapkan. Pencegahan anomali"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, apabila pada hematnya perlu atau suai manfaat berbuat sedemikian, sama ada bagi maksud menghapuskan kesulitan atau mencegah anomali yang berbangkit daripada pembuatan Akta ini, melalui perintah yang disiarkan dalam Warta membuat apa-apa ubah suaian kepada mana-mana peruntukan dalam Akta ini sebagaimana yang difikirkannya patut, tetapi Menteri tidak boleh menjalankan kuasa yang diberikan oleh seksyen ini selepas habis tempoh dua tahun dari tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_VI__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, \"ubah suaian\" termasuklah pindaan, tambahan, pemotongan, penggantian, adaptasi, variasi, pengubahan, dan ketidakpakaian mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui pemberitahuan dalam Warta, mengisytiharkan mana-mana rumah, bangunan atau tempat, atau mana-mana bahagian rumah, bangunan atau tempat itu, menjadi tempat perlindungan bagi jagaan dan perlindungan orang yang diperdagangkan dan boleh, dengan cara yang sama, mengisytiharkan bahawa tempat perlindungan itu terhenti menjadi suatu tempat perlindungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, mengarahkan pengasingan kategori berlainan orang yang diperdagangkan, antara lain, mengikut umur dan jantina sama ada di tempat perlindungan yang sama atau di tempat perlindungan yang berlainan. Pelantikan Pegawai Pelindung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "( 1 ) Menteri, selepas berunding dengan Menteri yang dipertanggungkan dengan tanggungjawab bagi pembangunan wanita, keluarga dan masyarakat boleh, melalui pemberitahuan dalam Warta, melantik apa-apa bilangan Pegawai Kebajikan Masyarakat atau mana-mana pegawai awam lain untuk menjalankan kuasa dan melaksanakan kewajipan seorang Pegawai Pelindung di bawah Akta ini tertakluk kepada apa-apa syarat sebagaimana yang dinyatakan dalam pemberitahuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Pelindung hendaklah —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kawalan ke atas dan tanggungjawab bagi jagaan dan perlindungan orang yang diperdagangkan di tempat perlindungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan siasatan dan menyebabkan supaya disediakan laporan mengenai orang yang diperdagangkan sebagaimana yang dikehendaki di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kuasa untuk mengawasi orang yang diperdagangkan apabila diperintahkan oleh Majistret atau diarahkan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai apa-apa kuasa, kewajipan dan fungsi lain sebagaimana yang ditetapkan oleh Menteri. Mengambil orang ke dalam jagaan sementara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa boleh, atas syak yang munasabah bahawa orang yang dijumpai atau diselamatkan ialah orang yang diperdagangkan, mengambil orang itu ke dalam jagaan sementara dan mengemukakan orang itu ke hadapan Majistret dalam masa dua puluh empat jam, tidak termasuk masa yang perlu bagi perjalanan ke Mahkamah Majistret, bagi maksud memperoleh perintah perlindungan interim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret boleh membuat perintah perlindungan interim bagi orang yang ditempatkan di tempat perlindungan selama tempoh empat belas hari bagi maksud menjalankan penyiasatan dan siasatan di bawah seksyen 51."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penguat kuasa hendaklah, apabila memperoleh perintah yang dikeluarkan di bawah subseksyen (2), menyerahkan orang yang diperdagangkan itu kepada Pegawai Pelindung untuk menempatkan orang yang diperdagangkan itu di tempat perlindungan yang dinyatakan dalam perintah. Orang dalam jagaan sementara yang memerlukan pemeriksaan atau rawatan perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai penguat kuasa yang mengambil seseorang ke dalam jagaan sementara di bawah subseksyen 44(1) berpendapat bahawa orang itu memerlukan pemeriksaan atau rawatan perubatan, pegawai penguat kuasa boleh, daripada mengemukakan orang itu ke hadapan Majistret, membawanya kepada pegawai perubatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada masa diambil ke dalam jagaan sementara, orang itu adalah pesakit di dalam hospital, pegawai penguat kuasa boleh meninggalkan orang itu di hospital itu. Pemeriksaan dan rawatan perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai perubatan yang di hadapannya seseorang dibawa di bawah seksyen 45 —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menjalankan atau menyebabkan dijalankan suatu pemeriksaan ke atas orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dalam memeriksa orang itu dan jika dibenarkan oleh pegawai penguat kuasa, menjalankan atau menyebabkan dijalankan apa-apa tatacara dan ujian sebagaimana yang perlu untuk mendiagnosis keadaan orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memberikan atau menyebabkan diberikan apa-apa rawatan sebagaimana yang dirasakannya perlu hasil daripada diagnosis itu. Kebenaran untuk dimasukkan ke hospital"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang yang diambil ke dalam jagaan sementara di bawah subseksyen 44(1) ialah seorang kanak-kanak dan pegawai perubatan yang memeriksa orang itu berpendapat bahawa kemasukannya ke hospital adalah perlu bagi maksud jagaan atau rawatan perubatan, seseorang pegawai penguat kuasa boleh membenarkan orang itu untuk dimasukkan ke hospital. Kawalan ke atas orang yang dimasukkan ke hospital"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang yang diambil ke dalam jagaan sementara di bawah subseksyen 44(1) dimasukkan ke hospital, pegawai penguat kuasa hendaklah mempunyai kawalan ke atas, dan tanggungjawab bagi keselamatan dan perlindungan orang itu. Langkah yang perlu diambil selepas pemeriksaan atau rawatan perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diambil ke dalam jagaan sementara di bawah subseksyen 44(1) dan diperiksa dari segi perubatan di bawah seksyen 46 hendaklah dibawa ke hadapan Majistret dalam masa dua puluh empat jam —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila selesai pemeriksaan atau rawatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu dimasukkan ke hospital, apabila dibenarkan keluar dari hospital."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika adalah tidak mungkin untuk membawa orang itu ke hadapan Majistret dalam masa yang dinyatakan dalam subseksyen ( 1) , orang itu hendaklah ditempatkan di tempat perlindungan sehingga suatu masa orang itu boleh dibawa ke hadapan Majistret. Tiada liabiliti ditanggung kerana memberikan kebenaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang yang diperiksa atau dirawat di bawah Bahagian ini —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai penguat kuasa yang membenarkan pemeriksaan atau rawatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai perubatan yang memeriksa atau merawat orang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua orang yang bertindak dalam membantu pegawai perubatan itu, tidaklah menanggung apa-apa liabiliti di sisi undang-undang hanya oleh sebab seseorang telah diperiksa atau dirawat menurut Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua yang terkandung dalam subseksyen (1) melepaskan seseorang pegawai perubatan daripada liabiliti berkenaan dengan pemeriksaan atau rawatan orang yang diambi! ke dalam jagaan sementara di bawah subseksyen 44(1), yang Iiabilitinya itu dia akan tertakluk sekiranya pemeriksaan atau rawatan itu dijalankan atau diberikan dengan keizinan ibu atau bapa atau penjaga orang itu atau orang yang mempunyai kuasa untuk mengizinkan pemeriksaan atau rawatan itu. Penyiasatan, siasatan dan Perintah Perlindungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perintah perlindungan interim dibuat di bawah subseksyen 44(2), dalam masa empat belas hari dari tarikh perintah itu —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai penguat kuasa hendaklah menyiasat keadaan kes orang itu bagi maksud menentukan sama ada orang itu adalah orang yang diperdagangkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pegawai Pelindung hendaklah menjalankan siasatan terhadap latar belakang orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila selesai sesuatu penyiasatan dan siasatan di bawah subseksyen (1), pegawai penguat kuasa dan Pegawai Pelindung hendaklah menyediakan suatu laporan dan mengemukakan laporan itu bersama-sama dengan orang itu ke hadapan Mahkamah Majistret bagi maksud memuaskan hati Majistret bahawa orang itu adalah orang yang diperdagangkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Majistret, selepas membaca laporan yang dikemukakan di bawah subseksyen (2), berpuas hati bahawa orang yang dibawa ke hadapannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah orang yang diperdagangkan dan memerlukan jagaan dan perlindungan, Majistret boleh membuat suatu Perintah Perlindungan —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang yang diperdagangkan ialah seorang warganegara atau pemastautin tetap Malaysia, memerintahkan orang yang diperdagangkan itu ditempatkan di tempat perlindungan selama tempoh tidak melebihi dua tahun dari tarikh perintah itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang yang diperdagangkan ialah seorang warganegara asing, memerintahkan orang yang diperdagangkan itu ditempatkan di tempat perlindungan selama tempoh tidak melebihi tiga bulan dari tarikh perintah itu, dan selepas itu melepaskannya kepada pegawai imigresen untuk tindakan yang perlu mengikut peruntukan Akta Imigresen 1959/63;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bukan orang yang diperdagangkan, Majistret boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang warganegara atau pemastautin tetap Malaysia, memerintahkan orang itu dilepaskan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang warganegara asing, memerintahkan orang itu dilepaskan kepada pegawai imigresen untuk tindakan yang perlu mengikut peruntukan Akta Imigresen 1959/63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret boleh pada bila-bila masa, atas permohonan pegawai penguat kuasa atau Pegawai Pelindung, mengikut mana- mana yang berkenaan, melanjutkan atau membatalkan Perintah Perlindungan yang dibuat di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (4), jika orang yang diperdagangkan itu ialah seorang warganegara asing, suatu pelanjutan Perintah Perlindungan boleh diberikan hanya bagi maksud menyelesaikan perakaman keterangan di bawah seksyen 52 atau bagi apa-apa keadaan luar biasa sebagaimana yang ditentukan oleh Majistret itu. Perakaman keterangan orang yang diperdagangkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa semasa tempoh Perintah Perlindungan dibuat di bawah subperenggan 51(3)(a)(ii), jika pendakwaan jenayah telah dimulakan terhadap mana-mana orang bagi suatu kesalahan di bawah Akta ini, pegawai penguat kuasa boleh membuat permohonan lisan bagi pengemukaan orang yang diperdagangkan itu ke hadapan Mahkamah Majistret bagi maksud merakamkan keterangan bersumpah orang yang diperdagangkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret boleh, atas permohonan itu, mengeluarkan saman atau perintah yang ditujukan kepada orang yang bertanggungjawab ke atas tempat perlindungan di mana orang yang diperdagangkan itu ditempatkan, menghendakinya untuk mengemukakan orang yang diperdagangkan itu pada masa dan di tempat yang dinyatakan dalara saman atau perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret hendaklah merakamkan keterangan orang yang diperdagangkan itu dan menyelesaikan perakaman itu dalam masa tujuh hari dari tarikh pengemukaan orang yang diperdagangkan itu ke hadapannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Semasa perakaman keterangan orang yang diperdagangkan itu, dia hendaklah diperiksa mengikut peruntukan Akta Keterangan 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret hendaklah menyebabkan keterangan yang diambil dijadlkan dalam bentuk bertulis dan, pada akhir tulisan itu, hendaklah menandatangani keterangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam Akta ini atau mana-mana undang-undang bertulis lain yang berlawanan, keterangan yang dirakam di bawah seksyen ini hendaklah boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini dan berat yang diletakkan pada keterangan itu hendaklah sama sebagaimana seorang saksi yang hadir dan memberi keterangan dalam suatu prosiding. Permohonan oleh ibu atau bapa, penjaga atau saudara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang diperdagangkan yang ditempatkan di tempat perlindungan ialah seorang warganegara atau pemastautin tetap Malaysia, ibu atau bapa, penjaga atau saudara orang itu boleh, pada bila-bila masa, membuat suatu permohonan kepada Mahkamah Majistret untuk meletakkan orang itu ke dalam jagaan ibu atau bapa, penjaga atau saudara orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Ibu atau bapa, penjaga atau saudara orang yang diperdagangkan itu hendaklah menyerahkan satu salinan permohonan itu kepada Pegawai Pelindung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima permohonan di bawah subseksyen (2), Pegawai Pelindung hendaklah menyebabkan suatu laporan disediakan berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang diperdagangkan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "status apa-apa penyiasatan atau pendakwaan bagi apa-apa kesalahan di bawah Akta ini yang berhubung dengan orang yang diperdagangkan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "latar belakang orang yang diperdagangkan itu, ibu atau bapa, penjaga atau saudaranya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain sebagaimana yang Pegawai Pelindung fikirkan berkaitan, untuk membolehkan Majistret menentukan permohonan demi kepentingan terbaik orang yang diperdagangkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret hendaklah, apabila menerima permohonan itu, menetapkan tarikh untuk mendengar permohonan itu dan hendaklah dengan notis bertulis, memaklumkan ibu atau bapa, penjaga atau saudara orang yang diperdagangkan itu, mengikut mana-mana yang berkenaan, Pegawai Pelindung atau orang lain yang Majistret fikirkan patut, dan hendaklah menghendaki supaya orang yang diperdagangkan itu hadir ke hadapannya pada tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas mendengar permohonan dan membaca laporan Pegawai Pelindung, dan jika Majistret berpuas hati bahawa adalah demi kepentingan terbaik orang yang diperdagangkan itu, dia boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "meletakkan orang itu ke dalam jagaan dan perlindungan ibu atau bapa, penjaga atau saudara orang itu dengan syarat-syarat yang dia fikirkan perlu untuk dikenakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki ibu atau bapa, penjaga atau saudara orang itu untuk menandatangani bon; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki orang itu diletakkan di bawah pengawasan seorang Pegawai Pelindung, untuk suatu tempoh yang akan ditetapkan oleh Majistret itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret boleh, pada bila-bila masa, membatalkan perintah yang dibuat di bawah subseksyen (5). Pelepasan orang yang diperdagangkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila sesuatu Perintah Perlindungan dibatalkan atau tamatnya tempoh yang dinyatakan dalam sesuatu Perintah Perlindungan, Pegawai Pelindung hendaklah —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang yang diperdagangkan ialah warganegara atau pemastautin tetap Malaysia, melepaskan orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang yang diperdagangkan ialah warganegara asing, melepaskan orang itu kepada pegawai imigresen untuk tindakan yang perlu mengikut peruntukan Akta Imigresen 1959/63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai imigresen itu hendaklah mengambil segala langkah yang perlu untuk menguruskan penghantaran balik orang itu ke negara asalnya tanpa kelengahan yang tidak perlu, dengan mengambil kira keselamatannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (a), mahkamah boleh, atas suatu permohonan yang dibuat oleh Pegawai Pelindung, dan setelah berpuas hati bahawa orang itu memerlukan jagaan dan perlindungan lanjut, membuat perintah supaya orang yang diperdagangkan itu ditempatkan di tempat perlindungan bagi apa-apa tempoh lanjut sebagaimana yang difikirkan patut oleh Majistret. Orang yang diperdagangkan yang melarikan diri atau dipindahkan dari tempat perlindungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diperdagangkan yang melarikan diri atau yang dipindahkan dari tempat perlindungan tanpa kuasa sah —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh diambil ke dalam jagaan oleh mana-mana pegawai penguat kuasa dan hendaklah dibawa semula ke tempat perlindungan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah ditempatkan untuk suatu tempoh yang sama dengan tempoh semasa dia bebas secara tidak sah dan untuk baki tempoh Perintah Perlindungannya yang belum habis yang asalnya dibuat oleh Majistret. Kesalahan memindahkan atau membantu orang yang diperdagangkan melarikan diri dari tempat perlindungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "memindahkan orang yang diperdagangkan dari tempat perlindungan tanpa kuasa sah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan diketahuinya membantu atau mendorong,. secara langsung atau tidak langsung, orang yang diperdagangkan untuk melarikan diri dari tempat perlindungan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan diketahuinya melindungi atau menyembunyikan orang yang diperdagangkan yang telah melarikan din, atau menghalang orang itu daripada kembali ke ternpat perlindungan, melakukan suatu kesalahan. Kuasa Menteri untuk memindahkan orang yang diperdagangkan dari satu tempat perlindungan ke tempat perlindungan yang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2007/7/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada bila-bila masa, atas sebab yang pada hematnya mencukupi, dengan perintah secara bertulis mengarahkan pemindahan mana-mana orang yang diperdagangkan dari suatu tempat perlindungan ke tempat perlindungan yang lain sebagaimana yang dinyatakan dalam perintah itu."
      }
    }
  ]
}
