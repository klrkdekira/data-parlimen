      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 6 Prime Minister's Department 173,210,000 B. 7 Public Services Department 101,000,000 B. 11 Treasury General Services 15,000,000,000 B. 12 Contribution to Statutory' Funds 300,000,000 B. 20 Ministry of Plantation Industries and 438,000,000 Commodities B. 21 Ministry of Agriculture and Agro-based 2,906.200,000 Industry B. 22 Ministry of Rural and Regional Development B. 23 Ministry of Natural Resources and 151,500,000 Environment B. 25 Ministry of Domestic Trade and Consumer 276,900,000 Affairs B. 28 Ministry of Transport B. 31 Ministry of Tourism 167,000,000 B. 32 Ministry of the Federal Territories B. 42 Ministry of Health 100,000,000 B. 44 Ministry of Unity, Culture, Arts and 23,500,000 Heritage B. 45 Ministry of Youth and Sports B. 46 Ministry of Human Resources 100,000,000 B. 48 Ministry of Women, Family and 45,000,000 Community Development B. 49 Ministry of Higher Education 178,300,000 B. 62 Ministry of Home Affairs 113,918,997 TOTAL 20,153,679,997"
