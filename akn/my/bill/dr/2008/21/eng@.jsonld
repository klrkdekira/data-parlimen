      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "money, donation, gift, loan, fee, reward, valuable security, property or interest in property being property of any description whether movable or immovable, financial benefit, or any other similar advantage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any office, dignity, employment, contract of employment or services, and agreement to give employment or render services in any capacity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any payment, release, discharge or liquidation of any loan, obligation or other liability, whether in whole or in part;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any valuable consideration of any kind, any discount, commission, rebate, bonus, deduction or percentage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any forbearance to demand any money or money’s worth or valuable thing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any other service or favour of any description, including protection from any penalty or disability incurred or apprehended or from any action or proceedings of a disciplinary, civil or criminal nature, whether or not already instituted, and including the exercise or the forbearance from the exercise of any right or any official power or duty; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
      "schema:text": {
        "@language": "en",
        "@value": "any offer, undertaking or promise, whether conditional or unconditional, of any gratification within the meaning of any of the preceding paragraphs (a) to (f); “Commission” means the Malaysian Anti-Corruption Commission; “appointed date” means the date on which this Act comes into operation; “dealing” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8",
      "@type": "akn:list",
      "eli:number": "8",
      "hasPart": [
