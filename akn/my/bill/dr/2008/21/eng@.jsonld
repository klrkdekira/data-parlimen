      "schema:text": {
        "@language": "en",
        "@value": "the trustee of any trust, where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the trust has been created by such person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the total value of the assets contributed by such person to the trust at any time, whether before or after the creation of the trust, amounts, at any time, to not less than twenty per centum of the total value of the assets of the trust; “gratification” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
