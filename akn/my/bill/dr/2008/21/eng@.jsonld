      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "a High Court or a Judge of a High Court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
