      "schema:text": {
        "@language": "en",
        "@value": "a brother or sister of the spouse of the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
