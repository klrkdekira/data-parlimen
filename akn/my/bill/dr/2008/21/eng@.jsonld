      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROVISIONS ON ADVISORY BOARD, SPECIAL COMMITTEE AND COMPLAINTS COMMITTEE Anti-Corruption Advisory Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall be advised by an advisory board to be known as the Anti-Corruption Advisory Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Board shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at least seven members who shall be appointed by the Yang di-Pertuan Agong on the advice of the Prime Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Commissioner as ex-officio member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The members appointed by the Yang di-Pertuan Agong shall be persons of integrity who have rendered distinguished public service or have achieved distinction in the professions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The term of office of members appointed by the Yang di-Pertuan Agong shall be three years and such member shall not hold office for more than two terms either continuously or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Board shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Commission on any aspect of the corruption problem in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Commission on policies and strategies of the Commission in its efforts to eradicate corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to receive, scrutinise and endorse proposals from the Commission towards the efficient and effective running of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to scrutinise and endorse resource needs of the Commission to ensure its effectiveness;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to scrutinise the annual report of the Commission before its submission to the Special Committee on Corruption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "to submit its comments to the Special Committee on Corruption as to the exercise by the Commission of its functions under this Act. Special Committee on Corruption"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a committee to be known as the Special Committee on Corruption which shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Prime Minister on any aspect of the corruption problem in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to examine the annual report of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to examine the comments of the Anti-Corruption Advisory Board as to the exercise by the Commission of its functions under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to seek clarifications and explanations on the annual report of the Commission and the comments of the Anti-Corruption Advisory Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Special Committee shall consist of seven members, to be appointed by the Yang di-Pertuan Agong, who shall be drawn both from the members of the Senate and the House of Representatives, none of whom shall be a member of the administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The members to be appointed under subsection (2) shall be the members of the Senate and the House of Representatives nominated by the Leader of the House of Representatives."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The term of office of members of the Special Committee shall be three years but a member shall not hold office for more than two terms either continuously or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Special Committee shall make an annual report on the discharge of their functions to the Prime Minister who shall lay a copy of that annual report before each House of Parliament. Complaints Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a complaints committee which shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the handling by the Commission of complaints of misconduct which is non-criminal in nature against officers of the Commission; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to identify any weaknesses in the work procedures of the Commission which might lead to complaints and where it considers appropriate to make such recommendations as to the work procedures of the Commission as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint not more than five persons, whom he deems fit and proper, to be members of the Complaints Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "In addition, and without prejudice, to the powers, duties and functions conferred under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of the Commission shall have, for the purposes of this Act, all the powers and immunities of a police officer appointed under the Police Act 1967 [Act 344]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a junior officer of the Commission shall have, for the purposes of this Act, all the powers and immunities of a prison officer of the rank of sergeant and below under the Prison Act 1995 [Act 537] when escorting and guarding persons in custody of the Commission and those of a police officer of the rank of sergeant and below appointed under the Police Act 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of the Commission of the rank of Superintendent and above shall have all the powers of a police officer of the rank of Assistant Superintendent of Police and above; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Chief Senior Assistant Superintendent, a Senior Assistant Superintendent and an Assistant Superintendent of the Commission shall have all the powers of a police officer of the rank of Inspector and above."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where in the course of any investigation or proceedings in court in respect of the commission of an offence under this Act by any person, there is disclosed an offence under any other written law, not being an offence under this Act, regardless whether the offence is committed by the same person or any other person, the officer of the Commission responsible for the investigation or proceedings, as the case may be, shall notify the Public Prosecutor or an officer of the Commission of the rank of Commissioner or above who may issue such directions as he thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "where an order, a certificate or any other act is required to be given, issued or done by an officer in charge of a Police District under any written law, such order, certificate or act may be given, issued or done by a senior officer of the Commission, and for such purpose, the place where the order, certificate or act was given, issued or done shall be deemed to be a Police District under his charge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of the Commission shall have all the powers conferred on an officer in charge of a police station under any written law, and for such purpose the office of such officer shall be deemed to be a police station."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that for the purposes of this Act an officer of the Commission shall have all the powers of a police officer of whatever rank as provided for under the Criminal Procedure Code [Act 593] and the Registration of Criminals and Undesirable Persons Act 1969 [Act 7], and such powers shall be in addition to the powers provided for under this Act and not in derogation thereof, but in the event of any inconsistency or conflict between the provisions of this Act and those of the Criminal Procedure Code, the provisions of this Act shall prevail. Duties of officers of the Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Chief Commissioner and the officers of the Commission to carry out their functions as specified in section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall make an annual report on the activities of the Commission to the Special Committee on Corruption. Standing orders"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner may issue administrative orders to be called “Standing Orders”, not inconsistent with the provisions of this Act, on the general control, training, duties and responsibilities of officers and junior officers of the Commission, and for such other matters as may be necessary or expedient for the good administration of the Commission or for the prevention of the abuse of power or neglect of duty, and generally for ensuring the efficient and effective functioning of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysian Anti-Corruption Commission is established. Chief Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong shall, on the advice of the Prime Minister, appoint a Chief Commissioner of the Malaysian Anti-Corruption Commission for such period and on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Chief Commissioner is appointed from among members of the public services, the period of appointment of the Chief Commissioner shall not extend beyond the date of his compulsory retirement from the public service, but where he so attains the age of compulsory retirement he may be reappointed as Chief Commissioner by the Yang di-Pertuan Agong, on the advice of the Prime Minister, on contract for such period and on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall, during the period of his appointment as set out in the instrument of appointment, hold office at the pleasure of the Yang di-Pertuan Agong, subject to the advice of the Prime Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall, during his term of office as such, be deemed to be a member of the general public service of the Federation for purposes of discipline."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall be responsible for the direction, control and supervision of all matters relating to the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall have all the powers of an officer of the Commission and shall have such powers of a Deputy Public Prosecutor as authorized by the Public Prosecutor for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Commissioner shall, before assuming the duties and responsibilities of his office, make in such manner as he may declare to be most binding on his conscience before the Yang di-Pertuan Agong such declaration as may be prescribed by the Minister by rules made under section 71."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be issued to the Chief Commissioner a certificate of appointment in the form of an authority card as evidence of his appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The person holding office as the Director General of the Anti-Corruption Agency appointed under subsection 3(2) of the Anti-Corruption Act 1997 [Act 575] immediately before the commencement of this Act shall, upon the commencement of this Act, be deemed to have been appointed Chief Commissioner under subsection (1) for the remainder of the period of his appointment under the 1997 Act, and the requirements of subsection (7) shall be deemed to have been satisfied. Appointment of other officers of the Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed such number of Deputy Chief Commissioners, Commissioners, Deputy Commissioners, Chief Senior Assistant Commissioners, Senior Assistant Commissioners , Assistant Commissioners, Senior Superintendents, Superintendents, Chief Senior Assistant Superintendents, Senior Assistant Superintendents and Assistant Superintendents of the Commission as may be necessary for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed such number of junior officers of the Commission as may be necessary to assist the Commission in carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "All officers and junior officers of the Commission shall be members of the general public service of the Federation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer and junior officer of the Commission shall have such powers as may be provided for him under this Act and shall be subject to the direction, control and supervision of the Chief Commissioner or any other officer of the Commission superior to him in rank, and shall exercise his powers, perform his functions, and discharge his duties in compliance with such directions or instructions as may be specified orally or in writing by the Chief Commissioner or any other officer of the Commission superior to him in rank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer of the Commission appointed under subsection (1) shall on first joining the Commission and before assuming the duties and responsibilities of his office make in such manner as he may declare to be most binding on his conscience before an officer of the Commission of the rank of Senior Superintendent or above such declaration as may be prescribed by the Minister by rules made under section 71."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate of appointment in the form of an authority card shall be issued to every officer and junior officer of the Commission, and such card shall be signed by the Chief Commissioner and shall be prima facie evidence of the appointment under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the commencement of this Act, every person holding an appointment under the Anti-Corruption Act 1997 shall be deemed to be an officer of the Commission appointed under this section and the requirements of subsection (5) shall be deemed to have been satisfied, and every such officer shall hold such title of office as may be determined by the Minister by notification in the Gazette. Functions of officers of the Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The officers of the Commission shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to receive and consider any report of the commission of an offence under this Act and investigate such of the reports as the Chief Commissioner or the officers consider practicable;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to detect and investigate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any suspected offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any suspected attempt to commit any offence under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any suspected conspiracy to commit any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to examine the practices, systems and procedures of public bodies in order to facilitate the discovery of offences under this Act and to secure the revision of such practices, systems or procedures as in the opinion of the Chief Commissioner may be conducive to corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to instruct, advise and assist any person, on the latter’s request, on ways in which corruption may be eliminated by such person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to advise heads of public bodies of any changes in practices, systems or procedures compatible with the effective discharge of the duties of the public bodies as the Chief Commissioner thinks necessary to reduce the likelihood of the occurrence of corruption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to educate the public against corruption; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "to enlist and foster public support against corruption. Production of authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer and junior officer of the Commission when acting under this Act shall, on demand, declare his office and produce to the person against whom he is acting or from whom he seeks any information the authority card issued to him under this Act. Officer deemed to be always on duty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer of the Commission shall, for the purposes of this Act, be deemed to be always on duty when required to perform his duties or functions and may perform the duties or functions and exercise the powers conferred on him under this Act or under any other written law at any place within or outside Malaysia. Powers of officers of the Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES AND PENALTIES Offence of accepting gratification"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who by himself, or by or in conjunction with any other person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "corruptly solicits or receives or agrees to receive for himself or for any other person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "corruptly gives, promises or offers to any person whether for the benefit of that person or of another person, any gratification as an inducement to or a reward for, or otherwise on account of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any person doing or forbearing to do anything in respect of any matter or transaction, actual or proposed or likely to take place; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_16__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any officer of a public body doing or forbearing to do anything in respect of any matter or transaction, actual or proposed or likely to take place, in which the public body is concerned, commits an offence. Offence of giving or accepting gratification by agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "A person commits an offence if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "being an agent, he corruptly accepts or obtains, or agrees to accept or attempts to obtain, from any person, for himself or for any other person, any gratification as an inducement or a reward for doing or forbearing to do, or for having done or forborne to do, any act in relation to his principal’s affairs or business, or for showing or forbearing to show favour or disfavour to any person in relation to his principal’s affairs or business; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "he corruptly gives or agrees to give or offers any gratification to any agent as an inducement or a reward for doing or forbearing to do, or for having done or forborne to do any act in relation to his principal’s affairs or business, or for showing or forbearing to show favour or disfavour to any person in relation to his principal’s affairs or business. Offence of intending to deceive principal by agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A person commits an offence if he gives to an agent, or being an agent he uses with intent to deceive his principal, any receipt, account or other document in respect of which the principal is interested, and which he has reason to believe contains any statement which is false or erroneous or defective in any material particular, and is intended to mislead the principal. Acceptor or giver of gratification to be guilty notwithstanding that purpose was not carried out or matter not in relation to principal’s affairs or business"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any agent for any offence under paragraph 17(a) it is proved that he corruptly solicited, accepted, obtained or agreed to accept or attempted to obtain any gratification having reason to believe or suspect that the gratification was solicited or offered as an inducement or a reward for his doing or forbearing to do any act or for showing or forbearing to show any favour or disfavour to any person in relation to his principal’s affairs or business, he commits an offence under that paragraph notwithstanding that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he did not have the power, right or opportunity so to do, show or forbear;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he accepted the gratification without intending so to do, show or forbear;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he did not in fact so do, show or forbear; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the act, favour or disfavour was not in relation to his principal’s affairs or business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any person for any offence under paragraph 17(b) it is proved that he corruptly gave, agreed to give or offered any gratification to any agent as an inducement or a reward for doing or forbearing to do any act or for showing or forbearing to show any favour or disfavour to any person having reason to believe or suspect that the agent had the power, right or opportunity so to do, show or forbear and that the act, favour or disfavour was in relation to his principal’s affairs or business, he commits an offence under that paragraph notwithstanding that the agent had no power, right or opportunity or that the act, favour or disfavour was not in relation to his principal’s affairs or business. Corruptly procuring withdrawal of tender"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "A person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "who, with intent to obtain from any public body a contract for performing any work, providing any service, doing anything, or supplying any article, material or substance, offers any gratification to any person who has made a tender for the contract, as an inducement or a reward for his withdrawing the tender; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "who solicits or accepts any gratification as an inducement or a reward for his withdrawing a tender made by him for such contract, commits an offence. Bribery of officer of public body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who offers to an officer of any public body, or being an officer of any public body solicits or accepts, any gratification as an inducement or a reward for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "the officer voting or abstaining from voting at any meeting of the public body in favour of or against any measure, resolution or question submitted to the public body;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "the officer performing or abstaining from performing or aiding in procuring, expediting, delaying, hindering or preventing the performance of, any official act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "the officer aiding in procuring or preventing the passing of any vote or the granting of any contract or advantage in favour of any person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "the officer showing or forbearing to show any favour or disfavour in his capacity as such officer, commits an offence, notwithstanding that the officer did not have the power, right or opportunity so to do, show or forbear, or accepted the gratification without intending so to do, show or forbear, or did not in fact so do, show or forbear, or that the inducement or reward was not in relation to the affairs of the public body. Bribery of foreign public officials"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who by himself, or by or in conjunction with any other person gives, promises or offers, or agrees to give or offer, to any foreign public official, or being a foreign public official, solicits, accepts or obtains, or agrees to accept or attempts to obtain, whether for the benefit of that foreign public official or of another person, any gratification as an inducement or reward for, or otherwise on account of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign public official using his position to influence any act or decision of the foreign state or public international organization for which the official performs any official duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign public official performing, having done or forbone to do, or abstaining from performing or aiding in procuring, expediting, delaying, hindering or preventing the performance of, any of his official duties; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign public official aiding in procuring or preventing the granting of any contract for the benefit of any person, commits an offence, notwithstanding that the foreign public official did not have the power, right or opportunity so to do, show or forbear, or accepted the gratification without intending so to do, show or forbear, or did not in fact so do, show or forbear, or that the inducement or reward was not in relation to the scope of his official duties. Offence of using office or position for gratification"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of a public body who uses his office or position for any gratification, whether for himself, his relative or associate, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), an officer of a public body shall be presumed, until the contrary is proved, to use his office or position for any gratification, whether for himself, his relative or associate, when he makes any decision, or takes any action, in relation to any matter in which such officer, or any relative or associate of his, has an interest, whether directly or indirectly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that, for the purposes of subsection (1), any member of the administration of a State shall be deemed to use his office or position for gratification when he acts contrary to subsection 2(8) of the Eighth Schedule to the Federal Constitution or the equivalent provision in the Constitution or Laws of the Constitution of that State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to an officer who holds office in a public body as a representative of another public body which has the control or partial control over the first-mentioned public body in respect of any matter or thing done in his capacity as such representative for the interest or advantage of that other public body. Penalty for offences under sections 16, 17, 18, 20, 21, 22 and 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under sections 16, 17, 20, 21, 22 and 23 shall on conviction be liable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "imprisonment for a term not exceeding twenty years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a fine of not less than five times the sum or value of the gratification which is the subject matter of the offence, where such gratification is capable of being valued or is of a pecuniary nature, or ten thousand ringgit, whichever is the higher."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under section 18 shall on conviction be liable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "imprisonment for a term not exceeding twenty years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a fine of not less than five times the sum or value of the false or erroneous or defective material particular, where such false or erroneous or defective material particular is capable of being valued, or of a pecuniary nature, or ten thousand ringgit, whichever is the higher. Duty to report bribery transactions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any person to whom any gratification is given, promised, or offered, in contravention of any provision of this Act shall report such gift, promise or offer together with the name, if known, of the person who gave, promised or offered such gratification to him to the nearest officer of the Commission or police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any person from whom any gratification has been solicited or obtained, or an attempt has been made to obtain such gratification, in contravention of any provision of this Act shall at the earliest opportunity thereafter report such soliciting or obtaining of, or attempt to obtain, the gratification together with the full and true description and if known, the name of the person who solicited, or obtained, or attempted to obtain, the gratification from him to the nearest officer of the Commission or police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails, without reasonable excuse, to comply with subsection (3) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both. Dealing with, using, holding, receiving or concealing gratification or advantage in relation to any offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, whether within or outside Malaysia, whether directly or indirectly, whether on behalf of himself or on behalf of any other person, enters into, or causes to be entered into, any dealing in relation to any property, or otherwise uses or causes to be used, or holds, receives, or conceals any property or any part thereof which was the subject matter of an offence under section 16, 17, 18, 20, 21, 22 or 23 commits an offence and shall on conviction be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding seven years or to both. Making of statement which is false or intended to mislead, etc., to an officer of the Commission or the Public Prosecutor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person makes or causes any other person to make to an officer of the Commission or to the Public Prosecutor, in the course of such officer or Public Prosecutor exercising any power conferred by this Act, any statement which to the knowledge of the person making the statement, or causing the statement to be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is false, or intended to mislead; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is not consistent with any other statement previously made by such person to any other person having authority or power under any law, or otherwise, to receive, or require to be made, such other statement regardless whether or not the person making the statement is under any legal or other obligation to tell the truth, he commits an offence and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person, who has made a statement to an officer of the Commission or to the Public Prosecutor, in the course of such officer or Public Prosecutor exercising any power conferred by this Act, subsequently thereto makes any other statement to any person having authority or power under any law, or otherwise, to receive, or require to be made, such other statement, regardless whether or not the person making the statement is under a legal or other obligation to tell the truth, he commits an offence, if such other statement is inconsistent with any statement previously made to an officer of the Commission or the Public Prosecutor and shall on conviction be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that for the purposes of paragraph (1)(b) and subsection (2), any statement made in the course of any legal proceedings before any court, whether civil or criminal, or any statement made by any person in the course of any disciplinary proceedings, whether such legal proceedings or disciplinary proceedings are against the person making the statement or against any other person, shall be deemed to be a statement made to a person having authority or power under law to receive the statement so made. Attempts, preparations, abetments and criminal conspiracies punishable as offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "attempts to commit any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "does any act preparatory to or in furtherance of the commission of any offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "abets or is engaged in a criminal conspiracy to commit any offence under this Act, commits such offence and shall on conviction be liable to the punishment provided for such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any provision of this Act which contains a reference to an offence under any specific provision of this Act shall be read as including a reference to an offence under subsection (1) in relation to the offence under that specific provision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(a) shall not apply where an attempt to do any act is expressly made an offence under this Act, and paragraph (1)(c) shall not apply to the case of an abetment of an offence as provided for under section 164 of the Penal Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REPEAL AND SAVING Repeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The Anti-Corruption Act 1997 is repealed. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "Any act done or action taken prior to the commencement of this Act by an officer of the Anti-Corruption Agency established under the Anti-Corruption Act 1997 shall be deemed to have been done or taken under this Act and may accordingly be continued by the officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "Any order made under section 60 of the Anti-Corruption Act 1997 and in force immediately before the commencement of this Act shall, upon the commencement of this Act, continue to remain in full force and may be revoked or amended in accordance with this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_IX__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this Act which relate solely to procedure or evidence shall apply to any offence against the law repealed under section 73 and such provisions may be used in the course of any pending investigations and in any court proceedings instituted before or after the commencement of this Act in respect of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysian Anti-Corruption Commission Act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 January 2009. Principal objects of Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "The principal objects of this Act are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "to promote the integrity and accountability of public and private sector administration by constituting an independent and accountable anti-corruption body; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "to educate public authorities, public officials and members of the public about corruption and its detrimental effects on public and private sector administration and on the community. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“member of a State Legislative Assembly” includes an officer of a public body who is a member of a State Executive Council by virtue of his office; “member of the administration” has the meaning assigned to it in Clause (2) of Article 160 of the Federal Constitution; “public body” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_g",
