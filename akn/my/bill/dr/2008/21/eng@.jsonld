      "schema:text": {
        "@language": "en",
        "@value": "[Paragraph 3(a), definition of “prescribed offence”] Offences punishable under sections 161, 162, 163, 164, 165, 213, 214, 215, 384, 385, 386, 387, 388, 389, 403, 404, 405, 406, 407, 408, 409, 417, 418, 419, 420, 465, 466, 467, 468, 469, 471, 472, 473, 474, 475, 476 and 477A of the Penal Code."
      }
    }
  ]
