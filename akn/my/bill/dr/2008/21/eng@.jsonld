      "schema:text": {
        "@language": "en",
        "@value": "any offence under any written law as specified in the Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "an offence punishable under section 137 of the Customs Act 1967 [Act 235];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under Part III of the Election Offences Act 1954 [Act 5];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "an attempt to commit any of the offences referred to in paragraphs (a) to (c); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "an abetment of or a criminal conspiracy to commit (as those terms are defined in the Penal Code) any of the offences referred to in paragraphs (a) to (c), whether or not the offence is committed in consequence thereof; “Chief Commissioner” means the Chief Commissioner of the Malaysian Anti-Corruption Commission appointed under section 5; “court” means—"
      }
    },
    {
