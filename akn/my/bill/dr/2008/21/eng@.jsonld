      "schema:text": {
        "@language": "en",
        "@value": "a lineal ascendant or descendant of a spouse of the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a lineal descendant of a person referred to in paragraph (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_5",
      "schema:text": {
