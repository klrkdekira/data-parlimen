      "schema:text": {
        "@language": "en",
        "@value": "any person who manages the affairs of such person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "any organisation of which such person, or any nominee of his, is a partner, or a person in charge or in control of, or has a controlling interest in, its business or affairs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
