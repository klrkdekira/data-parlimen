      "schema:text": {
        "@language": "en",
        "@value": "any purchase, sale, loan, charge, mortgage, lien, pledge, caveat, transfer, delivery, assignment, subrogation, transmission, gift, donation, trust, settlement, deposit, withdrawal, transfer between accounts, or extension of credit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "any agency or grant of power of attorney; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_8",
      "schema:text": {
        "@language": "en",
        "@value": "any act which results in any right, interest, title or privilege, whether present or future or whether vested or contingent, in the whole of or in part of any property being conferred on any person."
      }
    },
