        "@language": "en",
        "@value": "THE MALAYSIAN ANTI-CORRUPTION COMMISSION Establishment of the Malaysian Anti-Corruption Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
