      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this Act shall, in relation to citizens and permanent residents of Malaysia, have effect outside as well as within Malaysia, and when an offence under this Act is committed in any place outside Malaysia by any citizen or permanent resident, he may be dealt with in respect of such offence as if it was committed at any place within Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings against any person under this section which would be a bar to subsequent proceedings against such person for the same offence if such offence was committed in Malaysia shall be a bar to further proceedings against him under any written law relating to the extradition of persons, in respect of the same offence, outside Malaysia. Application of provisions of this Act to a prescribed offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law to the contrary, the provisions of this Act shall apply to a prescribed offence regardless of whether the prosecution or any other proceedings in respect of such offence are instituted or taken by an officer of the Commission, or a police officer or customs officer, or any other officer having powers to investigate, prosecute or take any proceedings in respect of such offence. General offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with any provision of this Act or any order, direction or notice given by or on behalf of a court, the Public Prosecutor, or an officer of the Commission in the exercise of his functions under this Act, commits an offence. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Every person convicted of an offence under this Act for which no penalty is specifically provided shall be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both. Powers of police officers under this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing contained in this Act shall derogate from the powers of a police officer to investigate into any offence under this Act and to prosecute any person in respect of any such offence, so long as the provisions of this Act are complied with. Minister’s power to make orders, regulations and rules and amend Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, by order published in the Gazette, prescribe any society, union, organization or body to be a public body."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations or rules for the further, better and more convenient carrying out of the provisions of this Act, and without prejudice to the generality of this provision, the Minister may make regulations or rules—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to any board or committee established under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "providing for the form of any notice, order, declaration or other matter under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "providing for the service or delivery of any notice, order, direction, instruction, requirement or other thing lawfully done under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, by order published in the Gazette, amend the Schedule. Immunity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings whatsoever shall lie or be brought, instituted, or maintained in any court or before any other authority against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "the Government of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "any officer or employee of the Government of Malaysia or of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Advisory Board or the Special Committee or any other committee established under or for the purposes of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "any person lawfully acting on behalf of the Government of Malaysia, Commission, officer or employee of the Government of Malaysia or Commission, for or on account of, or in respect of, any act done or statement made or omitted to be done or made, or purporting to be done or made or omitted to be done or made, in pursuance or in execution of, or intended pursuance or execution of this Act, or any order in writing, direction, instruction, notice or other thing whatsoever issued under this Act: Provided that such act or such statement was done or made, or was omitted to be done or made, in good faith."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "A prosecution for an offence under this Act shall not be instituted except by or with the consent of the Public Prosecutor. Jurisdiction of the Sessions Court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of the Subordinate Courts Act 1948 [Act 92], a prosecution for an offence under this Act shall be commenced in the Sessions Court. Trial by High Court on a certificate by the Public Prosecutor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provision of section 417 of the Criminal Procedure Code and subject to subsection (5), the Public Prosecutor may in any particular case triable in the Sessions Court for an offence under this Act, issue a certificate specifying the High Court in which the proceedings are to be instituted or transferred and requiring that the accused person be caused to appear or be produced before such High Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The power of the Public Prosecutor under subsection (1) shall be exercised by him personally."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The certificate of the Public Prosecutor issued under subsection (1) shall be tendered to the Sessions Court whereupon the Sessions Court shall transfer the case to the High Court specified in the certificate and cause the accused person to appear or be brought before such Court as soon as may be practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "When the accused person appears or is brought before the High Court in accordance with subsection (3), the High Court shall fix a date for his trial which shall be held in accordance with the procedure under Chapter XX of the Criminal Procedure Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall apply to all cases before the Sessions Court to try offences under this Act, whether the proceedings are instituted before or after the coming into operation of this Act, provided that the accused person has not pleaded guilty and no evidence in respect of the case against him has begun to be adduced. Joinder of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in section 164 of the Criminal Procedure Code, where a person is accused of more than one offence under this Act he may be charged with and tried at one trial for any number of such offences committed within the space of any length of time. Defence statement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Once delivery of documents by the prosecution pursuant to section 51A of the Criminal Procedure Code has taken place, the accused shall, before commencement of the trial, deliver the following documents to the prosecution:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "a defence statement setting out in general terms the nature of the defence and the matters on which the accused takes issue with the prosecution, with reasons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "a copy of any document which would be tendered as part of the evidence for the defence. Examination of offenders"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever two or more persons are charged with an offence under this Act the court may, on an application in writing by the Public Prosecutor, require one or more of them to give evidence as a witness or witnesses for the prosecution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any person referred to in subsection (1) who refuses to be sworn or to be affirmed to answer any lawful question shall be dealt with in the same manner as witnesses so refusing may by law be dealt with by the court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Every person required to give evidence under subsection (1) who, in the opinion of the court, makes a true and full discovery of all things as to which he is lawfully examined, shall be entitled to receive a certificate of indemnity under the seal of the court stating that he has made a true and full discovery of all things as to which he was examined, and such certificate shall be a bar to all legal proceedings against him in respect of all such things."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "An application by the Public Prosecutor under subsection (1) may be presented to the court by the officer conducting the prosecution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any person for an offence under section 16, 17, 18, 20, 21, 22 or 23 it is proved that any gratification has been received or agreed to be received, accepted or agreed to be accepted, obtained or attempted to be obtained, solicited, given or agreed to be given, promised, or offered, by or to the accused, the gratification shall be presumed to have been corruptly received or agreed to be received, accepted or agreed to be accepted, obtained or attempted to be obtained, solicited, given or agreed to be given, promised, or offered as an inducement or a reward for or on account of the matters set out in the particulars of the offence, unless the contrary is proved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any person for an offence under section 161, 162, 163 or 164 of the Penal Code, it is proved that such person has accepted or agreed to accept, or obtained or attempted to obtain any gratification, such person shall be presumed to have done so as a motive or reward for the matters set out in the particulars of the offence, unless the contrary is proved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any person for an offence under section 165 of the Penal Code it is proved that such person has accepted or attempted to obtain any valuable thing without consideration or for a consideration which such person knows to be inadequate, such person shall be presumed to have done so with such knowledge as to the circumstances as set out in the particulars of the offence, unless the contrary is proved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings against any person for an offence under paragraph 137(1)(b) of the Customs Act 1967, it is proved that any officer of customs or other person duly employed for the prevention of smuggling has accepted, agreed to accept or attempted to obtain any bribe, gratuity, recompense, or reward, such officer or person shall be presumed to have done so for the neglect or non-performance of his duty as set out in the particulars of the offence, unless the contrary is proved. Evidence of corroboration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings against any person for an offence under this Act, it may be proved that at or about the time of the alleged offence, or at any time thereafter, the accused, or any relative or associate of his—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "held any property for which he, or his relative or associate, as the case may be, is unable to give a satisfactory account as to how he came into its ownership, possession, custody or control; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "had entered into any dealing for the acquisition of any property and he is unable to satisfactorily account for the consideration for which it is to be acquired, and the evidence in relation thereto shall be presumed to corroborate any evidence relating to the commission of the offence. Evidence of accomplice and agent provocateur"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law or rule of law to the contrary, in any proceedings against any person for an offence under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no witness shall be regarded as an accomplice by reason only of such witness having—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "accepted, received, obtained, solicited, agreed to accept or receive, or attempted to obtain any gratification from any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "given, promised, offered or agreed to give any gratification; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "been in any manner concerned in the commission of such offence or having knowledge of the commission of the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no agent provocateur, whether he is an officer of the Commission or not, shall be presumed to be unworthy of credit by reason only of his having attempted to commit, or to abet, having abetted or having been engaged in a criminal conspiracy to commit, such offence if the main purpose of such attempt, abetment or engagement was to secure evidence against such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any statement, whether oral or written, made to an agent provocateur by such person shall be admissible as evidence at his trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law or rule of law to the contrary, a conviction for any offence under this Act solely on the uncorroborated evidence of any accomplice or agent provocateur shall not be illegal and no such conviction shall be set aside merely because the court which tried the case has failed to refer in the grounds of its judgment to the need to warn itself against the danger of convicting on such evidence. Admissibility of statements by accused persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "In any trial or inquiry by a court into an offence under this Act, any statement, whether the statement amounts to a confession or not or is oral or in writing, made at any time, whether before or after the person is charged and whether in the course of an investigation or not and whether or not wholly or partly in answer to question, by an accused person to or in the hearing of any officer of the Commission, whether or not interpreted to him by any other officer of the Commission or any other person, whether concerned or not in the arrest of that person, shall, notwithstanding any written law or rule of law to the contrary, be admissible at his trial in evidence and, if that person tenders himself as a witness, any such statement may be used in cross-examination and for the purpose of impeaching his credit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "No statement made under subsection (1) shall be admissible or used as provided for in that subsection if the making of the statement appears to the court to have been caused by any inducement, threat ot promise having reference to the charge against the person, proceeding from a person in authority and sufficient in the opinion of the court to give that person grounds which would appear to him reasonable for supposing that by making it he would gain any advantage or avoid any evil of a temporal nature in reference to the proceedings against him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is arrested or is informed that he may be prosecuted for any offence under this Act, he shall be served with a notice in writing, which shall be explained to him, to the following effect: “You have been arrested/informed that you may be prosecuted for … (the possible offence under this Act). Do you wish to say anything? If there is any fact on which you intend to rely in your defence in court, you are advised to mention it now. If you hold it back till you go to court, your evidence may be less likely to be believed and this may have a bad effect on your case in general. If you wish to mention any fact now, and you would like it written down, this will be done.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), a statement by any person accused of any offence under this Act made before there is time to serve a notice under that subsection shall not be rendered inadmissible in evidence merely by reason of no such notice having been served on him if such notice has been served on him as soon as is reasonably possible thereafter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "No statement made by an accused person in answer to a written notice served on him pursuant to subsection (3) shall be construed as a statement caused by any inducement, threat or promise as is described in subsection (2), if it is otherwise voluntary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any criminal proceedings against a person for an offence under this Act, evidence is given that the accused, on being informed that he might be prosecuted for it, failed to mention any such fact, being a fact which in the circumstances existing at the time he could reasonably have been expected to mention when so informed, the court, in determining whether the prosecution has made out a prima facie case against the accused and in determining whether the accused is guilty of the offence charged, may draw such inferences from the failure as appear proper; and the failure may, on the basis of those inferences, be treated as, or as capable of amounting to, corroboration of any evidence given against the accused in relation to which the failure is material."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (6) shall in any criminal proceedings—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "prejudice the admissibility in evidence of the silence or other reaction of the accused in the face of anything said in his presence relating to the conduct in respect of which he is charged, in so far as evidence thereof would be admissible apart from that subsection; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_53__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "be taken to preclude the drawing of any inference from any such silence or other reaction of the accused which could be drawn apart from that subsection. Admissibility of statements and documents of persons who are dead or cannot be traced, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, in any proceedings against any person for an offence under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "any statement made by any person to an officer of the Commission in the course of an investigation under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "any document, or copy of any document, seized from any person by an officer of the Commission in the exercise of his powers under this Act or by virtue of his powers under this Act or by virtue of this Act, shall be admissible in evidence in any proceedings under this Act before any court, where the person who made the statement or the document or the copy of the document is dead, or cannot be traced or found, or has become incapable of giving evidence, or whose attendance cannot be procured without an amount of delay or expense which appears to the court unreasonable. Certificate of position or office held"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate issued by a principal or an officer on behalf of his principal shall be admissible in evidence in any proceedings against any person for any offence under this Act as prima facie proof that the person named in such certificate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "held the position, office or capacity as specified in such certificate and for such period as so specified; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "received the emoluments as specified in such certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate issued under subsection (1) shall be prima facie proof that it was issued by the person purporting to issue it as principal or on behalf of the principal without proof of the signature of the person who issued such certificate and without proof of the authority of such person to issue it. Admissibility of translation of documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "Where any document which is to be used in any proceedings against any person for an offence under this Act is in a language other than the national language or the English language, a translation of such document into the national language or the English language shall be admissible where the translation is accompanied by a certificate of the person who translated the document setting out that it is a true and faithful translation and the translation had been done by such person at the instance of the Public Prosecutor or an officer of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall apply to a document which is translated, regardless whether the document was made within or outside Malaysia, or whether the translation was done within or outside Malaysia, or whether possession of such document was obtained by the prosecution within or outside Malaysia. Evidence of custom inadmissible"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "In any civil or criminal proceedings under this Act, evidence shall not be admissible to show that any such gratification as is mentioned in this Act is customary in any profession, trade, vocation or calling or on a social occasion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Every report relating to the commission of an offence under this Act may be made orally or in writing to an officer of the Commission, and if made orally it shall be reduced into writing and read over to the person making the report; and every report, whether in writing or reduced into writing, shall be signed by the person making the report."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Every report, whether in writing or reduced into writing, shall be entered in a book kept at the office of the Commission and there shall be appended to such entry the date and hour on which such report was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Where an officer of the Commission has reason to suspect the commission of an offence under this Act following a report made under subsection (1) or information otherwise received by him, he shall cause an investigation to be carried out and for such purpose may exercise all the powers of investigation provided for under this Act and the Criminal Procedure Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A report made under subsection (1) shall be kept secret and shall not be disclosed by any person to any person other than officers of the Commission and the Public Prosecutor until an accused person has been charged in court for an offence under this Act or any other written law in consequence of such report, unless the disclosure is made with the consent of the Public Prosecutor or an officer of the Commission of the rank of Commissioner and above."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A copy, which is certified by an officer of the Commission of the rank of Superintendent and above, of an entry under subsection (2) of a report under subsection (1) shall be admissible as evidence of the content of the original and of the time, place and manner in which the report was recorded. Power to examine persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An officer of the Commission investigating an offence under this Act may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence. Power of search and seizure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order any person to attend before him for the purpose of being examined orally in relation to any matter which may, in his opinion, assist in the investigation into the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order any person, to produce before him, within the time specified by such officer, any book, document, records, accounts or computerized data, or any certified copy thereof, or any other article which may, in his opinion, assist in the investigation into the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by written notice order any person to furnish a statement in writing made on oath or affirmation setting out therein all such information which may be required under the notice, being information which, in such officer’s opinion, would be of assistance in the investigation into the offence, within the time specified by such officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order any person to attend before him for the purpose of having his handwriting or voice sample taken."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(b) shall not apply to banker’s books."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order has been given under paragraph (1)(a) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "attend in accordance with the terms of the order to be examined, and shall continue to attend from day to day where so directed until the examination is completed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "during such examination, disclose all information which is within his knowledge, or which is available to him, in respect of the matter in relation to which he is being examined, and answer any question put to him truthfully and to the best of his knowledge and belief, and shall not refuse to answer any question on the ground that it tends to incriminate him or his spouse."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order has been given under paragraph (1)(b) shall not conceal, destroy, alter, remove from Malaysia, or deal with, expend, or dispose of, any book, document, record, account or computerized data, or article specified in the order, or alter or deface any entry in any such book, document, record, account or computerized data or cause such act to be done, or assist or conspire to do such act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom a written notice has been given under paragraph (1)(c) shall, in his statement, furnish and disclose truthfully all information required under the notice which is within his knowledge, or which is available to him, and shall not refuse to furnish or disclose the information on the ground that it tends to incriminate him or his spouse."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A person to whom an order or a notice is given under subsection (1) shall comply with such order or notice and with subsections (3), (4) and (5), notwithstanding any written law or rule of law to the contrary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person discloses any information or produces any book, document, record, account or computerized data or article pursuant to subsections (1), (3) and (5), neither the first-mentioned person, nor any other person on whose behalf or direction or as whose agent or employee the first-mentioned person may be acting, shall, on account of such disclosure or production, be liable to any prosecution, except a prosecution for an offence under section 27, for any offence under or by virtue of any written law, or to any proceeding or claim by any person under or by virtue of any law or under or by virtue of any contract, agreement or arrangement, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An officer of the Commission examining a person under paragraph (1)(a) shall record in writing any statement made by the person and the statement so recorded shall be read to and signed by the person, and where such person refuses to sign the record, the officer shall endorse thereon under his hand the fact of such refusal and the reasons therefor, if any, stated by the person examined."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The record of an examination under paragraph (1)(a), or a written statement on oath or affirmation made pursuant to paragraph 1(c), or any book, document, record, account or computerized data, or article produced under paragraph (1)(b) or otherwise in the course of an examination under paragraph (1)(a), or under a written statement on oath or affirmation made pursuant to paragraph (1)(c), or record of examination of sample taken under paragraph (1)(d) shall, notwithstanding any written law or rule of law to the contrary, be admissible in evidence in any proceedings in any court—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "for an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_30__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "for the forfeiture of property pursuant to section 40 or 41, regardless whether such proceedings are against the person who was examined, or who produced the book, document, record, account or computerized data, or article, or who made the written statement on oath or affirmation, or against any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to the Public Prosecutor or an officer of the Commission of the rank of Chief Senior Assistant Commissioner or above as authorized by the Public Prosecutor upon information, and after such inquiry as he thinks necessary, that there is reasonable cause to suspect that in any place there is any evidence of the commission of an offence under this Act, he may by written order direct an officer of the Commission to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "enter any premises and there search for, seize and take possession of, any book, document, record, account or data, or other article;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "inspect, make copies of, or take extracts from, any book, document, record, account or data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "search any person who is in or on such premises, and for the purpose of such search detain such person and remove him to such place as may be necessary to facilitate such search, and seize and detain any article found on such person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "break open, examine, and search any article, container or receptacle; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "stop, search, and seize any conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it is necessary so to do, an officer of the Commission exercising any power under subsection (1) may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door or window of any premises and enter thereinto, or otherwise forcibly enter the premises and every part thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to such entry, search, seizure or removal as he is empowered to effect; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "detain any person found in or on any premises, or in any conveyance, searched under subsection (1), until such premises or conveyance has been searched."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to an officer of the Commission that there is reasonable cause to suspect that there is concealed or deposited in any place any evidence of the commission of any offence under this Act and such officer has reasonable grounds for believing that, by reason of delay in obtaining a written order of the Public Prosecutor or an officer of the Commission of the rank of Chief Senior Assistant Commissioner or above under subsection (1), the object of the search is likely to be frustrated, he may exercise in and in respect of such place, all the powers mentioned in subsections (1) and (2) as if he were directed to do so by an order issued under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be searched under this section except by a person who is of the same gender as the person to be searched. Translation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where an officer of the Commission finds, seizes, detains or takes possession of any book, document or record in the exercise of any power under this Act, and such book, document or record or any part thereof is in a language other than the national language or the English language, or in any sign or code, the officer may require the person who had possession, custody or control of such book, document or record to furnish to the officer a translation in the national language of such book, document or record within such period as, in the opinion of the officer, would be reasonable having regard to the length of the book, document or record, or other circumstances relating to it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall knowingly furnish a translation under subsection (1) which is not an accurate, faithful and true translation, or knowingly make a translation under that subsection which is not accurate, faithful and true."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person required to furnish a translation under subsection (1) is not the person who is suspected to have committed the offence under investigation, the Commission may reimburse him for such reasonable expenses as he may have incurred in furnishing the translation. Seizure of movable property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "In the course of an investigation into an offence under this Act any movable property which any officer of the Commission of the rank of Assistant Superintendent or above has reasonable grounds to suspect to be the subject matter of an offence or evidence relating to the offence shall be liable to seizure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A list of all movable property seized pursuant to subsection (1) and of the places in which they are respectively found shall be prepared by the officer of the Commission effecting the seizure and signed by him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the list referred to in subsection (2) shall be served on the owner of such property or on the person from whom the property was seized as soon as possible."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Where any movable property liable to seizure under subsection (2) is in the possession, custody or control of a bank, subsections (1), (2) and (3) shall not apply and the provisions of section 37 shall apply thereto. Further provisions relating to seizure of movable property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where any movable property is seized under this Act, the seizure shall be effected by removing the movable property from the possession, custody or control of the person from whom it is seized and placing it under the custody of such person or authority and at such place as an officer of the Commission of the rank of Assistant Superintendent or above may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where it is not practicable, or it is otherwise not desirable, to effect removal of any property under subsection (1), the officer referred to in that subsection may leave it at the premises in which it is seized under the custody of such person as he may detail for the purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), when any movable property, including any movable property referred to in subsection (6), has been seized under this Act, an officer of the Commission of the rank of Superintendent or above, other than the officer who effected the seizure, may at his discretion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "temporarily return the movable property to the owner thereof, or to the person from whose possession, custody or control it was seized, or to such person as may be entitled thereto, subject to such terms and conditions as may be imposed, and, subject, in any case, to sufficient security being furnished to ensure that the movable property shall be surrendered on the demand being made by the officer who authorized the release and that such terms and conditions, if any, shall be complied with; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "return the movable property to the owner thereof, or to the person from whose possession, custody or control it was seized, or to such person as may be entitled thereto, with liberty for the person to whom the movable property is so returned to dispose of the property, such return being subject to security being furnished in an amount not less than an amount which represents the open market value of such property on the date on which it is so returned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person to whom movable property is temporarily returned under paragraph (3)(a) fails to surrender such property on demand or comply with any term or condition imposed under that paragraph—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the security furnished in respect of such property shall be forfeited; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "that person commits an offence and shall on conviction be liable to a fine of not less than two times the amount of the security furnished by him, and to imprisonment for a term not exceeding two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where an order of forfeiture is made by the court in respect of property returned under paragraph (3)(b), such forfeiture shall be effected by forfeiting the security furnished by the person to whom the property was returned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "When any movable property seized under this Act consists of money, shares, securities, stocks, debentures or any chose-in- action, in the possession or under the custody or control of any person other than the person against whom the prosecution is intended to be taken, the seizure shall be effected by an officer of the Commission of the rank of Assistant Superintendent or above serving an order on such person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "prohibiting him from using, transferring, or dealing with such property; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "requiring him to surrender the property to an officer of the Commission of the rank of Assistant Superintendent or above in the manner and within the time specified in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where any movable property seized is liable to speedy decay or deterioration, or is property which cannot be maintained without difficulty, or which is not practicable to be maintained, and which cannot be dealt with under subsection (3), an officer of the Commission of the rank of Superintendent or above may sell or cause to be sold the property and shall hold the proceeds of the sale, after deducting therefrom the costs and expenses of the maintenance and sale of the property, to abide the result of any proceedings under this Act. Investigation of share, purchase account, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any other written law or any rule of law, the Public Prosecutor or an officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor, if he is satisfied that it is necessary for the purpose of any investigation into an offence under this Act, may authorize in writing an officer of the Commission to exercise in relation to any bank specified in the authorization all the powers of investigation set out in subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "An officer of the Commission authorized under subsection (1) may, in relation to the bank in respect of which he is so authorized—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inspect and take copies of any banker’s book, bank account or any document belonging to or in the possession, custody or control of the bank;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inspect and take copies of any share account, purchase account, expense account or any other account of any person kept in the bank;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inspect the contents of any safe deposit box in the bank; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "request for any other information related to any document, account or article referred to in paragraphs (a), (b) and (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything in subsection (2), an officer of the Commission authorized under subsection (1) may take possession of any book, document, account, title, securities or cash to which he has access under that subsection where in his opinion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the inspection of them, the copying of them, or the taking of extracts from them, cannot reasonably be undertaken without taking possession of them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "they may be interfered with or destroyed unless he takes possession of them; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "they may be needed as evidence in any prosecution for an offence under this Act or any other written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who wilfully fails or refuses to disclose any information or to produce any account, document or article as are referred to in subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person discloses any information or produces any account or document or article to an authorized officer of the Commission, neither the first-mentioned person nor any other person on whose behalf or direction or as whose agent or employee, the first-mentioned person may be acting shall, on account of such disclosure or production, be liable to any prosecution, except a prosecution for an offence under section 27, for any offence under or by virtue of any law, or to any proceeding or claim by any person under or by virtue of any law, or under or by virtue of any contract, agreement or arrangement, or otherwise. Powers to obtain information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law or rule of law to the contrary, an officer of the Commission of the rank of Commissioner and above, if he has reasonable ground to believe, based on the investigation carried out by an officer of the Commission, that any property is held or acquired by any person as a result of or in connection with an offence under this Act, may by written notice—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require that person to furnish a statement in writing on oath or affirmation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "identifying every property, whether movable or immovable, whether within or outside Malaysia, belonging to him or in his possession, or in which he has any interest, whether legal or equitable, and specifying the date on which each of the properties so identified was acquired and the manner in which it was acquired, whether by way of any dealing, bequest, devise, inheritance, or any other manner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "identifying every property sent out of Malaysia by him during such period as may be specified in the notice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "setting out the estimated value and location of each of the properties identified under subparagraphs (i) and (ii), and if any of such properties cannot be located, the reason therefor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "stating in respect of each of the properties identified under subparagraphs (i) and (ii) whether the property is held by him or by any other person on his behalf, whether it has been transferred, sold to, or kept with any person, whether it has been diminished in value since its acquisition by him, and whether it has been commingled with other property which cannot be separated or divided without difficulty;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "setting out all other information relating to his properties, business, travel, or other activities as may be specified in the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "setting out all his sources of income, earnings or assets;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require any relative or associate of the person referred to in paragraph (1)(a), or any other person whom the officer of the Commission of the rank of Commissioner and above has reasonable grounds to believe is able to assist in the investigation, to furnish a statement in writing on oath or affirmation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "identifying every property, whether movable or immovable, whether within or outside Malaysia, belonging to him or in his possession, or in which such person has any interest, whether legal or equitable, and specifying the date on which each of the properties identified was acquired, whether by way of any dealing, bequest, devise, inheritance, or any other manner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "identifying every property sent out of Malaysia by him during such period as may be specified in the notice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "setting out the estimated value and location of each of the properties identified under subparagraphs (i) and (ii), and if any of such properties cannot be located, the reason therefor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "stating in respect of each of the properties identified under subparagraphs (i) and (ii) whether the property is held by him or by any other person on his behalf, whether it has been transferred, sold to, or kept with any person, whether it has been diminished in value since its acquisition by him, and whether it has been commingled with other property which cannot be separated or divided without difficulty;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "setting out all other information relating to each of the properties identified under subparagraphs (i) and (ii), and the business, travel, or other activities of such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "setting out all the sources of income, earnings or assets of such person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require any officer of any bank or financial institution, or any person who is in any manner or to any extent responsible for the management and control of the affairs of any bank or any financial institution, to furnish copies of any or all accounts, documents and records relating to any person to whom a notice may be issued under paragraph (a) or (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Every person to whom a notice is sent by the officer of the Commission of the rank of Commissioner and above under subsection (1) shall, notwithstanding any written law or rule of law to the contrary, comply with the terms of the notice within such time as may be specified therein, and any person who wilfully neglects or fails to comply with the terms of the notice commits an offence and shall on conviction be liable to imprisonment for a term not exceeding five years and to a fine not exceeding one hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where the officer of the Commission of the rank of Commissioner and above has reasonable grounds to believe that any officer of a public body who has been served with the written notice referred to in subsection (1) owns, possesses, controls or holds any interest in any property which is excessive, having regard to his present or past emoluments and all other relevant circumstances, such officer of the Commission may by written direction require him to furnish a statement on oath or affirmation explaining how he was able to own, possess, control or hold such excess and if he fails to explain satisfactorily such excess, he commits an offence and shall on conviction be liable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "imprisonment for a term not exceeding twenty years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a fine which is not less than five times the value of the excess, if the excess is capable of being valued, or ten thousand ringgit, whichever is the higher."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Every person to whom a direction is sent by such officer of the Commission under subsection (3) shall, notwithstanding any written law or rule of law to the contrary, comply with the terms of the direction within such time as may be specified in the direction, and if such person willfully neglects or fails to comply with such direction, he commits an offence and shall on conviction be liable to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "imprisonment for a term not exceeding twenty years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a fine which is not less than five times the value of the excess, if the excess is capable of being valued, or ten thousand ringgit, whichever is the higher."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Every person to whom a notice or direction is sent by an officer of the Commission of the rank of Commissioner and above under this section shall be legally bound to state the truth and shall disclose all information which is within his knowledge, or which is available to him, or which is capable of being obtained by him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person discloses an information or produces any accounts, documents or records, in response to a notice under subsection (1), such person, his agent or employee, or any other person acting on his behalf or under his direction, shall not, by reason only of such disclosure or production, be liable to prosecution for any offence under or by virtue of any law, or to any proceeding or claim by any person under or by virtue of any law or under or by virtue of any contract, agreement or arrangement, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (6) shall not bar, prevent or prohibit the institution of any prosecution for any offence—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "as provided by this section;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "of giving false evidence in relation to any statement on oath or affirmation furnished to an officer of the Commission of the rank of Commissioner and above pursuant to this section; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_36__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "provided for in section 27. Order not to part with, deal in, movable property in bank, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Public Prosecutor is satisfied on information given to him by an officer of the Commission that any movable property, including any monetary instrument or any accretion thereto, which is the subject matter of an offence under this Act or evidence in relation to the commission of such offence, is in the possession, custody or control of a bank, he may, notwithstanding any other written law or rule of law, by order direct the bank not to part with, deal in, or otherwise dispose of such property or any part thereof until the order is revoked or varied."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "A bank or any agent or employee of a bank shall not, on account of such compliance, be liable to any prosecution under or by virtue of any law or to any proceeding or claim by any person under or by virtue of any law or under or by virtue of any contract, agreement, or arrangement, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with an order of the Public Prosecutor under subsection (1) commits an offence and shall on conviction be liable to a fine not exceeding two times the amount which was paid out in contravention of the Public Prosecutor’s order or fifty thousand ringgit, whichever is the higher, and to imprisonment for a term not exceeding two years. Seizure of immovable property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Public Prosecutor is satisfied on information given to him by an officer of the Commission that any immovable property is the subject matter of an offence under this Act or evidence of the commission of such offence, such property shall be liable to seizure and the seizure shall be effected—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by the issue of a Notice of Seizure by the Public Prosecutor setting out therein the particulars of the immovable property which is seized in so far as such particulars are within his knowledge, and prohibiting all dealings in such immovable property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by publishing a copy of such Notice in two newspapers circulating in Malaysia one of which shall be in the national language and the other in the English language; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by serving a copy of such Notice on the Land Administrator or the Registrar of Titles, as the case may be, in Peninsular Malaysia, or on the Registrar of Titles or Collector of Land Revenue, as the case may be, in Sabah, or on the Director of Lands and Surveys or the Registrar responsible for land title, as the case may be, in Sarawak, of the area in which the immovable property is situated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Land Administrator, the Collector of Land Revenue, the Director of Lands and Surveys, the Registrar of Titles or the Registrar responsible for land title, as the case may be, referred to in subsection (1) shall immediately upon being served with a Notice of Seizure under subsection (1) endorse the terms of the Notice of Seizure on the document of title in respect of the immovable property in the Register at his office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where an endorsement of a Notice of Seizure has been made under subsection (2), the Notice shall have the effect of prohibiting all dealings in respect of the immovable property, and after such endorsement has been made no dealing in respect of the immovable property shall be registered, regardless whether it was effected before or after the issue of such Notice or the making of such endorsement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (3) shall not apply to a dealing effected by an officer of a public body in his capacity as such officer, or otherwise by or on behalf of the Government of Malaysia or the Government of a State, or a local authority or other statutory authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) or (3) or does any act which results in, or causes, a contravention of subsection (2) or (3) commits an offence and shall on conviction be liable to a fine not exceeding twice the value of the property in respect of which the Public Prosecutor’s order had been contravened, or fifty thousand ringgit, whichever is the higher, and to imprisonment for a term not exceeding two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where a Notice of Seizure has been issued under subsection (1) it shall be an offence for the registered proprietor of the immovable property which is seized under such Notice, or for any other person having any interest in such immovable property, who has knowledge of such Notice, to knowingly enter into any agreement with any person to sell, transfer, or otherwise dispose of or deal with, the whole or any part of such immovable property. Prohibition of dealing with property outside Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Public Prosecutor is satisfied that any property is the subject matter of an offence under this Act or was used in the commission of the offence, and such property is held or deposited outside Malaysia, he may make an application by way of an affidavit to a Judge of the High Court for an order prohibiting the person by whom the property is held or with whom it is deposited from dealing with the property. Forfeiture of property upon prosecution for an offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "In any prosecution for an offence under this Act, the court shall make an order for the forfeiture of any property which is proved to be the subject matter of the offence or to have been used in the commission of the offence where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the offence is proved against the accused; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the offence is not proved against the accused but the court is satisfied—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the accused is not the true and lawful owner of such property; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that no other person is entitled to the property as a purchaser in good faith for valuable consideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Where the offence is proved against the accused but the property referred to in subsection (1) has been disposed of, or cannot be traced, the court shall order the accused to pay as a penalty a sum which is equivalent to the amount of the gratification or is, in the opinion of the court, the value of the gratification received by the accused, and any such penalty shall be recoverable as a fine. Forfeiture of property where there is no prosecution for an offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where in respect of any property seized under this Act there is no prosecution or conviction for an offence under this Act, the Public Prosecutor may, before the expiration of eighteen months from the date of the seizure, apply to a Sessions Court Judge for an order of forfeiture of that property if he is satisfied that such property had been obtained as a result of or in connection with an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Judge to whom an application is made under subsection (1) shall cause to be published a notice in the Gazette calling upon any person who claims to have an interest in the property to attend before the Court on a date specified in the notice, to show cause as to why the property should not be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Judge to whom an application is made under subsection (1) is satisfied—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the property is the subject matter of or was used in the commission of an offence under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "there is no purchase in good faith for valuable consideration in respect of the property, he shall make an order for the forfeiture of the property."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Property in respect of which no application is made under subsection (1) shall, at the expiration of eighteen months from the date of its seizure, be released to the person from whom it was seized. Dealing with property after seizure to be void"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where any property has been seized under this Act, and so long as such seizure remains in force, any dealing effected by any person or between any persons in respect of such property, except any dealing effected under this Act or by virtue of this Act by an officer of a public body in his capacity as such officer, or otherwise by or on behalf of the Government of Malaysia, or the Government of a State, or a local authority or other statutory authority, shall be void, and shall not be registered or otherwise given effect to by any person or authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall be in addition to and not in derogation of subsections 38(3) and (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "For so long as a seizure of any property under this Act remains in force, no action, suit or other proceeding of a civil nature shall be instituted, or if it is pending immediately before such seizure, be maintained or continued in any court or before any other authority in respect of the property which has been so seized, and no attachment, execution or other similar process shall be commenced, or if any such process is pending immediately before such seizure, be maintained or continued, in respect of such property on account of any claim, judgement or decree, regardless whether such claim was made, or such judgment or decree was given, before or after such seizure was effected, except at the instance of the Government of Malaysia or the Government of a State, or at the instance of a local authority or other statutory authority, or except with the prior consent in writing of the Public Prosecutor. Power to intercept communications"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any other written law, the Public Prosecutor or an officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor, if he considers that it is likely to contain any information which is relevant for the purpose of any investigation into an offence under this Act, may, on the application of an officer of the Commission of the rank of Superintendent or above, authorize any officer of the Commission—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to intercept, detain and open any postal article in the course of transmission by post;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to intercept any message transmitted or received by any telecommunication; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to intercept, listen to and record any conversation by any telecommunication, and listen to the recording of the intercepted conversation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with an offence under this Act, any information obtained by an officer of the Commission in pursuance of subsection (1), whether before or after such person is charged, shall be admissible at his trial in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "An authorization by the Public Prosecutor or an officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor under subsection (1) may be given either orally or in writing; but if an oral authorization is given, the Public Prosecutor or the officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor shall, as soon as practicable, reduce the authorization into writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate by the Public Prosecutor or the officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor stating that the action taken by an officer of the Commission in pursuance of subsection (1) had been authorized by him under that subsection shall be conclusive evidence that it had been so authorized, and such certificate shall be admissible in evidence without proof of signature thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be under any duty, obligation or liability, or be in any manner compelled, to disclose in any proceedings the procedure, method, manner or means, or any matter related thereto, of anything done under paragraph (1)(a), (b) or (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “postal article” has the same meaning as in the Postal Services Act 1991 [Act 465]. Surrender of travel documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, the Public Prosecutor or an officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor may, where he has grounds to believe that any person who is the subject of an investigation in respect of an offence under this Act suspected to have been committed by him is likely to leave Malaysia, by written notice require such person to surrender his certificate of identity, passport or exit permit, or any other travel document in his possession."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A notice under subsection (1) shall be served personally on the person to whom it is addressed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A person on whom a notice under subsection (1) is served shall comply with such notice forthwith, failing which he may be arrested and taken before a Magistrate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is taken before a Magistrate under subsection (3), the Magistrate shall, unless such person complies with the notice under subsection (1) or satisfies the Magistrate that he does not possess a travel document, by warrant commit him to prison—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "until the expiry of the period of fourteen days from the date of his committal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "until he complies with the notice under subsection (1), whichever occurs earlier."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (4), a certificate signed by the Public Prosecutor or the officer of the Commission of the rank of Commissioner or above as authorized by the Public Prosecutor to the effect that the person has complied with the notice under subsection (1) shall be sufficient warrant for the Superintendent of Prison to discharge such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "No legal proceedings shall be instituted or maintained against the Government, an officer of the Commission, a public officer or any other person, in respect of anything lawfully done under this section. Power to amend or revoke any order or notice under this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Prosecutor or an officer of the Commission as authorized by the Public Prosecutor may at any time amend or revoke any order or notice which has been made or given by him in exercise of any power conferred on the Public Prosecutor or the officer under this Act, but any such revocation shall not be a bar to any fresh order being made or notice being given in the exercise of such power or any other powers conferred on the Public Prosecutor or the officer under this Act, at any time thereafter, against any person to whom the earlier order or notice applied or in respect of any matter affected by the earlier order or notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "A revocation or an amendment of an order or notice under subsection (1) may contain provision in respect of any matter which is consequential, ancillary or incidental to such revocation or amendment. Advocates and solicitors may be required to disclose information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law, a Judge of the High court may, on application being made to him in relation to an investigation into any offence under this Act, order an advocate and solicitor to disclose information available to him in respect of any transaction or dealing relating to any property which is liable to seizure under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) shall require an advocate and solicitor to comply with any order under that subsection to the extent that such compliance would disclose any privileged information or communication which came to his knowledge for the purpose of any pending proceedings. Legal obligation to give information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such limitation as is provided under this Act, every person required by an officer of the Commission or a police officer to give any information on any subject which it is such officer’s duty to inquire into under this Act and which is in that person’s power to give, shall be legally bound to give the information. Obstruction of investigation and search"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any officer of the Commission access to any premises, or fails to submit to a search by a person authorized to search him under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders or delays any officer of the Commission in the execution of his duty under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "fails to comply with any lawful demand, notice, order or requirement of an officer of the Commission in the execution of his duty under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "omits, refuses or neglects to give to an officer of the Commission any information which may reasonably be required of him and which he is empowered to give;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "fails to produce to, or conceals or attempts to conceal from, an officer of the Commission any book, document, or article, in relation to which such officer has reasonable grounds for suspecting that an offence under this Act has been or is being committed, or which is liable to seizure under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "rescues or endeavours to rescue or causes to be rescued any thing which has been duly seized;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "destroys any thing to prevent the seizure thereof, or the securing of the thing; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "interferes with, puts fear into, threatens or abducts or attempts to interfere with, put fear into, threaten or abduct any person involved in an investigation under this Act, commits an offence. Offences under Act to be seizable offences and powers of officers of the Commission relating to investigations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Every offence under this Act shall be a seizable offence for the purposes of the Criminal Procedure Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Every person arrested under subsection (1) may be released from custody—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as an officer of the Commission may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "on his executing a bond, with or without sureties, as an officer of the Commission may require; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as an officer of the Commission may require and his executing a bond, with or without sureties, as an officer of the Commission may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has been released from custody under subsection (2) may be arrested without warrant by any officer of the Commission—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if such officer has reasonable grounds for believing that any condition on or subject to which such person was released or otherwise admitted to bail has been or is likely to be broken; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "on being notified in writing by the surety of such person that such person is likely to break any condition on or subject to which such person was released and that surety wishes to be relieved of his obligation as surety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Any person arrested under subsection (3) and is not released shall, without unreasonable delay, and in any case within twenty-four hours (excluding the time of any necessary journey) be produced before a Magistrate’s Court and if it appears to the Court that any condition on or subject to which such person was released or otherwise admitted to bail has been or is likely to be broken, the Court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "remand such person in custody; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "admit such person to bail on the same conditions or on such other conditions as it thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person who is arrested for an offence under this Act is serving a sentence of imprisonment or is under detention under any law relating to preventive detention, or is otherwise in lawful custody, he shall, upon an order in writing by an officer of the Commission of the rank of Superintendent or above, be produced before such officer or before any other officer of the Commission for the purpose of investigation, and for such purpose he may be kept in lawful custody for a period not exceeding fourteen days."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is detained in lawful custody under subsection (5) or otherwise under any other written law may, at any time, be made available to an officer of the Commission for the purpose of investigation, or may be taken to any other place for the purpose of searching the place, or seizing any property, or identifying any person or for any other purpose related to the investigation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The period during which a person is under lawful custody under subsection (6) shall count towards the period of his imprisonment, detention or other custody."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person has been arrested and admitted to bail and the bailor fails to produce him or where the conditions of the bond on which or subject to which a person is released have not been complied with, the Public Prosecutor may apply to a Magistrate’s Court for an order of forfeiture of the sum of money deposited and the Court shall deal with the application in accordance with section 404 of the Criminal Procedure Code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~sched_1",
