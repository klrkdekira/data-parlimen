      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Member of Special Committee not to be member of Advisory Board, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Special Committee on Corruption shall not be appointed a member of the Anti-Corruption Advisory Board or a member of any other committee established for the purposes of this Act, whether established under this Act, any regulations made under this Act or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Advisory Board shall not be appointed a member of the Special Committee on Corruption or a member of any other committee established for the purposes of this Act, whether established under this Act, any regulations made under this Act or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "A member of any committee established for the purposes of this Act, whether established under this Act, any regulations made under this Act or otherwise shall not be appointed a member of the Special Committee on Corruption, a member of the Advisory Board or a member of any other committee established for the purposes of this Act, whether established under this Act, any regulations made under this Act or otherwise. Protection of informers and information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), where any complaint made by an officer of the Commission states that the complaint is made in consequence of information received by the officer making the complaint, the information referred to in the complaint and the identity of the person from whom such information is received shall be secret between the officer who made the complaint and the person who gave the information, and everything contained in such information, identity of the person who gave the information and all other circumstances relating to the information, including the place where it was given, shall not be disclosed or be ordered or required to be disclosed in any civil, criminal or other proceedings in any court, tribunal or other authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "If any book, paper or other document, or any visual or sound recording, or other matter or material which is given in evidence or liable to inspection in any civil, criminal or other proceedings in any court, tribunal or other authority as are referred to in subsection (1) contains any entry or other matter in which any person who gave the information is named or described or shown, or which might lead to his discovery, the court before which the proceedings are held shall cause all such parts thereof or passages therein to be concealed from view or to be obliterated or otherwise removed so far as is necessary to protect such person from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who gives the information referred to in subsection (1) knowing that the information is false commits an offence and shall on conviction be liable to imprisonment for a term not exceeding ten years, and shall also be liable to a fine not exceeding one hundred thousand ringgit; and for the purposes of any investigation into, or prosecution of, any offence under this subsection, subsections (1) and (2) shall not apply. Liability for offences outside Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_VIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
