        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Government of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Government of a State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any local authority and any other statutory authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any department, service or undertaking of the Government of Malaysia, the Government of a State, or a local authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any society registered under subsection 7(1) of the Societies Act 1966 [Act 335];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any branch of a registered society established under section 12 of the Societies Act 1966;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any sports body registered under section 17 of the Sports Development Act 1997 [Act 576];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any co-operative society registered under section 7 of the Co-operative Societies Act 1993 [Act 502];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any trade union registered under section 12 of the Trade Unions Act 1959 [Act 262];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any youth society registered under section 9 of the Youth Societies and Youth Development Act 2007 [Act 668];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any company or subsidiary company over which or in which any public body as is referred to in paragraph (a), (b), (c), (d), (e), (f), (g), (h), (i) or (j) has controlling power or interest; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any society, union, organization or body as the Minister may prescribe from time to time by order published in the Gazette; “bank” means a bank, a finance company, a merchant bank, or a discount house, licensed under the Banking and Financial Institutions Act 1989 [Act 372], or any other financial institution established or licensed under any other written law or any co- operative society registered or deemed to have been registered under the Co-operative Societies Act 1993; “banker’s book” includes ledgers, day books, cash books, account books and all other books and documents used in the ordinary course of business of a bank; “agent” means any person employed by or acting for another, and includes an officer of a public body or an officer serving in or under any public body, a trustee, an administrator or executor of the estate of a deceased person, a subcontractor, and any person employed by or acting for such trustee, administrator or executor, or subcontractor; “property” means real or personal property of every description, including money, whether situated in Malaysia or elsewhere, whether tangible or intangible, and includes an interest in any such real or personal property; “financial institution” means any person, which, in fact, lawfully or unlawfully, carries on any banking business or finance company business as defined in the Banking and Financial Institutions Act 1989; “monetary instrument” means coin or currency of Malaysia or of any other country, travellers’ cheque, personal cheque, bank cheque, money order, investment security or negotiable instrument in bearer form or otherwise in such form that title thereto passes upon delivery or upon delivery and endorsement; “offence under this Act” includes a prescribed offence; “prescribed offence” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/eng@/~part_I__cl_3__list_2",
      "@type": "akn:list",
