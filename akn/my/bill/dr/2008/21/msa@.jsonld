      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu percubaan untuk melakukan mana-mana kesalahan yang disebut dalam perenggan (a) hingga (c); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
