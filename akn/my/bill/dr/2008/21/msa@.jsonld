      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesatuan sekerja yang didaftarkan di bawah seksyen 12 Akta Kesatuan Sekerja 1959 [Akta 262];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pertubuhan belia yang didaftarkan di bawah seksyen 9 Akta Pertubuhan Belia dan Pembangunan Belia 2007 [Akta 668];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_k",
