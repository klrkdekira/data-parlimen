      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan di bawah Bahagian III Akta Kesalahan Pilihan Raya 1954 [Akta 5];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_2__para_d",
