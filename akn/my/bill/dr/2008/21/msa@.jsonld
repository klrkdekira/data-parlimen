      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan sesuatu Negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pihak berkuasa tempatan dan mana-mana pihak berkuasa berkanun yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana jabatan, perkhidmatan atau pengusahaan Kerajaan Malaysia, Kerajaan sesuatu Negeri, atau sesuatu pihak berkuasa tempatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pertubuhan yang didaftarkan di bawah subseksyen 7(1) Akta Pertubuhan 1966 [Akta 335];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana cawangan sesuatu pertubuhan berdaftar yang ditubuhkan di bawah seksyen 12 Akta Pertubuhan 1966;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana badan sukan yang didaftarkan di bawah seksyen 17 Akta Pembangunan Sukan 1997 [Akta 576];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana koperasi yang didaftarkan di bawah seksyen 7 Akta Koperasi 1993 [Akta 502];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1__para_i",
