        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KESALAHAN DAN PENALTI Kesalahan menerima suapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang sendiri atau melalui atau bersama dengan mana-mana orang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "secara rasuah meminta atau menerima atau bersetuju untuk menerima bagi dirinya atau bagi mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "secara rasuah memberikan, menjanjikan atau menawarkan kepada mana-mana orang sama ada bagi faedah orang itu atau bagi faedah orang lain, apa-apa suapan sebagai dorongan untuk atau upah bagi, atau selainnya oleh sebab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang melakukan atau tidak melakukan apa- apa jua berkenaan dengan apa-apa perkara atau transaksi, sama ada yang sebenar atau yang dicadangkan atau yang mungkin berlaku; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai sesuatu badan awam melakukan atau tidak melakukan apa-apa jua berkenaan dengan apa-apa perkara atau transaksi, sama ada yang sebenar atau yang dicadangkan atau yang mungkin berlaku, yang dengannya badan awam itu terlibat, melakukan suatu kesalahan. Kesalahan memberi atau menerima suapan oleh ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang melakukan kesalahan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai seorang ejen, dia secara rasuah menyetuju terima atau memperoleh, atau bersetuju untuk menyetuju terima atau cuba untuk memperoleh, daripada mana-mana orang, untuk dirinya sendiri atau untuk mana-mana orang lain, apa-apa suapan sebagai suatu dorongan atau upah bagi melakukan atau tidak melakukan, atau kerana telah melakukan atau tidak melakukan, apa-apa perbuatan berhubungan dengan hal ehwal atau perniagaan prinsipalnya, atau kerana memberikan atau tidak memberikan sokongan atau tentangan kepada mana-mana orang berhubungan dengan hal ehwal atau perniagaan prinsipalnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memberikan atau bersetuju untuk memberikan atau menawarkan apa-apa suapan kepada mana-mana ejen sebagai dorongan atau upah bagi melakukan atau tidak melakukan, atau kerana telah melakukan atau tidak melakukan apa-apa perbuatan berhubungan dengan hal ehwal atau perniagaan prinsipalnya, atau bagi memberikan atau tidak memberikan sokongan atau tentangan kepada mana-mana orang berhubungan dengan hal ehwal atau perniagaan prinsipalnya. Kesalahan dengan maksud untuk memperdayakan prinsipal oleh ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang melakukan kesalahan jika dia memberi seseorang ejen, atau sebagai seorang ejen dia menggunakan, dengan niat hendak memperdayakan prinsipalnya, apa-apa resit, akaun atau dokumen lain yang berkenaan dengannya prinsipal itu mempunyai kepentingan, dan yang dia mempunyai sebab untuk mempercayai mengandungi apa-apa pernyataan yang palsu atau silap atau tidak lengkap tentang apa-apa butir matan, dan yang dimaksudkan untuk mengelirukan prinsipalnya. Penerima atau pemberi suapan melakukan suatu kesalahan tanpa mengambil kira maksud tidak dilaksanakan atau perkara tidak berkaitan dengan hal ehwal atau perniagaan prinsipal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana prosiding terhadap mana-mana ejen bagi apa-apa kesalahan di bawah perenggan 17(a) adalah dibuktikan bahawa dia telah secara rasuah meminta, menyetuju terima, memperoleh atau bersetuju untuk menyetuju terima atau cuba untuk memperoleh apa-apa suapan sedangkan dia ada sebab untuk mempercayai atau mengesyaki bahawa suapan itu telah diminta atau ditawarkan sebagai suatu dorongan atau upah supaya dia melakukan atau tidak melakukan apa-apa perbuatan atau supaya dia memberikan atau tidak memberikan apa-apa sokongan atau tentangan kepada mana-mana orang berhubungan dengan hal ehwal atau perniagaan prinsipalnya, ejen itu melakukan suatu kesalahan di bawah perenggan itu walaupun—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mempunyai kuasa, hak atau peluang untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah menerima suapan itu tanpa niat untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah tidak sebenarnya berbuat demikian, memberikan yang sedemikian atau tidak memberikan yang sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan, sokongan atau tentangan itu tidak ada hubungan dengan hal ehwal atau perniagaan prinsipalnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana prosiding terhadap mana-mana orang bagi apa-apa kesalahan di bawah perenggan 17(b) adalah dibuktikan bahawa dia telah secara rasuah memberikan, bersetuju untuk memberikan, atau menawarkan apa-apa suapan kepada mana-mana ejen sebagai suatu dorongan atau upah bagi melakukan atau tidak melakukan apa-apa perbuatan atau bagi memberikan atau tidak memberikan apa-apa sokongan atau tentangan kepada mana-mana orang kerana dia ada sebab untuk mempercayai atau mengesyaki bahawa ejen itu mempunyai kuasa, hak atau peluang untuk berbuat demikian atau untuk memberikan yang sedemikian atau tidak memberikan yang sedemikian dan bahawa perbuatan, sokongan atau tentangan itu adalah berhubungan dengan hal ehwal atau perniagaan prinsipalnya, dia melakukan suatu kesalahan di bawah perenggan itu walaupun ejen itu tidak mempunyai kuasa, hak atau peluang atau bahawa perbuatan, sokongan atau tentangan itu tidak ada hubungan dengan hal ehwal atau perniagaan prinsipalnya. Secara rasuah mendapatkan penarikan balik tender"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "yang, dengan niat untuk memperoleh suatu kontrak daripada mana-mana badan awam bagi melaksanakan apa-apa kerja, mengadakan apa-apa perkhidmatan, melakukan apa-apa jua, atau membekalkan apa-apa barang, bahan atau benda, menawarkan apa-apa suapan kepada mana- mana orang yang telah membuat suatu tender untuk mendapatkan kontrak itu, sebagai suatu dorongan atau upah bagi orang itu menarik balik tendernya itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "yang meminta atau menerima apa-apa suapan sebagai suatu dorongan atau upah baginya menarik balik suatu tender yang telah dibuat olehnya untuk mendapatkan kontrak itu, melakukan suatu kesalahan. Penyogokan pegawai badan awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menawarkan kepada seseorang pegawai mana-mana badan awam, atau, sebagai seorang pegawai mana-mana badan awam, meminta atau menerima, apa-apa suapan sebagai suatu dorongan atau upah supaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai itu mengundi atau tidak mengundi dalam mana- mana mesyuarat badan awam itu bagi menyokong atau menentang apa-apa langkah, ketetapan atau soal yang dikemukakan kepada badan awam itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai itu melaksanakan atau tidak melaksanakan atau membantu dalam mendapatkan, mencepatkan, melambatkan, merintangi atau menghalang pelaksanaan, apa-apa perbuatan rasmi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai itu membantu dalam mendapatkan atau menghalang pelulusan apa-apa undi atau pemberian apa-apa kontrak atau faedah untuk mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai itu memberikan atau tidak memberikan apa-apa sokongan atau tentangan atas sifatnya sebagai pegawai sedemikian, melakukan suatu kesalahan, walaupun pegawai itu tidak mempunyai kuasa, hak atau peluang untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian, atau menerima suapan itu tanpa niat untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian, atau telah tidak sebenarnya berbuat demikian, memberikan yang sedemikian atau tidak memberikan yang sedemikian, atau walaupun dorongan atau upah itu tidak ada hubungan dengan hal ehwal badan awam itu. Penyogokan pegawai awam asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang sendiri atau melalui atau bersama dengan mana-mana orang lain memberikan, menjanjikan atau menawarkan, atau bersetuju untuk memberikan atau menawarkan, kepada mana-mana pegawai awam asing, atau sebagai seorang pegawai awam asing, meminta, menyetuju terima atau memperoleh, atau bersetuju untuk menyetuju terima atau cuba untuk memperoleh, sama ada bagi faedah pegawai awam asing itu atau orang lain, apa-apa suapan sebagai suatu dorongan atau upah supaya, atau kerana—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai awam asing itu menggunakan kedudukannya untuk mempengaruhi apa-apa perbuatan atau keputusan negara asing atau organisasi antarabangsa awam yang baginya pegawai itu melaksanakan apa-apa fungsi rasmi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai awam asing itu melaksanakan, telah melakukan atau tidak melakukan, atau menahan diri daripada melaksanakan atau membantu dalam mendapatkan, mencepatkan, melambatkan, merintangi atau menghalang pelaksanaan, apa-apa kewajipan awamnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai awam asing itu membantu untuk mendapatkan atau menghalang pemberian apa-apa kontrak bagi faedah mana-mana orang, melakukan suatu kesalahan, walaupun pegawai awam asing itu tidak mempunyai kuasa, hak atau peluang untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian, atau menerima suapan itu tanpa niat untuk berbuat demikian, untuk memberikan yang sedemikian atau untuk tidak memberikan yang sedemikian, atau telah tidak sebenarnya berbuat demikian, memberikan yang sedemikian atau tidak memberikan yang sedemikian, atau walaupun dorongan atau upah itu tidak ada hubungan dengan skop tugas rasminya. Kesalahan menggunakan jawatan atau kedudukan untuk suapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai badan awam yang menggunakan jawatan atau kedudukannya untuk apa-apa suapan, sama ada bagi dirinya sendiri, saudaranya atau sekutunya, melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), seseorang pegawai badan awam hendaklah dianggap, sehingga akasnya dibuktikan, telah menggunakan jawatan atau kedudukannya untuk apa-apa suapan, sama ada bagi dirinya sendiri, saudaranya atau sekutunya, apabila dia membuat apa-apa keputusan, atau mengambil apa-apa tindakan, berhubungan dengan apa-apa perkara yang mengenainya pegawai itu, atau mana-mana saudara atau sekutunya, mempunyai kepentingan, sama ada secara langsung atau tidak langsung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, adalah diisytiharkan bahawa, bagi maksud subseksyen (1), mana-mana anggota pentadbiran sesuatu Negeri hendaklah disifatkan telah menggunakan jawatan atau kedudukannya untuk suapan jika dia bertindak bertentangan dengan subseksyen 2(8) Jadual Kelapan kepada Perlembagaan Persekutuan atau peruntukan yang bersamaan dalam Perlembagaan atau Undang-Undang Tubuh Negeri itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini tidaklah terpakai bagi seseorang pegawai yang memegang jawatan dalam sesuatu badan awam sebagai wakil suatu badan awam lain yang mempunyai kawalan atau kawalan separa atas badan awam yang mula-mula disebut itu berkenaan dengan apa-apa perkara atau benda yang dilakukan atas sifatnya sebagai wakil sedemikian bagi kepentingan atau faedah badan awam yang satu lagi itu. Penalti bagi kesalahan di bawah seksyen 16, 17, 18, 20, 21, 22 dan 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan kesalahan di bawah seksyen 16, 17, 20, 21, 22 dan 23 apabila disabitkan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dipenjarakan selama tempoh tidak melebihi dua puluh tahun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak kurang daripada lima kali ganda jumlah atau nilai suapan yang menjadi hal perkara kesalahan itu jika suapan itu dapat dinilai atau berbentuk wang, atau sepuluh ribu ringgit, mengikut mana-mana yang lebih tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan kesalahan di bawah seksyen 18 apabila disabitkan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dipenjarakan selama tempoh tidak melebihi dua puluh tahun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak kurang daripada lima kali ganda jumlah atau nilai butir matan yang palsu atau silap itu jika butir matan yang palsu atau silap itu dapat dinilai atau berbentuk wang, atau sepuluh ribu ringgit, mengikut mana-mana yang lebih tinggi. Kewajipan untuk melaporkan transaksi penyogokan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diberi, dijanjikan, atau ditawarkan, apa-apa suapan dengan melanggar mana-mana peruntukan Akta ini hendaklah melaporkan pemberian, janji atau tawaran itu, berserta dengan nama, jika diketahui, orang yang memberikan, menjanjikan atau menawarkan suapan itu kepadanya kepada pegawai Suruhanjaya atau pegawai polis yang paling hampir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang daripadanya suapan telah diminta atau diperoleh, atau suatu percubaan telah dibuat untuk memperoleh suapan itu, dengan melanggar mana-mana peruntukan Akta ini, hendaklah seawal yang mungkin selepas itu melaporkan permintaan atau perolehan, atau percubaan untuk memperoleh, suapan itu berserta dengan perihalan yang lengkap dan benar dan, jika diketahui, nama orang yang meminta, atau memperoleh, atau cuba memperoleh, suapan daripadanya itu kepada pegawai Suruhanjaya atau pegawai polis yang paling hampir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak, tanpa alasan yang munasabah, mematuhi subseksyen (3) melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua- duanya. Berurusan tentang, menggunakan, memegang, menerima atau menyembunyikan suapan atau faedah berhubungan dengan apa-apa kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, sama ada di dalam atau di luar Malaysia, sama ada secara langsung atau tidak langsung, sama ada bagi pihak dirinya sendiri atau bagi pihak mana-mana orang lain, membuat atau menyebabkan dibuat apa-apa urusan berhubungan dengan apa-apa harta, atau selainnya menggunakan atau menyebabkan digunakan, atau memegang, menerima atau menyembunyikan apa-apa harta atau mana-mana bahagiannya yang menjadi hal perkara suatu kesalahan di bawah seksyen 16, 17, 18, 20, 21, 22 atau 23 melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya. Pembuatan pernyataan yang palsu atau dimaksudkan untuk mengelirukan, dsb., kepada pegawai Suruhanjaya atau Pendakwa Raya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang membuat atau menyebabkan mana- mana orang lain membuat kepada seseorang pegawai Suruhanjaya atau Pendakwa Raya, semasa pegawai itu atau Pendakwa Raya menjalankan mana-mana kuasa yang diberikan oleh Akta ini, apa-apa pernyataan yang diketahui oleh orang yang membuat pernyataan itu, atau yang menyebabkan pernyataan itu dibuat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah palsu atau dimaksudkan untuk mengelirukan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak selaras dengan apa-apa pernyataan lain yang dibuat sebelum itu oleh orang itu kepada mana-mana orang yang mempunyai kuasa atau wenang di bawah mana-mana undang-undang, atau selainnya, untuk menerima, atau menghendaki supaya dibuat, pernyataan lain itu tidak kira sama ada atau tidak orang yang membuat pernyataan itu mempunyai apa-apa obligasi di sisi undang-undang atau obligasi lain untuk menyatakan yang benar, dia melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang telah membuat sesuatu pernyataan kepada seorang pegawai Suruhanjaya atau kepada Pendakwa Raya, semasa pegawai itu atau Pendakwa Raya menjalankan mana-mana kuasa yang diberikan oleh Akta ini, kemudiannya membuat apa- apa pernyataan lain kepada mana-mana orang yang mempunyai kuasa atau wenang di bawah mana-mana undang-undang, atau selainnya, untuk menerima, atau menghendaki supaya dibuat, pernyataan lain itu, tidak kira sama ada atau tidak orang yang membuat pernyataan itu mempunyai obligasi di sisi undang- undang atau obligasi lain untuk menyatakan yang benar, dia, jika pernyataan yang lain itu tidak selaras dengan apa-apa pernyataan yang dibuat sebelumnya kepada seseorang pegawai Suruhanjaya atau Pendakwa Raya, melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, adalah diisytiharkan bahawa bagi maksud perenggan (1)(b) dan subseksyen (2), apa-apa pernyataan yang dibuat dalam apa-apa prosiding undang-undang di hadapan mana-mana mahkamah, sama ada sivil atau jenayah, atau apa-apa pernyataan yang dibuat oleh mana-mana orang dalam apa-apa prosiding tatatertib, sama ada prosiding undang-undang atau prosiding tatatertib itu adalah terhadap orang yang membuat pernyataan itu atau terhadap mana-mana orang lain, hendaklah disifatkan sebagai suatu pernyataan yang dibuat kepada seorang yang mempunyai kuasa atau wenang di bawah undang-undang untuk menerima pernyataan yang dibuat sedemikian. Percubaan, persediaan, persubahatan dan komplot jenayah boleh dihukum sebagaimana kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "cuba melakukan apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa perbuatan sebagai persediaan kesalahan atau untuk membantu pelakuan apa-apa kesalahan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bersubahat, atau terlibat dalam komplot jenayah, untuk melakukan apa-apa kesalahan di bawah Akta ini, melakukan kesalahan itu dan apabila disabitkan boleh dikenakan hukuman yang sama sebagaimana yang diperuntukkan bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana peruntukan Akta ini yang mengandungi sebutan mengenai sesuatu kesalahan di bawah mana-mana peruntukan khusus Akta ini hendaklah dibaca sebagai termasuk sebutan mengenai suatu kesalahan di bawah subseksyen (1) berhubungan dengan kesalahan di bawah peruntukan khusus itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan (1)(a) tidaklah terpakai jika suatu percubaan untuk melakukan apa-apa perbuatan dijadikan dengan nyata suatu kesalahan di bawah Akta ini, dan perenggan (1)(c) tidaklah terpakai bagi kes sesuatu persubahatan suatu kesalahan sebagaimana yang diperuntukkan di bawah seksyen 164 Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMANSUHAN DAN KECUALIAN Pemansuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pencegahan Rasuah 1997 dimansuhkan. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbuatan yang dilakukan atau tindakan yang diambil sebelum Akta ini mula berkuat kuasa oleh seseorang pegawai Badan Pencegah Rasuah yang ditubuhkan di bawah Akta Pencegahan Rasuah 1997 hendaklah disifatkan telah dilakukan atau diambil di bawah Akta ini dan oleh itu boleh diteruskan oleh pegawai itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perintah yang dibuat di bawah seksyen 60 Akta Pencegahan Rasuah 1997 dan berkuat kuasa sebaik sebelum Akta ini mula berkuat kuasa hendaklah, apabila Akta ini mula berkuat kuasa, terus berkuat kuasa sepenuhnya dan boleh dibatalkan atau dipinda mengikut Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini yang berhubungan semata-mata dengan tatacara dan keterangan hendaklah terpakai bagi apa-apa kesalahan terhadap undang-undang yang dimansuhkan di bawah seksyen 73 dan peruntukan itu boleh digunakan dalam apa-apa penyiasatan yang belum selesai dan dalam mana-mana prosiding mahkamah yang dimulakan sebelum atau selepas Akta ini mula berkuat kuasa berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Pencegahan Rasuah Malaysia 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2009. Matlamat utama Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Matlamat utama Akta ini adalah untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggalakkan integriti dan kebertanggungjawaban pentadbiran sektor awam dan swasta dengan menubuhkan suatu badan pencegahan rasuah yang bebas dan bertanggungjawab; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mendidik pihak berkuasa awam, pegawai awam dan orang awam tentang rasuah dan kesan buruknya terhadap pentadbiran sektor awam dan swasta dan komuniti. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“ahli sesuatu Dewan Undangan Negeri” termasuklah seseorang pegawai badan awam yang menjadi anggota Majlis Mesyuarat Kerajaan Negeri oleh sebab jawatannya; “anggota pentadbiran” mempunyai erti yang diberikan kepadanya dalam Fasal (2) Perkara 160 Perlembagaan Persekutuan; “badan awam” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
