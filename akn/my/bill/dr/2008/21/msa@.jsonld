    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Tinggi atau Hakim Mahkamah Tinggi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Sesyen atau Mahkamah Majistret atau Hakim Mahkamah Sesyen atau Majistret, mengikut mana-mana yang berkenaan; “Menteri” ertinya Menteri yang bertanggungjawab bagi Suruhanjaya Pencegahan Rasuah Malaysia; “pegawai” atau “pegawai rendah” ertinya mana-mana pegawai atau pegawai rendah yang dilantik di bawah subseksyen 6(1) atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "; “pegawai awam asing” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_I__cl_3__list_4",
