      "schema:text": {
        "@language": "ms",
        "@value": "SURUHANJAYA PENCEGAHAN RASUAH MALAYSIA Penubuhan Suruhanjaya Pencegahan Rasuah Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN TENTANG LEMBAGA PENASIHAT, JAWATANKUASA KHAS DAN JAWATANKUASA ADUAN Lembaga Penasihat Pencegahan Rasuah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah dinasihati oleh suatu lembaga penasihat yang hendaklah dikenali sebagai Lembaga Penasihat Pencegahan Rasuah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga Penasihat hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya tujuh anggota yang hendaklah dilantik oleh Yang di-Pertuan Agong atas nasihat Perdana Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya sebagai anggota ex-officio."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota-anggota yang dilantik oleh Yang di-Pertuan Agong hendaklah orang yang berintegriti yang telah memberikan perkhidmatan awam yang cemerlang atau telah mencapai keunggulan dalam profesion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh jawatan anggota-anggota yang dilantik oleh Yang di-Pertuan Agong ialah tiga tahun dan anggota itu tidak boleh memegang jawatan lebih daripada dua penggal sama ada terus menerus atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga Penasihat hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Suruhanjaya tentang apa-apa aspek masalah rasuah di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Suruhanjaya tentang dasar dan strategi Suruhanjaya dalam usahanya untuk membanteras rasuah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima, meneliti dan mengendorskan cadangan daripada Suruhanjaya ke arah perjalanan cekap dan berkesan Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk meneliti dan mengendorskan keperluan sumber Suruhanjaya untuk memastikan keberkesanannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk meneliti laporan tahunan Suruhanjaya sebelum dikemukakan kepada Jawatankuasa Khas mengenai Rasuah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_13__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengemukakan ulasannya tentang penjalanan oleh Suruhanjaya akan fungsinya di bawah Akta ini kepada Jawatankuasa Khas mengenai Rasuah. Jawatankuasa Khas mengenai Rasuah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada suatu jawatankuasa yang hendaklah dikenali sebagai Jawatankuasa Khas mengenai Rasuah yang hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Perdana Menteri mengenai apa-apa aspek masalah rasuah di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memeriksa laporan tahunan Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memeriksa ulasan Lembaga Penasihat Pencegahan Rasuah tentang penjalanan oleh Suruhanjaya akan fungsinya di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan penjelasan dan penerangan mengenai laporan tahunan Suruhanjaya dan ulasan Lembaga Penasihat Pencegahan Rasuah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Khas hendaklah terdiri daripada tujuh anggota, yang hendaklah dilantik oleh Yang di-Pertuan Agong, dan mereka hendaklah dipilih daripada kalangan ahli Dewan Negara dan Dewan Rakyat kedua-duanya, dan tiada seorang daripada mereka merupakan anggota pentadbiran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota-anggota yang hendak dilantik di bawah subseksyen (2) hendaklah ahli-ahli Dewan Negara dan Dewan Rakyat yang dinamakan oleh Ketua Majlis Mesyuarat Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh jawatan anggota Jawatankuasa Khas ialah tiga tahun tetapi seseorang anggota tidak boleh memegang jawatan lebih daripada dua penggal sama ada terus-menerus atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Khas hendaklah membuat laporan tahunan mengenai penunaian fungsinya kepada Perdana Menteri yang hendaklah membentangkan suatu salinan laporan tahunan itu di hadapan setiap Majlis Parlimen. Jawatankuasa Aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ada suatu jawatankuasa aduan yang hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memantau pengendalian oleh Suruhanjaya akan aduan mengenai salah laku yang tidak bersifat jenayah terhadap pegawai-pegawai Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenal pasti apa-apa kelemahan dalam tatacara kerja Suruhanjaya yang mungkin menimbulkan aduan dan jika difikirkannya sesuai untuk membuat apa-apa syor tentang tatacara kerja Suruhanjaya sebagaimana yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik tidak lebih daripada lima orang, yang difikirkannya patut dan sesuai, untuk menjadi anggota Jawatankuasa Aduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada, dan tanpa menjejaskan, kuasa- kuasa, kewajipan-kewajipan dan fungsi-fungsi yang diberikan di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai Suruhanjaya hendaklah mempunyai, bagi maksud Akta ini, segala kuasa dan kekebalan seorang pegawai polis yang dilantik di bawah Akta Polis 1967 [Akta 344]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai rendah Suruhanjaya hendaklah mempunyai, bagi maksud Akta ini, segala kuasa dan kekebalan seorang pegawai penjara yang berpangkat sarjan dan lebih rendah di bawah Akta Penjara 1995 [Akta 537] apabila membawa dan menjaga orang dalam tahanan Suruhanjaya dan kuasa dan kekebalan seorang pegawai polis yang berpangkat sarjan atau lebih rendah yang dilantik di bawah Akta Polis 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai Suruhanjaya yang berpangkat Penguasa dan yang lebih tinggi hendaklah mempunyai segala kuasa seorang pegawai polis yang berpangkat Penolong Penguasa Polis dan yang lebih tinggi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang Ketua Penolong Kanan Penguasa, Penolong Kanan Penguasa dan Penolong Penguasa Suruhanjaya hendaklah mempunyai segala kuasa seorang pegawai polis yang berpangkat Inspektor dan yang lebih tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam masa apa-apa penyiasatan atau prosiding di mahkamah berkenaan dengan pelakuan sesuatu kesalahan di bawah Akta ini oleh mana-mana orang, terzahir suatu kesalahan di bawah mana-mana undang-undang bertulis lain, yang tidak menjadi kesalahan di bawah Akta ini, tidak kira sama ada kesalahan itu dilakukan oleh orang yang sama atau mana-mana orang lain, pegawai Suruhanjaya yang bertanggungjawab bagi penyiasatan atau prosiding itu, mengikut mana-mana yang berkenaan, hendaklah memaklumkan Pendakwa Raya atau pegawai Suruhanjaya yang berpangkat Pesuruhjaya atau yang lebih tinggi yang boleh mengeluarkan apa-apa arahan yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "jika sesuatu perintah, perakuan atau apa-apa perbuatan lain dikehendaki supaya diberikan, dikeluarkan atau dilakukan oleh seseorang pegawai penjaga Daerah Polis di bawah mana-mana undang-undang bertulis, perintah, perakuan atau perbuatan itu boleh diberikan, dikeluarkan atau dilakukan oleh seorang pegawai kanan Suruhanjaya, dan bagi maksud itu, tempat perintah, perakuan atau perbuatan itu diberikan, dikeluarkan atau dilakukan hendaklah disifatkan sebagai Daerah Polis di bawah jagaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai Suruhanjaya hendaklah mempunyai segala kuasa yang diberikan kepada seseorang pegawai penjaga balai polis di bawah mana-mana undang-undang bertulis, dan bagi maksud itu pejabat pegawai itu hendaklah disifatkan sebagai balai polis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, adalah diisytiharkan bahawa bagi maksud Akta ini, seseorang pegawai Suruhanjaya hendaklah mempunyai segala kuasa seorang pegawai polis tidak kira apa jua pangkatnya sebagaimana yang diperuntukkan di bawah Kanun Tatacara Jenayah [Akta 593] dan Akta Pendaftaran Penjenayah dan Orang-Orang Yang Tidak Diingini 1969 [Akta 7] dan kuasa itu adalah tambahan kepada kuasa yang diperuntukkan di bawah Akta ini dan bukan pengurangannya, tetapi sekiranya terdapat apa-apa ketidakselarasan atau percanggahan antara peruntukan Akta ini dengan peruntukan Kanun Tatacara Jenayah, peruntukan Akta ini hendaklah mengatasi peruntukan Kanun itu. Kewajipan pegawai Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan Ketua Pesuruhjaya dan pegawai-pegawai Suruhanjaya untuk menjalankan fungsi mereka sebagaimana yang dinyatakan dalam seksyen 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah membuat laporan tahunan tentang kegiatan Suruhanjaya kepada Jawatankuasa Khas mengenai Rasuah. Perintah tetap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya boleh mengeluarkan perintah-perintah pentadbiran yang disebut “Perintah-Perintah Tetap”, yang selaras dengan peruntukan Akta ini tentang kawalan am, latihan, tugas dan tanggungjawab pegawai-pegawai dan pegawai-pegawai rendah Suruhanjaya, dan bagi apa-apa perkara lain yang perlu atau suai manfaat untuk pentadbiran baik Suruhanjaya atau bagi mencegah penyalahgunaan kuasa atau pengabaian tugas, dan pada amnya untuk memastikan Suruhanjaya berfungsi dengan cekap dan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya Pencegahan Rasuah Malaysia ditubuhkan. Ketua Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong hendaklah, atas nasihat Perdana Menteri, melantik seorang Ketua Pesuruhjaya bagi Suruhanjaya Pencegahan Rasuah Malaysia, untuk selama apa-apa tempoh dan atas apa-apa terma dan syarat sebagaimana yang dinyatakan dalam surat cara pelantikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pesuruhjaya dilantik daripada kalangan anggota perkhidmatan awam, tempoh pelantikan Ketua Pesuruhjaya tidak boleh melewati tarikh persaraan wajibnya daripada perkhidmatan awam, tetapi jika dia mencapai umur persaraan wajib itu dia boleh dilantik semula sebagai Ketua Pesuruhjaya oleh Yang di-Pertuan Agong, atas nasihat Perdana Menteri, secara kontrak selama apa-apa tempoh dan atas apa-apa terma dan syarat sebagaimana yang dinyatakan dalam surat cara pelantikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah, dalam tempoh pelantikannya sebagaimana yang dinyatakan dalam suratcara pelantikannya, memegang jawatan selama diperkenankan oleh Yang di-Pertuan Agong, tertakluk kepada nasihat Perdana Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah, selama tempoh jawatannya sebagai Ketua Pesuruhjaya, disifatkan sebagai anggota perkhidmatan awam am Persekutuan bagi maksud-maksud tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah bertanggungjawab bagi arahan, kawalan dan pengawasan segala perkara yang berhubungan dengan Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah mempunyai segala kuasa pegawai Suruhanjaya dan hendaklah mempunyai apa-apa kuasa Timbalan Pendakwa Raya sebagaimana yang diberi kuasa oleh Pendakwa Raya bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya hendaklah, sebelum mula menjalankan tugas dan tanggungjawab jawatannya, membuat di hadapan Yang di-Pertuan Agong, dengan cara yang diakuinya sebagai yang paling mengikat perasaan hati nuraninya, suatu akuan sebagaimana yang ditetapkan oleh Menteri melalui kaedah-kaedah yang dibuat di bawah seksyen 71."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dikeluarkan kepada Ketua Pesuruhjaya suatu perakuan pelantikan dalam bentuk kad kuasa sebagai keterangan tentang pelantikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang sebaik sebelum permulaan kuat kuasa Akta ini memegang jawatan sebagai Ketua Pengarah Badan Pencegah Rasuah yang dilantik di bawah subseksyen 3(2) Akta Pencegahan Rasuah 1997 [Akta 575] hendaklah, apabila Akta ini mula berkuat kuasa, disifatkan telah dilantik sebagai Ketua Pesuruhjaya di bawah subseksyen (1) untuk selama baki tempoh pelantikannya di bawah Akta 1997 itu, dan kehendak subseksyen (7) hendaklah disifatkan telah dipenuhi. Pelantikan pegawai lain Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dilantik apa-apa bilangan Timbalan Ketua Pesuruhjaya, Pesuruhjaya, Timbalan Pesuruhjaya, Ketua Penolong Kanan Pesuruhjaya, Penolong Kanan Pesuruhjaya, Penolong Pesuruhjaya, Penguasa Kanan, Penguasa, Ketua Penolong Kanan Penguasa, Penolong Kanan Penguasa dan Penolong Penguasa bagi Suruhanjaya sebagaimana yang perlu bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dilantik apa-apa bilangan pegawai rendah bagi Suruhanjaya sebagaimana yang perlu untuk membantu Suruhanjaya melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua pegawai dan pegawai rendah Suruhanjaya ialah anggota perkhidmatan awam am Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai dan pegawai rendah Suruhanjaya hendaklah mempunyai apa-apa kuasa yang diperuntukkan baginya di bawah Akta ini dan hendaklah tertakluk kepada arahan, kawalan dan pengawasan Ketua Pesuruhjaya atau mana-mana pegawai lain Suruhanjaya yang lebih tinggi pangkatnya daripadanya, dan hendaklah menjalankan kuasa-kuasanya, melaksanakan fungsi-fungsinya dan menunaikan kewajipan-kewajipannya dengan mematuhi apa-apa arahan atau petunjuk yang dinyatakan secara lisan atau bertulis oleh Ketua Pesuruhjaya atau mana-mana pegawai lain Suruhanjaya yang lebih tinggi pangkatnya daripadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai Suruhanjaya yang dilantik di bawah subseksyen (1) hendaklah apabila mula-mula menyertai Suruhanjaya dan sebelum mula menjalankan tugas dan tanggungjawab jawatannya membuat, di hadapan seorang pegawai Suruhanjaya yang berpangkat Penguasa Kanan atau yang lebih tinggi mengikut cara yang diakuinya sebagai yang paling mengikat perasaan hati nuraninya, suatu akuan sebagaimana yang ditetapkan oleh Menteri melalui kaedah-kaedah yang dibuat di bawah seksyen 71."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pelantikan dalam bentuk kad kuasa hendaklah dikeluarkan kepada tiap-tiap pegawai dan pegawai rendah Suruhanjaya, dan kad itu hendaklah ditandatangani oleh Ketua Pesuruhjaya dan hendaklah menjadi keterangan prima facie tentang pelantikannya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, tiap-tiap orang yang memegang jawatan di bawah Akta Pencegahan Rasuah 1997 hendaklah disifatkan sebagai pegawai Suruhanjaya yang dilantik di bawah seksyen ini dan kehendak subseksyen (5) hendaklah disifatkan telah dipenuhi, dan tiap-tiap pegawai itu hendaklah memegang apa-apa gelaran jawatan sebagaimana yang ditentukan oleh Menteri melalui pemberitahuan dalam Warta. Fungsi pegawai Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai-pegawai Suruhanjaya hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima dan menimbangkan apa-apa aduan tentang pelakuan kesalahan di bawah Akta ini dan menyiasat mana-mana aduan itu sebagaimana yang difikirkan praktik oleh Ketua Pesuruhjaya atau pegawai-pegawai itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mengesan dan menyiasat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan yang disyaki di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa percubaan yang disyaki untuk melakukan apa-apa kesalahan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa komplot yang disyaki untuk melakukan apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "meneliti amalan, sistem dan tatacara badan-badan awam untuk memudahkan penemuan kesalahan di bawah Akta ini dan untuk menghasilkan kajian semula amalan, sistem atau tatacara itu yang pada pendapat Ketua Pesuruhjaya mungkin membawa kepada rasuah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan, menasihati dan membantu mana-mana orang, atas permintaan orang itu, tentang cara-cara bagaimana rasuah dapat dihapuskan oleh orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "menasihati ketua badan-badan awam tentang apa-apa perubahan dalam amalan, sistem atau tatacara yang sesuai dengan penunaian berkesan kewajipan-kewajipan badan- badan awam itu sebagaimana yang difikirkan perlu oleh Ketua Pesuruhjaya untuk mengurangkan kemungkinan berlakunya rasuah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mendidik orang ramai untuk menentang rasuah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mendapatkan dan memelihara sokongan orang ramai dalam memerangi rasuah. Pengemukaan kad kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai dan pegawai rendah Suruhanjaya apabila bertindak di bawah Akta ini, hendaklah, apabila diminta, mengisytiharkan jawatannya dan mengemukakan kepada orang yang terhadapnya dia bertindak atau yang daripadanya dia meminta apa-apa maklumat kad kuasa yang dikeluarkan kepadanya di bawah Akta ini. Pegawai disifatkan sentiasa bertugas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai Suruhanjaya hendaklah, bagi maksud Akta ini, disifatkan sentiasa bertugas apabila dikehendaki melaksanakan kewajipan atau fungsinya dan boleh melaksanakan kewajipan atau fungsi itu dan menjalankan kuasa yang diberikan kepadanya di bawah Akta ini atau di bawah mana-mana undang-undang bertulis lain di mana-mana tempat di dalam atau di luar Malaysia. Kuasa pegawai Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/21/msa@/~part_IV__cl_22",
