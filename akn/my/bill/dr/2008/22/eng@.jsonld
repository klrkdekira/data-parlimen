      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “Where an officer” the words “Subject to section 16, where an officer”; and"
      }
    },
