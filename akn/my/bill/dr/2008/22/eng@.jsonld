      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (c). Deletion of section 25a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_9",
