    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "An officer who has opted for the Employees Provident Fund Scheme before 1 January 2009 but the confirmation of his appointment has been backdated to before 1 January 2009 shall be given an option to opt for pension, gratuity or other benefit as specified in subsection 6a(6a) of the principal Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the option of the officer shall be deemed irrevocable one month from the date he exercises the option and the provisions of the principal Act shall apply to the officer from that date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The grant of pension, derivative pension, retiring allowance or derivative retiring allowance in respect of an officer who retires before 1 January 2009 or dies before 31 December 2008 shall be based on the principal Act as if it has not been amended by this Act, and such grant of pension, derivative pension, retiring allowance or derivative retiring allowance shall be based on the amendments made to the principal Act by this Act only from 1 January 2009 and shall be payable from that date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of the abolishment of the requirement of residency in Malaysia, the grant of derivative pension or derivative retiring allowance before 1 January 2008 shall be based on the principal Act as if it has not been amended by this Act and such grant of derivative pension or derivative retiring allowance shall be based on the amendments made to the principal Act by this Act only from 1 January 2008 and shall be payable from that date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Pensions (Amendment) (No. 2) Act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 2(a), section 3, paragraphs 4(a) and 5(a), section 7 and subsections 10(1), (2) and (3) come into operation on 1 January 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 2(b), section 9 and subsection 10(4) are deemed to have come into operation on 1 January 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "The amendments in paragraphs 4(b) and 5(b), sections 6 and 8, in so far as they relate to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the reduction of the amount of the derivative pension or derivative retiring allowance to seventy per cent after the period of twelve and a half years, come into operation on 1 January 2009; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the requirement of residency in Malaysia, are deemed to have come into operation on 1 January 2008. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Pensions Act 1980 [Act 227], which is referred to as “the principal Act” in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “pensionable officer”, by inserting before the words “section 8” the words “subsection 6a(6c) or”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of “resident in Malaysia”. Amendment of section 6a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 6a of the principal Act is amended by inserting after subsection (6) the following subsections: “(6a) Notwithstanding subsection (3), an officer who had opted for the Employees Provident Fund Scheme before 1 January 2009 and has been confirmed in his appointment before such date shall be given an option to opt for pension, gratuity or other benefit granted under this Act. (6b) The option made under subsection (6a) shall be irrevocable on 1 February 2009 and the provisions of this Act shall apply to the officer from that date. (6c) Where an officer has opted for pension, gratuity or other benefit pursuant to subsection (6a) and dies before the option becomes irrevocable pursuant to subsection (6b), the officer is deemed to be a pensionable officer and the provisions of this Act shall apply to him from the date of his death.”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
