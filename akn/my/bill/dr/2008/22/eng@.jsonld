        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
