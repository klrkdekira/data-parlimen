      "schema:name": {
        "@language": "en",
        "@value": "Statutory and Local Authorities Pensions (Amendment)(No. 2) Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
