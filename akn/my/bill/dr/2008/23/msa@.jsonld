      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan adalah bermastautin di Malaysia.”. Pemotongan seksyen 16a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
