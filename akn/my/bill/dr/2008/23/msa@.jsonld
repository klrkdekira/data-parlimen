      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “tujuh puluh peratus dari pencen pekerja itu” dengan perkataan “amaun pencen yang dibayar kepadanya”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
