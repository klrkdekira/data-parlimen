      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pekerja berpencen mati” perkataan “dalam atau”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
