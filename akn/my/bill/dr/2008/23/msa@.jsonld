      "schema:text": {
        "@language": "ms",
        "@value": "dalam proviso—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_c__subpara_i",
