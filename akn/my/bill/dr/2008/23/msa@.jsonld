      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “Jika seseorang pekerja berpencen” dengan perkataan “Tertakluk kepada seksyen 17, jika seseorang pekerja berpencen”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_5",
      "schema:text": {
