      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (iv), dengan menggantikan koma di hujung perenggan itu dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_6__para_c__subpara_ii",
      "@type": "akn:subparagraph",
