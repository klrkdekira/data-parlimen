      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 16a. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/23/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
