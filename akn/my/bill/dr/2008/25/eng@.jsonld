      ],
      "schema:name": {
        "@language": "en",
        "@value": "Judges Remuneration (Amendment)(No. 2) Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Judges’ Remuneration (Amendment) (No. 2) Act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Section 7 and subsections 8(1), (2) and (3) come into operation on 1 January 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 2 and 6 and subsection 8(4) are deemed to have come into operation on 1 January 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "The amendments in sections 3, 4 and 5, in so far as they relate to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the reduction of the amount of the derivative pension to seventy per cent after the period of twelve and a half years, come into operation on 1 January 2009; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the requirement of residency in Malaysia, are deemed to have come into operation on 1 January 2008. Amendment of section 1a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Judges’ Remuneration Act 1971 [Act 45], which is referred to as “the principal Act” in this Act, is amended in section 1a by deleting the definition of “resident in Malaysia”. Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 10 of the principal Act is amended by deleting subsection (2). Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended by substituting for subsection (1) the following subsection: “(1) Where a Judge dies within or after the period of twelve and a half years from the date of his retirement, the Yang di-Pertuan Agong may grant to his spouse or child, or both spouse and child, as the case may be, a derivative pension according to the entitlement of the Judge.”. Amendment of section 11a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11a of the principal Act is amended by deleting subsections (2) and (3). Amendment of section 15a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 15a of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)−"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the comma at the end of the paragraph a full stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “and who are resident in Malaysia.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (2) and (3). Substitution of Fourth Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for the Fourth Schedule the following schedule: “Fourth Schedule [Subsection 15b(3)] ADJUSTMENT FORMULA FOR DERIVATIVE PENSION OF DEPENDANT Type of Benefit Derivative pension shall be paid or be payable for life— (a) from the date immediately 1/360 x number of months of service following the date of death in (subject to not more than 180 months) service of the Judge on or after x corresponding last drawn salary; but 1 July 1980; or the amount of derivative pension, as adjusted, which is paid or payable on (b) from the date immediately the death of the Judge in service or following the date of death of in retirement under paragraph 8(d) or the Judge in retirement on or under section 8a shall not be less than after 1 July 1980. 1/5 of the Judge’s corresponding last drawn salary.”. Savings and transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), any dependant of a Judge who is qualified for the adjustment of derivative pension under the principal Act before 1 January 2009 but the adjustment has not been done before that date, the derivative pension shall be adjusted until 31 December 2008 as provided in the Fourth Schedule as if the Schedule has not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The derivative pension of any dependant of a Judge shall from 1 January 2009 be calculated based on the Fourth Schedule as amended by this Act and shall be payable from that date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "For any dependant of a Judge whose derivative pension has been adjusted immediately before 1 January 2009, the derivative pension shall from that date be calculated based on the Fourth Schedule as amended by this Act and shall be payable from that date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of the abolishment of the requirement of residency in Malaysia, the grant of derivative pension before 1 January 2008 shall be based on the principal Act as if it has not been amended by this Act and such grant of derivative pension shall be based on the amendments made to the principal Act by this Act only from 1 January 2008 and shall be payable from that date."
      }
    }
  ]
}
