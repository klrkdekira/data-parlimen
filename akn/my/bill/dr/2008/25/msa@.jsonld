      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Saraan Hakim (Pindaan)(No. 2) 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Saraan Hakim (Pindaan) (No. 2) 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 7 dan subseksyen 8(1), (2) dan (3) mula berkuat kuasa pada 1 Januari 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 2 dan 6 dan subseksyen 8(4) disifatkan telah mula berkuat kuasa pada 1 Januari 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan dalam seksyen 3, 4 dan 5, setakat yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "penyusutan amaun pencen terbitan kepada tujuh puluh peratus selepas tempoh dua belas tahun setengah, mula berkuat kuasa pada 1 Januari 2009; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "kehendak pemastautinan di Malaysia, disifatkan telah mula berkuat kuasa pada 1 Januari 2008. Pindaan seksyen 1a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Saraan Hakim 1971 [Akta 45], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 1a dengan memotong takrif “bermastautin di Malaysia”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda dengan memotong subseksyen (2). Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Jika seseorang Hakim mati dalam atau selepas tempoh dua belas tahun setengah dari tarikh persaraannya, Yang di-Pertuan Agong boleh memberi suami atau isteri atau anaknya, atau suami atau isteri dan anak itu, kedua-duanya, mengikut mana-mana yang berkenaan, pencen terbitan mengikut hak Hakim itu.”. Pindaan seksyen 11a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11a Akta ibu dipinda dengan memotong subseksyen (2) dan (3). Pindaan seksyen 15a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan koma di hujung perenggan itu dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan yang bermastautin di Malaysia.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2) dan (3). Penggantian Jadual Keempat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan Jadual Keempat dengan jadual yang berikut: “Jadual Keempat [Subseksyen 15b(3)] FORMULA PENYELARASAN BAGI PENCEN TERBITAN ORANG TANGGUNGAN Jenis Faedah Pencen terbitan hendaklah dibayar atau adalah kena dibayar untuk seumur hidup—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dari tarikh sebaik selepas 1/360 x bilangan bulan perkhidmatan tarikh kematian Hakim itu (tertakluk kepada tidak lebih daripada dalam perkhidmatan pada atau 180 bulan) x gaji bersamaan yang selepas 1 Julai 1980; atau akhir diterima; tetapi amaun pencen terbitan, sebagaimana yang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dari tarikh sebaik selepas tarikh diselaraskan, yang dibayar atau kena kematian Hakim itu dalam dibayar apabila Hakim itu mati dalam persaraan pada atau selepas perkhidmatan atau dalam persaraan 1 Julai 1980. di bawah perenggan 8(d) atau di bawah seksyen 8a tidaklah boleh kurang daripada 1/5 daripada gaji bersamaan yang akhir diterima oleh Hakim itu.”. Peruntukan kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), mana-mana orang tanggungan Hakim yang layak diberikan penyelarasan pencen terbitan di bawah Akta ibu sebelum 1 Januari 2009 tetapi penyelarasannya itu tidak dibuat sebelum tarikh itu, pencen terbitan itu hendaklah diselaraskan sehingga 31 Disember 2008 sebagaimana yang diperuntukkan dalam Jadual Keempat seolah- olah Jadual itu tidak dipinda melalui Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pencen terbitan mana-mana orang tanggungan Hakim hendaklah mulai 1 Januari 2009 dikira berdasarkan Jadual Keempat sebagaimana yang dipinda oleh Akta ini dan hendaklah kena dibayar mulai tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mana-mana orang tanggungan Hakim yang pencen terbitannya telah diselaraskan sebaik sebelum 1 Januari 2009, pencen terbitan itu hendaklah mulai tarikh itu dikira berdasarkan Jadual Keempat sebagaimana yang dipinda oleh Akta ini dan hendaklah kena dibayar mulai tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/25/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal penghapusan kehendak pemastautinan di Malaysia, pemberian pencen terbitan sebelum 1 Januari 2008 hendaklah berdasarkan Akta ibu seolah-olah Akta ibu tidak dipinda oleh Akta ini dan pemberian pencen terbitan itu hendaklah berdasarkan pindaan yang dibuat kepada Akta ibu oleh Akta ini hanya mulai 1 Januari 2008 dan hendaklah kena dibayar mulai tarikh itu."
      }
    }
  ]
}
