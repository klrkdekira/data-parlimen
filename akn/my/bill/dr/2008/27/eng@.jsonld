      "schema:text": {
        "@language": "en",
        "@value": "FUNCTIONS AND POWERS OF THE COMMISSION Functions and powers of the Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Commission are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to select suitably qualified persons who merit appointment as judges of the superior court for the Prime Minister’s consideration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to receive applications from qualified persons for the selection of judges to the superior court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate and implement mechanisms for the selection and appointment of judges of the superior court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to review and recommend programmes to the Prime Minister to improve the administration of justice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make other recommendations about the judiciary; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as it deems fit to enable it to perform its functions effectively or which are incidental to the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall have all such powers as may be necessary for, or in connection with, or reasonably incidental to, the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Commission shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Commission without leave of the Chairman or, in the case of the Chairman, without leave of the Prime Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Prime Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Prime Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where the office of a member of the Commission is vacated pursuant to subsection (1), the Prime Minister may appoint any person he deems fit to fill up the vacancy thereby created for the remainder of the term vacated by the member or for the interim period until a new person is appointed to the office or the position held by that member prior to his vacating the office or position."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any period of appointment made under subsection (2) shall not be taken into consideration in the reckoning of the period of appointment specified in section 6. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Commission related or connected to any candidate being considered for selection shall disclose to the Commission his relationship to the candidate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Commission in which the matter is discussed or deliberated and, after the disclosure, the member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be present in any discussion or deliberation, or decision of the Commission when the matter is discussed or deliberated, or decided upon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the Commission when the matter is discussed or deliberated, or decided upon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
