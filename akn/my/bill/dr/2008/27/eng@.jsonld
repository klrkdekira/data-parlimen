      "schema:text": {
        "@language": "en",
        "@value": "a brother or sister of a spouse or a former spouse of the member of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3__list_1__para_d",
