      "schema:text": {
        "@language": "en",
        "@value": "a person practising in a firm in which the member of the Commission or his nominee—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3__list_2__para_f__subpara_i",
