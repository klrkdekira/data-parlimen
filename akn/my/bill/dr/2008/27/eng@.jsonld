      "schema:text": {
        "@language": "en",
        "@value": "a spouse of a partner or former partner of the member of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3__list_2__para_e",
