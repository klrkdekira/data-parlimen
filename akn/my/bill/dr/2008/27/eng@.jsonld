      "schema:text": {
        "@language": "en",
        "@value": "a spouse or a former spouse of any person referred to in paragraph (b), (c), (d) or (e);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3__list_1__para_g",
