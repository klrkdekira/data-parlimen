      "schema:text": {
        "@language": "en",
        "@value": "a lineal descendant of a person referred to in paragraph (b), (c) or (f);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/eng@/~part_II__cl_11__subsec_3__list_1__para_h",
      "@type": "akn:paragraph",
