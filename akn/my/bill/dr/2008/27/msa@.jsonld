        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
