    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan penama anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pekongsi anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bekas pekongsi anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri kepada pekongsi atau bekas pekongsi anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bekas suami atau isteri kepada pekongsi atau bekas suami atau isteri kepada bekas pekongsi anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2__para_f__subpara_i",
