    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "fungsi Suruhanjaya adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memilih orang berkelayakan yang sesuai yang wajar dilantik sebagai hakim mahkamah atasan untuk pertimbangan perdana menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima permohonan daripada orang berkelayakan bagi pemilihan hakim-hakim ke mahkamah atasan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merumuskan dan melaksanakan mekanisme bagi pemilihan dan pelantikan hakim mahkamah atasan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji semula dan mengesyorkan program kepada perdana menteri bagi memperbaik pentadbiran keadilan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat syor lain berkenaan dengan badan kehakiman; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa benda lain sebagaimana yang difikirkannya patut untuk membolehkannya melaksanakan fungsinya secara berkesan atau yang bersampingan dengan pelaksanaan fungsinya di bawah akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai segala kuasa yang perlu bagi, atau yang berhubungan dengan, atau yang semunasabahnya bersampingan dengan, pelaksanaan fungsinya di bawah akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan seseorang anggota Suruhanjaya hendaklah menjadi kosong jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda) selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak menghadiri tiga mesyuarat Suruhanjaya berturut- turut tanpa kebenaran pengerusi atau, dalam hal pengerusi, tanpa kebenaran perdana menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pelantikannya dibatalkan oleh perdana menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "peletakan jawatannya diterima oleh perdana menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "jika jawatan seseorang anggota Suruhanjaya menjadi kosong menurut subseksyen (1), perdana menteri boleh melantik mana- mana orang yang difikirkannya sesuai untuk mengisi kekosongan yang wujud itu bagi baki tempoh yang dikosongkan oleh anggota itu atau bagi tempoh interim sehingga orang yang baru dilantik ke jawatan atau kedudukan yang dipegang oleh anggota itu sebelum dia mengosongkan jawatan atau kedudukan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa tempoh pelantikan di bawah subseksyen (2) tidak boleh diambil pertimbangan dalam mengambil kira tempoh pelantikan yang dinyatakan dalam seksyen 6. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota Suruhanjaya yang bersaudara atau berkaitan dengan mana-mana calon yang dipertimbangkan bagi pemilihan hendaklah menzahirkan hubungannya dengan calon itu kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran di bawah subseksyen (1) hendaklah direkodkan dalam minit mesyuarat Suruhanjaya yang dalamnya perkara itu dibincangkan atau ditimbangtelitikan dan, selepas penzahiran itu, anggota itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh hadir semasa mana-mana perbincangan atau pertimbangtelitian, atau keputusan Suruhanjaya apabila perkara itu dibincangkan atau ditimbangtelitikan, atau diputuskan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh dikira bagi maksud membentuk kuorum Suruhanjaya apabila perkara itu dibincangkan atau ditimbangtelitikan, atau diputuskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud seksyen ini— “bersaudara”, berhubung dengan seseorang anggota Suruhanjaya, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
