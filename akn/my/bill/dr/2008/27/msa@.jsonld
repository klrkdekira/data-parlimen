      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri atau bekas suami atau isteri anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "saudara lelaki atau perempuan anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "saudara lelaki atau perempuan kepada suami atau isteri atau bekas suami atau isteri anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mempunyai pertalian nasab langsung ke atas atau ke bawah dengan anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mempunyai pertalian nasab langsung ke atas atau ke bawah dengan suami atau isteri atau bekas suami atau isteri anggota Suruhanjaya itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri atau bekas suami atau isteri mana-mana orang yang disebut dalam perenggan (b), (c), (d) atau (e);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mempunyai pertalian nasab langsung ke bawah dengan orang yang disebut dalam perenggan (b), (c) atau (f);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bapa saudara, ibu saudara atau sepupu kepada anggota Suruhanjaya itu, atau bapa saudara, ibu saudara atau sepupu kepada suami atau isteri atau bekas suami atau isteri anggota Suruhanjaya itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mempunyai pertalian nasab langsung ke atas atau ke bawah kepada orang yang disebut dalam perenggan (h); “berkaitan”, berhubung dengan seseorang anggota Suruhanjaya, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/27/msa@/~part_II__cl_11__subsec_3__list_2",
