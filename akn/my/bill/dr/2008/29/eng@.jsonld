      "schema:name": {
        "@language": "en",
        "@value": "Bank Kerjasama Rakyat Malaysia Berhad (Special Provisions)(Amendment) Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act may be cited as the bank Kerjasama Rakyat Malaysia berhad (Special Provisions) (amendment) act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act is deemed to have come into operation on 1 January 2008. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The bank Kerjasama Rakyat Malaysia berhad (Special Provisions) 1978 [Act 202], which is referred to as the “principal act” in this act, is amended in section 2 by inserting after the definition of “Chairman” the following definition: ‘ “Commission” means the Malaysia Co-operative Societies Commission established under the Malaysia Co-operative Commission act 2007 [Act 665];’. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 3(f) and (g) of the principal act is amended by substituting for the words “Registrar-General” wherever appearing the word “Commission”. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 7(2) of the principal act is amended in the national language text—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “dan liabiliti” the words “, liabiliti, dan obligasi”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “liabiliti dan” the word “obligasi”. Repeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 3(b) and sections 4 and 5 of the bank Kerjasama Rakyat Malaysia berhad (Special Provisions) (amendment) act 2007 [Act A1293] are repealed."
      }
    }
  ]
}
