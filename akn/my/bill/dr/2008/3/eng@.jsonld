      "schema:name": {
        "@language": "en",
        "@value": "Supplementary Supply (2007) Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2007) Act 2008. Further expenditure for the year 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorized of a sum not exceeding seventeen billion five hundred and forty-five million one hundred and seventy- one thousand and eight hundred ringgit (RM 17,545,171,800) from the Consolidated Fund for expenditure on the services and purposes specified in the Schedule for the year 2007, not provided for or not fully provided for by the Supply Act 2007 [Act AI276]. Bill"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Title Purpose B. 1 Parliament B. 7 Public Services Department 16,810,108,100 B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 21 Ministry of Agriculture and Agro-based Industry B. 25 Ministry of Domestic Trade and Consumer Affairs B. 27 Ministry of Works B. 31 Ministry of Tourism B. 42 Ministry of Health B. 44 Ministry of Culture, Arts and Heritage B. 60 Ministry of Defence B. 62 Ministry of Internal Security TOTAL 17,545,171,800"
      }
    }
