      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (2007) 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2007) 2008. Perbelanjaan tambahan bagi tahun 2007"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi tujuh belas bilion lima ratus empat puluh lima juta satu ratus tujuh puluh satu ribu lapan ratus ringgit (RM17,545,171,800) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2007 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2007 [Akta A1276]. 2 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 1 Parlimen B. 7 Jabatan Perkhidmatan Awam B. 12 Peruntukan kepada Kumpulan Wang Terkanun 16,810,108,100 B. 13 Kementerian Luar Negeri B. 21 Kementerian Pertanian dan Industri Asas Tani B. 25 Kementerian Perdagangan Dalam Negeri dan Hal Ehwal Pengguna B. 27 Kementerian Kerja Raya B. 31 Kementerian Pelancongan B. 42 Kementerian Kesihatan B. 44 Kementerian Kebudayaan, Kesenian dan Warisan B. 60 Kementerian Pertahanan B. 62 Kementerian Keselamatan Dalam Negeri JUMLAH 17,545,171,800"
      }
    }
  ]
