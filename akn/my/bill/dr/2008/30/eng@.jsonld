      "schema:name": {
        "@language": "en",
        "@value": "Judges Ethics Committee Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
