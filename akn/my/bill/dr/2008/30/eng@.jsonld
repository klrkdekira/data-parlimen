      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PRelimiNARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "judges’ ethics committee Constitution of the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "if the chairman or any member of the committee has a direct or indirect interest in any disciplinary proceeding, he shall disclose to the committee the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the proceeding in which the disclosure was made and, after the disclosure, the chairman or the member shall not take part in the deliberation or decision of the committee. Meetings of the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "the committee shall meet on such dates and at such places and times as the chairman may determine. Quorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "the chairman and not less than two members of the committee shall form the quorum for every proceedings of the committee. Adjournment of hearing before the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "the committee may adjourn the hearing from time to time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "No written notice of an adjournment is required to be given to any party when the adjournment is made in the presence of that party. Records and minutes of proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "the chairman shall cause the records and minutes of proceedings of the committee to be maintained and kept in a proper form. Decision of the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where the committee is not unanimous on any question or matter to be determined, the decision of the majority shall be deemed to be the decision of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "the committee shall ensure that its decision in any disciplinary proceeding is communicated in writing to the judge who is the subject of the disciplinary proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any provision in any other written law, the decision of the committee shall be final and conclusive and shall not be challenged, appealed against, reviewed, quashed or called in question in any court on any ground, and no court shall have jurisdiction to entertain or determine any suit, application, question or proceeding on any ground regarding the validity of such decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "there shall be constituted a committee by the name of “judges’ ethics committee”. Jurisdiction of the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "the committee shall have jurisdiction in matters relating to the conduct and discipline of all judges other than the removal of a judge from office under clause (3) of Article 125 of the Federal constitution. Membership of the Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the committee shall be in odd numbers and shall consist of persons who hold or have held office as the President of the court of Appeal, chief judge of the high court of malaya, chief judge of the high court of sabah and sarawak, judge of the Federal court, the court of Appeal or a high court as the chief justice of the Federal court deems fit to appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the chief justice of the Federal court shall be the chairman of the committee, unless he is the complainant, in which case the next senior judge shall be the chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the appointment of the members of the committee shall be on an ad hoc basis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any provisions of this Act, the members of the committee shall comprise judges who are senior in the order of precedence to the judge who is the subject of a disciplinary proceeding. Substitute member"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where the chairman is unable, through illness or for any other reason, to attend a disciplinary proceeding, the next senior serving judge in the committee shall be the chairman, and the chief justice of the Federal court shall appoint another judge in place of that senior judge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Where any member of the committee is unable, through illness or for any other reason, to attend a disciplinary proceeding, the chief justice of the Federal court shall appoint another judge in place of that member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the committee appointed under subsection (1) or (2) shall be a judge who is senior in the order of precedence to the judge who is the subject of a disciplinary proceeding. Principles and procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "in the exercise of its functions under this Act, the committee shall abide by the principles and procedures set out in this Act and the code of ethics. Proceedings in camera"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings of the committee shall be in camera. Enquiry"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings of the committee shall not be a trial but an enquiry as regards the breach of any provisions of the code of ethics committed by a judge referred to it by the chief justice of the Federal court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "the evidence Act 1950 [Act 56] shall not apply to proceedings of the committee. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "this Act may be cited as the judges’ ethics committee Act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "this Act comes into operation on a date to be appointed by the minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/30/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "in this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“complaint” means any complaint concerning the misconduct of a judge; “judge” means a judge of the high court, a judge of the court of Appeal and a judge of the Federal court, and includes a judicial commissioner; “committee” means the judges’ ethics committee constituted under section 3; “code of ethics” means the judges’ code of ethics 2008 [P.U. (A) ....../200......]; “breach” means the breach of any provisions of the code of ethics; “chairman” means the chairman of the committee appointed under section 5."
      }
    }
  ]
}
