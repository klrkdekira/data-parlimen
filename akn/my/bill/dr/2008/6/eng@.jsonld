      ],
      "schema:name": {
        "@language": "en",
        "@value": "Education (Amendment) 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 77(1) of the principal Act is amended by inserting after the words \"private educational institution\" \"registered under this Act\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Education (Amendment) Act 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. General amendments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Education Act 1996 [Act 550], which is referred to as the \"principal Act\" in this Act, is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Registrar General of Schools and Teachers\" wherever appearing the words \"Registrar General of Educational Institutions and Teachers\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"teacher education colleges\" wherever appearing the words \"institutes of teacher education\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Registrar of Schools and Teachers\" wherever appearing the words \"Registrar of Educational Institutions and Teachers\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Assistant Registrar of Schools\" wherever appearing the words \"Assistant Registrar of Educational Institutions\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words \"Deputy Registrar General of Schools and Teachers\" wherever appearing the words \"Deputy Registrar General of Educational Institutions and Teachers\". Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of \"higher educational institution\" the following definition: ' \"institute of teacher education\" means an educational institution providing teacher education leading to the award of a certificate, a diploma, a teaching degree or the equivalent thereof, or any other qualification as prescribed;';"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"Registrar General\", by substituting for the word \"Schools\" the words \"Educational Institutions\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"special education\", by substituting for the words \"the special educational needs of pupils\" the words \"pupils with special needs\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of \"Assistant Registrar\", by substituting for the word \"Schools\" the words \"Educational Institutions\". Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 5 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by inserting after the words \"numbers of the words \"Deputy Registrars of Educational Institutions and Teachers,\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by inserting after the words \"The Deputy Registrar General, the Registrars,\" the words \"the Deputy Registrars\"; and Education (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (6), by substituting for the words \"The Registrar or Assistant Registrar\" the words \"The Registrar, the Deputy Registrar or the Assistant Registrar\". New section 9A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 9 the following section: \"Change of names 9A. (1) All references to the \"Registrar General of Schools and Teachers\", \"Deputy Registrar General of Schools and Teachers\", \"Registrars of Schools and Teachers\" and \"Assistant Registrars of Schools and Teachers\" in any instrument, document, agreement or working arrangement subsisting immediately before the date of coming into operation of this Act shall, on and after the date of coming into operation of this Act, be construed as references to the \"Registrar General of Educational Institutions and Teachers\", \"Deputy Registrar General of Educational Institutions and Teachers\", \"Registrars of Educational Institutions and Teachers\" and \"Assistant Registrars of Educational Institutions and Teachers\" respectively. (2) The change of names from the \"Registrar General of Schools and Teachers\", \"Deputy Registrar General of Schools and Teachers\", \"Registrars of Schools and Teachers\" and \"Assistant Registrars of Schools and Teachers\" to \"Registrar General of Educational Institutions and Teachers\", \"Deputy Registrar General of Educational Institutions and Teachers\", \"Registrars of Educational Institutions and Teachers\" and \"Assistant Registrars of Educational Institutions and Teachers\" respectively shall not affect any powers, rights, privileges, liabilities, duties or obligations of the \"Registrar General of Schools and Teachers\", \"Deputy Registrar General of Schools and Teachers\", \"Registrars of Schools and Teachers\" and \"Assistant Registrars of Schools and Teachers\", or render defective any legal proceeding by or against them.\". Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 22(3) of the principal Act is amended by substituting for the word \"inform\" the words \"obtain the written approval of\". Amendment of section 44"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 44 of the principal Act is amended by inserting after the word \"certificate\" the words \", diploma, teaching degree\". Amendment of section 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by substituting for the words \"or diplomas\" the words \", diplomas, teaching degrees or any other qualification as may be prescribed\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (e), by substituting for the words \"and national\" the words \", national and international\"; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (g), by inserting after the words \"application for\" the words \"the establishment and\". Amendment of section 67"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 67(1) of the principal Act is amended by substituting for the words \"primary and secondary schools\" \"educational institutions\". Amendment of section 77"
      }
    }
  ]
