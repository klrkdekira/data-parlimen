      ],
      "schema:name": {
        "@language": "en",
        "@value": "Judges Remuneration (Amendment) Bill 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Judges' Remuneration (Amendment) Act 2008. Amendment of section 1A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Judges' Remuneration Act 1971 [Act 45], which is referred to as the \"principal Act\" in this Act, is amended in section 1A by inserting after the definition of \"Judge\" the following definition: ' \"Judicial Commissioner\" means a person appointed to be a full-time Judicial Commissioner under Article 122AB of the Federal Constitution;'. New section 7A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 7 the following section: \"Period of service as Judicial Commissioner 7A. (1) For the purpose of computing a Judge's pension and gratuity under this Act, his period of service as Judicial 2 Bill Commissioner immediately preceding his appointment as a Judge shall be counted as part of his period of service as a Judge. (2) For the purpose of computing a Judge's pension and gratuity, where any pension or gratuity has been paid to the Judge under any other law for the same period as the period which shall be counted as part of his period of service as a Judge under subsection (1), his pension and gratuity under this Act shall be reduced by the amount so paid.\"."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The amendments in subsection (1) shall only apply in respect of the period of service as Judicial Commissioners of Judges who are still in service on the date of coming into operation of this Act. Amendment of section 19A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 19A of the principal Act is amended by substituting for the words \"person appointed to be a full time Judicial Commissioner under Article 122AB of the Federal Constitution\" the words \"Judicial Commissioner\"."
      }
    }
  ]
}
