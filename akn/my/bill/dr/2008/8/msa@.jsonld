      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pencen (Pindaan) 2008"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
