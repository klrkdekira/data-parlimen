        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pencen (Pindaan) 2008."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Julai 2008. Pindaan seksyen 6A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pencen 1980 [Akta 227], yang disebut \"Akta ibu\" dalam Akta ini, dipinda dalam seksyen 6A—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5A), dengan menggantikan perkataan \"1 Oktober 2 0 0 1\" dan \"lima puluh enam\" masing- masing dengan perkataan \"1 Julai 2008\" dan \"lima puluh lapan\"; 2 Rang Undang-Undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (5A) subseksyen yang berikut: \"(5B) Umur persaraan paksa bagi seseorang pegawai yang tidak memilih umur persaraan paksa lima puluh lapan tahun yang disebut dalam subseksyen (5A) hendaklah kekal sama ada lima puluh lima tahun atau lima puluh enam tahun sebagaimana umur yang telah dipilihnya sebelum 1 Julai 2008. (5c) Opsyen bagi umur persaraan paksa lima puluh lapan tahun yang dilaksanakan oleh seseorang pegawai bagi maksud subseksyen (5) dan (5A) tidak boleh dibatalkan.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6), dengan memasukkan selepas perkataan \"seksyen 10\" perkataan \"atau seksyen 11\". Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dan (3) dengan subseksyen yang berikut: \"(2) Jika seseorang pegawai mencapai umur persaraan paksa lima puluh lima, lima puluh enam atau lima puluh lapan tahun, mengikut mana-mana yang berkenaan, dan suatu prosiding jenayah atau tatatertib yang mungkin berkeputusan dengan dia disabitkan atau dibuang kerja belum lagi selesai, perkhidmatannya hendaklah disifatkan sebagai telah dilanjutkan melampaui mana-mana umur itu, mengikut mana-mana yang berkenaan, tetapi dikira cuti tanpa gaji sehingga kesnya diputuskan. (3) Jika prosiding jenayah atau tatatertib di bawah subseksyen (2) itu tidak berkeputusan dengan dia disabitkan atau dibuang kerja, dia hendaklah bersara apabila mencapai umur lima puluh lima, lima puluh Pencen (Pindaan) enam atau lima puluh lapan tahun, mengikut mana- mana yang berkenaan dengan umur persaraan paksanya, dan tempoh perkhidmatan selepas mana-mana umur ini, mengikut mana-mana yang berkenaan, tidak dikira sebagai perkhidmatan yang boleh dimasukira.\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan menggantikan perkataan \"lima puluh enam\" dan \"1 Oktober 2 0 0 1\" masing- masing dengan perkataan \"lima puluh lapan\" dan \"1 Julai 2008\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (8), dengan menggantikan perkataan \"lima puluh enam\" di mana-mana jua perkataan itu terdapat dan perkataan \"1 Oktober 2 0 0 1\" masing-masing dengan perkataan \"lima puluh lapan\" dan \"1 Julai 2008\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (9), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\". Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 12 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\";"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3B) dengan subseksyen yang berikut: \"(3B) Jika seseorang pegawai yang disebut dalam subseksyen (3) yang telah dilantik sebelum 1 Julai 2008 yang telah diberikan opsyen sebelum tarikh itu dan tidak memilih umur persaraan paksa lima puluh lapan tahun, subseksyen (3) hendaklah terpakai baginya dengan menggantikan perkataan 'lima puluh lapan' dengan perkataan 'lima puluh lima' atau 'lima puluh enam', mengikut mana-mana yang berkenaan, sebagaimana umur yang telah dipilih oleh pegawai itu bagi persaraan paksanya sebelum 1 Julai 2008.\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan \"atau lima puluh enam tahun\" dengan perkataan \", lima puluh enam tahun atau lima puluh lapan tahun\". Rang Undang-Undang Pindaan seksyen 12A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 12A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2A) dengan subseksyen yang berikut: \"(2A) Jika seseorang pegawai yang disebut dalam subseksyen (2) yang telah dilantik sebelum 1 Julai 2008 yang telah diberikan opsyen sebelum tarikh itu dan tidak memilih umur persaraan paksa lima puluh lapan tahun, subseksyen (2) hendaklah terpakai baginya dengan menggantikan perkataan 'lima puluh lapan' dengan perkataan 'lima puluh lima' atau 'lima puluh enam', mengikut mana-mana yang berkenaan, sebagaimana umur yang telah dipilih oleh pegawai itu bagi umur persaraan paksanya sebelum 1 Julai 2008.\". Pindaan seksyen 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan \"lima puluh enam\" dengan perkataan \"lima puluh lapan\"; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2008/8/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2A) dengan subseksyen yang berikut: \"(2A) Jika seseorang pegawai yang disebut dalam subseksyen (2) yang telah dilantik semula sebelum 1 Julai 2008 yang telah diberikan opsyen sebelum tarikh itu dan tidak memilih umur persaraan paksa lima puluh lapan tahun, subseksyen (2) hendaklah terpakai baginya dengan menggantikan perkataan 'lima puluh lapan' dengan perkataan 'lima puluh lima' atau 'lima puluh enam', mengikut mana-mana yang berkenaan, sebagaimana umur yang telah dipilih oleh pegawai itu bagi persaraan paksanya sebelum 1 Julai 2008.\". Pencen (Pindaan)"
      }
    }
  ]
}
