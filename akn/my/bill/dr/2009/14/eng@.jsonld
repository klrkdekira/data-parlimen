      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/14/eng@/~cl_1__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "different provisions of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/14/eng@/~cl_1__subsec_2__para_b",
