      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan orang sebenar, merupakan warganegara atau pemastautin tetap Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan mana-mana orang lain, telah menubuhkan suatu tempat perniagaan, dan sedang beroperasi, di Malaysia, dan termasuklah seseorang yang diisytiharkan sebagai pemastautin menurut seksyen 43 Akta Kawalan Pertukaran Wang 1953 [Akta 17]; “perakuan” ertinya suatu perakuan yang dikeluarkan di bawah Akta ini; “perbadanan” ertinya mana-mana pertubuhan perbadanan yang dibentuk atau diperbadankan atau wujud di Malaysia atau di luar Malaysia dan termasuklah sesuatu syarikat Labuan asing tetapi tidak termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu perbadanan seorang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kesatuan sekerja yang didaftarkan di bawah mana- mana undang-undang bertulis sebagai kesatuan sekerja; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu pertubuhan yang didaftarkan di bawah mana- mana undang-undang bertulis yang berhubungan dengan koperasi; “perjanjian perkongsian” ertinya suatu perjanjian bertulis pekongsi-pekongsi tentang hal-ehwal sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana- mana yang berkenaan, dan hak dan obligasi pekongsi sesama mereka; “perkongsian liabiliti terhad Labuan” ertinya suatu perkongsian liabiliti terhad yang didaftarkan di bawah seksyen 30 atau 48; “perkongsian terhad Labuan” ertinya suatu perkongsian terhad yang didaftarkan di bawah seksyen 5; Liabiliti Terhad Labuan “syarikat amanah Labuan” ertinya suatu syarikat yang didaftarkan sebagai suatu syarikat amanah Labuan di bawah Bahagian V Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2009 [Akta ….]; “syarikat Labuan” mempunyai erti yang diberikan kepadanya dalam Akta Syarikat Labuan 1990; “ringgit” ertinya ringgit dalam mata wang Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu perkongsian terhad Labuan adalah tidak solven pada sesuatu masa tertentu apabila pekongsi am tidak berupaya untuk menunaikan hutang dan obligasi perkongsian terhad Labuan itu, tidak termasuk liabiliti kepada pekongsi berkenaan dengan kepentingan perkongsiannya, apabila ia kena dibayar, daripada aset perkongsian terhad Labuan itu tanpa menggunakan aset berasingan seseorang pekongsi am yang tidak disumbangkan kepada perkongsian terhad Labuan itu, dan “solven” hendaklah ditafsirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
