        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_85",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_87",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_88",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Akaun hendaklah disimpan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan hendaklah menyimpan apa-apa rekod perakaunan dan rekod lain yang mencukupi untuk menjelaskan transaksinya dan menzahirkan dengan ketepatan yang munasabah pada bila-bila masa tentang kedudukan kewangan perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pekongsi am atau pekongsi ditetapkan, mengikut mana-mana yang berkenaan, hendaklah menyebabkan catatan yang sesuai dibuat dalam rekod perakaunan dan rekod lain perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana-mana yang berkenaan, dalam masa enam puluh hari dari penyelesaian transaksi yang baginya mereka berhubungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Rekod perakaunan dan rekod lain sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan hendaklah disimpan di pejabat berdaftarnya atau di tempat lain di Labuan yang difikirkan sesuai oleh pekongsi am atau pekongsi ditetapkan, mengikut mana yang berkenaan, dan hendaklah pada bila-bila masa dibuka untuk pemeriksaan oleh mana-mana pekongsi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Melainkan jika dikehendaki selainnya dalam perjanjian perkongsian, akaun sesuatu perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan tidak dikehendaki untuk diaudit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pekongsi am atau pekongsi ditetapkan sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana-mana yang berkenaan, yang tidak mengambil segala langkah yang munasabah untuk memastikan pematuhan oleh perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu, dengan kehendak seksyen ini melakukan suatu kesalahan terhadap Akta ini. Maksud penubuhan yang dibenarkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan hendaklah tertakluk kepada sekatan dan larangan yang sama seperti syarikat Labuan di bawah Akta Syarikat Labuan 1990 melainkan jika dibenarkan secara nyata di bawah Akta ini atau jika sekatan dan larangan itu dibenarkan atau diketepikan di bawah Akta Syarikat Labuan 1990, kebenaran atau pengenepian yang sama hendaklah sama-sama terpakai bagi perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), Menteri boleh melalui notis yang disiarkan dalam Warta, memerintahkan supaya sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan disekat atau dilarang daripada menjalankan apa-apa perniagaan yang dinyatakan di Labuan dan boleh, melalui notis Liabiliti Terhad Labuan yang disiarkan dalam Warta, mengenakan syarat yang tertakluk kepadanya sesuatu perniagaan yang dinyatakan boleh dijalankan oleh perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan yang tidak mematuhi subseksyen (1) atau tidak mematuhi perintah Menteri di bawah subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit. Fi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengenakan fi berkenaan dengan perkhidmatan yang diberikan oleh Lembaga di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan hendaklah membayar apa-apa fi tahunan yang ditetapkan, pada atau sebelum setiap ulang tahun tarikh pendaftarannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa fi yang dipungut oleh atau dibayar kepada Lembaga di bawah Akta ini hendaklah menjadi sebahagian daripada dan dikreditkan ke dalam kumpulan wangnya yang ditubuhkan di bawah seksyen 29 Akta Lembaga Perkhidmatan Kewangan Labuan 1996. Pemeriksaan dan pengemukaan dokumen yang disimpan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, seseorang boleh, jika diberi kuasa oleh perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan yang berkaitan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa dokumen yang disampaikan kepada, didaftarkan oleh atau difailkan dengan Lembaga di bawah Akta ini dan yang disimpan oleh Lembaga atau, jika difikirkan sesuai oleh Lembaga, suatu salinan dokumen itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki supaya diberikan kepadanya suatu salinan perakuan pendaftaran sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan atau mana-mana dokumen lain atau sebahagian daripada mana-mana dokumen lain yang disebut dalam perenggan (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu salinan perakuan yang diberikan di bawah perenggan (1)(b) hendaklah diperakui oleh Lembaga dan dimeterai dengan meterai Lembaga. Bentuk rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Rekod-rekod yang sesuatu perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan dikehendaki oleh Akta ini untuk disimpan boleh disimpan dalam bentuk filem fotografi atau boleh dicatatkan atau direkodkan melalui sistem pemprosesan data secara mekanik atau elektronik atau apa-apa peranti penyimpanan maklumat lain yang berupaya mengeluarkan semula apa-apa maklumat yang dikehendaki dalam bentuk bertulis yang dapat difahami dalam masa yang munasabah. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini, mana-mana orang yang, pada masa pelakuan kesalahan itu ialah pengarah, pengurus, pekongsi, setiausaha atau pegawai lain yang seumpamanya atau yang berupa bertindak atas apa-apa sifat sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh didakwa secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati melakukan kesalahan itu, hendaklah disifatkan telah melakukan kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuan, persetujuan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_75__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah yang munasabah dan telah menjalankan segala usaha yang wajar untuk mencegah pelakuan kesalahan itu. Liabiliti Terhad Labuan Dokumen hendaklah difailkan melalui syarikat amanah Labuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap dokumen yang dikehendaki atau dibenarkan supaya difailkan dengan Lembaga di bawah Akta ini hendaklah difailkan melalui suatu syarikat amanah Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap permohonan kepada Lembaga bagi apa-apa perakuan atau apa-apa cabutan atau salinan apa-apa perakuan yang dikeluarkan di bawah Akta ini atau apa-apa dokumen yang difailkan dengan Lembaga hendaklah dibuat melalui syarikat amanah Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (2) tidak terpakai jika sesuatu permohonan dibuat oleh mana-mana pekongsi sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan berkenaan dengan perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu, mengikut mana-mana yang berkenaan, dan dokumen, perakuan, cabutan atau salinan itu adalah bagi kegunaan peribadinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa dokumen dikehendaki supaya difailkan atau didaftarkan dengan Lembaga melalui syarikat amanah Labuan, syarikat amanah Labuan itu hendaklah, tanpa menjejaskan kewajipannya yang terkandung dalam Akta Perkhidmatan Kewangan dan Sekuriti Labuan 200... [Akta ....], memastikan kesahan, kebenaran dan keaslian dokumen itu. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit. Kuasa untuk mengenakan penalti pentadbiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengenakan penalti pentadbiran ke atas mana-mana orang yang tidak mematuhi mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah, sebelum membuat keputusan untuk mengenakan suatu penalti pentadbiran ke atas seseorang, menyampaikan kepadanya suatu notis bertulis meminta dia memberikan tunjuk sebab mengapa penalti pentadbiran itu tidak sepatutnya dikenakan ke atasnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu penjelasan yang memuaskan tidak diterima dalam tempoh yang ditetapkan dalam notis bertulis itu, Lembaga boleh mengenakan suatu penalti pentadbiran yang amaunnya tidak melebihi lima ratus ringgit bagi setiap hari ketidakpatuhan dan amaun itu tidak boleh secara keseluruhan melebihi jumlah sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang tidak membayar suatu penalti pentadbiran yang dikenakan oleh Lembaga di bawah subseksyen (3), penalti yang dikenakan oleh Lembaga itu boleh dibawa guaman terhadapnya dan boleh didapatkan sebagai suatu hutang yang kena dibayar kepada Lembaga. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, dengan keizinan bertulis Pendakwa Raya, mengkompaunkan apa-apa kesalahan yang dilakukan oleh mana- mana orang di bawah Akta ini dengan membuat suatu tawaran bertulis kepada orang itu untuk mengkompaunkan kesalahan itu dengan membayar kepada Lembaga, dalam masa yang dinyatakan dalam tawaran itu, suatu amaun yang tidak melebihi lima puluh peratus daripada amaun denda maksimum bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya telah dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau dalam apa-apa tempoh lanjutan yang diberikan oleh Lembaga, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan selepas itu berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran mengkompaun kesalahan itu dibuat. Liabiliti Terhad Labuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa wang yang diterima oleh Lembaga di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada kumpulan wang yang ditubuhkan di bawah seksyen 29 Akta Lembaga Perkhidmatan Kewangan Labuan 1996. Pemotongan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa peruntukan dalam Akta ini, jika Lembaga berpuas hati bahawa sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak membayar apa-apa fi yang ditetapkan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini, Lembaga boleh menyampaikan suatu notis kepada perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu yang memberitahunya bahawa namanya akan dipotong daripada daftar, melainkan jika perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu mengambil apa-apa langkah atau tindakan untuk meremedi kemungkiran yang dinyatakan dalam notis itu dalam masa tiga puluh hari bermula dari tarikh notis atau apa-apa tempoh yang lebih lama yang dilanjutkan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima daripada perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, suatu notis yang menyatakan bahawa ada kemungkinan ia tidak akan dapat meremedi kemungkiran yang dinyatakan dalam notis di bawah subseksyen (1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menerima apa-apa jawapan daripada perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan kepada notis di bawah subseksyen (1), Lembaga boleh dalam masa tiga puluh hari bermula dari tarikh habis tempoh yang disebut dalam notis atau selepas itu, memotong nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu daripada daftar melainkan jika perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu memuaskan hati Lembaga bahawa nama itu tidak patut dipotong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan yang telah dipotong daripada daftar di bawah seksyen ini masih lagi bertanggungan bagi semua tuntutan, hutang, liabiliti dan obligasinya, dan pemotongan itu tidak menjejaskan liabiliti mana-mana pekongsinya. Kemasukan semula dalam daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_81__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika nama sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan telah dipotong daripada daftar di bawah subseksyen 80(2), perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, atau pekongsi atau pelikuidasinya boleh, dalam masa tiga tahun sebaik selepas tarikh pemotongan itu, memohon kepada Lembaga supaya nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu dimasukkan semula dalam daftar, dan apabila dibayar kepada Lembaga fi kemasukan semula yang ditetapkan dan segala fi yang ditetapkan lain yang kena dibayar, Lembaga boleh memasukkan semula nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu dalam daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu dimasukkan semula dalam daftar, nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu hendaklah disifatkan tidak pernah dipotong daripada daftar. Kesan pemotongan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika nama sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan telah dipotong daripada daftar, perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, dan pekongsi, pelikuidasi dan penerimanya, tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memulakan atau membela apa-apa prosiding undang-undang, atau menjalankan apa-apa perniagaan atau dengan apa- apa cara menguruskan harta perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membela apa-apa prosiding undang-undang, membuat apa-apa tuntutan atau menuntut apa-apa hak bagi, atau atas nama perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan; atau Liabiliti Terhad Labuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak dengan apa-apa cara berkenaan dengan hal-ehwal perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), jika nama sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan telah dipotong daripada daftar, perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu, atau pekongsi, pelikuidasi atau penerimanya, boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memohon kepada Lembaga supaya perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu didaftarkan semula;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "meneruskan pembelaan prosiding undang-undang yang telah dimulakan terhadap perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu sebelum tarikh pemotongan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "terus menjalankan prosiding undang-undang yang telah dimulakan bagi pihak perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu sebelum tarikh pemotongan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Hakikat bahawa nama sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan telah dipotong daripada daftar tidak boleh ditafsirkan sebagai menghalang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu daripada bertanggungan bagi apa-apa liabilitinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang daripada membuat tuntutan terhadap perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu, dan meneruskan tuntutan itu sehingga penghakiman atau pelaksanaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_82__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mahkamah daripada memberikan apa-apa perintah yang diperuntukkan di bawah Akta ini. Kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang dengan apa-apa cara mempunyai akses kepada apa-apa rekod, buku, daftar, surat-menyurat, dokumen, bahan atau maklumat, yang berhubungan dengan perniagaan dan hal-ehwal sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana-mana yang berkenaan, boleh memberikan, membuka, mendedahkan, menyiarkan atau selainnya menzahirkan kepada mana-mana orang rekod, buku, daftar, surat-menyurat, dokumen, bahan atau maklumat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua prosiding, selain prosiding jenayah, yang berhubungan dengan sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan hendaklah dimulakan dalam mana-mana Mahkamah Tinggi, sama ada di bawah peruntukan Akta ini atau bagi menentukan hak dan obligasi pekongsi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding dalam subseksyen (2) dan apa-apa rayuan daripada prosiding itu, hendaklah, melainkan jika diperintahkan selainnya oleh Mahkamah Tinggi, didengar secara tertutup dan tiada butir- butir prosiding itu boleh disiarkan oleh mana-mana orang tanpa kebenaran Mahkamah Tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan subseksyen (1) tidak terpakai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "jika penzahiran dikehendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menurut suatu perintah mana-mana mahkamah dalam mana-mana prosiding;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud pelaksanaan fungsi penyeliaan Lembaga yang diperuntukkan di bawah Akta Lembaga Perkhidmatan Kewangan Labuan 1996; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud seksyen 22 Akta Cukai Aktiviti Perniagaan Labuan 1990; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "jika terdapat kebenaran daripada semua pekongsi perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika perintah yang disebut dalam subperenggan (4)(a)(i) telah diperoleh melalui suatu permohonan ex-parte, pekongsi terhad atau pekongsi perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana-mana yang berkenaan, boleh memberitahu orang yang terjejas dengan perintah itu dan apabila pemberitahuan itu diterima, orang yang terjejas itu boleh memfailkan permohonan yang perlu kepada mahkamah untuk mencabar perintah itu atau selainnya mematuhi perintah itu dengan sewajarnya. Liabiliti Terhad Labuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini boleh menghalang mana-mana mahkamah daripada menjalankan budi bicaranya untuk menghendaki mana-mana orang untuk mengemukakan apa- apa dokumen atau untuk memberikan apa-apa keterangan dalam mana-mana prosiding di hadapan mahkamah yang berkaitan dengan prosiding itu. Hak untuk mendapatkan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa peruntukan Akta ini, Lembaga boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud memuaskan hatinya bahawa peruntukan Akta ini dipatuhi dan bahawa perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan itu, mengikut mana-mana yang berkenaan, berada dalam kedudukan kewangan yang kukuh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai akses kepada dan memeriksa buku, rekod, baucer, dokumen, wang tunai dan sekuriti bagi sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki mana-mana pekongsi, pegawai atau pekerja sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan untuk mengemukakan apa-apa maklumat, statistik, penyata atau dokumen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki, pada bila-bila masa, sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan atau mana-mana pekongsinya untuk mengemukakan apa-apa maklumat, statistik, penyata atau dokumen yang berhubungan dengan perkongsian itu kepada Lembaga pada masa dan tempat yang dinyatakan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dikehendaki di bawah subperenggan (1)(a)(ii) atau perenggan (1)(b) untuk memberikan apa-apa maklumat, statistik, penyata atau dokumen kepada Lembaga, orang itu hendaklah mengemukakan maklumat, statistik, penyata atau dokumen itu kepada Lembaga dalam bentuk dan cara dan dalam tempoh yang dinyatakan oleh Lembaga dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dikehendaki untuk memberikan kepada Lembaga apa-apa maklumat, statistik, penyata atau dokumen di bawah subperenggan (1)(a)(ii) atau perenggan (1)(b), orang itu tidak boleh mengemukakan apa-apa maklumat, statistik, penyata atau dokumen sebagai benar dan tepat yang baginya dia mengetahui, atau mempunyai alasan untuk mempercayai, adalah palsu, tidak tepat atau mengelirukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi subseksyen (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pekongsi, pegawai atau pekerja sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan, mengikut mana-mana yang berkenaan, yang menghalang atau menggalang Lembaga atau mana-mana orang yang diberi kuasa semasa menjalankan mana-mana kuasa yang disebut dalam subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran oleh seseorang tentang apa-apa maklumat kepada Lembaga sebagaimana yang dikehendaki oleh Lembaga di bawah subseksyen (1) tidak menjadi suatu kesalahan di bawah Akta ini. Pemakaian Akta Lembaga Perkhidmatan Kewangan Labuan 1996"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya terdapat apa-apa ketidakselarasan antara mana- mana peruntukan Akta ini dengan peruntukan Akta Lembaga Perkhidmatan Kewangan Labuan 1996, Akta yang kemudian disebut itu hendaklah mengatasi. Liabiliti Terhad Labuan Pemakaian undang-undang perkongsian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Rukun ekuiti dan common law yang terpakai bagi perkongsian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah terus terpakai bagi sesuatu perkongsian terhad Labuan, kecuali setakat yang tidak selaras dengan peruntukan nyata Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak terpakai bagi sesuatu perkongsian liabiliti terhad Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta Perkongsian 1961 [Akta 135] tidak terpakai bagi sesuatu perkongsian terhad Labuan dan perkongsian liabiliti terhad Labuan yang ditubuhkan atau didaftarkan di bawah Akta ini. Tatacara jika tidak dinyatakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa perbuatan atau langkah dikehendaki atau dibenarkan untuk dilakukan atau diambil di bawah Akta ini dan tiada bentuk ditetapkan atau tatacara dinyatakan sama ada dalam Akta ini atau peraturan-peraturan yang dibuat di bawah Akta ini, permohonan boleh dibuat kepada Lembaga bagi mendapatkan arahan tentang cara yang baginya perbuatan atau langkah itu boleh dilakukan atau diambil, dan apa-apa perbuatan atau langkah yang dilakukan atau diambil mengikut arahan Lembaga hendaklah menjadi pelaksanaan yang sah bagi perbuatan atau langkah itu. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Lembaga, mengecualikan sesuatu perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan atau seseorang atau golongan orang atau kelas perkongsian terhad Labuan atau perkongsian liabiliti terhad Labuan daripada mana-mana peruntukan Akta ini dan boleh, dalam memberikan pengecualian itu, mengenakan apa-apa terma dan syarat yang difikirkan sesuai oleh Menteri. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Lembaga, membuat peraturan- peraturan untuk menetapkan semua perkara dan benda yang dikehendaki atau diberi kuasa oleh Akta ini untuk ditetapkan atau diperuntukkan, atau yang perlu atau suai manfaat untuk ditetapkan atau diperuntukkan, bagi menjalankan, atau melaksanakan sepenuhnya, peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah Akta ini boleh memperuntukkan bagi apa-apa perbuatan atau peninggalan yang melanggar peraturan-peraturan itu menjadi suatu kesalahan dan boleh memperuntukkan penalti suatu denda tidak melebihi dua puluh lima ribu ringgit atau pemenjaraan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Perlindungan terhadap guaman dan prosiding undang- undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan boleh diambil atau dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga, mana-mana pegawai diberi kuasa, ejen atau pekhidmat Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain bagi atau kerana atau berkenaan dengan mana-mana perbuatan yang dilakukan atau berupa sebagai dilakukan oleh orang itu di bawah perintah, arahan atau petunjuk Lembaga atau mana-mana pegawai diberi kuasa, ejen atau pekhidmat Lembaga, jika perbuatan itu dilakukan dengan suci hati dan dengan kepercayaan yang munasabah bahawa ia adalah perlu bagi tujuan yang dimaksudkan yang hendak dicapai olehnya dan bagi melaksanakan peruntukan Akta ini. Pemansuhan dan kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “tarikh kuat kuasa” hendaklah membawa erti tarikh yang ditetapkan oleh Menteri dalam seksyen 1. Liabiliti Terhad Labuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perkongsian Terhad Luar Pesisir Labuan 1997 [Akta 565] dimansuhkan dari tarikh kuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua peraturan-peraturan, perintah, pemberitahuan, pengecualian dan perundangan subsidiari lain, kelulusan, arahan, keputusan dan perbuatan eksekutif lain, walau apa jua dinamakan, yang dibuat, diberikan atau dilakukan di bawah atau mengikut, atau menurut Akta Perkongsian Terhad Luar Pesisir Labuan 1997 hendaklah disifatkan sebagai telah dibuat, diberikan, atau dilakukan, di bawah atau mengikut, peruntukan yang bersamaan dengan Akta ini, dan hendaklah terus berkuat kuasa dengan sepenuhnya dan seberkesannya berhubung dengan orang yang kepadanya mereka terpakai sehingga dipinda, dimansuhkan, ditamatkan, dibatalkan atau digantikan di bawah, mengikut atau menurut kuasa, peruntukan yang bersamaan dengan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap arahan, notis, garis panduan atau pekeliling yang dikeluarkan oleh Lembaga atau Menteri di bawah Akta Perkongsian Terhad Luar Pesisir Labuan 1997 sebelum tarikh kuat kuasa dan berkuat kuasa sebaik sebelum tarikh kuat kuasa, hendaklah disifatkan sebagai telah dikeluarkan dengan sah di bawah Akta ini di bawah peruntukan tertentu Akta ini yang bersamaan dengan perkara yang diperkatakan dalam arahan, notis, garis panduan atau pekeliling itu dan hendaklah terus berkuat kuasa dengan sepenuhnya dan seberkesannya sehingga ia dipinda, dimansuhkan, ditamatkan, dibatalkan atau digantikan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permohonan bagi kelulusan atau keizinan, atau bagi apa-apa maksud lain walau apa pun jua, atau suatu rayuan yang berhubungan dengan permohonan itu, yang dibuat oleh seseorang kepada Menteri atau kepada Lembaga di bawah Akta Perkongsian Terhad Luar Pesisir Labuan 1997 sebelum tarikh kuat kuasa, dan belum selesai sebaik sebelum tarikh kuat kuasa, hendaklah, jika ada peruntukan yang bersamaan dalam Akta ni, diuruskan seolah-olah ia dibuat di bawah peruntukan itu dan, jika tiada peruntukan yang bersamaan dalam Akta ini, permohonan atau rayuan itu hendaklah luput pada tarikh kuat kuasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/23/msa@/~part_V__cl_91__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua transaksi atau urusan yang disempurnakan atau dimasuki dengan sah, dan semua perniagaan yang dibuat dengan sah, di bawah atau mengikut Akta Perkongsian Terhad Luar Pesisir Labuan 1997 oleh seseorang yang diluluskan atau didaftarkan di bawah Akta Perkongsian Terhad Luar Pesisir Labuan 1997, dengan mana-mana orang lain, hendaklah disifatkan sebagai telah disempurnakan, dimasuki, atau dilakukan, menurut undang-undang dan dengan sah, di bawah dan mengikut Akta ini, dan dengan itu, apa-apa hak atau liabiliti di bawah transaksi dan urusan itu, sebaik sebelum tarikh kuat kuasa, hendaklah disifatkan sebagai berterusan di sisi undang-undang dan sah di bawah Akta ini."
      }
    }
  ]
}
