        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/25/msa@/~part_VI__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/25/msa@/~part_VI__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/25/msa@/~part_VI__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/25/msa@/~part_VI__cl_19",
