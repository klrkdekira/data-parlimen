      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “capital expenditure”, by substituting for the full stop at the end of the definition a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_16__para_b",
