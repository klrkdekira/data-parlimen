      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: “(c) fails to furnish an estimate in accordance with subsection 49A(2) or (3), or paragraph 49A(4)(a),”. New section 82A"
      }
