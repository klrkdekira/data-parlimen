      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 9 of Schedule 7B to the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_16__para_a",
