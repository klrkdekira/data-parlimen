      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “capital expenditure” the following definition: ‘ “incurred” has the same meaning assigned to it in paragraphs 46 and 55 of Schedule 3.’."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "@type": "akn:clause",
