      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_14__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “27 per cent” appearing in the column “Rate of income tax”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Part XIII the following Part: “PART XIV 1. Notwithstanding Part I, income tax shall be charged on the income of an individual who is a resident and knowledge worker in respect of a qualified activity in a specified region at the rate of 15 per cent of his chargeable income. 2. In this Part, the knowledge worker, qualified activity and specified region referred to in paragraph 1 shall be as determined by the Minister by rules, made under this Act.”. Amendment of Schedule 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_15",
      "@type": "akn:clause",
