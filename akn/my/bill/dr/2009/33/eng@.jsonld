      "schema:text": {
        "@language": "en",
        "@value": "Section 55 of the principal Act is amended by deleting the words “, requisition” wherever appearing. New section 57A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~part_II__chp_V__cl_53",
