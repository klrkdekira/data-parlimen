        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Section 4, subparagraph 5(a)(i), sections 6, 7, 14, 15 and 16 have effect for the year of assessment 2010 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subparagraphs 5(a)(ii), (iii), (iv) and paragraph 5(b) have effect for the years of assessment 2010, 2011 and 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Section 8 has effect for the year ending 31 December 2009 and subsequent years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 9, 11, 12 and 13 come into operation on the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Section 10 has effect for the year of assessment 2011 and subsequent years of assessment. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Income Tax Act 1967, which is referred to as the “principal Act” in this Chapter, is amended in section 2 by inserting after subsection (8) the following subsection: “(9) Any reference in subsection 107C(4A), paragraph 2A of Schedule 1 and paragraph 19A of Schedule 3 to a company which has a paid-up capital in respect of ordinary shares of two million five hundred thousand ringgit and less at the beginning of the basis period for a year of assessment shall exclude a company which is established for the issuance of asset-backed securities in a securitization transaction approved by the Securities Commission.”. Amendment of section 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 46 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)— “(m) an amount limited to a maximum of five hundred ringgit in respect of expenses expended or deemed expended under subsection (3) in that basis year by that individual for the payment of monthly bill for broadband subscription under that individual’s name as evidenced by receipts issued in respect of such bill.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the word “eight” the word “nine”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (k), by deleting the word “and” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (l), by substituting for the full stop at the end of the paragraph the words “; and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (l) the following paragraph:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the words “and (l)” the words “, (l) and (m)”. Amendment of section 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended by substituting for subsection (1A) the following subsection: “(1A) For the purposes of subsection (1)— (a) where the aggregate amount of deduction allowed under that subsection in respect of payments, other than payment of premium for any deferred annuity contracted by an individual on or after 1 January 2010, or contributions or both, is six thousand ringgit or less, there shall be allowed a further deduction on any payment of premium for such deferred annuity: Provided that the total of that aggregate amount of deduction and that further deduction shall not exceed seven thousand ringgit; and (b) where subsection 50(2) or 50(3) applies, the total deduction under that subsection shall not exceed six thousand ringgit or where paragraph (a) applies, shall not exceed seven thousand ringgit.”. Amendment of section 60I"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 60I(4) of the principal Act is amended in the definition of “special purpose vehicle” by inserting after the words “Companies Act 1965” the words “or a company incorporated under the Offshore Companies Act 1990 which has made an election under section 3A of the Labuan Offshore Business Activity Tax Act 1990”. Amendment of section 83"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 83 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) Every employer shall, for each year, furnish to the Director General a return in the prescribed form not later than 31 March in the year immediately following the first-mentioned year containing— (a) the number of employees employed in the first- mentioned year; (b) the number of employees subject to deductions under the Income Tax (Deduction From Remuneration) Rules 1994 [P.U. (A) 507/1994] for the first-mentioned year; (c) the number of new employees employed in the first-mentioned year; (d) the number of employees who have resigned in the first-mentioned year; (e) the number of employees who have resigned and left Malaysia in the first-mentioned year; and (f) such other particulars as may be required by the Director General.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1A) For the purpose of subsection (1), every employer shall, for each year, prepare and render to his employee a statement of remuneration of that employee on or before the last day of February in the year immediately following the first-mentioned year containing the following information: (a) the relevant particulars of the employee; (b) the full amount of the gross income falling within section 13 paid, payable or provided by or on behalf of the employer to that employee in respect of the employment; (c) pension, annuity or periodical payment falling under paragraph (4)(e); (d) total deductions under the Income Tax (Deduction From Remuneration) Rules 1994 paid to the Director General in the first-mentioned year; (e) the compulsory contributions made by the employees to the Pension Fund or Employees’ Provident Fund, or any approved fund pursuant to section 150; (f) details relating to the payment of arrears and others for the years prior to the first-mentioned year; (g) tax exempt allowances, perquisites, gifts and benefits for the first-mentioned year; and (h) such other particulars as may be required by the Director General.”. Amendment of section 107"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 107(4) of the principal Act is amended by inserting after the words “failed to deduct” the words “, and such amount of tax shall be a debt due from that employer to the Government and shall be payable forthwith to the Director General”. Amendment of section 107C"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_IV",
      "@type": "akn:chapter",
      "eli:number": "IV",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Finance (No. 2) Act 2009. Amendment of Acts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_I",
      "schema:text": {
        "@language": "en",
        "@value": "The Income Tax Act 1967 [Act 53], the Stamp Act 1949 [Act 378], the Petroleum (Income Tax) Act 1967 [Act 543], the Real Property Gains Tax Act 1976 [Act 169] and the Labuan Offshore Business Activity Tax Act 1990 [Act 445] are amended in the manner specified in Chapters II, III, IV, V and VI respectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
