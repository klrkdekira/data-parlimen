      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph 35(b), by inserting after the word “debentures” the words “or Islamic Securities”. Amendment of Schedule 7B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_II__cl_16__para_a",
