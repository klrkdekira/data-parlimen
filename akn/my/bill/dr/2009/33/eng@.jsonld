        "@value": "AMENDMENTS TO THE INCOME TAX ACT 1967 Commencement of amendments to the Income Tax Act 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_III",
      "@type": "akn:chapter",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/33/eng@/~chp_III__cl_18",
