        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_103",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_104",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_105",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_106",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_107",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_108",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VIII__cl_109"
      ],
