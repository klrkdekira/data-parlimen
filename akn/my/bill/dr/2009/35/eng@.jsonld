      "schema:text": {
        "@language": "en",
        "@value": "EXEMPTION Exemption"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be exempted from the provisions of this Act personal data processed by an individual only for the purposes of that individual’s personal, family or household affairs, including recreational purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 46, personal data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "processed for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the prevention or detection of crime or for the purpose of investigations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the apprehension or prosecution of offenders; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the assessment or collection of any tax or duty or any other imposition of a similar nature, shall be exempted from the General Principle, Notice and Choice Principle, Disclosure Principle and Access Principle and other related provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "processed in relation to information of the physical or mental health of a data subject shall be exempted from the Access Principle and other related provisions of this Act of which the application of the provisions to the data subject would be likely to cause serious harm to the physical or mental health of the data subject or any other individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "processed for preparing statistics or carrying out research shall be exempted from the General Principle, Notice and Choice Principle, Disclosure Principle and Access Principle and other related provisions of this Act, provided that such personal data is not processed for any other purpose and that the resulting statistics or the results of the research are not made available in a form which identifies the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that is necessary for the purpose of or in connection with any order or judgement of a court shall be exempted from the General Principle, Notice and Choice Principle, Disclosure Principle and Access Principle and other related provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "processed for the purpose of discharging regulatory functions shall be exempted from the General Principle, Notice and Choice Principle, Disclosure Principle and Access Principle and other related provisions of this Act if the application of those provisions to the personal data would be likely to prejudice the proper discharge of those functions; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "processed only for journalistic, literary or artistic purposes shall be exempted from the General Principle, Notice and Choice Principle, Disclosure Principle, Retention Principle, Data Integrity Principle and Access Principle and other related provisions of this Act, provided that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "the processing is undertaken with a view to the publication by any person of the journalistic, literary or artistic material;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "the data user reasonably believes that, taking into account the special importance of public interest in freedom of expression, the publication would be in the public interest; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "the data user reasonably believes that in all the circumstances, compliance with the provision in respect of which the exemption is claimed is incompatible with the journalistic, literary or artistic purposes. Power to make further exemptions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon the recommendation of the Commissioner, by order published in the Gazette exempt—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the application of any of the Personal Data Protection Principles under this Act to any data user or class of data users; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any data user or class of data users from all or any of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may impose any terms or conditions as he thinks fit in respect of any exemption made under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_III__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time, on the recommendation of the Commissioner, by order published in the Gazette, revoke any order made under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The personal data processed for any purpose shall not be kept longer than is necessary for the fulfilment of that purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of a data user to take all reasonable steps to ensure that all personal data is destroyed or permanently deleted if it is no longer required for the purpose for which it was to be processed. Data Integrity Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall take reasonable steps to ensure that the personal data is accurate, complete, not misleading and kept up-to-date by having regard to the purpose, including any directly related purpose, for which the personal data was collected and further processed. Access Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A data subject shall be given access to his personal data held by a data user and be able to correct that personal data where the personal data is inaccurate, incomplete, misleading or not up-to-date, except where compliance with a request to such access or correction is refused under this Act. Division 2 Registration Application of this Division"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "This Division shall apply to a data user who belongs to a class of data users as specified in the order made under subsection 14(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who belongs to a class of data users not specified in the order made under subsection 14(1) shall comply with all the provisions of this Act other than the provisions of this Division relating to the registration of data users and matters connected thereto. Registration of data users"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon the recommendation of the Commissioner, by order published in the Gazette specify a class of data users who shall be required to be registered as data users under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall, before making his recommendation under subsection (1), consult with—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such bodies representative of data users belonging to that class; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such other interested persons. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A person who belongs to the class of data users as specified in the order made under subsection 14(1) shall submit an application for registration to the Commissioner in the manner and form as determined by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Every application for registration shall be accompanied with the prescribed registration fee and such documents as may be required by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may in writing at any time after receiving the application and before it is determined, require the applicant to provide such additional documents or information within the time as specified by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "If the requirement under subsection (3) is not complied with, the application for registration shall be deemed to have been withdrawn by the applicant and shall not be further proceeded with by the Commissioner, but without prejudice to a fresh application being made by the applicant. Certificate of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "After having given due consideration to an application under subsection 15(1), the Commissioner may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "register the applicant and issue a certificate of registration to the applicant in such form as determined by the Commissioner; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "refuse the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The certificate of registration may be issued subject to such conditions or restrictions as the Commissioner may think fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commissioner refuses the application for registration in pursuance of subsection (1), he shall inform the applicant by a written notice that the application has been refused and the reasons for the refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A person who belongs to the class of data users as specified in the order made under subsection 14(1) and who processes personal data without a certificate of registration issued in pursuance of paragraph 16(1)(a) commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Renewal of certificate of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A data user may make an application for the renewal of the certificate of registration not later than ninety days before the date of expiry of the certificate of registration in the manner and form as determined by the Commissioner and the application shall be accompanied with the prescribed renewal fee and such documents as may be required by the Commissioner, but no application for renewal shall be allowed where the application is made after the date of expiry of the certificate of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "When renewing a certificate of registration, the Commissioner may vary the conditions or restrictions imposed upon the issuance of the certificate of registration or impose additional conditions or restrictions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may refuse to renew a certificate of registration—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the data user has failed to comply with any of the provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the data user has failed to comply with any conditions or restrictions imposed upon the issuance of the certificate of registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if he is satisfied that the data user is unable to continue the processing of personal data in accordance with this Act. Revocation of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may revoke the registration of a data user if the Commissioner is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has failed to comply with any of the provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has failed to comply with any conditions or restrictions imposed upon the issuance of the certificate of registration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the issuance of the certificate of registration was induced by a false representation of fact by the data user; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has ceased to carry on the processing of personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Commissioner shall not revoke the registration of a data user unless the Commissioner is satisfied that, after giving the data user an opportunity of making any representation in writing he may wish to make, the registration should be revoked."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where the registration of the data user is revoked, the Commissioner shall issue a notice of revocation of registration to the data user, and the certificate of registration issued in respect of such registration shall have no effect upon service of the notice of revocation of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A data user whose registration has been revoked under this section and who continues to process personal data thereafter commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Surrender of certificate of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where the certificate of registration is revoked in pursuance of section 18, the holder of the certificate shall, within seven days from the date of service of the notice of revocation of registration, surrender the certificate to the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Register of Data Users"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall maintain a Register of Data Users in accordance with section 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Register of Data Users shall contain the names of data users who have been registered in pursuance of this Division and any other particulars regarding such data users as may be determined by the Commissioner. Division 3 Data user forum and code of practice Data user forum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may designate a body as a data user forum in respect of a specific class of data users for the purposes of this Act by notifying that body in writing, if the Commissioner is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the membership of the body is open to all data users of that class;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the body is capable of performing as required under the relevant provisions of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the body has a written constitution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The body shall agree in writing to be a data user forum before the designation is registered by the Commissioner in the Register of Data User Forums."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may decide that an existing body that was previously designated as a data user forum under subsection (1) is no longer a data user forum for the purposes of this Act, if he is satisfied that the body no longer meets the requirements as set out in that subsection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commissioner decides that an existing body which has been designated as a data user forum is no longer a data user forum for the purposes of this Act, he shall withdraw the designation and subsequently cancel the registration of the designation in the Register of Data User Forums."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A designation or withdrawal of designation under this section shall take effect from the date of registration of the designation or the date of cancellation of the registration of the designation, as the case may be, or such later date as specified by the Commissioner. Register of Data User Forums"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall maintain a Register of Data User Forums in accordance with section 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Register of Data User Forums shall contain the names of data user forums which have been designated and registered in pursuance of this Division and any other particulars regarding such data user forums as may be determined by the Commissioner. Code of practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "A data user forum may prepare a code of practice—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on its own initiative; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon request by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The data user forum shall, in preparing a code of practice under subsection (1), consider matters including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the purpose for the processing of personal data by the data user or class of data users;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the views of the data subjects or groups representing data subjects;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the views of the relevant regulatory authority, if any, to which the data user is subject to; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the code of practice, upon having regard to all of the matters in paragraphs (a), (b) and (c) and any other matters, offers an adequate level of protection for the personal data of the data subjects concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may register the code of practice prepared pursuant to subsection (1), if the Commissioner is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the code of practice is consistent with the provisions of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the matters as set out in subsection (2) have been given due consideration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The code of practice under subsection (1) shall take effect on the date of registration of the code of practice by the Commissioner in the Register of Codes of Practice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "If the Commissioner refuses to register the code of practice, the Commissioner shall notify the relevant data user forum of his decision in writing and provide the reasons for it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "If the Commissioner neither registers nor refuses to register a code of practice within thirty days from the date of receipt of the code of practice by him for registration, he shall be deemed to have refused the registration of the code of practice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may register different codes of practice for different classes of data users."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner and data user shall make available to the public any code of practice registered under subsection (3). Commissioner may issue code of practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may issue a code of practice, if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a code of practice is not prepared under paragraph 23(1)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner is satisfied that a code of practice for a specific class of data users is unlikely to be prepared by the relevant data user forum within the period as specified by the Commissioner; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is no data user forum to develop the relevant code of practice for the class of data users."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall, before issuing a code of practice under subsection (1), consider matters including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the purpose for the processing of personal data by the data user or class of data users;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the views of the data users or groups representing data users, to which the code of practice is applicable;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the views of the data subjects or groups representing data subjects;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the views of the relevant regulatory authority, if any, to which the data user is subject to; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the code of practice, upon having regard to all of the matters in paragraphs (a), (b) and (c) and any other matters, offers an adequate level of protection for the personal data of the data subjects concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may issue different codes of practice for different classes of data users."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The code of practice issued by the Commissioner under subsection (1) shall be registered in the Register of Codes of Practice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The code of practice under subsection (1) shall take effect on the date of registration of the code of practice by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall make available to the public any code of practice issued by him under subsection (1). Applicable code of practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall ensure that there is only one code of practice registered for a class of data users at a given time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "All data users belonging to a class of data users shall comply with the relevant registered code of practice that is applicable to that class of data users at a given time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where a code of practice is registered by the Commissioner under section 23 or 24, the Commissioner shall notify, in such manner as he may determine, the relevant class of data users to whom the code of practice is applicable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "of the identity of the code of practice concerned and the date on which the code of practice is to take effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "of the specific requirements under this Act for which the code of practice is issued and registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If there is any uncertainty or ambiguity as to which code of practice is applicable to a particular data user or class of data users, the data user or person concerned may apply to the Commissioner for his opinion on which code of practice is the applicable code of practice in relation to the circumstances of such data user or person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall provide his opinion within thirty days from the date of receipt of an application made under subsection (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall, when making his opinion under subsection (5), take into account any relevant previous opinions, if any."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may withdraw an opinion made under this section if the Commissioner is satisfied that the nature of the activity engaged by the data user has changed materially. Revocation, etc., of code of practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may revoke, amend or revise, whether in whole or in part, any code of practice registered under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on his own accord; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon an application by the data user forum or such bodies representing the data users."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall, before revoking, amending or revising a code of practice under subsection (1), consult with—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such data users or bodies representative of data users to which the code of practice shall apply, whether in whole or in part; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such other interested persons, as the Commissioner thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where any code of practice has been revoked, amended or revised under subsection (1), the Commissioner—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall enter the particulars of such revocation, amendment or revision in the Register of Codes of Practice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall notify the relevant data user forum, class of data users, data users and the public of such revocation, amendment or revision in such manner as may be determined by him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall make available to the public any code of practice as amended or revised by him under this Submission of new code of practice by data user forum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A data user forum may submit a new code of practice to replace an existing code of practice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The new code of practice submitted in pursuance of subsection (1) shall be subject to the provisions of this Division. Register of Codes of Practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall maintain a Register of Codes of Practice in accordance with section 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Register of Codes of Practice shall contain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "particulars of codes of practice registered under section 23 or 24 and any revocation, amendment or revision to such codes of practice under section 26; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any opinion made by the Commissioner under section 25, including particulars of withdrawal of previous opinions. Non-compliance with code of practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who fails to comply with any provision of the code of practice that is applicable to the data user commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Division 4 Rights of data subject Right of access to personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An individual is entitled to be informed by a data user whether personal data of which that individual is the data subject is being processed by or on behalf of the data user."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A requestor may, upon payment of a prescribed fee, make a data access request in writing to the data user—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for information of the data subject’s personal data that is being processed by or on behalf of the data user; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to have communicated to him a copy of the personal data in an intelligible form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A data access request for any information under subsection (2) shall be treated as a single request, and a data access request for information under paragraph (2)(a) shall, in the absence of any indication to the contrary, be treated as extending also to such request under paragraph (2)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a data user having separate entries in respect of personal data held for different purposes, a separate data access request shall be made for each separate entry."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user does not hold the personal data, but controls the processing of the personal data in such a way as to prohibit the data user who holds the personal data from complying, whether in whole or part, with the data access request under subsection (2) which relates to the personal data, the first- mentioned data user shall be deemed to hold the personal data and the provisions of this Act shall be construed accordingly. Compliance with data access request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2) and section 32, a data user shall comply with a data access request under section 30 not later than twenty-one days from the date of receipt of the data access request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who is unable to comply with a data access request within the period specified in subsection (1) shall before the expiration of that period—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by notice in writing inform the requestor that he is unable to comply with the data access request within such period and the reasons why he is unable to do so; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "comply with the data access request to the extent that he is able to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the data user shall comply in whole with the data access request not later than fourteen days after the expiration of the period stipulated in subsection (1). Circumstances where data user may refuse to comply with data access request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A data user may refuse to comply with a data access request under section 30 if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not supplied with such information as he may reasonably require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in order to satisfy himself as to the identity of the requestor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "where the requestor claims to be a relevant person, in order to satisfy himself—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "as to the identity of the data subject in relation to whom the requestor claims to be the relevant person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "that the requestor is the relevant person in relation to the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not supplied with such information as he may reasonably require to locate the personal data to which the data access request relates;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the burden or expense of providing access is disproportionate to the risks to the data subject’s privacy in relation to the personal data in the case in question;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user cannot comply with the data access request without disclosing personal data relating to another individual who can be identified from that information, unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "that other individual has consented to the disclosure of the information to the requestor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "it is reasonable in all the circumstances to comply with the data access request without the consent of the other individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (3), any other data user controls the processing of the personal data to which the data access request relates in such a way as to prohibit the first-mentioned data user from complying, whether in whole or in part, with the data access request;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "providing access would constitute a violation of an order of a court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "providing access would disclose confidential commercial information; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such access to personal data is regulated by another law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "In determining for the purposes of subparagraph (1)(d)(ii) whether it is reasonable in all the circumstances to comply with the data access request without the consent of the other individual, regard shall be had, in particular, to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any duty of confidentiality owed to the other individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any steps taken by the data user with a view to seeking the consent of the other individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whether the other individual is capable of giving consent; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any express refusal of consent by the other individual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(e) shall not operate so as to excuse the data user from complying with the data access request under subsection 30(2) to any extent that the data user can comply with the data access request without contravening the prohibition concerned. Notification of refusal to comply with data access request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user who pursuant to section 32 refuses to comply with a data access request under section 30, he shall, not later than twenty-one days from the date of receipt of the data access request, by notice in writing, inform the requestor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "of the refusal and the reasons for the refusal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "where paragraph 32(1)(e) is applicable, of the name and address of the other data user concerned. Right to correct personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a copy of the personal data has been supplied by the data user in compliance with the data access request under section 30 and the requestor considers that the personal data is inaccurate, incomplete, misleading or not up-to-date; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data subject knows that his personal data being held by the data user is inaccurate, incomplete, misleading or not up-to-date, the requestor or data subject, as the case may be, may make a data correction request in writing to the data user that the data user makes the necessary correction to the personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user does not hold the personal data, but controls the processing of the personal data in such a way as to prohibit the data user who holds the personal data from complying, whether in whole or in part, with the data correction request under subsection (1) which relates to the personal data, the first-mentioned data user shall be deemed to be the data user to whom such a request may be made and the provisions of this Act shall be construed accordingly. Compliance with data correction request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsections (2), (3) and (5) and section 36, where a data user is satisfied that the personal data to which a data correction request relates is inaccurate, incomplete, misleading or not up-to-date, he shall, not later than twenty-one days from the date of receipt of the data correction request—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make the necessary correction to the personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "supply the requestor with a copy of the personal data as corrected; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (4), where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the personal data has been disclosed to a third party during the twelve months immediately preceding the day on which the correction is made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has no reason to believe that the third party has ceased using the personal data for the purpose, including any directly related purpose, for which the personal data was disclosed to the third party, take all practicable steps to supply the third party with a copy of the personal data as so corrected accompanied by a notice in writing stating the reasons for the correction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who is unable to comply with a data correction request within the period specified in subsection (1) shall before the expiration of that period—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by notice in writing inform the requestor that he is unable to comply with the data correction request within such period and the reasons why he is unable to do so; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "comply with the data correction request to the extent that he is able to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the data user shall comply in whole with the data correction request not later than fourteen days after the expiration of the period stipulated in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A data user is not required to comply with paragraph (1)(c) in any case where the disclosure of the personal data to a third party consists of the third party’s own inspection of a register—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "in which the personal data is entered or otherwise recorded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "which is available for inspection by the public."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user is requested to correct personal data under subsection 34(1) and the personal data is being processed by another data user that is in a better position to respond to the data correction request—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the first-mentioned data user shall immediately transfer the data correction request to such data user, and notify the requestor of this fact; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_35__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "sections 34, 35, 36 and 37 shall apply as if the references therein to a data user were references to such other data user. Circumstances where data user may refuse to comply with data correction request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "A data user may refuse to comply with a data correction request under section 34 if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not supplied with such information as he may reasonably require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in order to satisfy himself as to the identity of the requestor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "where the requestor claims to be a relevant person, in order to satisfy himself—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "as to the identity of the data subject in relation to whom the requestor claims to be the relevant person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "that the requestor is the relevant person in relation to the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not supplied with such information as he may reasonably require to ascertain in what way the personal data to which the data correction request relates is inaccurate, incomplete, misleading or not up-to-date;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not satisfied that the personal data to which the data correction request relates is inaccurate, incomplete, misleading or not up-to-date;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data user is not satisfied that the correction which is the subject of the data correction request is accurate, complete, not misleading or up-to-date; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (2), any other data user controls the processing of the personal data to which the data correction request relates in such a way as to prohibit the first-mentioned data user from complying, whether in whole or in part, with the data correction request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(e) shall not operate so as to excuse the data user from complying with subsection 35(1) in relation to the data correction request to any extent that the data user can comply with that subsection without contravening the prohibition concerned. Notification of refusal to comply with data correction request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user who pursuant to section 36 refuses to comply with a data correction request under section 34, he shall, not later than twenty-one days from the date of receipt of the data correction request, by notice in writing, inform the requestor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the refusal and the reasons for the refusal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where paragraph 36(1)(e) is applicable, of the name and address of the other data user concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), where personal data to which the data correction request relates is an expression of opinion and the data user is not satisfied that the expression of opinion is inaccurate, incomplete, misleading or not up-to-date, the data user shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make a note, whether annexed to the personal data or elsewhere—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "of the matters in respect of which the expression of opinion is considered by the requestor to be inaccurate, incomplete, misleading or not up-to-date; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in such a way that the personal data cannot be used by any person without the note being drawn to the attention of and being available for inspection by that person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "attach a copy of the note to the notice referred to in subsection (1) which relates to the data correction request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “expression of opinion” includes an assertion of fact which is unverifiable or in all circumstances of the case is not practicable to verify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Withdrawal of consent to process personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "A data subject may by notice in writing withdraw his consent to the processing of personal data in respect of which he is the data subject."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The data user shall, upon receiving the notice under subsection (1), cease the processing of the personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The failure of the data subject to exercise the right conferred by subsection (1) does not affect any other rights conferred on him by this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Extent of disclosure of personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 8, personal data of a data subject may be disclosed by a data user for any purpose other than the purpose for which the personal data was to be disclosed at the time of its collection or any other purpose directly related to that purpose, only under the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "the data subject has given his consent to the disclosure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is necessary for the purpose of preventing or detecting a crime, or for the purpose of investigations; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "was required or authorized by or under any law or by the order of a court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "the data user acted in the reasonable belief that he had in law the right to disclose the personal data to the other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "the data user acted in the reasonable belief that he would have had the consent of the data subject if the data subject had known of the disclosing of the personal data and the circumstances of such disclosure; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure was justified as being in the public interest in circumstances as determined by the Minister. Processing of sensitive personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2) and section 5, a data user shall not process any sensitive personal data of a data subject except in accordance with the following conditions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the data subject has given his explicit consent to the processing of the personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_vii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_viii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ix",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_x"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the processing is necessary—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the purposes of exercising or performing any right or obligation which is conferred or imposed by law on the data user in connection with employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in order to protect the vital interests of the data subject or another person, in a case where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "consent cannot be given by or on behalf of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "the data user cannot reasonably be expected to obtain the consent of the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in order to protect the vital interests of another person, in a case where consent by or on behalf of the data subject has been unreasonably withheld;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for medical purposes and is undertaken by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "schema:text": {
        "@language": "en",
        "@value": "a healthcare professional; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "schema:text": {
        "@language": "en",
        "@value": "a person who in the circumstances owes a duty of confidentiality which is equivalent to that which would arise if that person were a healthcare professional;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_ix",
      "@type": "akn:subparagraph",
      "eli:number": "ix",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the exercise of any functions conferred on any person by or under any written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of, or in connection with, any legal proceedings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of obtaining legal advice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the purposes of establishing, exercising or defending legal rights;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_viii",
      "@type": "akn:subparagraph",
      "eli:number": "viii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the administration of justice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b__subpara_x",
      "@type": "akn:subparagraph",
      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for any other purposes as the Minister thinks fit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the information contained in the personal data has been made public as a result of steps deliberately taken by the data subject."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may by order published in the Gazette exclude the application of subparagraph (1)(b)(i), (viii) or (ix) in such cases as may be specified in the order, or provide that, in such cases as may be specified in the order, the condition in subparagraph (1)(b)(i), (viii) or (ix) is not to be regarded as satisfied unless such further conditions as may be specified in the order are also satisfied."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section— “medical purposes” includes the purposes of preventive medicine, medical diagnosis, medical research, rehabilitation and the provision of care and treatment and the management of healthcare services; “healthcare services” has the meaning assigned to it in the Private Healthcare Facilities and Services Act 1998 [Act 586]; “healthcare professional” means a medical practitioner, dental practitioner, pharmacist, clinical psychologist, nurse, midwife, medical assistant, physiotherapist, occupational therapist and other allied healthcare professionals and any other person involved in the giving of medical, health, dental, pharmaceutical and any other healthcare services under the jurisdiction of the Ministry of Health. Repeated collection of personal data in same circumstances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has complied with the provisions of the Notice and Choice Principle under section 7 in respect of the collection of personal data from the data subject, referred to as the “first collection”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on any subsequent occasion again collects personal data from that data subject, referred to as the “subsequent collection”, the data user is not required to comply with the provisions of the Notice and Choice Principle in respect of the subsequent collection if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to comply with those provisions in respect of that subsequent collection would be to repeat, in the same circumstances, what was done to comply with that principle in respect of the first collection; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "not more than twelve months have elapsed between the first collection and the subsequent collection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that subsection (1) shall not operate to prevent a subsequent collection from becoming a first collection if the data user concerned has complied with the provisions of the Notice and Choice Principle in respect of the subsequent collection. Right to prevent processing likely to cause damage or distress"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), a data subject may, at any time by notice in writing to a data user, referred to as the “data subject notice”, require the data user at the end of such period as is reasonable in the circumstances, to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "cease the processing of or processing for a specified purpose or in a specified manner; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not begin the processing of or processing for a specified purpose or in a specified manner, any personal data in respect of which he is the data subject if, based on reasons to be stated by him—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the processing of that personal data or the processing of personal data for that purpose or in that manner is causing or is likely to cause substantial damage or substantial distress to him or to another person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the damage or distress is or would be unwarranted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not apply where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the data subject has given his consent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the processing of personal data is necessary—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the performance of a contract to which the data subject is a party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the taking of steps at the request of the data subject with a view to entering a contract;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for compliance with any legal obligation to which the data user is the subject, other than an obligation imposed by contract; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in order to protect the vital interests of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in such other cases as may be prescribed by the Minister by order published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The data user shall, within twenty-one days from the date of receipt of the data subject notice under subsection (1), give the data subject a written notice—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "stating that he has complied or intends to comply with the data subject notice; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "stating his reasons for regarding the data subject notice as unjustified, or to any extent unjustified, and the extent, if any, to which he has complied or intends to comply with it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the data subject is dissatisfied with the failure of the data user to comply with the data subject notice, whether in whole or in part, under paragraph (3)(b), the data subject may submit an application to the Commissioner to require the data user to comply with the data subject notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commissioner is satisfied that the application of the data subject under subsection (4) is justified or justified to any extent, the Commissioner may require the data user to take such steps for complying with the data subject notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who fails to comply with the requirement of the Commissioner under subsection (5) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Right to prevent processing for purposes of direct marketing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A data subject may, at any time by notice in writing to a data user, require the data user at the end of such period as is reasonable in the circumstances to cease or not to begin processing his personal data for purposes of direct marketing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where the data subject is dissatisfied with the failure of the data user to comply with the notice, whether in whole or in part, under subsection (1), the data subject may submit an application to the Commissioner to require the data user to comply with the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commissioner is satisfied that the application of the data subject under subsection (2) is justified or justified to any extent, the Commissioner may require the data user to take such steps for complying with the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who fails to comply with the requirement of the Commissioner under subsection (3) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “direct marketing” means the communication by whatever means of any advertising or marketing material which is directed to particular individuals. Record to be kept by data user"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall keep and maintain a record of any application, notice, request or any other information relating to personal data that has been or is being processed by him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may determine the manner and form in which the record is to be maintained."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The processing of personal data by a data user shall be in compliance with the following Personal Data Protection Principles, namely—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the General Principle;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Notice and Choice Principle;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Disclosure Principle;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Security Principle;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Retention Principle;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Data Integrity Principle; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Access Principle, as set out in sections 6, 7, 8, 9, 10, 11 and 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to sections 45 and 46, a data user who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. General Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of personal data other than sensitive personal data, process personal data about a data subject unless the data subject has given his consent to the processing of the personal data; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of sensitive personal data, process sensitive personal data about a data subject except in accordance with the provisions of section 40."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (1)(a), a data user may process personal data about a data subject if the processing is necessary—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the performance of a contract to which the data subject is a party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the taking of steps at the request of the data subject with a view to entering into a contract;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for compliance with any legal obligation to which the data user is the subject, other than an obligation imposed by a contract;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in order to protect the vital interests of the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the administration of justice; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the exercise of any functions conferred on any person by or under any law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Personal data shall not be processed unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the personal data is processed for a lawful purpose directly related to an activity of the data user;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the processing of the personal data is necessary for or directly related to that purpose; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the personal data is adequate but not excessive in relation to that purpose. Notice and Choice Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall by written notice inform a data subject—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "that personal data of the data subject is being processed by or on behalf of the data user, and shall provide a description of the personal data to that data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the purposes for which the personal data is being or is to be collected and further processed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any information available to the data user as to the source of that personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the data subject’s right to request access to and to request correction of the personal data and how to contact the data user with any inquiries or complaints in respect of the personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the class of third parties to whom the data user discloses or may disclose the personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of the choices and means the data user offers the data subject for limiting the processing of personal data, including personal data relating to other persons who may be identified from that personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whether it is obligatory or voluntary for the data subject to supply the personal data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where it is obligatory for the data subject to supply the personal data, the consequences for the data subject if he fails to supply the personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The notice under subsection (1) shall be given as soon as practicable by the data user—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "when the data subject is first asked by the data user to provide his personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "when the data user first collects the personal data of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in any other case, before the data user—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "uses the personal data of the data subject for a purpose other than the purpose for which the personal data was collected; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "discloses the personal data to a third party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A notice under subsection (1) shall be in the national and English languages, and the individual shall be provided with a clear and readily accessible means to exercise his choice, where necessary, in the national and English languages. Disclosure Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 39, no personal data shall, without the consent of the data subject, be disclosed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "for any purpose other than—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the purpose for which the personal data was to be disclosed at the time of collection of the personal data; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a purpose directly related to the purpose referred to in subparagraph (i); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to any party other than a third party of the class of third parties as specified in paragraph 7(1)(e). Security Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall, when processing personal data, take practical steps to protect the personal data from any loss, misuse, modification, unauthorized or accidental access or disclosure, alteration or destruction by having regard—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to the nature of the personal data and the harm that would result from such loss, misuse, modification, unauthorized or accidental access or disclosure, alteration or destruction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to the place or location where the personal data is stored;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to any security measures incorporated into any equipment in which the personal data is stored;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to the measures taken for ensuring the reliability, integrity and competence of personnel having access to the personal data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to the measures taken for ensuring the secure transfer of the personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where processing of personal data is carried out by a data processor on behalf of the data user, the data user shall, for the purpose of protecting the personal data from any loss, misuse, modification, unauthorized or accidental access or disclosure, alteration or destruction, ensure that the data processor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provides sufficient guarantees in respect of the technical and organizational security measures governing the processing to be carried out; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "takes reasonable steps to ensure compliance with those measures. Retention Principle"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "APPOINTMENT, FUNCTIONS AND POWERS OF COMMISSIONER Appointment of Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint any person as the “Personal Data Protection Commissioner” for the purposes of carrying out the functions and powers assigned to the Commissioner under this Act on such terms and conditions as he thinks desirable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of the Commissioner shall be published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner appointed under subsection (1) shall be a body corporate having perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may sue and be sued in his corporate name. Functions of Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister on the national policy for personal data protection and all other related matters;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to implement and enforce the personal data protection laws, including the formulation of operational policies and procedures;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to promote and encourage associations or bodies representing data users to prepare codes of practice and to disseminate to their members the codes of practice for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to cooperate with bodies corporate or government agencies for the purpose of performing his functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to determine in pursuance of section 129 whether any place outside Malaysia has in place a system for the protection of personal data that is substantially similar to that as provided for under this Act or that serves the same purposes as this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake or cause to be undertaken research into and monitor developments in the processing of personal data, including technology, in order to take account any effects such developments may have on the privacy of individuals in relation to their personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor and supervise compliance with the provisions of this Act, including the issuance of circulars, enforcement notices or any other instruments to any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to promote awareness and dissemination of information to the public about the operation of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to liaise and cooperate with persons performing similar personal data protection functions in any place outside Malaysia in respect of matters of mutual interest, including matters concerning the privacy of individuals in relation to their personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to represent Malaysia through participation in events that relate to personal data protection as authorized by the Minister, whether within or outside Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out such activities and do such things as are necessary, advantageous and proper for the administration of this Act, or such other purposes consistent with this Act as may be directed by the Minister. Powers of Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall have all such powers to do all things necessary or expedient for or in connection with the performance of his functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the powers of the Commissioner shall include the power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to collect such fees as may be prescribed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint such agents, experts, consultants or any other persons as he thinks fit to assist him in the performance of his functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate human resource development and cooperation programmes for the proper and effective performance of his functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to acquire, purchase, take, hold and enjoy any movable or immovable property of every description for the performance of his functions, and to convey, assign, surrender, yield up, charge, mortgage, demise, transfer or otherwise dispose of, or deal with such property or any interest therein vested in him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to perform such other functions as the Minister may assign from time to time; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to do all such things as may be incidental to or consequential upon the performance of his functions. Appointment of Deputy Commissioners and Assistant Commissioners"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may, with the approval of the Minister, from time to time, appoint such number of public officers as Deputy Commissioners and such number of persons as Assistant Commissioners as are necessary to assist the Commissioner in the performance of his functions and the exercise of his powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Commissioners and Assistant Commissioners appointed under subsection (1) shall hold office for such periods, receive such remuneration, allowances or benefits, and shall be subject to such terms and conditions of service as the Commissioner, with the approval of the Minister, may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Commissioners and Assistant Commissioners appointed under subsection (1) shall be subject to the supervision, direction and control of the Commissioner. Appointment of other officers and servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may employ on such terms and conditions as he thinks desirable such officers and servants as may be necessary to assist him in the performance of his functions and the exercise of his powers under this Act. Loans and advances to officers and servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may grant loans and advances to the officers and servants under section 51 for such purposes and on such terms and conditions as the Commissioner may determine. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such conditions as may be specified in his instrument of appointment, the Commissioner shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for a term not exceeding three years and may be eligible for reappointment. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of the Commissioner and shall state the reason for such revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may at any time resign his office by giving a written notice addressed to the Minister fourteen days prior to the intended date of resignation. Temporary exercise of functions and powers of Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may temporarily appoint a Deputy Commissioner to perform the functions and powers of the Commissioner for the period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner is by reason of illness, leave of absence or any other cause unable to perform his functions for any substantial period; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Commissioner is vacant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "A person appointed under subsection (1) shall, during the period in which he is performing the functions and exercising the powers of the Commissioner under this section, be deemed to be the Commissioner. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The office of the Commissioner shall be vacated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a Commissioner or otherwise, has been such as to bring discredit on the office of the Commissioner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if his appointment is revoked by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "if his resignation is accepted by the Minister. Remuneration and allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall be paid such remuneration and allowances as the Minister may determine after consultation with the Minister of Finance. Delegation of Commissioner’s functions and powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may, subject to such conditions, limitations or restrictions as he may think fit to impose, delegate any of his functions or powers imposed or conferred upon him under this Act, except his power of delegation, to the Deputy Commissioners or Assistant Commissioners, and any function or power so delegated may be performed and exercised by the officer in the name and on behalf of the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The delegation under subsection (1) shall not preclude the Commissioner himself from performing or exercising at any time the delegated functions or powers. Direction by Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall be responsible to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give to the Commissioner directions of a general character consistent with the provisions of this Act relating to the performance of the functions and powers of the Commissioner and the Commissioner shall give effect to such directions. Returns, reports, accounts and information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall furnish to the Minister and any such public authority as may be directed by the Minister, the returns, reports, accounts and information with respect to his activities as the Minister may require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IV__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Commissioner shall, as soon as practicable after the end of each financial year, cause to be made and transmitted to the Minister and if so directed by the Minister to any other public authority, a report dealing with the activities of the Commissioner during the preceding financial year, and the report shall be in such form and shall contain such information relating to the proceedings and policies of the Commissioner as the Minister may specify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_110",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_114",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_116",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_119",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_126",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Authorized officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may in writing authorize any officer appointed under sections 50 and 51 or any public officer to exercise the powers of enforcement under this Act. Authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall issue to each authorized officer an authority card which shall be signed by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_111",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever the authorized officer exercises any of the powers of enforcement under this Act, he shall produce on demand to the person against whom the power is being exercised the authority card issued to him under subsection (1). Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may investigate the commission of any offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_112",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that for the purposes of this Act, the authorized officer shall have all or any of the special powers of a police officer of whatever rank in relation to police investigations in seizable cases as provided for under the Criminal Procedure Code [Act 593], and such powers shall be in addition to the powers provided for under this Act and not in derogation thereof. Search and seizure with warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath from the authorized officer and after such inquiry as the Magistrate considers necessary, that there is reasonable cause to believe that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any premises has been used for; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is in any premises evidence necessary to the conduct of an investigation into, the commission of an offence under this Act, the Magistrate may issue a warrant authorizing the authorized officer named in the warrant at any reasonable time by day or night and with or without assistance, to enter the premises and if need be by force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "Without affecting the generality of subsection (1), the warrant issued by the Magistrate may authorize the search and seizure of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any computer, book, account, computerized data or other document which contains or is reasonably suspected to contain information as to any offence suspected to have been committed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any signboard, card, letter, pamphlet, leaflet or notice representing or implying that the person is registered under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any equipment, instrument or article that is reasonably believed to furnish evidence of the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under subsection (1) may, for the purpose of investigating into the offence, search any person who is in or on the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making a search of a person under subsection (3) or section 114 may seize or take possession of, and place in safe custody all things other than the necessary clothing found upon the person, and any of those things which there is reason to believe were the instruments or other evidence of the offence may be detained until the discharge or acquittal of the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it is necessary to cause a woman to be searched, the search shall be made by another woman with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "If, by the reason of its nature, size or amount, it is not practicable to remove any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized under this section, the authorized officer shall by any means seal such computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article in the premises or container in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_113",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (6) or removes any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article under seal or attempts to do so commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding six months or to both. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "If an authorized officer is satisfied upon information received that he has reasonable cause to believe that by reason of delay in obtaining a search warrant under section 113 the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the authorized officer may enter the premises and exercise in, upon and in respect of the premises all the powers referred to in section 113 in as full and ample a manner as if he were authorized to do so by a warrant issued under that Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under sections 113 and 114 shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “access”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of computerized data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_115__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has the meaning assigned to it by subsections 2(2) and (5) of the Computer Crimes Act 1997 [Act 563]. Warrant admissible notwithstanding defects"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "A search warrant issued under this Act shall be valid and enforceable notwithstanding any defect, mistake or omission therein or in the application for such warrant, and any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized under such warrant shall be admissible in evidence in any proceedings under this Act. List of computer, book, account, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article is seized pursuant to this Act, the authorized officer making the seizure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall prepare—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a list of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized and shall sign the list; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a written notice of the seizure containing the grounds for the seizure and shall sign the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall as soon as practicable serve a copy of the list of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized and the written notice of the seizure to the occupier of the premises which have been searched, or to his agent or servant at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117",
      "schema:text": {
        "@language": "en",
        "@value": "The written notice of the seizure shall not be required to be served in pursuance of paragraph (1)(b) where the seizure is made in the presence of the person against whom proceedings under this Act are intended to be taken, or in the presence of the owner of such property or his agent, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_117",
      "schema:text": {
        "@language": "en",
        "@value": "If the premises are unoccupied, the authorized officer shall post a copy of the list of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized conspicuously on the premises. Release of computer, book, account, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118",
      "schema:text": {
        "@language": "en",
        "@value": "If any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article has been seized under this Act, the authorized officer who effected the seizure may, after referring to the Public Prosecutor, release the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article to the person as he determines to be lawfully entitled to it, if the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article is not liable to forfeiture under this Act, and is not otherwise required for the purpose of any proceedings under this Act or for the purpose of any prosecution under any other written law, and in such event neither the authorized officer effecting the seizure, nor the Federal Government, Commissioner or any person acting on behalf of the Federal Government or Commissioner shall be liable to any proceedings by any person if the seizure and the release of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article had been effected in good faith."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_118",
      "schema:text": {
        "@language": "en",
        "@value": "A record in writing shall be made by the authorized officer effecting the release of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article under subsection (1) specifying in detail the circumstances of and the reason for the release, and he shall send a copy of the record to the Public Prosecutor within seven days of the release. No cost or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Obstruction to search"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any authorized officer access to any premise which the authorized officer is entitled to have under this Act or in the execution of any duty imposed or power conferred by this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders or delays any authorized officer in effecting any entry which the authorized officer is entitled to effect under this Act, or in the execution of any duty imposed or power conferred by this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_120",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any authorized officer any information relating to an offence or suspected offence under this Act or any other information which may reasonably be required of him and which he has in his knowledge or power to give, commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding two years or to a fine not exceeding ten thousand ringgit or to both. Power to require production of computer, book, account, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall, for the purposes of the execution of this Act, have the power to do all or any of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of any computer, book, account, computerized data or other document kept by the data user or any other person and to inspect, examine and to download from them, make copies of them or take extracts from them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of any identification document from any person in relation to any act or offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_121",
      "schema:text": {
        "@language": "en",
        "@value": "to make such enquiries as may be necessary to ascertain whether the provisions of this Act have been complied with. Power to require attendance of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may by order in writing require the attendance before himself of any person who appears to the authorized officer to be acquainted with the facts and circumstances of the case, and such person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_122",
      "schema:text": {
        "@language": "en",
        "@value": "If any person refuses or fails to attend as so required, the authorized officer may report such refusal or failure to a Magistrate who shall issue a summons to secure the attendance of such person as may be required by the order made under subsection (1). Examination of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may examine orally any person supposed to be acquainted with the facts and circumstances of the case and shall reduce into writing any statement made by the person so examined."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "Such person shall be bound to answer all questions relating to the case put to him by the authorized officer: Provided that such person may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not such statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "The authorized officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_123",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by any person under this section shall, whenever possible, be taken down in writing and signed by the person making it or affixed with his thumb print, as the case may be, after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish. Admission of statements in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no statement made by any person to an authorized officer in the course of an investigation made under this Act shall be used in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "schema:text": {
        "@language": "en",
        "@value": "When any witness is called for the prosecution or for the defence, other than the accused, the court shall, on the request of the accused or the prosecutor, refer to any statement made by that witness to the authorized officer in the course of the investigation under this Act and may then, if the courts thinks fit in the interest of justice, direct the accused to be furnished with a copy of it and the statement may be used to impeach the credit of the witness in the manner provided by the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "schema:text": {
        "@language": "en",
        "@value": "Where the accused had made a statement during the course of an investigation, such statement may be admitted in evidence in support of his defence during the course of the trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to apply to any statement made in the course of an identification parade or falling within section 27 or paragraphs 32(1)(a), (i) and (j) of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with any offence in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the making; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_124__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the contents, of any statement made by him to an authorized officer in the course of an investigation made under this Act, that statement may be used as evidence in the prosecution’s case. Forfeiture of computer, book, account, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "Any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized shall be liable to forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "An order for the forfeiture of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized and liable to forfeiture under this Act shall be made by the court before which the prosecution with regard thereto has been held if it is proved to the satisfaction of the court that an offence under this Act has been committed and that the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized was the subject matter of or was used in the commission of the offence, notwithstanding that no person has been convicted of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "If there is no prosecution with regard to any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized under this Act, such computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article shall be taken and deemed to be forfeited at the expiration of a period of one calendar month from the date of service of a notice to the last-known address of the person from whom the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article was seized indicating that there is no prosecution in respect of such computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article, unless before the expiration of that period a claim thereto is made in the manner set out in subsections (4), (5) and (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "Any person asserting that he is the owner of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article referred to in subsection (3) and that it is not liable to forfeiture may, personally or by his agent authorized in writing, give written notice to the authorized officer in whose possession such computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article is held that he claims the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of the notice under subsection (4), the authorized officer shall refer the matter to a Magistrate for his decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate to whom the matter is referred under subsection (5) shall issue a summons requiring the person asserting that he is the owner of the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article and the person from whom it was seized to appear before the Magistrate, and upon their appearance or default to appear, due service of the summons having been proved, the Magistrate shall proceed to the examination of the matter and, on proof that an offence under this Act has been committed and that the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized was the subject matter of or was used in the commission of such offence, the Magistrate shall order the computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article to be forfeited, and shall, in the absence of such proof, order its release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_125",
      "schema:text": {
        "@language": "en",
        "@value": "Any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article forfeited or deemed to be forfeited shall be delivered to the Commissioner and shall be disposed of in such manner as the Commissioner thinks fit. Joinder of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in section 164 of the Criminal Procedure Code, where a person is accused of more than one offence under this Act, he may be charged with and tried at one trial for any number of such offences committed within the space of any length of time. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer or police officer may arrest without warrant any person whom he reasonably believes has committed or is attempting to commit an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_IX__cl_127",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an arrest under subsection (1) shall without unnecessary delay make over the person so arrested to the nearest police officer or, in the absence of a police officer, take such person to the nearest police station, and thereafter the person shall be dealt with as is provided for by the law relating to criminal procedure for the time being in force as if he had been arrested by a police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Personal Data Protection Act 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for different provisions of this Act. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who processes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who has control over or authorizes the processing of, any personal data in respect of commercial transactions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (1), this Act applies to a person in respect of personal data if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person is established in Malaysia and the personal data is processed, whether or not in the context of that establishment, by that person or any other person employed or engaged by that establishment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person is not established in Malaysia, but uses equipment in Malaysia for processing the personal data otherwise than for the purposes of transit through Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A person falling within paragraph (2)(b) shall nominate for the purposes of this Act a representative established in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsections (2) and (3), each of the following is to be treated as established in Malaysia:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an individual whose physical presence in Malaysia shall not be less than one hundred and eighty days in one calendar year;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a body incorporated under the Companies Act 1965 [Act 125];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "a partnership or other unincorporated association formed under any written laws in Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any person who does not fall within paragraph (a), (b) or (c) but maintains in Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "an office, branch or agency through which he carries on any activity; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_2__subsec_4__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "a regular practice. Non-application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to the Federal Government and State Governments."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to any personal data processed outside Malaysia unless that personal data is intended to be further processed in Malaysia. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“credit reporting agency” has the meaning assigned to it in the Credit Reporting Agencies Act 2009 [Act ]; “this Act” includes regulations, orders, notifications and other subsidiary legislation made under this Act; “register” means the Register of Data Users, Register of Data User Forums or Register of Codes of Practice; “personal data” means any information in respect of commercial transactions, which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "is being processed wholly or partly by means of equipment operating automatically in response to instructions given for that purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "is recorded with the intention that it should wholly or partly be processed by means of such equipment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "is recorded as part of a relevant filing system or with the intention that it should form part of a relevant filing system, that relates directly or indirectly to a data subject, who is identified or identifiable from that information or from that and other information in the possession of a data user, including any sensitive personal data and expression of opinion about the data subject; but does not include any information that is processed for the purpose of a credit reporting business carried on by a credit reporting agency under the Credit Reporting Agencies Act 2009; “sensitive personal data” means any personal data consisting of information as to the physical or mental health or condition of a data subject, his political opinions, his religious beliefs or other beliefs of a similar nature, the commission or alleged commission by him of any offence or any other personal data as the Minister may determine by order published in the Gazette; “prescribed” means prescribed by the Minister under this Act and where no mode is mentioned, means prescribed by order published in the Gazette; “Advisory Committee” means the Personal Data Protection Advisory Committee established under section 70; “vital interests” means matters relating to life, death or security of a data subject; “Fund” means the Personal Data Protection Fund established under section 61; “use”, in relation to personal data, does not include the act of collecting or disclosing such personal data; “collect”, in relation to personal data, means an act by which such personal data enters into or comes under the control of a data user; “Minister” means the Minister charged with the responsibility for the protection of personal data; “disclose”, in relation to personal data, means an act by which such personal data is made available by a data user; “relevant person”, in relation to a data subject, howsoever described, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a data subject who is below the age of eighteen years, the parent, guardian or person who has parental responsibility for the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a data subject who is incapable of managing his own affairs, a person who is appointed by a court to manage those affairs, or a person authorized in writing by the data subject to act on behalf of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in any other case, a person authorized in writing by the data subject to make a data access request, data correction request, or both such requests, on behalf of the data subject; “authorized officer” means any officer authorized in writing by the Commissioner under section 110; “correction”, in relation to personal data, includes amendment, variation, modification or deletion; “requestor”, in relation to a data access request or data correction request, means the data subject or the relevant person on behalf of the data subject, who has made the request; “data processor”, in relation to personal data, means any person, other than an employee of the data user, who processes the personal data solely on behalf of the data user, and does not process the personal data for any of his own purposes; “processing”, in relation to personal data, means collecting, recording, holding or storing the personal data or carrying out any operation or set of operations on the personal data, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "the organization, adaptation or alteration of personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "the retrieval, consultation or use of personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure of personal data by transmission, transfer, dissemination or otherwise making available; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "the alignment, combination, correction, erasure or destruction of personal data; “registration” means the registration of a data user under section 16; “data user” means a person who either alone or jointly or in common with other persons processes any personal data or has control over or authorizes the processing of any personal data, but does not include a data processor; “relevant data user”, in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
      "@type": "akn:list",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "an inspection, means the data user who uses the personal data system which is the subject of the inspection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "a complaint, means the data user specified in the complaint;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "an investigation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an investigation initiated by a complaint, means the data user specified in the complaint;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "in any other case, means the data user who is the subject of the investigation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "an enforcement notice, means the data user on whom the enforcement notice is served; “credit reporting business” has the meaning assigned to it in the Credit Reporting Agencies Act 2009; “Commissioner” means the Personal Data Protection Commissioner appointed under section 47; “third party”, in relation to personal data, means any person other than—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a relevant person in relation to a data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a data user;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a data processor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_I__cl_4__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "a person authorized in writing by the data user to process the personal data under the direct control of the data user; “relevant filing system” means any set of information relating to individuals to the extent that, although the information is not processed by means of equipment operating automatically in response to instructions given for that purpose, the set of information is structured, either by reference to individuals or by reference to criteria relating to individuals, in such a way that specific information relating to a particular individual is readily accessible; “data subject” means an individual who is the subject of the personal data; “appointed date” means the relevant date or dates, as the case may be, on which this Act comes into operation; “code of practice” means the personal data protection code of practice in respect of a specific class of data users registered by the Commissioner pursuant to section 23 or issued by the Commissioner under section 24; “commercial transactions” means any transaction of a commercial nature, whether contractual or not, which includes any matters relating to the supply or exchange of goods or services, agency, investments, financing, banking and insurance, but does not include a credit reporting business carried out by a credit reporting agency under the Credit Reporting Agencies Act 2009."
      }
    },
    {
