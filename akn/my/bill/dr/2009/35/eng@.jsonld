      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Appeal Tribunal shall disclose, as soon as practicable, to the Chairman any interest, whether substantial or not, which might conflict with the member’s duties as a member of the Appeal Tribunal in a particular matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is of the opinion that the member’s interest is in conflict with his duties as a member of the Appeal Tribunal, the Chairman shall inform all the parties to the matter of the conflict."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "If none of the parties to the matter objects to the conflict, the member may continue to execute his duties as a member of the Appeal Tribunal in relation to that matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "If a party to the matter objects to the conflict, the member of the Appeal Tribunal shall not continue to execute his duties as a member of the Appeal Tribunal in relation to that matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "The failure by the member to disclose his interest under subsection (1) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "invalidate the decision of the Appeal Tribunal, unless all parties agree to be bound by the decision; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_92__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "subject the member to the revocation of his appointment under section 88. Appeal to Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved by the decision of the Commissioner under this Act relating to matters, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registration of a data user under Division 2 of Part II;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the refusal of the Commissioner to register a code of practice under subsection 23(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the failure of the data user to comply with a data access request or data correction request under Division 4 of Part II;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the issuance of an enforcement notice under section 108;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the refusal of the Commissioner to vary or revoke an enforcement notice under section 109; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the refusal of the Commissioner to carry out or continue an investigation initiated by a complaint under Part VIII, may appeal to the Appeal Tribunal by filing a notice of appeal with the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of appeal shall be made in writing to the Appeal Tribunal within thirty days from the date of the decision of the Commissioner, or in the case of an enforcement notice, within thirty days after the enforcement notice is served upon the relevant data user, and the appellant shall serve a copy of the notice of appeal upon the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of appeal shall state briefly the substance of the decision of the Commissioner against which an appeal is filed with the Appeal Tribunal, contain an address at which any notice or document connected with the appeal may be served upon the appellant or his advocate, and shall be signed by the appellant or his advocate. Record of decision of Commissioner"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "The aggrieved person referred to in subsection 93(1) may, on his own initiative, request in writing from the Commissioner a statement of the grounds for his decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), the Commissioner shall, upon receiving the written request under subsection (1), provide to the aggrieved person, upon the payment of a prescribed fee, a copy of a statement of the grounds for his decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "Where a notice of appeal has been filed with the Appeal Tribunal under subsection 93(1), the Commissioner shall, if he has not already written the grounds for his decision in respect of the matter stated in the notice under subsection 93(1), record in writing the grounds for his decision, and the written grounds shall form part of the record of proceedings before the Appeal Tribunal. Stay of decision pending appeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the Commissioner shall be valid, binding and enforceable pending the decision of an appeal by the Appeal Tribunal, except where an appeal against an enforcement notice has been made to the Appeal Tribunal in accordance with subsection 93(2), or a stay of the decision of the Commissioner has been applied for under subsection (2) and granted by the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_95",
      "schema:text": {
        "@language": "en",
        "@value": "An aggrieved person may apply in writing to the Appeal Tribunal for a stay of the decision of the Commissioner on or after the notice of appeal has been filed with the Appeal Tribunal. Composition of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "Every proceeding of the Appeal Tribunal shall be heard and disposed of by three members or such greater uneven number of members of the Appeal Tribunal as the Chairman may in any particular case determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_96",
      "schema:text": {
        "@language": "en",
        "@value": "In the absence of the Chairman, the senior member of the Appeal Tribunal shall preside. Sitting of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall sit on such dates and at such places as the Chairman may appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may cancel or postpone any sitting of the Appeal Tribunal or change the place of the sitting which has been appointed under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_97",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary to the Appeal Tribunal shall by written notice inform the parties to the appeal of any change to the date or place of any sitting of the Appeal Tribunal. Procedure of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal may regulate its own procedure. Decision of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Appeal Tribunal on any matter shall be decided on a majority of members of the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VII__cl_99",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the Appeal Tribunal shall be final and binding on the parties to the appeal. Enforcement of decision of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "There is established a Personal Data Protection Advisory Committee. Functions of Advisory Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Advisory Committee shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Commissioner on all matters relating to personal data protection, and the due administration and enforcement of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Commissioner on any matter referred by him to the Advisory Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall not be bound to act upon the advice of the Advisory Committee. Members of Advisory Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee shall consist of the following members to be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "three members from the public sector; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_72",
      "schema:text": {
        "@language": "en",
        "@value": "at least seven but not more than eleven other members. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed under section 72 shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for such period not exceeding three years as the Minister may determine at the time of his appointment, and shall be eligible for reappointment; but no member shall hold office for more than two consecutive terms. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of any member of the Advisory Committee and shall state the reason for such revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Advisory Committee appointed under section 72 may at any time resign from his office by giving a written notice addressed to the Minister fourteen days prior to the intended date of resignation. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may temporarily appoint any member of the Advisory Committee to act as the Chairman for the period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman is by reason of illness, leave of absence or any other cause unable to perform his functions for any substantial period; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chairman is vacant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed under subsection (1) shall, during the period in which he is performing the functions of the Chairman under this section, be deemed to be the Chairman. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Advisory Committee shall be vacated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if his conduct, whether in connection with his duties as a member of the Advisory Committee or otherwise, has been such as to bring discredit on the Advisory Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if he becomes bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of the Chairman, if he absents himself from a meeting of the Advisory Committee without leave in writing of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a member of the Advisory Committee other than the Chairman, if he absents himself from three consecutive meetings of the Advisory Committee without leave in writing of the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if his appointment is revoked by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "if his resignation is accepted by the Minister. Allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and all other members of the Advisory Committee may be paid such allowances as the Minister may determine after consultation with the Minister of Finance. Time and place of meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee is to hold as many meetings as are necessary for the efficient performance of its functions and such meetings are to be held at such places and times as the Chairman may decide, provided that the Chairman shall not allow more than two months to lapse between meetings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall call for a meeting if requested to do so in writing by the Minister or by at least four members of the Advisory Committee. Advisory Committee may invite others to attend meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee may invite any person to attend any meeting or deliberation of the Advisory Committee for the purpose of assisting it on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subsection (1) shall be paid such allowances as may be determined by the Commissioner. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "Minutes made of meetings of the Advisory Committee shall, if duly signed, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Advisory Committee in respect of the proceedings of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act. Procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee may regulate its own procedure. Members to devote time to business of Advisory Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Advisory Committee shall devote such time to the business of the Advisory Committee as is necessary to discharge their duties effectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, a fund to be known as the “Personal Data Protection Fund” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be controlled, maintained and operated by the Commissioner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided by Parliament for the purposes of this Act from time to time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "fees, costs and any other charges imposed by or payable to the Commissioner under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all monies derived from the sale, disposal, lease, hire or any other dealings with the movable or immovable property vested in or acquired by the Commissioner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all monies as may be paid to the Commissioner from time to time for loans given by the Commissioner; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all other monies or property which may in any manner become payable to or vested in the Commissioner in respect of any matter incidental to his functions and powers. Expenditure to be charged on Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund may be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Commissioner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenses incurred for organizing campaigns, research, studies and publication of materials for the protection of personal data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "paying the remuneration, allowances, benefits and other expenses of the Commissioner, Deputy Commissioners, Assistant Commissioners, members of the Advisory Committee, members, officers and servants of the Appeal Tribunal and officers and servants of the Commissioner, including the granting of loans and advances, superannuation allowances, retirement benefits and gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, expenditure, fees and costs, including fees for the engagement of consultants, and legal fees and costs, properly incurred or accepted, or deemed fit by the Commissioner in the performance of his functions and the exercise of his powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment and materials, acquiring land and any assets, and carrying out any other works and undertakings in the performance of his functions and the exercise of his powers; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act. Conservation of Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Commissioner to conserve the Fund by so performing his functions and exercising his powers under this Act as to secure that the total revenues of the Commissioner are sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest on capital, taking one year with another. Reserve fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall establish and maintain a reserve fund within the Fund. Financial year"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The financial year of the Commissioner shall begin on 1 January and end on 31 December of each year. Limitation on contracts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall not, without the approval of the Minister and the concurrence of the Minister of Finance, enter into any contract under which the Commissioner is to pay or receive an amount exceeding two million ringgit. Bank accounts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall open and maintain an account or accounts with such financial institution or financial institutions in Malaysia as the Commissioner, after consulting with the Minister, thinks fit; and every such account shall be operated upon as far as practicable by cheques signed by such persons as may be authorized by the Minister. Accounts and audit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall cause proper accounts to be kept and maintained in respect of the Fund and in compliance with the provisions of the Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240]. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Commissioner up to such amount as may be authorized by the Minister for any one year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Before 1 June of each year, the Commissioner shall submit to the Minister an estimate of the expenditure for the following year in such form and containing such particulars as the Minister may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, before 1 January of the following year, notify the Commissioner of the amount authorized for expenditure generally or of the amounts authorized for each description of expenditure based on the estimate prepared under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_V__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may at any time submit to the Minister a supplementary estimate of its expenditure for any one year and the Minister may allow the whole or any part of the additional expenditure to be included in the supplementary estimate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_135",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_137",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_138",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_142",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI",
      "@type": "akn:part",
      "eli:number": "XI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_145",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SAVINGS AND TRANSITIONAL PROVISIONS Personal data processed before the date of coming into operation of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_145",
      "@type": "akn:clause",
      "eli:number": "145",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Where a data user has collected personal data from the data subject or any third party before the date of coming into operation of this Act, he shall comply with the provisions of this Act within three months from the date of coming into operation of this Act. Registration of persons who process personal data before the date of coming into operation of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146",
      "@type": "akn:clause",
      "eli:number": "146",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), any person who at the date of coming into operation of this Act either alone or jointly or in common with other persons processes any personal data or has control over or authorizes the processing of any personal data, shall within three months from the date of coming into operation of this Act be registered as a data user in accordance with the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_XI__cl_146",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not apply to a data user who does not belong to the class of data users who shall be required to be registered as data users in pursuance of the provisions of Division 2 of Part II."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner shall maintain in both physical and electronic forms a register as required under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "A person may on payment of the prescribed fee—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inspect the register; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make a copy of or take extracts from an entry in the register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_128",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person requests that a copy of an entry in the register be provided in an electronic form, the Commissioner may provide the relevant information by way of electronic means. Transfer of personal data to places outside Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "A data user shall not transfer any personal data of a data subject to a place outside Malaysia unless to such place as specified by the Minister, upon the recommendation of the Commissioner, by notification published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), the Minister may specify any place outside Malaysia if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "there is in that place in force any law which is substantially similar to this Act, or that serves the same purposes as this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that place ensures an adequate level of protection in relation to the processing of personal data which is at least equivalent to the level of protection afforded by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), a data user may transfer any personal data to a place outside Malaysia if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the data subject has given his consent to the transfer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is necessary for the performance of a contract between the data subject and the data user;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is necessary for the conclusion or performance of a contract between the data user and a third party which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "is entered into at the request of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "is in the interests of the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is for the purpose of any legal proceedings or for the purpose of obtaining legal advice or for establishing, exercising or defending legal rights;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has reasonable grounds for believing that in all circumstances of the case—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is for the avoidance or mitigation of adverse action against the data subject;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "it is not practicable to obtain the consent in writing of the data subject to that transfer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "if it was practicable to obtain such consent, the data subject would have given his consent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the data user has taken all reasonable precautions and exercised all due diligence to ensure that the personal data will not in that place be processed in any manner which, if that place is Malaysia, would be a contravention of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is necessary in order to protect the vital interests of the data subject; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the transfer is necessary as being in the public interest in circumstances as determined by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commissioner has reasonable grounds for believing that in a place as specified under subsection (1) there is no longer in force any law which is substantially similar to this Act, or that serves the same purposes as this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner shall make such recommendations to the Minister who shall, either by cancelling or amending the notification made under subsection (1), cause that place to cease to be a place to which personal data may be transferred under this section; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the data user shall cease to transfer any personal data of a data subject to such place with effect from the time as specified by the Minister in the notification."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "A data user who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_129",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “adverse action”, in relation to a data subject, means any action that may adversely affect the data subject’s rights, benefits, privileges, obligations or interests. Unlawful collecting, etc., of personal data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "A person shall not knowingly or recklessly, without the consent of the data user—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "collect or disclose personal data that is held by the data user; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "procure the disclosure to another person of personal data that is held by the data user."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not apply to a person who shows—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the collecting or disclosing of personal data or procuring the disclosure of personal data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "was necessary for the purpose of preventing or detecting a crime or for the purpose of investigations; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "was required or authorized by or under any law or by the order of a court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that he acted in the reasonable belief that he had in law the right to collect or disclose the personal data or to procure the disclosure of the personal data to the other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that he acted in the reasonable belief that he would have had the consent of the data user if the data user had known of the collecting or disclosing of personal data or procuring the disclosure of personal data and the circumstances of it; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the collecting or disclosing of personal data or procuring the disclosure of personal data was justified as being in the public interest in circumstances as determined by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "A person who collects or discloses personal data or procures the disclosure of personal data in contravention of subsection (1) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "A person who sells personal data commits an offenceif he has collected the personal data in contravention of subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "A person who offers to sell personal data commits an offence if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "he has collected the personal data in contravention of subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "he subsequently collects the personal data in contravention of subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (5), an advertisement indicating that personal data is or may be for sale is an offer to sell the personal data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_130",
      "schema:text": {
        "@language": "en",
        "@value": "A person who commits an offence under this section shall, upon conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Abetment and attempt punishable as offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "A person who abets the commission of or who attempts to commit any offence under this Act shall be guilty of that offence and shall, on conviction, be liable to the punishment provided for that offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_131",
      "schema:text": {
        "@language": "en",
        "@value": "A person who does any act preparatory to or in furtherance of the commission of any offence under this Act shall be guilty of that offence and shall, on conviction, be liable to the punishment provided for the offence: Provided that any term of imprisonment imposed shall not exceed one-half of the maximum term provided for the offence. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner may, with the consent in writing of the Public Prosecutor, compound any offence committed by any person under this Act and prescribed to be a compoundable offence by making a written offer to the person suspected to have committed the offence to compound the offence upon payment to the Commissioner of an amount of money not exceeding fifty per centum of the amount of maximum fine for that offence within such time as may be specified in his written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed but before any prosecution for it has been instituted, and if the amount specified in the offer is not paid within the time specified in the offer or such extended time as the Commissioner may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made, and any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article seized in connection with the offence may be released or forfeited by the Commissioner, subject to such terms and conditions as he thinks fit to impose in accordance with the conditions of the compound."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_132",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the Commissioner under this section shall be paid into the Federal Consolidated Fund. Offences by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133",
      "schema:text": {
        "@language": "en",
        "@value": "If a body corporate commits an offence under this Act, any person who at the time of the commission of the offence was a director, chief executive officer, chief operating officer, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the body corporate is found to have committed the offence, shall be deemed to have committed that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133",
      "schema:text": {
        "@language": "en",
        "@value": "If any person would be liable under this Act to any punishment or penalty for his act, omission, neglect or default, he shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his, or of the employee of the agent, if the act, omission, neglect or default was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the agent when acting on behalf of that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of the agent in the course of his employment by the agent or otherwise on behalf of the agent acting on behalf of that person. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor. Jurisdiction to try offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law to the contrary, a Sessions Court shall have jurisdiction to try any offence under this Act and to impose full punishment for any such offence under this Act. Service of notices or other documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136",
      "@type": "akn:clause",
      "eli:number": "136",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136",
      "schema:text": {
        "@language": "en",
        "@value": "Service of a notice or any other document upon any person shall be effected—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by the delivering the notice or other document to the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by leaving the notice or other document at the last-known address of residence or place of business of the person in a cover addressed to that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by forwarding the notice or other document by post in an A.R. registered letter addressed to the person at his last-known address of residence or place of business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_136",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person to whom there has been addressed an A.R. registered letter containing any notice or other document which may be given under this Act is informed of the fact that there is an A.R. registered letter awaiting him at a post office, and such person refuses or neglects to take delivery of such A.R. registered letter, such notice or other document shall be deemed to have been served upon him on the date on which he was so informed. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_137",
      "@type": "akn:clause",
      "eli:number": "137",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Commissioner, Deputy Commissioner, Assistant Commissioner, any officer or servant of the Commissioner, any member of the Advisory Committee, any member, officer or servant of the Appeal Tribunal, or any authorized officer in respect of any act, neglect or default done or omitted by him or it in such capacity. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_138",
      "@type": "akn:clause",
      "eli:number": "138",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The Commissioner, Deputy Commissioner, Assistant Commissioner, any officer or servant of the Commissioner, any member of the Advisory Committee, any member, officer or servant of the Appeal Tribunal, or any authorized officer while discharging his duty or performing his functions or exercising his powers under this Act in such capacity shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Protection against suit and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
      "@type": "akn:clause",
      "eli:number": "139",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner, Deputy Commissioner, Assistant Commissioner or any officer or servant of the Commissioner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Advisory Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "any member, officer or servant of the Appeal Tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_139",
      "schema:text": {
        "@language": "en",
        "@value": "any authorized officer, in respect of any act or omission done or omitted by him or it in good faith in such capacity. Protection of informers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140",
      "@type": "akn:clause",
      "eli:number": "140",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsections (2) and (3), no witness in any civil or criminal proceedings pursuant to this Act shall be obliged or permitted to disclose the name or address of any informer or the substance and nature of the information received from him or state any matter which might lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "If any computer, book, account, computerized data or other document, signboard, card, letter, pamphlet, leaflet, notice, equipment, instrument or article which is in evidence or is liable to inspection in any civil or criminal proceedings whatsoever contains any entry in which any informer is named or described or which might lead to his discovery, the court shall cause all such entries to be concealed from view or to be obliterated in so far as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_140",
      "schema:text": {
        "@language": "en",
        "@value": "If in a trial for any offence under this Act the court, after full inquiry into the case, is of the opinion that the informer wilfully made in his complaint a material statement which he knew or believed to be false or did not believe to be true, or if in any other proceedings the court is of the opinion that justice cannot be fully done between the parties in the proceeding without the discovery of the informer, the court may require the production of the original complaint, if in writing, and permit an inquiry and require full disclosure concerning the informer. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141",
      "@type": "akn:clause",
      "eli:number": "141",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law or where otherwise authorized by the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner, Deputy Commissioner, Assistant Commissioner, any officer or servant of the Commissioner, any member of the Advisory Committee, any member, officer or servant of the Appeal Tribunal, any authorized officer or any person attending any meeting or deliberation of the Advisory Committee, whether during or after his tenure of office or employment, shall not disclose any information obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has by any means access to any information or documents relating to the affairs of the Commissioner shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_141",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_142",
      "@type": "akn:clause",
      "eli:number": "142",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "All acts and things done by any person in preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto shall be deemed to have been authorized under this Act, provided that the acts and things done are consistent with the general intention and purposes of this Act; and all rights and obligations acquired or incurred as a result of the doing of those acts or things including any expenditure incurred in relation thereto, shall on the coming into operation of this Act be deemed to be the rights and obligations of the Commissioner. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143",
      "@type": "akn:clause",
      "eli:number": "143",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the powers conferred by subsection (1), the Minister may make regulations for all or any of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate all matters relating to the registration of data users under this Act, including to prescribe the registration fees and renewal fees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate all matters necessary for the implementation of the Personal Data Protection Principles;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate procedures in respect of the inspection of personal data systems, investigation of complaints and issuance of enforcement notices, and all other matters related to it;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the offences which may be compounded and the forms to be used and the method and procedure for compounding the offences;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide and prescribe for any fees payable in connection with the provision of any service or any matter under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any matter for which this Act makes express provision to be made by regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all other matters as are necessary or expedient to be prescribed for giving effect to this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_143",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section or any other subsidiary legislation made under this Act may prescribe for any act or omission in contravention of the regulations or other subsidiary legislation to be an offence and may prescribe for penalties of a fine not exceeding two hundred and fifty thousand ringgit or imprisonment for a term not exceeding two years or to both. Prevention of anomalies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144",
      "@type": "akn:clause",
      "eli:number": "144",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, make such modifications to the provisions of this Act as may appear to him to be necessary or expedient for the purpose of removing any difficulties or preventing anomalies in consequence of the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall not exercise the powers conferred by subsection (1) after the expiration of one year from the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/eng@/~part_X__cl_144",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “modifications” means amendments, additions, deletions and substitutions of any provisions of this Act."
      }
    }
  ]
}
