        "@language": "ms",
        "@value": "PENGECUALIAN Pengecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Data peribadi yang diproses oleh seseorang individu hanya bagi maksud hal-ehwal peribadi, keluarga atau rumah tangga individu itu, termasuk bagi maksud rekreasi, hendaklah dikecualikan daripada peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 46, data peribadi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diproses bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pencegahan atau pengesanan jenayah atau bagi maksud penyiasatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "penangkapan atau pendakwaan pesalah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pentaksiran atau pemungutan apa-apa cukai atau duti atau apa-apa pengenaan lain yang serupa jenisnya, hendaklah dikecualikan daripada Prinsip Am, Prinsip Notis dan Pilihan, Prinsip Penzahiran dan Prinsip Akses dan peruntukan lain Akta ini yang berkaitan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diproses berhubung dengan maklumat mengenai kesihatan fizikal atau mental seorang subjek data hendaklah dikecualikan daripada Prinsip Akses dan peruntukan lain Akta ini yang berkaitan yang pemakaian peruntukan itu kepada subjek data mungkin akan menyebabkan kemudaratan yang teruk kepada kesihatan fizikal atau mental subjek data itu atau mana-mana individu lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diproses bagi menyediakan statistik atau menjalankan penyelidikan hendaklah dikecualikan daripada Prinsip Am, Prinsip Notis dan Pilihan, Prinsip Penzahiran dan Prinsip Akses dan peruntukan lain Akta ini yang berkaitan, dengan syarat bahawa data peribadi itu tidak diproses bagi apa-apa maksud lain dan bahawa statistik yang terhasil atau dapatan penyelidikan itu tidak dijadikan tersedia dalam suatu bentuk yang mengenal pasti subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang perlu bagi maksud atau yang berkaitan dengan apa-apa perintah atau penghakiman suatu mahkamah hendaklah dikecualikan daripada Prinsip Am, Prinsip Notis dan Pilihan, Prinsip Penzahiran dan Prinsip Akses dan peruntukan lain Akta ini yang berkaitan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diproses bagi maksud menunaikan fungsi pengawalseliaan hendaklah dikecualikan daripada Prinsip Am, Prinsip Notis dan Pilihan, Prinsip Penzahiran dan Prinsip Akses dan peruntukan lain Akta ini yang berkaitan jika pemakaian peruntukan itu kepada data peribadi mungkin akan menjejaskan penunaian fungsi itu dengan sepatutnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diproses hanya bagi maksud kewartawanan, kesusasteraan atau kesenian hendaklah dikecualikan daripada Prinsip Am, Prinsip Notis dan Pilihan, Prinsip Penzahiran, Prinsip Penyimpanan, Prinsip Integriti Data dan Prinsip Akses dan peruntukan lain Akta ini yang berkaitan, dengan syarat bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "pemprosesan itu dijalankan dengan tujuan penyiaran bahan kewartawanan, kesusasteraan atau kesenian itu oleh mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data mempercayai dengan semunasabahnya bahawa, dengan mengambil kira betapa mustahaknya kepentingan awam dalam kebebasan bersuara, penyiaran itu berkepentingan awam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_45__subsec_2__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data mempercayai dengan semunasabahnya bahawa dalam segala hal keadaan itu, pematuhan peruntukan yang berkenaan dengannya pengecualian dituntut adalah tidak bersesuaian dengan maksud kewartawanan, kesusasteraan atau kesenian itu. Kuasa untuk membuat pengecualian tambahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Pesuruhjaya, melalui perintah yang disiarkan dalam Warta mengecualikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemakaian mana-mana Prinsip Perlindungan Data Peribadi di bawah Akta ini bagi mana-mana pengguna data atau golongan pengguna data; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengguna data atau golongan pengguna data daripada semua atau mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengenakan apa-apa terma atau syarat yang difikirkannya patut berkenaan dengan mana-mana pengecualian yang dibuat di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_III__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa, atas syor Pesuruhjaya, melalui perintah yang disiarkan dalam Warta, membatalkan mana- mana perintah yang dibuat di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Data peribadi yang diproses bagi apa-apa maksud tidak boleh disimpan lebih lama daripada yang diperlukan bagi memenuhi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan seorang pengguna data untuk mengambil segala langkah yang munasabah untuk memastikan bahawa segala data peribadi dimusnahkan atau dipadamkan secara kekal jika data peribadi itu tidak lagi dikehendaki bagi maksud yang baginya data peribadi itu hendak diproses. Prinsip Integriti Data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data hendaklah mengambil langkah yang munasabah untuk memastikan bahawa data peribadi adalah tepat, lengkap, tidak mengelirukan dan terkini dengan mengambil kira maksud, termasuk apa-apa maksud yang berhubungan secara langsung, yang baginya data peribadi itu dikumpulkan dan diproses selanjutnya. Prinsip Akses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang subjek data hendaklah diberi akses kepada data peribadinya yang dipegang oleh seorang pengguna data dan boleh membetulkan data peribadi itu jika data peribadi itu tidak tepat, tidak lengkap, mengelirukan atau tidak terkini, kecuali jika pematuhan dengan permintaan untuk akses atau pembetulan itu enggan diberikan di bawah Akta ini. Penggal 2 Pendaftaran Pemakaian Penggal ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Penggal ini hendaklah terpakai bagi seorang pengguna data yang berada dalam golongan pengguna data yang dinyatakan dalam perintah yang dibuat di bawah subseksyen 14(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengguna data yang berada dalam golongan pengguna data yang tidak dinyatakan dalam perintah yang dibuat di bawah subseksyen 14(1) hendaklah mematuhi semua peruntukan Akta ini selain peruntukan Penggal ini yang berhubungan dengan pendaftaran pengguna data dan perkara yang berkaitan dengannya. Pendaftaran pengguna data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Pesuruhjaya, melalui perintah yang disiarkan dalam Warta menyatakan golongan pengguna data yang dikehendaki untuk didaftarkan sebagai pengguna data di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, sebelum membuat syornya di bawah subseksyen (1), berunding dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana badan yang mewakili pengguna data yang berada dalam golongan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berkepentingan yang lain. Permohonan untuk pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang berada dalam golongan pengguna data yang dinyatakan dalam perintah yang dibuat di bawah subseksyen 14(1) hendaklah mengemukakan suatu permohonan untuk pendaftaran kepada Pesuruhjaya mengikut cara dan dalam bentuk yang ditentukan oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap permohonan untuk pendaftaran hendaklah disertai dengan fi pendaftaran yang ditetapkan dan apa-apa dokumen sebagaimana yang dikehendaki oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh secara bertulis pada bila-bila masa selepas menerima permohonan dan sebelum permohonan itu diputuskan, menghendaki pemohon untuk memberikan apa-apa dokumen atau maklumat tambahan dalam tempoh masa yang dinyatakan oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kehendak di bawah subseksyen (3) tidak dipatuhi, permohonan untuk pendaftaran hendaklah disifatkan telah ditarik balik oleh pemohon dan tidak boleh diteruskan oleh Pesuruhjaya, tetapi tanpa menjejaskan suatu permohonan baru dibuat oleh pemohon. Perakuan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas pertimbangan yang sewajarnya diberikan kepada suatu permohonan di bawah subseksyen 15(1), Pesuruhjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendaftarkan pemohon dan mengeluarkan suatu perakuan pendaftaran kepada pemohon itu dalam apa-apa bentuk yang ditentukan oleh Pesuruhjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran boleh dikeluarkan tertakluk kepada apa-apa syarat atau sekatan yang difikirkan wajar untuk dikenakan oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar menolak permohonan untuk pendaftaran menurut subseksyen (1), dia hendaklah memaklumkan pemohon melalui suatu notis bertulis bahawa permohonan itu ditolak dan sebab-sebab baginya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang berada dalam golongan pengguna data yang dinyatakan dalam perintah yang dibuat di bawah subseksyen 14(1) dan yang memproses data peribadi tanpa suatu perakuan pendaftaran yang dikeluarkan menurut perenggan 16(1)(a) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pembaharuan perakuan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data boleh membuat suatu permohonan bagi pembaharuan perakuan pendaftaran tidak lewat daripada sembilan puluh hari sebelum tarikh habis tempoh perakuan pendaftaran itu mengikut cara dan dalam bentuk yang ditentukan oleh Pesuruhjaya dan permohonan itu hendaklah disertai dengan fi pembaharuan yang ditetapkan dan apa-apa dokumen yang dikehendaki oleh Pesuruhjaya, tetapi tiada permohonan bagi pembaharuan boleh dibenarkan jika permohonan itu dibuat selepas tarikh habis tempoh perakuan pendaftaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila membaharui suatu perakuan pendaftaran, Pesuruhjaya boleh mengubah syarat atau sekatan yang dikenakan semasa perakuan pendaftaran itu dikeluarkan atau mengenakan syarat atau sekatan tambahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh enggan untuk membaharui suatu perakuan pendaftaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengguna data itu tidak mematuhi mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengguna data itu tidak mematuhi apa-apa syarat atau sekatan yang dikenakan semasa perakuan pendaftaran itu dikeluarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_17__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia berpuas hati bahawa pengguna data itu tidak boleh meneruskan pemprosesan data peribadi mengikut Akta ini. Pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh membatalkan pendaftaran seseorang pengguna data jika Pesuruhjaya berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak mematuhi mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak mematuhi apa-apa syarat atau sekatan yang dikenakan semasa perakuan pendaftaran itu dikeluarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengeluaran perakuan pendaftaran itu didorong oleh representasi fakta yang palsu oleh pengguna data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu telah berhenti menjalankan pemprosesan data peribadi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), Pesuruhjaya tidak boleh membatalkan pendaftaran seorang pengguna data melainkan jika Pesuruhjaya berpuas hati bahawa, selepas memberi pengguna data itu peluang untuk membuat apa-apa representasi bertulis yang dihasratinya untuk dibuat, pendaftaran itu patut dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pendaftaran pengguna data itu dibatalkan, Pesuruhjaya hendaklah mengeluarkan suatu notis pembatalan pendaftaran kepada pengguna data itu, dan perakuan pendaftaran yang dikeluarkan berkenaan dengan pendaftaran itu tidaklah mempunyai kuat kuasa apabila disampaikan notis pembatalan pendaftaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang pendaftarannya telah dibatalkan di bawah seksyen ini dan yang terus memproseskan data peribadi selepas itu melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Penyerahan perakuan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika perakuan pendaftaran dibatalkan menurut seksyen 18, pemegang perakuan itu hendaklah, dalam masa tujuh hari dari tarikh penyampaian notis pembatalan pendaftaran itu, menyerahkan perakuan itu kepada Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Daftar Pengguna Data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menyenggarakan suatu Daftar Pengguna Data mengikut seksyen 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar Pengguna Data itu hendaklah mengandungi nama pengguna data yang telah didaftarkan menurut Penggal ini dan apa-apa butir lain berkenaan dengan pengguna data itu sebagaimana yang ditentukan oleh Pesuruhjaya. Penggal 3 Forum pengguna data dan tataamalan Forum pengguna data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh menamakan sesuatu badan sebagai suatu forum pengguna data berkenaan dengan sesuatu golongan pengguna data yang khusus bagi maksud Akta ini dengan memberitahu badan itu secara bertulis, jika Pesuruhjaya berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "keanggotaan badan itu terbuka kepada semua pengguna data dalam golongan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "badan itu berupaya untuk melaksanakan sebagaimana yang dikehendaki di bawah peruntukan yang berkaitan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "badan itu mempunyai perlembagaan bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Badan itu hendaklah bersetuju secara bertulis untuk menjadi suatu forum pengguna data sebelum penamaan itu didaftarkan oleh Pesuruhjaya dalam Daftar Forum Pengguna Data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh memutuskan bahawa suatu badan yang sedia ada yang sebelum ini dinamakan sebagai suatu forum pengguna data di bawah subseksyen (1) tidak lagi menjadi forum pengguna data bagi maksud Akta ini, jika dia berpuas hati bahawa badan itu tidak lagi memenuhi kehendak yang dinyatakan dalam subseksyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya memutuskan bahawa suatu badan yang sedia ada yang telah dinamakan sebagai suatu forum pengguna data tidak lagi menjadi forum pengguna data bagi maksud Akta ini, dia hendaklah menarik balik penamaan itu dan kemudiannya membatalkan pendaftaran penamaan itu dalam Daftar Forum Pengguna Data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu penamaan atau penarikan balik penamaan di bawah seksyen ini hendaklah mula berkuat kuasa dari tarikh pendaftaran penamaan itu atau tarikh pembatalan pendaftaran penamaan itu, mengikut mana-mana yang berkenaan, atau apa-apa tarikh terkemudian yang dinyatakan oleh Pesuruhjaya. Daftar Forum Pengguna Data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menyenggarakan suatu Daftar Forum Pengguna Data mengikut seksyen 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar Forum Pengguna Data itu hendaklah mengandungi nama forum pengguna data yang telah dinamakan dan didaftarkan menurut Penggal ini dan apa-apa butir lain berkenaan dengan forum pengguna data itu sebagaimana yang ditentukan oleh Pesuruhjaya. Tataamalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu forum pengguna data boleh menyediakan suatu tataamalan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas inisiatifnya sendiri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas permintaan Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Forum pengguna data hendaklah, dalam menyediakan suatu tataamalan di bawah subseksyen (1), menimbangkan perkara termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maksud bagi pemprosesan data peribadi oleh pengguna data atau golongan pengguna data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan subjek data atau kumpulan yang mewakili subjek data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan pihak berkuasa kawal selia yang berkaitan, jika ada, yang kepadanya pengguna data itu tertakluk; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tataamalan itu, apabila mengambil kira semua perkara dalam perenggan (a), (b) dan (c) dan apa-apa perkara lain, memberikan suatu tahap perlindungan yang mencukupi bagi data peribadi subjek data yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh mendaftarkan tataamalan yang disediakan menurut subseksyen (1), jika Pesuruhjaya berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tataamalan itu adalah selaras dengan peruntukan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "perkara yang dinyatakan dalam subseksyen (2) telah diberi pertimbangan yang sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Tataamalan di bawah subseksyen (1) hendaklah mula berkuat kuasa pada tarikh pendaftaran tataamalan itu oleh Pesuruhjaya dalam Daftar Tataamalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya enggan mendaftarkan tataamalan itu, Pesuruhjaya hendaklah memberitahu forum pengguna data yang berkaitan mengenai keputusannya secara bertulis dan memberikan sebab-sebab bagi keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya tidak mendaftarkan dan tidak juga enggan mendaftarkan suatu tataamalan dalam tempoh tiga puluh hari dari tarikh penerimaan tataamalan itu olehnya untuk pendaftaran, Pesuruhjaya hendaklah disifatkan telah enggan mendaftarkan tataamalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh mendaftarkan tataamalan yang berlainan bagi golongan pengguna data yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya dan pengguna data hendaklah menjadikan tersedia bagi orang awam mana-mana tataamalan yang didaftarkan di bawah subseksyen (3). Pesuruhjaya boleh mengeluarkan tataamalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh mengeluarkan suatu tataamalan, jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu tataamalan tidak disediakan di bawah perenggan 23(1)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya berpuas hati bahawa suatu tataamalan bagi suatu golongan pengguna data yang khusus tidak mungkin akan disediakan oleh forum pengguna data yang berkaitan dalam tempoh yang ditentukan oleh Pesuruhjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak ada forum pengguna data untuk membangunkan tataamalan yang berkaitan bagi golongan pengguna data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, sebelum mengeluarkan suatu tataamalan di bawah subseksyen (1), menimbangkan perkara termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maksud bagi pemprosesan data peribadi oleh penguna data atau golongan pengguna data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan pengguna data atau kumpulan yang mewakili pengguna data, yang baginya tataamalan itu terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan subjek data atau kumpulan yang mewakili subjek data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan pihak berkuasa kawal selia yang berkaitan, jika ada, yang kepadanya pengguna data itu tertakluk; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tataamalan itu, apabila mengambil kira semua perkara dalam perenggan (a), (b) dan (c) dan apa-apa perkara lain, memberikan suatu tahap perlindungan yang mencukupi bagi data peribadi mengenai subjek data yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh mengeluarkan tataamalan yang berlainan bagi golongan pengguna data yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tataamalan yang dikeluarkan oleh Pesuruhjaya di bawah subseksyen (1) hendaklah didaftarkan dalam Daftar Tataamalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tataamalan di bawah subseksyen (1) hendaklah mula berkuat kuasa pada tarikh pendaftaran tataamalan itu oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menjadikan tersedia bagi orang awam mana-mana tataamalan yang dikeluarkan olehnya di bawah subseksyen (1). Tataamalan yang terpakai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah memastikan bahawa ada hanya satu tataamalan yang didaftarkan bagi suatu golongan pengguna data pada sesuatu masa tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua pengguna data yang tergolong dalam suatu golongan pengguna data hendaklah mematuhi tataamalan berdaftar yang berkaitan yang terpakai bagi golongan pengguna data itu pada sesuatu masa tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu tataamalan didaftarkan oleh Pesuruhjaya di bawah seksyen 23 atau 24, Pesuruhjaya hendaklah memberitahu, mengikut apa-apa cara yang ditentukan olehnya, golongan pengguna data yang berkaitan yang baginya tataamalan itu terpakai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai identiti tataamalan yang berkenaan dan tarikh yang tataamalan itu akan mula berkuat kuasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai kehendak khusus di bawah Akta ini yang baginya tataamalan itu dikeluarkan dan didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat apa-apa ketidakpastian atau ketaksaan tentang yang mana satu tataamalan yang terpakai bagi pengguna data atau golongan pengguna data tertentu, pengguna data itu atau orang yang berkenaan itu boleh memohon kepada Pesuruhjaya untuk mendapatkan pandangannya tentang tataamalan yang mana satu yang merupakan tataamalan yang terpakai berhubungan dengan hal keadaan pengguna data atau orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah memberikan pandangannya dalam tempoh tiga puluh hari dari tarikh penerimaan permohonan yang dibuat di bawah subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, apabila memberikan pandangannya di bawah subseksyen (5), mengambil kira mana-mana pandangan terdahulu yang berkaitan, jika ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh menarik balik suatu pandangan yang dibuat di bawah seksyen ini jika Pesuruhjaya berpuas hati bahawa sifat aktiviti yang dalamnya pengguna data itu terlibat telah berubah secara material. Pembatalan, dsb., tataamalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh membatalkan, meminda atau menyemak, sama ada keseluruhannya atau sebahagiannya, mana-mana tataamalan yang didaftarkan di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas kehendaknya sendiri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas suatu permohonan oleh forum pengguna data atau mana-mana badan yang mewakili pengguna data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, sebelum membatalkan, meminda atau menyemak suatu tataamalan di bawah subseksyen (1), berunding dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengguna data atau badan yang mewakili pengguna data yang baginya tataamalan itu hendaklah terpakai, sama ada keseluruhannya atau sebahagiannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berkepentingan yang lain, yang difikirkan patut oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana tataamalan telah dibatalkan, dipinda atau disemak di bawah subseksyen (1), Pesuruhjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memasukkan butir mengenai pembatalan, pindaan atau penyemakan itu dalam Daftar Tataamalan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memberitahu forum pengguna data yang berkaitan, golongan pengguna data, pengguna data dan orang awam mengenai pembatalan, pindaan atau penyemakan itu mengikut apa-apa cara yang ditentukan oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menjadikan tersedia bagi orang awam mana-mana tataamalan yang dipinda atau disemak olehnya di bawah seksyen ini. Pengemukaan tataamalan yang baru oleh forum pengguna data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu forum pengguna data boleh mengemukakan suatu tataamalan yang baru untuk menggantikan suatu tataamalan yang sedia ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Tataamalan yang baru yang dikemukakan menurut subseksyen (1) hendaklah tertakluk kepada peruntukan Penggal ini. Daftar Tataamalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menyenggarakan suatu Daftar Tataamalan mengikut seksyen 128."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar Tataamalan itu hendaklah mengandungi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "butir mengenai tataamalan yang didaftarkan di bawah seksyen 23 atau 24 dan apa-apa pembatalan, pindaan atau penyemakan kepada tataamalan itu di bawah seksyen 26; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_28__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pandangan yang dibuat oleh Pesuruhjaya di bawah seksyen 25, termasuk butir mengenai penarikan balik pandangan yang terdahulu. Ketidakpatuhan tataamalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang tidak mematuhi mana-mana peruntukan tataamalan yang terpakai bagi pengguna data itu melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Penggal 4 Hak subjek data Hak untuk mengakses data peribadi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang individu berhak untuk diberitahu oleh seorang pengguna data sama ada data peribadi yang mengenainya individu itu ialah subjek data sedang diproses oleh atau bagi pihak pengguna data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang peminta boleh, apabila dibayar fi yang ditetapkan, membuat suatu permintaan mengakses data secara bertulis kepada pengguna data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maklumat mengenai data peribadi subjek data yang sedang diproses oleh atau bagi pihak pengguna data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya disampaikan kepadanya suatu salinan data peribadi itu dalam bentuk yang dapat difahami."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permintaan mengakses data bagi apa-apa maklumat di bawah subseksyen (2) hendaklah dianggap sebagai suatu permintaan tunggal, dan suatu permintaan mengakses data bagi maklumat di bawah perenggan (2)(a) hendaklah, sekiranya tidak ada apa-apa arahan yang bertentangan, dianggap diperluas juga kepada permintaan di bawah perenggan (2)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal seorang pengguna data yang mempunyai entri yang berasingan berkenaan dengan data peribadi yang dipegang bagi maksud yang berlainan, suatu permintaan mengakses data yang berasingan hendaklah dibuat bagi setiap entri yang berasingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data tidak memegang data peribadi, tetapi mengawal pemprosesan data peribadi itu dengan apa-apa cara yang melarang pengguna data yang memegang data peribadi itu daripada mematuhi, sama ada keseluruhannya atau sebahagiannya, permintaan mengakses data di bawah subseksyen (2) yang berhubungan dengan data peribadi itu, pengguna data yang mula-mula disebut itu hendaklah disifatkan memegang data peribadi itu dan peruntukan Akta ini hendaklah ditafsirkan dengan sewajarnya. Pematuhan permintaan mengakses data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2) dan seksyen 32, seseorang pengguna data hendaklah mematuhi permintaan mengakses data di bawah seksyen 30 tidak lewat daripada dua puluh satu hari dari tarikh penerimaan permintaan mengakses data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang tidak dapat mematuhi permintaan mengakses data dalam tempoh yang dinyatakan dalam subseksyen (1) hendaklah sebelum habis tempoh itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui notis bertulis memaklumkan peminta itu bahawa dia tidak dapat mematuhi permintaan mengakses data itu dalam tempoh itu dan sebab-sebab dia tidak boleh berbuat demikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi permintaan mengakses data itu setakat yang dia boleh berbuat demikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), pengguna data hendaklah mematuhi permintaan mengakses data itu keseluruhannya tidak lewat daripada empat belas hari selepas habis tempoh yang dinyatakan dalam subseksyen (1). Hal keadaan yang pengguna data boleh enggan mematuhi permintaan mengakses data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data boleh enggan mematuhi permintaan mengakses data di bawah seksyen 30 jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak diberi apa-apa maklumat yang dikehendaki dengan munasabah olehnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memuaskan hatinya tentang identiti peminta itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peminta itu menuntut bahawa dia ialah seorang yang berkaitan, untuk memuaskan hatinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "tentang identiti subjek data yang berhubungan dengannya peminta itu menuntut bahawa dia ialah orang yang berkaitan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa peminta itu ialah orang yang berkaitan berhubungan dengan subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak diberi apa-apa maklumat sebagaimana yang dikehendaki dengan munasabah olehnya untuk mengesan data peribadi yang dengannya permintaan mengakses data itu adalah berhubungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "beban atau perbelanjaan untuk memberikan akses tidak setimpal dengan risiko kepada privasi subjek data itu berhubungan dengan data peribadi dalam hal yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data tidak dapat mematuhi permintaan mengakses data tanpa menzahirkan data peribadi yang berhubungan dengan individu lain yang dapat dikenal pasti daripada maklumat itu, melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "individu lain itu telah memberikan persetujuan terhadap penzahiran maklumat itu kepada peminta; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah munasabah dalam segala hal keadaan itu untuk mematuhi permintaan mengakses data itu tanpa persetujuan individu lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (3), mana-mana pengguna data lain mengawal pemprosesan data peribadi yang dengannya permintaan mengakses data itu adalah berhubungan dengan apa-apa cara yang melarang pengguna data yang mula-mula disebut itu daripada mematuhi, sama ada keseluruhannya atau sebahagiannya, dengan permintaan mengakses data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan akses akan menjadi pelanggaran suatu perintah mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan akses akan menzahirkan maklumat komersial yang sulit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa akses kepada data peribadi itu dikawal selia oleh undang-undang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menentukan bagi maksud subperenggan (1)(d)(ii), sama ada munasabah dalam segala hal keadaan itu untuk mematuhi permintaan mengakses data tanpa persetujuan individu lain itu, perhatian hendaklah diberikan, secara khususnya, kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kewajipan kerahsiaan kepada individu lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa langkah yang diambil oleh pengguna data dengan tujuan untuk mendapatkan persetujuan individu lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada individu lain itu berupaya memberikan persetujuan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa keengganan nyata untuk memberikan persetujuan oleh individu lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan (1)(e) tidak boleh berkuat kuasa sehingga membenarkan pengguna data untuk tidak mematuhi permintaan mengakses data di bawah subseksyen 30(2) ke apa-apa takat yang pengguna data itu dapat mematuhi permintaan mengakses data tanpa melanggar larangan yang berkenaan. Pemberitahuan mengenai keengganan mematuhi permintaan mengakses data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data yang menurut seksyen 32 enggan mematuhi permintaan mengakses data di bawah seksyen 30, dia hendaklah, tidak lewat daripada dua puluh satu hari dari tarikh penerimaan permintaan mengakses data itu, melalui notis bertulis, memaklumkan peminta itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai keengganan itu dan sebab-sebab bagi keengganan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "jika perenggan 32(1)(e) terpakai, mengenai nama dan alamat pengguna data lain yang berkenaan. Hak untuk membetulkan data peribadi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan data peribadi telah diberikan oleh pengguna data pada mematuhi permintaan mengakses data di bawah seksyen 30 dan peminta menganggap bahawa data peribadi itu tidak tepat, tidak lengkap, mengelirukan atau tidak terkini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subjek data itu mengetahui bahawa data peribadinya yang dipegang oleh pengguna data itu adalah tidak tepat, tidak lengkap, mengelirukan atau tidak terkini, peminta atau subjek data itu, mengikut mana-mana yang berkenaan, boleh membuat suatu permintaan pembetulan data secara bertulis kepada pengguna data supaya pengguna data itu membuat pembetulan yang perlu kepada data peribadi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang pengguna data tidak memegang data peribadi itu, tetapi mengawal pemprosesan data peribadi itu dalam apa- apa cara yang melarang pengguna data yang memegang data peribadi itu daripada mematuhi, sama ada keseluruhannya atau sebahagiannya, permintaan pembetulan data di bawah subseksyen (1) yang berhubungan dengan data peribadi itu, pengguna data yang mula-mula disebut itu hendaklah disifatkan pengguna data yang kepadanya permintaan sedemikian boleh dibuat dan peruntukan Akta ini hendaklah ditafsirkan dengan sewajarnya. Pematuhan permintaan pembetulan data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), (3) dan (5) dan seksyen 36, jika seseorang pengguna data berpuas hati bahawa data peribadi yang dengannya suatu permintaan pembetulan data adalah berhubungan adalah tidak tepat, tidak lengkap, mengelirukan atau tidak terkini, dia hendaklah, tidak lewat daripada dua puluh satu hari dari tarikh penerimaan permintaan pembetulan data itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat pembetulan yang perlu kepada data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi peminta suatu salinan data peribadi yang telah dibetulkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (4), jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "data peribadi itu telah dizahirkan kepada suatu pihak ketiga dalam masa dua belas bulan sebaik sebelum hari yang pembetulan itu dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak mempunyai apa-apa sebab untuk mempercayai bahawa pihak ketiga itu telah berhenti menggunakan data peribadi bagi maksud, termasuklah apa-apa maksud yang berkaitan secara langsung, yang baginya data peribadi itu telah dizahirkan kepada pihak ketiga itu, mengambil segala langkah praktikal untuk memberi pihak ketiga suatu salinan data peribadi yang telah dibetulkan sedemikian berserta dengan suatu notis bertulis yang menyatakan sebab-sebab bagi pembetulan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang tidak dapat mematuhi permintaan pembetulan data dalam tempoh yang dinyatakan dalam subseksyen (1) hendaklah sebelum habis tempoh itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui notis bertulis memaklumkan peminta bahawa dia tidak dapat mematuhi permintaan pembetulan data dalam tempoh itu dan sebab-sebab kenapa dia tidak dapat berbuat demikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi permintaan pembetulan data itu ke apa-apa takat yang dapat dibuat olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), pengguna data hendaklah mematuhi keseluruhan permintaan pembetulan data itu tidak lewat daripada empat belas hari selepas habis tempoh yang dinyatakan dalam subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data tidak dikehendaki untuk mematuhi perenggan (1)(c) dalam apa-apa hal jika penzahiran data peribadi kepada pihak ketiga terdiri daripada pemeriksaan sendiri daftar oleh pihak ketiga itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dalamnya data peribadi itu dimasukkan atau selainnya direkodkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tersedia untuk pemeriksaan oleh orang awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data diminta untuk membetulkan data peribadi di bawah subseksyen 34(1) dan data peribadi itu sedang diproses oleh pengguna data lain yang berada dalam kedudukan yang lebih baik untuk memberikan maklum balas kepada permintaan pembetulan data itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data yang mula-mula disebut itu hendaklah dengan serta-merta memindahkan permintaan pembetulan data itu kepada pengguna data itu, dan memberitahu peminta itu mengenai fakta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_35__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 34, 35, 36 dan 37 hendaklah terpakai seolah-olah sebutan dalamnya kepada seorang pengguna data ialah sebutan kepada pengguna data lain itu. Hal keadaan yang pengguna data boleh enggan mematuhi permintaan pembetulan data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data boleh enggan untuk mematuhi permintaan pembetulan data di bawah seksyen 34 jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak diberi apa-apa maklumat yang dikehendaki dengan munasabah olehnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memuaskan hatinya tentang identiti peminta itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peminta itu menuntut bahawa dia ialah seorang yang berkaitan, untuk memuaskan hatinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "tentang identiti subjek data yang berhubungan dengannya peminta itu menuntut bahawa dia ialah seorang yang berkaitan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_a__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa peminta itu ialah orang yang berkaitan berhubungan dengan subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak diberi apa-apa maklumat yang dikehendaki dengan munasabah olehnya untuk menentukan bagaimana data peribadi yang dengannya permintaan pembetulan data itu adalah berhubungan adalah tidak tepat, tidak lengkap, mengelirukan atau tidak terkini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak berpuas hati bahawa data peribadi yang dengannya permintaan pembetulan data itu adalah berhubungan adalah tidak tepat, tidak lengkap, mengelirukan atau tidak terkini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu tidak berpuas hati bahawa pembetulan yang menjadi subjek permintaan pembetulan data itu adalah tepat, lengkap, tidak mengelirukan atau terkini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (2), mana-mana pengguna data lain mengawal pemprosesan data peribadi yang dengannya permintaan pembetulan data itu adalah berhubungan dengan apa-apa cara yang melarang pengguna data yang mula-mula disebut itu daripada mematuhi, sama ada keseluruhannya atau sebahagiannya, permintaan pembetulan data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan (1)(e) tidak boleh berkuat kuasa sehingga membenarkan pengguna data untuk tidak mematuhi subseksyen 35(1) berhubungan dengan permintaan pembetulan data itu ke apa-apa takat yang pengguna data itu dapat mematuhi subseksyen itu tanpa melanggar larangan yang berkenaan. Pemberitahuan mengenai keengganan untuk mematuhi permintaan pembetulan data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data yang menurut seksyen 36 enggan untuk mematuhi permintaan pembetulan data di bawah seksyen 34, dia hendaklah, tidak lewat daripada dua puluh satu hari dari tarikh penerimaan permintaan pembetulan data itu, melalui notis bertulis, memaklumkan peminta itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai keengganan itu dan sebab-sebab bagi keengganan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika perenggan 36(1)(e) terpakai, mengenai nama dan alamat pengguna data lain yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), jika data peribadi yang dengannya permintaan pembetulan data itu adalah berhubungan merupakan suatu penyataan pendapat dan pengguna data itu tidak berpuas hati bahawa penyataan pendapat itu tidak tepat, tidak lengkap, mengelirukan atau tidak terkini, pengguna data itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu catatan, sama ada dilampirkan pada data peribadi itu atau di tempat lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai perkara yang berkenaan dengannya penyataan pendapat itu dianggap oleh peminta sebagai tidak tepat, tidak lengkap, mengelirukan atau tidak terkini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa cara supaya data peribadi itu tidak dapat digunakan oleh mana-mana orang tanpa catatan itu dibawa kepada perhatian dan tersedia untuk pemeriksaan oleh orang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melampirkan suatu salinan catatan itu pada notis yang disebut dalam subseksyen (1) yang berhubungan dengan permintaan pembetulan data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, “penyataan pendapat” termasuk suatu kenyataan fakta yang tidak dapat ditentusahkan atau dalam segala hal keadaan mengenai hal itu penentusahannya tidak dapat dilaksanakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Penarikan balik persetujuan untuk memproses data peribadi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang subjek data boleh melalui notis bertulis menarik balik persetujuannya terhadap pemprosesan data peribadi yang berkenaan dengannya dia merupakan subjek data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna data itu hendaklah, apabila diterima notis di bawah subseksyen (1), berhenti memproses data peribadi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Kegagalan subjek data untuk menjalankan hak yang diberikan oleh subseksyen (1) tidak menjejaskan mana-mana hak lain yang diberikan kepadanya oleh Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Takat penzahiran data peribadi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 8, data peribadi seseorang subjek data boleh dizahirkan oleh seorang pengguna data bagi apa-apa maksud selain maksud yang baginya data peribadi itu sepatutnya dizahirkan pada masa pengumpulannya atau apa-apa maksud lain yang berkaitan secara langsung dengan maksud itu, hanya di bawah hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "subjek data itu telah memberikan persetujuannya bagi penzahiran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "perlu bagi maksud mencegah atau mengesan suatu jenayah, atau bagi maksud penyiasatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dikehendaki atau dibenarkan oleh atau di bawah mana-mana undang-undang atau oleh perintah suatu mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data bertindak atas kepercayaan yang munasabah bahawa dia ada hak di sisi undang-undang untuk menzahirkan data peribadi itu kepada orang lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data bertindak atas kepercayaan yang munasabah bahawa dia akan mendapat persetujuan subjek data jika subjek data itu mengetahui tentang penzahiran data peribadi itu dan hal keadaan mengenai penzahiran itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu berjustifikasi oleh sebab ia berkepentingan awam dalam hal keadaan yang ditentukan oleh Menteri. Pemprosesan data peribadi sensitif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2) dan seksyen 5, seseorang pengguna data tidak boleh memproses apa-apa data peribadi sensitif seorang subjek data kecuali mengikut syarat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subjek data telah memberikan persetujuannya secara nyata bagi pemprosesan data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_vii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_viii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ix",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_x"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemprosesan itu perlu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud menjalankan atau melaksanakan apa-apa hak atau obligasi yang diberikan atau dikenakan oleh undang-undang terhadap pengguna data yang berkaitan dengan pengambilan kerja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melindungi kepentingan vital subjek data atau orang lain, dalam hal jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "persetujuan tidak dapat diberikan oleh atau bagi pihak subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data tidak boleh semunasabahnya dijangka untuk mendapat persetujuan subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melindungi kepentingan vital orang lain, dalam hal jika persetujuan oleh atau bagi pihak subjek data telah tidak diberikan dengan semunasabahnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud perubatan dan dilakukan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang profesional jagaan kesihatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang dalam hal keadaan itu mempunyai kewajipan kerahsiaan yang bersamaan dengan kewajipan kerahsiaan yang akan berbangkit jika orang itu merupakan seorang profesional jagaan kesihatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_ix",
      "@type": "akn:subparagraph",
      "eli:number": "ix",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menjalankan apa-apa fungsi yang diberikan kepada mana-mana orang oleh atau di bawah mana-mana undang-undang bertulis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud, atau yang berkaitan dengan, apa-apa prosiding undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud mendapatkan nasihat undang- undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud membuktikan, menjalankan atau mempertahankan hak di sisi undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_viii",
      "@type": "akn:subparagraph",
      "eli:number": "viii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pentadbiran keadilan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b__subpara_x",
      "@type": "akn:subparagraph",
      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa maksud lain yang difikirkan patut oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang terkandung dalam data peribadi itu telah diumumkan kepada orang awam akibat langkah yang diambil dengan sengaja oleh subjek data."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melalui perintah yang disiarkan dalam Warta mengecualikan pemakaian subperenggan (1)(b)(i), (viii) atau (ix) dalam mana-mana hal yang dinyatakan dalam perintah itu, atau memperuntukkan bahawa, dalam mana-mana hal yang dinyatakan dalam perintah itu, syarat dalam subperenggan (1)(b)(i), (viii) atau (ix) tidak boleh dianggap sebagai dipenuhi melainkan jika apa-apa syarat tambahan sebagaimana yang dinyatakan dalam perintah itu juga dipenuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini— “maksud perubatan” termasuk maksud perubatan pencegahan, diagnosis perubatan, penyelidikan perubatan, pemulihan dan penyediaan jagaan dan rawatan dan pengurusan perkhidmatan jagaan kesihatan; “perkhidmatan jagaan kesihatan” mempunyai erti yang diberikan kepadanya dalam Akta Kemudahan dan Perkhidmatan Jagaan Kesihatan Swasta 1998 [Akta 586]; “profesional jagaan kesihatan” ertinya pengamal perubatan, pengamal pergigian, ahli farmasi, ahli psikologi klinikal, jururawat, bidan, pembantu perubatan, ahli fisioterapi, ahli terapi pekerjaan dan profesional jagaan kesihatan berkaitan yang lain dan mana- mana orang lain yang terlibat dalam memberikan perkhidmatan perubatan, kesihatan, pergigian, farmaseutikal dan apa-apa perkhidmatan jagaan kesihatan lain yang di bawah bidang kuasa Kementerian Kesihatan. Pengumpulan data peribadi secara berulang dalam hal keadaan yang sama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mematuhi peruntukan Prinsip Notis dan Pilihan di bawah seksyen 7 berkenaan dengan pengumpulan data peribadi daripada subjek data, disebut “pengumpulan yang pertama”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pada bila-bila masa kemudiannya mengumpulkan sekali lagi data peribadi daripada subjek data itu, disebut “pengumpulan yang berikutnya”, pengguna data itu tidak dikehendaki untuk mematuhi peruntukan Prinsip Notis dan Pilihan berkenaan dengan pengumpulan yang berikutnya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mematuhi peruntukan itu berkenaan dengan pengumpulan yang berikutnya akan menyebabkan pengulangan, dalam hal keadaan yang sama, apa yang telah dilakukan untuk mematuhi prinsip itu berkenaan dengan pengumpulan yang pertama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada dua belas bulan telah berlalu antara pengumpulan yang pertama dengan pengumpulan yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, dengan ini diisytiharkan bahawa subseksyen (1) tidak boleh berkuat kuasa untuk menghalang pengumpulan yang berikutnya menjadi pengumpulan yang pertama jika pengguna data yang berkenaan telah mematuhi peruntukan Prinsip Notis dan Pilihan berkenaan dengan pengumpulan yang berikutnya. Hak untuk menghalang pemprosesan yang mungkin menyebabkan kerosakan atau distres"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), seorang subjek data boleh, pada bila-bila masa melalui notis bertulis kepada seorang pengguna data, disebut “notis subjek data”, menghendaki pengguna data pada penghujung apa-apa tempoh yang munasabah dalam hal keadaan itu, untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberhentikan pemprosesan atau pemprosesan bagi suatu maksud yang tertentu atau mengikut cara yang tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak memulakan pemprosesan atau pemprosesan bagi suatu maksud yang tertentu atau mengikut cara yang tertentu, apa-apa data peribadi yang berkenaan dengannya dia merupakan subjek data jika, berdasarkan sebab-sebab yang dinyatakan olehnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pemprosesan data peribadi itu atau pemprosesan data peribadi bagi maksud itu atau mengikut cara itu menyebabkan atau mungkin menyebabkan kerosakan yang substansial atau distres yang substansial kepadanya atau kepada orang lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kerosakan atau distres itu adalah atau akan menjadi tidak wajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak terpakai jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "subjek data itu telah memberikan persetujuannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemprosesan data peribadi itu perlu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi melaksanakan suatu kontrak yang mengenainya subjek data itu merupakan suatu pihak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mengambil langkah, atas permintaan subjek data, dengan tujuan untuk membuat suatu kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mematuhi apa-apa obligasi undang-undang yang mengenainya pengguna data itu merupakan subjek, selain suatu obligasi yang dikenakan oleh kontrak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melindungi kepentingan vital subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa hal lain yang ditetapkan oleh Menteri melalui perintah yang disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna data hendaklah, dalam tempoh dua puluh satu hari dari tarikh penerimaan notis subjek data di bawah subseksyen (1), memberi subjek data suatu notis bertulis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyatakan bahawa dia telah mematuhi atau berhasrat untuk mematuhi notis subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyatakan sebab-sebab dia menganggap notis subjek data itu sebagai tidak berjustifikasi, atau ke apa- apa takat tidak berjustifikasi, dan takat, jika ada, yang dia telah mematuhi atau berhasrat untuk mematuhinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika subjek data itu tidak berpuas hati oleh sebab pengguna data tidak mematuhi notis subjek data, sama ada keseluruhannya atau sebahagiannya, di bawah perenggan (3)(b), subjek data itu boleh mengemukakan suatu permohonan kepada Pesuruhjaya untuk menghendaki pengguna data itu mematuhi notis subjek data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya berpuas hati bahawa permohonan subjek data di bawah subseksyen (4) itu berjustifikasi atau berjustifikasi ke apa-apa takat, Pesuruhjaya boleh menghendaki pengguna data itu supaya mengambil apa-apa langkah bagi mematuhi notis subjek data itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang tidak mematuhi kehendak Pesuruhjaya di bawah subseksyen (5) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Hak untuk menghalang pemprosesan bagi maksud pemasaran langsung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang subjek data boleh, pada bila-bila masa melalui notis bertulis kepada pengguna data, menghendaki pengguna data itu pada penghujung apa-apa tempoh yang munasabah dalam hal keadaan itu untuk memberhentikan atau tidak memulakan pemprosesan data peribadinya bagi maksud pemasaran langsung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika subjek data itu tidak berpuas hati oleh sebab pengguna data tidak mematuhi notis itu, sama ada keseluruhannya atau sebahagiannya, di bawah subseksyen (1), subjek data itu boleh mengemukakan suatu permohonan kepada Pesuruhjaya untuk menghendaki pengguna data itu mematuhi notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya berpuas hati bahawa permohonan subjek data di bawah subseksyen (2) itu berjustifikasi atau berjustifikasi ke apa-apa takat, Pesuruhjaya boleh menghendaki pengguna data itu supaya mengambil apa-apa langkah bagi mematuhi notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang tidak mematuhi kehendak Pesuruhjaya di bawah subseksyen (3) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pemasaran langsung” ertinya berkomunikasi dengan apa cara sekali pun mengenai apa-apa bahan pengiklanan atau pemasaran yang ditujukan kepada individu tertentu. Rekod disimpan oleh pengguna data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data hendaklah menyimpan dan menyenggarakan suatu rekod mengenai apa-apa permohonan, notis, permintaan atau apa-apa maklumat lain yang berhubungan dengan data peribadi yang telah atau sedang diproses olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh menentukan cara dan bentuk yang mengikutnya rekod itu hendaklah disenggarakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemprosesan data peribadi oleh seseorang pengguna data hendaklah mematuhi Prinsip Perlindungan Data Peribadi yang berikut, iaitu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Am;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Notis dan Pilihan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Penzahiran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Keselamatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Penyimpanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Integriti Data; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prinsip Akses, sebagaimana yang dinyatakan dalam seksyen 6, 7, 8, 9, 10, 11 dan 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 45 dan 46, seseorang pengguna data yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Prinsip Am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal data peribadi selain data peribadi sensitif, memproses data peribadi mengenai seorang subjek data melainkan jika subjek data itu telah memberikan persetujuannya bagi pemprosesan data peribadi itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal data peribadi sensitif, memproses data peribadi sensitif mengenai seorang subjek data kecuali mengikut peruntukan seksyen 40."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (1)(a), seseorang pengguna data boleh memproses data peribadi mengenai seorang subjek data jika pemprosesan itu perlu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi melaksanakan sesuatu kontrak yang subjek data itu ialah suatu pihak kepadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mengambil langkah atas permintaan subjek data itu dengan tujuan untuk membuat sesuatu kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mematuhi apa-apa obligasi undang-undang yang pengguna data itu merupakan subjek baginya, selain suatu obligasi yang dikenakan oleh sesuatu kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi melindungi kepentingan vital subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mentadbirkan keadilan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menjalankan apa-apa fungsi yang diberikan kepada mana-mana orang oleh atau di bawah mana-mana undang- undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Data peribadi tidak boleh diproses melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "data peribadi itu diproses bagi maksud yang sah yang berhubungan secara langsung dengan aktiviti pengguna data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemprosesan data peribadi itu perlu bagi atau berhubungan secara langsung dengan maksud itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "data peribadi itu adalah mencukupi tetapi tidak berlebihan berhubung dengan maksud itu. Prinsip Notis dan Pilihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data hendaklah melalui notis bertulis memaklumkan seorang subjek data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa data peribadi subjek data itu sedang diproses oleh atau bagi pihak pengguna data itu, dan hendaklah memberikan perihalan data peribadi itu kepada subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maksud yang baginya data peribadi itu sedang atau akan dikumpulkan dan diproses selanjutnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat yang ada pada pengguna data itu tentang sumber data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hak subjek data itu untuk meminta akses kepada dan untuk meminta pembetulan terhadap data peribadi itu dan bagaimana untuk menghubungi pengguna data itu tentang apa-apa pertanyaan atau aduan berkenaan dengan data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "golongan pihak ketiga yang kepadanya pengguna data menzahirkan atau boleh menzahirkan data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pilihan dan cara yang ditawarkan oleh pengguna data itu kepada subjek data bagi mengehadkan pemprosesan data peribadi, termasuklah data peribadi yang berhubungan dengan orang lain yang boleh dikenal pasti daripada data peribadi itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada wajib atau sukarela bagi subjek data untuk memberikan data peribadi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika wajib bagi subjek data itu untuk memberikan data peribadi itu, akibat kepadanya jika dia tidak memberikan data peribadi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis di bawah subseksyen (1) hendaklah diberikan dengan secepat yang dapat dilaksanakan oleh pengguna data itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila subjek data itu pertama kalinya diminta oleh pengguna data itu untuk memberikan data peribadinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila pengguna data itu pertama kalinya mengumpul data peribadi subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal lain, sebelum pengguna data itu–"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan data peribadi subjek data itu bagi maksud selain maksud yang baginya data peribadi itu dikumpulkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menzahirkan data peribadi itu kepada pihak ketiga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu notis di bawah subseksyen (1) hendaklah dalam bahasa kebangsaan dan bahasa Inggeris, dan individu itu hendaklah diberi cara yang jelas dan mudah diakses untuk membuat pilihannya, jika perlu, dalam bahasa kebangsaan dan bahasa Inggeris. Prinsip Penzahiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 39, tiada data peribadi boleh, tanpa persetujuan subjek data, dizahirkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa maksud selain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "maksud yang baginya data peribadi itu hendak dizahirkan pada masa pengumpulan data peribadi itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu maksud yang berhubungan secara langsung dengan maksud yang disebut dalam subperenggan (i); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana pihak selain pihak ketiga daripada golongan pihak ketiga yang dinyatakan dalam perenggan 7(1)(e). Prinsip Keselamatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data hendaklah, apabila memproses data peribadi, mengambil langkah yang praktikal untuk melindungi data peribadi itu daripada apa-apa kehilangan, salah guna, ubah suaian, akses atau penzahiran tanpa kebenaran atau tidak sengaja, pengubahan atau pemusnahan dengan mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sifat data peribadi itu dan kemudaratan akibat daripada kehilangan, salah guna, ubah suaian, akses atau penzahiran tanpa kebenaran atau tidak sengaja, pengubahan atau pemusnahan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat atau lokasi di mana data peribadi itu disimpan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa langkah keselamatan yang digabungkan ke dalam apa-apa kelengkapan yang dalamnya data peribadi itu disimpan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "langkah yang diambil untuk memastikan kebolehpercayaan, integriti dan kewibawaan personel yang mempunyai akses kepada data peribadi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "langkah yang diambil bagi memastikan pemindahan selamat data peribadi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemprosesan data peribadi dijalankan oleh seorang pemproses data bagi pihak pengguna data, pengguna data itu hendaklah, bagi maksud melindungi data peribadi itu daripada apa-apa kehilangan, salah guna, ubah suaian, akses atau penzahiran tanpa kebenaran atau tidak sengaja, pengubahan atau pemusnahan, memastikan bahawa pemproses data itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan jaminan yang mencukupi berkenaan dengan langkah keselamatan teknikal dan organisasi yang mengawal pemprosesan yang akan dijalankan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil langkah yang munasabah bagi memastikan pematuhan langkah itu. Prinsip Penyimpanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELANTIKAN, FUNGSI DAN KUASA PESURUHJAYA Pelantikan Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik mana-mana orang sebagai “Pesuruhjaya Perlindungan Data Peribadi” bagi maksud menjalankan fungsi dan kuasa yang diberikan kepada Pesuruhjaya di bawah Akta ini atas apa-apa terma dan syarat yang difikirkannya wajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan Pesuruhjaya hendaklah disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya yang dilantik di bawah subseksyen (1) ialah suatu pertubuhan perbadanan yang kekal turun-temurun dan mempunyai suatu meterai perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh membawa guaman dan dibawa guaman terhadapnya atas nama perbadanannya. Fungsi Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "menasihati Menteri mengenai dasar kebangsaan bagi perlindungan data peribadi dan segala perkara lain yang berkaitan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan dan menguatkuasakan undang-undang perlindungan data peribadi, termasuklah perumusan dasar dan tatacara operasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "memajukan dan menggalakkan persatuan atau badan yang mewakili pengguna data untuk menyediakan tataamalan dan menyebarkan tataamalan itu kepada anggotanya bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "bekerjasama dengan pertubuhan perbadanan atau agensi kerajaan bagi maksud melaksanakan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan menurut seksyen 129 sama ada mana-mana tempat di luar Malaysia mempunyai suatu sistem bagi perlindungan data peribadi yang sebahagian besarnya seumpama dengan yang diperuntukkan di bawah Akta ini atau yang dapat digunakan bagi maksud yang serupa seperti Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan atau menyebabkan dijalankan penyelidikan terhadap dan mengawasi pembangunan dalam pemprosesan data peribadi, termasuk teknologi, untuk mengambil kira kemungkinan apa-apa kesan pembangunan itu terhadap privasi individu berhubung dengan data peribadinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "memantau dan menyelia pematuhan peruntukan Akta ini, termasuk pengeluaran pekeliling, notis penguatkuasaan atau apa-apa surat cara lain kepada mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "menggalakkan kesedaran dan penyebaran maklumat kepada orang awam mengenai kuat kuasa Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dan bekerjasama dengan orang yang melaksanakan fungsi perlindungan data peribadi yang seumpama di mana-mana tempat di luar Malaysia berkenaan dengan perkara yang berkepentingan bersama, termasuk perkara yang melibatkan privasi individu berhubung dengan data peribadinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "mewakili Malaysia melalui penyertaan dalam acara yang berhubungan dengan perlindungan data peribadi sebagaimana yang dibenarkan oleh Menteri, sama ada di dalam atau di luar Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa aktiviti dan melakukan apa-apa perkara yang perlu, memberi kebaikan dan patut bagi pentadbiran Akta ini, atau apa-apa maksud lain yang selaras dengan Akta ini sebagaimana yang diarahkan oleh Menteri. Kuasa Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah mempunyai segala kuasa untuk melakukan semua perkara yang perlu atau suai manfaat bagi atau berkaitan dengan pelaksanaan fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kuasa Pesuruhjaya hendaklah termasuk kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengutip apa-apa fi yang ditetapkan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana ejen, pakar, perunding atau mana-mana orang lain yang difikirkannya patut untuk membantunya dalam pelaksanaan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merumuskan pembangunan sumber manusia dan program kerjasama bagi pelaksanaan fungsinya dengan patut dan berkesan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperoleh, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih atau tak alih bagi pelaksanaan fungsinya, dan untuk memindahhakkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadaijanjikan, mendemiskan, memindahkan hakmilik atau selainnya melupuskan, atau membuat apa-apa urusan mengenai harta itu atau apa-apa kepentingan mengenainya yang terletak hak padanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan apa-apa fungsi lain yang ditugaskan oleh Menteri dari semasa ke semasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan semua perkara yang bersampingan dengan atau berbangkit daripada pelaksanaan fungsinya. Pelantikan Timbalan Pesuruhjaya dan Penolong Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh, dengan kelulusan Menteri, dari semasa ke semasa, melantik apa-apa bilangan pegawai awam sebagai Timbalan Pesuruhjaya dan apa-apa bilangan orang sebagai Penolong Pesuruhjaya sebagaimana yang perlu untuk membantu Pesuruhjaya dalam melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pesuruhjaya dan Penolong Pesuruhjaya yang dilantik di bawah subseksyen (1) hendaklah memegang jawatan bagi apa-apa tempoh, menerima apa-apa saraan, elaun atau faedah, dan hendaklah tertakluk kepada apa-apa terma dan syarat perkhidmatan sebagaimana yang ditentukan oleh Pesuruhjaya, dengan kelulusan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pesuruhjaya dan Penolong Pesuruhjaya yang dilantik di bawah subseksyen (1) hendaklah tertakluk kepada penyeliaan, arahan dan kawalan Pesuruhjaya. Pelantikan pegawai lain dan pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh mengambil kerja atas apa-apa terma dan syarat yang difikirkannya wajar mana-mana pegawai dan pekhidmat yang perlu untuk membantu Pesuruhjaya dalam melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini. Pinjaman dan wang pendahuluan kepada pegawai dan pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh memberikan pinjaman dan pendahuluan kepada pegawai dan pekhidmat di bawah seksyen 51 bagi apa- apa maksud dan atas apa-apa terma dan syarat yang ditentukan oleh Pesuruhjaya. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa syarat yang dinyatakan dalam surat cara pelantikannya, Pesuruhjaya hendaklah, melainkan jika dia terlebih dahulu meletakkan jawatannya atau mengosongkan jawatannya atau pelantikannya dibatalkan terlebih dahulu, memegang jawatan selama tempoh tidak melebihi tiga tahun dan layak dilantik semula. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan Pesuruhjaya dan hendaklah menyatakan sebab bagi pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh pada bila-bila masa meletakkan jawatannya dengan memberikan suatu notis bertulis yang ditujukan kepada Menteri empat belas hari sebelum tarikh peletakan jawatan yang diniatkan itu. Penjalanan sementara fungsi dan kuasa Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara sementara seorang Timbalan Pesuruhjaya untuk melaksanakan fungsi dan kuasa Pesuruhjaya selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya atas sebab sakit, tidak hadir dengan kebenaran atau apa-apa sebab lain tidak boleh melaksanakan fungsinya bagi apa-apa tempoh yang lama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pesuruhjaya kosong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang yang dilantik di bawah subseksyen (1) hendaklah, semasa tempoh dia melaksanakan fungsi dan menjalankan kuasa Pesuruhjaya di bawah seksyen ini, disifatkan sebagai Pesuruhjaya. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan Pesuruhjaya hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau jika dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada denda atau sebagai ganti denda) selama tempoh yang melebihi dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai Pesuruhjaya atau selainnya, adalah sedemikian rupa sehingga mencemarkan nama baik jawatan Pesuruhjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peletakan jawatannya diterima oleh Menteri. Saraan dan elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah dibayar apa-apa saraan dan elaun yang ditentukan oleh Menteri selepas berunding dengan Menteri Kewangan. Pewakilan fungsi dan kuasa Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh, tertakluk kepada apa-apa syarat, batasan atau sekatan yang difikirkannya patut dikenakan, mewakilkan mana-mana fungsi atau kuasanya yang dikenakan atau diberikan kepadanya di bawah Akta ini, kecuali kuasa pewakilannya, kepada Timbalan Pesuruhjaya atau Penolong Pesuruhjaya, dan mana-mana fungsi atau kuasa yang diwakilkan sedemikian boleh dilaksanakan dan dijalankan oleh pegawai itu atas nama dan bagi pihak Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah subseksyen (1) tidak menghalang Pesuruhjaya sendiri daripada melaksanakan atau menjalankan pada bila-bila masa fungsi atau kuasa yang diwakilkan itu. Arahan oleh Menteri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya adalah bertanggungjawab kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberi Pesuruhjaya arahan yang bersifat am yang selaras dengan peruntukan Akta ini berhubungan dengan pelaksanaan fungsi dan kuasa Pesuruhjaya dan Pesuruhjaya hendaklah melaksanakan arahan itu. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah memberi Menteri dan mana-mana pihak berkuasa awam sebagaimana yang diarahkan oleh Menteri, penyata, laporan, akaun dan maklumat berkenaan dengan aktivitinya sebagaimana yang dikehendaki atau diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IV__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Pesuruhjaya hendaklah, dengan secepat yang dapat dilaksanakan selepas berakhirnya setiap tahun kewangan, menyebabkan disediakan dan dihantar kepada Menteri dan jika diarahkan sedemikian oleh Menteri kepada mana-mana pihak berkuasa awam lain, suatu laporan yang memperkatakan aktiviti Pesuruhjaya semasa tahun kewangan yang sebelum itu, dan laporan itu hendaklah mengikut apa-apa bentuk dan hendaklah mengandungi apa-apa maklumat yang berhubungan dengan prosiding dan dasar Pesuruhjaya sebagaimana yang dinyatakan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_110",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_114",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_116",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_119",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_126",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUATKUASAAN Pegawai diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh secara bertulis memberi kuasa mana-mana pegawai yang dilantik di bawah seksyen 50 dan 51 atau mana- mana pegawai awam untuk menjalankan kuasa penguatkuasaan di bawah Akta ini. Kad kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah mengeluarkan kepada setiap pegawai diberi kuasa suatu kad kuasa yang hendaklah ditandatangani oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila pegawai diberi kuasa menjalankan mana-mana kuasa penguatkuasaan di bawah Akta ini, dia hendaklah, apabila diminta, menunjukkan kepada orang yang terhadapnya kuasa itu sedang dijalankan kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (1). Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa boleh menyiasat pelakuan mana-mana kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, diisytiharkan bahawa bagi maksud Akta ini, pegawai diberi kuasa hendaklah mempunyai segala atau mana-mana kuasa khas seorang pegawai polis daripada apa-apa jua pangkat berhubungan dengan penyiasatan polis dalam kes boleh tangkap seperti yang diperuntukkan di bawah Kanun Tatacara Jenayah [Akta 593], dan kuasa itu adalah sebagai tambahan kepada kuasa yang diperuntukkan di bawah Akta ini dan bukan pengurangan baginya. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah daripada pegawai diberi kuasa dan selepas apa-apa siasatan sebagaimana yang difikirkan perlu oleh Majistret, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana premis telah digunakan bagi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ada di dalam mana-mana premis keterangan yang perlu untuk menjalankan suatu penyiasatan mengenai, pelakuan suatu kesalahan di bawah Akta ini, Majistret boleh mengeluarkan suatu waran yang memberi kuasa pegawai diberi kuasa yang dinamakan dalam waran itu pada bila-bila masa yang munasabah pada waktu siang atau malam dan dengan atau tanpa bantuan, untuk memasuki premis itu dan jika perlu dengan menggunakan kekerasan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberi kuasa penggeledahan dan penyitaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain yang mengandungi atau yang semunasabahnya disyaki mengandungi maklumat mengenai apa-apa kesalahan yang disyaki telah dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana papan tanda, kad, surat, risalah, lembaran atau notis yang menyatakan atau yang menyiratkan bahawa orang itu didaftarkan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kelengkapan, peralatan atau barang yang semunasabahnya dipercayai dapat memberikan keterangan mengenai pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang menjalankan penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang membuat pemeriksaan terhadap seseorang di bawah subseksyen (3) atau seksyen 114 boleh menyita atau mengambil milik, dan menyimpan dalam jagaan selamat semua benda selain pakaian yang perlu yang dijumpai pada orang itu, dan apa-apa benda sedemikian yang mengenainya ada sebab untuk mempercayai bahawa benda itu merupakan peralatan atau keterangan lain mengenai kesalahan itu boleh ditahan sehingga orang itu dilepaskan atau dibebaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perlu untuk menyebabkan seseorang perempuan diperiksa, pemeriksaan itu hendaklah dilakukan oleh seorang perempuan lain dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab sifat, saiz atau amaunnya, pemindahan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita di bawah seksyen ini tidak dapat dilaksanakan, pegawai diberi kuasa hendaklah dengan apa-apa cara mengelak komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu di dalam premis atau bekas yang di dalamnya ia dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (6) atau memindahkan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran geledah di bawah seksyen 113 penyiasatan akan terjejas atau keterangan mengenai pelakuan suatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai diberi kuasa itu boleh memasuki premis itu dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 113 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Capaian kepada data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang menjalankan suatu penggeledahan di bawah seksyen 113 dan 114 hendaklah diberi capaian kepada data berkomputer sama ada disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “capaian”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "termasuklah diberi kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan data berkomputer itu difahami; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai erti yang diberikan kepadanya oleh subseksyen 2(2) dan (5) Akta Jenayah Komputer 1997 [Akta 563]. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun kecacatan, kesilapan atau peninggalan dalamnya atau dalam permohonan bagi waran itu, dan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita di bawah waran itu hendaklah boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Senarai komputer, buku, akaun, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang disita menurut Akta ini, pegawai diberi kuasa yang membuat penggeledahan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menyediakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu senarai komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita itu dan hendaklah menandatangani senarai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu notis bertulis mengenai penyitaan itu yang mengandungi alasan bagi penyitaan itu dan hendaklah menandatangani notis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dengan secepat yang dapat dilaksanakan menyampaikan suatu salinan senarai komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita dan notis bertulis mengenai penyitaan itu kepada penghuni premis yang telah digeledah, atau kepada ejen atau pekhidmatnya di dalam premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bertulis mengenai penyitaan itu tidak dikehendaki untuk disampaikan menurut perenggan (1)(b) jika penyitaan itu dibuat dengan kehadiran orang yang terhadapnya prosiding di bawah Akta ini diniatkan untuk diambil, atau dengan kehadiran pemunya harta sedemikian atau ejennya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak diduduki, pegawai diberi kuasa hendaklah menampalkan suatu salinan senarai komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita itu di tempat yang mudah dilihat di premis itu. Pelepasan komputer, buku, akaun, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang telah disita di bawah Akta ini, pegawai diberi kuasa yang membuat penyitaan itu boleh, selepas merujuk kepada Pendakwa Raya, melepaskan komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu kepada orang yang ditentukan olehnya sebagai berhak secara sah kepadanya, jika komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu tidak boleh dilucuthakkan di bawah Akta ini, dan tidak dikehendaki selainnya bagi maksud apa-apa prosiding di bawah Akta ini atau bagi maksud apa-apa pendakwaan di bawah mana-mana undang-undang bertulis yang lain, dan sekiranya sedemikian pegawai diberi kuasa yang membuat penyitaan itu, atau Kerajaan Persekutuan, Pesuruhjaya atau mana- mana orang yang bertindak bagi pihak Kerajaan Persekutuan atau Pesuruhjaya tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod bertulis hendaklah dibuat oleh pegawai diberi kuasa yang membuat pelepasan komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang di bawah subseksyen (1) yang menyatakan secara terperinci hal keadaan dan sebab bagi pelepasan itu, dan dia hendaklah menghantarkan suatu salinan rekod itu kepada Pendakwa Raya dalam tempoh tujuh hari dari pelepasan itu. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita dalam menjalankan atau yang berupa sebagai menjalankan mana-mana kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau kepada apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Halangan terhadap penggeledahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk memberi mana-mana pegawai diberi kuasa akses kepada mana-mana premis yang pegawai diberi kuasa itu berhak kepadanya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menghalang, menggalang atau melengahkan mana-mana pegawai diberi kuasa dalam membuat apa- apa kemasukan yang pegawai diberi kuasa itu berhak membuatnya di bawah Akta ini, atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk memberi mana-mana pegawai diberi kuasa apa-apa maklumat berhubungan dengan sesuatu kesalahan atau kesalahan yang disyaki di bawah Akta ini atau apa-apa maklumat lain yang boleh semunasabahnya dikehendaki daripadanya dan yang ada dalam pengetahuannya atau dalam kuasanya untuk memberikannya, melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi dua tahun atau didenda tidak melebihi sepuluh ribu ringgit atau kedua-duanya. Kuasa untuk menghendaki pengemukaan komputer, buku, akaun, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa hendaklah, bagi maksud pelaksanaan Akta ini, mempunyai kuasa untuk melakukan semua atau mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain yang disimpan oleh pengguna data atau mana-mana orang lain dan untuk memeriksa, meneliti dan memuat turun daripadanya, membuat salinannya atau mengambil cabutan daripadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan mana-mana dokumen pengenalan daripada mana-mana orang berhubungan dengan mana- mana perbuatan atau kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa siasatan yang perlu untuk memastikan sama ada peruntukan Akta ini telah dipatuhi. Kuasa untuk menghendaki kehadiran orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang menjalankan suatu penyiasatan di bawah Akta ini boleh melalui perintah bertulis menghendaki kehadiran di hadapannya mana-mana orang yang pada pendapat pegawai diberi kuasa itu mempunyai pengetahuan tentang fakta dan hal keadaan kes itu, dan orang itu hendaklah hadir sebagaimana yang dikehendaki sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_122",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang enggan atau tidak hadir sebagaimana yang dikehendaki sedemikian, pegawai diberi kuasa itu boleh melaporkan keengganan atau ketidakhadiran itu kepada seorang Majistret yang hendaklah mengeluarkan suatu saman untuk memastikan kehadiran orang itu sebagaimana yang dikehendaki oleh perintah yang dibuat di bawah subseksyen (1). Pemeriksaan orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang menjalankan suatu penyiasatan di bawah Akta ini boleh memeriksa secara lisan mana-mana orang yang dikatakan mempunyai pengetahuan tentang fakta dan hal keadaan kes itu dan hendaklah mengubah ke dalam bentuk bertulis apa-apa pernyataan yang dibuat oleh orang yang diperiksa sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu adalah terikat untuk menjawab semua soalan yang berhubungan dengan kes itu yang diajukan kepadanya oleh pegawai diberi kuasa itu: Dengan syarat bahawa orang itu boleh enggan untuk menjawab mana-mana soalan yang jawapannya berkecenderungan mendedahkannya kepada pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang membuat suatu pernyataan di bawah seksyen ini adalah terikat di sisi undang-undang untuk menyatakan yang benar, sama ada pernyataan itu dibuat secara keseluruhannya atau sebahagiannya dalam menjawab soalan atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai diberi kuasa yang memeriksa seseorang di bawah subseksyen (1) hendaklah terlebih dahulu memaklumkan orang itu mengenai peruntukan subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah, bila mana mungkin, dicatatkan secara bertulis dan ditandatangani oleh orang yang membuatnya atau dilekatkan cap ibu jarinya, mengikut mana-mana yang berkenaan, selepas pernyataan itu dibacakan kepadanya dalam bahasa dia membuatnya dan selepas dia diberi peluang untuk membuat apa-apa pembetulan yang dia mahu. Kebolehterimaan pernyataan sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam seksyen ini, tiada pernyataan yang dibuat oleh mana-mana orang kepada seorang pegawai diberi kuasa dalam penjalanan suatu penyiasatan yang dibuat di bawah Akta ini boleh digunakan sebagai keterangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana saksi dipanggil bagi pendakwaan atau pembelaan, selain tertuduh, mahkamah hendaklah, atas permintaan tertuduh atau pendakwa, merujuk kepada mana-mana pernyataan yang dibuat oleh saksi itu kepada pegawai diberi kuasa dalam penjalanan penyiasatan di bawah Akta ini dan boleh kemudian, jika difikirkan patut oleh mahkamah demi kepentingan keadilan, mengarahkan supaya tertuduh diberi suatu salinan pernyataan itu dan pernyataan itu boleh digunakan untuk mencabar kebolehpercayaan saksi itu mengikut cara yang diperuntukkan oleh Akta Keterangan 1950 [Akta 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tertuduh telah membuat suatu pernyataan semasa penjalanan suatu penyiasatan, pernyataan itu boleh diterima sebagai keterangan untuk menyokong pembelaannya semasa penjalanan perbicaraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua dalam seksyen ini hendaklah disifatkan terpakai bagi apa-apa pernyataan yang dibuat dalam penjalanan perbarisan cam atau yang diliputi oleh seksyen 27 atau perenggan 32(1)(a), (i) dan (j) Akta Keterangan 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang dipertuduh atas mana-mana kesalahan yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pembuatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_124__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "kandungan, mana-mana pernyataan yang dibuat olehnya kepada seorang pegawai diberi kuasa dalam penjalanan suatu penyiasatan yang dibuat di bawah Akta ini, pernyataan itu boleh digunakan sebagai keterangan dalam kes pendakwaan. Pelucuthakan komputer, buku, akaun, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi pelucuthakan komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita dan boleh dilucuthakkan di bawah Akta ini hendaklah dibuat oleh mahkamah yang di hadapannya pendakwaan berkenaan dengannya telah diadakan jika dibuktikan sehingga memuaskan hati mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita itu ialah hal perkara bagi atau telah digunakan dalam pelakuan kesalahan itu, walaupun tiada orang telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita di bawah Akta ini, komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu hendaklah diambil dan disifatkan terlucut hak apabila habis tempoh satu bulan kalendar dari tarikh penyampaian notis ke alamat yang terakhir diketahui orang yang daripadanya komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu disita yang menyatakan bahawa tiada pendakwaan berkenaan dengan komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu, melainkan jika sebelum habis tempoh itu suatu tuntutan baginya dibuat mengikut cara yang dinyatakan dalam subseksyen (4), (5) dan (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disebut dalam subseksyen (3) dan bahawa ia tidak boleh dilucuthakkan boleh memberi, sendiri atau melalui ejennya yang diberi kuasa secara bertulis, notis bertulis kepada pegawai diberi kuasa yang dalam milikannya komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu dipegang bahawa dia menuntut komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila notis di bawah subseksyen (4) diterima, pegawai diberi kuasa hendaklah merujukkan perkara itu kepada Majistret bagi keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret yang kepadanya perkara itu dirujukkan di bawah subseksyen (5) hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu dan orang yang daripadanya ia disita untuk hadir di hadapan Majistret itu, dan apabila mereka hadir atau apabila mereka tidak hadir, setelah dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, Majistret itu hendaklah meneruskan pemeriksaan perkara itu dan, apabila dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita itu ialah hal perkara bagi atau telah digunakan dalam pelakuan kesalahan itu, Majistret hendaklah memerintahkan supaya komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang itu dilucuthakkan, dan hendaklah, jika tiada bukti sedemikian, memerintahkan pelepasannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_125",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang dilucuthakkan atau disifatkan terlucut hak hendaklah diserahkan kepada Pesuruhjaya dan hendaklah dilupuskan mengikut apa-apa cara yang difikirkan patut oleh Pesuruhjaya. Percantuman kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam seksyen 164 Kanun Tatacara Jenayah, jika seseorang dituduh atas lebih daripada satu kesalahan di bawah Akta ini, dia boleh dipertuduh atas dan dibicarakan dalam satu perbicaraan bagi seberapa banyak kesalahan yang dilakukan dalam jarak masa tidak kira apa jua pun tempohnya. Kuasa menangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa atau pegawai polis boleh menangkap tanpa waran mana-mana orang yang semunasabahnya dipercayai olehnya telah melakukan atau cuba melakukan suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_IX__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang membuat tangkapan di bawah subseksyen (1) hendaklah tanpa kelengahan yang tidak perlu menyerahkan orang yang ditangkap sedemikian kepada pegawai polis yang paling hampir atau, jika tiada pegawai polis, membawa orang itu ke balai polis yang paling hampir, dan selepas itu orang itu hendaklah diperlakukan sebagaimana yang diperuntukkan oleh undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa seolah-olah dia ditangkap oleh seorang pegawai polis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlindungan Data Peribadi 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi peruntukan yang berlainan dalam Akta ini. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang memproses; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mempunyai kawalan terhadap atau membenarkan pemprosesan, apa-apa data peribadi berkenaan dengan transaksi komersial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (1), Akta ini terpakai bagi seseorang berkenaan dengan data peribadi jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu ditubuhkan di Malaysia dan data peribadi itu diproses, sama ada dalam konteks pertubuhan itu atau tidak, oleh orang itu atau mana-mana orang lain yang diambil kerja atau diguna khidmat oleh pertubuhan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak ditubuhkan di Malaysia, tetapi menggunakan kelengkapan di Malaysia bagi memproses data peribadi itu selain bagi maksud transit melalui Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diliputi oleh perenggan (2)(b) hendaklah menamakan bagi maksud Akta ini seorang wakil yang ditubuhkan di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2) dan (3), setiap yang berikut hendaklah dianggap sebagai ditubuhkan di Malaysia:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang individu yang kehadirannya secara fizikal di Malaysia hendaklah tidak kurang daripada satu ratus lapan puluh hari dalam satu tahun kalendar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan yang diperbadankan di bawah Akta Syarikat 1965 [Akta 125];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu perkongsian atau persatuan yang tidak diperbadankan lain yang dibentuk di bawah mana-mana undang-undang bertulis di Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang tidak diliputi oleh perenggan (a), (b) atau (c) tetapi menyenggara di Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pejabat, cawangan atau agensi yang melaluinya dia menjalankan apa-apa aktiviti; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_2__subsec_4__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu amalan tetap. Ketidakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini tidaklah terpakai bagi Kerajaan Persekutuan dan Kerajaan Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini tidaklah terpakai bagi apa-apa data peribadi yang diproses di luar Malaysia melainkan jika data peribadi itu diniatkan untuk diproses selanjutnya di Malaysia. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“agensi pelaporan kredit” mempunyai erti yang diberikan kepadanya dalam Akta Agensi Pelaporan Kredit 2009 [Akta ]; “Akta ini” termasuk peraturan-peraturan, perintah, pemberitahuan dan perundangan subsidiari lain yang dibuat di bawah Akta ini; “daftar” ertinya Daftar Pengguna Data, Daftar Forum Pengguna Data atau Daftar Tataamalan; “data peribadi” ertinya apa-apa maklumat yang berkenaan dengan transaksi komersial, yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sedang diproses secara keseluruhannya atau sebahagiannya melalui kelengkapan yang dikendalikan secara automatik sebagai tindak balas kepada arahan yang diberikan bagi maksud itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "direkodkan dengan niat bahawa ia sepatutnya diproses secara keseluruhannya atau sebahagiannya melalui kelengkapan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "direkodkan sebagai sebahagian daripada sistem pemfailan yang berkaitan atau dengan niat bahawa ia sepatutnya menjadi sebahagian daripada sistem pemfailan yang berkaitan, yang berhubungan secara langsung atau tidak langsung dengan seorang subjek data, yang dikenal pasti atau boleh dikenal pasti daripada maklumat itu atau daripada maklumat itu dan maklumat lain dalam milikan seorang pengguna data, termasuk apa-apa data peribadi sensitif dan penyataan pendapat tentang subjek data itu; tetapi tidak termasuk apa-apa maklumat yang diproses bagi maksud suatu perniagaan pelaporan kredit yang dijalankan oleh sesuatu agensi pelaporan kredit di bawah Akta Agensi Pelaporan Kredit 2009; “data peribadi sensitif” ertinya apa-apa data peribadi yang mengandungi maklumat tentang kesihatan atau keadaan fizikal atau mental seorang subjek data, pendapat politiknya, kepercayaan agamanya atau kepercayaan lain yang bersifat seumpamanya, pelakuan atau pengataan pelakuan apa-apa kesalahan olehnya atau apa-apa data peribadi lain yang ditentukan oleh Menteri melalui perintah yang disiarkan dalam Warta; “ditetapkan” ertinya ditetapkan oleh Menteri di bawah Akta ini dan jika tiada cara disebut, ertinya ditetapkan melalui perintah yang disiarkan dalam Warta; “Jawatankuasa Penasihat” ertinya Jawatankuasa Penasihat Perlindungan Data Peribadi yang ditubuhkan di bawah seksyen 70; “kepentingan vital” ertinya perkara yang berhubungan dengan kehidupan, kematian atau keselamatan seorang subjek data; “Kumpulan Wang” ertinya Kumpulan Wang Perlindungan Data Peribadi yang ditubuhkan di bawah seksyen 61; “menggunakan”, berhubung dengan data peribadi, tidak termasuk perbuatan mengumpul atau menzahirkan data peribadi itu; “mengumpul”, berhubung dengan data peribadi, ertinya perbuatan yang melaluinya data peribadi itu termasuk ke dalam atau berada di bawah kawalan seorang pengguna data; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi perlindungan data peribadi; “menzahirkan”, berhubung dengan data peribadi, ertinya perbuatan yang melaluinya data peribadi itu disediakan oleh seorang pengguna data; “orang yang berkaitan”, berhubung dengan seorang subjek data, dengan apa jua cara sekalipun diperihalkan, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang subjek data yang di bawah umur lapan belas tahun, ibu bapa, penjaga atau seseorang yang mempunyai tanggungjawab ibu bapa terhadap subjek data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang subjek data yang tidak berupaya menguruskan hal-ehwalnya sendiri, seorang yang dilantik oleh mahkamah untuk menguruskan hal-ehwal itu, atau seorang yang diberi kuasa secara bertulis oleh subjek data untuk bertindak bagi pihak subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal lain, seorang yang diberi kuasa secara bertulis oleh subjek data untuk membuat suatu permintaan mengakses data, permintaan pembetulan data, atau kedua-dua permintaan itu, bagi pihak subjek data itu; “pegawai diberi kuasa” ertinya mana-mana pegawai yang diberi kuasa secara bertulis oleh Pesuruhjaya di bawah seksyen 110; “pembetulan”, berhubung dengan data peribadi, termasuk pindaan, perubahan, ubah suaian atau pemotongan; “peminta”, berhubung dengan suatu permintaan mengakses data atau permintaan pembetulan data, ertinya subjek data atau orang yang berkaitan bagi pihak subjek data itu, yang membuat permintaan itu; “pemproses data”, berhubung dengan data peribadi, ertinya mana-mana orang, selain seorang pekerja pengguna data, yang memproses data peribadi itu semata-mata bagi pihak pengguna data itu, dan tidak memproses data peribadi itu bagi apa-apa maksud persendiriannya; “pemprosesan”, berhubung dengan data peribadi, ertinya mengumpul, merekod, memegang atau menyimpan data peribadi itu atau menjalankan apa-apa pengendalian atau set pengendalian terhadap data peribadi itu, termasuk—"
      }
    },
    {
