      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu penyiasatan yang dimulakan dengan suatu aduan, ertinya pengguna data yang dinyatakan dalam aduan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_4__para_c__subpara_ii",
