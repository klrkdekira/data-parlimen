      "schema:text": {
        "@language": "ms",
        "@value": "mendapatkan kembali, merujuk kepada atau menggunakan data peribadi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
