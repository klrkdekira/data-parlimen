      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu penyiasatan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_4__para_c__subpara_i",
