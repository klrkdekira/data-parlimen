    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_107",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_109"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMERIKSAAN, ADUAN DAN PENYIASATAN Pemeriksaan sistem data peribadi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh menjalankan suatu pemeriksaan mengenai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana sistem data peribadi yang digunakan oleh pengguna data bagi maksud menentukan maklumat untuk membantu Pesuruhjaya dalam membuat syor kepada pengguna data yang berkaitan berhubungan dengan penggalakan pematuhan peruntukan Akta ini, khususnya Prinsip Perlindungan Data Peribadi, oleh pengguna data yang berkaitan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana sistem data peribadi yang digunakan oleh pengguna data yang tergolong dalam golongan pengguna data bagi maksud menentukan maklumat untuk membantu Pesuruhjaya dalam membuat syor kepada golongan pengguna data yang dalamnya pengguna data yang berkaitan tergolong berhubungan dengan penggalakan pematuhan peruntukan Akta ini, khususnya Prinsip Perlindungan Data Peribadi, oleh golongan pengguna data yang dalamnya pengguna data yang berkaitan tergolong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini— “pengguna data” termasuk pemproses data; “sistem data peribadi” ertinya apa-apa sistem, sama ada berautomasi atau selainnya, yang digunakan, sama ada keseluruhannya atau sebahagiannya, oleh seorang pengguna data bagi pemprosesan data peribadi, dan termasuk rekod yang disenggarakan di bawah seksyen 44 dan apa-apa dokumen dan kelengkapan yang menjadi sebahagian daripada sistem itu. Pengguna data yang berkaitan, dll., hendaklah dimaklumkan mengenai keputusan pemeriksaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya telah menyelesaikan suatu pemeriksaan terhadap suatu sistem data peribadi, dia hendaklah mengikut apa-apa cara dan pada bila-bila masa yang difikirkannya patut memaklumkan pengguna data yang berkaitan atau golongan pengguna data yang dalamnya pengguna data yang berkaitan itu tergolong mengenai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "keputusan pemeriksaan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa syor yang didapati daripada pemeriksaan itu yang difikirkan patut oleh Pesuruhjaya untuk dibuat berhubungan dengan penggalakan pematuhan peruntukan Akta ini, khususnya Prinsip Perlindungan Data Peribadi, oleh pengguna data yang berkaitan atau golongan pengguna data yang dalamnya pengguna data yang berkaitan itu tergolong; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa ulasan lain yang berbangkit daripada pemeriksaan itu yang difikirkannya patut. Laporan oleh Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh, selepas menyelesaikan pemeriksaan terhadap mana-mana sistem data peribadi yang digunakan oleh pengguna data yang tergolong dalam suatu golongan pengguna data, menerbitkan suatu laporan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyatakan apa-apa syor yang didapati daripada pemeriksaan yang difikirkan patut oleh Pesuruhjaya untuk dibuat berhubungan dengan penggalakan pematuhan peruntukan Akta ini, khususnya Prinsip Perlindungan Data Peribadi, oleh golongan pengguna data yang dalamnya pengguna data yang berkaitan tergolong; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengikut apa-apa cara yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu laporan yang diterbitkan di bawah subseksyen (1) hendaklah dibuat dengan sebegitu rupa supaya menghalang identiti mana-mana individu daripada dapat ditentukan daripadanya. Aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana individu atau orang yang berkaitan boleh membuat aduan secara bertulis kepada Pesuruhjaya mengenai sesuatu perbuatan, amalan atau permintaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dinyatakan dalam aduan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah dilakukan atau dibuat, atau yang sedang dilakukan atau dibuat, oleh pengguna data yang dinyatakan dalam aduan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berhubungan dengan data peribadi yang mengenainya individu itu merupakan subjek data; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mungkin melanggar peruntukan Akta ini, termasuk mana-mana tataamalan. Penyiasatan oleh Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya menerima suatu aduan di bawah seksyen 104, Pesuruhjaya hendaklah, tertakluk kepada seksyen 106, menjalankan suatu penyiasatan berhubung dengan pengguna data yang berkaitan untuk memastikan sama ada perbuatan, amalan atau permintaan yang dinyatakan dalam aduan itu melanggar peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya mempunyai alasan yang munasabah untuk mempercayai bahawa suatu perbuatan, amalan atau permintaan telah dilakukan atau dibuat, atau sedang dilakukan atau dibuat, oleh pengguna data yang berkaitan berhubungan dengan data peribadi dan perbuatan, amalan atau permintaan itu mungkin melanggar peruntukan Akta ini, Pesuruhjaya boleh menjalankan suatu penyiasatan berhubungan dengan pengguna data yang berkaitan itu untuk memastikan sama ada perbuatan, amalan atau permintaan itu melanggar peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Bahagian IX hendaklah terpakai berkenaan dengan penyiasatan yang dijalankan oleh Pesuruhjaya di bawah Bahagian ini. Sekatan terhadap penyiasatan yang dimulakan melalui aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh enggan untuk menjalankan atau meneruskan suatu penyiasatan yang dimulakan melalui suatu aduan jika dia berpendapat bahawa, dengan mengambil kira semua hal keadaan mengenai hal itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "aduan itu, atau suatu aduan yang sebahagian besarnya bersifat seumpamanya, telah sebelum ini memulakan suatu penyiasatan yang akibat daripadanya Pesuruhjaya berpendapat bahawa tidak terdapat apa-apa pelanggaran peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan, amalan atau permintaan yang dinyatakan dalam aduan itu adalah remeh-temeh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "aduan itu adalah remeh, menyusahkan atau tidak dibuat dengan suci hati; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana penyiasatan atau penyiasatan selanjutnya adalah kerana apa-apa sebab lain tidak perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun keluasan kuasa yang diberikan kepada Pesuruhjaya oleh Akta ini, Pesuruhjaya boleh enggan untuk menjalankan atau meneruskan suatu penyiasatan yang dimulakan melalui suatu aduan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pengadu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pengadu ialah seorang yang berkaitan berhubungan dengan seorang subjek data, subjek data itu atau orang yang berkaitan itu, mengikut mana-mana yang berkenaan, mempunyai pengetahuan yang sebenar mengenai perbuatan, amalan atau permintaan yang dinyatakan dalam aduan itu bagi tempoh melebihi dua tahun sebaik sebelum tarikh Pesuruhjaya menerima aduan itu, melainkan jika Pesuruhjaya berpuas hati bahawa dalam semua hal keadaan mengenai hal itu adalah wajar untuk menjalankan atau meneruskan penyiasatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika aduan itu dibuat tanpa nama pengadu diketahui;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengadu tidak boleh dikenal pasti atau dikesan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika Pesuruhjaya berpuas hati bahawa pengguna data yang berkaitan tidak menjadi seorang pengguna data bagi tempoh tidak kurang daripada dua tahun sebaik sebelum tarikh Pesuruhjaya menerima aduan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal keadaan lain yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya enggan di bawah seksyen ini untuk menjalankan atau meneruskan suatu penyiasatan yang dimulakan melalui suatu aduan, dia hendaklah, dengan secepat yang dapat dilaksanakan tetapi dalam mana-mana hal tidak lewat daripada tiga puluh hari selepas tarikh penerimaan aduan itu, melalui notis bertulis yang disampaikan kepada pengadu itu memaklumkan pengadu itu mengenai keengganan itu dan sebab-sebab bagi keengganan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu rayuan boleh dibuat kepada Tribunal Rayuan terhadap mana-mana keengganan yang dinyatakan dalam notis di bawah subseksyen (3) oleh pengadu yang kepadanya notis itu disampaikan atau jika pengadu ialah seorang yang berkaitan, oleh subjek data yang berkenaan dengannya pengadu ialah orang yang berkaitan. Pesuruhjaya boleh menjalankan atau meneruskan penyiasatan yang dimulakan melalui aduan walaupun aduan itu ditarik balik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya berpendapat bahawa adalah demi kepentingan awam untuk berbuat demikian, dia boleh menjalankan atau meneruskan suatu penyiasatan yang dimulakan melalui suatu aduan walaupun pengadu itu telah menarik balik aduan itu dan, dalam mana-mana hal sedemikian, peruntukan Akta ini hendaklah terpakai bagi aduan dan pengadu itu seolah-olah aduan itu telah tidak ditarik balik. Notis penguatkuasaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, berikutan dengan penyelesaian suatu penyiasatan mengenai suatu perbuatan, amalan atau permintaan yang dinyatakan dalam aduan, Pesuruhjaya berpendapat bahawa pengguna data yang berkaitan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melanggar suatu peruntukan Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_C",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_D"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar peruntukan sedemikian dalam hal keadaan yang menjadikan berkemungkinan bahawa pelanggaran itu akan berterusan atau berulang, maka Pesuruhjaya boleh menyampaikan suatu notis penguatkuasaan kepada pengguna data yang berkaitan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyatakan bahawa dia berpendapat sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyatakan peruntukan Akta ini yang berdasarkannya dia berpendapat sedemikian dan sebab-sebab kenapa dia berpendapat sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mengarahkan pengguna data yang berkaitan untuk mengambil apa-apa langkah yang dinyatakan dalam notis penguatkuasaan itu untuk meremedi pelanggaran itu atau, mengikut hal keadaan, perkara yang menyebabkannya dalam apa-apa tempoh yang dinyatakan dalam notis penguatkuasaan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mengarahkan, jika perlu, pengguna data yang berkaitan untuk memberhentikan pemprosesan data peribadi sementara menunggu pengguna data yang berkaitan meremedi pelanggaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, dalam menentukan sama ada untuk menyampaikan suatu notis penguatkuasaan, menimbangkan sama ada pelanggaran atau perkara yang dengannya notis penguatkuasaan itu adalah berhubungan telah menyebabkan atau berkemungkinan akan menyebabkan kerosakan atau distres kepada subjek data bagi data peribadi yang dengannya pelanggaran atau perkara itu adalah berhubungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Langkah yang dinyatakan dalam notis penguatkuasaan untuk meremedi pelanggaran atau perkara yang dengannya notis penguatkuasaan itu adalah berhubungan boleh dibuat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sehingga apa-apa takat dengan merujuk kepada mana- mana tataamalan yang telah diluluskan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memberi pengguna data yang berkaitan suatu pilihan antara cara-cara yang berlainan untuk meremedi pelanggaran atau perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh yang dinyatakan dalam notis penguatkuasaan di bawah subseksyen (1) untuk mengambil langkah yang dinyatakan dalamnya tidak boleh habis tempoh sebelum berakhirnya tempoh yang dinyatakan dalam subseksyen 93(2) yang dalam tempoh itu suatu rayuan terhadap notis penguatkuasaan itu boleh dibuat dan, jika rayuan sedemikian dibuat, langkah itu tidak perlu diambil sementara menunggu penentuan atau penarikan balik rayuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (4), jika Pesuruhjaya berpendapat bahawa atas alasan hal keadaan khas langkah yang dinyatakan dalam notis penguatkuasaan itu sepatutnya diambil atas dasar keterdesakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh memasukkan suatu pernyataan yang membawa maksud sedemikian dalam notis penguatkuasaan itu berserta dengan sebab-sebab kenapa dia berpendapat sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pernyataan itu telah dimasukkan sedemikian, subseksyen (4) tidak terpakai tetapi notis penguatkuasaan itu tidak boleh menghendaki supaya langkah itu diambil sebelum berakhirnya tempoh tujuh hari dari tarikh notis penguatkuasaan itu disampaikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rayuan boleh dibuat kepada Tribunal Rayuan terhadap suatu notis penguatkuasaan oleh pengguna data yang berkaitan mengikut seksyen 93."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai pendapat yang disebut dalam subseksyen (1) berkenaan dengan pengguna data yang berkaitan pada bila-bila masa sebelum suatu penyiasatan diselesaikan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "juga berpendapat bahawa, atas alasan hal keadaan khas, suatu notis penguatkuasaan sepatutnya disampaikan kepada pengguna data yang berkaitan atas dasar keterdesakan, dia boleh menyampaikan notis penguatkuasaan itu walaupun penyiasatan itu belum diselesaikan dan, dalam mana-mana hal sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah, tanpa menjejaskan apa-apa perkara lain yang akan dimasukkan dalam notis penguatkuasaan itu, menyatakan dalam notis penguatkuasaan itu sebab- sebab tentang kenapa dia mempunyai pendapat yang disebut dalam perenggan (b); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "peruntukan lain Akta ini, termasuk seksyen ini, hendaklah ditafsirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang tidak mematuhi suatu notis penguatkuasaan melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Perubahan atau pembatalan notis penguatkuasaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh, atas inisiatifnya sendiri atau atas permohonan seorang pengguna data yang berkaitan, mengubah atau membatalkan notis penguatkuasaan yang disampaikan di bawah subseksyen 108(1) melalui notis bertulis kepada pengguna data yang berkaitan jika Pesuruhjaya berpuas hati dengan tindakan yang diambil oleh pengguna data yang berkaitan untuk meremedi pelanggaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu keputusan yang diberikan oleh Tribunal Rayuan boleh, dengan kebenaran Mahkamah Sesyen, dikuatkuasakan dengan cara yang serupa dengan suatu penghakiman atau perintah yang mempunyai kesan yang serupa, dan jika kebenaran diberikan sedemikian, penghakiman boleh dimasukkan mengikut terma keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Tribunal Rayuan ditubuhkan bagi maksud mengkaji semula mana-mana perkara dalam rayuan yang dinyatakan dalam seksyen 93. Kuasa Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan hendaklah mempunyai kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memanggil pihak-pihak kepada prosiding atau mana-mana orang lain untuk hadir di hadapannya untuk memberikan keterangan berkenaan dengan sesuatu rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan dan menerima keterangan secara bersumpah atau berikrar, sama ada secara bertulis atau lisan, dan memeriksa semua orang sedemikian sebagai saksi sebagaimana yang difikirkan perlu oleh Tribunal Rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang dipanggil sedemikian, untuk menghendaki pengemukaan apa-apa maklumat, dokumen atau benda lain dalam milikannya atau di bawah kawalannya yang difikirkan perlu oleh Tribunal Rayuan bagi maksud rayuan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengendalikan apa-apa sumpah, ikrar atau akuan berkanun, mengikut kehendak keadaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang dipanggil sedemikian, untuk membenarkan bayaran bagi apa-apa belanja yang munasabah yang dilakukan berkaitan dengan kehadirannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima keterangan atau menolak keterangan yang dikemukakan, sama ada lisan atau dokumentar, dan sama ada boleh diterima atau tidak boleh diterima di bawah peruntukan mana-mana undang-undang bertulis yang berhubungan dengan kebolehterimaan keterangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menangguhkan pendengaran rayuan dari semasa ke semasa, termasuklah kuasa untuk menangguhkan bagi menimbangkan keputusannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya untuk mengarahkan dan melakukan semua perkara yang perlu atau suai manfaat bagi mempercepat keputusan rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan hendaklah mempunyai kuasa suatu mahkamah rendah berkenaan dengan penguatkuasaan kehadiran saksi, pendengaran keterangan secara bersumpah atau berikrar dan menjatuhkan hukuman kerana penghinaan. Keanggotaan Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan hendaklah terdiri daripada anggota yang berikut yang hendaklah dilantik oleh Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya dua orang anggota lain, atau apa-apa bilangan anggota yang lebih ramai sebagaimana yang difikirkan perlu oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seseorang yang merupakan seorang anggota Perkhidmatan Kehakiman dan Perundangan Persekutuan selama sekurang-kurangnya sepuluh tahun untuk menjadi Pengerusi Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan anggota Tribunal Rayuan hendaklah disiarkan melalui pemberitahuan dalam Warta. Setiausaha Tribunal Rayuan dan pegawai lain, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Setiausaha Tribunal Rayuan atas apa-apa terma dan syarat yang difikirkannya wajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Tribunal Rayuan hendaklah bertanggungjawab bagi pentadbiran dan pengurusan fungsi Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik apa-apa bilangan pegawai dan pekhidmat sebagaimana yang difikirkan patut oleh Menteri untuk membantu Setiausaha Tribunal Rayuan dalam menjalankan fungsinya di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Tribunal Rayuan hendaklah mempunyai kawalan am terhadap pegawai dan pekhidmat Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, Setiausaha Tribunal Rayuan dan pegawai yang dilantik di bawah subseksyen (3) hendaklah disifatkan sebagai pegawai Tribunal Rayuan. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Tribunal Rayuan yang dilantik di bawah subseksyen 85(1) hendaklah, melainkan jika dia terlebih dahulu meletakkan jawatannya atau mengosongkan jawatannya atau pelantikannya dibatalkan terlebih dahulu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang jawatan selama tempoh tidak melebihi tiga tahun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah layak untuk dilantik semula selepas habis tempoh jawatannya, tetapi tidak boleh dilantik bagi lebih daripada dua tempoh berturut-turut. Peletakan jawatan dan pembatalan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan seseorang anggota Tribunal Rayuan dan hendaklah menyatakan sebab bagi pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Tribunal Rayuan yang dilantik di bawah subseksyen 85(1) boleh pada bila-bila masa meletakkan jawatannya dengan memberikan suatu notis bertulis yang ditujukan kepada Menteri empat belas hari sebelum tarikh peletakan jawatan yang diniatkan itu. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara sementara mana-mana anggota Tribunal Rayuan untuk bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi atas sebab sakit, tidak hadir dengan kebenaran atau apa-apa sebab lain tidak boleh melaksanakan fungsinya bagi apa-apa tempoh yang lama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota yang dilantik di bawah subseksyen (1) hendaklah, semasa tempoh dia melaksanakan fungsi Pengerusi di bawah seksyen ini, disifatkan sebagai Pengerusi. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Tribunal Rayuan hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau jika dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada denda atau sebagai ganti denda) selama tempoh yang melebihi dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai seorang anggota Tribunal Rayuan atau selainnya, adalah sedemikian rupa sehingga mencemarkan nama baik Tribunal Rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak mematuhi obligasinya di bawah seksyen 92;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika prestasinya sebagai seorang anggota Tribunal Rayuan tidak memuaskan selama tempoh yang ketara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peletakan jawatannya diterima oleh Menteri. Elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Tribunal Rayuan yang dilantik di bawah perenggan 85(1)(a) hendaklah dibayar apa-apa elaun tetap dan elaun lain sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal Rayuan lain yang dilantik di bawah perenggan 85(1)(b) hendaklah dibayar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "elaun bersidang harian semasa persidangan Tribunal Rayuan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_91__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "elaun penginapan, perjalanan dan sara hidup, yang ditentukan oleh Menteri. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Tribunal Rayuan hendaklah menzahirkan, dengan secepat yang dapat dilaksanakan, kepada Pengerusi apa- apa kepentingan, sama ada substansial atau tidak, yang mungkin bercanggah dengan kewajipan anggota itu sebagai seorang anggota Tribunal Rayuan dalam sesuatu perkara tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi berpendapat bahawa kepentingan anggota itu bercanggah dengan kewajipannya sebagai seorang anggota Tribunal Rayuan, Pengerusi hendaklah memaklumkan semua pihak kepada perkara itu mengenai percanggahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pihak kepada perkara itu membantah mengenai percanggahan itu, anggota itu boleh terus melaksanakan kewajipannya sebagai seorang anggota Tribunal Rayuan berhubung dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pihak kepada perkara itu membantah mengenai percanggahan itu, anggota Tribunal Rayuan itu tidak boleh meneruskan pelaksanaan kewajipannya sebagai seorang anggota Tribunal Rayuan berhubung dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92",
      "schema:text": {
        "@language": "ms",
        "@value": "Kegagalan oleh anggota itu untuk menzahirkan kepentingannya di bawah subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menidaksahkan keputusan Tribunal Rayuan, melainkan jika semua pihak bersetuju untuk terikat dengan keputusan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_92__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menjadikan anggota itu tertakluk kepada pembatalan pelantikannya di bawah seksyen 88. Rayuan kepada Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Pesuruhjaya di bawah Akta ini berhubungan dengan perkara, termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran pengguna data di bawah Penggal 2 Bahagian II;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "keengganan Pesuruhjaya untuk mendaftarkan suatu tataamalan di bawah subseksyen 23(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kegagalan pengguna data untuk mematuhi suatu permintaan mengakses data atau permintaan pembetulan data di bawah Penggal 4 Bahagian II;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengeluaran suatu notis penguatkuasaan di bawah seksyen 108;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "keengganan Pesuruhjaya untuk mengubah atau membatalkan suatu notis penguatkuasaan di bawah seksyen 109; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "keengganan Pesuruhjaya untuk menjalankan atau meneruskan suatu penyiasatan yang dimulakan dengan suatu aduan di bawah Bahagian VIII, boleh merayu kepada Tribunal Rayuan dengan memfailkan suatu notis rayuan dengan Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis rayuan itu hendaklah dibuat secara bertulis kepada Tribunal Rayuan dalam masa tiga puluh hari dari tarikh keputusan Pesuruhjaya, atau dalam hal suatu notis penguatkuasaan, dalam masa tiga puluh hari selepas notis penguatkuasaan itu disampaikan kepada pengguna data yang berkaitan, dan perayu hendaklah menyampaikan suatu salinan notis rayuan itu kepada Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis rayuan itu hendaklah menyatakan secara ringkas kandungan keputusan Pesuruhjaya yang terhadapnya suatu rayuan difailkan dengan Tribunal Rayuan, mengandungi alamat di mana apa-apa notis atau dokumen yang berkaitan dengan rayuan itu boleh disampaikan kepada perayu atau peguam belanya, dan hendaklah ditandatangani oleh perayu itu atau peguam belanya. Rekod keputusan Pesuruhjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang terkilan yang disebut dalam subseksyen 93(1) boleh, atas inisiatifnya sendiri, meminta secara bertulis daripada Pesuruhjaya suatu pernyataan mengenai alasan bagi keputusan Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), Pesuruhjaya hendaklah, apabila diterimanya permintaan bertulis di bawah subseksyen (1), memberi orang yang terkilan itu, apabila dibayar fi yang ditetapkan, suatu salinan pernyataan mengenai alasan bagi keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_94",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila suatu notis rayuan telah difailkan dengan Tribunal Rayuan di bawah subseksyen 93(1), Pesuruhjaya hendaklah, jika dia belum lagi menulis alasan bagi keputusannya berkenaan dengan perkara yang dinyatakan dalam notis di bawah subseksyen 93(1), merekodkan secara bertulis alasan bagi keputusannya, dan alasan bertulis itu hendaklah menjadi sebahagian daripada rekod prosiding di hadapan Tribunal Rayuan. Penggantungan keputusan sementara menunggu rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu keputusan Pesuruhjaya adalah sah, mengikat dan boleh dikuatkuasakan sementara menunggu keputusan rayuan oleh Tribunal Rayuan, kecuali jika suatu rayuan terhadap suatu notis penguatkuasaan telah dibuat kepada Tribunal Rayuan mengikut subseksyen 93(2), atau penggantungan keputusan Pesuruhjaya telah dimohon di bawah subseksyen (2) dan dibenarkan oleh Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan boleh memohon secara bertulis kepada Tribunal Rayuan bagi suatu penggantungan keputusan Pesuruhjaya pada atau selepas notis rayuan difailkan dengan Tribunal Rayuan. Keanggotaan Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap prosiding Tribunal Rayuan hendaklah didengar dan dibereskan oleh tiga anggota atau apa-apa bilangan ganjil yang lebih besar anggota Tribunal Rayuan sebagaimana yang ditentukan oleh Pengerusi dalam mana-mana hal tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam ketiadaan Pengerusi, anggota Tribunal Rayuan yang lebih kanan hendaklah menjadi Pengerusi. Persidangan Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan hendaklah bersidang pada apa-apa tarikh dan di mana-mana tempat yang ditetapkan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh membatalkan atau menangguhkan mana-mana persidangan Tribunal Rayuan atau menukar tempat persidangan yang telah ditetapkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Tribunal Rayuan hendaklah melalui notis bertulis memaklumkan pihak-pihak kepada rayuan itu mengenai apa-apa perubahan tarikh atau tempat mana-mana persidangan Tribunal Rayuan. Tatacara Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan boleh mengawal selia tatacaranya sendiri. Keputusan Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Tribunal Rayuan mengenai apa-apa perkara hendaklah diputuskan mengikut majoriti anggota Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu keputusan Tribunal Rayuan adalah muktamad dan mengikat pihak-pihak kepada rayuan itu. Penguatkuasaan keputusan Tribunal Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Jawatankuasa Penasihat Perlindungan Data Peribadi ditubuhkan. Fungsi Jawatankuasa Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Jawatankuasa Penasihat adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Pesuruhjaya mengenai segala perkara yang berhubungan dengan perlindungan data peribadi, dan pentadbiran dan penguatkuasaan sewajarnya Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Pesuruhjaya mengenai apa-apa perkara yang dirujukkan olehnya kepada Jawatankuasa Penasihat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya tidak terikat untuk bertindak atas nasihat Jawatankuasa Penasihat. Anggota Jawatankuasa Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat hendaklah terdiri daripada anggota yang berikut yang dilantik oleh Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga anggota daripada sektor awam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya tujuh tetapi tidak lebih daripada sebelas anggota lain. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota yang dilantik di bawah seksyen 72 hendaklah, melainkan jika dia terlebih dahulu meletakkan jawatannya atau mengosongkan jawatannya atau pelantikannya dibatalkan terlebih dahulu, memegang jawatan selama apa-apa tempoh tidak melebihi tiga tahun sebagaimana yang ditentukan oleh Menteri pada masa pelantikannya, dan layak untuk dilantik semula; tetapi tiada anggota boleh memegang jawatan bagi tempoh lebih daripada dua penggal berturut-turut. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota Jawatankuasa Penasihat dan hendaklah menyatakan sebab bagi pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang anggota Jawatankuasa Penasihat yang dilantik di bawah seksyen 72 boleh pada bila-bila masa meletakkan jawatannya dengan memberikan suatu notis bertulis yang ditujukan kepada Menteri empat belas hari sebelum tarikh peletakan jawatan yang diniatkan itu. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara sementara mana-mana anggota Jawatankuasa Penasihat untuk bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi atas sebab sakit, tidak hadir dengan kebenaran atau apa-apa sebab lain tidak boleh melaksanakan fungsinya bagi apa-apa tempoh yang lama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang anggota yang dilantik di bawah subseksyen (1) hendaklah, semasa tempoh dia melaksanakan fungsi Pengerusi di bawah seksyen ini, disifatkan sebagai Pengerusi. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan seorang anggota Jawatankuasa Penasihat hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau jika dia telah disabitkan atas, suatu pertuduhan berkenaan dengan–"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada denda atau sebagai ganti denda) selama tempoh yang melebihi dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai seorang anggota Jawatankuasa Penasihat atau selainnya, adalah sedemikian rupa sehingga mencemarkan nama baik Jawatankuasa Penasihat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Pengerusi, jika dia tidak menghadiri suatu mesyuarat Jawatankuasa Penasihat tanpa kebenaran Menteri secara bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang anggota Jawatankuasa Penasihat selain Pengerusi, jika dia tidak menghadiri mesyuarat Jawatankuasa Penasihat tiga kali berturut-turut tanpa kebenaran Pengerusi secara bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peletakan jawatannya diterima oleh Menteri. Elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi dan semua anggota Jawatankuasa Penasihat lain boleh dibayar apa-apa elaun yang ditentukan oleh Menteri selepas berunding dengan Menteri Kewangan. Masa dan tempat mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat hendaklah mengadakan seberapa banyak mesyuarat yang perlu bagi melaksanakan fungsinya dengan cekap dan mesyuarat itu hendaklah diadakan di mana-mana tempat dan pada bila-bila masa yang diputuskan oleh Pengerusi, dengan syarat bahawa Pengerusi tidak boleh membenarkan lebih daripada dua bulan berlalu antara mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah memanggil suatu mesyuarat jika dia diminta untuk berbuat demikian secara bertulis oleh Menteri atau oleh sekurang-kurangnya empat anggota Jawatankuasa Penasihat. Jawatankuasa Penasihat boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat boleh mengundang mana-mana orang untuk menghadiri mana-mana mesyuarat atau penimbangtelitian Jawatankuasa Penasihat bagi maksud menasihatinya mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subseksyen (1) hendaklah dibayar apa-apa elaun sebagaimana yang ditentukan oleh Pesuruhjaya. Minit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat hendaklah menyebabkan supaya minit semua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit yang dibuat mengenai mesyuarat Jawatankuasa Penasihat hendaklah, jika ditandatangani dengan sewajarnya, diterima dalam semua prosiding undang-undang sebagai keterangan tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap mesyuarat Jawatankuasa Penasihat yang berkenaan dengan penjalanannya minit telah dibuat hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota pada mesyuarat itu layak dengan sewajarnya untuk bertindak. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat boleh mengawal selia tatacaranya sendiri. Anggota hendaklah menumpukan masa kepada urusan Jawatankuasa Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Jawatankuasa Penasihat hendaklah menumpukan masa kepada urusan Jawatankuasa Penasihat sebagaimana yang perlu bagi menunaikan kewajipannya dengan berkesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu kumpulan wang yang dikenali sebagai “Kumpulan Wang Perlindungan Data Peribadi” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dikawal, disenggarakan dan dikendalikan oleh Pesuruhjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang diperuntukkan oleh Parlimen bagi maksud Akta ini dari semasa ke semasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "fi, kos dan apa-apa caj lain yang dikenakan oleh atau kena dibayar kepada Pesuruhjaya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada penjualan, pelupusan, pemajakan, penyewaan atau apa-apa urus niaga lain mengenai harta alih atau tak alih yang terletak hak atau diperoleh oleh Pesuruhjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang dibayar kepada Pesuruhjaya dari semasa ke semasa bagi pinjaman yang diberikan oleh Pesuruhjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_61__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang atau harta lain yang boleh dalam apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Pesuruhjaya berkenaan dengan apa-apa perkara yang bersampingan dengan fungsi dan kuasanya. Perbelanjaan yang hendaklah dipertanggungkan pada Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang boleh dibelanjakan bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan secara sah oleh Pesuruhjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja yang dilakukan bagi menganjurkan kempen, penyelidikan, kajian dan penyiaran bahan bagi perlindungan data peribadi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar saraan, elaun, faedah dan belanja lain bagi Pesuruhjaya, Timbalan Pesuruhjaya, Penolong Pesuruhjaya, anggota Jawatankuasa Penasihat, anggota, pegawai dan pekhidmat Tribunal Rayuan dan pegawai dan pekhidmat Pesuruhjaya, termasuk pemberian pinjaman dan wang pendahuluan, elaun persaraan, faedah persaraan dan ganjaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, perbelanjaan, fi dan kos lain, termasuk fi bagi penggunaan khidmat perunding, dan fi dan kos guaman, yang dilakukan atau diterima dengan sepatutnya, atau disifatkan patut oleh Pesuruhjaya dalam pelaksanaan fungsinya dan penjalanan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan dan bahan, memperoleh tanah dan apa-apa aset, dan menjalankan apa-apa kerja dan usaha lain dalam pelaksanaan fungsinya dan penjalanan kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya, membayar apa-apa belanja bagi melaksanakan peruntukan Akta ini. Pemeliharaan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan Pesuruhjaya untuk memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini supaya dapat memastikan bahawa jumlah hasil Pesuruhjaya mencukupi untuk membayar semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya pada akaun hasilnya, termasuk susut nilai dan bunga atas modal, dari setahun ke setahun. Kumpulan wang rizab"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menubuhkan dan meyenggarakan suatu kumpulan wang rizab dalam Kumpulan Wang. Tahun kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Pesuruhjaya hendaklah bermula pada 1 Januari dan berakhir pada 31 Disember setiap tahun. Batasan untuk berkontrak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya tidak boleh, tanpa kelulusan Menteri dan persetujuan Menteri Kewangan, membuat apa-apa kontrak yang di bawahnya Pesuruhjaya dikehendaki untuk membayar atau menerima suatu amaun yang melebihi dua juta ringgit. Akaun bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah membuka dan menyenggarakan akaun atau akaun-akaun dengan mana-mana institusi kewangan atau institusi-institusi kewangan di Malaysia yang difikirkan patut oleh Pesuruhjaya, selepas berunding dengan Menteri; dan tiap-tiap akaun itu hendaklah dikendalikan setakat yang dapat dilaksanakan melalui cek yang ditandatangani oleh mana-mana orang yang diberi kuasa oleh Menteri. Akaun dan audit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menyebabkan supaya akaun yang sepatutnya disimpan dan disenggarakan berkenaan dengan Kumpulan Wang dan dengan mematuhi peruntukan Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240]. Perbelanjaan dan penyediaan anggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Pesuruhjaya setakat apa-apa amaun yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendaklah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum 1 Jun setiap tahun, Pesuruhjaya hendaklah mengemukakan suatu anggaran perbelanjaan bagi tahun yang berikutnya kepada Menteri mengikut apa-apa bentuk dan yang mengandungi apa-apa butir yang diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum 1 Januari tahun yang berikutnya, memberitahu Pesuruhjaya amaun yang dibenarkan bagi perbelanjaan secara amnya atau amaun yang dibenarkan bagi setiap perihalan perbelanjaan berdasarkan anggaran yang disediakan di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh pada bila-bila masa mengemukakan suatu anggaran perbelanjaan tambahannya bagi mana-mana satu tahun kepada Menteri dan Menteri boleh membenarkan keseluruhan atau mana-mana bahagian perbelanjaan tambahan termasuk dalam anggaran tambahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_135",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_137",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_138",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_142",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI",
      "@type": "akn:part",
      "eli:number": "XI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_145",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN KECUALIAN DAN PERALIHAN Data peribadi yang diproses sebelum tarikh permulaan kuat kuasa Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_145",
      "@type": "akn:clause",
      "eli:number": "145",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna data telah mengumpul data peribadi daripada subjek data atau mana-mana pihak ketiga sebelum tarikh permulaan kuat kuasa Akta ini, dia hendaklah mematuhi peruntukan Akta ini dalam masa tiga bulan dari tarikh permulaan kuat kuasa Akta ini. Pendaftaran orang yang memproses data peribadi sebelum tarikh permulaan kuat kuasa Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146",
      "@type": "akn:clause",
      "eli:number": "146",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), mana-mana orang yang pada tarikh permulaan kuat kuasa Akta ini, sama ada dia sendiri atau bersesama atau bersama dengan orang lain, memproses apa- apa data peribadi atau mempunyai kawalan atau membenarkan pemprosesan apa-apa data peribadi, hendaklah dalam masa tiga bulan dari tarikh permulaan kuat kuasa Akta ini didaftarkan sebagai seorang pengguna data mengikut peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_XI__cl_146",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak terpakai bagi seseorang pengguna data yang tidak tergolong dalam golongan pengguna data yang dikehendaki untuk berdaftar sebagai pengguna data menurut peruntukan Penggal 2 Bahagian II."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah menyenggarakan dalam kedua- dua bentuk fizikal dan elektronik suatu daftar sebagaimana yang dikehendaki di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang boleh apabila dibayarnya fi yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa daftar itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat salinan atau mengambil cabutan daripada suatu entri dalam daftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_128",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang meminta supaya suatu salinan entri dalam daftar itu diberikan dalam bentuk elektronik, Pesuruhjaya boleh memberikan maklumat yang berkenaan melalui cara elektronik. Pemindahan data peribadi ke tempat di luar Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data tidak boleh memindahkan mana-mana data peribadi mengenai seorang subjek data ke suatu tempat di luar Malaysia melainkan jika ke mana-mana tempat yang ditentukan oleh Menteri, atas syor Pesuruhjaya, melalui pemberitahuan yang disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), Menteri boleh menentukan mana-mana tempat di luar Malaysia jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "di tempat itu ada berkuat kuasa mana-mana undang-undang yang sebahagian besarnya serupa dengan Akta ini, atau yang dapat digunakan bagi maksud yang sama seperti Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat itu memastikan suatu tahap perlindungan yang mencukupi berhubung dengan pemprosesan data peribadi yang sekurang-kurangnya setara dengan tahap perlindungan yang diberikan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), seseorang pengguna data boleh memindahkan mana-mana data peribadi ke suatu tempat di luar Malaysia jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "subjek data telah memberikan persetujuannya terhadap pemindahan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu perlu bagi pelaksanaan suatu kontrak antara subjek data dengan pengguna data itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu perlu bagi penyempurnaan atau pelaksanaan suatu kontrak antara pengguna data itu dengan suatu pihak ketiga yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat atas permintaan subjek data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah untuk kepentingan subjek data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu adalah bagi maksud mana-mana prosiding undang-undang atau bagi maksud untuk mendapatkan nasihat undang-undang atau untuk mewujudkan, menjalankan atau mempertahankan hak di sisi undang- undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu mempunyai alasan yang munasabah untuk mempercayai bahawa dalam segala hal keadaan mengenai hal itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu adalah bagi mengelakkan atau mengurangkan tindakan yang memudaratkan terhadap subjek data;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah tidak praktikal untuk mendapatkan persetujuan subjek data secara bertulis mengenai pemindahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "jika adalah praktikal untuk mendapatkan persetujuan itu, subjek data itu akan memberikan persetujuannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu telah mengambil segala langkah berjaga- jaga yang munasabah dan telah menjalankan segala usaha yang wajar untuk memastikan bahawa data peribadi itu tidak akan diproses di tempat itu mengikut apa-apa cara yang, sekiranya tempat itu ialah Malaysia, akan menjadi suatu pelanggaran Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu perlu untuk melindungi kepentingan vital subjek data; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindahan itu perlu oleh sebab ia berkepentingan awam dalam hal keadaan yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pesuruhjaya mempunyai alasan yang munasabah untuk mempercayai bahawa di tempat yang ditentukan di bawah subseksyen (1) tidak ada lagi berkuat kuasa mana-mana undang- undang yang sebahagian besarnya serupa dengan Akta ini, atau yang dapat digunakan bagi maksud yang sama seperti Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya hendaklah membuat apa-apa syor kepada Menteri yang hendaklah, sama ada dengan membatalkan atau meminda pemberitahuan yang dibuat di bawah subseksyen (1), menyebabkan tempat itu terhenti menjadi suatu tempat yang kepadanya data peribadi boleh dipindahkan di bawah seksyen ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pengguna data itu hendaklah berhenti memindahkan apa-apa data peribadi mengenai seorang subjek data kepada tempat itu berkuat kuasa mulai dari tempoh yang ditentukan oleh Menteri dalam pemberitahuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna data yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_129",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “tindakan yang memudaratkan”, berhubungan dengan seorang subjek data, ertinya apa-apa tindakan yang boleh membawa kesan yang memudaratkan terhadap hak, faedah, keistimewaan, obligasi atau kepentingan subjek data itu. Pengumpulan, dsb., data peribadi yang menyalahi undang- undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang tidak boleh dengan disedarinya atau secara melulu, tanpa persetujuan pengguna data—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengumpul atau menzahirkan data peribadi yang dipegang oleh pengguna data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan penzahiran data peribadi yang dipegang oleh pengguna data itu kepada orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak terpakai bagi seseorang yang menunjukkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pengumpulan atau penzahiran data peribadi itu atau perihal menyebabkan penzahiran data peribadi itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah perlu bagi maksud menghalang atau mengesan sesuatu jenayah atau bagi maksud penyiasatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah dikehendaki atau dibenarkan oleh atau di bawah mana-mana undang-undang atau oleh perintah suatu mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia bertindak dengan kepercayaan yang munasabah bahawa dia ada hak di sisi undang-undang untuk mengumpul atau menzahirkan data peribadi itu atau untuk menyebabkan penzahiran data peribadi itu kepada orang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia bertindak dengan kepercayaan yang munasabah bahawa dia akan mendapat persetujuan pengguna data jika pengguna data itu mengetahui mengenai pengumpulan atau penzahiran data peribadi itu atau perihal menyebabkan penzahiran data peribadi itu dan hal keadaan mengenainya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pengumpulan atau penzahiran data peribadi itu atau perihal menyebabkan penzahiran data peribadi itu adalah berjustifikasi oleh sebab ia berkepentingan awam dalam hal keadaan yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang mengumpul atau menzahirkan data peribadi atau menyebabkan penzahiran data peribadi dengan melanggar subseksyen (1) melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang menjual data peribadi melakukan suatu kesalahan jika dia telah mengumpul data peribadi itu dengan melanggar subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang menawarkan untuk menjual data peribadi melakukan suatu kesalahan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah mengumpul data peribadi itu dengan melanggar subseksyen (1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia kemudiannya mengumpul data peribadi itu dengan melanggar subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (5), sesuatu iklan yang menunjukkan bahawa data peribadi adalah untuk dijual atau mungkin akan dijual merupakan suatu tawaran untuk menjual data peribadi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_130",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah seksyen ini boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pensubahatan dan cubaan boleh dihukum sebagai kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bersubahat dalam pelakuan atau yang cuba untuk melakukan apa-apa kesalahan di bawah Akta ini adalah bersalah atas kesalahan itu dan boleh, apabila disabitkan, dikenakan hukuman yang diperuntukkan bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_131",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan apa-apa perbuatan sebagai persediaan untuk melakukan atau sebagai pelanjutan kepada pelakuan mana-mana kesalahan di bawah Akta ini adalah bersalah atas kesalahan itu dan boleh, apabila disabitkan, dikenakan hukuman yang diperuntukkan bagi kesalahan itu: Dengan syarat bahawa apa-apa tempoh pemenjaraan yang dikenakan tidak boleh melebihi setengah daripada tempoh maksimum yang diperuntukkan bagi kesalahan itu. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya boleh, dengan keizinan secara bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini dan yang ditetapkan menjadi suatu kesalahan boleh kompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Pesuruhjaya suatu amaun wang yang tidak melebihi lima puluh peratus daripada amaun denda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran bertulisnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau apa-apa masa lanjutan yang diberikan oleh Pesuruhjaya, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran mengkompaun itu dibuat, dan mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang disita berkaitan dengan kesalahan itu boleh dilepaskan atau dilucuthakkan oleh Pesuruhjaya, tertakluk kepada apa-apa terma dan syarat yang difikirkannya patut untuk dikenakan mengikut syarat kompaun itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Pesuruhjaya di bawah seksyen ini hendaklah dibayar ke dalam Kumpulan Wang Disatukan Persekutuan. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini, mana-mana orang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, ketua pegawai eksekutif, ketua pegawai operasi, pengurus, setiausaha atau pegawai lain yang seumpamanya dalam pertubuhan perbadanan itu atau yang berupa bertindak atas mana-mana sifat sedemikian atau yang mengikut apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal-ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati telah melakukan kesalahan itu, hendaklah disifatkan telah melakukan kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya, persetujuannya atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga- jaga yang munasabah dan telah menjalankan segala usaha yang wajar untuk mengelakkan pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang di bawah Akta ini boleh dikenakan apa-apa hukuman atau penalti bagi perbuatan, peninggalan, pengabaian atau keingkarannya, dia boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran mana-mana pekerja atau ejennya, atau pekerja ejen itu, jika perbuatan, peninggalan, pengabaian atau keingkaran itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam masa penggajiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen itu semasa bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_133__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen itu dalam masa penggajian pekerja itu dengan ejen itu atau selainnya bagi pihak ejen itu yang bertindak bagi pihak orang itu. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi sesuatu kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Bidang kuasa untuk membicarakan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis lain yang berlawanan, Mahkamah Sesyen hendaklah mempunyai bidang kuasa untuk membicarakan mana-mana kesalahan di bawah Akta ini dan mengenakan hukuman penuh bagi mana-mana kesalahan sedemikian di bawah Akta ini. Penyampaian notis atau dokumen lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136",
      "@type": "akn:clause",
      "eli:number": "136",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyampaian sesuatu notis atau mana-mana dokumen lain kepada mana-mana orang hendaklah dilaksanakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar serah notis atau dokumen lain itu kepada orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan meninggalkan notis atau dokumen lain itu di alamat kediaman atau tempat perniagaan orang itu yang terakhir diketahui dalam suatu sampul yang ditujukan kepada orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantarkan notis atau dokumen lain itu melalui pos dalam suatu surat berdaftar Akuan Terima yang ditujukan kepada orang itu di alamat kediamannya atau tempat perniagaannya yang terakhir diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang kepadanya telah ditujukan suatu surat berdaftar Akuan Terima yang mengandungi apa-apa notis atau dokumen lain yang boleh diberikan di bawah Akta ini diberitahu mengenai hakikat bahawa terdapat suatu surat berdaftar Akuan Terima yang sedang menunggunya di pejabat pos, dan orang itu enggan atau abai untuk mengambil surat berdaftar Akuan Terima itu, notis atau dokumen lain itu hendaklah disifatkan telah disampaikan kepadanya pada tarikh dia diberitahu sedemikian. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_137",
      "@type": "akn:clause",
      "eli:number": "137",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap Pesuruhjaya, Timbalan Pesuruhjaya, Penolong Pesuruhjaya, mana-mana pegawai atau pekhidmat Pesuruhjaya, mana-mana anggota Jawatankuasa Penasihat, mana-mana anggota, pegawai atau pekhidmat Tribunal Rayuan, atau mana-mana pegawai diberi kuasa berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dilakukan atau ditinggalkan olehnya atas sifat yang sedemikian. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_138",
      "@type": "akn:clause",
      "eli:number": "138",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya, Timbalan Pesuruhjaya, Penolong Pesuruhjaya, mana-mana pegawai atau pekhidmat Pesuruhjaya, mana-mana anggota Jawatankuasa Penasihat, mana-mana anggota, pegawai atau pekhidmat Tribunal Rayuan, atau mana-mana pegawai diberi kuasa semasa menunaikan kewajipannya atau melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini atas sifat sedemikian hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Perlindungan terhadap guaman dan prosiding undang- undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
      "@type": "akn:clause",
      "eli:number": "139",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan atau dibuat dalam mana- mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya, Timbalan Pesuruhjaya, Penolong Pesuruhjaya atau mana-mana pegawai atau pekhidmat Pesuruhjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota Jawatankuasa Penasihat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota, pegawai atau pekhidmat Tribunal Rayuan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai diberi kuasa, berkenaan dengan apa-apa perbuatan atau peninggalan yang dilakukan atau ditinggalkan olehnya dengan suci hati atas sifat yang sedemikian. Perlindungan pemberi maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140",
      "@type": "akn:clause",
      "eli:number": "140",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2) dan (3), tiada saksi dalam mana-mana prosiding sivil atau jenayah menurut Akta ini boleh dikehendaki atau dibenarkan untuk menzahirkan nama atau alamat mana-mana pemberi maklumat atau isi dan jenis maklumat yang diterima daripadanya atau untuk menyatakan apa-apa perkara yang mungkin menyebabkan dia diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana komputer, buku, akaun, data berkomputer atau dokumen lain, papan tanda, kad, surat, risalah, lembaran, notis, kelengkapan, peralatan atau barang yang menjadi keterangan atau yang boleh diperiksa dalam mana-mana jua prosiding sivil atau jenayah mengandungi apa-apa entri yang menamakan atau memperihalkan mana-mana pemberi maklumat dalamnya atau yang mungkin menyebabkan dia diketahui, mahkamah hendaklah menyebabkan semua entri sedemikian ditutup daripada penglihatan atau dipadamkan setakat yang perlu untuk melindungi pemberi maklumat itu daripada diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam sesuatu perbicaraan bagi apa-apa kesalahan di bawah Akta ini mahkamah, selepas siasatan penuh tentang kes itu, berpendapat bahawa pemberi maklumat itu dengan sengaja membuat dalam aduannya suatu pernyataan material yang dia tahu atau percaya adalah palsu atau tidak percaya adalah benar, atau jika dalam mana-mana prosiding lain mahkamah berpendapat bahawa keadilan tidak dapat dilaksanakan sepenuhnya antara pihak-pihak dalam prosiding itu tanpa pemberi maklumat itu diketahui, mahkamah boleh menghendaki pengemukaan aduan asal, jika bertulis, dan membenarkan siasatan dan menghendaki penzahiran sepenuhnya tentang pemberi maklumat itu. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141",
      "@type": "akn:clause",
      "eli:number": "141",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi mana-mana maksud Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana- mana undang-undang bertulis atau jika selainnya dibenarkan oleh Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pesuruhjaya, Timbalan Pesuruhjaya, Penolong Pesuruhjaya, mana-mana pegawai atau pekhidmat Pesuruhjaya, mana- mana anggota Jawatankuasa Penasihat, mana-mana anggota, pegawai atau pekhidmat Tribunal Rayuan, mana- mana pegawai diberi kuasa atau mana-mana orang yang menghadiri mana-mana mesyuarat atau pertimbangtelitian Jawatankuasa Penasihat, sama ada semasa atau selepas tempoh jawatan atau penggajiannya, tidak boleh menzahirkan apa-apa maklumat yang diperoleh olehnya semasa menjalankan kewajipannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang lain yang telah melalui apa-apa cara mendapat akses kepada apa-apa maklumat atau dokumen yang berhubungan dengan hal-ehwal Pesuruhjaya boleh menzahirkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Benda yang dilakukan dalam menjangkakan Akta ini akan diperbuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_142",
      "@type": "akn:clause",
      "eli:number": "142",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala perbuatan dan benda yang dilakukan oleh mana-mana orang sebagai persediaan bagi atau dalam menjangkakan Akta ini diperbuat dan apa-apa perbelanjaan yang dilakukan berhubungan dengannya hendaklah disifatkan telah dibenarkan di bawah Akta ini, dengan syarat bahawa perbuatan dan benda yang dilakukan itu adalah selaras dengan niat dan maksud am Akta ini; dan segala hak dan obligasi yang diperoleh atau ditanggung akibat pelakuan perbuatan atau benda itu termasuk apa-apa perbelanjaan yang dilakukan berhubungan dengannya, hendaklah apabila Akta ini mula berkuat kuasa disifatkan sebagai hak dan obligasi Pesuruhjaya. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143",
      "@type": "akn:clause",
      "eli:number": "143",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan yang perlu atau suai manfaat bagi maksud pelaksanaan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan oleh subseksyen (1), Menteri boleh membuat peraturan-peraturan bagi segala atau mana-mana maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia semua perkara yang berhubungan dengan pendaftaran pengguna data di bawah Akta ini, termasuk menetapkan fi pendaftaran dan fi pembaharuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia semua perkara yang perlu bagi pelaksanaan Prinsip Perlindungan Data Peribadi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia tatacara berkenaan dengan pemeriksaan sistem data peribadi, penyiasatan aduan dan pengeluaran notis penguatkuasaan, dan semua perkara lain yang berhubungan dengannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan kesalahan yang boleh dikompaun dan borang yang hendak digunakan dan kaedah dan tatacara bagi pengkompaunan kesalahan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memperuntukkan dan menetapkan apa-apa fi yang kena dibayar berkaitan dengan penyediaan apa-apa perkhidmatan atau apa-apa perkara di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan apa-apa perkara yang baginya Akta ini membuat peruntukan nyata supaya dibuat melalui peraturan- peraturan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan semua perkara lain yang perlu atau suai manfaat untuk ditetapkan bagi melaksanakan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_143",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah seksyen ini atau mana-mana perundangan subsidiari lain yang dibuat di bawah Akta ini boleh menetapkan apa-apa perbuatan atau peninggalan yang berlanggaran dengan peraturan-peraturan atau perundangan subsidiari lain itu menjadi suatu kesalahan dan boleh menetapkan penalti denda tidak melebihi dua ratus lima puluh ribu ringgit atau pemenjaraan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Pencegahan anomali"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144",
      "@type": "akn:clause",
      "eli:number": "144",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, membuat apa-apa ubah suaian kepada peruntukan Akta ini yang nyata padanya adalah perlu atau suai manfaat bagi maksud menghapuskan apa-apa kesulitan atau mencegah apa-apa anomali akibat permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri tidak boleh menjalankan kuasa yang diberikan oleh subseksyen (1) selepas habis tempoh satu tahun dari tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_X__cl_144",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, “ubah suaian” ertinya pindaan, tambahan, pemotongan dan penggantian mana-mana peruntukan Akta ini."
      }
    }
  ]
}
