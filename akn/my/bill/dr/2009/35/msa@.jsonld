      "schema:text": {
        "@language": "ms",
        "@value": "penyusunan, penyesuaian atau pengubahan data peribadi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2009/35/msa@/~part_I__cl_4__list_3__para_b",
