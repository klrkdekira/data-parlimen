    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada tarikh yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta Pengangkutan Awam Darat 2010, tiada apa-apa yang terkandung dalam Akta atau Akta Pengangkutan Awam Darat 2010 boleh menjejaskan mana-mana orang yang bertanggungan untuk didakwa atau dihukum bagi kesalahan yang dilakukan di bawah Akta sebelum tarikh yang ditetapkan, atau apa-apa penyiasatan yang dibuat, prosiding yang diambil atau hukuman yang dikenakan sebelum hari itu berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu sebutan dalam mana-mana undang-undang bertulis yang berkuat kuasa sebaik sebelum tarikh yang ditetapkan mengenai Lembaga yang dibubarkan hendaklah, setakat pemakaiannya bagi Semenanjung Malaysia, ditafsirkan sebagai sebutan mengenai Suruhanjaya. Status lesen, dsb. yang ada di bawah Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Lembaga Pelesenan Kenderaan Perdagangan 1987, kemudian daripada ini disebut sebagai “Akta”, hendaklah terhenti pemakaiannya bagi Semenanjung Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga Pelesenan Kenderaan Perdagangan Semenanjung Malaysia, kemudian daripada ini disebut “Lembaga yang dibubarkan”, adalah dibubarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun ketidakpakaian Akta Lembaga Pelesenan Kenderaan Perdagangan 1987 bagi Semenanjung Malaysia, semua perundangan subsidiari yang dibuat atau yang disifatkan sebagai telah dibuat atau mempunyai kesan di bawah Akta dan berkuat kuasa atau mempunyai kesan pada tarikh yang ditetapkan hendaklah, setakat yang semua perundangan subsidiari itu tidak tak konsisten dengan Akta Pengangkutan Awam Darat 2010 [Akta ], terus berkuat kuasa dan mempunyai kesan di Semenanjung Malaysia seolah-olah perundangan subsidiari itu telah dibuat di bawah Akta Pengangkutan Awam Darat 2010 sehingga semua perundangan subsidiari itu dipinda, dibatalkan atau digantikan oleh mana-mana perundangan subsidiari yang dibuat di bawah Akta Pengangkutan Awam Darat 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa, hak, keistimewaan, liabiliti, obligasi dan kewajipan yang sebaik sebelum tarikh yang ditetapkan merupakan kuasa, hak, keistimewaan, liabiliti, obligasi dan kewajipan yang dipunyai oleh Lembaga yang dibubarkan hendaklah turun kepada Suruhanjaya Pengangkutan Darat, kemudian daripada ini disebut sebagai “Suruhanjaya”, mulai tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua keputusan, arahan dan pemberitahuan yang dibuat atau diberi oleh Lembaga yang dibubarkan menurut Akta hendaklah disifatkan telah dibuat atau diberi oleh Suruhanjaya di bawah Akta Pengangkutan Awam Darat 2010 dan akan terus berkuat kuasa sehingga semua keputusan, arahan dan pemberitahuan itu dipinda, dibatalkan atau digantikan atau sehingga tarikh habis tempoh keputusan, arahan dan pemberitahuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa yang berlawanan, anggota Lembaga yang dibubarkan dan anggota apa-apa jawatankuasa yang dilantik di bawah Akta dan memegang jawatan sebelum tarikh yang ditetapkan itu hendaklah terhenti daripada memegang jawatan itu pada tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang sebaik sebelum tarikh yang ditetapkan itu diambil kerja sebagai pegawai atau pekhidmat Lembaga yang dibubarkan, hendaklah pada tarikh yang ditetapkan itu diberi hak untuk memilih supaya diambil kerja oleh Suruhanjaya dengan terma dan syarat yang tidak kurang baiknya daripada apa yang dinikmatinya sebaik sebelum tarikh yang ditetapkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehinggalah terma dan syarat perkhidmatan termasuklah kelakuan dan tatatertib pekerja-pekerjanya dibuat oleh Suruhanjaya, skim dan terma dan syarat perkhidmatan termasuk kelakuan dan tatatertib pekerja Lembaga yang dibubarkan hendaklah terus terpakai secara mutatis mutandis bagi tiap-tiap orang yang telah memilih di bawah subseksyen (6) untuk diambil kerja oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala wang yang kena dibayar kepada Lembaga yang dibubarkan sebaik sebelum tarikh yang ditetapkan hendaklah kena dibayar kepada Suruhanjaya mulai tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding sama ada guaman atau jenayah atau kausa tindakan yang belum selesai atau yang ada sebaik sebelum tarikh yang ditetapkan, oleh atau terhadap Lembaga yang dibubarkan boleh diteruskan atau dimulakan oleh atau terhadap Suruhanjaya sebagaimana ia boleh diteruskan atau dimulakan oleh atau terhadap Lembaga yang dibubarkan seolah-olah Akta Pengangkutan Awam Darat 2010 tidak diluluskan."
      }
    }
  ]
}
