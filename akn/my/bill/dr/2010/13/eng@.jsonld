      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/13/eng@/~cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 34 the following section: “Prosecution 34. No prosecution for or in relation to any offence under this Act or the regulations shall be instituted except by or with the written consent of the Public Prosecutor.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/13/eng@/~cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/13/eng@/~cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The amendment in subsection (1) shall not affect any criminal or civil proceedings pending in any court. Amendment of section 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/13/eng@/~cl_23",
