      "schema:text": {
        "@language": "en",
        "@value": "in subsections (1), (2), (3), (4) and (6), by substituting for the word “goods” wherever appearing the words “property, document or computerized data”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/13/eng@/~cl_23__para_c",
      "@type": "akn:paragraph",
