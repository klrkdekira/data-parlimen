      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/14/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by inserting after the words “subsection (1)” the words “or (1a)”;"
      }
    },
