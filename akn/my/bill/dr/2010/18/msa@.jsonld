      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4B Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2A) No owner shall deliver or cause to be delivered to any dealer, agent or person acting on behalf of the owner a hire-purchase agreement or any other form or document relating to a hire-purchase agreement which has not been duly completed.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_4__para_b",
