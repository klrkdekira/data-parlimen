      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_15__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
