      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1A) A hire-purchase agreement shall be in the national language or English language.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_3__para_b",
