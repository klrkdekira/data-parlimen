      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “six” dengan perkataan “twelve”. Pindaan seksyen 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 38 Akta ibu dipinda dengan menggantikan perkataan “ten” dengan perkataan “thirty”. Pindaan seksyen 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_13",
      "@type": "akn:clause",
