      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 36 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
