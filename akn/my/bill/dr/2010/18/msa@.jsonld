        "@language": "ms",
        "@value": "dengan menggantikan perkataan “(1) and (2)” dengan perkataan “(1), (2) and (2A)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_4__para_c__subpara_i",
