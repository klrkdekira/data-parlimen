        "@value": "dengan menggantikan perkataan “six months” dengan perkataan “three years”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_17__para_c",
      "@type": "akn:paragraph",
