      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “three” dengan perkataan “ten”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/18/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
