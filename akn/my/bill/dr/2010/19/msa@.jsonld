      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memasukkan selepas perkataan “apa-apa barang larangan” perkataan “atau perkhidmatan larangan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (b)(i), dengan memasukkan selepas perkataan “barang larangan” dan “membekalkan barang” perkataan “atau perkhidmatan larangan” dan “atau perkhidmatan” masing-masingnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d__subpara_iii",
      "@type": "akn:subparagraph",
