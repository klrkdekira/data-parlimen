      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6)— Bahagian baru IIIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d__subpara_i",
      "@type": "akn:subparagraph",
