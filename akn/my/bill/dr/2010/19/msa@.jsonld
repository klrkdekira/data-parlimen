    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_10__para_b"
      ],
