      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23 dalam Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “Larangan terhadap barang” perkataan “dan perkhidmatan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “sebagai barang larangan” perkataan “atau apa-apa perkhidmatan atau kelas perkhidmatan sebagai perkhidmatan larangan,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “atau barang daripada kelas itu” perkataan “atau perkhidmatan atau perkhidmatan daripada kelas itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (2)(b) dan (c), subperenggan (2)(d) (i)(ii) dan (iii), dan perenggan 2(e) dan (f), dengan memasukkan selepas perkataan “barang larangan” di mana-mana jua terdapat perkataan “atau perkhidmatan larangan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/19/msa@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
