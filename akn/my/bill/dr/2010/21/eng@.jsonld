    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by deleting section 86. Amendment of section 90"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 90 of the principal act is amended by substituting for the words “twenty five” the words “one hundred”. Deletion of section 91"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by deleting section 91. Amendment of section 92"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 92 of the principal act is amended by substituting for the word “three” the word “ten”. Amendment of section 93"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 93(1) of the principal act is amended in the proviso by substituting for the words ‘ “twenty five” ’ and the words ‘ “two hundred and fifty thousand” ’ the words ‘ “one hundred” ’ and the words ‘ “one million” ’, respectively. Deletion of Part VIII"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by deleting Part Viii. Deletion of section 100"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by deleting section 100. New section 101a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by inserting after section 101 the following section: “Power of Sessions Court Judge to hear matters in chambers 101a. Subject to the limitations contained in this act, a Sessions Court Judge shall have the power to hear any matter or proceedings in chambers.”. Saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "all pending proceedings and cases which had been registered at the Sessions Court and High Court before the coming into operation of this act shall not be affected by this act and shall continue as if this act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act may be cited as the Subordinate Courts (amendment) act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act comes into operation on a date to be appointed by the Minister by notification in the Gazette. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Subordinate Courts act 1948 [Act 92], which is referred to as the “principal act” in this act, is amended by deleting the words “or Penghulu’s Court” wherever they appear. Amendment of section 2"
      }
    },
