      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Mahkamah Rendah (Pindaan) 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 86. Pindaan seksyen 90"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 90 Akta ibu dipinda dengan menggantikan perkataan “dua puluh lima” dengan perkataan “satu ratus”. Pemotongan seksyen 91"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 91. Pindaan seksyen 92"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 92 Akta ibu dipinda dengan menggantikan perkataan “tiga” dengan perkataan “sepuluh”. Pindaan seksyen 93"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 93(1) Akta ibu dipinda dalam proviso dengan menggantikan perkataan ‘ “dua puluh lima” ’ dan perkataan ‘ “dua ratus lima puluh ribu” ’ dengan perkataan ‘ “satu ratus” ’ dan perkataan ‘ “satu juta” ’, masing-masing. Pemotongan Bahagian VIII"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Bahagian VIII. Pemotongan seksyen 100"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 100. Seksyen baru 101a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 101 seksyen yang berikut: “Kuasa Hakim Mahkamah Sesyen untuk mendengar perkara dalam kamar 101a. Tertakluk kepada batasan yang terkandung dalam Akta ini, Hakim Mahkamah Sesyen hendaklah mempunyai kuasa untuk mendengar apa-apa perkara atau prosiding dalam kamar.”. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua prosiding dan kes yang belum selesai yang telah didaftarkan di Mahkamah Sesyen dan Mahkamah Tinggi sebelum mula berkuat kuasanya Akta ini tidak terjejas oleh Akta ini dan hendaklah diteruskan seolah-olah Akta ini telah tidak diperbuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Mahkamah Rendah (Pindaan) 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Mahkamah Rendah 1948 [Akta 92], yang disebut “Akta ibu” dalam Akta ini, dipinda dengan memotong perkataan “atau Mahkamah Penghulu” di mana-mana jua terdapat. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 2(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “pemastautin tetap” takrif yang berikut: ‘ “Pendaftar” ertinya Pendaftar, Timbalan Pendaftar, Penolong Kanan Pendaftar atau Penolong Pendaftar Mahkamah Rendah;’; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “Penghulu”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 3(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan koma bernoktah dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (c). Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_5",
      "@type": "akn:clause",
