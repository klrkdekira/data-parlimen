      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 5(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/21/msa@/~cl_5__para_a__subpara_ii"
      ],
