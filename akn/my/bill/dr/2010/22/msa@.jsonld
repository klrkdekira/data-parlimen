      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” yang terdapat di hujung perenggan (c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
