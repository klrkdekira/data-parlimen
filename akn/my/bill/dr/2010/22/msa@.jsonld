      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (d) dengan perkataan “; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
