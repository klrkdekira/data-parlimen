      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 52 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_21__para_a",
