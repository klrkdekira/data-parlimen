      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
