      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “Antipemerdagangan Orang” perkataan “dan Antipenyeludupan Migran”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/22/msa@/~cl_8__para_c__subpara_i",
