      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, a fund to be known as the “Perbadanan Stadium Malaysia Fund” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be controlled, maintained and operated by the Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/eng@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
