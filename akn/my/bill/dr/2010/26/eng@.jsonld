        "@language": "en",
        "@value": "FINANCE The Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
