      "schema:text": {
        "@language": "ms",
        "@value": "KETUA PEGAWAI EKSEKUTIF, PEGAWAI DAN PEKHIDMAT PERBADANAN Ketua Pegawai Eksekutif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Ketua Pegawai Eksekutif atas apa-apa terma dan syarat yang ditentukan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah bertanggungjawab bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keseluruhan penjalanan, pentadbiran dan pengurusan fungsi, aktiviti dan hal ehwal hari ke hari Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penyediaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "program, skim, projek dan aktiviti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "anggaran perbelanjaan bagi pelaksanaan program tahunan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "semua anggaran pendapatan, untuk kelulusan Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan semua program, skim dan projek Perbadanan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan keputusan dan arahan Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah menjadi Setiausaha kepada Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah melaksanakan apa-apa kewajipan lain yang diarahkan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menunaikan kewajipannya, Ketua Pegawai Eksekutif hendaklah bertindak di bawah kuasa dan arahan am Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pegawai Eksekutif tidak ada buat sementara di Malaysia atau tidak berupaya untuk sementara oleh sebab sakit atau apa-apa sebab lain untuk melaksanakan kewajipannya, atau jika jawatan Ketua Pegawai Eksekutif adalah kosong pada masa itu, Perbadanan boleh mengarahkan mana-mana pegawai lain untuk melaksanakan kewajipan Ketua Pegawai Eksekutif semasa ketiadaan atau ketidakupayaan sementara itu. Pengambilan khidmat pegawai dan pekhidmat lain Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana peraturan-peraturan yang dibuat di bawah subseksyen (4), Perbadanan boleh mengambil khidmat apa-apa bilangan pegawai dan pekhidmat sebagaimana yang difikirkan wajar dan perlu oleh Perbadanan dan atas apa- apa terma dan syarat sebagaimana yang difikirkan sesuai oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah mempunyai kawalan am ke atas pegawai dan perkhidmat Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun layak untuk diambil berkhidmat sebagai pegawai atau pekhidmat Perbadanan jika dia mempunyai, secara langsung atau tidak langsung, dengan sendirinya atau menerusi pekongsinya, apa-apa syer atau kepentingan dalam mana-mana kontrak atau kontrak yang dicadangkan dengan, untuk atau bagi pihak Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, dengan kelulusan Menteri, membuat peraturan-peraturan berkenaan dengan syarat-syarat perkhidmatan pegawai dan pekhidmatnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mengguna pakai dengan apa-apa gubah suaian yang difikirkannya patut, apa-apa peraturan, kaedah, dasar, pekeliling atau arahan yang diperbuat atau dikeluarkan oleh Kerajaan Persekutuan berhubung dengan apa-apa perkara di bawah Bahagian ini. Bantuan kewangan kepada pegawai, pekhidmat dan orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Perbadanan boleh menyediakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "bayaran faedah persaraan, gratuiti, dan elaun lain yang ditentukan oleh Perbadanan kepada pegawai dan pekhidmat Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "subsidi, pemberian, kemudahan pembiayaan atau kredit, dengan atau tanpa bunga, dan pembiayaan atau pinjaman ihsan lainnya, kepada pegawai dan pekhidmat Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "subsidi, pemberian, kemudahan pembiayaan atau kredit, dengan atau tanpa bunga, bagi maksud perubatan kepada pegawai dan pekhidmat Perbadanan, dan tanggungan mereka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "kemudahan pembiayaan atau kredit, dengan atau tanpa bunga, bagi maksud pendidikan atau biasiswa kepada pegawai dan pekhidmat Perbadanan atau mana-mana orang lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "derma kepada mana-mana orang, atas apa-apa terma dan syarat yang ditentukan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Perbadanan yang dilantik di bawah perenggan 6(1)(a), (d) atau (e) hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang- undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda) selama tempoh yang melebihi dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menghadiri mesyuarat Perbadanan tiga kali berturut-turut tanpa kebenaran Pengerusi atau dalam hal Pengerusi, tanpa kebenaran Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peletakan jawatannya diterima oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang anggota yang dilantik di bawah perenggan 6(1)(a), (d) atau (e) terhenti menjadi anggota Perbadanan, Menteri boleh melantik seorang lain untuk mengisi kekosongan itu bagi baki tempoh yang anggota yang mengosongkan jawatan itu dilantik mengikut peruntukan yang terpakai. Elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Perbadanan hendaklah dibayar elaun pada apa-apa kadar yang ditentukan oleh Menteri setelah berunding dengan Menteri Kewangan. Kuasa Menteri untuk memberikan arahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah bertanggungjawab kepada Menteri, dan Menteri boleh, dari semasa ke semasa, memberikan arahan yang tidak bercanggah dengan peruntukan Akta ini dan Perbadanan hendaklah, dengan secepat mungkin, melaksanakan segala arahan yang diberi itu. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah memberi Menteri, dan mana-mana pihak berkuasa awam sebagaimana yang dinyatakan oleh Menteri, apa-apa penyata, laporan, akaun dan maklumat berkenaan dengan harta dan aktivitinya sebagaimana yang dikehendaki atau diarahkan oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Perbadanan hendaklah, secepat yang dapat dilaksanakan selepas berakhirnya setiap tahun kewangan, menyebabkan dibuat dan dihantar kepada Menteri dan, jika diarahkan sedemikian oleh Menteri, kepada mana- mana pihak berkuasa awam lain suatu laporan yang memperkatakan tentang aktiviti Perbadanan sepanjang tahun kewangan yang sebelumnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Laporan di bawah subseksyen (2) hendaklah dalam apa- apa bentuk dan hendaklah mengandungi apa-apa maklumat yang berhubungan dengan prosiding dan dasar Perbadanan sebagaimana yang dinyatakan oleh Menteri dari semasa ke semasa. Pewakilan fungsi dan kuasa Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, tertakluk kepada subseksyen (2) dan apa-apa syarat, batasan dan sekatan sebagaimana yang difikirkan patut untuk dikenakan, mewakilkan secara bertulis mana-mana fungsi atau kuasanya, kecuali kuasa untuk meminjamkan wang, memberikan pinjaman, menubuhkan syarikat dan membuat peraturan-peraturan, kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana jawatankuasa yang ditubuhkan oleh Perbadanan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai atau pekhidmat Perbadanan, dan mana-mana fungsi atau kuasa yang diwakilkan sedemikian boleh dilaksanakan atau dijalankan oleh anggota, jawatankuasa pegawai atau pekhidmat itu, mengikut mana-mana yang berkenaan, atas nama dan bagi pihak Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota, jawatankuasa, pegawai atau pekhidmat yang diwakilkan dengan fungsi dan kuasa sedemikian hendaklah terikat untuk mematuhi dan mengambil perhatian semua syarat, batasan dan sekatan yang dikenakan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mewakilkan kepada Pengerusi kuasa untuk membenarkan perbelanjaan daripada Kumpulan Wang atau mana- mana wang lain yang terletak hak pada atau di bawah kawalan Perbadanan ke takat yang dinyatakan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pewakilan di bawah seksyen ini tidak menghalang Perbadanan sendiri daripada melaksanakan atau menjalankan pada bila-bila masa mana-mana fungsi atau kuasa yang diwakilkan itu. Perbadanan boleh menubuhkan jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Perbadanan boleh menubuhkan apa-apa jawatankuasa sebagaimana yang difikirkan perlu atau suai manfaat untuk membantunya dalam melaksanakan fungsinya di bawah Akta ini. (2) Perbadanan boleh memilih mana-mana anggotanya untuk menjadi pengerusi sesuatu jawatankuasa yang ditubuhkan di bawah subseksyen (1). (3) Perbadanan boleh melantik mana-mana orang untuk menjadi anggota sesuatu jawatankuasa. (4) Sesuatu jawatankuasa boleh mengawal selia tatacaranya sendiri dan, dalam menjalankan kuasanya di bawah subseksyen ini, jawatankuasa itu hendaklah tertakluk kepada dan bertindak mengikut apa-apa arahan yang diberikan kepada jawatankuasa itu oleh Perbadanan. (5) Mesyuarat sesuatu jawatankuasa hendaklah diadakan pada bila-bila masa dan di mana-mana tempat sebagaimana yang ditentukan oleh pengerusi jawatankuasa itu. (6) Sesuatu jawatankuasa boleh mengundang mana-mana orang yang bukan anggota jawatankuasa itu untuk menghadiri mana- mana mesyuarat jawatankuasa itu, bagi maksud menasihatinya mengenai apa-apa perkara yang dibincangkan tetapi orang itu tidak berhak untuk mengundi dalam mesyuarat itu. (7) Anggota sesuatu jawatankuasa atau mana-mana orang yang diundang di bawah subseksyen (6) untuk menghadiri mana- mana mesyuarat sesuatu jawatankuasa boleh dibayar apa-apa elaun dan perbelanjaan lain sebagaimana yang ditentukan oleh Perbadanan. (8) Seseorang anggota jawatankuasa hendaklah memegang jawatan bagi apa-apa tempoh sebagaimana yang dinyatakan dalam surat cara pelantikannya dan layak untuk dilantik semula. (9) Perbadanan boleh, pada bila-bila masa membatalkan pelantikan mana-mana anggota sesuatu jawatankuasa. (10) Seseorang anggota jawatankuasa boleh pada bila-bila masa meletakkan jawatannya melalui suatu notis bertulis yang dialamatkan kepada Pengerusi Perbadanan. (11) Jawatankuasa hendaklah menyebabkan— (a) minit semua mesyuaratnya disenggara dan disimpan dalam bentuk yang sepatutnya; dan (b) salinan minit semua mesyuaratnya diserahkan kepada Perbadanan seberapa segera yang boleh dilaksanakan. (12) Mana-mana minit yang dibuat mengenai mesyuarat jawatankuasa hendaklah, jika ditandatangani dengan sewajarnya, boleh diterima sebagai keterangan dalam semua prosiding undang- undang tanpa bukti selanjutnya. (13) Tiap-tiap mesyuarat jawatankuasa yang berkenaan dengan prosidingnya minit telah dibuat menurut subseksyen (11) dan (12) hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota dalam mesyuarat itu layak dengan sewajarnya untuk bertindak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pertubuhan perbadanan dengan nama “Perbadanan Stadium Malaysia” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan adalah kekal turun-temurun dan mempunyai suatu meterai perbadanan dan boleh membawa guaman dan dibawa guaman terhadapnya atas nama perbadanannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada dan bagi maksud Akta ini, Perbadanan boleh, atas apa-apa terma yang disifatkannya patut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih dan harta tak alih; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memindahhakkan, menyerahhakkan, menyerahkan, memulangkan, menggadai, menggadai janji, mendemis, memajakkan, menyerahhak semula, memindahkan atau selainnya melupuskan, atau memperlakukan, mana-mana harta alih atau harta tak alih atau apa-apa kepentingan yang terletak hak pada Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Objektif Perbadanan adalah untuk membangunkan, mengendalikan dan menguruskan stadium mengikut standard yang ditentukan oleh Perbadanan. Fungsi Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Perbadanan adalah seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menubuhkan, menguruskan, mengendalikan dan menyenggarakan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan dasar dan program pembangunan bagi menjamin daya maju stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memajukan dan menambah baik stadium dan untuk menyediakan dan melengkapkan stadium dengan loji, jentera, kelengkapan dan perkakasan sebagaimana yang difikirkan sesuai oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mempromosikan stadium, di peringkat kebangsaan dan antarabangsa, sebagai suatu tempat serbaguna untuk acara sukan, rekreasi, kebudayaan, pendidikan, komersial dan hiburan dan apa-apa acara lain yang difikirkan patut oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membangunkan dan menyediakan di stadium apa-apa kemudahan dan perkhidmatan bersifat komersial yang melengkapi stadium, termasuklah tempat penginapan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan dan mempromosikan penggunaan stadium oleh mana-mana orang, sama ada tempatan atau asing, atas apa-apa terma dan syarat yang difikirkan patut oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyediakan perkhidmatan teknikal, nasihat, perundingan dan perkhidmatan lain yang berkaitan dengan sukan dan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bekerjasama dan membuat perkiraan dengan mana-mana orang yang berminat dalam pembangunan kemudahan pendidikan, perubatan dan penyelidikan bagi sukan di stadium, dan jika sesuai, di tempat lain untuk pembangunan kemudahan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memajukan sistem dan proses yang akan menjadikan stadium mudah, mampu dan menarik kepada orang awam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan apa-apa fungsi lain sebagaimana yang difikirkannya patut untuk membolehkannya melaksanakan fungsinya secara berkesan atau yang bersampingan dengan pelaksanaan fungsinya. Kuasa Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mempunyai kuasa untuk melakukan segala perkara yang suai manfaat atau yang secara munasabahnya perlu bagi atau bersampingan dengan penjalanan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kuasa Perbadanan hendaklah termasuk kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan segala aktiviti, khususnya aktiviti bersifat komersial, yang didapati olehnya adalah perlu, berfaedah atau sesuai bagi atau berkaitan dengan pelaksanaan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil inisiatif dan membuat kajian mengenai kemungkinan pembangunan dan pembangunan semula stadium dan untuk mencadangkan pelan yang menggariskan aktiviti pembangunan atau pembangunan semula serta kaji selidik untuk menentukan sama ada pengusahaan dan pelaksanaan pembangunan atau pembangunan semula stadium itu boleh dilaksanakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membina apa-apa bangunan atas apa-apa harta tak alih Perbadanan dan menyediakan serta menyiapkan harta itu bagi apa-apa sukan, permainan, rekreasi, kegiatan masa lapang, pameran dan perarakan yang mungkin sesuai atau mudah untuk diadakan di situ, untuk menyediakan astaka, gimnasium, ruang hidangan ringan, kedai, gerai, tandas dan apa-apa kemudahan lain yang berkaitan yang difikirkan patut oleh Perbadanan dan untuk menyenggarakan atau membina semula apa-apa bangunan yang terdapat di atas tanah Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan atau menggalakkan apa-apa sukan, permainan, rekreasi, kegiatan masa lapang, pameran dan perarakan, dan untuk memberikan dan menyumbang hadiah, anugerah dan kepujian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengusahakan aktiviti yang berhubungan dengan penyelidikan dan pembangunan aktiviti, perkhidmatan dan perkara lain yang berkaitan dengan sukan dan stadium, dan untuk menugaskan mana-mana orang atau badan untuk menjalankan penyelidikan dan pembangunan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bekerjasama dengan atau bertindak sebagai ejen yang diberi kuasa bagi, atau selainnya bertindak bersama dengan atau bagi pihak, mana-mana syarikat atau perbadanan, atau mana-mana badan atau orang, sama ada tempatan atau asing bagi maksud pembangunan kemudahan dan perkhidmatan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghubungi mana-mana pelabur atau pelabur berpotensi, sama ada tempatan atau asing secara langsung atau tidak langsung, bagi menggalakkan pelaburan dalam pembangunan, pengendalian dan pengurusan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk berhubung dan bekerjasama dengan pihak berkuasa Negeri berkenaan dengan aktiviti yang berhubungan dengan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memohon bagi dan menerima pemberimilikan atau pemindahan hakmilik tanah untuk pembangunan, pengendalian dan pengurusan stadium;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana ejen sebagaimana yang difikirkannya patut bagi maksud melaksanakan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan fi, kos, levi, caruman atau apa-apa caj lain yang disifatkannya patut bagi memberi kuat kuasa kepada mana-mana fungsi atau kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat segala perkara yang suai manfaat atau perlu bagi atau bersampingan dengan pelaksanaan fungsinya di bawah Akta ini. Keanggotaan Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, yang hendaklah dilantik oleh Menteri daripada kalangan anggota;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "lima orang wakil Kerajaan Persekutuan yang terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang bertanggungjawab bagi belia dan sukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Jabatan Perdana Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian Kewangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang wakil daripada agensi lain Kerajaan Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "lima orang untuk mewakili organisasi sukan yang hendaklah dilantik oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "lima orang lain yang hendaklah dilantik oleh Menteri yang, pada pendapat Menteri, mempunyai pengalaman, menunjukkan keupayaan dan profesionalisme dalam perkara yang berhubungan dengan pembangunan, pengendalian dan pengurusan stadium, kompleks sukan dan kemudahan sukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas budi bicaranya, melantik seorang Timbalan Pengerusi daripada kalangan anggota Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual hendaklah terpakai bagi Perbadanan. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa syarat yang dinyatakan dalam surat cara pelantikannya, seorang anggota Perbadanan yang dilantik dibawah perenggan 6(1)(a), (d) atau (e) hendaklah, melainkan jika dia terlebih dahulu meletakkan atau mengosongkan jawatannya atau pelantikannya terlebih dahulu dibatalkan, memegang jawatan bagi suatu tempoh yang tidak melebihi dua tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perbadanan yang dilantik di bawah perenggan 6(1)(a), (d) atau (e) adalah layak untuk dilantik semula tetapi tiada anggota boleh memegang jawatan itu bagi tempoh lebih daripada dua penggal sama ada secara berterusan atau selainnya. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila jawatan Pengerusi kosong atau Pengerusi tidak hadir bertugas di Malaysia atau Pengerusi, atas apa-apa sebab lain, tidak dapat menjalankan kewajipan jawatannya, anggota yang dilantik di bawah subseksyen 6(2) hendaklah secara sementara bertindak sebagai Pengerusi, dan jika anggota itu atas apa-apa sebab tidak dapat bertindak di bawah subseksyen ini, anggota di bawah subperenggan 6(1)(c)(i) hendaklah bertindak sebagai Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota yang bertindak sebagai Pengerusi di bawah subseksyen (1) hendaklah disifatkan sebagai Pengerusi. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan mana-mana anggota di bawah perenggan 6(1)(a), (d) atau (e) boleh pada bila-bila masa dibatalkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota boleh pada bila-bila masa meletakkan jawatannya melalui suatu notis bertulis yang dialamatkan kepada Menteri. Pengosongan jawatan dan pengisian kekosongan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KEWANGAN Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu kumpulan wang yang dikenali sebagai “Kumpulan Wang Perbadanan Stadium Malaysia” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dikawal, disenggara dan dikendalikan oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang diperuntukkan oleh Parlimen bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diperoleh melalui pengendalian projek, skim atau perusahaan yang dibiayai daripada Kumpulan Wang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diperoleh atau didapati daripada apa-apa harta, pelaburan, gadai janji, pajakan, penyewaan, gadaian atau debentur yang diperoleh oleh atau yang terletak hak pada Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa harta, pelaburan, gadai janji, gadaian atau debentur yang diperoleh oleh atau terletak hak pada Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "fi, kos, levi, caruman dan caj lain yang dikenakan oleh Perbadanan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada perkhidmatan perundingan dan nasihat dan apa-apa perkhidmatan lain yang diberikan oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "derma atau sumbangan yang diterima daripada mana-mana organisasi di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang atau harta lain yang boleh dalam apa-apa cara menjadi kena dibayar kepada atau teletak hak pada Perbadanan berkenaan dengan apa-apa perkara yang bersampingan dengan fungsi dan kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang lain yang diterima secara sah oleh Perbadanan. Perbelanjaan yang hendaklah dipertanggungkan pada Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan secara sah oleh Perbadanan, termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "saraan, elaun dan perbelanjaan lain anggota Perbadanan dan mana-mana jawatankuasa dan pegawai dan pekhidmat Perbadanan termasuk pemberian pinjaman dan bayaran pendahuluan, elaun persaraan, faedah persaraan, pencen dan gratuiti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perlindungan insurans bagi pegawai dan pekhidmat Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "kos yang ditanggung dalam memberikan bantuan bagi kebajikan pegawai dan pekhidmat Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "fi dan kos perundangan dan apa-apa fi dan kos lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos dan perbelanjaan lain yang dilakukan atau disetujui terima secara sah oleh Perbadanan dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa loji, kelengkapan, jentera dan bahan, memperoleh tanah dan aset lain, mendirikan bangunan dan menjalankan apa-apa kerja dan pengusahaan lain dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan bantuan kewangan di bawah seksyen 18; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya membayar apa-apa belanja bagi menguatkuasakan peruntukan-peruntukan Akta ini. Pemeliharaan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan Perbadanan untuk memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini supaya dapat dipastikan bahawa jumlah pendapatan Perbadanan mencukupi untuk memenuhi semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya pada akaun hasilnya, termasuk susut nilai dan bunga atas modal, dari setahun ke setahun. Kumpulan wang rizab"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menubuhkan dan menyenggara suatu kumpulan wang rizab dalam Kumpulan Wang. Perbelanjaan dan penyediaan anggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Perbadanan setakat amaun yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendaklah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum 30 September setiap tahun, Perbadanan hendaklah mengemukakan kepada Menteri suatu anggaran perbelanjaan, termasuklah perbelanjaan bagi pembangunan, pengendalian atau pengurusan stadium, bagi tahun yang berikutnya dalam apa-apa bentuk dan mengandungi apa-apa butir sebagaimana yang diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum awal tahun yang berikutnya, memberitahu Perbadanan mengenai amaun yang dibenarkan bagi keseluruhan perbelanjaan atau mengenai amaun yang dibenarkan bagi setiap jenis perbelanjaan berdasarkan anggaran yang disediakan di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh, pada bila-bila masa, mengemukakan kepada Menteri suatu anggaran tambahan perbelanjaannya bagi mana-mana satu tahun dan Menteri boleh membenarkan keseluruhan atau mana-mana bahagian perbelanjaan tambahan yang termasuk dalam anggaran tambahan itu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengarahkan Perbadanan supaya mengemukakan suatu salinan anggaran atau anggaran tambahan itu, mengikut mana-mana yang berkenaan, kepada mana-mana pihak berkuasa awam lain sebagaimana yang dinyatakan dalam arahan itu. Tahun kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Perbadanan hendaklah bermula pada 1 Januari dan berakhir pada 31 Disember setiap tahun. Akaun dan laporan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menyebabkan supaya akaun yang sewajarnya bagi Kumpulan Wang disimpan dan hendaklah, dengan seberapa segera yang dapat dilaksanakan selepas berakhirnya setiap tahun kewangan, menyebabkan supaya disediakan bagi tahun kewangan itu suatu penyata akaun Perbadanan yang hendaklah mengandungi suatu kunci kira-kira dan akaun pendapatan dan perbelanjaan. Akaun bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah membuka dan menyenggarakan akaun atau akaun-akaun dengan bank tertentu di Malaysia sebagaimana yang difikirkan patut oleh Perbadanan, dan tiap-tiap akaun hendaklah dikendalikan setakat yang boleh dilaksanakan melalui cek yang ditandatangani oleh mana-mana orang yang diberi kuasa oleh Perbadanan bagi maksud itu dari semasa ke semasa. Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbadanan Stadium Malaysia 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“ditetapkan” ertinya ditetapkan melalui kaedah-kaedah, peraturan- peraturan atau perintah yang disiarkan dalam Warta; “jawatankuasa” ertinya suatu jawatankuasa yang ditubuhkan oleh Perbadanan di bawah seksyen 15; “Ketua Pegawai Eksekutif” ertinya Ketua Pegawai Eksekutif yang dilantik di bawah subseksyen 16(1) dan termasuklah mana- mana pegawai yang diarahkan di bawah subseksyen 16(6) untuk melaksanakan tugas Ketua Pegawai Eksekutif; “Kumpulan Wang” ertinya Kumpulan Wang Perbadanan Stadium Malaysia yang ditubuhkan di bawah seksyen 19; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi sukan; “Pengerusi” ertinya Pengerusi Perbadanan yang dilantik di bawah seksyen 6; “Perbadanan” ertinya Perbadanan Stadium Malaysia yang ditubuhkan di bawah seksyen 3; “stadium” ertinya mana-mana stadium, kompleks sukan dan kemudahan sukan yang diwujudkan oleh Perbadanan atau di bawah skop Perbadanan; “tarikh yang ditetapkan” ertinya tarikh Akta ini mula berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_32"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUASA LAIN PERBADANAN Kuasa untuk meminjam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_39"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Kesalahan kerana memberikan maklumat palsu atau mengelirukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMANSUHAN, PENGECUALIAN DAN PERALIHAN Pemansuhan dan pembubaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perbadanan Stadium Merdeka 1963 [Akta 433] (“Akta dimansuhkan”) dimansuhkan dan Perbadanan Stadium Merdeka (“Perbadanan dibubarkan”) yang ditubuhkan di bawah Akta dimansuhkan dibubarkan mulai tarikh yang ditetapkan. Pemindahan kuasa, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa, hak, keistimewaan, liabiliti, obligasi dan kewajipan yang sebaik sebelum tarikh yang ditetapkan dipunyai oleh Perbadanan dibubarkan hendaklah dipindahkan mulai tarikh itu kepada Perbadanan yang ditubuhkan oleh Akta ini. Pemindahan harta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua tanah yang sebelum tarikh yang ditetapkan terletak hak pada, atau dirizabkan di bawah mana-mana undang-undang bertulis berkaitan dengan tanah bagi maksud Perbadanan dibubarkan hendaklah, pada tarikh itu, dengan kuasa Akta ini, terletak hak pada atau disifatkan dirizabkan bagi maksud Perbadanan yang ditubuhkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua harta dan aset, selain tanah, yang sebaik sebelum tarikh yang ditetapkan terletak hak pada Perbadanan dibubarkan atau pada mana-mana orang bagi pihak Perbadanan dibubarkan, mengikut mana-mana yang berkenaan hendaklah, pada tarikh itu terletak hak pada Perbadanan yang ditubuhkan di bawah Akta ini. Kontrak sedia ada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua surat ikatan, bon, perjanjian, surat cara dan susunan kerja yang wujud sebelum tarikh yang ditetapkan dan menyentuh mana- mana harta yang dipindahmilikkan di bawah seksyen 42 hendaklah mempunyai kuat kuasa dan berkesan sepenuhnya terhadap atau dengan memihak kepada Perbadanan yang ditubuhkan oleh Akta ini dan hendaklah boleh dikuatkuasakan sepenuhnya dan dengan seberkesannya seolah-olah, sebagai ganti Perbadanan dibubarkan atau mana-mana orang yang bertindak bagi pihak Perbadanan dibubarkan, Perbadanan yang telah dinamakan dalamnya atau menjadi pihak kepadanya. Pemindahan wang dalam kumpulan wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang ada di dalam atau kena dibayar kepada kumpulan wang Perbadanan dibubarkan hendaklah pada tarikh yang ditetapkan, dipindahkan dan disifatkan menjadi sebahagian daripada Kumpulan Wang yang ditubuhkan di bawah seksyen 19. Keanggotaan Perbadanan dibubarkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perkara yang berlawanan, anggota Perbadanan dibubarkan dan anggota mana-mana jawatankuasa yang dilantik di bawah Akta dimansuhkan yang memegang jawatan sebelum tarikh yang ditetapkan hendaklah terhenti daripada memegang jawatan pada tarikh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua dalam subseksyen (1) boleh menjejaskan kebertanggungjawaban anggota Perbadanan dibubarkan yang tamat tempoh jawatannya dan seberapa segera yang boleh dilaksanakan selepas tarikh yang ditetapkan, Perbadanan dibubarkan hendaklah menyediakan dan mengemukakan kepada Menteri suatu laporan termasuklah penyata kewangan yang dikehendaki di bawah Akta dimansuhkan, tetapi laporan itu hendaklah terhad kepada tempoh dari 1 Januari tahun yang berkenaan hingga ke hari sebelum tarikh yang ditetapkan. Penerusan pegawai dan pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang sebaik sebelum tarikh yang ditetapkan diambil khidmat sebagai pegawai dan pekhidmat Perbadanan dibubarkan hendaklah, pada tarikh yang ditetapkan, disifatkan telah diambil khidmat oleh Perbadanan yang ditubuhkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang sebaik sebelum tarikh yang ditetapkan telah diambil khidmat sebagai pegawai dan pekhidmat Perbadanan dibubarkan hendaklah, pada tarikh yang ditetapkan, diambil khidmat sebagai pegawai atau pekhidmat Perbadanan yang ditubuhkan oleh Akta ini atas terma dan syarat perkhidmatan yang tidak kurang baiknya daripada terma dan syarat perkhidmatan yang dia berhak kepadanya sebaik sebelum tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika perubahan dibuat pada atau selepas tarikh yang ditetapkan berkenaan dengan syarat perkhidmatan pegawai dan pekhidmat Perbadanan dibubarkan yang disifatkan di bawah subseksyen (1) telah diambil khidmat oleh Perbadanan yang ditubuhkan oleh Akta ini, mereka hendaklah diberi pilihan sama ada untuk terus tertakluk kepada syarat perkhidmatan yang sedia ada atau tertakluk kepada syarat perkhidmatan yang baru. Penerusan prosiding sivil dan jenayah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemansuhan di bawah seksyen 40 atau apa-apa jua yang terkandung dalam Akta ini tidak boleh menjejaskan apa-apa liabiliti seseorang untuk didakwa atau dihukum bagi kesalahan yang dilakukan di bawah Akta dimansuhkan sebaik sebelum tarikh yang ditetapkan, atau apa-apa prosiding yang dibawa sebelum tarikh itu berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding, sama ada sivil atau jenayah, atau kausa tindakan yang belum diputuskan atau yang wujud sebaik sebelum tarikh yang ditetapkan oleh atau terhadap Perbadanan dibubarkan atau mana-mana orang yang bertindak bagi pihak Perbadanan dibubarkan boleh diteruskan atau dimulakan oleh atau terhadap Perbadanan yang ditubuhkan oleh Akta ini sebagaimana yang boleh dilakukan oleh atau terhadap Perbadanan dibubarkan atau orang itu jika Akta ini tidak diperbuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rayuan yang dibawa atau apa-apa kebenaran untuk merayu yang dipohon pada atau selepas tarikh yang ditetapkan terhadap sesuatu keputusan yang diberikan sebaik sebelum tarikh yang ditetapkan dalam mana-mana prosiding undang-undang yang Perbadanan dibubarkan menjadi suatu pihak kepadanya boleh dibawa oleh atau terhadap Perbadanan yang ditubuhkan oleh Akta ini. Sebutan dalam undang-undang atau dokumen mengenai Perbadanan dibubarkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu sebutan dalam mana-mana undang-undang atau dokumen yang berkuat kuasa sebelum tarikh yang ditetapkan mengenai Perbadanan dibubarkan hendaklah ditafsirkan sebagai sebutan mengenai Perbadanan yang ditubuhkan oleh Akta ini. Penerusan penggunaan nama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun di dalam seksyen 40 dan 48, Perbadanan yang ditubuhkan oleh Akta ini boleh terus menggunakan nama “Perbadanan Stadium Merdeka” bagi maksud mengekalkan nama baik atau bagi apa-apa maksud yang difikirkan patut oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang menzahirkan atau memberikan maklumat kepada Perbadanan yang dia ketahui atau dia ada sebab untuk percaya adalah palsu atau mengelirukan, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit. Kewajipan untuk mengekalkan kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi maksud Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis, tiada anggota, pegawai atau pekhidmat Perbadanan, atau orang yang diundang untuk menghadiri mana-mana mesyuarat Perbadanan atau jawatankuasa boleh menzahirkan apa-apa maklumat yang telah diperolehnya semasa melaksanakan kewajipannya dan yang tidak disiarkan menurut Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya. Perlindungan terhadap tindakan guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tindakan tidak boleh diambil atau pendakwaan tidak boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota Perbadanan, mana-mana anggota jawatankuasa, atau mana-mana pegawai, pekhidmat atau ejen Perbadanan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain yang bertindak dengan sah bagi pihak Perbadanan, berkenaan dengan apa-apa perbuatan atau peninggalan yang dilakukan atau ditinggalkan olehnya dengan suci hati atas sifat yang sedemikian. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi mana-mana tindakan, guaman, pendakwaan atau prosiding terhadap Perbadanan atau terhadap mana-mana anggota, mana-mana anggota sesuatu jawatankuasa, atau mana- mana pegawai, pekhidmat atau ejen Perbadanan berkenaan dengan apa-apa perbuatan, keabaian, keingkaran atau peninggalan yang dibuat atau dilakukan olehnya atas sifat sedemikian. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Perbadanan, atau mana-mana anggota sesuatu jawatankuasa, atau mana-mana pegawai, pekhidmat atau ejen Perbadanan, semasa menunaikan kewajipannya di bawah Akta ini sebagai anggota, pegawai, pekhidmat atau ejen, hendaklah disifatkan sebagai pekhidmat awam dalam pengertian Kanun Keseksaan [Akta 574]. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Perbadanan, membuat peraturan-peraturan yang perlu bagi melaksanakan peruntukan Akta ini dengan lebih baik atau bagi menetapkan apa- apa jua yang boleh atau dikehendaki untuk ditetapkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan- peraturan boleh dibuat bagi atau berkenaan dengan semua atau mana-mana perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan fi, kos, levi, caruman atau apa-apa caj lain dalam hal-hal tertentu sebagaimana yang ditentukan oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan fi atau caj bagi perkhidmatan yang disediakan oleh Perbadanan dan untuk kemasukan orang ke stadium atau ke mana-mana pameran atau aktiviti yang dianjurkan atau dikendalikan oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia kemasukan atau pengeluaran mana-mana orang atau benda ke dalam atau dari stadium yang diuruskan atau dikawal oleh Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenai penjagaan, perlindungan dan pengurusan tanah dan bangunan yang dimiliki oleh atau di bawah kawalan dan pengurusan Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi apa-apa perkara lain yang dijangkakan oleh, atau yang perlu bagi memberikan kuat kuasa sepenuhnya peruntukan-peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah seksyen ini boleh menetapkan apa-apa tindakan yang melanggar peraturan-peraturan itu menjadi suatu kesalahan dan boleh menetapkan penalti denda tidak melebihi sepuluh ribu ringgit atau pemenjaraan selama tempoh tidak melebihi dua tahun atau kedua-duanya, dan dalam hal suatu kesalahan yang berterusan, boleh menetapkan denda tambahan sebanyak satu ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari kesalahan itu berterusan selepas sabitan. Tindakan yang dilakukan pada menjangkakan pembuatan Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala perbuatan dan perkara yang dilakukan bagi pihak Perbadanan sebagai persediaan bagi atau pada menjangkakan pembuatan Akta ini dan apa-apa perbelanjaan yang dilakukan berhubung dengannya hendaklah disifatkan telah dibenarkan di bawah Akta ini, dengan syarat bahawa perbuatan dan perkara yang dilakukan itu selaras dengan niat dan maksud am Akta ini; dan segala hak dan obligasi yang diperoleh atau ditanggung akibat daripada tindakan atau perkara itu termasuk perbelanjaan yang ditanggung berhubung dengannya hendaklah, setelah Akta ini mula berkuat kuasa, disifatkan sebagai hak dan obligasi Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh dari semasa ke semasa, dengan kelulusan Menteri dan Menteri Kewangan, meminjam, pada apa-apa kadar bunga dan bagi apa-apa tempoh dan atas apa-apa terma mengenai masa dan cara pembayaran balik dan selainnya sebagaimana yang diluluskan oleh Menteri dan Menteri Kewangan, apa-apa jumlah wang yang dikehendaki oleh Perbadanan bagi memenuhi mana- mana obligasinya atau menunaikan mana-mana kewajipannya. Pelaburan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang Perbadanan hendaklah, setakat yang tidak dikehendaki untuk dibelanjakan oleh Perbadanan di bawah Akta ini, dilaburkan dengan apa-apa cara yang diluluskan oleh Menteri dan Menteri Kewangan. Kuasa untuk mengambil khidmat ejen, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mengambil khidmat, melantik dan membayar ejen, kontraktor dan penasihat teknikal, termasuklah peguam bela dan peguam cara, jurubank, broker saham, juruukur, penilai dan orang lain, untuk menjalankan apa-apa urusan, melaksanakan apa- apa projek, skim atau perusahaan, atau melakukan apa-apa tindakan yang dikehendaki dijalankan atau dilakukan dalam pelaksanaan fungsinya, penjalanan kuasanya atau penunaian kewajipannya atau bagi melaksanakan maksud Akta ini dengan lebih baik. Pengkomersialan dapatan penyelidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh membuat tersedia apa-apa dapatan penyelidikan yang terletak hak pada Perbadanan kepada mana-mana orang atau badan tertakluk kepada apa-apa syarat dan pembayaran apa-apa fi, royalti atau balasan lain, jika ada, sebagaimana yang ditentukan oleh Perbadanan dengan kelulusan Menteri bagi maksud pengkomersialan. Kuasa untuk menubuhkan syarikat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh menubuhkan syarikat di bawah Akta Syarikat 1965 [Akta 125] untuk menjalankan dan mempunyai tanggungjawab, mengendalikan dan menguruskan apa-apa projek, skim atau perusahaan yang telah dirancangkan atau diusahakan oleh Perbadanan pada melaksanakan fungsinya atau menjalankan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 6(3)] Mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah bermesyuarat pada masa dan tempat yang ditentukan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan mesyuarat Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi yang mempengerusikan sesuatu mesyuarat Perbadanan dan empat orang anggota lain hendaklah membentuk suatu kuorum pada mana- mana mesyuarat Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota yang hadir pada mesyuarat Perbadanan berhak kepada satu undi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mengenai sesuatu persoalan untuk diputuskan oleh Perbadanan terdapat bilangan undi yang sama banyak, Pengerusi hendaklah mempunyai undi pemutus di samping undi biasanya. Perbadanan boleh mengundang orang lain ke mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh mengundang mana-mana orang untuk menghadiri sesuatu mesyuarat atau penimbangtelitian Perbadanan bagi maksud menasihatinya mengenai apa-apa perkara yang dibincangkan, tetapi orang itu tidak berhak untuk mengundi pada mesyuarat atau penimbangtelitian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subperenggan (1) boleh dibayar apa-apa elaun dan perbelanjaan lain sebagaimana yang ditentukan oleh Perbadanan. Meterai Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah mempunyai suatu meterai perbadanan yang hendaklah mengandungi suatu tanda yang diluluskan oleh Perbadanan dan meterai itu boleh dipecahkan, ditukar, diubah atau dibuat baru sebagaimana yang difikirkan patut oleh Perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai Perbadanan hendaklah disimpan dalam jagaan Ketua Pegawai Eksekutif atau mana-mana pegawai lain yang dibenarkan oleh Perbadanan, dan hendaklah ditentusahkan oleh Ketua Pegawai Eksekutif atau mana-mana orang yang diberi kuasa atau mana-mana pegawai yang diberi kuasa secara bertulis oleh Ketua Pegawai Eksekutif; dan semua surat ikatan, dokumen dan surat cara lain yang berupa sebagai dimeterai dengan meterai tersebut, yang ditentusahkan sebagaimana yang disebut terdahulu, hendaklah, sehingga dibuktikan sebaliknya, disifatkan telah disempurnakan dengan sah: Dengan syarat bahawa apa-apa dokumen atau surat cara yang jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan tidak dikehendaki supaya dimeteraikan boleh disempurnakan dengan cara yang sama oleh Perbadanan; dan mana-mana dokumen atau surat cara itu boleh disempurnakan bagi pihak Perbadanan oleh mana-mana pegawai atau pekhidmat Perbadanan yang diberi kuasa secara am atau khusus oleh Perbadanan bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan bagi Perbadanan hendaklah diberi pengiktirafan rasmi dan kehakiman. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perbadanan yang mempunyai, secara langsung atau tidak langsung, sendiri atau melalui pekongsinya, mana-mana kepentingan dalam mana-mana syarikat atau perusahaan yang dengannya Perbadanan bercadang untuk membuat kontrak atau yang mempunyai apa-apa kepentingan dalam mana-mana kontrak itu atau dalam mana-mana perkara yang dibincangkan oleh Perbadanan hendaklah menzahirkan kepada Perbadanan hakikat kepentingan dan jenis kepentingannya itu, dan penzahiran yang sedemikian hendaklah direkodkan dalam minit Perbadanan dan, melainkan jika dibenarkan secara khusus kepadanya oleh Pengerusi, anggota itu tidak boleh mengambil bahagian dalam apa-apa penimbangtelitian atau keputusan Perbadanan yang berhubungan dengan kontrak atau perkara itu. Minit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan hendaklah menyebabkan minit semua mesyuaratnya disenggara dan disimpan dalam bentuk yang sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit yang dibuat mengenai mesyuarat Perbadanan hendaklah, jika ditandatangani dengan sewajarnya, boleh diterima sebagai keterangan dalam semua prosiding undang-undang tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap mesyuarat Perbadanan yang berkenaan dengan prosidingnya minit telah dibuat sedemikian rupa hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota dalam mesyuarat itu layak dengan sewajarnya untuk bertindak. Kesahan tindakan dan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perbuatan yang dilakukan atau prosiding yang diambil di bawah Akta ini boleh dipersoalkan atas alasan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu kekosongan dalam keanggotaan, atau sesuatu kecacatan dalam penubuhan Perbadanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pelanggaran oleh mana-mana anggota Perbadanan terhadap peruntukan perenggan 4; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu peninggalan, kecacatan atau ketidakteraturan yang tidak menyentuh merit hal itu. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Perbadanan boleh menentukan tatacaranya sendiri. Anggota Perbadanan hendaklah menumpukan masa kepada urusan Perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/26/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Perbadanan hendaklah menumpukan masa kepada urusan Perbadanan sebagaimana yang perlu bagi menunaikan kewajipannya dengan berkesan."
      }
    }
  ]
}
