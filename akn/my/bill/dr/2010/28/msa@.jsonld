      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11a Akta ibu dipinda dengan menggantikan perkataan “moneylender” dengan perkataan “licensee”. Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_28",
      "@type": "akn:clause",
