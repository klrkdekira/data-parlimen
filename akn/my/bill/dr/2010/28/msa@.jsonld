      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), (3), (7) dan (8), dengan menggantikan perkataan “police officer”, di mana-mana jua terdapat, dengan perkataan “a senior police officer”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
