      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu dipinda dengan menggantikan perkataan “moneylender”, di mana-mana jua terdapat, dengan perkataan “licensee”. Pindaan seksyen 17a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 1(2) Akta ibu dipinda dengan menggantikan perkataan “States of Peninsular Malaysia only” dengan perkataan “whole of Malaysia”. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
