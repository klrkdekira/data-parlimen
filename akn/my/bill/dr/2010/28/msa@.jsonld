      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “any premises,” perkataan “or any evidence necessary to establish the commission of an offence under this Act,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “police officer” dengan perkataan “a senior police officer”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “such premises” perkataan “at any reasonable time by day or night”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/28/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
