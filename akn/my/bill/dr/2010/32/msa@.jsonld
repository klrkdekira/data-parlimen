      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” yang terdapat di hujung perenggan (l); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (l) perenggan yang berikut: “(la) mengadakan, mengendalikan dan menguruskan apa-apa produk atau perkhidmatan lain yang perlu bagi maksud mencapai tujuan Bank dan mengenakan caj bagi produk dan perkhidmatan sedemikian; dan”. Pindaan seksyen 6"
      }
    },
