      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
