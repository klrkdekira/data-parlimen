    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 35(2) Akta ibu dipinda dengan menggantikan perkataan “Pengurus Besar” dengan perkataan “Ketua Eksekutif”. Pindaan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 36(1) Akta ibu dipinda dengan menggantikan perkataan “Pengurus Besar”, di mana-mana jua terdapat, dengan perkataan “Ketua Eksekutif”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bank Simpanan Nasional (Pindaan) 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Bank Simpanan Nasional 1974 [Akta 146] yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “bunga” takrif yang berikut: ‘ “Ketua Eksekutif” ertinya Ketua Eksekutif yang dilantik di bawah seksyen 9 dan termasuklah seseorang yang dilantik untuk bertindak sebagai Ketua Eksekutif;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pegawai”, dengan menggantikan perkataan “Pengurus Besar” dengan perkataan “Ketua Eksekutif”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “Pengurus Besar”. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_3",
      "@type": "akn:clause",
