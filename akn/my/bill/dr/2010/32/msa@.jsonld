      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 8(1)(b) Akta ibu dipinda dengan menggantikan perkataan “Pengurus Besar” dengan perkataan “Ketua Eksekutif”. Pindaan seksyen 9"
      }
    },
