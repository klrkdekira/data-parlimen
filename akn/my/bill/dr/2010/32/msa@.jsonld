      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan menggantikan perkataan “tidak lebih daripada empat orang pengarah lain” dengan perkataan “tidak kurang daripada empat orang pengarah lain”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_4__para_c",
