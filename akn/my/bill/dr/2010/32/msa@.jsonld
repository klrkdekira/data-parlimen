      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f), dengan menggantikan perkataan “Pengurus Besar” dengan perkataan “Ketua Eksekutif”. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
