      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “Pengurus Besar” dengan perkataan “Ketua Eksekutif”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
