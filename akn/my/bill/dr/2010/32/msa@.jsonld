        "@value": "dengan memotong perenggan (c) dan (d);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
