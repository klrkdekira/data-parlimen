      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/32/msa@/~cl_6__para_b__subpara_ii"
      ],
