        "@language": "en",
        "@value": "NATIONAL VISUAL ARTS DEVELOPMENT BOARD Establishment of the National Visual Arts Development Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
