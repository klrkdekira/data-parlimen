        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_21"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFICERS AND SERVANTS OF THE BOARD Appointment of Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint a Director General for the purposes of this Act and for the efficient conduct of the affairs of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The terms and conditions of appointment of the Director General shall be determined by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "If the Director General is temporarily absent from Malaysia or is temporarily incapacitated through illness or for any other reason from the performance of his duties, the Board may direct any other officer to perform the duties of the Director General during his temporary absence or incapacity. Duties of Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The Director General shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "be responsible for the management of the affairs of the Board subject to the directions of and in accordance with policies determined by the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "be responsible for putting into execution the decisions of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "exercise supervision and control over all the other officers and servants of the Board; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "perform such duties and exercise such powers as may from time to time be determined or delegated by the Board or as the Chairman may direct. Officers and servants of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall appoint such number of officers and servants of the Board as the Board may from time to time think necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have power to formulate and regulate the procedure for the appointment of its officers and servants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "An officer or servant of the Board shall hold his office for such period and on such terms and conditions as the Board may from time to time determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, with the approval of the Minister, make regulations with respect to the conditions of service of its officers and servants. Power to grant loans and make advances to officers and servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may grant loans and make advances to its officers and servants for such purposes and on such terms and conditions as the Board may determine. Payment of retirement benefits, gratuities and other allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may make arrangements for the payment to its officers and servants and their dependants of such retirement benefits, gratuities and other allowances as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have a common seal which shall bear such device as the Board shall approve and such seal may be broken, changed, altered or made anew as the Board deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Board, a stamp bearing the words “National Visual Arts Development Board” may be used and shall be deemed to be the common seal of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Director General or such other person as may be authorized by the Board, and shall be authenticated by the Director General or such authorized person or by any officer authorized by either of them in writing; and all deeds, documents and other instruments purporting to be sealed with that seal, authenticated as specified in this subsection, shall, until the contrary is proved, be deemed to have been validly executed: Provided that any document or instrument which if executed by a person not being a body corporate would not be required to be under seal may in like manner be executed by the Board, and any such document or instrument may be executed on behalf of the Board by any officer or servant of the Board generally or specially authorized by the Board in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Board shall be officially and judicially noticed. Power to establish companies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, from time to time, with the approval of the Minister establish companies under the Companies Act 1965 [Act 125] to carry out and have the charge, conduct and management of any project, scheme or enterprise which has been planned or undertaken by the Board in the performance of its functions or the exercise of its powers. Delegation of Board’s functions and powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, in writing, delegate any of its functions and powers to the Chairman or any other member of the Board or to any officer of the Board, except the power to make subsidiary legislation, power to borrow money and power with regards to administrative and operational matters of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A person delegated with such powers shall be bound to observe and have regard to all conditions and restrictions imposed by the Board and all requirements, procedures and matters specified by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any function or power delegated under this section shall be performed or exercised in the name and on behalf of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Board itself from performing or exercising at any time any of the delegated functions or powers. Power of Minister to give directions and require information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give to the Board any direction of a general character consistent with the provisions of this Act and the Board shall give effect to such direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall furnish the Minister with such information with respect to its property and activities as he may from time to time require. Meetings and procedures of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall hold such number of meetings as may be necessary for the due fulfillment of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Board or the person appointed to exercise the functions of the Chairman pursuant to subsection 9(1) shall preside at any meeting of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "If at any meeting of the Board neither the Chairman nor the person appointed to exercise the functions of the Chairman pursuant to subsection 9(1) is present, the members present shall elect one of their members to be the chairman of the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Every question at a meeting of the Board shall be determined by a majority of the votes of the members present, and in the case of an equality of votes, the chairman of the meeting shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may act notwithstanding one or more vacancies among its members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum for a meeting of the Board shall be five. Secretary to the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall be the secretary to the Board. Committees of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may establish such committees as it considers necessary or expedient to assist it in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of a committee shall be held at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "minutes of all its meetings to be maintained and kept in proper form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "copies of the minutes of all its meetings to be submitted to the Board as soon as practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of a meeting of a committee shall, if duly signed, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of a committee in respect of the proceedings of which minutes have been made in accordance with subsections (11) and (12) shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any of its meetings, for the purpose of advising it on any matter under discussion, but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_15",
      "@type": "akn:subsection",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Members of a committee or any person invited to attend any meeting of a committee may be paid such allowances and other expenses as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16",
      "@type": "akn:subsection",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceeding taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of, or any defect in the constitution of, a committee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or an irregularity not affecting the merits of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may elect any of its members to be the chairman of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint any person to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may at any time revoke the appointment of any member of a committee without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may at any time resign by giving notice in writing to the Chairman of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to and act in accordance with any direction given to the committee by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may at any time discontinue or alter the constitution of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of “National Visual Arts Development Board” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may sue and be sued in its name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Board may, upon such terms as it deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase, take, hold and enjoy movable and immovable property of every description; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer, or otherwise dispose of, or deal with, any movable or immovable property or any interest vested in the Board. Functions of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Board shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Minister as to the policies, methods, measures and strategies to be adopted to promote, nurture and facilitate the development of visual arts in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to establish, operate and maintain the Gallery;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to purchase or acquire any works of visual arts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to preserve the visual arts objects in the Gallery;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to maintain the standard and quality of the visual arts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to provide assistance in monetary term or otherwise to visual arts operators in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to initiate activities either with or without the participation of visual arts operators towards the advancement of visual arts development in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to promote, assist and co-ordinate the activities of visual arts operators;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to provide support, including, but not limited to, financial support, advice and information, to any person, organization or institution towards the advancement of visual arts development in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct activities for the purpose of stimulating public interest in visual arts, promoting knowledge, appreciation and practice of the visual arts and improving standards in such art; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to act in any capacity or role towards the advancement of visual arts development Malaysia. Powers of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Board shall have the following powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to employ consultants, appoint agents and attorneys;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to hold any works of visual arts upon trust;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to provide training schemes and facilities, to control and supervise the implementation of training projects and programmes relating to the development or advancement of visual arts in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to employ such number of officers and servants on such terms and conditions as the Minister may approve;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to manage and control the Gallery and for that purpose may employ such number of officers and servants to run the Gallery, on such terms and conditions as the Minister may approve;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to impose fees or any other charges it deems fit in respect of any entrance to any exhibition held at the Gallery or any other services rendered by the Gallery;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to lend any object belonging to the Gallery to any gallery, museum or exhibition on such terms and subject to such conditions as the Board thinks fit: Provided that the approval in writing of the Minister shall first be obtained if such gallery, museum or exhibition is outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the written consent of the Minister, and subject to any restrictions which the Minister may impose, to invest, borrow money or charge any movable or immovable property or any interest therein vested in the Board, upon such terms and conditions as the Board thinks fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make available services in relation to the visual arts including the carrying out of investigations and the giving of advice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to do all things reasonably necessary for the performance of its duties under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1) the Board, subject to any directive made by the Minister from time to time, shall have power to participate and promote participation in international collaborative projects, the participation whereof appears to it to be requisite, advantageous or convenient for or in connection with the performance of its functions under this Act. Membership of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman to be appointed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry charged with the responsibility for the development of visual arts, or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry charged with the responsibility for finance, or his representative; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not less than five but not more than ten other members to be appointed by the Minister of which half shall be practising artists or academics in the visual arts field who in the opinion of the Minister, would be able to contribute to the development of visual arts."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Board appointed by the Minister shall, unless his appointment is sooner revoked or he sooner resigns, hold office for a term not exceeding three years as the Minister may determine and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Members of the Board shall be paid such allowances as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Schedule shall apply to the Board. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member appointed under paragraph 6(1)(a) or (d) may at any time be revoked by the Minister without assigning any reasons for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed by the Minister may at any time resign his office by giving a written notice addressed to the Minister. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
