      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, a fund to be known as the “National Visual Arts Fund” which shall be administered and controlled by the Board is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_IV__cl_22__subsec_2",
