      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Board without leave of the Chairman or in the case of the Chairman, without leave of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Minister. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9__subsec_1",
