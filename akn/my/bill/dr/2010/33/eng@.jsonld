      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Chairman is for any reason unable to perform the functions of the Chairman or during any period of vacancy in the office of the Chairman, the Minister may appoint any member of the Board to perform the functions of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed under subsection (1) shall, during the period in which he is performing the functions of the Chairman under this section, be deemed to be the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person ceases to be a member of the Board by reason of any of the provisions of this Act, another person shall be appointed in his place in accordance with the provisions applying. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/33/eng@/~part_IV",
