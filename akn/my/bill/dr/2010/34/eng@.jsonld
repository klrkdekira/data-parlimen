        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REGISTRATION OF FOOD ANALYSTS Registrar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Senior Director of Food Safety and Quality Division, Ministry of Health Malaysia shall be the Registrar. Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall cause to be kept in the prescribed form a register of food analysts to be known as the Register of Food Analysts."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall be responsible for the maintenance and custody of the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Register shall be deemed to be a public document within the meaning of the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate signed by the Registrar that any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "is or is not registered under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_17__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "was or was not at any time registered under this Act, shall be conclusive evidence of the matters referred to therein. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be registered as a food analyst under this Act unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he holds—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a degree in food science or food technology or food science and technology from any higher educational institution as may be approved by the Council; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any other degree in science in any related field as may be approved by the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he produces to the Council evidence to the satisfaction of the Council—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he has been selected for employment under the supervision of any registered food analyst or registered chemist; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he has two years of working experience in food analysis if he holds a degree in food science or food technology or food science and technology, or four years of working experience in food analysis if he holds any degree in science in any related field; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is not less than eighteen years of age."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "An application for registration shall be made to the Council in the prescribed form. Mode of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Registration under this Act shall be effected by entering in the Register the applicant’s particulars as prescribed upon payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is registered under this Act, the Council shall cause to be issued to him a certificate of registration under the hand of the Chairman. Annual practising certificate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "A registered food analyst who intends to practise as a food analyst may make an application to the Registrar in the prescribed form and pay the prescribed fee for a certificate to practise as a food analyst."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application and payment specified in subsection (1), the Registrar may, upon approval, issue to the registered food analyst an annual practising certificate in the prescribed form, authorizing the registered food analyst to practise as a food analyst during the year for which the certificate is issued."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate by the Registrar that any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "is or is not the holder of an annual practising certificate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "was or was not at any time a holder of an annual practising certificate, shall be conclusive evidence of the matter referred to therein. Renewal of annual practising certificate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The application for the renewal of an annual practising certificate shall be made to the Registrar not less than thirty days before the date of expiry in the prescribed form and upon payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "If the Registrar approves the application, the Registrar shall issue to the registered analyst an annual practising certificate in the prescribed form authorizing the registered food analyst to practise as a food analyst during the year for which the certificate is issued. Compliance with guidelines issued by the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A registered food analyst shall comply with all guidelines issued by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A registered food analyst who fails to comply with subsection (1) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Council is deemed to have been vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is terminated;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "he is absent without leave of the Council for three consecutive meetings of the Council; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointed member under paragraph 7(1) (c) or (d), he ceases to be a registered food analyst. Meetings of the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A meeting of the Council shall be convened by the Chairman by notice in writing to the other members and the meeting shall be held at the time and place specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet at least once in four months. Procedure at meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is absent from any meeting of the Council, the Deputy Chairman shall preside."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman or the Deputy Chairman, when he is presiding at a meeting, shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members shall form the quorum of a meeting of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "All questions before a meeting of the Council shall be decided by a simple majority of the members present and voting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may determine its own procedure. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish committees to assist it in carrying out its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint any person to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The committee established under this section may elect any of its members to be chairman and may regulate its own procedure and, in carrying out its functions under this subsection, such committee shall be subject to and act in accordance with any direction given to the committee by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may at any time revoke the appointment of any member of a committee. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Council or against any member or agent of the Council in respect of any act, neglect or default done or omitted by him in such capacity. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Council, while discharging his duties as such member, shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of “Malaysian Food Analysts Council” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have perpetual succession and a common seal and may sue and be sued in its name. Functions and powers of the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to perform the duties and functions and exercise the powers provided in this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to determine and regulate the professional conduct and ethics of food analysts and to issue any code of ethics for food analysts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the scale of fees to be charged by registered food analysts for services rendered;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to hear and determine disputes relating to the professional conduct or ethics of registered food analysts and to establish committees or appoint arbitrators to hear and determine such disputes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct examinations in association with the Malaysian Institute of Food Technology for admission to the food analysis profession;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to hold or cause to be held professional development programmes for registered food analysts to further enhance their knowledge in the latest developments relating to the practise of food analysis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to issue guidelines to specify the procedures and test methods of food analysis; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as it considers fit to enable it to perform its functions effectively or that are incidental to the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have all such powers as may be necessary for, or in connection with, or reasonably incidental to, the performance of its functions under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall not borrow or raise money in any manner without the prior approval of the Minister and the Minister of Finance. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have a common seal that shall bear a device approved by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal may be broken, changed, altered and made anew as the Council considers fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Council, a stamp bearing the words “Malaysian Food Analysts Council” may be used and shall be deemed to be its common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Chairman or a member of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be affixed in the presence of any two designated members of the Council and such members shall sign every deed, document or other instrument to which the common seal is affixed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents or other instruments purporting to be sealed with the common seal and authenticated as specified in subsection (5) shall, until the contrary is proved, be deemed to have been validly executed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Council shall be officially and judicially noticed. Membership of the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General who shall be the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Senior Director of Food Safety and Quality Division, Ministry of Health Malaysia who shall be the Deputy Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "two registered food analysts from the private sector appointed by the Minister, one of whom shall be a member of the Malaysian Institute of Food Technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "two registered food analysts recommended by the Malaysian Institute of Food Technology from among its members and appointed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "two food scientists employed by a higher educational institution offering a degree in food science or food technology or food science and technology, to be appointed by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "three representatives from a government food-related agency appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall, with the approval of the Minister, appoint an officer of the Ministry of Health to be the Secretary of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is unable to exercise his functions under this Act due to illness, absence from Malaysia or any other cause, his functions shall be exercised by the Deputy Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may delegate to the Deputy Chairman any of his powers, and when so delegated such power shall be exercised by the Deputy Chairman under the control of and subject to such directions and restrictions as may be specified by the Chairman. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member who is appointed or elected under paragraph 7(1)(c) to (f) shall hold office for a term not exceeding three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member who is appointed or elected under paragraph 7(1)(c) to (f) is eligible for reappointment but such member shall not hold office for more than two consecutive terms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "If the office of a member becomes vacant before the expiration of his term of office, the person appointed to fill the vacancy shall hold office for the remainder of the term of office of the member whose office has become vacant. Allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "All members of the Council shall be paid such allowances at such rates as the Minister may determine. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DISCIPLINE Council’s disciplinary jurisdiction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have disciplinary authority over registered food analysts."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may exercise disciplinary authority over any registered food analyst—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whose registration has been obtained by fraud or misrepresentation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "whose degree has been withdrawn or cancelled by the university, college or body by which it was conferred;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has been convicted by a court in Malaysia or elsewhere of any offence involving fraud, dishonesty or moral turpitude or who has been sentenced to imprisonment (whether in itself only, or in addition to or in lieu of a fine);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who was not at the time of his registration entitled to be registered;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has been found by the Council to have contravened this Act or its regulations; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "who has failed to discharge his professional duties with due skill, care and diligence. Inquiry"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall establish a Disciplinary Committee to hold an inquiry on any disciplinary matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "In conducting an inquiry, the Disciplinary Committee shall not be bound by the provisions of the Evidence Act 1950 or by any legal procedure but may conduct the inquiry in a manner it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may suspend temporarily the registration of a registered food analyst pending the decision of the Council on the result of any inquiry or the disposal of any appeal. Disciplinary punishments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, in the exercise of its disciplinary authority, impose any of the following punishments:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the registered food analyst to be reprimanded in writing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the name of the registered food analyst to be suspended from the Register and suspend the annual practising certificate for such period as it thinks fit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "order the name of the registered food analyst to be removed from the Register and suspend the annual practising certificate for such period as it thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, in any case, make such order as it thinks fit with regard to the payment of costs incurred by the Registrar, any complainant or of the registered food analyst."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any costs awarded under subsection (2) may be recovered as a civil debt. Surrender of certificate of registration and annual practising certificate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where the name of a registered food analyst has been ordered by the Council to be suspended or removed from the Register, that person shall deliver his certificate of registration and the annual practising certificate to the Registrar within fourteen days of the receipt of the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Removal of name by reason of physical or mental infirmity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to paragraph 25(1)(c), the Council may order the name of any registered food analyst to be removed from the Register if the Council is satisfied that the registered food analyst is incapable, by reason of physical or mental infirmity, of carrying out duties as a food analyst."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of satisfying itself that any registered food analyst is incapable, by reason of physical or mental infirmity, of carrying out his duties, the Council shall appoint a Medical Review Committee which shall consist of not less than two medical practitioners and one food analyst appointed by the Council to inquire into each case and to make such recommendations as the Committee deems proper. Alteration to the Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "If the Council is satisfied that a registered food analyst is deceased or has voluntarily deregistered himself as a food analyst, the Council shall cause his name and all particulars relating to him to be removed from the Register. Restoration of name in Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Where the name of a registered food analyst has been removed from the Register, he may apply for his name to be restored in the Register on the ground that by reason of a specified change in circumstances that had occurred since the date of the removal it is just that his name be so restored."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may, in its discretion, upon application made to it, order that the name of the applicant be restored in the Register. Appeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any food analyst who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been refused registration by the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been registered but is dissatisfied with any condition or restriction imposed by the Council under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "having been registered has had his name removed from the Register pursuant to an order of the Council made under 27;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is not satisfied with any order of the Council under section 25; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is aggrieved by the decision of the Council under section 29, may, within twenty-one days of being so notified of the decision of the Council, file a notice of appeal in writing to the Minister, who shall then make a decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the notice of appeal in subsection (1) shall be sent to the Chairman of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Food Analysts Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“government food-related agency” means a government agency that is involved in conducting food analysis; “registered chemist” means a person who is registered under the Chemists Act 1975 [Act 158]; “food analysis” means the detailed examination of food which includes physical, microbiological, chemical, biochemical, biotechnological, toxicological or sensory evaluation properties of food and such examination may include examination of package, packaging materials and containers; “package” means anything in which or any means by which food is wholly or partly cased, covered, enclosed, contained, placed or otherwise packed in any way whatsoever and includes any basket, pail, tray or receptacle of any kind whether opened or closed; “Register” means the register kept or maintained in accordance with section 17; “prescribed” means prescribed by the Minister by regulations; “higher educational institution” means an educational institution providing higher education leading to the award of a diploma, degree or its equivalent; “registered food analyst” means a person who conducts food analysis and is registered under section 19; “Director General” means the Director General of Health, Malaysia; “Council” means the Malaysian Food Analysts Council established under section 4; “food” has the meaning assigned to it under the Food Act 1983 [Act 281]; “Minister” means the Minister charged with the responsibility for health; “authorized officer” means a person appointed by the Minister to be an authorized officer under section 37; “Registrar” means the Registrar referred to in section 16; “Secretary” means the Secretary of the Malaysian Food Analysts Council appointed under section 7. Non-application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to the chemists registered under the Chemists Act 1975."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FOOD ANALYSIS Registered food analysts may issue food analysis report"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Fraudulent registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is registered or who attempts to get himself or any other person to be registered under this Act by making or producing or causing to be made or produced any false or fraudulent representation or declaration either orally or in writing commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both. Offence of impersonating, holding out, etc., as a registered food analyst"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is not registered as a food analyst under this Act commits an offence if he—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "impersonates as a registered food analyst;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "holds himself out, by advertisement or otherwise, as being qualified or authorized to practise food analysis, and shall, on conviction, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding two years or to both and for a subsequent offence, to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under this Act for which no specific penalty is provided shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding one year or to both. Offence committed by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where a body corporate commits an offence under this Act, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where the body corporate is found to have committed the offence, shall be deemed to have committed that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable under this Act to any punishment or penalty for any act, omission, neglect or default, he shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his, or of the employee of such agent, if such act, omission, neglect or default was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by his employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the agent when acting on his behalf; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of such agent in the course of his employment by such agent or otherwise on behalf of the agent. Appointment of authorized officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint such number of authorized officers as he considers necessary for the purposes of this Act and every authorized officer shall be issued with an authority card which shall in any legal proceedings be admissible in evidence and shall be prima facie evidence of the facts so certified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The authorized officers appointed under this section shall be deemed to be public servants within the meaning of the Penal Code. Power to enter premises, examine and seize documents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may, at any time, enter any premises in which a registered food analyst is practising food analysis or in which there is reasonable ground to believe that a person is practising food analysis and exercise the following powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "examine any document, apparatus or article stored or used in connection with the practice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where a person is practising food analysis without being registered or without an annual practising certificate under this Act, seize any document, apparatus or article stored or used in connection with the practice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require that any information relating to the practice as the authorized officer may specify to be provided to him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "inspect any procedure or test performed or carried out by the food analyst, to ensure compliance with the guidelines issued by the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "inspect, take, make copies of, or make extracts from, any record found in the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "intimidates or obstructs an authorized officer in the performance of such authorized officer’s duty;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to permit an authorized officer to examine any document, apparatus or article;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to produce any document, apparatus or article for examination by an authorized officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to surrender any document, apparatus or article to an authorized officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to provide any information required by an authorized officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "attempts to do any of the acts specified in paragraphs (a) to (e), commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where an authorized officer seizes and seals any document, apparatus or article, he shall give a signed receipt for the document, apparatus or article."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer exercising power under this section shall produce his authority card on demand. Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under this Act shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “access” includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of computerized data. Power to require attendance of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may, by order in writing require the attendance before himself of any person who appears to the authorized officer to be acquainted with the facts and circumstances of the case, and such person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "If any such person refuses to attend as so required, the authorized officer may report such refusal to a Magistrate who shall issue a summons to secure the attendance of such person as may be required by the order made under subsection (1). Examination of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may examine orally any person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The person examined by an authorized officer shall be legally bound to answer all questions relating to such case put to him by the authorized officer, but such person may refuse to answer any question the answer to which would have a tendency to expose him to criminal charge, penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to tell the truth, whether or not such statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by any person under this section shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumb-print, as the case may be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after it has been read to him in the language in which he made it; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_41__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after he has been given an opportunity to make any correction he may wish. Admission of statements in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no statement made by any person to an authorized officer in the course of an investigation made under this Act shall be used in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "When any witness is called for the prosecution or for the defence, other than the accused, the court shall, on the request of the accused or the prosecutor, refer to any statement made by that witness to an authorized officer in the course of the investigation under this Act and may then, if the court thinks fit in the interest of justice, direct the accused to be furnished with a copy of it and the statement may be used to impeach the credit of the witness in the manner provided by the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where the accused had made a statement during the course of an investigation, such statement may be admitted in evidence in support of his defence during the course of the trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to apply to any statement made in the course of an identification parade or falling within section 27 or paragraphs 32(1)(a), (i) and (j) of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with any offence in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the making; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_42__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the contents, of any statement made by him to an authorized officer in the course of a police investigation made under this Act, that statement may be used as evidence in the prosecution’s case. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, with the written consent of the Public Prosecutor, compound any offence committed by any person under this Act or the regulations made under this Act and prescribed by the Minister to be a compoundable offence by making a written offer to such person to compound the offence upon payment to the Director General or any person authorized in writing by the Director General such amount not exceeding fifty per centum of the amount of maximum fine for that offence within such time as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed but before any prosecution for it has been instituted and where the amount specified in the offer is not paid within the time specified in the offer or within such extended period as the Director General or any person authorized in writing by the Director General may grant, prosecution for the offence may be instituted at any time thereafter against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "no prosecution shall thereafter be instituted in respect of such offence against the person to whom the offer to compound was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any book, record, apparatus, equipment, instrument, material, article, substance or any other thing seized in connection with the offence, may be forfeited, destroyed or returned to that person, as the Director General deems fit after taking into consideration the nature of the offence and subject to such terms and conditions as may be imposed. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in respect of an offence under this Act shall be instituted except by or with the consent of the Public Prosecutor. Appointment of legal advisor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "The Council or the Disciplinary Committee may appoint a legal advisor to assist the Council or the Disciplinary Committee during any inquiry touching on a disciplinary matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "The Council or the Disciplinary Committee may appoint any person who is and has been an advocate and solicitor for a period of not less than five years to advise it on—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all questions of law ensuing in the course of the inquiry; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the meaning and construction of all documents procured during the inquiry. Power of Minister to exempt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, exempt subject to such conditions as he deems fit to impose—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person conducting research and development works at any research institute or higher educational institution or in any industry on food analysis for its own use; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person conducting internal quality control or quality assurance at any research institute or higher educational institution or in any industry on food analysis for its own use, from all or any of the provisions of this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, by order published in the Gazette, revoke any order made under subsection (1) if he is satisfied that the exemption should no longer be granted. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Council, make such regulations as may be expedient or necessary for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "In particular and without prejudice to the generality of subsection (1), such regulations may prescribe for any or all of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the duties of the Registrar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the form and contents of the Register and the mode in which it shall be kept;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the fees to be paid under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the form and manner in which applications for registration and renewal for annual practising certificates shall be made;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure to be followed in relation to inquiries held under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the form of any certificate or other document required under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the offences that may be compounded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other matter which is required by this Act to be prescribed or which is necessary or expedient to be prescribed for carrying this Act into effect. Transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, at the date of the coming into operation of this Act, has been carrying out any food analysis activity to which this Act applies shall, within 12 months from the date of coming into operation of this Act, apply to be registered as a food analyst under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_VI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any person referred to in subsection (1) may continue to carry out such activity pending determination of his application to be registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall issue or certify in writing the result of any food analysis for the purpose of determining the composition or specification of any substance or product consumed or used by, or intended for the consumption or use of the public unless he is a registered food analyst and has a valid annual practising certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both and for a subsequent offence, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both. Practising without an annual practising certificate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A registered food analyst who practises without an annual practising certificate commits an offence and shall, on conviction be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of a first offence, to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of a subsequent offence, to a fine not exceeding forty thousand ringgit or to imprisonment for a term not exceeding four years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is in partnership with a person who practises food analysis without a valid annual practising certificate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_C"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "employs a person who practises food analysis without a valid annual practising certificate, commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of a first offence, to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of a subsequent offence, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of a continuing offence, to a further fine of five hundred ringgit for each day the offence continues after conviction in addition to the penalties provided under paragraphs (A) and (B)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/34/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A person referred to in subsection (2) shall not be deemed to have committed an offence if he proves that the offence was committed without his knowledge, consent or connivance."
      }
    }
  ]
}
