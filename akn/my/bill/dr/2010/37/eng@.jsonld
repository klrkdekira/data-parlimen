      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/37/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 6C. Amendment of section 16"
      }
    },
