    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perkapalan Saudagar (Pindaan dan Peluasan) 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa di Negeri-negeri Sabah dan Sarawak pada tarikh yang Menteri boleh, selepas berunding dengan pihak berkuasa Negeri, menetapkan melalui pemberitahuan dalam Warta. Pindaan seksyen 300"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Ordinan Perkapalan Saudagar 1952 [Ordinan No. 70/1952], yang disebut “Ordinan” dalam Akta ini, dipinda dengan memotong subseksyen 300(3). Pindaan seksyen 306C"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 470 Ordinan dipinda dengan menggantikan perkataan “one hundred” dengan perkataan “five thousand”. Pindaan seksyen 471"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~cl_21",
      "@type": "akn:clause",
