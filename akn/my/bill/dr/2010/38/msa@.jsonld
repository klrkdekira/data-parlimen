      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian III Peraturan-Peraturan Perkapalan Saudagar (Pelaksanaan Konvensyen yang Berhubungan dengan Pengangkutan Barang-Barang melalui Laut dan Liabiliti Pemunya Kapal dan Lain-Lain) 1960 bagi Sarawak [G.N. S 240/1960] dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan kepada Bahagian III Peraturan-Peraturan tersebut hendaklah ditafsirkan sebagai suatu sebutan kepada Bahagian IX Ordinan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan mana-mana undang-undang bertulis yang bersamaan dengan peruntukan dalam Bahagian III, IV, VI, VIII, IX dan X Ordinan dan yang berkuat kuasa dalam Negeri Sabah atau Sarawak sebaik sebelum tarikh atau tarikh-tarikh yang ditetapkan dalam subseksyen 1(3) hendaklah, pada tarikh atau tarikh-tarikh yang ditetapkan itu, dimansuhkan. Peruntukan dalam Bahagian III, IV, VI, VIII, IX dan X Ordinan hendaklah mengatasi undang-undang bertulis yang tidak selaras atau berlawanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/38/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan dalam Bahagian III, IV, VI, VIII, IX dan X Ordinan hendaklah mengatasi walaupun terdapat apa-apa yang tidak selaras atau berlawanan dengan peruntukan itu dalam mana- mana undang-undang bertulis yang lain."
      }
    }
