      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “under section 3” the words “or 3A”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/39/eng@/~cl_14__para_b",
