    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/39/eng@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/39/eng@/~cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1A) Subject to subsection (2), if the Director of Marine is satisfied, on an application for such certificate as is mentioned in section 11A in respect of a ship registered in Malaysia or any country which is not a Bunker’s Convention country, that there will be in force in respect of the ship, throughout the period for which the certificate is to be issued, a valid contract of insurance or other financial security satisfying the requirements Article 7 of the Bunkers Convention, the Director of Marine shall issue such certificate to the registered owner.”; and"
      }
    },
