    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is granted a permit or registered as a broker under this Act shall in relation to the strategic items or restricted activities—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "maintain a register in such form as may be prescribed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keep all documents for such period as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The register shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "be kept solely for the purpose of entering such records and information as may be prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "be kept up to date and in good order and condition; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "be kept for such period as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The person referred to in subsection (1) shall make the register available for inspection as and when required by an authorized officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1), (2) or (3) commits an offence and shall, on conviction, be punished with a fine not exceeding one million ringgit or with imprisonment for a term not exceeding two years or with both, and in the case of a body corporate, be punished with a minimum fine of two million ringgit. Registers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Controller shall keep and maintain a register of permit holders and registered brokers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The registers shall be available to the public for inspection subject to such conditions as the Controller considers appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A copy or extract of any entry in the registers duly certified by the Controller shall be given to any person requiring the copy or extract upon payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The registers shall be conclusive evidence if any question arises as to whether any person holds a valid permit or is a registered broker under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Strategic Trade Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for different provisions of this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“authorized officer” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of customs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of the Malaysian Maritime Enforcement Agency;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "an officer of the Malaysian Communications and Multimedia Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "such other officers as may be specified by the Controller; “biological agent” means any microbial, micro-organism, virus or infectious substance derived from them naturally or artificially, as well as their components and whatever their origin or method of production; “biological weapon” means any microbial or other biological agents or toxins whatever their origin or method of production, of types and in quantities that have no justification for prophylactic, protective or other peaceful purpose, and weapons, equipment or means of delivery designed to use biological agents or toxins for hostile purposes or in armed conflict; “bring in transit” means to bring items from any country into Malaysia by land, sea or air, where the items are to be taken out from Malaysia on the same conveyance on which they are brought into Malaysia or any other conveyance and whether or not such items are landed or transhipped in Malaysia, but does not include the passage through Malaysia in accordance with international law of a foreign conveyance carrying any items; “brokering” means the activity of a person who, either on his own behalf or acting as an agent on behalf of another person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "negotiates, arranges for or facilitates the purchasing, financing, conveying, sale or supply of items; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "buys, sells or supplies such items; “chemical weapon” has the same meaning as assigned to it under the Chemical Weapons Convention Act 2005 [Act 641]; “Controller” means the Strategic Trade Controller appointed under section 5, and includes the Deputy Strategic Trade Controller; “conveyance” includes any vessel, train, vehicle, aircraft and any other means of transport by which persons or items can be carried; “device” means any medium in which information, visual images, sounds or other data is or are recorded, stored or embodied in any form so as to be capable (with or without the aid of other equipment) of being retrieved or produced therefrom; “export” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "to take or cause to be taken out of Malaysia any items by land, sea or air, or to place any items in a conveyance for the purpose of such items being taken out of Malaysia by land, sea or air; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "to transmit technology by any means to a destination outside Malaysia, and includes any oral or visual transmission of technology by a communications device where the technology is contained in a document the relevant part of which is read out, described or otherwise displayed over the communications device in such a way as to achieve a similar result; “items” includes goods and technology; “Minister” means the Minister charged with the responsibility for international trade and industry; “nuclear weapons” means any device which is capable of releasing nuclear energy in an uncontrolled manner and which has a group of characteristics that are appropriate for use for warlike purposes, but does not include the delivery system if it is separable from the device; “owner”, in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4",
      "@type": "akn:list",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "strategic items or unlisted items, includes any person being or holding himself out to be the owner, importer, exporter, consignee, agent or person in possession of, or beneficially interested in, or having any control of, or power of disposition over, the strategic items or unlisted items; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "a conveyance, includes every person acting as agent for the owner or who receives freight or other charges payable in respect of the conveyance; “permit” means a permit issued under this Act, and includes a special permit; “related laws” means the written laws specified in the Schedule; “relevant Authority” means the Authority designated under the related laws for the regulation of the strategic items, unlisted items and restricted activities, and includes the Controller; “restricted activity” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any activity that supports the development, production, handling, usage, maintenance, storage, inventory or proliferation of any weapon of mass destruction and its delivery systems; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "participation in transactions with persons engaged in such activities; “software” means a collection of one or more programmes or microprogrammes recorded, stored or embodied in any device; “strategic items” means any items prescribed as strategic items under section 7; “strategic technology” means technology prescribed as a strategic item under section 7; “technical assistance” includes instructions, skills, training, the provision of working knowledge and consulting services and may involve the transfer of technical data; “technical data” includes blueprints, plans, diagrams, models, formulae, tables, engineering designs and specifications, manuals and instructions in print or electronic format; “technology” means information and data in any form for the design, development, production or use of another item and includes technical data, technical assistance and software; “toxin” means any poisonous substance, whatever its origin or method of production, produced by a living organism or artificially synthesised which can cause illness, injury or death; “tranship” means to remove items from the conveyance on which they were brought into Malaysia and to place the items on the same or another conveyance for the purpose of taking them out of Malaysia where these acts are carried out on a through bill of lading, through airway bill or through manifest; “transmit”, in relation to strategic technology, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6",
      "@type": "akn:list",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "to transmit the technology in Malaysia by electronic means; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_2__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "to make the technology available in Malaysia on a device, so that the strategic technology becomes accessible to any person, whether within or outside Malaysia; “unlisted items” means items that may be used in a restricted activity but are not prescribed as strategic items under section 7; “weapons of mass destruction” means any weapon designed to kill, harm or infect people, animals or plants through the effect of nuclear explosion or dispersion or the toxic properties of a chemical weapon or the infectious or toxic properties of a biological weapon, and includes a delivery system designed, adapted or intended for the deployment of such weapons. Prevailing law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this Act shall be in addition to, and not in derogation of, the provisions of any other written law, including the related laws, relating to the prevention of the proliferation of weapons of mass destruction and their delivery systems."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any conflict or inconsistency between the provisions of this Act and those of any other written laws, including the related laws, the provisions of this Act shall prevail and the conflicting or inconsistent provisions of the other written laws shall, to the extent of the conflict or inconsistency, be deemed to be superseded. Extra-territorial application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall, in relation to any person, whatever his nationality or citizenship, have effect outside as well as within Malaysia, and where an offence under this Act is committed by any person in any place outside Malaysia, he may be dealt with in respect of such offence as if the offence was committed at any place within Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1) and in relation to the transmission of strategic technology, this Act shall apply if, for the offence in question, the transmission of the strategic technology utilized any equipment or device located in Malaysia or was routed through any equipment or device located in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Application of Act for enforcement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Exemption"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister may, by regulations, exempt—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "any person or class of persons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "any activity in respect of any items of a specified nature or description, from any provisions of this Act, subject to such conditions as may be prescribed. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to any offence under this Act relating to strategic items, unlisted items or restricted activities shall be instituted except by or with the written consent of the Public Prosecutor. Offences by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence against any provision of this Act has been committed by a body corporate, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity, or was in any manner or to any extent responsible for the management of any of the affairs of such body corporate, or was assisting in such management, shall be deemed to be guilty of that offence unless he proves that the offence was committed without his knowledge, consent or connivance and that he exercised all due diligence to prevent the commission of the offence as he ought to have exercised, having regard to the nature of his functions in that capacity and to all the circumstances. Offences by employee or agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable under this Act to any punishment or penalty for any act, omission, neglect or default, such person shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his or of the employee of such agent, if such act, omission, neglect or default was committed by the person’s employee in the course of his employment, or by the agent when acting on behalf of the person, or by the employee of such agent in the course of his employment by such agent or otherwise on behalf of the agent. Notice for disclosure of information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Controller or the relevant Authority may send a notice to any person whom the Controller or the relevant Authority believes on reasonable grounds has information or documents relevant to the enforcement of this Act relating to strategic items, unlisted items or restricted activities, requesting the person to provide the information or documents to the Controller or the relevant Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "A person who receives a notice referred to in subsection (1) shall provide the requested information and documents to the Controller or the relevant Authority in the prescribed form and within the time specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (2) commits an offence and shall, on conviction, be punished with a fine not exceeding one million ringgit or with imprisonment for a term not exceeding two years or with both. Information is privileged and confidential"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Any information and document obtained pursuant to this Act or by virtue of this Act relating to strategic items, unlisted items or restricted activities are privileged and confidential."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the information and documents referred to in subsection (1) are not privileged or confidential if they are required to be disclosed or communicated for the purpose of national interest, national security or under any written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "No person in possession of privileged or confidential information or documents shall knowingly, without the written consent of the person from whom they were obtained, communicate them or allow them to be communicated to any person, or allow any person to have access to them, except for the purpose of the enforcement of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written laws, no person shall be required, in connection with any legal proceedings, to produce any statement or other record containing privileged or confidential information or documents, or to give evidence relating to them, unless the proceedings relate to the enforcement of this Act. Protection of officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No action or prosecution shall be brought, instituted or maintained in any court against the Controller, the relevant Authority or an authorized officer for or on account of or in respect of any act ordered or done for the purpose of carrying into effect this Act if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served thereby. Protection of Government, etc. from liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The Government, Controller or relevant Authority, as the case may be, shall not be liable to make good any loss sustained in respect of any strategic items or unlisted items by fire, theft, damage or any other cause while such strategic items or unlisted items are in any customs warehouse or in the lawful custody or control of an authorized officer unless such loss is caused by the wilful neglect, or default of an authorized officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "No authorized officer shall be liable to make good any loss sustained in respect of any strategic items or unlisted items by fire, theft, damage or other cause while such strategic items or unlisted items are in any customs warehouse or in the lawful custody or control of such authorized officer unless such loss is caused by his wilful neglect or default. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be necessary or expedient for giving full effect to the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any forms for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any information to be furnished for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedures for the issuance of permits under this Act, including the establishment of different classes of permits for different classes of strategic items;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedures for the registration of brokers under this Act, including the establishment of different classes of brokers for different classes of strategic items;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the forms for end-user statements;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the fees to be paid under this Act and the manner for collecting and dealing with such fees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the forms of registers to be kept and maintained by permit holders and registered brokers, including the particulars to be recorded in the registers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for any matter, including enforcement matters, which under this Act is required or permitted to be prescribed or which is necessary or expedient to be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section or any other subsidiary legislation made under this Act may prescribe for any act or omission in contravention of the regulations or subsidiary legislation to be an offence and may prescribe for penalties of a fine not exceeding one million ringgit or imprisonment for a term not exceeding five years or with both. Amendment of Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedule. Saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "A person engaged in any activity relating to strategic items or in any restricted activities immediately before the commencement of this Act and intends to continue with that activity on and after such commencement shall, not later than three months from the date of commencement of this Act, apply to the Controller or relevant Authority for a permit or registration, as the case may require, under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Pending the decision of the Controller or relevant Authority on the application under subsection (1), the applicant shall be deemed to be temporarily authorized to continue his activities under this Act for a period of three months from the date of commencement of this Act and no action shall be taken against him for engaging in such activity without a permit or registration during such period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), a person authorized under this section shall for the purposes of this Act comply with the requirements, duties and obligations of a permit holder or a registered broker."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Where a permit is issued under section 16 or registration is granted under section 19 by the Controller or relevant Authority, the applicant shall immediately take the necessary action to comply with any conditions imposed on the permit or registration, as the case may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_VI__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Where the permit or registration is refused by the Controller or relevant Authority, the applicant shall cease to be deemed to be authorized under subsection (2) from the date he is notified of the decision of the Controller or relevant Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of section 3 and the application of the related laws, for the purpose of strategic items, unlisted items and restricted activities regulated under this Act, the enforcement powers provided under this Part shall be available to the authorized officers. Production of authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Every authorized officer shall declare his office and shall on demand produce to the person against whom he is acting his authority card. Powers of authorized officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the powers of the authorized officers under any other written law, including the related laws, an authorized officer shall have the following powers for the purpose of enforcement of this Act:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to receive and consider any report of the commission of an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to stop, enter, board, inspect and search any place, premises, structure or conveyance and to detain any conveyance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to recall any conveyance that has departed from any port or place in Malaysia and to detain such conveyance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to exercise the right of hot pursuit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to demand the production of any permit, record, certificate or other document and to inspect, make copies of or take extracts from such permit, record, certificate or other document;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to investigate any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to examine and seize any strategic items or unlisted items together with any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data relating to any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to arrest any person that he has reason to believe has committed or is attempting to commit an offence under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to expel any conveyance which he has reason to believe to be involved in a restricted activity or acting against national interest or national security."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), no conveyance shall be stopped, entered, boarded, searched, inspected or detained within the area of the territorial sea if the passage of the conveyance within the territorial sea is an innocent passage."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (2), the passage of a conveyance is an innocent passage if and so long as the passage of the conveyance is not prejudicial to the peace, good order or national security of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law, for the purposes of subsection (3), the following activities shall be considered to be prejudicial to the peace, good order and national security:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any threat or use of force against the sovereignty, territorial integrity or political independence of Malaysia or any act which in any manner is a violation of the principles of international law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any exercise or practice with weapons of any kind;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any act aimed at collecting information to the prejudice of the national security or defence of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any act of propaganda aimed at affecting the peace, national security or defence of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the launching, landing or taking on board of any aircraft;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the launching, landing or taking on board of any military device;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the loading or unloading of any commodity, currency or person contrary to the customs, fiscal, immigration or health laws of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any act of pollution;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any fishing activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the carrying out of unauthorized research or survey activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any act aimed at interfering with any systems of communication or any other facilities or installations of Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any other activity not having a direct bearing on passage. Powers of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall have all the powers necessary to carry out an inspection and to investigate the commission of any offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), for the purpose of the investigation of any offence under this Act, an authorized officer shall have all the powers which the authorized officer may exercise under any written law and the Criminal Procedure Code [Act 593]. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, where an authorized officer has reasonable grounds for believing that by reason of the delay in obtaining a search warrant the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the authorized officer may, without warrant, enter any place, premises or conveyance and seize any strategic items or unlisted items, or any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data. Access to places or premises"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall for the purposes of this Act at all times have access to any place or premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where any authorized officer enters upon any place or premises in accordance with the provisions of this section, then—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may require any person therein to produce any books, accounts or other documents, including computerized data, or other record, whether in print or electronic format, or items which such person is required to keep under the provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may examine any books, accounts or other documents, including computerized data, or other record, whether in print or electronic format, facility, apparatus, equipment, device or item and make copies of or take extracts from any such books, accounts, documents or records;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may seize and detain any books, accounts or other documents, including computerized data, or other record, whether in print or electronic format, facility, apparatus, equipment, device or item which contains or is reasonably suspected to contain information as to any offence suspected to have been committed under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may require any person therein or his employees to answer questions relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "any book, data, document or other record, or item;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "any entry in any book, data, document or other record; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "any items;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may require any container, envelope or other receptacle in any such place or premises to be opened;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he may at the risk and expense of any person therein open and examine any package, or any items or materials, in any such place or premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If, by reason of its nature, size or amount, it is not practicable to remove any items, books, accounts or other documents, including computerized data, or other record, whether in print or electronic format, seized under this section, the seizing officer shall, by any means, seal such items, books, accounts or other documents, including computerized data, or other record in the place or premises or container in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where the authorized officer acting under the provisions of this Act is unable to obtain free access to any place or premises or to any container in that place or premises, he may, at any time, enter such place or premises and open such container in such manner, if necessary by force, as he may think necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where, on the entry upon any place or premises under the provisions of this Act, any strategic items or unlisted items are found in relation to which any offence has been committed, then such strategic items or unlisted items shall be liable to forfeiture. Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under this Act shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “access” includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of the computerized data. Power to search conveyances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "board any conveyance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require the master of a vessel, pilot of an aircraft or person in control of any other conveyance to give such information relating to the conveyance, cargo, stores, crew, passengers or voyage as he may consider necessary;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "search all parts of such conveyance for strategic items;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "examine all items on board and all items then being loaded or unloaded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "demand all documents which ought to be on board such conveyance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require all or any such documents to be brought to him for inspection, and the master of a vessel, pilot of an aircraft or person in control of any other conveyance refusing to allow such authorized officer to board or search such conveyance, or refusing to give such information or to produce such documents on demand commits an offence and shall, on conviction, be punished with imprisonment for a term of not less than three years or with a fine of not less than one million ringgit or with both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "If any place, box or chest on board such conveyance is locked and the key withheld, the authorized officer may break open any such place, box or chest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "If any items are found concealed on board any conveyance, such items shall be deemed to be strategic items. Use of force"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where force is required to enter any place, premises or conveyance, the authorized officer executing the powers under this Act may use such force as is reasonable in the circumstances. List of items seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where any strategic items or unlisted items, and any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data are seized, the authorized officer seizing the items shall prepare a list of the items seized and immediately deliver a copy signed by him to the owner or person in charge of the place, premises or conveyance which has been searched, or to such owner’s or person’s agent or servant, at that place, premises or conveyance. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may arrest without warrant any person whom he reasonably believes has committed or is attempting to commit an offence under this Act. Interception of communications"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any other written law, the Public Prosecutor may, if he considers that it is likely to contain any information which is relevant for the purpose of any investigation into an offence under this Act relating to strategic items, unlisted items or restricted activities, on the application of an authorized officer, authorize any authorized officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to intercept, detain and open any postal article in the course of transmission by post; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to intercept, listen to and record any communication transmitted or received by any communications."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with an offence under this Act relating to strategic items, unlisted items or restricted activities, any information obtained by an authorized officer in pursuance of subsection (1), whether before or after such person is charged, shall be admissible at his trial in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An authorization by the Public Prosecutor under subsection (1) may be given either orally or in writing; but if an oral authorization is given, the Public Prosecutor shall, as soon as practicable, reduce the authorization in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "A certificate by the Public Prosecutor stating that the action taken by an authorized officer in pursuance of subsection (1) had been authorized by him under that subsection shall be conclusive evidence that it had been so authorized and such certificate shall be admissible in evidence without proof of signature thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be under any duty, obligation or liability, or be in any manner compelled to disclose in any proceedings the procedure, method, manner or means, or any matter related thereto, of anything done under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “postal article” has the same meaning as in the Postal Services Act 1991 [Act 465]. Power to require attendance of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting an investigation under this Act may by order in writing require the attendance before himself of a person who appears to the authorized officer to be acquainted with the circumstances of the case, and the person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "If the person fails to attend as required, the authorized officer may report the failure to a Magistrate who shall issue a warrant to secure the attendance of the person. Examination of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting an investigation under this Act may examine orally a person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall during such examination, disclose all information which is within his knowledge, or which is available to him, in respect of the matter in relation to which he is being examined, and answer any question put to him truthfully and to the best of his knowledge and belief, and shall not refuse to answer any question on the ground that it tends to incriminate him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by a person under this section shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumb print, as the case may be, after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish. Offences with respect to information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A person who submits false or misleading information in any application, report or other document for any purpose under this Act or the related laws commits an offence and shall, on conviction, be punished with a fine not exceeding one million ringgit or with imprisonment for a term not exceeding two years or with both, and in the case of a body corporate, be punished with a minimum fine of two million ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "furnishes or causes to be furnished to an authorized officer any false or misleading particular, information or statement in respect of any matter which such officer requires to be furnished under this Act or the related laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to answer or gives a false answer to any question put to him by an authorized officer for the purpose of obtaining any particulars, information or statement required to be given under this Act or the related laws; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fails or refuses to produce any document as may be required by an authorized officer, commits an offence and shall, on conviction, be punished with a fine not exceeding one million ringgit or with imprisonment for a term not exceeding two years or with both, and in the case of a body corporate, be punished with a minimum fine of two million ringgit. Disposal of seized strategic items and unlisted items"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Controller shall after consultation with the Public Prosecutor, at any time he considers appropriate, order the disposal of the strategic items or unlisted items together with any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data seized subject to the following procedures being complied with:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "an inventory specifying the description, markings and other particulars which clearly identifies the items seized has been prepared by an authorized officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "photographs of the items seized have been taken in the presence of an authorized officer, and the said authorized officer has certified that the photographs are true; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "copies of any record, book, account, document or computerized data seized are duly certified by an authorized officer. Admissibility of evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law, the disposal of any item under section 41 shall not prejudice the trial of any person under this Act provided that the disposal of the item was done in accordance with that section and the court shall admit the inventory, photographs and copies made, as the case may be, of the items seized as representing the items seized. Forfeiture of strategic items and unlisted items when there is no prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is no prosecution or conviction in respect of any strategic items or unlisted items together with any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data seized in the exercise of any power conferred under this Act, such items shall be held for the period of one calendar month from the date of seizure and at the end of that period shall be deemed forfeited, unless a written claim thereto is received within such period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person asserting that he is the owner of any strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents, or computerized data seized under this Act and that the strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents, or computerized data are not liable to forfeiture may personally or by his agent authorized in writing by him, give written notice to the authorized officer who made the seizure of his claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of the written claim under subsection (2), the authorized officer shall refer the matter to the Sessions Court for decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Court to which the matter is referred shall issue a summons requiring the person asserting that he is the owner of the strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents, or computerized data and the person from whom they were seized to appear before the court and upon their appearance or default to appear, due service of the summons being proved, the court shall proceed to the examination of the matter, and on proof that an offence under this Act has been committed and that such strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents, or computerized data were the subject matter of or were used in the commission of such offence, shall order that the strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents or computerized data be forfeited or may, in the absence of such proof, order the release of such strategic items, unlisted items, container, package, conveyance, article, records, books, accounts, documents, or computerized data to the person entitled to them. Cost of holding strategic items and unlisted items seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where any strategic items or unlisted items, or any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data seized under this Act is held in the custody of the Government pending completion of any proceedings in respect of an offence under this Act, the cost of holding such strategic items, unlisted items, container, package, conveyance, article, record, book, account, document or computerized data in custody shall, in the event of any person being found guilty of an offence, be a debt due to the Government by such person and shall be recoverable accordingly. No costs or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of any strategic items or unlisted items, or any container, package, conveyance or other article in which the strategic items or unlisted items are stored, kept or found, record, book, account, document or computerized data seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Obstruction of authorized officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall obstruct, impede or interfere with an authorized officer in the performance of his functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) commits an offence and shall, on conviction, be punished with a fine not exceeding five million ringgit or with imprisonment for a term not exceeding five years or with both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 2] RELATED LAWS The written laws related to the regulation of strategic items, unlisted items and restricted activities are as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Animals Act 1953 [Act 647]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Atomic Energy Licensing Act 1984 [Act 304]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Chemical Weapons Convention Act 2005 [Act 641]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Customs Act 1967 [Act 235]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Pesticides Act 1974 [Act 149]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Plant Quarantine Act 1976 [Act 167]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Prevention and Control of Infectious Diseases Act 1988 [Act 342]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Protection of New Plant Varieties Act 2004 [Act 634]"
      }
    }
  ]
}
