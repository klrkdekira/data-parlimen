      "schema:text": {
        "@language": "en",
        "@value": "in relation to unlisted items which are arms or related material—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a__subpara_i__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a__subpara_i__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "where the act is done with the intent to unlawfully export, tranship or bring in transit such unlisted items without a permit or with knowledge that the export, transhipment or bringing in transit of such unlisted items without a permit is unlawful—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a__subpara_i__subpara_A",
