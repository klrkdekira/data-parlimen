      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, prescribe any items as strategic items for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If any question arises as to whether any item is or is not included in a class of items appearing in an order made under subsection (1), such question shall be decided by the Controller. Restricted and prohibited end-users"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may designate an end-user to be a restricted end-user for which a special permit is required under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may designate an end-user to be a prohibited end-user to which all export, transhipment or transit of strategic items or unlisted items under this Act are prohibited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A list of the restricted end-users and prohibited end-users shall be published by order in the Gazette, and the Minister may amend the list from time to time. Export, transhipment and transit of strategic items and unlisted items"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_9",
      "@type": "akn:clause",
