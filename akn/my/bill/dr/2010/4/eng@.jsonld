      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_12__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
