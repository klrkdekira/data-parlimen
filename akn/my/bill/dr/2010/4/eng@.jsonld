      "schema:text": {
        "@language": "en",
        "@value": "where the act is done with the intent to unlawfully export, tranship or bring in transit such strategic items without a permit or with knowledge that the export, transhipment or bringing in transit of such strategic items without a permit is unlawful—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/4/eng@/~part_III__cl_9__subsec_4__para_a__subpara_i__subpara_A",
