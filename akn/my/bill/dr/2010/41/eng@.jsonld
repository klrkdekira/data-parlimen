        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CHIEF EXECUTIVE OFFICER, OFFICERS AND EMPLOYEES OF THE AGENCY Chief Executive Officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister shall appoint a Chief Executive Officer on such terms and conditions as he may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be responsible for the general conduct, administration and management of the functions, activities and day-to-day affairs of the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall have general control of the officers and employees of the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall vest in the Chief Executive Officer such powers and impose upon him such duties as may be determined by the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall not decide on matters pertaining to policy and the strategic direction of the Agency without the approval of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall exercise reasonable care, skill, diligence and proper judgment in exercising his duties under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer is deemed to have exercised proper judgment referred to in subsection (6) if he—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "makes the judgment in good faith for a proper purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "does not have a material personal interest in the subject matter of the judgment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "is informed about the subject matter of the judgment to the extent he reasonably believes to be appropriate under the circumstances; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_19__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "reasonably believes that the judgment is in the best interest of the Government and the Agency. Employment of officers and employees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may employ such number of officers and employees as the Agency thinks desirable and necessary upon such terms and conditions of service as may be determined by the Agency for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "An officer and employee of the Agency shall, at all times, act in good faith and comply with such requirements, standards, duties and code of conduct as may be determined by the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be eligible for employment as an officer or employee of the Agency if he has, directly or indirectly, any share or interest in any contract or proposed contract with, for or on behalf of the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may adopt with such modifications as it deems fit any regulations, rules, policies, circulars and directives enacted or issued by the Federal Government in relation to any matter under this Part. Conduct and discipline of officers and employees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall have disciplinary authority over all its officers and employees and shall exercise disciplinary control over such persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may make such regulations to provide for the conduct and discipline of its officers and employees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section may include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for the establishment of appropriate disciplinary committees and the procedures to be complied with;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for the establishment of a disciplinary appeal committee to hear appeals from the decision of a disciplinary committee and the procedures to be complied with; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the interdiction with reduction in salary or other remuneration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the suspension without salary or other remuneration, of an officer or employee of the Agency during the pendency of the disciplinary proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section may create such disciplinary offences and provide for such disciplinary punishments as the Agency may deem appropriate, and the punishments so provided may extend to dismissal or reduction in rank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this section shall, in prescribing the procedure for disciplinary proceedings, provide for an opportunity for representations to be made by the officer or employee of the Agency against whom the disciplinary proceedings are taken before a decision is arrived at by the disciplinary committee on such disciplinary charge laid against such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Council appointed under paragraph 7(2)(h) shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Council without leave of the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Prime Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Prime Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member of the Council appointed under paragraph 7(2)(h) ceases to be a member of the Council, the Prime Minister may appoint another person to fill the vacancy for the remainder of the term for which the vacating member was appointed. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall convene its meetings at least once in every three months and the meeting shall be held at the time and place specified in a written notice by the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may authorize the use of live video, television links or other appropriate communication or multimedia facilities for the purposes of any meeting of the Council. Procedure at meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is absent from any meeting of the Council, he may appoint any member of the Council to replace him as the chairman of the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Council shall be five."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Every member except the Chief Executive Officer shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is an equality of votes, the Chairman or the member replacing the Chairman referred to in subsection (2) shall have the casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may regulate its own procedure. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall cause the minutes of all its meetings to be maintained and kept in proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of a meeting of the Council shall, if duly signed by the Chairman, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Council in respect of which minutes of the proceedings have been made in accordance with subsections (1) and (2) shall be deemed to have been duly convened and held and all members at the meeting to have been duly qualified to act. Council may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any other person to attend any meeting of the Council for the purpose of advising the Council on any matter under discussion, but the person so attending is not entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited under subsection (1) may be paid such allowances as the Council may determine. Resolutions without meeting"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Council may, where necessary, pass a resolution without meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The following conditions shall be complied with:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all members of the Council have been informed of the proposed resolution, or reasonable efforts have been made to inform all members of the Council of the proposed resolution; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all members of the Council indicate agreement with the resolution in accordance with the method determined by the Council. Council may establish committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish any committee as it considers necessary or expedient to assist it in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall cause minutes of all its meetings to be maintained and kept in proper form, and copies of the minutes shall be submitted by the committee to the Council as soon as practicable. Vacation of office of member of committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint any person to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall appoint the chairman of the committee established under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall be subject to and act in accordance with any direction given by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall meet as often as may be necessary at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The committee may invite any other person to attend any meeting of the committee for the purpose of advising the committee on the matter under discussion, but the person so attending is not entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the committee or any person invited under subsection (7) to attend any meeting of the committee may be paid such allowances as the Council may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "All decisions made by the committee shall be tabled during the meeting of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of a committee appointed under section 16 shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the committee without leave of the Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Council; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member of the committee ceases to be a member, the Council may appoint another person to fill the vacancy for the remainder of the term for which the vacating member was appointed. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Council or a committee having directly or indirectly any interest in relation to any matter under discussion by the Council or the committee shall disclose to the Council or the committee, as the case may be, the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Council or the committee, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Upon disclosure under subsection (1), the member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall not take part in or be present during any discussion or decision of the Council or the committee; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the meeting of the Council or the committee, relating to the matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Council or the committee who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "No act or proceeding of the Council or the committee shall be invalidated on the ground that any member of the Council or the committee has contravened this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of “Agensi Inovasi Malaysia” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall have perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may sue and be sued in its name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Agency may, upon such terms as it deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase, take, hold and enjoy movable and immovable property of every description; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_4__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "convey, assign, surrender, yield up, charge, mortgage, demise, lease, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property or any interest vested in the Agency. Functions of the Agency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Agency are as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate national policies, strategies and directions relating to innovation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to organize, co-operate in and coordinate the performance of activities with the public and private sector to stimulate innovation in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct inquiries, survey and analysis of data, research and development relating to innovation and the national innovation eco-system;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to promote and facilitate investment activities and initiatives by the public and private sector in relation to innovation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to further promote the culture of innovation in the public, private and education sectors in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Government in matters relating to innovation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations relating to the innovation component of existing or future strategic national projects;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out any other functions as it deems fit to enable it to perform its functions effectively or which is incidental to the performance of its functions. Powers of the Agency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall have the power to do all things expedient or reasonably necessary for or incidental to the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the powers of the Agency shall include the power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to carry on all activities, particularly activities which are commercial in nature, which appear to it to be requisite, advantageous or convenient for or in connection with the performance of its functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "subject to any written law, to call for information on matters relating to innovation in furtherance of the performance of its functions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (3), to impose fees or charges for any service rendered in the exercise of its powers and the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any fees or charges to be imposed shall be prescribed in the regulations made under section 41. Governance Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall be administered by a council to be known as the “Governance Council”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Prime Minister as the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for science, technology and innovation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for domestic trade, cooperatives and consumerism;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for higher education;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for finance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister in the Prime Minister’s Department charged with the responsibility for the Economic Planning Unit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ten other members who, in the opinion of the Prime Minister, possess the relevant qualifications, special knowledge or experience in the subject of innovation, science, technology, business, economics or government policies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A member referred to in paragraph (2)(h) shall be appointed by the Prime Minister and shall, unless he sooner resigns, vacates his office or his appointment is sooner revoked, hold office for a term not exceeding three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A member referred to in paragraph (2)(h) shall be eligible for reappointment but no member shall hold office for more than three terms consecutively. Alternate members"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister may, in respect of each member appointed under paragraph 7(2)(b) to (f), appoint an alternate member to attend, in place of that member, meetings of the Council when the member is for any reason unable to attend."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "When attending meetings of the Council, an alternate member shall, for all purposes, be deemed to be a member of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "An alternate member shall, unless he sooner resigns or his appointment is sooner revoked, cease to be an alternate member when the member in respect of whom he is an alternate ceases to be a member of the Council. Allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Council shall not be paid any fixed monthly remuneration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the members of the Council shall be paid such allowances as the Prime Minister may determine in relation to attending to meetings of the Council and matters related to the Council. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE Operational Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Agency shall establish and maintain an Operational Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Operational Fund shall consist of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys received by the Agency in performing its functions under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided from time to time for the purposes of this Act by Parliament;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys earned by the operation of any project or activities financed from the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums borrowed by the Agency for the purposes of meeting any of its obligations or discharging any of its duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other sums or property which may in any manner become payable to or vested in the Agency in respect of any matter incidental to its functions, powers and duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Operational Fund shall be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of any operational expenses, costs or expenditure properly incurred or accepted by the Agency in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any purchase made by the Agency;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of remuneration, allowances, benefits, reimbursement and expenses of officers and employees of the Agency and members of the Council or committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the repayment of any moneys borrowed under this Act and the interest due thereon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of contributions and donations for purposes of corporate social responsibility."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (2)(c), the moneys referred to in the paragraph which are in excess of the financial requirements of the Agency for the performance of its functions may be paid into the Federal Consolidated Fund. Innovation Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Agency shall establish and maintain an Innovation Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Innovation Fund shall consist of all moneys and property received by the Agency from the Government, any organization, body corporate or institution solely for the purposes of research activities and initiatives relating to innovation, and shall be disbursed for such like purposes, including funding of selected innovation determined by the Agency. Conservation of Operational Fund and Innovation Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Agency to conserve the Operational Fund and the Innovation Fund by so performing, exercising and discharging its functions, powers and duties under this Act so as to secure that the total revenues of the Agency are sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest on capital, taking one year with another. Expenditure and preparation of estimate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Agency up to such amount as may be authorized by the Prime Minister for one year shall be defrayed out of the Operational Fund and Innovation Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Before the end of September of each year, the Agency shall submit to the Prime Minister an estimate of the expenditure, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "projected budget and expenses for Operational Fund and Innovation Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "proposed activities and projects to be carried out; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the key performance indicators of the proposed activities and projects to be carried out, by reference to which the development, performance or position of the Agency can be measured effectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister shall, before the beginning of the following year, notify the Agency of the amount authorized for expenditure generally or of the amount authorized for each description of expenditure based on the estimates prepared under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may, at any time, submit to the Prime Minister a supplementary estimate of its expenditure for any one year and the Prime Minister may allow the whole or any part of the additional expenditure included in the supplementary estimate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister may direct the Agency to submit a copy of the estimate or supplementary estimate, as the case may be, to such other public authority as may be specified in the direction. Financial year"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The financial year of the Agency shall begin on 1 January and end on 31 December of each year. Accounts and reports"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall cause to be kept proper accounts of the Operational Fund and the Innovation Fund and reports of its activities and shall, as soon as practicable after the end of each financial year, caused to be prepared for that financial year—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of accounts of the Agency which shall include a balance sheet and an account of income and expenditure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of its activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall as soon as possible send a copy of the statements of accounts and statements of activities mentioned in subsection (1) certified by the Auditor General and a copy of the Auditor General’s report to the Prime Minister who shall cause them to be laid before both Houses of Parliament."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Account and Annual Reports) Act 1980 [Act 240] shall apply to the Agency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Agensi Inovasi Malaysia Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Prime Minister by notification in the Gazette. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply for a period until 31 December"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Prime Minister may, by order published in the Gazette, extend the application of the Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "An order made under subsection (2) shall be laid before both Houses of Parliament. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“Agency” means the Agensi Inovasi Malaysia established under section 4; “Innovation Ambassador” means the Innovation Ambassador appointed under section 31; “intellectual property” include copyright, patent, trademark, integrated circuit layout design, geographical indication and industrial design whether registered or otherwise and manifested or stored in any form whatsoever; “innovation” means any idea or knowledge in whatever form which brings about changes in the form of product, service or process resulting in positive impact to the economy, business, public service delivery system, social well-being or the environment; “committee” means the committee established by the Governance Council under section 16; “Chief Executive Officer” means the Chief Executive Officer appointed under section 19; “national intellectual property central depository” means the depository established under section 28; “Council” means the Governance Council established under section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_V__cl_30"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROVISIONS RELATING TO INTELLECTUAL PROPERTY National intellectual property central depository"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/41/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
