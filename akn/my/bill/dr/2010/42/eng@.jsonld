      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 51 of the principal act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2) in the national language text, by deleting the words “perjanjian timbang tara dibuat atau”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(4) any court proceedings relating to arbitration commenced after the commencement of this act shall be governed by this act notwithstanding that such proceedings arose out of arbitral proceedings commenced before the commencement of this act.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act may be cited as the arbitration (amendment) act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The arbitration act 2005 [Act 646], which is referred to as the “principal act” in this act, is amended in paragraph 2(2)(b) by substituting for the words “sections 3 and 30” the words “section 3”. Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal act is amended by substituting for section 8 the following section: “Extent of court intervention 8. No court shall intervene in matters governed by this act, except where so provided in this act.”. Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 10 of the principal act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) a court before which proceedings are brought in respect of a matter which is the subject of an arbitration agreement shall, where a party makes an application before taking any other steps in the proceedings, stay those proceedings and refer the parties to arbitration unless it finds that the agreement is null and void, inoperative or incapable of being performed.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsections: “(2a) Where admiralty proceedings are stayed pursuant to subsection (1), the court granting the stay may, if in those proceedings property has been arrested or bail or other security has been given to prevent or obtain release from arrest— (a) order that the property arrested be retained as security for the satisfaction of any award given in the arbitration in respect of that dispute; or (b) order that the stay of those proceedings be conditional on the provision of equivalent security for the satisfaction of any such award. (2b) Subject to any rules of court and to any necessary modifications, the same law and practice shall apply in relation to property retained in pursuance of an order under subsection (2a) as would apply if it were held for the purposes of proceedings in the court making the order. (2c) For the purpose of this section, admiralty proceedings refer to admiralty proceedings under Order 70 of the Rules of the High Court 1980 [P.U. (A) 50/1980] and proceedings commenced pursuant to paragraph 24(b) of the Courts of Judicature act 1964 [Act 91].”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(4) This section shall also apply in respect of an international arbitration, where the seat of arbitration is not in Malaysia.”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the principal act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (1)(e), by inserting after the word “dispute” the words “, whether by way of arrest of property or bail or other security pursuant to the admiralty jurisdiction of the High Court”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: “(3) This section shall also apply in respect of an international arbitration, where the seat of arbitration is not in Malaysia.”. Amendment of section 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 30(1) of the principal act is amended by substituting for the words “in respect of” the words “Unless otherwise agreed by the parties, in respect of”. Amendment of section 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 38(1) of the principal act is amended by substituting for the words “a domestic arbitration” the words “an arbitration where the seat of arbitration is in Malaysia”. Amendment of section 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 39 of the principal act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (a)(ii), by substituting for the word “Malaysia” the words “the State where the award was made”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (a)(v), by substituting for the word “(2)” the word “(3)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: “(3) Where the decision on matters submitted to arbitration can be separated from those not so submitted, only that part of the award which contains decisions on matters submitted to arbitration may be recognized and enforced.”. Amendment of section 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 42 of the principal act is amended by inserting after subsection (1) the following subsection: “(1a) The High Court shall dismiss a reference made under subsection (1) unless the question of law substantially affects the rights of one or more of the parties.”. Amendment of section 51"
      }
    }
  ]
}
