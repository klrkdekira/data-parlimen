      ],
      "schema:name": {
        "@language": "en",
        "@value": "Arbitration (Amendment) Bill 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
