      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Timbang Tara (Pindaan) 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 51 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) dalam teks bahasa kebangsaan, dengan memotong perkataan “perjanjian timbang tara dibuat atau”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(4) Apa-apa prosiding mahkamah yang berhubungan dengan timbang tara yang telah dimulakan selepas permulaan kuat kuasa Akta ini hendaklah dikawal oleh Akta ini walaupun prosiding itu timbul daripada prosiding timbang tara yang bermula sebelum permulaan kuat kuasa Akta ini.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Timbang Tara (Pindaan) 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Timbang Tara 2005 [Akta 646], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 2(2)(b) dengan menggantikan perkataan “seksyen 3 dan 30” dengan perkataan “seksyen 3”. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 8 dengan seksyen yang berikut: “Takat campur tangan mahkamah 8. Tiada mahkamah boleh campur tangan dalam perkara yang dikawal oleh Akta ini, kecuali jika diperuntukkan sedemikian dalam Akta ini.”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Mahkamah yang di hadapannya prosiding dibawa berkenaan dengan suatu perkara yang menjadi hal suatu perjanjian timbang tara hendaklah, jika suatu pihak membuat permohonan sebelum mengambil apa- apa langkah lain dalam prosiding itu, menggantung prosiding itu dan merujukkan pihak-pihak itu kepada timbang tara melainkan jika mahkamah itu mendapati bahawa perjanjian itu adalah batal dan tidak sah, tidak berkuat kuasa atau tidak dapat dilaksanakan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Jika prosiding admiralti digantung menurut subseksyen (1), mahkamah yang membenarkan penggantungan itu boleh, jika dalam prosiding mahkamah itu harta pernah ditahan atau ikat jamin atau jaminan lain telah diberikan untuk mengelakkan atau mendapatkan pelepasan daripada tahanan— (a) memerintahkan supaya harta yang ditahan itu dipegang sebagai jaminan bagi penyelesaian apa-apa award yang diberikan dalam timbang tara berkenaan dengan pertikaian itu; atau (b) memerintahkan supaya penggantungan prosiding itu adalah dengan syarat pengadaan jaminan yang setara bagi penyelesaian apa-apa award sedemikian. (2b) Tertakluk kepada apa-apa kaedah-kaedah mahkamah dan kepada apa-apa ubah suaian yang perlu, undang-undang dan amalan yang sama hendaklah terpakai berhubungan dengan harta yang ditahan menurut suatu perintah di bawah subseksyen (2a) sebagaimana akan terpakai jika ia ditahan bagi maksud prosiding dalam mahkamah yang membuat perintah itu. (2c) Bagi maksud seksyen ini, prosiding admiralti merujuk kepada prosiding admiralti di bawah Aturan 70 Kaedah-Kaedah Mahkamah Tinggi 1980 [P.U. (A) 50/1980] dan prosiding yang dimulakan menurut perenggan 24(b) Akta Mahkamah Kehakiman 1964 [Akta 91].”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(4) Seksyen ini hendaklah juga terpakai berkenaan dengan timbang tara antarabangsa, sekiranya tempat timbang tara bukan di Malaysia.”. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(e), dengan memasukkan selepas perkataan “pertikaian” perkataan “, sama ada melalui penahanan harta atau ikat jamin atau jaminan lain menurut bidang kuasa admiralti Mahkamah Tinggi”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Seksyen ini hendaklah juga terpakai berkenaan dengan timbang tara antarabangsa, sekiranya tempat timbang tara bukan di Malaysia.”. Pindaan seksyen 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 30(1) Akta ibu dipinda dengan menggantikan perkataan “Berkenaan dengan” dengan perkataan “Melainkan jika dipersetujui selainnya oleh pihak-pihak, berkenaan dengan”. Pindaan seksyen 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 38(1) Akta ibu dipinda dengan menggantikan perkataan “timbang tara domestik” dengan perkataan “suatu timbang tara sekiranya tempat timbang tara adalah di Malaysia”. Pindaan seksyen 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (a)(ii), dengan menggantikan perkataan “Malaysia” dengan perkataan “Negara di mana award dibuat”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (a)(v), dengan menggantikan perkataan “(2)” dengan perkataan “(3)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Jika keputusan tentang perkara yang dikemukakan kepada timbang tara boleh diasingkan daripada perkara yang tidak dikemukakan, hanya bahagian award itu yang mengandungi keputusan tentang perkara yang dikemukakan kepada timbang tara boleh diiktiraf dan dikuatkuasakan.”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu dipinda dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Mahkamah Tinggi hendaklah menolak suatu rujukan yang dibuat di bawah subseksyen (1) melainkan jika soal undang-undang itu menjejaskan secara substansial hak satu pihak atau lebih.”. Pindaan seksyen 51"
      }
    }
  ]
}
