      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI Perbelanjaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dilakukan oleh pemunya, pemberi konsain, penerima konsain atau pengimport akibat daripada syarat yang dikenakan oleh Ketua Pengarah atau mana-mana pegawai penguat kuasa dalam menjalankan kuasanya di bawah Akta ini hendaklah ditanggung oleh pemunya, pemberi konsain, penerima konsain atau pengimport, mengikut mana-mana yang berkenaan, bagi mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau makanan yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbelanjaan yang dilakukan oleh Ketua Pengarah atau pegawai penguat kuasa dalam menjalankan kuasanya di bawah Akta ini hendaklah dipertanggungkan pada pemunya, pemberi konsain, penerima konsain atau pengimport, mengikut mana-mana yang berkenaan, bagi mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, makanan atau benda lain yang berkenaan dan boleh didapatkan kembali sebagai hutang sivil."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pampasan boleh dibayar kepada mana-mana orang berkenaan dengan pelupusan mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain di bawah subseksyen 29(9). Wang yang dipungut atau diterima di bawah Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika wang dipungut atau diterima di bawah Akta ini bagi pihak agensi atau jabatan yang berkaitan, wang itu hendaklah diuruskan mengikut undang-undang bertulis yang berkaitan. Khidmat pakar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh memperoleh apa-apa khidmat pakar dalam bidang kepakaran yang berkaitan daripada agensi atau jabatan yang berkaitan atau khidmat pakar dari dalam atau luar Malaysia untuk memastikan pelaksanaan Akta ini dengan berkesan. Pakaian seragam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai penguat kuasa hendaklah memakai pakaian seragam yang ditetapkan oleh Ketua Pengarah semasa menjalankan tugas melainkan jika dikecualikan secara bertulis oleh Ketua Pengarah. Pejabat dan kemudahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi atau jabatan yang berkaitan atau entiti swasta yang menguruskan premis di pintu masuk hendaklah menyediakan di pintu masuk itu pejabat dan kemudahan bagi pemeriksaan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, makanan atau benda lain dan untuk menjalankan tatacara kuarantin ke atas mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, atau benda lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala kos dan perbelanjaan yang dilakukan berhubung dengan pejabat dan kemudahan yang disediakan di bawah subseksyen (1) hendaklah ditanggung oleh agensi atau jabatan yang berkaitan atau entiti swasta itu. Kuasa untuk meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Ketua Pengarah, melalui perintah yang disiarkan dalam Warta meminda Jadual. Kesalahan yang dilakukan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini, mana-mana orang yang pada masa pelakuan kesalahan itu ialah pengarah, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi pertubuhan perbadanan itu atau yang berupa bertindak atas apa-apa sifat sedemikian atau yang dalam apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh didakwa secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati telah melakukan kesalahan itu, hendaklah disifatkan telah melakukan kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuan, persetujuan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga- jaga yang munasabah dan telah menjalankan usaha yang wajar untuk mencegah pelakuan kesalahan itu. Kesalahan yang dilakukan oleh pekongsi, ejen atau pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang boleh dikenakan mana-mana penalti di bawah Akta ini bagi apa-apa perbuatan, peninggalan, pengabaian atau keingkaran jika perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan olehnya sendiri boleh dikenakan penalti yang sama jika perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan oleh pekongsi, ejen atau pekhidmatnya melainkan jika dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan tanpa pengetahuan, keizinan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga-jaga yang munasabah dan telah menjalankan usaha yang wajar untuk mencegah perbuatan, peninggalan, pengabaian atau keingkaran itu. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang disabitkan atas suatu kesalahan di bawah Akta ini yang baginya tiada penalti dperuntukkan dengan khusus, boleh didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam tahun atau kedua-duanya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, dengan keizinan bertulis Pendakwa Raya, membuat tawaran bertulis untuk mengkompaun mana-mana kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini dan yang ditetapkan sebagai kesalahan yang boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang itu untuk mengkompaun kesalahan itu apabila dibayar kepada Ketua Pengarah suatu amaun yang tidak melebihi lima puluh peratus amaun maksimum denda bagi kesalahan itu dalam masa yang ditetapkan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika amaun yang dinyatakan dalam tawaran di bawah subseksyen (1) tidak dibayar dalam masa yang ditetapkan dalam tawaran itu atau dalam apa-apa tempoh lanjutan yang diberikan oleh Ketua Pengarah, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan selepas itu berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun telah dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, secara bertulis, mewakilkan fungsi dan tugasnya di bawah seksyen ini kepada mana-mana pegawai penguat kuasa tertakluk kepada terma dan syarat sebagaimana yang difikirkannya patut, tetapi perwakilan di bawah subseksyen ini tidak menghalang Ketua Pengarah daripada melaksanakan atau menjalankan fungsi dan tugas yang telah diwakilkan. Permulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi atau berhubung dengan mana-mana kesalahan di bawah Akta ini boleh dimulakan tanpa keizinan bertulis Pendakwa Raya. Perlindungan terhadap guaman dan prosiding undang- undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai atau pegawai penguat kuasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain bagi atau atas sebab atau berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa dilakukan olehnya di bawah perintah, arahan atau suruhan Ketua Pengarah, pegawai penguat kuasa atau mana-mana pegawai lain yang dilantik dengan sewajarnya oleh Ketua Pengarah, jika perbuatan itu dilakukan dengan suci hati dan dengan mempercayai semunasabahnya bahawa ia perlu bagi maksud yang diniatkan untuk dicapai melaluinya dan bagi melaksanakan peruntukan Akta ini. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan, tidak termasuk bagi perkara yang berhubungan dengan makanan, yang perlu atau suai manfaat untuk melaksanakan sepenuhnya atau bagi menjalankan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan- peraturan boleh dibuat bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan semua perkara yang berhubungan dengan kuarantin dan pemeriksaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan semua perkara yang berhubungan dengan tatacara kuarantin;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan semua perkara yang berhubungan dengan permit, lesen dan perakuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan semua perkara yang berhubungan dengan pendaftaran pengimport, pengeksport dan ejen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengisytiharkan mana-mana premis sebagai stesen kuarantin atau premis kuarantin;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tatacara bagi mengambil dan berurusan dengan sampel;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan pakaian seragam pegawai penguat kuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi dan caj yang kena dibayar di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kesalahan yang boleh dikompaun. Peruntukan kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan atau kes yang belum selesai yang berhubungan dengan kuarantin, pemeriksaan, penguatkuasaan atau import dan eksport apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau makanan di bawah undang-undang bertulis yang berkaitan sebelum permulaan kuat kuasa Akta ini tidak terjejas oleh Akta ini dan hendaklah diteruskan seolah-olah Akta ini tidak diperbuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Walaupun Akta ini telah mula berkuat kuasa, sehingga suatu masa apabila undang-undang bertulis yang berkaitan, tidak termasuk Akta Makanan 1983, dipinda berbangkit daripada Akta ini dan pindaan itu mula berkuat kuasa, agensi atau jabatan yang berkaitan hendaklah meneruskan untuk menjalankan kuarantin, pemeriksaan, penguatkuasaan dan pemerakuan import dan eksport apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan atau kes yang belum selesai di bawah undang-undang bertulis yang berkaitan yang berhubungan dengan kuarantin, pemeriksaan, penguatkuasaan dan import dan eksport apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma yang dibuat atau dimulakan semasa tempoh sebaik selepas permulaan kuat kuasa Akta ini dan sebaik sebelum undang-undang bertulis yang berkaitan dipinda berbangkit daripada Akta ini dan pindaan itu mula berkuat kuasa tidak terjejas oleh pindaan itu dan hendaklah diteruskan seolah-olah pindaan itu tidak dibuat kepada undang-undang bertulis yang berkaitan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa hendaklah menjalankan kuasa di bawah Bahagian ini di pintu masuk, stesen kuarantin dan premis kuarantin."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), seseorang pegawai penguat kuasa yang dilantik di bawah subseksyen 5(5) untuk menjalankan kuasa di bawah perenggan 9(b) hendaklah menjalankan kuasa sedemikian di pintu masuk dan mengikut Akta Makanan 1983 sahaja. Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa hendaklah mempunyai segala kuasa yang perlu untuk menjalankan penyiasatan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana hal yang berhubungan dengan pelakuan suatu kesalahan di bawah Akta ini, pegawai penguat kuasa yang menjalankan penyiasatan boleh menjalankan semua atau mana-mana kuasa berhubung dengan penyiasatan polis dalam kes boleh tangkap yang diberikan oleh Kanun Tatacara Jenayah [Akta 593]. Kuasa penangkapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa boleh menangkap tanpa waran mana-mana orang yang dipercayainya dengan munasabah telah melakukan atau cuba untuk melakukan suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa yang membuat penangkapan di bawah subseksyen (1) hendaklah, tanpa kelengahan yang tidak perlu, membawa orang yang ditangkap itu ke balai polis yang paling hampir, dan sesudah itu orang itu hendaklah diperlakukan mengikut undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, atas maklumat bertulis dengan bersumpah dan selepas apa-apa siasatan sebagaimana yang difikirkannya perlu, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa mana-mana premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin telah digunakan atau akan digunakan bagi, atau ada di dalam atau pada mana-mana premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin, keterangan yang perlu untuk membuktikan pelakuan suatu kesalahan di bawah Akta ini, Majistret boleh mengeluarkan suatu waran yang memberi kuasa seseorang pegawai penguat kuasa yang kepadanya diarahkan, pada bila-bila masa yang munasabah pada waktu siang atau malam dan dengan atau tanpa bantuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memasuki mana-mana premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin dan menggeledah bagi, menyita dan menahan mana-mana buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memeriksa, membuat salinan, atau mengambil cabutan daripada, mana-mana buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain yang disita dan ditahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil milikan, dan memindahkan dari premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin, mana-mana buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain yang disita dan menahannya bagi suatu tempoh sebagaimana yang perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggeledah mana-mana orang yang berada di dalam, atau pada, premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin, dan bagi maksud menggeledah, menahan orang itu dan memindahkannya ke tempat yang perlu untuk membantu penggeledahan, dan menyita dan menahan apa-apa harta atau dokumen yang dijumpai pada orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memecah buka, memeriksa dan menggeledah mana-mana buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa yang bertindak di bawah subseksyen (1) boleh, jika perlu berbuat demikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memecah buka mana-mana pintu luar atau dalam mana-mana premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin dan memasuki premis itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memasuki dengan kekerasan mana-mana premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin dan tiap-tiap bahagiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memindahkan dengan menggunakan kekerasan apa-apa halangan kepada kemasukan, penggeledahan, penyitaan, penahanan atau pemindahan yang dia diberi kuasa untuk melaksanakan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menahan mana-mana orang yang dijumpai di mana-mana permis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin yang digeledah di bawah subseksyen (1) sehingga penggeledahan itu selesai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab jenis, saiz atau amaunnya, adalah tidak munasabah untuk memindahkan mana-mana buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain yang disita di bawah seksyen ini, pegawai penguat kuasa yang membuat penyitaan itu hendaklah, dengan apa-apa cara, mengelak buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, hasil pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (3) atau memindahkan buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain itu yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya dan dalam hal kesalahan yang berterusan didenda tidak melebihi satu ribu ringgit bagi tiap- tiap hari atau sebahagian daripada hari kesalahan itu berterusan selepas disabitkan. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai penguat kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran geledah di bawah subseksyen 19(1) penyiasatan akan terjejas atau keterangan mengenai pelakuan sesuatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai penguat kuasa itu boleh memasuki premis yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin dan menjalankan dalam, di dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 19 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia telah diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walaupun apa-apa kecacatan, kesilapan atau peninggalan dalamnya atau dalam permohonan bagi waran itu, dan apa-apa buku, rekod, dokumen, komputer, peralatan, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, permit, lesen, perakuan, atau benda lain yang disita di bawah waran itu boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Kuasa untuk mengelak premis dan pengangkut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan kuasa di bawah seksyen 19 dan 20, seseorang pegawai penguat kuasa boleh mengelak buat sementara waktu mana-mana premis dan pengangkut yang terletak di pintu masuk, stesen kuarantin dan premis kuarantin. Akses kepada data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa yang menjalankan penggeledahan di bawah Akta ini hendaklah diberi akses kepada data berkomputer sama ada yang disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, seseorang pegawai penguat kuasa hendaklah diberikan kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang diperlukan untuk membolehkan data berkomputer itu difahami. Kuasa untuk memberhentikan, menggeledah dan menyita pengangkut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai penguat kuasa mempunyai sebab yang munasabah untuk mengesyaki bahawa mana-mana pengangkut sedang membawa suatu tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang berkenaan dengannya suatu kesalahan di bawah Akta ini sedang atau telah dilakukan, dia boleh memberhentikan dan memeriksa pengangkut itu dan boleh, jika atas pemeriksaan dia mempunyai sebab yang munasabah untuk mempercayai bahawa pengangkut itu sedang atau telah digunakan untuk melakukan kesalahan itu, menyita pengangkut itu dan mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang dijumpai dalam pengangkut itu yang dengan semunasabahnya dipercayai memberikan keterangan mengenai pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang mengawal atau menjaga pengangkut itu hendaklah, jika dikehendaki untuk berbuat demikian oleh pegawai penguat kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberhentikan pengangkut itu dan membenarkan pegawai penguat kuasa itu memeriksanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuka semua bahagian pengangkut itu untuk diperiksa dan mengambil segala langkah yang perlu untuk membolehkan atau memudahkan penjalanan pemeriksaan itu sebagaimana yang difikirkan perlu oleh pegawai penguat kuasa. Senarai tumbuhan, binatang, karkas, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa penyitaan dibuat di bawah Akta ini, seseorang pegawai penguat kuasa yang membuat penyitaan itu hendaklah menyediakan senarai tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita dan hendaklah menandatangani senarai itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Senarai yang disediakan mengikut subseksyen (1) hendaklah diserahkan dengan serta-merta kepada orang yang mengawal atau menjaga pengangkut itu jika penyitaan dibuat di bawah seksyen 24. Pemeriksaan orang yang mengetahui kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa yang membuat penyiasatan di bawah Akta ini boleh memeriksa secara lisan mana-mana orang yang dijangkakan mengetahui fakta dan hal keadaan kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu adalah terikat untuk menjawab segala soalan yang berhubungan dengan kes itu yang dikemukakan kepadanya oleh pegawai penguat kuasa, tetapi dia boleh enggan untuk menjawab apa-apa soalan yang jawapannya mungkin mendedahkannya kepada suatu pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang membuat pernyataan di bawah seksyen ini adalah terikat di sisi undang-undang untuk menyatakan yang benar, sama ada atau tidak pernyataan itu dibuat keseluruhannya atau sebahagiannya bagi menjawab soalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa yang memeriksa seseorang di bawah subseksyen (1) hendaklah terlebih dahulu memaklumkan orang itu mengenai peruntukan subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah, bilamana mungkin, diubah ke dalam bentuk bertulis dan ditandatangani oleh orang yang membuatnya atau dilekatkan dengan cap ibu jarinya, mengikut mana-mana yang berkenaan, selepas—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pernyataan itu dibacakan kepadanya dalam bahasa yang dalamnya pernyataan itu dibuat olehnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dia diberi peluang untuk membuat apa-apa pembetulan yang ingin dibuat olehnya. Kebolehterimaan pernyataan dalam keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam seksyen ini, tiada pernyataan yang dibuat oleh mana-mana orang kepada seseorang pegawai penguat kuasa semasa penyiasatan yang dibuat di bawah Akta ini boleh digunakan sebagai keterangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana saksi dipanggil bagi pendakwaan atau bagi pembelaan, selain tertuduh, mahkamah hendaklah, atas permintaan tertuduh atau pendakwa, merujuk kepada mana- mana pernyataan yang dibuat oleh saksi itu kepada seseorang pegawai penguat kuasa semasa sesuatu penyiasatan di bawah Akta ini dan boleh kemudiannya, jika mahkamah berpendapat patut demi kepentingan keadilan, mengarahkan supaya tertuduh diberi suatu salinan pernyataan itu dan pernyataan itu boleh digunakan untuk mencabar kebolehpercayaan saksi itu mengikut cara yang diperuntukkan oleh Akta Keterangan 1950 [Akta 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tertuduh telah membuat suatu pernyataan semasa sesuatu penyiasatan, pernyataan itu boleh diterima sebagai keterangan bagi menyokong pembelaannya semasa perbicaraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini boleh disifatkan terpakai bagi mana-mana pernyataan yang dibuat semasa suatu kawad cam atau terangkum dalam seksyen 27 atau perenggan 32(1)(a), (i) dan (j) Akta Keterangan 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang dipertuduh atas apa-apa kesalahan berhubung dengan pembuatan atau kandungan apa-apa pernyataan yang dibuat olehnya kepada seseorang pegawai penguat kuasa semasa sesuatu penyiasatan yang dibuat di bawah Akta ini, pernyataan itu boleh digunakan sebagai keterangan dalam kes pendakwaan. Kuasa untuk menghendaki kehadiran orang yang mengetahui kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai penguat kuasa yang membuat penyiasatan di bawah Akta ini boleh, melalui perintah secara bertulis, menghendaki mana-mana orang yang pada hemat pegawai penguat kuasa itu mengetahui fakta dan hal keadaan kes itu supaya hadir di hadapannya, dan orang itu hendaklah hadir sebagaimana yang dikehendaki."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang enggan hadir sebagaimana yang dikehendaki oleh suatu perintah yang dibuat di bawah subseksyen (1), pegawai penguat kuasa itu boleh melaporkan keengganannya itu kepada Majistret yang hendaklah mengeluarkan suatu waran untuk memastikan kehadiran orang itu sebagaimana yang dikehendaki oleh perintah itu. Pelucuthakan tumbuhan, binatang, karkas, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita pada menjalankan mana-mana kuasa yang diberikan di bawah Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi pelucuthakan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain, hendaklah dibuat jika dibuktikan sehingga memuaskan hati mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu merupakan hal perkara bagi atau digunakan dalam pelakuan kesalahan itu, walaupun tiada orang telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita di bawah Akta ini, tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu hendaklah diambil dan disifatkan terlucut hak apabila tamat tempoh satu bulan kalendar dari tarikh penyampaian notis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis yang disebut dalam subseksyen (3) hendaklah menunjukkan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pendakwaan berkenaan dengan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu, hendaklah diambil dan disifatkan terlucut hak apabila tamat tempoh satu bulan kalendar dari tarikh penyampaian notis itu melainkan jika sebelum tarikh itu suatu tuntutan baginya telah dibuat mengikut cara yang dinyatakan dalam subseksyen (5), (6) dan (7)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disebut dalam subseksyen (3) dan bahawa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu tidak boleh dilucuthakkan boleh dengan sendiri atau melalui ejennya yang diberi kuasa secara bertulis, memberikan notis bertulis kepada pegawai penguat kuasa yang dalam miliknya tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu dipegang bahawa dia menuntut tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila notis yang disebut dalam subseksyen (4) diterima, pegawai penguat kuasa itu hendaklah merujukkan tuntutan itu kepada Majistret."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret yang kepadanya sesuatu perkara dirujukkan di bawah subseksyen (5) hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu dan orang yang daripadanya ia disita hadir di hadapannya, dan apabila mereka hadir atau tidak hadir, setelah dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, Majistret hendaklah meneruskan pemeriksaan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disebut dalam subseksyen (7) merupakan hal perkara bagi atau telah digunakan dalam pelakuan kesalahan itu, Majistret itu hendaklah memerintahkan supaya tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu dilucuthakkan, dan hendaklah, jika tiada bukti sedemikian, memerintahkan pelepasannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang dilucuthakkan atau disifatkan terlucut hak hendaklah dilupuskan mengikut cara sebagaimana yang difikirkan patut oleh Ketua Pengarah. Pelepasan tumbuhan, binatang, karkas, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain telah disita di bawah Akta ini, pegawai penguat kuasa yang membuat penyitaan itu boleh, selepas merujuk kepada Ketua Pengarah, melepaskan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita di bawah Akta ini kepada orang yang daripada milikan, jagaan atau kawalannya ia disita."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod secara bertulis hendaklah dibuat oleh pegawai penguat kuasa yang membuat pelepasan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain di bawah subseksyen (1) yang menyatakan secara terperinci hal keadaan dan sebab bagi pelepasan itu, dan dia hendaklah menghantarkan satu salinan rekod itu kepada Ketua Pengarah dalam masa tujuh hari dari pelepasan itu. Kos memegang tumbuhan, binatang, karkas, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma, makanan atau benda lain yang disita di bawah Akta ini dipegang dalam jagaan pegawai penguat kuasa sementara menunggu penyelesaian apa-apa prosiding berkenaan dengan suatu kesalahan di bawah Akta ini, kos bagi memegangnya dalam jagaan hendaklah, sekiranya mana-mana orang disabitkan atas kesalahan itu, menjadi hutang yang kena dibayar kepada Kerajaan oleh orang itu dan bolehlah didapatkan dengan sewajarnya. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun, dalam apa-apa prosiding di hadapan mana- mana mahkamah berkenaan dengan penyitaan mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita pada menjalankan atau yang berupa penjalanan mana-mana kuasa yang diberikan di bawah Akta ini, berhak mendapat kos prosiding itu atau apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Kuasa untuk mengambil sampel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa boleh meminta, memilih, mengambil atau memperoleh sampel mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain bagi maksud analisis, tanpa bayaran, daripada mana-mana orang yang mengimport atau mengeksport tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Tatacara bagi mengambil dan berurusan dengan sampel itu adalah sebagaimana yang ditetapkan oleh peraturan- peraturan. Pemeriksaan atau pengujian tumbuhan, binatang, karkas, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika adalah perlu untuk memeriksa atau menguji mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita di bawah Akta ini, adalah mencukupi untuk memeriksa atau menguji sampel yang mewakili tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu atau, jika tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu dibungkus dalam tempat penyimpanan yang berlainan, kandungan setiap tempat penyimpanan itu. Kuasa tambahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai penguat kuasa hendaklah, bagi maksud melaksanakan Akta ini, mempunyai kuasa untuk melakukan semua atau mana-mana daripada yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki pengemukaan apa-apa buku, rekod atau dokumen yang disimpan oleh mana-mana orang dan untuk meneliti, memeriksa, dan untuk membuat salinan daripadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki pengemukaan apa-apa dokumen pengenalan daripada mana-mana orang berhubung dengan mana-mana kes atau kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat apa-apa siasatan yang perlu untuk menentukan sama ada peruntukan Akta ini telah dipatuhi. Menghalang pegawai penguat kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menghalang, menyekat atau mengganggu mana-mana pegawai penguat kuasa dalam pelaksanaan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil balik atau berusaha untuk mengambil balik mana-mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain yang disita di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum atau selepas apa-apa penyitaan menyebabkan kehilangan, atau merosakkan atau memusnahkan mana- mana tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu untuk menghalang penyitaannya atau penyimpanan selamat tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih, mikroorganisma atau benda lain itu, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam tahun atau kedua-duanya dan, bagi kesalahan kedua atau yang berikutnya didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mengimport apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma tanpa permit, lesen atau perakuan yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mengeksport apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma tanpa permit atau lesen yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terlibat dalam pengimportan dan pengeksportan apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam tahun atau kedua-duanya dan, bagi kesalahan kedua atau yang berikutnya didenda tidak melebihi satu ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya. Permohonan bagi permit, lesen dan perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permit, lesen atau perakuan untuk mengimport; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permit atau lesen untuk mengeksport, apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma hendaklah dibuat kepada Ketua Pengarah mengikut cara sebagaimana yang ditentukan oleh Ketua Pengarah dan hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, selepas menerima permohonan yang dibuat di bawah subseksyen (1), menghendaki pemohon untuk memberikan maklumat, butiran atau dokumen tambahan dalam apa-apa tempoh masa sebagaimana yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon tidak memberikan maklumat, butiran atau dokumen tambahan yang dikehendaki di bawah subseksyen (2), permohonan itu hendaklah dianggap telah ditarik balik tanpa menjejaskan pembuatan suatu permohonan baru mengikut subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh meluluskan permohonan yang dibuat di bawah subseksyen (1) dan boleh mengeluarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permit, lesen atau perakuan untuk mengimport; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permit atau lesen untuk mengeksport, apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma kepada pemohon jika pemohon telah memenuhi kehendak di bawah subseksyen (1) dan (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mengeluarkan apa-apa permit, lesen atau perakuan untuk mengimport dan apa-apa permit atau lesen untuk mengeksport mengikut dasar, arahan dan kehendak sebagaimana yang ditentukan oleh agensi atau jabatan yang berkaitan. Permit, lesen dan perakuan palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang memberikan atau menyebabkan supaya diberikan kepada Ketua Pengarah secara lisan atau secara bertulis, apa-apa permit, lesen, perakuan, atau dokumen lain atau maklumat yang dikehendaki untuk diberikan di bawah Akta ini yang palsu, tidak tepat atau mengelirukan dalam pengimportan atau pengeksportan apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya dan, bagi kesalahan kedua atau yang berikutnya didenda tidak melebihi tujuh puluh lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Tumbuhan, binatang, karkas, dsb. dengan perosak, penyakit atau bahan cemar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengimport melalui pintu masuk, stesen kuarantin atau premis kuarantin apa-apa tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan perosak, penyakit atau bahan cemar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dipercayai mempunyai perosak, penyakit atau bahan cemar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diserang oleh perosak, penyakit atau bahan cemar, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam tahun atau kedua-duanya dan, bagi kesalahan kedua atau yang berikutnya didenda tidak melebihi satu ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya. Syarat import dan eksport"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terlibat dalam pengimportan atau pengeksportan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma hendaklah mematuhi apa-apa syarat import sebagaimana yang dinyatakan dalam permit, lesen atau perakuan, atau syarat eksport sebagaimana yang dinyatakan dalam permit atau lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_V__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terlibat dalam pengimportan atau pengeksportan tumbuhan, binatang, karkas, ikan, keluaran pertanian, tanih atau mikroorganisma yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam tahun atau kedua-duanya dan, bagi kesalahan kedua atau yang berikutnya didenda tidak melebihi satu ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya."
      }
    },
