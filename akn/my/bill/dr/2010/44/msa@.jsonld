        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_48",
