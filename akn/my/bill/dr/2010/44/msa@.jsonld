        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_VII__cl_43",
