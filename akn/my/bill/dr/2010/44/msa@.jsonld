      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/44/msa@/~part_III__cl_8__subsec_1__para_b",
