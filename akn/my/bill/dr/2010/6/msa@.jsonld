      "schema:text": {
        "@language": "ms",
        "@value": "FUNGSI DAN KUASA SURUHANJAYA Fungsi Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai apa-apa fungsi yang dinyatakan di bawah undang-undang persaingan dan hendaklah juga mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "menasihati Menteri atau mana-mana pihak berkuasa awam atau pihak berkuasa pengawalseliaan yang lain tentang segala perkara yang berkenaan dengan persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu Menteri tentang kesan anti-persaingan yang sebenar atau yang mungkin daripada perundangan semasa atau perundangan yang dicadangkan dan membuat syor kepada Menteri, jika sesuai, bagi mengelakkan kesan ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "menasihati Menteri tentang perjanjian antarabangsa yang berkaitan dengan perkara persaingan dan undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan dan menguatkuasakan peruntukan undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan garis panduan berhubung dengan pelaksanaan dan penguatkuasaan undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai penyokong bagi perkara persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan, sebagaimana yang difikirkannya sesuai, kajian am berhubung dengan isu-isu yang berkaitan dengan persaingan dalam ekonomi Malaysia atau sektor tertentu ekonomi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "mengumpul maklumat bagi pelaksanaan fungsi Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan, dan selainnya meningkatkan kesedaran di kalangan orang yang terlibat dalam perdagangan atau tred dan di kalangan orang awam, maklumat yang berkenaan dengan undang-undang persaingan dan cara yang mengikutnya Suruhanjaya akan menjalankan fungsinya di bawah undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu dan mendidik orang awam tentang cara-cara bagaimana persaingan dapat memberi manfaat kepada pengguna di, dan ekonomi, Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "mempertimbangkan dan membuat syor kepada Menteri tentang pembaharuan kepada undang-undang persaingan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa aktiviti dan melakukan apa-apa benda yang perlu atau bermanfaat dan wajar bagi pentadbiran Suruhanjaya. Kuasa Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai kuasa untuk melakukan segala benda yang perlu atau suai manfaat bagi atau berkaitan dengan pelaksanaan fungsinya di bawah undang-undang persaingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kuasa Suruhanjaya termasuklah kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggunakan semua harta alih dan harta tak alih Suruhanjaya mengikut apa-apa cara yang difikirkan suai manfaat oleh Suruhanjaya termasuk menggadaijanjikan harta itu bagi pemerdapatan pinjaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan penalti bagi pelanggaran peruntukan undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan fi atau caj bagi perkhidmatan yang diberikan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana ejen, pakar atau perunding yang difikirkannya layak untuk membantu Suruhanjaya dalam pelaksanaan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberikan pinjaman, biasiswa dan wang pendahuluan kepada pekerja Suruhanjaya bagi apa-apa maksud dan atas apa-apa terma yang ditentukan oleh Suruhanjaya atau yang diluluskan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membayar saraan, elaun dan apa-apa perbelanjaan lain anggota Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merumuskan dan melaksanakan program bagi pelaksanaan fungsi Suruhanjaya dengan sewajarnya dan seberkesannya, termasuklah program bagi pembangunan sumber manusia, pembiayaan dan kerjasama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bekerjasama dengan mana-mana pertubuhan perbadanan atau agensi kerajaan bagi maksud melaksanakan fungsi Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki pemberian maklumat oleh perusahaan bagi membantu Suruhanjaya dalam pelaksanaan fungsinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa jua yang bersampingan dengan mana-mana fungsi dan kuasanya. Arahan oleh Menteri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah bertanggungjawab kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, secara bertulis, memberi Suruhanjaya arahan yang bersifat am, yang selaras dengan peruntukan undang-undang persaingan, berhubung dengan pelaksanaan fungsi dan kuasa Suruhanjaya dan Suruhanjaya hendaklah melaksanakan arahan itu. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah memberi Menteri, dan mana-mana pihak berkuasa awam yang dinyatakan oleh Menteri, apa-apa penyata, laporan, akaun dan maklumat berkenaan dengan aktiviti dan kewangannya sebagaimana yang dikehendaki atau diarahkan oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyata, laporan, akaun dan maklumat itu hendaklah dalam apa-apa bentuk dan hendaklah mengandungi apa-apa maklumat yang berhubungan dengan urusan dan dasar Suruhanjaya dan apa-apa perkara lain sebagaimana yang ditentukan oleh Menteri dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah dibayar apa-apa saraan dan elaun sebagaimana yang ditentukan oleh Menteri, selepas berunding dengan Menteri Kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua anggota lain Suruhanjaya hendaklah dibayar apa-apa elaun pada kadar yang ditentukan oleh Menteri, selepas berunding dengan Menteri Kewangan. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan mana-mana anggota Suruhanjaya boleh, pada bila-bila masa, dibatalkan oleh Perdana Menteri jika perlu demi kepentingan pelaksanaan berkesan dan berekonomi fungsi Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembatalan pelantikan di bawah subseksyen (1) hendaklah disokong dengan alasan secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Suruhanjaya boleh, pada bila-bila masa, meletakkan jawatannya melalui notis bertulis yang ditujukan kepada Perdana Menteri. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Suruhanjaya hendaklah menjadi kosong jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dibuktikan terhadapnya atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda) lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai anggota Suruhanjaya atau selainnya, ialah kelakuan yang memburukkan atau mencemarkan nama Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak sempurna akal atau selainnya tidak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Pengerusi, dia tidak menghadiri mesyuarat Suruhanjaya sebanyak tiga kali berturut-turut tanpa kebenaran secara bertulis daripada Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seseorang anggota Suruhanjaya selain Pengerusi, dia tidak menghadiri mesyuarat Suruhanjaya sebanyak tiga kali berturut-turut tanpa kebenaran secara bertulis daripada Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah terlibat dalam apa-apa jawatan atau pekerjaan berbayar yang bercanggah dengan kewajipannya sebagai anggota Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah bertindak melanggar undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "pelantikannya dibatalkan oleh Perdana Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "peletakan jawatannya diterima oleh Perdana Menteri. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), Menteri boleh melantik secara sementara mana-mana anggota Suruhanjaya, selain Ketua Pegawai Eksekutif, untuk bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi tidak hadir bertugas atau tidak ada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, kerana apa-apa sebab lain, tidak dapat melaksanakan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya jawatan Pengerusi kosong selama enam bulan berturut-turut atau lebih, Perdana Menteri hendaklah melantik orang lain untuk menjadi Pengerusi mengikut Akta ini, dan dengan pelantikan itu, Pengerusi sebelumnya hendaklah terhenti daripada menjadi anggota Suruhanjaya. Penubuhan Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menubuhkan apa-apa jawatankuasa yang difikirkannya perlu atau suai manfaat untuk membantunya melaksanakan fungsinya di bawah undang-undang persaingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota sesuatu jawatankuasa dan mana-mana orang yang diundang di bawah subseksyen (9) boleh dibayar apa-apa elaun dan belanja lain sebagaimana yang ditentukan oleh Suruhanjaya. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa yang ditubuhkan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dipengerusikan oleh mana-mana anggota Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menepati dan bertindak mengikut apa-apa arahan yang diberikan kepadanya oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menentukan tatacaranya sendirinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota jawatankuasa yang ditubuhkan di bawah subseksyen (1) boleh dilantik daripada kalangan anggota Suruhanjaya atau mana-mana orang lain sebagaimana yang difikirkannya patut oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota jawatankuasa hendaklah memegang jawatan atas apa-apa syarat dan selama tempoh yang dinyatakan dalam surat pelantikannya dan layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membatalkan pelantikan mana-mana anggota jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota jawatankuasa boleh, pada bila-bila masa, meletakkan jawatan dengan memberikan notis secara bertulis kepada pengerusi jawatankuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, pada bila-bila masa, memberhentikan atau mengubah keanggotaan sesuatu jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh mengadakan mesyuarat pentadbirannya pada bila-bila masa dan di mana-mana tempat yang ditentukan oleh pengerusi jawatankuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengundang mana-mana orang untuk menghadiri mana-mana mesyuaratnya bagi maksud menasihatinya tentang apa-apa perkara yang sedang dibincangkan tetapi orang itu tidak berhak untuk mengundi pada mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya atau mana-mana jawatankuasa yang ditubuhkan di bawah seksyen 14 yang memperoleh suatu kepentingan secara langsung atau tidak langsung sama ada dengan sendirinya, menerusi anggota keluarganya atau menerusi sekutunya berhubung dengan apa-apa perkara yang sedang dibincangkan oleh Suruhanjaya atau jawatankuasa itu, hendaklah menzahirkan kepada Suruhanjaya atau jawatankuasa itu, mengikut mana-mana yang berkenaan, hakikat kepentingannya dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subseksyen (1) hendaklah direkodkan dalam minit mesyuarat Suruhanjaya atau jawatankuasa itu, mengikut mana-mana yang berkenaan, yang dalamnya perkara itu dibincangkan dan, selepas penzahiran itu, anggota itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh hadir atau mengambil bahagian dalam apa-apa pertimbangtelitian atau keputusan Suruhanjaya atau jawatankuasa itu, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diambil dikira bagi maksud membentuk kuorum Suruhanjaya atau jawatankuasa itu, mengikut mana-mana yang berkenaan, apabila perkara itu dibincangkan atau diputuskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya atau jawatankuasa yang tidak menzahirkan kepentingannya sebagaimana yang dikehendaki di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding Suruhanjaya atau jawatankuasa boleh menjadi tidak sah atas alasan bahawa mana-mana anggota Suruhanjaya atau jawatankuasa telah melanggar seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini— “anggota keluarganya”, berhubungan dengan seseorang anggota Suruhanjaya atau jawatankuasa, termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ibu atau bapanya (termasuk ibu atau bapa suami atau isterinya);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "anaknya (termasuk anak angkat atau anak tiri);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adik-beradiknya (termasuk adik beradik suami atau isterinya); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri anaknya atau adik-beradiknya; dan “sekutu”, berhubungan dengan seseorang anggota Suruhanjaya atau jawatankuasa, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang merupakan penama atau pekerja anggota itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "firma yang anggota itu atau mana-mana penamanya merupakan seorang pekongsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pekongsi anggota itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang amanah sesuatu amanah yang di bawahnya anggota itu atau seorang anggota keluarganya ialah seorang benefisiari; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_15__subsec_5__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perbadanan mengikut pengertian Akta Syarikat 1965 [Akta 125], yang anggota itu atau mana-mana penamanya atau seseorang anggota keluarganya ialah seorang pengarah atau mempunyai pemegangan syer yang substantial dalam perbadanan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pertubuhan perbadanan yang dikenali sebagai “Suruhanjaya Persaingan” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya adalah kekal turun temurun dan mempunyai meterai perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membawa guaman dan dibawa guaman terhadapnya atas namanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada dan bagi maksud Akta ini, Suruhanjaya boleh, atas apa-apa terma yang difikirkan patut oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat kontrak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan tiap-tiap jenis harta alih dan tak alih dan kepentingan mengenai harta alih dan tak alih–"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, membeli dan mengambil harta dan kepentingan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_3__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang, menikmati, memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai janji, mendemis, menyerahhakkan semula, memindahkan hakmilik, atau dengan apa-apa cara lain melupuskan, atau membuat apa-apa urusan mengenai, harta itu dan apa-apa kepentingan mengenai harta itu yang terletak hak pada Suruhanjaya. Meterai perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan Suruhanjaya hendaklah mempunyai suatu peranti yang diluluskan oleh Suruhanjaya dan meterai itu boleh dari semasa ke semasa dipecahkan, ditukar, diubah dan dibuat baharu sebagaimana yang difikirkan patut oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu meterai diadakan oleh Suruhanjaya, suatu cap yang mengandungi perkataan “Suruhanjaya Persaingan” bolehlah digunakan dan hendaklah disifatkan sebagai meterai perbadanan Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan itu hendaklah disimpan dalam jagaan Pengerusi atau mana-mana orang lain yang diberi kuasa oleh Suruhanjaya, dan hendaklah ditentusahkan sama ada oleh Pengerusi atau oleh mana-mana orang lain itu yang diberi kuasa oleh Pengerusi secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala surat ikatan, dokumen dan surat cara lain yang berupa sebagai dimeteraikan dengan meterai perbadanan itu dan ditentusahkan mengikut subseksyen (3), hendaklah, sehingga dibuktikan sebaliknya, disifatkan telah disempurnakan dengan sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa surat ikatan, dokumen dan surat cara lain yang, jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan, tidak dikehendaki supaya dimeteraikan boleh disempurnakan mengikut cara yang serupa oleh seorang anggota Suruhanjaya atau mana-mana orang lain yang diberi kuasa oleh Suruhanjaya bagi pihak Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan Suruhanjaya hendaklah diberi pengiktirafan rasmi dan kehakiman. Keanggotaan Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah terdiri daripada anggota yang berikut yang hendaklah dilantik oleh Perdana Menteri atas syor Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "empat orang anggota yang mewakili Kerajaan, seorang daripadanya hendaklah wakil Kementerian yang pada masa ini bertanggungjawab bagi perkara-perkara yang berkenaan dengan perdagangan dalam negeri dan hal ehwal pengguna; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada tiga tetapi tidak lebih daripada lima orang anggota lain, yang mempunyai pengalaman dan pengetahuan dalam perkara-perkara yang berhubungan dengan perniagaan, industri, perdagangan, undang-undang, ekonomi, pentadbiran awam, persaingan, perlindungan pengguna atau apa-apa kelayakan lain yang sesuai sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan anggota Suruhanjaya hendaklah disiarkan dalam Warta. Pemakaian Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual terpakai bagi anggota Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh meminda Jadual melalui perintah yang disiarkan dalam Warta. Akaun berkanun oleh anggota Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dilantik sebagai anggota Suruhanjaya melainkan jika sebelum pelantikan sedemikian orang itu membuat suatu akuan berkanun tentang sama ada dia mempunyai apa-apa kepentingan, kewangan atau selainnya, dalam apa-apa pengusahaan komersial atau perdagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang anggota Suruhanjaya memperoleh apa-apa kepentingan, kewangan atau selainnya, dalam apa-apa pengusahaan komersial atau perdagangan, dia hendaklah, dalam tempoh satu bulan selepas pemerolehan itu, memberikan notis secara bertulis kepada Menteri yang menyatakan kepentingan yang telah diperoleh itu. Kelulusan untuk memegang jawatan lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi tidak boleh, semasa memegang jawatan itu, memegang apa-apa jawatan atau pekerjaan lain, sama ada diberi saraan atau tidak, tanpa terlebih dahulu mendapat kelulusan bertulis Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dilantik atau kekal sebagai anggota Suruhanjaya sekiranya dia memegang jawatan sepenuh masa dalam mana-mana syarikat tersenarai awam tanpa terlebih dahulu mendapat kelulusan bertulis Menteri. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya hendaklah memegang jawatan selama tempoh tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Suruhanjaya layak untuk dilantik semula tetapi tiada anggota boleh memegang jawatan lebih daripada dua penggal berturut-turut. Saraan dan elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_26"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN YANG BERHUBUNGAN DENGAN PEKERJA SURUHANJAYA Ketua Pegawai Eksekutif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Ketua Pegawai Eksekutif atas apa-apa terma dan syarat sebagaimana yang difikirkannya wajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah bertanggungjawab bagi keseluruhan pentadbiran dan pengurusan fungsi, aktiviti dan hal ehwal hari ke hari Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah mempunyai kawalan am ke atas pekerja Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif hendaklah melaksanakan apa-apa kewajipan lain sebagaimana yang diarahkan oleh Suruhanjaya dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menunaikan kewajipannya, Ketua Pegawai Eksekutif hendaklah bertindak di bawah kuasa dan arahan am Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif ialah seorang pekerja Suruhanjaya. Penjalanan sementara fungsi Ketua Pegawai Eksekutif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara sementara mana-mana pekerja Suruhanjaya untuk bertindak sebagai Ketua Pegawai Eksekutif selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Ketua Pegawai Eksekutif kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif tidak hadir bertugas atau tidak ada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pegawai Eksekutif, kerana apa-apa sebab lain, tidak dapat melaksanakan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya jawatan Ketua Pegawai Eksekutif kosong selama lebih daripada enam bulan, Menteri hendaklah melantik orang lain untuk menjadi Ketua Pegawai Eksekutif, dan dengan pelantikan itu, Ketua Pegawai Eksekutif sebelumnya hendaklah terhenti daripada memegang jawatan itu. Pelantikan pekerja Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dari semasa ke semasa, melantik dan mengambil kerja apa-apa bilangan pekerja yang difikirkannya perlu dan atas apa-apa terma yang difikirkannya sesuai bagi menjalankan maksud undang-undang persaingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dengan kelulusan Menteri, menentukan syarat perkhidmatan pekerjanya. Pinjaman, biasiswa dan wang pendahuluan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh memberikan pinjaman, biasiswa dan wang pendahuluan kepada pekerjanya bagi apa-apa maksud dan atas apa-apa terma yang ditentukan oleh Suruhanjaya. Pembayaran faedah persaraan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membuat perkiraan bagi pembayaran kepada pekerjanya dan orang tanggungan mereka apa-apa faedah persaraan, pencen, ganjaran dan elaun lain yang ditentukan oleh Suruhanjaya. Suruhanjaya boleh menerima pakai peraturan-peraturan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menerima pakai dengan apa-apa ubah suaian yang difikirkannya patut, apa-apa peraturan, kaedah, dasar, pekeliling dan arahan yang diperbuat atau dikeluarkan oleh Kerajaan Persekutuan berhubung dengan apa-apa perkara di bawah Bahagian ini. Perlindungan pegawai dan orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding boleh dimulakan dalam mana-mana mahkamah terhadap Suruhanjaya, pegawai Suruhanjaya atau mana-mana orang lain yang bertindak bagi pihak Suruhanjaya atau pegawai Suruhanjaya berkenaan dengan apa-apa perbuatan yang diarahkan supaya dilakukan atau dilakukan olehnya atas sifat sedemikian dengan syarat bahawa pada masa itu dia telah menjalankan fungsinya dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Persaingan 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“anggota” ertinya Pengerusi dan mana-mana anggota Suruhanjaya yang dilantik di bawah seksyen 5; “jawatankuasa” ertinya jawatankuasa yang ditubuhkan oleh Suruhanjaya di bawah seksyen 14; “Ketua Pegawai Eksekutif” ertinya Ketua Pegawai Eksekutif Suruhanjaya yang dilantik di bawah seksyen 20; “Kumpulan Wang” ertinya Kumpulan Wang Suruhanjaya Persaingan yang ditubuhkan di bawah seksyen 27; “Menteri” ertinya Menteri yang pada masa ini dipertanggungkan dengan tanggungjawab bagi perkara-perkara yang berkenaan dengan perdagangan dalam negeri dan hal ehwal pengguna; “pegawai Suruhanjaya” ertinya seseorang yang dilantik atau diberi kuasa oleh Ketua Pegawai Eksekutif secara bertulis di bawah undang-undang persaingan bagi maksud menjalankan penyiasatan ke atas apa-apa kesalahan atau pelanggaran undang-undang persaingan; “pekerja” ertinya mana-mana orang yang diambil kerja oleh Suruhanjaya di bawah seksyen 22 dan termasuklah Ketua Pegawai Eksekutif; “Pengerusi” ertinya Pengerusi Suruhanjaya yang dilantik di bawah seksyen 5; “Suruhanjaya” ertinya Suruhanjaya Persaingan yang ditubuhkan di bawah seksyen 3; “undang-undang persaingan” ertinya Akta ini dan Akta Persaingan 2010 dan termasuklah mana-mana perundangan subsidiari yang dibuat di bawah undang-undang ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
