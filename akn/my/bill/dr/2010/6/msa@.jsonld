        "@language": "ms",
        "@value": "KEWANGAN Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
