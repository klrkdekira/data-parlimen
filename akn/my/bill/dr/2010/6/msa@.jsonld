        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Pelantikan dan kuasa pegawai Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh melantik apa-apa bilangan pegawai Suruhanjaya yang difikirkannya perlu untuk menjalankan kuasa yang diperuntukkan di bawah undang-undang persaingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud sesuatu penyiasatan di bawah undang-undang persaingan, Suruhanjaya boleh melantik pekerjanya atau mana-mana orang lain untuk menjadi pegawai Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai Suruhanjaya yang bukan pekerja Suruhanjaya hendaklah tertakluk kepada obligasi kerahsiaan di bawah seksyen 43, dan hendaklah menikmati perlindungan dan tanggung rugi sebagaimana yang dinyatakan dalam Akta ini atau undang-undang bertulis lain yang terpakai bagi seseorang pekerja Suruhanjaya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai Suruhanjaya hendaklah mempunyai segala kuasa yang perlu untuk menjalankan pemeriksaan dan penyiasatan tentang apa-apa kesalahan atau pelanggaran di bawah undang-undang persaingan. Kerjasama dengan pihak berkuasa lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberikan arahan kepada Suruhanjaya mengenai perkiraan kerjasama antara Suruhanjaya dengan mana-mana pihak berkuasa lain di Malaysia atau dalam bidang kuasa asing atau mana-mana organisasi antarabangsa dan menentukan perkiraan bagi kerjasama sedemikian atau keanggotaan dalam organisasi antarabangsa. Permulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan boleh dimulakan bagi apa-apa kesalahan di bawah undang-undang persaingan tanpa keizinan bertulis Pendakwa Raya. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua anggota Suruhanjaya dan mana-mana jawatankuasa, dan semua pekerja, pegawai Suruhanjaya, ejen dan perunding Suruhanjaya, semasa menunaikan kewajipan mereka di bawah Akta ini sebagai anggota, pekerja, Pegawai Suruhanjaya, ejen atau perunding sedemikian, hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap Suruhanjaya atau terhadap mana-mana anggota Suruhanjaya, mana-mana anggota jawatankuasa, dan pekerja atau ejen Suruhanjaya berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dibuat atau dilakukan olehnya dengan suci hati atau apa-apa peninggalan olehnya dengan suci hati, dalam sifatnya yang sedemikian. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi mana-mana maksud Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis atau jika selainnya dibenarkan oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada anggota Suruhanjaya atau mana-mana jawatankuasanya atau mana-mana pekerja atau ejen Suruhanjaya atau mana-mana orang yang menghadiri mana-mana mesyuarat Suruhanjaya atau mana-mana jawatankuasanya, sama ada semasa atau selepas tempoh memegang jawatan atau tempoh pekerjaannya, boleh menzahirkan apa-apa maklumat yang didapatinya dalam penjalanan kewajipannnya dan yang tidak disiarkan menurut undang-undang persaingan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang lain pun yang melalui apa-apa cara mempunyai akses kepada apa-apa maklumat atau dokumen yang berhubungan dengan hal ehwal Suruhanjaya boleh menzahirkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Pewakilan dalam prosiding sivil"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil oleh atau terhadap Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil terhadap mana-mana pekerja atau pegawai Suruhanjaya berhubung dengan pelaksanaan fungsinya di bawah undang-undang persaingan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil yang lain yang dalamnya Suruhanjaya dikehendaki atau dibenarkan oleh mahkamah untuk diwakili, atau untuk didengar, atau selainnya berhak untuk diwakili atau didengar, mana-mana orang yang diberi kuasa oleh Suruhanjaya bagi maksud itu boleh, bagi pihak Suruhanjaya, atau pekerja itu atau pegawai Suruhanjaya, memulakan prosiding sedemikian atau hadir dalam prosiding itu dan boleh membuat semua kehadiran dan permohonan dan melakukan semua perbuatan berkenaan dengan prosiding itu bagi pihak Suruhanjaya. Kuasa untuk mengambil kerja"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengambil kerja dan membayar ejen dan penasihat teknikal, termasuklah peguam bela dan peguam cara, jurubank, perunding dan orang lain, untuk membuat apa-apa urusan atau untuk melakukan apa-apa perbuatan yang dikehendaki supaya diuruskan atau dilakukan pada melaksanakan fungsinya, atau menjalankan kuasanya atau bagi melaksanakan maksud Akta ini dengan lebih baik. Perkara yang dilakukan pada menjangkakan Akta ini diperbuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala benda yang dilakukan oleh mana-mana orang atau pihak berkuasa bagi pihak Suruhanjaya sebagai persediaan dan ke arah pelaksanaan atau pentadbiran yang sepatutnya Akta ini, dan apa-apa perbelanjaan yang dilakukan berhubungan dengannya, pada menjangkakan pembuatan Akta ini hendaklah disifatkan telah dibenarkan oleh Akta ini, dan segala hak yang diperoleh atau obligasi yang ditanggung bagi pihak Suruhanjaya daripada apa-apa jua yang dilakukan sedemikian hendaklah apabila Akta ini mula berkuat kuasa disifatkan sebagai hak dan obligasi Suruhanjaya. Kaedah penyiaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya diberi kuasa untuk menyiarkan, atau dikehendaki untuk menyiarkan, suatu arahan, garis panduan, penarikbalikan, pelepasan, penamaan atau keputusan atau dokumen lain di bawah undang-undang persaingan, penyiaran itu bolehlah melalui kaedah elektronik mengikut apa-apa cara yang menjadikannya boleh diakses dengan munasabah oleh mana-mana orang yang berhasrat untuk melihatnya, dan penyiaran sesuatu dokumen melalui kaedah itu hendaklah mempunyai kuat kuasa bagi semua maksud di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_VI__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “elektronik” ertinya teknologi yang menggunakan elektrik, optik, magnet, elektromagnet, biometrik, fotonik atau teknologi lain sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu kumpulan wang yang dikenali sebagai “Kumpulan Wang Suruhanjaya Persaingan” ditubuhkan dan hendaklah ditadbirkan dan dikawal oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa wang yang diperuntukkan dari semasa ke semasa oleh Parlimen bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua atau mana-mana bahagian fi, caj pentadbiran atau caj lain yang dikenakan oleh atau yang kena dibayar kepada Suruhanjaya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh sebagai pendapatan daripada pelaburan yang dibuat oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diterima oleh Suruhanjaya melalui pemberian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada penjualan, pelupusan, pemajakan atau penyewaan, atau apa-apa urus niaga lain mengenai, apa-apa harta, gadai janji, gadaian atau debentur yang terletak hak pada atau yang diperoleh oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang dan harta lain yang dengan apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Suruhanjaya, berkenaan dengan apa-apa perkara yang bersampingan dengan fungsinya dan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kos yang dibayar kepada, atau didapatkan oleh, Suruhanjaya dalam apa-apa tindakan atau prosiding, sivil atau jenayah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang dipinjam oleh Suruhanjaya di bawah seksyen 32; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diterima dengan sah oleh Suruhanjaya, termasuklah bunga. Perbelanjaan yang hendaklah dipertanggungkan pada Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan secara sah oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar saraan, elaun dan perbelanjaan lain anggota Suruhanjaya, anggota jawatankuasa dan pekerja Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos atau perbelanjaan lain berhubung dengan pemerolehan barang dan perkhidmatan, termasuk pengambilan khidmat perunding, fi dan kos guaman dan fi dan kos lain, yang dilakukan atau diterima dengan sepatutnya oleh Suruhanjaya dalam pelaksanaan fungsinya dan penjalanan kuasanya di bawah undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan, jentera dan apa-apa bahan lain, memperoleh tanah dan apa-apa aset, dan membina bangunan, dan menjalankan apa-apa kerja dan pengusahaan lain dalam pelaksanaan fungsinya dan penjalanan kuasanya di bawah undang-undang persaingan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik wang yang dipinjam dan bunga yang dikenakan ke atasnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan pinjaman, biasiswa, wang pendahuluan, faedah persaraan, pencen, ganjaran dan faedah lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya, membayar apa-apa belanja bagi melaksanakan peruntukan undang-undang persaingan. Pemeliharaan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan Suruhanjaya untuk memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini dengan sedemikian cara supaya dapat dipastikan bahawa jumlah hasil Suruhanjaya mencukupi untuk membayar semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya pada akaun hasilnya, termasuk susut nilai dan bunga atas modal, dari setahun ke setahun. Perbelanjaan dan penyediaan anggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Suruhanjaya setakat apa-apa amaun yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendaklah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum 1 September setiap tahun, Suruhanjaya hendaklah mengemukakan kepada Menteri suatu anggaran perbelanjaannya (termasuk perbelanjaan bagi program penyelidikan dan pembangunan) bagi tahun yang berikutnya dalam apa-apa bentuk dan yang mengandungi apa-apa butir sebagaimana yang diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum 1 Januari tahun yang berikutnya, memberitahu Suruhanjaya amaun yang dibenarkan bagi perbelanjaan secara amnya atau amaun yang dibenarkan bagi setiap perihalan perbelanjaan berdasarkan anggaran yang disediakan di bawah subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, pada bila-bila masa, mengemukakan suatu anggaran perbelanjaan tambahan bagi mana-mana satu tahun kepada Menteri dan Menteri boleh membenarkan keseluruhan atau mana-mana bahagian perbelanjaan tambahan yang dimasukkan dalam anggaran perbelanjaan tambahan itu. Akaun bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah membuka dan menyenggarakan akaun atau akaun-akaun dengan bank atau bank-bank di Malaysia sebagaimana yang difikirkan patut oleh Suruhanjaya, selepas berunding dengan Menteri; dan tiap-tiap akaun itu hendaklah dikendalikan, setakat yang dapat dilaksanakan, melalui cek yang ditandatangani oleh mana-mana orang atau orang-orang yang diberi kuasa oleh Suruhanjaya bagi maksud itu dari semasa ke semasa. Kuasa untuk meminjam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dari semasa ke semasa, meminjam dalam apa-apa bentuk dan pada apa-apa kadar bunga dan bagi apa-apa tempoh dan atas apa-apa terma tentang masa dan kaedah pembayaran balik dan selainnya, sebagaimana yang diluluskan oleh Menteri, dengan persetujuan Menteri Kewangan, apa-apa wang yang diperlukan oleh Suruhanjaya bagi memenuhi mana-mana obligasinya atau menunaikan mana-mana kewajipannya. Pelaburan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang Suruhanjaya hendaklah, setakat yang tidak diperlukan untuk dibelanjakan dengan segera oleh Suruhanjaya di bawah Akta ini, dilaburkan mengikut apa-apa cara yang diluluskan oleh Menteri, dengan persetujuan Menteri Kewangan. Batasan untuk berkontrak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya tidak boleh, tanpa kelulusan Menteri dan persetujuan Menteri Kewangan, membuat apa-apa kontrak yang di bawahnya Suruhanjaya dikehendaki untuk membayar atau menerima suatu amaun yang melebihi sepuluh juta ringgit. Tatacara kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan kelulusan Menteri, Suruhanjaya hendaklah menentukan tatacara kewangannya sendiri. Tahun kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Suruhanjaya hendaklah bermula pada 1 Januari dan berakhir pada 31 Disember setiap tahun. Laporan tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 6] Masa dan tempat mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mengadakan seberapa banyak mesyuarat yang perlu bagi melaksanakan fungsinya dengan cekap dan mesyuarat itu hendaklah diadakan di mana-mana tempat dan pada bila-bila masa yang diputuskan oleh Pengerusi, dengan syarat bahawa Pengerusi tidak boleh membenarkan lebih daripada tiga bulan berlalu antara mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bertulis sekurang-kurangnya empat belas hari hendaklah diberikan kepada anggota."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan mesyuarat Suruhanjaya. Kuorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi dan sekurang-kurangnya setengah daripada anggota Suruhanjaya yang lain hendaklah membentuk kuorum pada mana-mana mesyuarat Suruhanjaya. Undi pemutus"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Suruhanjaya yang hadir berhak kepada satu undi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas apa-apa persoalan untuk ditentukan oleh Suruhanjaya terdapat persamaan undi, Pengerusi hendaklah mempunyai undi pemutus di samping undi biasanya. Suruhanjaya boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengundang mana-mana orang untuk menghadiri mana-mana mesyuarat atau pertimbangtelitian Suruhanjaya bagi maksud menasihatinya tentang apa-apa perkara yang sedang dibincangkan, tetapi mana-mana orang yang hadir sedemikian tidak berhak untuk mengundi pada mesyuarat atau pertimbangtelitian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subperenggan (1) hendaklah dibayar apa-apa elaun sebagaimana yang ditentukan oleh Suruhanjaya. Ketetapan tanpa bermesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu ketetapan dikira sebagai telah diluluskan pada sesuatu mesyuarat Suruhanjaya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua anggota Suruhanjaya telah dimaklumkan tentang ketetapan yang dicadangkan itu, atau usaha yang munasabah telah dibuat untuk memaklumkan semua anggota Suruhanjaya tentang ketetapan yang dicadangkan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa bermesyuarat, majoriti anggota Suruhanjaya menandakan persetujuan tentang ketetapan itu mengikut kaedah yang ditentukan oleh Suruhanjaya di bawah subperenggan (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan (1) terpakai hanya jika Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memutuskan bahawa subperenggan itu terpakai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memutuskan kaedah yang dengannya anggota Suruhanjaya boleh menandakan persetujuan tentang ketetapan. Minit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyebabkan supaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "minit kesemua mesyuaratnya disenggarakan dan disimpan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan minit semua mesyuaratnya dikemukakan kepada Suruhanjaya dengan seberapa segera yang dapat dilaksanakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit yang dibuat mengenai mesyuarat Suruhanjaya, jika ditandatangani dengan sewajarnya, hendaklah, dalam mana-mana prosiding undang-undang, diterima sebagai keterangan prima facie mengenai fakta yang dinyatakan dalam minit itu tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap mesyuarat Suruhanjaya yang minit berkenaan dengannya telah dibuat mengikut subperenggan (1) dan (2) hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota pada mesyuarat itu layak dengan sewajarnya untuk bertindak. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengawal selia tatacaranya sendiri. Kesahan perbuatan dan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perbuatan yang dilakukan atau prosiding yang diambil di bawah Akta ini boleh dipersoalkan atas alasan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa kekosongan dalam keanggotaan, atau terdapat apa-apa kecacatan dalam penubuhan, Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat pelanggaran peruntukan seksyen 15 Akta oleh mana-mana anggota Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa peninggalan, kecacatan atau ketidakteraturan yang tidak menyentuh merit kes itu. Anggota hendaklah menumpukan masa kepada urusan Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/6/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Suruhanjaya hendaklah menumpukan masa kepada urusan Suruhanjaya sebagaimana yang perlu untuk menunaikan kewajipan mereka dengan berkesan."
      }
    }
  ]
}
