      ],
      "schema:name": {
        "@language": "en",
        "@value": "Railways (Amendment) Bill 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Railways (Amendment) Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “appointed date” means the date appointed by the Minister under subsection 1(2). General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Railways Act 1991 [Act 463], which is referred to as the “principal Act” in this Act, is amended in sections 1, 4 and 7 by substituting for the word “Malaysia” wherever appearing the words “Sabah, Sarawak and the Federal Territory of Labuan”. Amendment of section 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 1 of the principal Act is amended by inserting after subsection (1) the following subsection: “(1A) Notwithstanding subsection (1), Part XII shall apply to all railways in Malaysia.”. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 2 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “railway”, by deleting the words “the Penang Hill Railway and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “Minister”, by inserting after the word “railways” the words “in Sabah, Sarawak and the Federal Territory of Labuan”. Amendment of section 66"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 66 of the principal Act is amended by inserting after the words “twenty years” the words “or to both”. Amendment of section 89"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 89 of the principal Act is amended in paragraph (8)(b) by deleting the words “to promote and”. Non-application, saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "On the appointed date, the Railways Act 1991, hereinafter referred to as “the Act”, shall cease to apply to Peninsular Malaysia, except Part XII."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the non-application of the Railways Act 1991 to Peninsular Malaysia, all subsidiary legislation made or deemed to have been made or having effect under the Act prior to the appointed date shall, in so far as they are not inconsistent with the Land Public Transport Act 2010 [Act ], continue to be in force and have effect in Peninsular Malaysia until they are amended or revoked by any subsidiary legislation made under the Land Public Transport Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any licence, approval, direction, order or decision granted, issued, given or made under or in accordance with the Act in respect of its application to Peninsular Malaysia prior to the appointed date shall, in so far as they are not inconsistent with the provisions of the Land Public Transport Act 2010, continue to be in full force and effect until suspended or revoked under the Land Public Transport Act 2010 or until the date of the expiry of the licence, approval, direction, order or decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "All applications for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "construction of a railway;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "grant of approvals of railways schemes for a railway;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "issuance or renewal of licence to operate a railway;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "grant of approval to open a railway;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "grant of approval for reopening of a closed railway; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "variation of conditions of approvals or licences described under paragraphs (b) and (c), made by any person under the Act in its application to Peninsular Malaysia prior to the appointed date and which are pending on such date shall, on that date, cease to be dealt with under the Act and shall be dealt with under the Land Public Transport Act 2010 as if such applications had been made under the provisions of the Land Public Transport Act 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the provisions of the Land Public Transport Act 2010, nothing in the Act or the Land Public Transport Act 2010 shall affect any person liable to be prosecuted or punished for offences committed under the provisions of the Act in respect of its application to Peninsular Malaysia prior to the appointed date, or any investigation made, proceedings brought or sentence imposed before that day in respect of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2010/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A reference in any written law or document in force, immediately before the appointed date to the Director General of Railways under the Act in respect of its application to Peninsular Malaysia, shall be construed as a reference to the Suruhanjaya Pengangkutan Awam Darat established under the Suruhanjaya Pengangkutan Awam Darat Act 2010 [Act ]."
      }
    }
  ]
}
