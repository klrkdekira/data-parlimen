      "schema:text": {
        "@language": "en",
        "@value": "Title Parliament Prime Minister’s Department 317,383,200 Attorney General’s Chambers Treasury General Services 6,000,000,000 Ministry of Foreign Affairs Ministry of Plantation Industries and 786,200,000 Commodities Ministry of Agriculture and Agro-based 1,383,802,500 Industry Ministry of Rural and Regional Development 213,300,000 Ministry of Natural Resources and Environment Ministry of International Trade and Industry Ministry of Works 100,000,000 Ministry of Transport 198,740,000 Ministry of Science, Technology and Innovations Ministry of the Federal Territories and Urban Wellbeing Ministry of Education 1,540,369,000 Ministry of Health 1,037,800,000 Ministry of Housing and Local Government 442,149,000 Ministry of Information, Communication and Culture Ministry of Women, Family and Community 458,750,000 Development Ministry of Defence 493,297,600 Ministry of Home Affairs TOTAL 13,186,713,000"
