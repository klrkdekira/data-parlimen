        "@value": "Supplementary Supply (2011) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2011) Act 2011. Additional expenditure for the year 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding thirteen billion one hundred and eighty-six million seven hundred and thirteen thousand ringgit (RM13,186,713,000) from the Consolidated Fund for additional expenditure on the services and purposes specified in the Schedule for the year 2011 not provided for or not fully provided for by the Supply Act 2011 [Act A1388]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/11/eng@/~sched_1",
