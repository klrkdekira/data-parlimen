      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, and upon such terms as it deems fit, the Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase, take, lease, hold, sell and enjoy movable and immovable property of every description; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer, or otherwise dispose of, or deal with any movable or immovable property or any interest in any movable or immovable property, vested in the Authority. Membership of the Authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
