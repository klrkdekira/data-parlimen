        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of Health as a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Finance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry of Health; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not more than five persons with expertise and experience in medical device matters to be appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Schedule shall apply to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may amend the Schedule by order published in the Gazette. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such conditions as may be specified in his instrument of appointment, every member of the Authority appointed under paragraph 4(1)(e) shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for a term not exceeding three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Authority appointed under paragraph 4(1)(e) shall be eligible for reappointment but no member shall hold office for more than two consecutive terms. Allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall be paid such allowances as the Minister may determine after consultation with the Minister of Finance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "All other members of the Authority, other than the Chief Executive, shall be paid such allowances as the Minister may determine after consultation with the Minister of Finance. Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Authority shall preside at all meetings of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "In the absence of the Chairman for any reason, he shall appoint the Deputy of Director General of Health to carry out the duties of the Chairman. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of a member of the Authority, other than the members appointed under paragraphs 4(1)(a), (b), (c) and (d), may at any time be revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member, other than the Chief Executive, may at any time resign his office by a written notice addressed to the Minister. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Authority, other than Chief Executive, shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his conduct, whether in connection with his duties as a member of the Authority or otherwise, has been such as to bring discredit to the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of the Chairman, he absents himself from three consecutive meetings of the Authority without leave from the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a member of the Authority, other than the Chairman, he absents himself from three consecutive meetings of the Authority without leave of the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member appointed under paragraph 4(1)(e) ceases to be a member of the Authority, the Minister may appoint another person to fill the vacancy for the remainder of the term for which the vacating member was appointed in accordance with the provisions applying. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFICERS AND SERVANTS OF THE AUTHORITY Chief Executive"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a person who has scientific qualification, technical knowledge of and experience in the field of medical device or medical device related matters to be the Chief Executive on such terms and conditions as he thinks desirable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "In the absence of the Chief Executive for any reason, the Minister shall appoint an officer of the Authority to carry out the duties of the Chief Executive."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall vest in the Chief Executive any function and powers of the Authority under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive shall be responsible for the overall administration and management of the functions and the day-to- day affairs of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive shall have general control of the officers and servants of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive shall perform such other duties as the Minister or the Authority may direct. Appointment of other officers and servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may employ such number of officers and servants as it thinks desirable and necessary and upon such terms and conditions as it considers appropriate for carrying out the purposes of the medical device laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, with the approval of the Minister, determine the conditions of service of its officers and servants. Loans and advances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may grant loans and advances to its officers and servants for such purposes and on such terms and conditions as the Authority may determine. Payment of retirement benefits, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may make arrangements for the payment to its officers and servants and their dependents of such retirement benefits, gratuities and other allowances as the Authority may determine. Authority may adopt regulations, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, with the approval of the Minister, adopt with such modifications as it deems fit any regulations, rules, policies, circulars and directives enacted or issued by the Federal Government in relation to any matter under this Part. Employment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall, on the appointed date, accept into its employment every person who immediately before that date was in the employment or service of the Medical Device Bureau, Ministry of Health, Malaysia and who was given an option by the Government of Malaysia and had opted to serve as an employee of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Every such person who opted under subsection (1) to serve as an employee of the Authority shall be employed by the Authority on terms and conditions of service not less favourable than the terms and conditions of service to which he was entitled immediately before the appointed date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Until such time as the terms and conditions of service of its employees are drawn up by the Authority, the scheme and terms and conditions of service, including the law applicable to the conduct and discipline of employees of the Government, shall mutatis mutandis continue to apply to every person employed by the Authority under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order, make such modifications as may be necessary to the scheme and terms and conditions of service referred to in subsection (3) for the purpose of removing any difficulties as a consequence of the provisions of that subsection. Continuation and completion of disciplinary proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Where on the appointed date any disciplinary proceedings is pending or existing against any employee of the Government who had opted to serve as an employee of the Authority, such proceedings shall be continued and completed by the Authority, and the law applicable to such employee immediately before the appointed date in relation to such proceedings shall apply to the proceedings continued and completed under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "An order, ruling or direction made or given by a disciplinary authority of the Authority pursuant to this section shall in respect of such employee of the Government have the same force or effect as an order, ruling or direction made or given by the Disciplinary Authority, Disciplinary Board or Disciplinary Appeal Board, as the case may be, under the law referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order, make such modifications to the law referred to in subsection (1) in their application to such employee of the Government as may be necessary for the purpose of removing difficulties as a consequence of the provision of subsection."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Medical Device Authority Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“member” means a member of the Authority under section 4; “committee” means a committee established under section 10; “Fund” means the Fund established under section 23; “Minister” means the Minister charged with the responsibility for health; “Chairman” means the Director General of Health; “Authority” means the Medical Device Authority established under section 3; “appointed date” means the date appointed under subsection 1(2); “medical device laws” means this Act and the Medical Device Act 2011 [Act ], and includes any subsidiary legislation made under these laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE The Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution shall be instituted for any offence under this Act without the consent in writing of the Public Prosecutor. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman, members of the Authority and any of its committees, and all officers and agents of the Authority, while discharging their duties under this Act as the Chairman, such members, officers or agents, shall be deemed to be public servants within the meaning of the Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Authority, any of its members, any member of a committee, or any officer or agent of the Authority in respect of any act, neglect or default done or committed by him in good faith or any omission omitted by him in good faith, in such capacity. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any purposes of this Act or for the purpose of any civil or criminal proceedings under any written law or where otherwise authorized by the Authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no member of the Authority or any of its committees or any officer or agent of the Authority or any person attending any meeting of the Authority or any of its committees, whether during his tenure of office or during his employment or after that, shall disclose any information which has been obtained by him in the course of his duties and which is not published in pursuance of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has by any means access to any information or document relating to the affairs of the Authority shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding six months or to both. Representation in civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding any other written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "in any civil proceedings by or against the Authority; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "in any other civil proceedings in which the Authority is required or permitted by the court to be represented, or to be heard, or is otherwise entitled to be represented or to be heard, any person authorized by the Authority for that purpose may, on behalf of the Authority, institute such proceedings or appear in such proceedings and may make all appearances and applications and do all acts in respect of the proceedings on behalf of the Authority. Power to employ"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may employ and pay agents, technical advisers and conformity assessment bodies, including advocates and solicitors, bankers, consultants and other persons, to transact any business or to do any act required to be transacted or done in the performance of its functions or for the better carrying into effect the purposes of this Act. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Authority, make regulations as are necessary or expedient to give full effect or for carrying out the provisions of this Act. Acts done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "All acts done by any person or authority on behalf of the Authority in preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto, shall be deemed to have been authorized by this Act, provided that the acts and things done are consistent with the general intention and purposes of this Act; and all rights or obligations acquired or incurred on as a result of the doing of those acts or things including any expenditure incurred in relation thereto, shall on the coming into operation of this Act, be deemed to be the rights and obligations of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the “Medical Device Authority Fund” is established and shall be administered and controlled by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided by Parliament, from time to time, for the purposes of this Act and the medical device laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all or any part of the registration, licence or other fees, administration charges, levies or other charges imposed by or payable to the Authority under the medical device laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived as income from investments by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys derived from the sale, disposal, lease or hire of, or any other dealing with, any property, mortgages, charges or debentures vested in or acquired by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all moneys earned from consultancy and advisory services and any other service provided by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys and property which may in any manner become payable to or vested in the Authority in respect of any matter incidental to its functions and powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums borrowed by the Authority under section 28; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys lawfully received by the Authority. Expenditure to be charged on the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "paying for the allowances and other expenses of the members of the Authority and members of committees and the remuneration, allowances and other expenses of the officers and servants of the Authority, including the granting of loans and advances, superannuation allowances, retirement benefits and gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs, expenditure or other payments properly incurred or accepted by the Authority in the performance of its functions and the exercise of its powers under the medical device laws including the engagement of consultants, legal fees and costs and other charges and costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other materials, acquiring land and any assets, and erecting buildings and carrying out any other works and undertakings in the performance of its functions and the exercise of its powers under the medical device laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under section 28 and the interest due on the borrowed moneys; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of the medical device laws. Conservation of Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Authority to conserve the Fund by so performing its function and exercising its powers under this Act as to secure that the total revenue of the Authority are sufficient to meet all sums properly chargeable to its revenue account including depreciation and interest on capital taking one year with another. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Authority up to such amount as may be authorized by the Minister for any one year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Before 1 September each year, the Authority shall submit to the Minister an estimate of its expenditure, including the expenditure for research and development programmes, for the following year in such form and containing such particulars as the Minister may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, before 1 January the following year, notify the Authority of the amount authorized for expenditure generally or of the amount authorized for each description of expenditure based on the estimate prepared under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may at any time submit to the Minister a supplementary estimate of its expenditure for any one year and the Minister may allow the whole or any part of the additional expenditure included therein. Bank accounts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall open and maintain an account or accounts with such financial institution or institutions in Malaysia as the Authority thinks fit, after consulting the Minister; and every such account shall be operated upon as far as practicable by cheques signed by any person or persons as may be authorized by the Authority for such purpose from time to time. Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, from time to time, borrow in such form and at such rate of interest and for such period and upon such terms as to the time and method of repayment and otherwise, as may be approved by the Minister with the concurrence of the Minister of Finance, any money required by the Authority for meeting any of its obligations or discharging any of its functions. Investment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The moneys of the Authority shall, in so far as they are not immediately required to be expended by the Authority under this Act, be invested in such manner as the Minister may, with the concurrence of the Minister of Finance, approve. Financial procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act and the approval of the Minister, the Authority shall determine its own financial procedure. Financial year"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The financial year of the Authority shall begin on 1 January and end on 31 December of each year. Accounts and reports"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall cause proper accounts of the Fund and proper reports of its activities to be kept and shall, as soon as practicable after the end of each financial year, cause to be prepared for that financial year—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of accounts of the Authority which shall include a balance sheet and an account of income and expenditure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a statement of its activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall cause the statement of accounts to be audited by independent auditors appointed by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall as soon as possible send a copy of the statement of accounts certified by the auditors and a copy of the auditor’s report to the Minister who shall cause such statement and report to be laid before both Houses of Parliament."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Account and Annual Reports) Act 1980 [Act 240] shall apply to the Authority. Payment to the Federal Consolidated Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall on the instruction of the Federal Government, cause to be paid to the Federal Consolidated Fund an amount not exceeding twenty per cent of its current annual surplus after the fifth year of its operation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 4] Times and places of meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Authority shall devote such time to the business of the Authority as is necessary to discharge their duties effectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority is to hold as many meetings as are necessary for the efficient performance of its functions and such meetings are to be held at such places and times as the Chairman may decide, provided that the Chairman shall not allow more than two months to lapse between meetings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall call for a meeting if requested to do so in writing by the Minister or by at least two members of the Authority. Quorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and four members of the Authority shall form a quorum at any meeting of the Authority. Casting vote"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "If on any question to be determined by the Authority there is an equality of votes, the Chairman shall have a casting vote in addition to his deliberative vote. Authority may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may invite any person to attend any meeting or deliberation of the Authority for the purpose of advising it on any matter under discussion, but any person so attending shall have no right to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subparagraph (1) shall be paid such allowances as may be determined by the Authority. Resolutions without meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "A resolution is taken to have been passed at a meeting of the Authority if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all members of the Authority have been informed of the proposed resolution, or reasonable efforts have been made to inform all members of the Authority of the proposed resolution; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "without meeting, a majority of the members of the Authority indicate agreement with the resolution in accordance with the method determined by the Authority under subparagraph (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subparagraph (1) applies only if the Authority—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "decides that subparagraph (1) applies; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "decides the method by which members of the Authority are to indicate agreement with resolutions. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall have a common seal which shall bear such device as the Authority may approve and such seal may from time to time be changed, modified or made anew by the Authority as the Authority thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Chief Executive or any other officer authorized by the Chief Executive, and shall be authenticated by the Chief Executive or by such other person authorized by the Chief Executive in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purported to be sealed with the common seal and authenticated in accordance with subsection (2), shall be deemed to have been validly executed until the contrary is proven."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), any deed, document or instrument which, if executed by a person not being a body corporate, is not required to be under seal may in like manner be executed by an officer of the Authority authorized in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_6",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Authority shall be officially and judicially noticed. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority and every committee shall cause minutes of all their meetings to be maintained and kept in proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause copies of the minutes of all its meetings to be submitted to the Authority as soon as practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of meetings of the Authority or a committee, if duly signed, shall be admissible in any legal proceedings as prima facie evidence of the facts stated in them without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Authority or committee in respect of the proceedings of which minutes have been so made in accordance with subparagraphs (1) and (2) shall be deemed to have been duly convened and held and all members at the meeting to have been duly qualified to act. Procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may regulate its own procedure. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceedings taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of, or any defect in the constitution of, the Authority; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity not affecting the merits of the case. Members to devote time to business of the Authority"
      }
    }
  ]
}
