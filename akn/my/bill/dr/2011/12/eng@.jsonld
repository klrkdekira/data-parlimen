      "schema:text": {
        "@language": "en",
        "@value": "FUNCTIONS AND POWERS OF THE AUTHORITY Functions and powers of the Authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall have all the functions and powers imposed on it under the medical device laws and shall also have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to implement and enforce and to consider and recommend reform to the medical device laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate all matters relating to medical device and the medical device industry and its activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to encourage and promote the development of medical device and the medical device industry and its activities including in the area of research and training;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to provide consultancy and advisory service and any other services in relation to medical device and the medical device industry and its activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to utilize all the property of the Authority, movable and immovable, in such manner as the Authority may think expedient, including the raising of loans by mortgaging such property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to impose fees or charges for services rendered by the Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to grant loans and scholarships to servants of the Authority for such purposes as may be approved by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall have all such powers as may be necessary for, or in connection with, or incidental to, the performance of its functions under this Act. Delegation of the Authority’s functions and powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, in writing, delegate any of its functions or powers other than its power to make subsidiary legislation, to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the Authority; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Authority or a committee, as the case may be, delegated with such function or power shall be bound to observe and have regard to all conditions and restrictions imposed by the Authority and all requirements, procedures and matters specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any function and power delegated under this section shall be performed and exercised in the name and on behalf of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Authority itself from performing or exercising at any time any of the delegated functions and powers. Power of Minister to give directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall be responsible to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, give to the Authority directions of a general character consistent with the provisions of this Act relating to the performance of the functions and powers of the Authority and the Authority shall as soon as possible give effect to such directions. Returns, reports, accounts and information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall furnish to the Minister such returns, reports, accounts and information with respect to its activities and finances as the Minister may from time to time require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The returns, reports, accounts and information shall be in such form and shall contain such information relating to the proceedings and policy of the Authority and any other matter as the Minister may from time to time specify."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may establish any committee it considers necessary or expedient to assist it in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of a committee shall be held at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "minutes of all its meetings to be maintained and kept in proper form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "copies of the minutes of all its meetings to be submitted to the Authority as soon as practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any of its meetings for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The members of a committee and any person invited under subsection (12) shall be paid such allowances and other expenses as the Authority may determine. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may elect any of its members to be the chairman of a committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may appoint any person to be a member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, at any time, revoke the appointment of a member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign his office by a written notice addressed to the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, at any time, discontinue the constitution or alter the composition of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to, and act in accordance with, any direction given to it by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Authority or any committee established under section 10 who has or acquires a direct or indirect interest by himself, through a member of his family or his associate in relation to any matter under discussion by the Authority or committee, as the case may be, shall disclose to the Authority or committee, as the case may be, the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Authority or the committee, as the case may be, in which the matter is discussed and, after the disclosure the member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be present or take part in any discussion or decision of the Authority or committee, as the case may be, about the matter; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the meeting of the Authority or committee, as the case may be, when the matter is discussed or decided upon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Authority or committee who fails to disclose his interest as required under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "No act or proceedings of the Authority or committee shall be invalidated on the ground that any member of the Authority or committee has contravened this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1)— “a member of his family” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his parent (including a parent of his spouse);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his child (including an adopted child or stepchild);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his brother or sister (including a brother or sister of his spouse); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a spouse of his child, brother or sister; and “associate” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is a nominee or an employee of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a firm of which the member or any nominee of his is a partner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a partner of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a trust under which the member or a member of his family is a beneficiary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_11__subsec_5__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any corporation within the meaning of the Companies Act 1965 [Act 125], of which the member or any nominee of his or a member of the member’s family is a director or has a substantial shareholding in the corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate with the name “Medical Device Authority” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall have perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may sue and be sued in its name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/12/eng@/~part_II__cl_3__subsec_4",
