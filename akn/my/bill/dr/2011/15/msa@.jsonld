      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (3)(aaa), dengan memotong perkataan “in” yang terdapat selepas perkataan “referred”. Pindaan seksyen 60i"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_1__subsec_1",
