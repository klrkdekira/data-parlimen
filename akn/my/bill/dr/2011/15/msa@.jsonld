        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_22__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 69 Akta ibu dipinda dalam perenggan (2)(ii)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_22__para_a",
      "@type": "akn:paragraph",
