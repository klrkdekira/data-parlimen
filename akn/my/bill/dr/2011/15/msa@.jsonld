      "eli:number": "iii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_19__para_a__subpara_iii__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/15/msa@/~cl_19__para_a__subpara_iii__subpara_ii"
