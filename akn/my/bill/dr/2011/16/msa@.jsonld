        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_55"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa-kuasa menangkap, penggeledahan dan penyitaan Kuasa menangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal boleh menangkap tanpa waran mana-mana orang yang dipercayainya dengan munasabah telah melakukan atau cuba untuk melakukan suatu kesalahan di bawah seksyen 8."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang membuat tangkapan di bawah subseksyen (1) hendaklah tanpa kelengahan yang tidak perlu menyerahkan orang yang ditangkap sedemikian kepada pegawai polis yang paling hampir atau, jika tiada pegawai polis, membawa orang itu ke balai polis yang paling hampir, dan selepas itu orang itu hendaklah diperlakukan sebagaimana yang diperuntukkan oleh undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa seolah-olah dia ditangkap oleh seorang pegawai polis. Kuasa untuk memasuki premis dan memeriksa dan menyita barang-barang dan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal boleh, pada bila-bila masa yang munasabah, menjalankan kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh, bagi maksud menentukan sama ada apa-apa kesalahan di bawah Akta ini telah dilakukan, memeriksa mana-mana barang dan memasuki mana-mana premis selain premis yang digunakan sebagai tempat kediaman sahaja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia ada sebab yang munasabah bagi mengesyaki bahawa suatu kesalahan di bawah Akta ini telah dilakukan, dia boleh menyita dan menahan apa-apa barang bagi maksud menentukan, dengan cara menguji atau dengan cara lain, sama ada kesalahan itu telah dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh menyita dan menahan mana-mana barang atau dokumen yang dia ada sebab untuk mempercayai mungkin dikehendaki sebagai keterangan dalam prosiding bagi suatu kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh, bagi maksud menjalankan kuasanya di bawah subseksyen ini untuk menyita barang-barang, tetapi hanya jika dan setakat yang semunasabahnya perlu untuk memastikan bahawa peruntukan Akta ini dan peruntukan mana-mana perintah yang dibuat di bawah Akta ini dituruti dengan sewajarnya, menghendaki mana-mana orang yang mempunyai kuasa untuk berbuat demikian supaya memecah buka apa-apa bekas atau membuka apa- apa mesin penjualan dan, jika orang itu tidak mematuhi kehendak itu, dia sendiri boleh berbuat demikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Penolong Pengawal yang menyita apa-apa barang atau dokumen pada menjalankan kuasanya di bawah seksyen ini hendaklah memberitahu orang yang daripadanya barang-barang itu disita dan, dalam hal barang-barang yang disita daripada mesin penjualan, orang yang nama dan alamatnya dinyatakan pada mesin itu sebagai tuan punyanya atau, jika tiada nama dan alamat dinyatakan sedemikian, penduduk premis tempat mesin itu berada atau penduduk premis yang padanya mesin itu dilekatkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang-barang atau dokumen yang disita oleh Penolong Pengawal pada menjalankan kuasanya di bawah seksyen ini adalah disebabkan oleh jenis, saiz atau amaunnya tidak praktik untuk dipindahkan dari tempat barang-barang atau dokumen itu dijumpai, dia boleh dengan apa-apa cara mengelak barang-barang atau dokumen itu di dalam premis atau bekas yang di dalamnya barang-barang atau dokumen itu dijumpai dan menjadi suatu kesalahan bagi mana-mana orang tanpa kuasa yang sah untuk memecahkan, mengganggu atau merosakkan lak itu atau untuk memindahkan barang-barang atau dokumen itu atau untuk cuba berbuat demikian. Kuasa untuk memasuki premis dengan waran geledah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah dan selepas apa-apa siasatan yang difikirkannya perlu, bahawa terdapat alasan yang munasabah untuk mempercayai bahawa seseorang telah melakukan atau sedang melakukan suatu kesalahan di bawah Akta ini, sehingga apa-apa keterangan atau benda yang perlu dalam pelaksanaan suatu penyiasatan bagi apa-apa kesalahan mungkin ditemui di dalam mana-mana premis, Majistret itu boleh mengeluarkan suatu waran yang memberi kuasa mana-mana Penolong Pengawal yang dinamakan dalamnya untuk memasuki premis itu pada bila-bila masa, dengan atau tanpa bantuan, dan jika perlu dengan menggunakan kekerasan untuk menggeledah dan menyita apa-apa keterangan atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Penolong Pengawal yang memasuki mana-mana premis menurut seksyen ini boleh membawa bersamanya mana-mana orang lain dan apa-apa kelengkapan yang ternyata padanya perlu; dan apabila meninggalkan mana-mana premis yang telah dimasukinya menurut kuasa waran di bawah subseksyen yang terdahulu dia hendaklah, jika premis itu tidak diduduki atau penduduknya tidak ada buat sementara waktu, meninggalkan premis itu dalam keadaan yang betul-betul selamat daripada penceroboh sebagaimana keadaan premis itu didapati olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberi kuasa penggeledahan dan penyitaan apa-apa buku, rekod, akaun, dokumen, data komputer, barang atau benda yang mengandungi atau dengan munasabahnya dipercayai mengandungi maklumat tentang apa-apa kesalahan yang disyaki telah dilakukan atau selainnya perlu untuk melaksanakan suatu penyiasatan bagi apa-apa kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal yang menjalankan penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal yang membuat pemeriksaan ke atas seseorang di bawah subseksyen (4) boleh menyita, atau mengambil milikan, dan menyimpan dalam jagaan selamat semua benda selain pakaian yang perlu yang dijumpai pada orang itu, dan apa-apa benda lain, yang berkenaan dengannya terdapat sebab untuk mempercayai bahawa benda itu merupakan peralatan atau keterangan mengenai kesalahan itu, dan benda itu boleh ditahan sehingga Mahkamah mengeluarkan perintah pelupusan terhadapnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab jenis, saiz atau amaunnya, adalah tidak praktik untuk memindahkan apa-apa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda yang disita di bawah seksyen ini, Penolong Pengawal yang menyita itu hendaklah dengan apa- apa cara mengelak premis atau bekas yang di dalamnya dijumpai buku, rekod, akaun, dokumen, data berkomputer, barang atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (6) atau memindahkan apa-apa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan. Kuasa memasuki dan menggeledah dan menyita tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam mendapatkan waran geledah di bawah seksyen 41 penyiasatan akan terjejas atau keterangan mengenai pelakuan pelanggaran atau kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, Penolong Pengawal boleh memasuki premis dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 41 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Akses kepada maklumat berekod atau data berkomputer, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang menjalankan kuasanya di bawah seksyen 41 atau 42 hendaklah diberi akses kepada apa-apa maklumat berekod atau data berkomputer atau berdigital, sama ada yang disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menjalankan kuasanya, Penolong Pengawal—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memeriksa dan meneliti pengendalian apa-apa komputer dan apa-apa radas atau bahan yang berkaitan yang dia ada sebab munasabah untuk mengesyaki sedang atau telah digunakan berkaitan dengan maklumat atau data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menghendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang, olehnya atau bagi pihaknya, pegawai itu ada sebab munasabah untuk mengesyaki, komputer itu sedang atau telah digunakan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang bertanggungjawab, atau yang selainnya terlibat dengan, pengendalian komputer, radas atau bahan itu, untuk memberinya apa-apa bantuan yang munasabah sebagaimana yang dikehendaki olehnya bagi maksud seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh membuat salinan atau mengambil cabutan maklumat berekod, data berkomputer atau berdigital itu jika difikirkannya perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “akses” termasuk diberi kata laluan yang perlu, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu atau apa-apa cara lain yang dikehendaki untuk membolehkan pemahaman maklumat berekod dan data berkomputer atau berdigital itu. Pemberian maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai sebab untuk mengesyaki bahawa seorang Penolong Pengawal sedang bertindak, atau bercadang untuk bertindak, berkaitan dengan suatu penyiasatan yang sedang, atau akan, dijalankan di bawah atau bagi maksud Akta ini dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan penyiasatan itu atau penyiasatan yang dicadangkan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai sebab untuk mengesyaki bahawa suatu penzahiran telah dibuat kepada seorang Penolong Pengawal di bawah Akta ini dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan apa-apa penyiasatan yang mungkin dijalankan berikutan dengan penzahiran itu, melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) menjadikannya suatu kesalahan jika seseorang peguam bela dan peguam cara atau pekerjanya menzahirkan apa-apa maklumat atau perkara lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada pelanggannya atau wakil pelanggannya berkaitan dengan pemberian nasihat kepada pelanggan itu dalam perjalanan dan bagi maksud khidmat profesional peguam bela dan peguam cara itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang pada menjangkakan, atau berkaitan dengan dan bagi maksud, apa-apa prosiding undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (2) tidaklah terpakai berhubungan dengan apa-apa maklumat atau perkara lain yang dizahirkan dengan tujuan untuk melaksanakan apa-apa maksud yang menyalahi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam prosiding terhadap seseorang bagi suatu kesalahan di bawah seksyen ini, menjadi pembelaan jika orang itu membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mengetahui atau mengesyaki bahawa penzahiran yang dibuat di bawah perenggan (1)(b) berkemungkinan menjejaskan penyiasatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mempunyai kuasa sah atau alasan yang munasabah untuk membuat penzahiran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang Penolong Pengawal atau orang yang lain tidak melakukan suatu kesalahan di bawah seksyen ini berkenaan dengan apa-apa perkara yang telah dibuat olehnya dalam perjalanan tindakan yang berkaitan dengan penguatkuasaan, atau penguatkuasaan yang dicadangkan, bagi Akta ini. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun kecacatan, kesilapan atau peninggalan dalamnya atau dalam permohonan bagi waran itu dan mana-mana buku, rekod, akaun, dokumen, data berkomputer, barang atau benda yang disita di bawah waran itu boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Senarai benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika apa-apa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda disita di bawah Bahagian ini, Penolong Pengawal yang melakukan penyitaan itu hendaklah dengan secepat yang dapat dilaksanakan menyediakan senarai benda yang disita itu dan dengan segera menyerahkan suatu salinan senarai itu yang ditandatangani olehnya kepada penghuni premis yang digeledah itu, atau kepada ejen atau pekhidmatnya, di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak berpenghuni, Penolong Pengawal yang melakukan penyitaan itu hendaklah bilamana mungkin menampalkan senarai benda yang disita itu di tempat yang mudah dilihat di premis itu. Pelucuthakan barangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua barangan yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi melucuthakkan atau melepaskan apa- apa barangan yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini hendaklah dibuat oleh Mahkamah yang di hadapannya pendakwaan berkenaan dengannya telah dijalankan dan suatu perintah bagi melucuthakkan barangan itu hendaklah dibuat jika dibuktikan dengan memuaskan hati Mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa barangan itu ialah hal perkara atau telah digunakan dalam melakukan kesalahan itu, walaupun tiada orang telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan mana-mana barangan yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini, barangan itu hendaklah dikira dan disifatkan telah dilucuthakkan apabila habis tempoh satu bulan kalendar dari tarikh ia disita melainkan jika suatu tuntutan mengenainya dibuat sebelum tarikh itu mengikut cara yang dinyatakan kemudian daripada ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya barangan itu dan bahawa barangan itu tidak boleh dilucuthakkan boleh dengan sendirinya atau melalui ejennya yang diberi kuasa secara bertulis memberikan notis bertulis kepada Penolong Pengawal bahawa dia menuntut barangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila diterima notis itu Penolong Pengawal hendaklah merujukkan tuntutan itu kepada Pengawal yang boleh mengarahkan supaya barangan itu dilepaskan atau dilucuthakkan atau boleh mengarahkan Penolong Pengawal supaya merujukkan perkara itu kepada Mahkamah untuk keputusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah yang kepadanya perkara itu dirujukkan hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya barangan itu dan orang yang daripadanya barangan itu telah disita supaya hadir di hadapannya dan apabila dia hadir atau tidak hadir, selepas dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, Mahkamah hendaklah meneruskan pemeriksaan perkara itu dan apabila dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa barangan itu ialah hal perkara kesalahan itu atau telah digunakan dalam melakukan kesalahan itu hendaklah memerintahkan supaya barangan itu dilucuthakkan atau boleh, jika tidak dibuktikan sedemikian, memerintahkan supaya barangan itu dilepaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua benda yang dilucuthakkan atau disifatkan dilucuthakkan hendaklah diserahkan kepada Penolong Pengawal dan hendaklah dilupuskan mengikut arahan Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barangan yang disita pada menjalankan kuasa yang diberikan oleh Akta ini adalah daripada jenis mudah musnah atau jika jagaan barangan itu melibatkan perbelanjaan dan kesusahan yang tidak munasabah, barangan itu boleh dijual pada bila-bila masa dan hasil jualan itu boleh dipegang untuk mematuhi keputusan apa-apa pendakwaan atau tuntutan di bawah seksyen ini. Pelepasan benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda telah disita di bawah Akta ini, Penolong Pengawal yang melakukan penyitaan itu boleh melepaskan buku, rekod, akaun, dokumen, data berkomputer, barang atau benda itu kepada orang yang ditentukan olehnya sebagai berhak secara sah kepadanya, jika dia berpuas hati bahawa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda itu tidak dikehendaki selainnya bagi maksud apa-apa prosiding di bawah Akta ini, atau bagi maksud apa-apa pendakwaan di bawah mana- mana undang-undang bertulis yang lain, dan sekiranya sedemikian Penolong Pengawal yang melakukan penyitaan itu, Kerajaan Persekutuan, Pengawal atau mana-mana orang yang bertindak bagi pihak Kerajaan Persekutuan atau Pengawal tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan buku, rekod, akaun, dokumen, data berkomputer, barang atau benda itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod bertulis hendaklah dibuat oleh Penolong Pengawal yang melakukan pelepasan itu bagi apa-apa perkara di bawah subseksyen (1) dengan menyatakan secara terperinci hal keadaan dan sebab bagi pelepasan itu. Penyitaan barangan mudah musnah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barangan yang disita pada menjalankan kuasa yang diberikan oleh Akta ini merupakan barangan yang mudah musnah sifatnya atau jika jagaan barangan itu melibatkan perbelanjaan dan kesusahan yang tidak munasabah, barangan itu boleh dijual oleh Penolong Pengawal pada bila-bila masa dan hasil jualan itu boleh dipegang untuk mematuhi keputusan apa-apa pendakwaan atau tuntutan di bawah seksyen ini. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan balik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan mana-mana buku, rekod, akaun, dokumen, data berkomputer, barang atau benda yang disita pada menjalankan atau yang berupa sebagai menjalankan mana- mana kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau kepada apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Halangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk memberi mana-mana Penolong Pengawal akses kepada mana-mana premis yang Penolong Pengawal itu berhak kepadanya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menggalang, menghalang atau melengahkan mana-mana Penolong Pengawal dalam membuat apa- apa kemasukan yang Penolong Pengawal itu berhak membuatnya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk memberi mana-mana Penolong Pengawal apa- apa maklumat yang berhubungan dengan suatu kesalahan atau suatu kesalahan yang disyaki di bawah Akta ini atau apa-apa maklumat lain yang secara munasabah dikehendaki supaya diberikan olehnya dan yang ada dalam pengetahuan atau kuasanya, melakukan suatu kesalahan. Kuasa membuat pembelian untuk ujian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal hendaklah mempunyai kuasa untuk membuat apa-apa pembelian barangan yang ternyata suai manfaat bagi maksud menentukan sama ada atau tidak peruntukan Akta ini dan perintah yang dibuat di bawahnya dipatuhi. Keterangan agent provocateur boleh diterima"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana rukun undang-undang atau peruntukan Akta ini atau mana-mana undang-undang bertulis lain yang berlawanan, tiada agent provocateur boleh dianggap sebagai tidak boleh dipercayai hanya oleh sebab dia cuba untuk bersubahat atau telah bersubahat dalam melakukan suatu kesalahan oleh mana- mana orang di bawah Akta ini jika cubaan untuk bersubahat atau pensubahatan itu adalah semata-mata bagi maksud mendapatkan keterangan terhadap orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana rukun undang-undang atau peruntukan Akta ini atau mana-mana undang-undang bertulis lain yang berlawanan, dan walaupun agent provocateur itu ialah seorang Penolong Pengawal, apa-apa pernyataan, sama ada lisan atau bertulis yang dibuat kepada agent provocateur itu oleh mana-mana orang yang selepas itu dipertuduh atas suatu kesalahan di bawah Akta ini boleh diterima sebagai keterangan dalam perbicaraannya. Mengambil sampel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barang yang menjadi hal perkara suatu kesalahan di bawah Akta ini terdapat dalam dua atau lebih bungkusan atau bekas yang sama perihalnya, hendaklah dianggap sehingga dibuktikan sebaliknya bahawa semua bungkusan atau bekas itu mengandungi barang yang sama jenis, kuantiti dan kualiti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bungkusan atau bekas mengandungi barang-barang yang melanggar peruntukan Akta ini atau yang selainnya boleh disita telahpun disita, adalah mencukupi untuk membuka dan memeriksa satu peratus atau tidak kurang daripada lima sampel, mengikut mana-mana yang lebih kurang, daripada kandungan dalam setiap bungkusan atau bekas yang disita itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah menganggap bahawa lebihan sampel yang terkandung dalam bungkusan atau bekas itu adalah sama jenis dengan sampel yang diperiksa. Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang menyiasat apa-apa pelakuan kesalahan di bawah Akta ini boleh menjalankan semua atau mana-mana kuasa yang berhubungan dengan penyiasatan polis dalam kes boleh tangkap yang diperuntukkan oleh Kanun Tatacara Jenayah [Akta 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa adalah demi kepentingan orang yang kepadanya apa-apa barang dibekalkan atau apa-apa perkhidmatan diadakan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa adalah demi kepentingan orang yang kepadanya apa-apa barang dieksport dan tidak berlawanan dengan kepentingan orang yang kepadanya barang-barang itu dibekalkan di Malaysia, bahawa apa-apa ungkapan yang digunakan berhubungan dengan barang-barang atau perkhidmatan itu patut difahami sebagai mempunyai pengertian yang tertentu, Menteri boleh melalui perintah, memberikan apa-apa pengertian sama ada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada ungkapan itu apabila digunakan dalam perjalanan perdagangan atau perniagaan sebagai, atau sebagai sebahagian daripada, suatu perihal dagangan yang digunakan bagi barang-barang atau perkhidmatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada ungkapan itu apabila digunakan sedemikian dalam apa-apa hal keadaan yang dinyatakan dalam perintah itu, dan jika suatu pengertian diberikan sedemikian kepada suatu ungkapan ia hendaklah disifatkan bagi maksud Akta ini sebagai mempunyai pengertian itu apabila digunakan sebagaimana yang disebut dalam perenggan (A) atau, mengikut mana-mana yang berkenaan, perenggan (B)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi suatu kesalahan bagi mana-mana orang yang menggunakan ungkapan yang telah ditakrifkan dalam perintah yang dinyatakan dalam subseksyen (1) sebagai perihal dagangan bagi barang-barang atau perkhidmatan, dengan tujuan untuk memperdaya atau mengelirukan orang yang mahu membeli atau mendapatkan barang-barang atau perkhidmatan itu, seolah-olah barang-barang atau perkhidmatan itu dibekalkan menurut takrif yang diberikan kepada ungkapan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah seksyen ini boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima juta ringgit, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi sepuluh juta ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_28__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Perintah cap bermaklumat dan perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada Menteri adalah perlu atau suai manfaat demi kepentingan orang yang kepadanya apa-apa barang atau apa-apa perkhidmatan yang berhubungan dengan barang-barang itu dibekalkan, bahawa barang-barang itu sepatutnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "diperakukan oleh pihak berkuasa yang berwibawa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ditandakan dengan cap yang ditentukan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "disertai dengan apa-apa maklumat (sama ada atau tidak terjumlah kepada atau termasuk suatu perihal dagangan) atau arahan yang berhubungan dengan barang-barang, Menteri boleh, melalui perintah, mengenakan kehendak untuk menjamin bahawa barang-barang itu diperakukan, ditandakan atau disertai sedemikian dan mengawal selia atau melarang pembekalan barang-barang dan kehendak itu boleh meliputi bentuk dan cara maklumat atau arahan itu diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perintah di bawah seksyen ini sedang berkuat kuasa berkenaan dengan barang-barang daripada apa-apa perihalan, mana-mana orang yang, dalam perjalanan perdagangan atau perniagaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memperakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menandakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membekalkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menawarkan untuk membekalkan, barang-barang daripada perihalan itu dengan melanggar perintah itu melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi dua ratus ribu ringgit, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi lima ratus ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi dua ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pihak berkuasa yang berwibawa” ertinya pihak berkuasa yang berwibawa yang dinamakan oleh Menteri selepas mendapat persetujuan pihak berkuasa yang berwibawa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat perintah melarang pengimportan barang-barang ke dalam Malaysia jika perihal dagangan palsu digunakan pada mana-mana barang di luar Malaysia dan petunjuk palsu itu, atau salah satu petunjuk palsu itu, yang telah diberikan, atau mungkin dikira telah diberikan, ialah petunjuk mengenai tempat dibuat, dikeluarkan, diproseskan atau dipulihkan barang- barang itu atau mana-mana bahagian daripada barang-barang itu. Menyubahati kesalahan yang dilakukan di luar negeri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), mana-mana orang, di Malaysia, yang membantu atau mendorong pelakuan sesuatu perbuatan di mana-mana negara lain berkenaan dengan barang- barang yang jika perbuatan itu dilakukan di Malaysia akan menjadi suatu kesalahan di bawah seksyen 5, melakukan suatu kesalahan, jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perihal dagangan palsu yang berkenaan ialah suatu petunjuk (atau apa-apa yang mungkin dikira sebagai suatu petunjuk) bahawa barang-barang itu atau mana- mana bahagian daripadanya telah dibuat, dikeluarkan, diproseskan atau dipulihkan di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perihal dagangan palsu yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "terdiri daripada atau mengandungi suatu ungkapan (atau apa-apa yang mungkin dikira sebagai suatu ungkapan) yang kepadanya pengertian diberikan melalui suatu perintah yang dibuat di bawah perenggan 28(1)(b); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengertian itu diberikan sedemikian hanya dalam hal keadaan yang dinyatakan dalam perintah itu, perihal dagangan itu digunakan dalam hal keadaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang tidak melakukan suatu kesalahan di bawah subseksyen (1) jika, melalui perintah yang dibuat di bawah seksyen 56, Menteri telah menetapkan ketidakpakaian seksyen 5 bagi barang-barang yang dimaksudkan untuk dihantar ke suatu tempat di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, di Malaysia, membantu atau mendorong pelakuan sesuatu perbuatan di mana-mana negara lain, berkenaan dengan barang-barang yang jika perbuatan itu dilakukan di Malaysia akan menjadi suatu kesalahan di bawah seksyen 26, melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 6(3)] Akta Jualan Dadah 1952 [Akta 368]"
      }
    }
  ]
}
