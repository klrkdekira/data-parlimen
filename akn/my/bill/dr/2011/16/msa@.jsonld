        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERNYATAAN SILAP SELAIN PERIHAL DAGANGAN PALSU Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, “palsu” atau “mengelirukan” ertinya apa-apa pelakuan, representasi, pernyataan atau amalan yang berupaya untuk membawa mana-mana orang kepada kesilapan. Petunjuk palsu atau yang mengelirukan tentang harga barang- barang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang menawarkan untuk membekalkan apa-apa barang tidak boleh membuat apa-apa petunjuk palsu atau yang mengelirukan, dengan apa-apa cara, sama ada secara langsung atau tidak langsung—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa harga barang-barang yang ditawarkan itu adalah sama dengan atau lebih rendah daripada harga yang disyorkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa barang-barang itu ditawarkan pada harga yang lebih rendah daripada harga yang sebenarnya ditawarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa barang-barang itu ditawarkan pada harga yang lebih rendah daripada harga yang ditawarkan oleh mana- mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dipertuduh dengan suatu kesalahan di bawah seksyen ini, beban untuk membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harga barang-barang yang ditawarkan olehnya adalah lebih rendah daripada harga yang ditawarkan oleh mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kewujudan dan terma apa-apa harga yang disyorkan yang padanya dia bergantung atau bahawa kehendak subseksyen (3) telah dipatuhi, hendaklah terletak pada orang yang dipertuduh itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu petunjuk tentang suatu harga yang disyorkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dikira, melainkan jika dinyatakan sebaliknya, sebagai suatu petunjuk bahawa ia suatu harga yang disyorkan oleh pembuat atau pengeluarnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dikira, melainkan jika dinyatakan sebaliknya, sebagai suatu petunjuk bahawa ia suatu harga yang disyorkan pada amnya untuk pembekalan secara jualan runcit di kawasan tempat barang-barang itu ditawarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jua yang mungkin dikira sebagai suatu petunjuk tentang suatu harga yang disyorkan hendaklah dianggap sebagai suatu petunjuk sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mengiklankan barang-barang sebagai ada untuk pembekalan hendaklah dikira sebagai menawarkan untuk membekalkannya. Harga disifatkan termasuk cukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana iklan harga apa-apa barang atau perkhidmatan disebut, harga itu hendaklah, melainkan jika ternyata sebaliknya, disifatkan termasuk semua cukai dan duti kerajaan yang layak dan apa-apa caj lain. Representasi palsu tentang pembekalan atau kelulusan barang- barang atau perkhidmatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh membuat apa-apa representasi palsu dengan apa-apa cara, sama ada secara langsung atau tidak langsung, bahawa apa-apa barang atau perkhidmatan yang dibekalkan olehnya atau apa-apa kaedah yang digunakan olehnya ialah barang-barang atau perkhidmatan yang dibekalkan kepada atau diluluskan oleh mana-mana orang termasuk mana-mana kerajaan atau jabatan atau agensi kerajaan atau mana-mana badan atau agensi antarabangsa sama ada di Malaysia atau luar negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah berkuat kuasa tanpa menjejaskan peruntukan mana-mana undang-undang bertulis yang melarang atau menyekat penggunaan apa-apa nama, lambang, insignia, meterai, bendera, panji-panji, gelaran, jata, tanda, perkataan atau huruf atau apa-apa bentuk perihalan yang lain dalam perjalanan perdagangan, perniagaan, pekerjaan atau profesion. Pernyataan palsu atau yang mengelirukan tentang perkhidmatan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu pernyataan yang diketahuinya adalah palsu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa berhemat membuat suatu pernyataan palsu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_C",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_D",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_E",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_F"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa pernyataan yang mungkin memperdayakan atau mengelirukan mana-mana orang, tentang mana-mana perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "pengadaan apa-apa perkhidmatan, penginapan atau kemudahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "sifat apa-apa perkhidmatan, penginapan atau kemudahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "bila masanya, bagaimana caranya atau orang yang olehnya apa-apa perkhidmatan, penginapan atau kemudahan yang diadakan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "pemeriksaan, kelulusan atau penilaian oleh mana-mana orang bagi apa-apa perkhidmatan, penginapan atau kemudahan yang diadakan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_E",
      "@type": "akn:subparagraph",
      "eli:number": "E",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "lokasi atau kemudahan bagi apa-apa penginapan yang diadakan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c__subpara_F",
      "@type": "akn:subparagraph",
      "eli:number": "F",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "kadar atau caj bagi apa-apa perkhidmatan, penginapan atau kemudahan yang diadakan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pernyataan, sama ada atau tidak merujuk kepada mana-mana perkara yang dinyatakan dalam subseksyen (1), yang mungkin dikira sebagai suatu pernyataan mengenai mana-mana perkara itu yang mungkin palsu, adalah disifatkan sebagai suatu pernyataan palsu tentang perkara itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pernyataan yang dibuat tidak kira sama ada ia benar atau palsu adalah disifatkan telah dibuat tanpa berhemat, sama ada atau tidak orang yang membuatnya ada sebab untuk mempercayai bahawa ia mungkin palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Berhubungan dengan apa-apa perkhidmatan yang mengandungi atau yang termasuk pengenaan apa-apa rawatan atau proses atau penjalanan apa-apa pembaikan, perkara yang dinyatakan dalam subseksyen (1) hendaklah dikira sebagai termasuk kesan rawatan, proses atau pembaikan itu. Pernyataan palsu atau yang mengelirukan dalam iklan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh membuat apa-apa pernyataan palsu atau yang mengelirukan dalam mana-mana iklan berhubungan dengan apa-apa barang atau perkhidmatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dipertuduh atas suatu kesalahan di bawah seksyen ini, beban untuk membuktikan bahawa pernyataan yang dibuat olehnya adalah benar atau tidak mengelirukan hendaklah terletak pada orang yang dipertuduh itu. Anggapan liabiliti ke atas pengiklan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang berikut hendaklah, melainkan jika dibuktikan sebaliknya, disifatkan telah membuat suatu pernyataan palsu atau yang mengelirukan dalam mana-mana iklan:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang secara langsung atau tidak langsung menawarkan untuk membekalkan barang-barang atau perkhidmatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang bagi pihaknya iklan itu dibuat. Pernyataan palsu atau yang mengelirukan berhubungan dengan peraduan, permainan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh membuat apa-apa pernyataan palsu atau yang mengelirukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa barang-barang atau perkhidmatan yang ditawarkan olehnya dapat memudahkan kemenangan dalam mana-mana peraduan atau permainan mencuba nasib; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa mana-mana orang telahpun memenangi, akan memenangi, atau akan, sekiranya melakukan perbuatan tertentu, memenangi hadiah atau faedah lain yang setara, sedangkan pada hakikatnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada hadiah atau faedah lain yang setara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "hadiah atau faedah lain yang setara itu tidak diadakan sebagaimana yang ditawarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil apa-apa tindakan berhubungan dengan menuntut hadiah atau faedah yang setara itu adalah tertakluk kepada orang itu membayar wang, menanggung kos atau apa-apa syarat yang tidak munasabah. Pelanggaran Bahagian III menjadi suatu kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar mana-mana peruntukan dalam Bahagian ini melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima ratus ribu ringgit, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi satu juta ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi dua ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang menggunakan suatu perihal dagangan bagi barang-barang jika dia atau mana-mana orang yang diberi kuasa olehnya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menampalkan atau melampirkannya pada atau dengan apa- apa cara mengecapkannya di atas atau menyatukannya dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "barang-barang itu sendiri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa benda yang di dalamnya, di atasnya atau dengannya barang-barang itu dibekalkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meletakkan barang-barang itu di dalam, di atas atau dengan apa-apa benda yang perihal dagangan itu telah ditampalkan atau dilampirkan padanya, dicapkan di atasnya atau disatukan dengannya, atau meletakkan mana-mana benda itu dengan barang-barang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan perihal dagangan itu dengan apa-apa cara yang mungkin dianggap sebagai merujuk kepada barang- barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu pernyataan lisan boleh terjumlah kepada penggunaan suatu perihal dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang-barang dibekalkan menurut suatu permintaan yang dalamnya suatu perihal dagangan digunakan dan hal keadaannya adalah sebegitu rupa sehingga menjadikan munasabah untuk membuat inferens bahawa barang-barang itu dibekalkan sebagai barang-barang yang bersamaan dengan perihal itu, orang yang membekalkan barang-barang itu disifatkan sebagai telah menggunakan perihal dagangan itu bagi barang-barang itu. Perihal dagangan yang digunakan dalam iklan bagi kelas barang-barang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini hendaklah berkuat kuasa jika dalam sesuatu iklan suatu perihal dagangan digunakan berhubungan dengan mana-mana kelas barang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Perihal dagangan itu hendaklah dikira sebagai merujuk kepada semua barang daripada kelas itu, sama ada atau tidak barang-barang itu ada pada masa iklan itu disiarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud menentukan sama ada suatu kesalahan telah dilakukan di bawah perenggan 5(1)(a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika barang-barang daripada kelas itu dibekalkan atau ditawarkan untuk dibekalkan oleh seseorang yang menyiarkan atau mempamerkan iklan itu, bagi maksud menentukan sama ada suatu kesalahan telah dilakukan di bawah perenggan 5(1)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menentukan sama ada apa-apa barang terdiri daripada suatu kelas yang baginya suatu perihal dagangan yang digunakan dalam suatu iklan adalah berkaitan, perhatian hendaklah diberikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada bentuk dan kandungan iklan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada masa, tempat, cara dan kekerapan penyiaran iklan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada semua perkara lain, yang menyebabkan mungkin atau tidak mungkin seseorang yang kepadanya dibekalkan barang-barang itu akan memikirkan bahawa barang-barang itu tergolong dalam kelas yang berhubungan dengannya perihal dagangan itu digunakan dalam iklan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “kelas barang-barang” ertinya kelas barang-barang yang ditetapkan di bawah Akta Cap Dagangan 1976. Dalam milikan untuk pembekalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang ada dalam milikannya tiga barang atau lebih yang sama daripada perihalan yang serupa dan menggunakan perihal dagangan yang sama sebagaimana yang disebut dalam seksyen 6 dan 8 disifatkan sebagai mempunyai dalam milikan barang-barang untuk pembekalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan suatu perihal dagangan palsu bagi apa-apa barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membekalkan atau menawarkan untuk membekalkan apa- apa barang yang baginya suatu perihal dagangan palsu digunakan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendedahkan untuk pembekalan atau mempunyai dalam milikan, jagaan atau kawalannya untuk pembekalan apa-apa barang yang baginya suatu perihal dagangan palsu digunakan, melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi dua ratus lima puluh ribu ringgit, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi lima ratus ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi dua ratus lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Istilah-istilah yang digunakan dalam seksyen ini dan di mana- mana jua lagi ia terdapat dalam Akta ini hendaklah ditafsirkan mengikut seksyen 6 hingga 11. Perihal dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan seksyen 8, suatu perihal dagangan ialah suatu petunjuk, sama ada secara langsung atau tidak langsung, dan yang diberikan dengan apa-apa cara, mengenai mana-mana daripada perkara yang berikut berkenaan dengan apa-apa barang- barang atau bahagian barang-barang:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jenis atau nama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kuantiti, panjang, lebar, tinggi, luas, isi padu, muatan, berat, saiz atau ukuran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah pembuatan, pengeluaran, pemprosesan atau pemulihan keadaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kandungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kelayakan bagi maksud, kekuatan, prestasi, gerak-geri atau ketepatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "standard ketulenan barang yang dibuat daripada logam berharga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa ciri fizikal atau teknologi yang tidak termasuk dalam perenggan yang terdahulu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh habis tempoh barang-barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengujian oleh mana-mana orang dan keputusannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kualiti selain yang ditetapkan dalam perenggan yang terdahulu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kelulusan oleh mana-mana orang atau keakuran dengan jenis yang diluluskan oleh mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat atau tarikh pembuatan, pengeluaran, pemprosesan atau pemulihan keadaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang membuat, mengeluarkan, memproses atau memulihkan keadaan barang-barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "riwayat lain, termasuk pemunyaan atau penggunaan sebelumnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara yang dinyatakan dalam subseksyen (1) hendaklah dikira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan apa-apa haiwan, sebagai termasuk jantina, baka atau kacukan, kesuburan dan kesempurnaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan apa-apa mani, sebagai termasuk pengenalan dan ciri-ciri haiwan yang daripadanya mani itu telah diambil dan sukatan kecairan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penggunaan apa-apa perihal dilarang di bawah peruntukan undang-undang yang dinyatakan dalam Jadual kecuali jika digunakan bagi barang-barang yang mematuhi kehendak undang-undang itu, tiada perihal yang digunakan mengikut kehendak undang-undang itu akan menjadi suatu perihal dagangan palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh meminda Jadual yang disebut dalam subseksyen (3) melalui perintah yang disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu perihal dagangan atau pernyataan yang diterbitkan dalam mana-mana akhbar, buku atau majalah berkala atau dalam mana-mana filem atau siaran bunyian atau televisyen atau apa-apa medium lain, termasuk melalui cara elektronik, tidak boleh disifatkan sebagai suatu perihal dagangan atau pernyataan melainkan jika ia adalah atau menjadi sebahagian daripada sesuatu iklan. Perihal dagangan palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perihal dagangan palsu ialah suatu perihal dagangan yang palsu ke takat darjah yang material."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perihal dagangan, walaupun tidak palsu, adalah mengelirukan, iaitu yang mungkin dikira sebagai suatu petunjuk bagi mana-mana perkara yang dinyatakan dalam seksyen 6 yang adalah palsu ke takat darjah yang material, hendaklah disifatkan sebagai suatu perihal dagangan palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa, walaupun bukan suatu perihal dagangan, iaitu yang mungkin dikira sebagai suatu petunjuk bagi mana-mana perkara yang dinyatakan dalam seksyen 6 yang adalah palsu ke takat darjah yang material, hendaklah disifatkan sebagai suatu perihal dagangan palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu petunjuk palsu, atau apa-apa jua yang mungkin dikira sebagai suatu petunjuk yang adalah palsu, bahawa apa-apa barang mematuhi standard yang ditentukan atau diiktiraf oleh mana-mana orang atau disiratkan dengan kelulusan mana-mana orang disifatkan sebagai suatu perihal dagangan palsu, jika tidak ada orang sedemikian atau tidak ada standard yang ditentukan, diiktiraf atau difahamkan sedemikian. Larangan perihal dagangan palsu berhubungan dengan cap dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 5 dan 6, suatu perihal dagangan termasuklah suatu petunjuk, sama ada secara langsung atau tidak langsung, dan yang diberikan melalui apa-apa cara, berkenaan dengan apa-apa barang-barang atau bahagian barang-barang yang berhubungan dengan apa-apa hak berkenaan dengan cap dagangan yang berdaftar di bawah Akta Cap Dagangan 1976 [Akta 175]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan suatu perihal dagangan palsu bagi apa-apa barang seolah-olah barang itu tertakluk kepada apa-apa hak yang berhubungan dengan cap dagangan berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membekalkan atau menawarkan untuk membekalkan apa- apa barang yang baginya suatu perihal dagangan palsu digunakan seolah-olah barang itu tertakluk kepada apa-apa hak yang berhubungan dengan cap dagangan berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mendedahkan untuk pembekalan atau mempunyai dalam milikan, jagaan atau kawalannya untuk pembekalan apa-apa barang yang baginya suatu perihal dagangan palsu digunakan, melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima belas ribu ringgit bagi setiap barang yang diletakkan perihal dagangan palsu, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit bagi setiap barang yang diletakkan perihal dagangan palsu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit bagi setiap barang yang diletakkan perihal dagangan palsu atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi dua puluh ribu ringgit bagi setiap barang yang diletakkan perihal dagangan palsu atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menggunakan, membekalkan atau menawarkan untuk membekalkan, mendedahkan untuk pembekalan atau mempunyai dalam milikan, jagaan atau kawalannya untuk pembekalan apa-apa barang yang diletakkan suatu cap yang serupa dengan cap dagangan berdaftar tanpa persetujuan pemunya berdaftar cap dagangan itu disifatkan sebagai menggunakan, membekalkan atau menawarkan untuk membekalkan barang-barang yang diletakkan perihal dagangan palsu melainkan jika dibuktikan sebaliknya. Perintah Perihal Dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang merupakan pemunya berdaftar suatu cap dagangan yang berdaftar di bawah Akta Cap Dagangan 1976 mendakwa bahawa haknya berkenaan dengan cap dagangan itu dilanggar dalam perjalanan perdagangan, oleh mana-mana cap lain atau cara gaya yang digunakan oleh mana-mana orang lain, yang tidak serupa dengan cap dagangan berdaftarnya tetapi boleh berkelirupaan sebagai cap dagangan berdaftarnya, pemunya berdaftar itu boleh memohon kepada Mahkamah Tinggi untuk mengisytiharkan bahawa cap yang melanggar itu ialah perihal dagangan palsu bagi maksud seksyen 8."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), orang yang disebut dalam subseksyen (1) dalam membuat permohonan itu hendaklah mengenal pasti secara khusus cap dagangan atau cap lain atau cara gaya yang melanggar, dan Mahkamah Tinggi boleh, atas permohonan orang itu, membuat suatu perintah yang mengisytiharkan bahawa cap dagangan atau cap lain atau cara gaya yang melanggar itu bagi maksud Akta ini, ialah suatu perihal dagangan palsu dalam penggunaannya bagi barang-barang itu sebagaimana yang dinyatakan dalam perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah Mahkamah Tinggi yang dibuat di bawah seksyen ini boleh disebut sebagai suatu perintah perihal dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah perihal dagangan yang masih berkuat kuasa yang dibuat oleh mana-mana Mahkamah Tinggi di Malaysia boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah seksyen 8 yang dalamnya ia adalah berkaitan sebagai bukti muktamad mengenai suatu perihal dagangan palsu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah perihal dagangan hendaklah habis tempoh pada akhir tempoh satu tahun dari tarikh ia dibuat, melainkan jika ia dibaharui oleh Mahkamah Tinggi atas apa-apa terma dan bagi apa-apa tempoh selanjutnya sebagaimana yang diputuskan oleh Mahkamah Tinggi atas permohonan orang yang disebut dalam subseksyen (1) atau pengganti dalam hakmiliknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang memperoleh suatu perintah perihal dagangan di bawah seksyen ini hendaklah mendaftarkannya dengan Pendaftar. Menggunakan perihal dagangan bagi barang-barang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMBELAAN Kesalahan yang disebabkan oleh salah orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pelakuan sesuatu kesalahan oleh mana-mana orang (disebut dalam seksyen ini sebagai “orang yang mula-mula disebut itu”) disebabkan oleh perbuatan atau keingkaran orang lain, orang lain itu yang melakukan perbuatan atau keingkaran itu, adalah, apabila disabitkan, bersalah atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), mana-mana orang boleh dipertuduh dan disabitkan atas kesalahan itu, sama ada atau tidak prosiding diambil terhadap orang yang mula-mula disebut itu. Pembelaan kegunaan peribadi atau domestik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding bagi sesuatu kesalahan, menjadi suatu pembelaan bagi orang yang dipertuduh untuk membuktikan bahawa pelakuan kesalahan itu adalah bagi maksud kegunaan peribadi atau domestik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila sesuatu pertubuhan perbadanan dipertuduh atas sesuatu kesalahan di bawah Akta ini, pertubuhan perbadanan itu tidak berhak untuk bergantung pada pembelaan yang disebut dalam seksyen ini. Pembelaan kesilapan, tidak sengaja, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), dalam mana-mana prosiding bagi sesuatu kesalahan, menjadi suatu pembelaan bagi orang yang dipertuduh untuk membuktikan bahawa pelakuan kesalahan itu adalah disebabkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh sesuatu kesilapan pada pihaknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh kebergantungan kepada maklumat yang diberikan kepadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh perbuatan atau keingkaran seseorang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh sesuatu yang tidak sengaja atau sesuatu sebab lain di luar kawalannya, dan bahawa dia telah mengambil segala langkah berjaga-jaga yang munasabah dan menjalankan segala usaha yang wajar untuk mengelakkan pelakuan kesalahan itu olehnya atau mana-mana orang di bawah kawalannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam apa-apa hal pembelaan melibatkan pengataan bahawa pelakuan kesalahan itu adalah disebabkan oleh sesuatu kesilapan pada pihaknya atau kebergantungan kepada maklumat yang diberikan kepadanya atau perbuatan atau keingkaran seseorang lain, orang yang dipertuduh itu tidak berhak, tanpa kebenaran Mahkamah, untuk bergantung pada pembelaan itu melainkan jika, dalam tempoh empat belas hari dari dia dipertuduh di Mahkamah, dia telah menyampaikan kepada pendakwa suatu notis bertulis memberikan apa-apa maklumat yang pada masa itu ada dalam milikannya yang mengecam atau membantu untuk mengecam orang lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding bagi kesalahan membekalkan atau menawarkan untuk membekalkan barang-barang yang padanya suatu perihal dagangan palsu digunakan, menjadi suatu pembelaan bagi orang yang dipertuduh untuk membuktikan bahawa dia tidak tahu, dan tidak mungkin dengan usaha yang wajar dapat menentukan, bahawa barang-barang itu tidak mematuhi perihal itu atau bahawa perihal itu telah digunakan bagi barang-barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan dipertuduh atas sesuatu kesalahan di bawah Akta ini, pertubuhan perbadanan itu tidak berhak untuk bergantung pada pembelaan yang disebut dalam seksyen ini. Penyiaran iklan tanpa niat salah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding bagi sesuatu kesalahan yang dilakukan oleh sebab penyiaran sesuatu iklan, menjadi suatu pembelaan bagi orang yang dipertuduh untuk membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia seorang yang urusannya adalah untuk menyiarkan atau mengaturkan penyiaran iklan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah menerima iklan itu untuk disiarkan dalam perjalanan biasa perniagaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia tidak tahu dan tiada sebab untuk mengesyaki bahawa penyiarannya akan terjumlah kepada suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perihal Dagangan 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri, melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“barang-barang” termasuk kapal, kapal udara, kenderaan, haiwan, tumbuhan dan hasil tanaman dan semua jenis harta alih; “elektronik” ertinya teknologi yang menggunakan elektrik, optik, magnetik, elektromagnetik, biometrik, fotonik atau teknologi lain yang seumpamanya; “iklan” ertinya tiap-tiap bentuk pengiklanan (sama ada atau tidak disertai dengan atau dikaitkan dengan perkataan yang ditutur atau ditulis atau dengan tulisan atau bunyi lain dan sama ada atau tidak terkandung atau diterbitkan dalam terbitan) dengan cara mempamerkan notis atau melalui katalog, senarai harga, pekeliling, label, kad atau dokumen atau bahan lain atau dengan menunjukkan filem atau gambar atau fotograf, atau melalui radio atau televisyen, atau dengan apa-apa cara lain termasuk melalui cara elektronik; “kapal” termasuk apa-apa bot dan apa-apa perihalan lain vesel yang digunakan dalam pelayaran; “logam berharga” ertinya emas, perak atau platinum dalam bentuk tulen atau aloi emas, perak atau platinum; “membekalkan” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan barang-barang, pembekalan, termasuk pembekalan semula, secara penjualan, pertukaran, pajakan, sewaan atau sewa beli barang-barang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan perkhidmatan, ertinya pengadaan secara penjualan, pemberian atau pembekalan perkhidmatan itu, melalui apa-apa cara termasuk melalui cara elektronik; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi perdagangan dalam negeri dan kepenggunaan; “Pendaftar” ertinya Pendaftar Perintah Perihal Dagangan yang dilantik di bawah seksyen 4; “Pengawal” ertinya Pengawal Perihal Dagangan yang dilantik di bawah seksyen 3; “Penolong Pengawal” ertinya Penolong Pengawal Perihal Dagangan yang dilantik di bawah seksyen 3; “perkhidmatan” ertinya apa-apa perihalan perkhidmatan, sama ada perindustrian, perdagangan, profesional atau selainnya tetapi tidak termasuk apa-apa yang dibuat di bawah kontrak perkhidmatan; “premis” ertinya apa-apa tempat, yang tidak bergerak atau sebaliknya yang ditubuhkan atau didirikan oleh mana-mana orang, sama ada tempat itu ada atau tiada kepungan, dan termasuklah kenderaan, pesawat udara, kapal dan apa-apa vesel lain; “standard ketulenan”, berhubungan dengan barang yang dibuat daripada logam berharga, ertinya bilangan bahagian mengikut berat emas, perak atau platinum tulen dalam seribu bahagian mengikut berat logam berharga; “terbit”, berhubungan dengan sesuatu iklan, ertinya menunjukkan iklan kepada orang awam atau mana-mana orang awam melalui apa-apa cara, termasuk melalui cara elektronik; dan “Timbalan Pengawal” ertinya Timbalan Pengawal Perihal Dagangan yang dilantik di bawah seksyen 3. Pelantikan Pengawal, Timbalan Pengawal, Penolong Pengawal, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik, daripada kalangan pegawai awam, seorang Pengawal, apa-apa bilangan Timbalan Pengawal, Penolong Pengawal dan pegawai lain sebagaimana yang perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal hendaklah melaksanakan kewajipan yang dikenakan dan menjalankan kuasa yang diberikan kepadanya tertakluk kepada arahan dan kawalan am Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengawal, Penolong Pengawal dan pegawai lain yang dilantik di bawah subseksyen (1) hendaklah berada di bawah arahan dan kawalan Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengawal boleh melaksanakan segala kewajipan yang dikenakan dan menjalankan segala kuasa yang diberikan kepada Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal atau Timbalan Pengawal boleh melaksanakan segala kewajipan yang dikenakan dan menjalankan segala kuasa yang diberikan kepada Penolong Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai yang dilantik di bawah seksyen ini apabila bertindak terhadap mana-mana orang di bawah Akta ini hendaklah, apabila diminta, mengisytiharkan jawatannya dan mengemukakan kepada orang yang terhadapnya dia bertindak itu apa-apa kad kuasa sebagaimana yang diarahkan oleh Pengawal supaya dibawa oleh pegawai itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai yang dilantik di bawah seksyen ini hendaklah disifatkan sebagai pekhidmat awam dalam pengertian Kanun Keseksaan [Akta 574]. Pelantikan Pendaftar Perintah Perihal Dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, hendaklah ada seorang Pendaftar Perintah Perihal Dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik, daripada kalangan pegawai awam, seorang Pendaftar Perintah Perihal Dagangan yang akan menyebabkan suatu daftar awam perintah perihal dagangan diadakan dan disenggarakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_V",
      "@type": "akn:part",
