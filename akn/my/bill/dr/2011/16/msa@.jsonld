      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, menyatakan bahawa mana-mana peruntukan Akta ini tidak terpakai berkenaan dengan apa-apa perihalan bagi barang-barang yang dimaksudkan untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "dihantar ke suatu tempat di luar Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kegunaan atau maksud tertentu sebagaimana yang disebut dalam perintah itu. Kontrak tidak tersentuh oleh pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu kontrak bagi membekal apa-apa barang tidak boleh menjadi terbatal atau tidak boleh dikuatkuasakan semata-mata oleh sebab sesuatu pelanggaran mana-mana peruntukan Akta ini. Eksperimen penyelidikan pasaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini “eksperimen penyelidikan pasaran” ertinya apa-apa aktiviti yang dijalankan bagi maksud menentukan pendapat orang (disebut dalam seksyen ini sebagai “peserta”) tentang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa benda yang dalamnya, atasnya atau dengannya barang-barang itu dibekalkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "rupa atau apa-apa ciri lain barang-barang itu atau sesuatu benda itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "nama atau perihal yang atasnya barang-barang itu dibekalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini terpakai bagi apa-apa eksperimen penyelidikan pasaran yang berkenaan dengannya syarat yang berikut dipenuhi:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa mana-mana peserta yang kepadanya apa-apa barang dibekalkan dalam perjalanan eksperimen itu diberitahu, pada atau sebelum masa barang itu dibekalkan kepadanya, bahawa barang itu dibekalkan bagi sesuatu maksud sebagaimana yang disebut dalam subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tiada balasan berupa wang atau nilai wang diberikan oleh seorang peserta bagi barang itu atau apa-apa barang yang dibekalkan kepadanya untuk perbandingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 5 dan 28 tidak terpakai berhubungan dengan barang- barang yang dibekalkan atau ditawarkan untuk dibekalkan, sama ada kepada seorang peserta atau mana-mana orang lain, dalam perjalanan eksperimen penyelidikan pasaran yang seksyen ini terpakai baginya. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi dua puluh lima ribu ringgit, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi lima puluh ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua- duanya, dan bagi kesalahan yang kedua atau yang berikutnya didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Bidang kuasa untuk membicarakan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa yang berlawanan dalam mana-mana undang-undang bertulis, Mahkamah Sesyen hendaklah mempunyai bidang kuasa untuk membicarakan apa-apa kesalahan di bawah Akta ini dan mengenakan hukuman penuh bagi apa-apa kesalahan sedemikian. Pewakilan kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal atau Timbalan Pengawal boleh secara bertulis mewakilkan semua atau mana-mana kuasa, kewajipan atau fungsinya di bawah Akta ini kepada mana-mana Penolong Pengawal, dan boleh pada bila-bila masa membatalkan mana-mana pewakilan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah subseksyen (1) tidak menghalang Pengawal atau Timbalan Pengawal daripada menjalankan pada bila-bila masa kuasa, kewajipan atau fungsi yang diwakilkan itu. Pemulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi atau berhubungan dengan mana-mana kesalahan di bawah Akta ini boleh dimulakan tanpa keizinan Pendakwa Raya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal boleh, dengan keizinan bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini dengan menerima daripada orang yang melakukan kesalahan itu, suatu jumlah wang yang tidak melebihi denda maksimum bagi kesalahan itu dalam apa-apa masa yang dinyatakan dalam tawaran kompaun itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau dalam apa-apa masa lanjutan yang diberikan oleh Pengawal, pendakwaan bagi kesalahan itu boleh dimulakan pada habis tempoh masa yang ditetapkan dalam tawaran terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila diterima bayaran di bawah subseksyen (1), tiada pendakwaan boleh diambil terhadap orang itu berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal boleh melucuthakkan atau memulangkan barang- barang yang disita semasa kes itu apabila diterima bayaran di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang diterima di bawah subseksyen (1) hendaklah dibayar ke dalam Kumpulan Wang Disatukan Persekutuan. Prinsipal bertanggungjawab bagi perbuatan pekhidmat atau ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pekhidmat atau ejen seseorang melakukan suatu kesalahan atau membuat apa-apa atau meninggalkan daripada melakukan apa-apa perbuatan (yang jika dibuat atau ditinggalkan oleh orang itu akan menjadi suatu kesalahan di bawah Akta ini), orang itu hendaklah, walaupun orang itu tiada pengetahuan mengenai kesalahan itu, disifatkan melakukan kesalahan itu dan boleh dihukum bagi kesalahan itu melainkan jika dia membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan atau peninggalan yang diadukan itu bukan dalam skop biasa pekerjaan pekhidmat atau agensi ejen itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan atau peninggalan yang diadukan itu telah dilakukan atau ditinggalkan tanpa dipersetujui atau dibiarkan olehnya dan bahawa dia telah menjalankan segala usaha wajar untuk mengelakkan pembuatan atau peninggalan itu sebagaimana yang sepatutnya dilakukannya dengan mengambil kira segala hal keadaan kes itu. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini, mana-mana orang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, ketua pegawai eksekutif, ketua pegawai operasi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi pertubuhan perbadanan itu atau yang berupa bertindak atas mana-mana sifat sedemikian atau yang mengikut apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati bersalah melakukan kesalahan itu, hendaklah disifatkan bersalah melakukan kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuan, persetujuan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga- jaga yang munasabah dan telah menjalankan segala usaha yang wajar untuk mengelakkan pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang di bawah Akta ini boleh dikenakan apa-apa hukuman atau penalti bagi perbuatan, peninggalan, pengabaian atau keingkarannya, dia boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran mana-mana pekerja atau ejennya, atau pekerja ejen itu, jika perbuatan, peninggalan, pengabaian atau keingkaran itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam masa penggajiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen itu semasa bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen itu dalam masa penggajian pekerja itu dengan ejen itu atau selainnya bagi pihak ejen yang bertindak bagi pihak orang itu. Ganjaran bagi maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal sabitan yang melibatkan denda, mahkamah yang mengenakan denda itu boleh, atas permohonan pegawai pendakwa, mengarahkan pembayaran mana-mana bahagian denda itu mengikut perkadaran yang difikirkan patut oleh mahkamah tetapi dalam apa- apa hal tidak melebihi setengah daripada denda itu, kepada orang yang memberikan maklumat yang membawa kepada sabitan itu. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap Pengawal, Timbalan Pengawal, Penolong Pengawal atau mana-mana pegawai yang dilantik di bawah seksyen 3 berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dibuat atau dilakukan olehnya dengan suci hati atau apa-apa peninggalan yang ditinggalkan olehnya dengan suci hati, atas sifat yang sedemikian. Perlindungan pegawai dan orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau pendakwaan boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal, Timbalan Pengawal, Penolong Pengawal atau mana-mana orang lain berkenaan dengan apa-apa perbuatan yang diperintahkan atau yang dilakukan bagi maksud melaksanakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa sebagai dilakukan olehnya di bawah perintah, arahan atau suruhan Pengawal jika perbuatan itu dilakukan dengan suci hati dan kepercayaan munasabah bahawa ia perlu bagi maksud yang dihasratkan untuk dicapai dengannya. Kuasa Menteri untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan-peraturan yang suai manfaat atau perlu bagi melaksanakan dengan lebih baik peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan- peraturan boleh dibuat bagi semua atau mana-mana maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan pengertian bagi apa-apa ungkapan atau petunjuk yang digunakan dalam perjalanan perdagangan atau perniagaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melarang, menyekat atau selainnya mengawal selia atau mengawal penggunaan apa-apa ungkapan atau petunjuk yang digunakan dalam perjalanan perdagangan atau perniagaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan fi yang akan dikenakan berkenaan dengan penggunaan apa-apa ungkapan atau petunjuk yang digunakan dalam perjalanan perdagangan atau perniagaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi penyenggaraan daftar atau rekod yang digunakan dalam perjalanan perdagangan atau perniagaan dan menetapkan butir-butir yang hendaklah direkodkan dalam daftar atau rekod itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan borang yang akan digunakan bagi maksud mengawal selia apa-apa perkara yang ditetapkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan standard ketulenan artikel yang dibuat daripada logam berharga dan mengawal selia atau mengawal penggunaan apa-apa ungkapan atau petunjuk yang digunakan dalam perjalanan perdagangan atau perniagaan berhubung dengan standard ketulenan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan suatu penalti denda tidak melebihi dua ratus lima puluh ribu ringgit atau pemenjaraan selama tempoh tidak melebihi lima tahun bagi pelanggaran atau ketidakpatuhan mana-mana peruntukan mana-mana peraturan-peraturan yang dibuat di bawah Akta ini. Pemansuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perihal Dagangan 1972 [Akta 87] dimansuhkan. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Walaupun Akta Perihal Dagangan 1972 dimansuhkan di bawah seksyen 70—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "semua orang, benda dan hal keadaan yang dilantik atau diwujudkan oleh atau di bawah Akta Perihal Dagangan 1972 (“Akta yang dimansuhkan”) atau yang wujud atau yang berterusan di bawah Akta yang dimansuhkan sebaik sebelum permulaan kuat kuasa Akta ini hendaklah, di bawah dan tertakluk kepada Akta ini, terus mempunyai kedudukan, kuat kuasa dan kesan yang sama sebagaimana yang akan dipunyai masing-masing seolah-olah Akta yang dimansuhkan itu tidak dimansuhkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "khususnya dan tanpa menjejaskan keluasan perenggan (a), pemansuhan itu tidak menjejaskan pelantikan, perintah, kaedah-kaedah dan peraturan-peraturan yang dikeluarkan atau dibuat di bawah atau menurut kuasa Akta yang dimansuhkan dan berkuat kuasa sebaik sebelum permulaan kuat kuasa Akta ini dan pelantikan, perintah, kaedah-kaedah dan peraturan-peraturan itu hendaklah berkuat kuasa dan hendaklah terus berkuat kuasa seolah- olah tiap-tiap pelantikan, perintah, kaedah-kaedah dan peraturan-peraturan itu telah dikeluarkan atau dibuat di bawah atau menurut kuasa Akta ini sehingga digantikan atau dibatalkan oleh apa-apa pelantikan, perintah, kaedah- kaedah atau peraturan-peraturan yang dikeluarkan atau dibuat di bawah atau menurut kuasa Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada apa jua pun boleh menjejaskan liabiliti mana-mana orang untuk didakwa atau dihukum bagi kesalahan yang dilakukan di bawah Akta yang dimansuhkan sebaik sebelum permulaan kuat kuasa Akta ini dan pendakwaan kesalahan itu hendaklah dibuat mengikut Akta yang dimansuhkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa prosiding undang-undang, pendakwaan jenayah, penyiasatan atau prosiding tatatertib yang belum selesai di bawah Akta yang dimansuhkan hendaklah diteruskan di bawah Akta dimansuhkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa sebutan mengenai Akta yang dimansuhkan dalam mana-mana undang-undang bertulis hendaklah ditafsirkan sebagai sebutan mengenai Akta ini dan apa-apa sebutan mengenai mana-mana peruntukan tertentu Akta yang dimansuhkan dalam mana-mana undang-undang bertulis hendaklah ditafsirkan sebagai sebutan mengenai peruntukan Akta ini yang hampir-hampir bersamaan dengan peruntukan tertentu itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiasatan dan aduan Penyiasatan oleh Penolong Pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal mempunyai alasan yang munasabah untuk mengesyaki bahawa apa-apa kesalahan sedang atau akan dilakukan di bawah Akta ini, maka Penolong Pengawal boleh menjalankan apa-apa penyiasatan yang difikirkannya suai manfaat bagi pentadbiran wajar Akta ini. Aduan kepada Penolong Pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh, apabila mendapat aduan daripada seseorang, menjalankan penyiasatan terhadap mana-mana orang yang telah atau sedang melakukan apa-apa kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_1__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Aduan itu hendaklah menyatakan orang yang terhadapnya aduan itu dibuat atau premis tempat kesalahan yang dikatakan itu dilakukan dan butiran mengenai kesalahan yang dikatakan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa mengumpul maklumat Kuasa Penolong Pengawal untuk menghendaki pemberian maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini terpakai jika Penolong Pengawal dalam menjalankan penyiasatan di bawah Bahagian ini mempunyai sebab untuk mempercayai bahawa mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai apa-apa maklumat atau apa-apa dokumen yang berkaitan dengan pelaksanaan kuasa dan fungsi Penolong Pengawal di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berupaya memberikan apa-apa keterangan yang Penolong Pengawal mempunyai sebab untuk mempercayai adalah berkaitan dengan pelaksanaan kuasa dan fungsi Penolong Pengawal di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan mana-mana undang-undang bertulis yang lain, Penolong Pengawal, dengan notis bertulis, boleh mengarahkan mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memberi Penolong Pengawal, dalam tempoh dan mengikut cara dan bentuk yang dinyatakan dalam notis itu, apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengemukakan kepada Penolong Pengawal, dalam tempoh dan mengikut cara yang dinyatakan dalam notis itu, apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau media elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membuat salinan, atau cabutan daripada, apa-apa dokumen yang disebut dalam subseksyen (1) dan supaya mengemukakan salinan atau cabutan dokumen itu, mengikut mana-mana yang berkenaan, kepada Penolong Pengawal dalam tempoh dan mengikut cara yang dinyatakan dalam notis itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu seorang individu, supaya hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau media elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu suatu pertubuhan perbadanan atau badan awam, supaya menyebabkan pegawai yang berkaitan dan berkelayakan bagi pertubuhan atau badan itu untuk hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa- apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau media elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu suatu perkongsian, supaya menyebabkan individu yang merupakan seorang pekongsi dalam perkongsian itu atau pekerja perkongsian itu untuk hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa- apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau media elektronik; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membuat suatu pernyataan kepada Penolong Pengawal dengan memberikan suatu penjelasan mengenai apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1) dalam tempoh dan mengikut cara dan bentuk yang dinyatakan dalam notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal mengarahkan mana-mana orang supaya mengemukakan apa-apa dokumen di bawah subseksyen (2) dan orang itu tidak mempunyai jagaan ke atas dokumen itu, orang itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana dokumen itu boleh dijumpai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenal pasti, sepanjang pengetahuan dan kepercayaannya, orang yang terakhir mempunyai jagaan ke atas dokumen itu dan menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana orang terakhir yang disebut itu boleh dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diarahkan supaya memberikan maklumat di bawah subseksyen (2) atau (3) hendaklah memastikan bahawa maklumat yang diberikan itu adalah benar, tepat dan lengkap dan orang itu hendaklah memberikan representasi yang nyata yang bermaksud sedemikian, termasuk suatu perisytiharan bahawa dia tidak menyedari mengenai apa-apa maklumat lain yang akan menjadikan maklumat yang diberikan itu tidak benar atau mengelirukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang enggan atau tidak mematuhi arahan yang dibuat oleh Penolong Pengawal di bawah seksyen ini melakukan suatu kesalahan. Penolong Pengawal boleh memegang simpan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh mengambil dan memegang simpan selama apa-apa tempoh yang difikirkannya perlu, milikan mana-mana dokumen yang diperoleh di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang memberikan dokumen itu berhak untuk dibekalkan, dengan secepat yang dapat dilaksanakan, suatu salinan yang diperakui sah oleh Penolong Pengawal sebagai suatu salinan benar dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan mana-mana undang-undang bertulis yang lain, salinan yang diperakui sah bagi dokumen itu hendaklah diterima sebagai keterangan seolah-olah salinan itu ialah dokumen asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal berpuas hati bahawa dokumen itu tidak lagi perlu dipegang simpan, Penolong Pengawal boleh mengembalikan dokumen itu kepada orang yang memberikan dokumen itu, dengan secepat yang dapat dilaksanakan. Akses kepada rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang hendaklah, jika pada bila-bila masa diarahkan oleh Penolong Pengawal, membenarkan Penolong Pengawal akses kepada buku, rekod, akaun, dokumen, data berkomputer, barang atau benda bagi maksud menjalankan mana-mana fungsi atau kuasa Penolong Pengawal di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi arahan di bawah subseksyen (1) melakukan suatu kesalahan. Kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menzahirkan atau menggunakan apa-apa maklumat atau dokumen rahsia berkenaan dengan suatu perusahaan tertentu atau hal ehwal seseorang individu yang diperoleh menurut kuasa mana-mana peruntukan Akta ini melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa pun dalam subseksyen (1) boleh berkuat kuasa untuk menghalang penzahiran maklumat jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dengan persetujuan orang yang daripadanya maklumat atau dokumen itu diperoleh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dalam hal keadaan maklumat yang diberikan itu dirangka dengan cara yang sebegitu rupa sehingga sumber maklumat itu tidak dapat dipastikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu telah sedia ada dalam domain awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat bagi memudahkan pelaksanaan fungsi atau kuasa Pengawal, Timbalan Pengawal atau Penolong Pengawal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat secara munasabah semasa apa-apa prosiding di bawah Akta ini dengan syarat bahawa penzahiran itu tidak dibuat berlawanan dengan apa-apa arahan Pengawal, Timbalan Pengawal atau Penolong Pengawal yang di hadapannya prosiding itu berjalan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat berkaitan dengan penyiasatan terhadap suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “maklumat rahsia” ertinya maklumat perdagangan, perniagaan atau perindustrian yang dipunyai oleh mana-mana orang, yang mempunyai nilai ekonomi dan secara amnya tidak tersedia kepada atau diketahui oleh orang lain. Komunikasi terlindung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dikehendaki, di bawah mana-mana peruntukan Bahagian ini, supaya memberikan atau menzahirkan apa-apa komunikasi antara seorang penasihat undang-undang profesional dengan pelanggannya yang dilindungi daripada penzahiran mengikut seksyen 126 Akta Keterangan 1950 [Akta 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal membuat suatu kehendak di bawah seksyen 33 terhadap seorang peguam bela dan peguam cara berkenaan dengan apa-apa maklumat atau dokumen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_36__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat atau dokumen itu mengandungi komunikasi terlindung yang dibuat oleh atau bagi pihak atau kepada peguam bela dan peguam cara itu atas sifatnya sebagai seorang peguam bela dan peguam cara, peguam bela dan peguam cara itu berhak untuk enggan mematuhi kehendak itu melainkan jika orang yang kepadanya atau olehnya atau bagi pihaknya komunikasi itu dibuat atau, jika orang itu ialah pertubuhan perbadanan yang di bawah penerimaan atau sedang digulung, penerima atau pelikuidasi, mengikut mana-mana yang berkenaan, bersetuju supaya peguam bela dan peguam cara itu mematuhi kehendak itu, tetapi jika peguam bela dan peguam cara itu enggan untuk mematuhi kehendak sedemikian, peguam bela dan peguam cara itu hendaklah dengan segera memberi Pengawal secara bertulis nama dan alamat orang yang kepadanya atau olehnya atau bagi pihaknya komunikasi itu dibuat. Memberikan maklumat, keterangan atau dokumen palsu atau yang mengelirukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang tidak menzahirkan atau meninggalkan untuk memberikan apa-apa maklumat, keterangan atau dokumen yang berkaitan, atau memberikan apa-apa maklumat, keterangan atau dokumen yang diketahuinya atau dia ada sebab untuk mempercayai adalah palsu atau mengelirukan, dalam penjalanan penyiasatan oleh Penolong Pengawal, melakukan suatu kesalahan. Pemusnahan, penyembunyian, pencacatan dan pengubahan rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, menyembunyikan, mencacatkan atau mengubah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_2__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "menghantar atau cuba untuk menghantar atau berkomplot dengan mana-mana orang lain untuk mengalihkan dari premisnya atau menghantar ke luar Malaysia, apa-apa buku, rekod, akaun, dokumen, data berkomputer, barang atau benda yang disimpan atau disenggarakan dengan niat untuk memfraud Penolong Pengawal atau untuk menghalang, melengahkan atau menggalang penjalanan suatu penyiasatan atau penjalanan mana-mana kuasa Penolong Pengawal di bawah Akta ini melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_VII__chp_3",
      "@type": "akn:chapter",
