        "@language": "ms",
        "@value": "LARANGAN PERIHAL DAGANGAN PALSU Larangan perihal dagangan palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/16/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
