      "schema:text": {
        "@language": "ms",
        "@value": "LARANGAN PENGIMPORTAN BARANG-BARANG TERTENTU, DSB. Larangan pengimportan barang-barang yang mengandungi petunjuk palsu mengenai asal"
      }
    },
