      "schema:text": {
        "@language": "en",
        "@value": "In a prosecution against an employer under subsection (1), by virtue of an offence committed by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_2__para_a",
