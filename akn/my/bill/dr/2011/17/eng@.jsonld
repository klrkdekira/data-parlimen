    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MINIMUM WAGES ORDER Council to have consultation, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Before any recommendation is made under section 22, the Council shall take the following actions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "have consultation with the public on the minimum wages rates and coverage in such manner as the Minister may determine; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "collect and analyse data and information and conduct research on wages and the socioeconomic indicators. Council to make recommendation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Based on the actions taken under section 21, the Council shall, at such time as the Minister may determine, make a recommendation to the Government through the Minister on the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the minimum wages rates;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the coverage of the recommended minimum wages rates according to sectors, types of employment and regional areas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the non-application of the recommended minimum wages rates and coverage to any sectors, types of employment and regional areas or to any person or class of persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the commencement of the minimum wages order and the different dates for the commencement of the minimum wages order to different sectors, types of employment and regional areas, or to different persons or class of persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "other matters relating to the minimum wages, including the implementation of the recommended minimum wages rates and coverage."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Government may, after considering recommendation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "agree with the recommendation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "direct the Council to review the recommendation within the period as the Government may determine and make a fresh recommendation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Government directs the Council to review the recommendation and make a fresh recommendation under paragraph (2)(b), section 21 and subsection (1) shall apply."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Government may, after considering the fresh recommendation made pursuant to subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "agree with the fresh recommendation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_22__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "disagree with the fresh recommendation and determine the matters specified in paragraphs (1)(a) to (e). Minimum wages order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Government agrees with the recommendation of the Council under paragraph 22(2)(a) or 22(4)(a) or determines the matters under paragraph 22(4)(b), the Minister shall, by notification in the Gazette, make a minimum wages order on the matters specified in paragraphs 22(1)(a) to (e) as agreed to or determined by the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon the direction of the Government, by notification in the Gazette, amend or revoke the minimum wages order. Effect of the minimum wages order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “contract of service” includes the collective agreement made under section 14 of the Industrial Relations Act 1967 [Act 177]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Where the rates of the basic wages agreed in a contract of service is lower than the minimum wages rates as specified in the minimum wages order, the rates shall be substituted with any rates not lower than the minimum wages rates as specified in the minimum wages order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Where the rates of the basic wages agreed in a contract of service is higher than the minimum wages rates as specified in the minimum wages order, the rates shall not be reduced to any rates lower than the rates of the basic wages agreed in the contract of service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be construed as preventing an employer and an employee from agreeing to any rates of the basic wages which are higher than the minimum wages rates as specified in the minimum wages order. Council to review minimum wages order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall, at least once in every two years, review the minimum wages order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Council may, on its own accord or upon the direction of the Government, review the minimum wages order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The review made under subsection (1) or (2) shall be on the matters specified in paragraphs 22(1)(a) to (e) and for the purpose of evaluating the effectiveness of the minimum wages order and its implication on the social and economic development of the country."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_III__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Council is satisfied that any matter specified in the minimum wages order needs to be amended, sections 21, 22 and 23 shall apply."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, revoke the appointment of a member of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Council may resign from office by giving thirty days’ written notice to the Minister. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Council shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from two consecutive meetings of the Council without leave of the Chairman, or in the case of the Chairman, without leave of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "If the office of a member of the Council is vacated, the Minister may, if necessary, appoint another person to hold the office for the remaining period vacated by that member or for an interim period until a new member is appointed to that office, as the Minister thinks fit. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall meet at least four times in a year as the Chairman may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "At least fourteen days’ notice in writing or by electronic mail shall be given to the members of the Council. Procedure at meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Council and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the absence of the Chairman at any meeting of the Council for any reason, the Deputy Chairman shall preside at the meeting; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the absence of the Chairman and the Deputy Chairman at any meeting of the Council for any reason, any other member of the Council appointed by the Chairman shall preside at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Council shall be two-third of the members of the Council, including the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Every member present at the meeting of the Council shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "If there is an equality of votes, the Chairman, the Deputy Chairman or any other member presiding at the meeting of the Council under subsection (1) shall have the casting vote. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall cause the minutes of all its meetings to be maintained and kept in proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of a meeting of the Council shall, if duly signed by the Chairman, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Council in respect of which minutes of the proceedings have been made in accordance with subsection (2) shall be deemed to have been duly convened and held and all members at the meeting to have been duly qualified to act. Council may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any person not being a member of the Council to attend its meetings to advise on any matter under discussion, but that person is not entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited under subsection (1) may be paid such allowances as the Council may determine. Procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Council may determine its own procedure. Council may establish committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish any committee as it considers necessary or expedient to assist it in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall appoint any of its members to be the chairman of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint any of its members or any qualified persons to be members of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The members of a committee may be paid such allowances as the Council may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may at any time revoke the appointment of any member of a committee, make changes in the composition of the members of a committee or dissolve a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any direction of the Council, the committee may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The chairman of each committee shall cause minutes of all its meetings to be maintained and kept in proper form and copies of the minutes shall be submitted by the committee to the Council as soon as practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person not being a member of the committee to attend its meetings to advise on any matter under discussion, but that person is not entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited under subsection (8) may be paid such allowances as the Council may determine. Secretariat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a secretariat to the Council with such number of public officers to assist the Council and the Secretary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The secretariat shall be subject to the direction, control and supervision of the Secretary. Funds"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall provide sufficient funds for the Council annually to enable the Council to perform its functions and exercise its powers under this Act. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceeding taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of, or any defect in the establishment of, the Council; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity not affecting the merits of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A council by the name of the “National Wages Consultative Council” is established. Functions and powers of the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Council shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Government on all matters relating to minimum wages, including its development at the international level;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Government on the minimum wages rates and coverage according to sectors, types of employment and regional areas, and other matters relating to minimum wages and wages;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to consult the public on the minimum wages rates and coverage;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to collect and analyse data and information and to conduct research on wages and the socioeconomic indicators;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate and supervise, and to evaluate the impact of, the implementation of minimum wages;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to review the minimum wages order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to deliberate on all matters relating to minimum wages;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to disseminate information and analysis on wages; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out any other functions as it deems fit to enable it to perform its functions effectively or which are incidental to the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have the power to do all things expedient or reasonably necessary for or incidental to the performance of its functions. Membership of the Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_4",
