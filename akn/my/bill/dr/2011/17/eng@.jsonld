        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_II__cl_5__subsec_1__para_e",
