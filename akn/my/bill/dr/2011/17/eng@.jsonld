    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath and after such inquiry as he considers necessary, that there is a reasonable cause to believe that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any premises have been used or are about to be used for; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is in any premises evidence necessary to the conduct of an investigation into, the commission of an offence under this Act, the Magistrate may issue a warrant authorizing an enforcement officer named in the warrant, at any reasonable time, by day or by night and with or without assistance, to enter the premises and if need be by force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A warrant issued under subsection (1) may authorize the enforcement officer to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "search the premises for, and to seize or remove from the premises any book of account of wages, register, financial statement or other document that is reasonably believed to furnish evidence of the commission of the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "take samples of any book of account of wages, register, financial statement or other document found in the premises for the purposes of ascertaining, by examining or otherwise, whether the offence has been committed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make copies of or take extracts from any book of account of wages, register, financial statement or other document found in the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any book of account of wages, register, financial statement or other document shall be admissible as evidence in any proceedings in court under this Act against the person or any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer entering any premises under this section may take with him such other persons and equipment as may appear to him to be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer may, in the exercise of his powers under this section, if it is necessary so to do—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door of the premises or any fence, enclosure, gate or other obstruction to the premises, in order to effect entry into the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "forcibly enter the premises and every part of the premises;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to entry, search, seizure or removal as he is empowered to effect under this section; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "detain any person found in the premises until the search has been completed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Where, by reason of its nature, size or amount, it is not practical to remove any book of account of wages, register, financial statement or other document seized under this section, the enforcement officer shall, by any means, seal such book of account of wages, register, financial statement or other document in the premises or container in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (6) or removes the book of account of wages, register, financial statement or other document under seal or attempts to do so commits an offence. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "If the enforcement officer is satisfied upon information received that he has reasonable cause to believe that by reason of delay in obtaining a search warrant under section 28 the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the enforcement officer may enter the premises and exercise in, upon and in respect of the premises all the powers referred to in section 28 in as full and ample a manner as if he were authorized to do so by a warrant issued under that Access to recorded information, computerized data, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer exercising his powers under section 28 or section 29 shall be given access to any recorded information or computerized or digitalized data, whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "In exercising his powers, the enforcement officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may inspect and check the operation of any computer and any associated apparatus or material which he has reasonable cause to suspect is or has been used in connection with that information or data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person, by whom or on whose behalf, the officer has reasonable cause to suspect, the computer is or has been so used; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person having charge of, or is otherwise concerned with, the operation of the computer, apparatus or material, to provide him with such reasonable assistance as he may require for the purposes of this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The enforcement officer may make copies or take extracts of the recorded information, computerized or digitalized data if he deems it necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “access” includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of recorded information, computerized or digitalized data. Warrant admissible notwithstanding defects"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A search warrant issued under this Act shall be valid and enforceable notwithstanding any defect, mistake or omission in the warrant or in the application for the warrant, and any book of account of wages, register, financial statement or other document seized under the warrant shall be admissible in evidence in any proceedings under this Act. List of book of account of wages, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any book of account of wages, register, financial statement or other document is seized under this Act, the enforcement officer making the seizure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall prepare—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a list of the book of account of wages, register, financial statement or other document seized and shall sign the list; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a written notice of the seizure containing the grounds for the seizure and shall sign the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall as soon as practicable serve a copy of the list of the book of account of wages, register, financial statement or other document seized and the written notice of the seizure to the occupier of the premises which have been searched, or to his agent or servant at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The written notice of the seizure shall not be required to be served under paragraph (1)(b) where the seizure is made in the presence of the person against whom proceedings under this Act are intended to be taken, or in the presence of the owner of the property or his agent, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "If the premises are unoccupied, the enforcement officer shall post a copy of the list of the book of account of wages, register, financial statement or other document seized conspicuously on the premises. Release of the book of account of wages, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "If any book of account of wages, register, financial statement or other document has been seized under this Act, the enforcement officer who effected the seizure may, after referring to the Public Prosecutor, release the book of account of wages, register, financial statement or other document to the person as he determines to be lawfully entitled to it, if the book of account of wages, register, financial statement or other document is not required for the purpose of any proceedings under this Act or for the purpose of any prosecution under any other written law, and in such event neither the enforcement officer effecting the seizure, nor the Federal Government, or any person acting on behalf of the Federal Government shall be liable to any proceedings by any person if the seizure and the release of the book of account of wages, register, financial statement or other document had been effected in good faith."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A record in writing shall be made by the enforcement officer effecting the release of the book of account of wages, register, financial statement or other document under subsection (1) specifying in detail the circumstances of and the reason for the release, and he shall send a copy of the record to the Public Prosecutor within seven days of the release. No cost or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of any book of account of wages, register, financial statement or other document seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Obstruction to exercise of powers by enforcement officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any enforcement officer access to any premises which the enforcement officer is entitled to have under this Act or in the execution of any duty imposed or power conferred by this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders or delays any enforcement officer in effecting any entry which the enforcement officer is entitled to effect under this Act, or in the execution of any duty imposed or power conferred by this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any enforcement officer any information relating to an offence or suspected offence under this Act or any other information which may reasonably be required of him and which he has in his knowledge or power to give, commits an offence. Powers to require the production of book of account of wages, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer in carrying out an investigation under this Part may require any person whom he believes to be acquainted with the facts and circumstance of the case—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to produce to the enforcement officer, any book of account of wages, register, financial statement or other document whether in physical form or in electronic medium; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make copies of, or extracts from any book of account of wages, register, financial statement or other document and to produce copies or extracts of such documents, as the case may be, to the enforcement officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who refuses or fails to comply with the direction made by the enforcement officer under this section commits an offence. Enforcement officer may retain documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The enforcement officer may take and retain, for as long as is necessary, possession of any document obtained under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The person who provided the document is entitled to be supplied, as soon as practicable, with a copy certified by the enforcement officer to be a true copy of the document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of any other written law, the certified copy of the document shall be admissible as evidence as if it were the original document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "If the enforcement officer is satisfied that the retaining of the document is no longer necessary, the enforcement officer may return the document to the person who provided the document as soon as practicable. Access to records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "A person shall, if at any time directed by an enforcement officer, allow the enforcement officer to have access to his book of account of wages, register, financial statement or other document for the purposes of carrying out any of the enforcement officer’s powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with the direction made by the enforcement officer under subsection (1) commits an offence. Power to require attendance of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer making an investigation under this Act may, by order in writing, require the attendance before himself of any person who appears to the enforcement officer to be acquainted with the facts and circumstances of the case, and such person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "If any person refuses or fails to attend as so required, the enforcement officer may report such refusal or failure to a Magistrate who shall issue a summons to secure the attendance of such person as may be required by the order made under subsection (1). Examination of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer making an investigation under this Act may examine orally any person supposed to be acquainted with the facts and circumstances of the case and shall reduce into writing any statement made by the person so examined."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Such person shall be bound to answer all questions relating to the case put to him by the enforcement officer: Provided that such person may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not such statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The enforcement officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by any person under this section shall, whenever possible, be taken down in writing and signed by the person making it or affixed with his thumb print, as the case may be, after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish. Admission of statements in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no statement made by any person to an enforcement officer in the course of an investigation made under this Act shall be used in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "When any witness is called for the prosecution or for the defence, other than the accused, the court shall, on the request of the accused or the prosecutor, refer to any statement made by that witness to the enforcement officer in the course of the investigation under this Act and may then, if the court thinks fit in the interest of justice, direct the accused to be furnished with a copy of it and the statement may be used to impeach the credit of the witness in the manner provided by the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where the accused had made a statement during the course of an investigation, such statement may be admitted in evidence in support of his defence during the course of the trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to apply to any statement made in the course of an identification parade or falling within section 27 or paragraphs 32(1)(a), (i) and (j) of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with an offence in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the making; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_41__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the contents, of any statement made by him to an enforcement officer in the course of an investigation made under this Act, that statement may be used as evidence in the prosecution’s case. Admissibility of documents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of any proceedings under this Act, an enforcement officer may prepare a report which consists of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the difference between the minimum wages rates as specified in the minimum wages order and the basic wages paid by the employer to the employee, including the outstanding differences;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "other payments accrued from the calculation of wages based on the basic wages which shall be in accordance with the minimum wages rates as specified in the minimum wages order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "other matters relating to the employer, employee and contract of service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_IV__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The report prepared under subsection (2) and any documents issued by the employer to the employee indicating the payment of wages shall be prima facie evidence in any proceedings under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Wages Consultative Council Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into operation of this Act in different parts of Malaysia. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context requires otherwise—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“wages” has the same meaning assigned to it in section 2 of the Employment Act 1955 [Act 265], section 2 of the Sabah Labour Ordinance [Cap 67] or section 2 of the Sarawak Labour Ordinance [Cap 76]; “minimum wages” means the basic wages to be or as determined under section 23; “Director General” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of Peninsular Malaysia, the Director General of Labour appointed under subsection 3(1) of the Employment Act 1955;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of Sabah, the Director of Labour appointed under subsection 3(1) of the Sabah Labour Ordinance; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of Sarawak, the Director of Labour appointed under subsection 3(1) of the Sarawak Labour Ordinance; “contract of service” means any agreement, whether oral or in writing, and whether express or implied, whereby one person agrees to employ another person as an employee and that other person agrees to serve his employer as an employee, but does not include an apprenticeship contract; “court” means the Magistrate Court; “employer” means any person who has entered into a contract of service to employ another person as an employee and includes the agent, manager or factor of such first-mentioned person; “Council” means the National Wages Consultative Council established under section 3; “Minister” means the Minister charged with the responsibility for human resources; “enforcement officer” means the officers appointed under section 3 of the Employment Act 1955, section 3 of the Sabah Labour Ordinance or section 3 of the Sarawak Labour Ordinance; “employee” means any person or class of persons specified in the following schedules:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the First Schedule to the Employment Act 1955;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Schedule to the Sabah Labour Ordinance; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Schedule to the Sarawak Labour Ordinance, but does not include the person or class of persons to whom the minimum wages order is not applicable; “Chairman” means the Chairman of the Council appointed under section 5; “minimum wages order” means the order made by the Minister under section 23; “Secretary” means the Secretary of the Council appointed under section 5."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
