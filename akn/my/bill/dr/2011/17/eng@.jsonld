      "schema:text": {
        "@language": "en",
        "@value": "Whenever such enforcement officer exercises any of the powers under this Act, he shall, on demand, produce to the person against whom the power is being exercised the authority card issued to him under subsection (1). Search and seizure with warrant"
      }
    },
