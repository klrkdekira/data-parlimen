      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Responsibility of employer for offences committed by members of board of directors, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48",
      "@type": "akn:clause",
