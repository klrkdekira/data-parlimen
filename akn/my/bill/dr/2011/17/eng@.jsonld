        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence against any provision of this Act has been committed by a person who at the time of the commission of the offence was—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the board of directors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an employee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/17/eng@/~part_VI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an agent, of the employer, the employer shall be deemed to have also committed that offence."
      }
    },
    {
