      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into operation of—"
