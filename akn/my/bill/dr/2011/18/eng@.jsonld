      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 31L(4) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “The Audit Oversight Board shall” the words “The Commission shall”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “a balance sheet” the words “the statement of accounts”. Amendment of Division 4 of Part IIIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended in the subheading of Division 4 of Part IIIA by inserting after the word “Registration” the words “or Recognition”. Amendment of section 31N"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31N of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by inserting after the word “registration” the words “or recognition”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the word “registered” the words “as a registered auditor or recognised as a recognised auditor”. Amendment of section 31O"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31O of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “registration and renewal of registration” the words “registration, renewal of registration and recognition”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “ (1) For the purposes of this Act, an application for— (a) registration or renewal of registration as a registered auditor; or (b) recognition as a recognised auditor, shall be made to the Audit Oversight Board.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: “ (3) Subject to section 31P, the Audit Oversight Board may— (a) approve or refuse the registration of an applicant as a registered auditor or the renewal of registration of a registered auditor; or (b) approve or refuse the grant of recognition of an applicant as a recognised auditor.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (4) the following subsection: “ (4) The Audit Oversight Board may, upon the— (a) registration of an applicant as a registered auditor; (b) renewal of registration of a registered auditor; or (c) grant of recognition of an applicant as a recognised auditor, impose such conditions as it deems necessary or expedient and from time to time amend any such conditions or impose new or additional conditions.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5), by substituting for the words “of the registration or renewal of registration,” the words “imposed under subsection (4),”. Amendment of section 31P"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31P of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “register or renew registration” the words “register, renew registration or grant recognition”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)−"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “an auditor” the words “a registered auditor”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “the auditor” the words “the registered auditor”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “ (1A) The Audit Oversight Board may refuse to recognise an applicant as a recognised auditor if the Audit Oversight Board is satisfied that the applicant— (a) falls within paragraph (1)(b), (c), (d) or (f); (b) has been subject to any sanction imposed by any relevant foreign authority; (c) has not been approved by a relevant foreign authority to prepare audited financial statements; or (d) is not supervised by a relevant foreign authority.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: “ (2) Where the Audit Oversight Board refuses— (a) the registration of an applicant as a registered auditor; (b) the renewal of registration of a registered auditor; or (c) to grant recognition of an applicant as a recognised auditor, the Audit Oversight Board shall give the applicant or the registered auditor an opportunity to be heard by serving a written notice on the applicant or the registered auditor stating the grounds for such refusal.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (3). Amendment of section 31Q"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31Q of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “revoke and suspend registration” the words “revoke, withdraw or suspend registration or recognition”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “ (1) The Audit Oversight Board may, at any time— (a) revoke or suspend the registration; or (b) withdraw or suspend the recognition, of an auditor if— (A) there exists a ground on which the Audit Oversight Board may refuse an application under subsection 31P(1) or (1A); or (B) the auditor contravenes any terms or conditions imposed by the Audit Oversight Board in respect of his registration or recognition under this Part.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: “ (3) Where the Audit Oversight Board intends to— (a) revoke or suspend the registration; or (b) withdraw or suspend the recognition, under subsection (1) or (2), it shall give the auditor an opportunity to be heard by serving a written notice to the auditor concerned stating the grounds for such revocation, suspension or withdrawal.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (4); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (5) the following subsection: “ (5) For the purposes of this Part, an auditor whose registration has been revoked or suspended or whose recognition has been withdrawn or suspended, as the case may be, shall be deemed not to be registered or recognized as an auditor from the date the revocation, withdrawal or suspension takes effect or any other date as may be specified by the Audit Oversight Board.”. Amendment of section 31R"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
