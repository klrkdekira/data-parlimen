      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 147 the following section: “Decision of Minister or Commission to be final 147. Except as otherwise provided in the securities laws— (a) any decision made by the Minister under the securities laws, whether an original decision by him or a decision on appeal to him from a decision of the Commission; or (b) any decision by the Commission under the securities laws made pursuant to an appeal to review its original decision, shall be final.”. Amendment of section 150A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_29__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_29__para_b"
