      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “public interest entity” the following definitions: ‘ “recognised auditor” means a foreign individual auditor or foreign audit firm recognised under section 31O as an auditor of a public interest entity;’; and ‘ “registered auditor” means an individual auditor or audit firm registered under section 31O as an auditor of a public interest entity;’;"
      }
    },
