      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2A), dengan menggantikan perkataan “kontrak niaga hadapan” dengan perkataan “derivatif”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
