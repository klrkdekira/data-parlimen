      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_3__para_l",
