      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 22A Akta ibu dipinda dengan menggantikan perkataan “niaga hadapan” dengan perkataan “derivatif”. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_5",
