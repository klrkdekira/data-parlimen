      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (e) dengan perenggan yang berikut: “(e) memajukan dan mengawal selia segala perkara yang berhubungan dengan pengurusan kumpulan wang, termasuklah skim unit amanah;”;"
      }
    },
