      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 31L(4) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Lembaga Pemantauan Audit hendaklah” dengan perkataan “Suruhanjaya hendaklah”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “suatu kunci kira-kira” dengan perkataan “penyata akaun”. Pindaan Penggal 4 Bahagian IIIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dalam subtajuk Penggal 4 Bahagian IIIA dengan memasukkan selepas perkataan “Pendaftaran” perkataan “atau Pengiktirafan”. Pindaan seksyen 31N"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 31N Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “pendaftaran” perkataan “atau pengiktirafan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “didaftarkan” perkataan “sebagai juruaudit berdaftar atau diiktirafkan sebagai juruaudit yang diiktiraf”. Pindaan seksyen 31O"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 31O Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “pendaftaran dan pembaharuan pendaftaran” dengan perkataan “pendaftaran, pembaharuan pendaftaran dan pengiktirafan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “ (1) Bagi maksud Akta ini, suatu permohonan untuk— (a) pendaftaran atau pembaharuan pendaftaran sebagai juruaudit berdaftar; atau (b) pengiktirafan sebagai juruaudit yang diiktiraf, hendaklah dibuat kepada Lembaga Pemantauan Audit.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “ (3) Tertakluk kepada seksyen 31 P, Lembaga Pemantauan Audit boleh— (a) meluluskan atau menolak pendaftaran seseorang pemohon sebagai juruaudit berdaftar atau pembaharuan pendaftaran seseorang juruaudit berdaftar; atau (b) meluluskan atau menolak pemberian pengiktirafan seseorang pemohon sebagai juruaudit yang diiktiraf.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (4) dengan subseksyen yang berikut: “ (4) Lembaga Pemantauan Audit boleh, selepas— (a) pendaftaran seseorang pemohon sebagai juruaudit berdaftar; (b) pembaharuan pendaftaran seseorang juruaudit berdaftar; atau (c) pemberian pengiktirafan seseorang pemohon sebagai juruaudit yang diiktiraf, mengenakan apa-apa syarat yang difikirkannya perlu atau suai manfaat dan dari semasa ke semasa meminda mana-mana syarat itu atau mengenakan syarat baru atau syarat tambahan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “pendaftaran atau pembaharuan pendaftaran,” dengan perkataan “yang dikenakan di bawah subseksyen (4),”. Pindaan seksyen 31P"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_a",
