        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 31P Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “pendaftaran atau pembaharuan pendaftaran” dengan perkataan “pendaftaran, pembaharuan pendaftaran atau pemberian pengiktirafan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “seseorang juruaudit” perkataan “berdaftar”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “juruaudit” perkataan “berdaftar”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “ (1A) Lembaga Pemantauan Audit boleh menolak untuk mengiktirafkan seseorang pemohon sebagai juruaudit yang diiktiraf jika Lembaga Pemantauan Audit berpuas hati bahawa pemohon itu— (a) termasuk dalam perenggan (1)(b), (c), (d) atau (f); (b) telah tertakluk kepada apa-apa hukuman yang dikenakan oleh mana-mana pihak berkuasa asing yang berkaitan; (c) belum diluluskan oleh pihak berkuasa asing yang berkaitan untuk menyediakan penyata kewangan teraudit; atau (d) tidak diawasi oleh suatu pihak berkuasa asing yang berkaitan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “ (2) Jika Lembaga Pemantauan Audit menolak— (a) pendaftaran seseorang pemohon sebagai juruaudit berdaftar; (b) pembaharuan pendaftaran seseorang juruaudit berdaftar; atau (c) pemberian pengiktirafan seseorang pemohon sebagai juruaudit yang diiktiraf, Lembaga Pemantauan Audit hendaklah memberi pemohon atau juruaudit berdaftar tersebut suatu peluang untuk didengar dengan menyampaikan suatu notis bertulis kepada pemohon atau juruaudit berdaftar itu yang menyatakan alasan bagi penolakan tersebut.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3). Pindaan seksyen 31Q"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/18/msa@/~cl_15",
      "@type": "akn:clause",
