      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/2/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (6). Amendment of section 21BA"
      }
    },
    {
