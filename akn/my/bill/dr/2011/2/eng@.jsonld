      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/2/eng@/~cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (6) the following subsection: “(6) For the purposes of subsection (2) and subparagraph (3)(b)(i) of the proviso, subsections 29A(5), (6) and (7) shall apply mutatis mutandis.”."
      }
    },
