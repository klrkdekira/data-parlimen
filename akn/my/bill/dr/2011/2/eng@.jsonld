    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/2/eng@/~cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/2/eng@/~cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: “(2) Where a company which has been granted approval under section 27L has incurred, in the basis period for a year of assessment in respect of a manufacturing activity, capital expenditure for the purpose of relocating that manufacturing activity, the company shall be given for that year of assessment an investment tax allowance of one hundred per cent of that expenditure.”; and"
      }
