      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 21BA(2) of the principal Act is amended by substituting for the words “(3), (4) and (5)” the words “(3) and"
      }
    },
