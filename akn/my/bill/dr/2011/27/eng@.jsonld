      ],
      "schema:name": {
        "@language": "en",
        "@value": "Restricted Residence (Repeal) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Restricted Residence (Repeal) Act 2011. Repeal of Act and saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Restricted Residence Act 1933 [Act 377] is repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The repeal of the Restricted Residence Act 1933 shall not affect any order issued or made, or action or proceedings taken, under the repealed Act prior to the date of coming into operation of this Act. Order to cease to have effect, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection 2(2), on the date of coming into operation of this Act, any order issued or made under the repealed Act which is still in force on the date of coming into operation of this Act shall cease to have effect and any pending action or proceedings under the repealed Act shall be discontinued."
      }
    }
  ]
