      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Kediaman Terhad (Pemansuhan) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kediaman Terhad (Pemansuhan) 2011. Pemansuhan Akta dan kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kediaman Terhad 1933 [Akta 377] dimansuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemansuhan Akta Kediaman Terhad 1933 tidaklah menjejaskan apa-apa perintah yang dikeluarkan atau dibuat, atau tindakan atau prosiding yang diambil, di bawah Akta yang dimansuhkan sebelum tarikh permulaan kuat kuasa Akta ini. Perintah hendaklah terhenti berkuat kuasa, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/27/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen 2(2), pada tarikh permulaan kuat kuasa Akta ini, mana-mana perintah yang dikeluarkan atau dibuat di bawah Akta yang dimansuhkan yang masih berkuat kuasa pada tarikh permulaan kuat kuasa Akta ini hendaklah terhenti berkuat kuasa dan apa-apa tindakan atau prosiding yang belum selesai di bawah Akta yang dimansuhkan hendaklah dihentikan."
      }
    }
  ]
