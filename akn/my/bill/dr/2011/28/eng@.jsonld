      "schema:name": {
        "@language": "en",
        "@value": "Banishment (Repeal) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Banishment (Repeal) Act 2011. Repeal of Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Banishment Act 1959 [Act 79] is repealed. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The repeal of the Banishment Act 1959 shall not affect any warrant, order, direction or other instrument, or detention, issued or made under the Act prior to the date of the coming into operation of this Act."
      }
    }
  ]
