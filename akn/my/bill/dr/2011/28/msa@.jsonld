      "schema:text": {
        "@language": "ms",
        "@value": "Akta Buang Negeri 1959 [Akta 79] dimansuhkan. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/28/msa@/~cl_3",
