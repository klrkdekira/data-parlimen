        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_h",
