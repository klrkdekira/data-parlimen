      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Duty to maintain secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law, no member of the Institute or any of its committees, officer, employee or agent of the Institute or any person attending any meeting of the Institute or any of its committees shall disclose any information which has been obtained by him in the course of his duties and which is not published in pursuance of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding two years or to both. Protection against suit and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted or maintained against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Institute or a committee, or any officer, employee or agent of the Institute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "any person lawfully acting on behalf of the Institute, in respect of any act, neglect, default or omission done or omitted by him or it in good faith in such capacity. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Institute or against any member of the Institute, any member of a committee, or any officer, employee or agent of the Institute in respect of any act, neglect, default or omission done or omitted by him or it in such capacity. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Institute or a committee, or any officer, employee or agent of the Institute, while discharging his duty under this Act as such member, officer, employee or agent, shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as are necessary or expedient to give full effect to or for carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Minister may make regulations—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the fees and charges payable to the Institute under this Act and the manner for collecting and disbursing such fees and charges;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribing the procedure to be followed for the administration of the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "providing for the implementation of foundation talent identification programmes and follow through programmes for potential athletes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "providing for such other matters as are contemplated by, or necessary for giving full effect to the provisions of this Act. Acts done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "All acts and things done by any person on behalf of the Institute in the preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto shall be deemed to have been authorized under this Act, provided that the acts and things done are consistent with the general intention and purposes of this Act; and all rights and obligations acquired or incurred as a result of doing those acts or things including any expenditure incurred in relation thereto shall, on coming into operation of this Act, be deemed to be the rights and obligations of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister and the Minister of Finance, borrow, at such rate of interest and for such period and upon such terms as to the time and method of repayment and otherwise as the Minister and the Minister of Finance may approve, any sums required by the Institute for meeting any of its obligations or discharging any of its duties. Power to invest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The moneys of the Institute shall, insofar as they are not required to be expended by the Institute under this Act, be invested in such manner as the Minister and the Minister of Finance may approve. Power to employ agents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may employ, appoint and pay agents, contractors and technical advisers, including advocates and solicitors, bankers, stockbrokers, surveyors, valuers and other persons, to transact any business or to do any act required to be transacted or done in the performance of its functions, the exercise of its powers or the discharge of its duties or for the better carrying into effect of the purposes of this Act. Power to establish companies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may establish companies under the Companies Act 1965 [Act 125] to carry out and have the charge, conduct and management of any project, scheme or enterprise which has been planned or undertaken by the Institute in the performance of its functions and the exercise of its powers. Financial assistance to company established by the Institute, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Institute may, with the approval of the Minister and the Minister of Finance, provide financial assistance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "to any company established under section 41; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "to any person involved in conducting research, development and innovation activities relating to sports science and sports medicine, with or without interest and for such period and upon such terms as to the time and method of repayment and otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the “National Sports Institute Fund” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be controlled, maintained and operated by the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_a",
