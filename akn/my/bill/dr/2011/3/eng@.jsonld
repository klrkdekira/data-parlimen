        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "paying any expenditure lawfully incurred by the Institute;"
      }
    },
    {
