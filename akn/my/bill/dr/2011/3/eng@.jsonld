      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "moneys earned from consultancy and advisory services and any other services rendered by the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "moneys received by the Institute by way of grants;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all other moneys lawfully received by the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_29__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "all other sums and property which may in any manner become payable to or vested in the Institute in respect of any matter incidental to its functions and powers. Expenditure to be charged on Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/3/eng@/~part_VI__cl_30__para_a",
