      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph 9—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26__para_c__subpara_i",
