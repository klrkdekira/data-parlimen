      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “approved scheme”, by inserting after the words “Employees Provident Fund” the words “, private retirement scheme”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_4__para_a__subpara_ii",
