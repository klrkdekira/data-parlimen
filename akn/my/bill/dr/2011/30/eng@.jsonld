      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of “Eastern Corridor of Peninsular Malaysia”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26__para_c__subpara_ii",
