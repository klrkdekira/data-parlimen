      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 26(b) is deemed to have effect from the year of assessment 2011. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_4",
