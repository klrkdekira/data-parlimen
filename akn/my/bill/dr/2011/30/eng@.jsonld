        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_II__chp_V__cl_36__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_II__chp_V__cl_36__para_b"
