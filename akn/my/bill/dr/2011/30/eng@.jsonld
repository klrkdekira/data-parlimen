      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “prescribed” the following definition: ‘ “private retirement scheme” means a retirement scheme approved by the securities Commission in accordance with the Capital markets and services Act 2007 [Act 671];’; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_4__para_b",
