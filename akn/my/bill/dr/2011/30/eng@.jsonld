      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 6(1)(i) of the principal Act is amended by substituting for the words “three years from the year of assessment 2009” the words “five years from the year of assessment 2012”. Amendment of section 6a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_6",
      "@type": "akn:clause",
