      "schema:text": {
        "@language": "en",
        "@value": "section 45 of the principal Act is amended by substituting for subsection (5) the following subsection: “(5) the election referred to in subsection (2) shall be made in a return furnished in accordance with subsection 77(1).”. Amendment of section 49"
      }
    }
