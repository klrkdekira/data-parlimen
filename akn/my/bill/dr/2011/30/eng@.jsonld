      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "in the proviso to paragraph 3, by deleting the words “where the qualifying project is located within the States of Sabah, Sarawak, the Federal Territory of Labuan, Perlis, the Eastern Corridor of Peninsular Malaysia and such other areas which the Minister may from time to time determine or”;"
      }
    },
    {
