      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “Minister” the words “Inland Revenue Board of Malaysia”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_23__para_c__subpara_ii",
