      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_23__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
