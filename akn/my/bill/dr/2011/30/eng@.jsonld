      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (c) the following paragraph: “ (c) a “contract research and development company” and a “research and development company” have the same meaning assigned thereto in section 2 of the Promotion of Investments Act 1986 and fulfills the conditions specified by the relevant ministry;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_7__para_b",
