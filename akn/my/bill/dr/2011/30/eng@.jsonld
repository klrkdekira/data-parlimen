      "schema:name": {
        "@language": "en",
        "@value": "subsection 34b(4) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_7__para_a",
