      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1a), by substituting for the words “section 6a” the words “subsection 6a(1)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_23__para_b",
