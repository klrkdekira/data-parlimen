      "schema:text": {
        "@language": "en",
        "@value": "this Act may be cited as the Finance (No. 2) Act 2011. Amendment of Acts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~chp_I",
      "schema:text": {
        "@language": "en",
        "@value": "the Income tax Act 1967 [Act 53], the stamp Act 1949 [Act 378], the real Property gains tax Act 1976 [Act 169], the Labuan Business Activity tax Act 1990 [Act 445] and the Finance Act 2009 [Act 693] are amended in the manner specified in Chapters II, III, Iv, v and vI respectively."
      }
    },
