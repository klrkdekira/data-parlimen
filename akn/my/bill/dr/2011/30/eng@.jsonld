      "schema:text": {
        "@language": "en",
        "@value": "in subsection 2(8), by substituting for the words “or the Labuan offshore Financial services Authority” the words “, the Labuan Financial services Authority or the malaysia Co-operative societies Commission”. Amendment of section 6"
      }
    },
