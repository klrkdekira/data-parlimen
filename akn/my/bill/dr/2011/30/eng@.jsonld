      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (d), by substituting for the words “the period” the words “the basis period”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/eng@/~part_I__cl_26__para_b__subpara_iii",
