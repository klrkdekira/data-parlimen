        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 49 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_10__para_a__subpara_i",
