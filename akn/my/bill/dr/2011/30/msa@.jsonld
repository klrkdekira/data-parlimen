      "schema:name": {
        "@language": "ms",
        "@value": "Akta Setem 1949, yang disebut “Akta ibu” dalam Bab ini, dipinda dalam seksyen 9—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_III__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
