        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_23__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 134 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_23__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_I__cl_23",
      "schema:text": {
        "@language": "ms",
