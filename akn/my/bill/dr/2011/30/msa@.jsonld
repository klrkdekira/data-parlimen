      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan butiran 19 dengan butiran yang berikut: “19 ANy BOND furnished to An immigration officer”; the Director General of dan Immigration in connection with the grant of any pass or permit issued under the Immigration Act 1959/63 [Act 155]"
      }
    },
    {
