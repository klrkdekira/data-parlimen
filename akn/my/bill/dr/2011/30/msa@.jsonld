      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 1, di bawah “GENERAL EXEMPTIONS”, dengan memotong perkataan “or the Malayan Railway” di mana-mana jua terdapat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_III__cl_31__para_f",
