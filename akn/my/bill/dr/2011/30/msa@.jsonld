      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], Akta Setem 1949 [Akta 378], Akta Cukai Keuntungan Harta Tanah 1976 [Akta 169], Akta Cukai Aktiviti Perniagaan Labuan 1990 [Akta 445] dan Akta Kewangan 2009 [Akta 693] dipinda mengikut cara yang dinyatakan masing-masing dalam Bab II, III, IV, V dan VI."
      }
    },
