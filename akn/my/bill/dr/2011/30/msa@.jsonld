      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran 23—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_III__cl_31__para_c__subpara_i",
