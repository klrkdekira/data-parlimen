      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 6, di bawah “GENERAL EXEMPTIONS”, dengan memasukkan selepas perkataan “the Labuan Financial Services Authority” perkataan “, the Malaysia Co-operative Societies Commission”. Pindaan Jadual Kedua"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_III__cl_32",
