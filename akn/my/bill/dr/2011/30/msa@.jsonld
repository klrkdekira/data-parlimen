      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas butiran 19 butiran yang berikut: “19a EMPLOyMENT An immigration officer”. CONTRACT issued to the Immigration Department for the purpose of securing a pass"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_IV",
      "@type": "akn:chapter",
