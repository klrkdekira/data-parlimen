      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA CUKAI KEUNTUNGAN HARTA TANAH 1976 Permulaan kuat kuasa pindaan kepada Akta Cukai Keuntungan Harta Tanah 1976"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini berkuat kuasa mulai tahun taksiran 2012. Pindaan Jadual 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Keuntungan Harta Tanah 1976 dipinda dalam subperenggan 3(g) Jadual 2 dengan memasukkan selepas perkataan “Bank Negara” perkataan “, Lembaga Perkhidmatan Kewangan Labuan, Suruhanjaya Koperasi Malaysia”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_V",
      "@type": "akn:chapter",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_V__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_V__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA CUKAI AKTIVITI PERNIAGAAN LABUAN 1990 Permulaan kuat kuasa pindaan kepada Akta Cukai Aktiviti Perniagaan Labuan 1990"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_VI",
      "@type": "akn:chapter",
      "eli:number": "VI",
      "hasPart": [
