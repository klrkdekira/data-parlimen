      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran 32, di bawah “Exemptions”, dalam subperenggan (b)(v), dengan memotong perkataan “or of the Malayan Railway”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/30/msa@/~part_II__chp_III__cl_31__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
