      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Lembaga Hasil Dalam Negeri Malaysia (Pindaan) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Hasil Dalam Negeri Malaysia (Pindaan) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3 disifatkan mula berkuat kuasa pada 1 November 2011. Pindaan seksyen 6a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Lembaga Hasil Dalam Negeri Malaysia 1995 [Akta 533], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 6a—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Lembaga hendaklah, selepas berunding dengan ketua pegawai eksekutif, melantik dua atau lebih timbalan ketua pegawai eksekutif.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan “ketua pegawai eksekutif” perkataan “dan timbalan ketua pegawai eksekutif”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Sekiranya ketua pegawai eksekutif buat sementara waktu tidak berdaya melaksanakan tugasnya disebabkan dia sakit atau apa-apa sebab lain, Menteri hendaklah, atas syor Lembaga, melantik seorang daripada timbalan ketua pegawai eksekutif untuk bertindak bagi menggantikan ketua pegawai eksekutif dalam tempoh ketidakdayaan itu.”. Seksyen baru 10b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 10a seksyen yang berikut: “Fungsi tambahan Lembaga 10b. Lembaga boleh melaksanakan mana-mana fungsi lain sebagaimana yang diarahkan oleh Menteri, termasuklah pengurusan wang dan pembayaran wang itu kepada mana- mana orang.”."
      }
    }
  ]
}
