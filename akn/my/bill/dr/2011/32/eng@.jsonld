        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The amendments in paragraphs 5(a) and (b) of this Act shall not affect the grant of a pension to an officer who before 1 January 2012—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has optionally retired;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has exceeded the age of fifty-five years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has attained his compulsory age of retirement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The grant of a pension to an officer who before 1 January 2012—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has optionally retired;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has exceeded the age of fifty-five years; but"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not attained his compulsory age of retirement, shall only be made from 1 January 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The payment of derivative pension or derivative retiring allowance in consequence of the amendments made under sections 7 and 11 of this Act to any person prescribed in the regulations, if the period of twelve and a half years has expired before 1 January 2012, shall be dealt with as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the period of twenty years shall be calculated from the date of the retirement of the officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the persons shall not be entitled to the payment of derivative pension or derivative retiring allowance for the period after the expiration of twelve and a half years until 31 December 2011; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of derivative pension or derivative retiring allowance shall only be made from 1 January 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Pensions (Amendment) Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 January 2012. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/32/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Pensions Act 1980 [Act 227], which is referred to as “the principal Act” in this Act, is amended in section 6 by inserting after subsection (2) the following subsection: “(3) Any pension, gratuity or other benefit granted to an officer who retires under section 11 shall be computed in accordance with the regulations where the total period of his reckonable service shall be counted as if he had served until his compulsory age of retirement, whichever is applicable to him.”. Amendment of section 6a"
      }
    },
