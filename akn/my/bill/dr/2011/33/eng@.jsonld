      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2A) the following subsection: “(2A) Where an employee referred to in subsection (2) who was appointed before 1 January 2012 had been given an option before such date and had not opted for the compulsory age of retirement of sixty years, subsection (2) shall apply to him with the words ‘fifty- five’ or ‘fifty-six’ or ‘fifty-eight’, as the case may be, being substituted for the word ‘sixty’.”. Amendment of section 16"
      }
    },
