      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “, fifty- five years of age, fifty-six years of age or fifty-eight years of age” the words “or fifty-five years of age”. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_6",
