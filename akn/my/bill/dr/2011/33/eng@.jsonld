      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “fifty- eight” the word “sixty”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_6__para_b",
