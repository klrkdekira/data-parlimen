      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 26 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “fifty- eight” the word “sixty”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2A) the following subsection: “(2A) Where an employee referred to in subsection (2) who was reappointed before 1 January 2012 had been given an option before such date and had not opted for the compulsory age of retirement of sixty years, subsection (2) shall apply to him with the words ‘fifty- five’ or ‘fifty-six’ or ‘fifty-eight’, as the case may be, being substituted for the word ‘sixty’.”. Savings and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/eng@/~cl_11",
      "@type": "akn:clause",
