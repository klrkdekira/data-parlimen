      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_6__para_a",
