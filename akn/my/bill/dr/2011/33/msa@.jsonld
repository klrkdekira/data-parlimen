      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan menggantikan perkataan “lima puluh lapan” dan “1 Julai 2008” masing-masing dengan perkataan “enam puluh” dan “1 Januari 2012”;"
      }
    },
