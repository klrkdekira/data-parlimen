      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) , dengan menggantikan perkataan “lima puluh lapan” dengan perkataan “enam puluh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3) dan (4), dengan menggantikan perkataan “atau lima puluh lapan” dengan perkataan “, lima puluh lapan atau enam puluh”;"
      }
    },
    {
