      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 26 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “lima puluh lapan” dengan perkataan “enam puluh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2A) dengan subseksyen yang berikut: “(2A) Jika seseorang pekerja yang disebut dalam subseksyen (2) yang telah dilantik semula sebelum 1 Januari 2012 telah diberikan opsyen sebelum tarikh itu dan tidak memilih umur persaraan paksa enam puluh tahun, subseksyen (2) hendaklah terpakai baginya dengan menggantikan perkataan ‘enam puluh’ dengan perkataan ‘lima puluh lima’ atau ‘lima puluh enam’ atau ‘lima puluh lapan’, mengikut mana-mana yang berkenaan.”. Tempatan (Pindaan) Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan dalam perenggan 5(a) dan (b) Akta ini tidaklah menjejaskan pemberian pencen kepada seseorang pekerja yang sebelum 1 Januari 2012—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah bersara pilihan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melebihi umur lima puluh lima tahun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mencapai umur persaraan paksanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberian pencen kepada seseorang pekerja yang sebelum 1 Januari 2012—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "telah bersara pilihan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melebihi umur lima puluh lima tahun; tetapi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "belum mencapai umur persaraan paksanya, hendaklah hanya dibuat mulai 1 Januari 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembayaran pencen terbitan atau elaun persaraan terbitan yang berbangkit daripada pindaan yang dibuat di bawah seksyen 7 Akta ini kepada mana-mana orang yang ditetapkan dalam peraturan-peraturan, jika tempoh dua belas tahun setengah telah habis sebelum 1 Januari 2012, hendaklah diuruskan sebagaimana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh dua puluh tahun itu hendaklah dikira dari tarikh persaraan pekerja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak berhak untuk mendapat pembayaran pencen terbitan atau elaun persaraan terbitan bagi tempoh selepas habisnya tempoh dua belas tahun setengah hingga 31 Disember 2011; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran pencen terbitan atau elaun persaraan terbitan itu hendaklah hanya dibuat mulai 1 Januari 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pencen Pihak Berkuasa Berkanun dan Tempatan (Pindaan) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2012. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pencen Pihak Berkuasa Berkanun dan Tempatan 1980 [Akta 239], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 5 dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Apa-apa pencen, ganjaran atau faedah lain yang diberikan kepada seseorang pekerja yang bersara di bawah seksyen 11 hendaklah dihitung mengikut peraturan-peraturan yang jumlah tempoh perkhidmatan yang boleh dimasuk kira baginya hendaklah dikira seolah-olah pekerja itu telah berkhidmat sehingga mencapai umur persaraan paksanya, yang mana jua terpakai baginya.”. Pindaan seksyen 6A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6A Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “lima puluh lapan” dengan perkataan “enam puluh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5A), dengan menggantikan perkataan “1 Julai 2008” dan “lima puluh lapan” masing-masing dengan perkataan “1 Januari 2012” dan “enam puluh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5B)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima puluh lapan” dan “1 Julai 2008” masing-masing dengan perkataan “enam puluh” dan “1 Januari 2012”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “lima puluh enam tahun” perkataan “atau lima puluh lapan tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5C), dengan menggantikan perkataan “lima puluh lapan” dengan perkataan “enam puluh”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_4",
      "@type": "akn:clause",
