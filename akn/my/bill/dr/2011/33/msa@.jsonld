      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/33/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
