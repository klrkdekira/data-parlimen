      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Penyelarasan Pencen (Pindaan) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Penyelarasan Pencen (Pindaan) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2012. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Penyelarasan Pencen 1980 [Akta 238], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 4 dengan menggantikan perkataan “dua belas tahun setengah”, di mana- mana jua terdapat, dengan perkataan “dua puluh tahun”. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu dipinda dengan menggantikan perkataan “dua belas tahun setengah”, di mana-mana jua terdapat, dengan perkataan “dua puluh tahun”. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembayaran pencen terbitan atau elaun persaraan terbitan yang berbangkit daripada pindaan yang dibuat di bawah seksyen 2 dan 3 Akta ini kepada orang selain mereka yang disebut dalam subseksyen 4(3) dan 5(4) Akta ibu, jika tempoh dua belas tahun setengah itu telah habis sebelum 1 Januari 2012, hendaklah diuruskan sebagaimana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh dua puluh tahun itu hendaklah dikira dari tarikh persaraan pegawai itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak berhak untuk mendapat pembayaran pencen terbitan atau elaun persaraan terbitan bagi tempoh selepas habisnya tempoh dua belas tahun setengah hingga 31 Disember 2011; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/34/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran pencen terbitan atau elaun persaraan terbitan itu hendaklah hanya dibuat mulai 1 Januari 2012."
      }
    }
  ]
}
