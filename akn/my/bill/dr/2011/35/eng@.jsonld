      "schema:name": {
        "@language": "en",
        "@value": "Judges Remuneration (Amendment) (No. 2) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Judges’ Remuneration (Amendment) (No. 2) Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 January 2012. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Judges’ Remuneration Act 1971 [Act 45], which is referred to as the “principal Act” in this Act, is amended in section 11 by substituting for the words “twelve and a half years”, wherever they appear, the words “twenty years”. Savings and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The payment of derivative pension in consequence of the amendment made under section 2 of this Act to persons other than those mentioned in subsection 11(3) of the principal Act, if the period of twelve and a half years has expired before 1 January 2012, shall be dealt with as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "the period of twenty years shall be calculated from the date of the retirement of the Judge;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "the persons shall not be entitled to the payment of derivative pension for the period after the expiration of the period of twelve and a half years until 31 December 2011; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "the payment of derivative pension shall only be made from 1 January 2012."
      }
    }
  ]
}
