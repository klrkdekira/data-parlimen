      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Saraan Hakim (Pindaan) (No.2) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Saraan Hakim (Pindaan) (No. 2) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2012. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Saraan Hakim 1971 [Akta 45], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 11 dengan menggantikan perkataan “dua belas tahun setengah”, di mana-mana jua terdapat, dengan perkataan “dua puluh tahun”. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembayaran pencen terbitan yang berbangkit daripada pindaan yang dibuat di bawah seksyen 2 Akta ini kepada orang selain mereka yang disebut dalam subseksyen 11(3) Akta ibu, jika tempoh dua belas tahun setengah itu telah habis sebelum 1 Januari 2012, hendaklah diuruskan sebagaimana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh dua puluh tahun itu hendaklah dikira dari tarikh persaraan Hakim itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak berhak untuk mendapat pembayaran pencen terbitan bagi tempoh selepas habisnya tempoh dua belas tahun setengah hingga 31 Disember 2011; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/35/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran pencen terbitan itu hendaklah hanya dibuat mulai 1 Januari 2012."
      }
    }
  ]
}
