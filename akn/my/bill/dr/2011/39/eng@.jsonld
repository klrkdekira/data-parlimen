        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the principal Act is amended in section 407A—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by deleting the words “after the case management”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by deleting the words “with the consent of the accused”; and Act 2010 (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(4) Where the Court makes an order for the disposal of the articles under subsection (3), the Court may allow the accused to take photographs of the articles.”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended by substituting for paragraph (a) the following paragraph: ‘(a) by substituting for subsection (1) the following subsection: “(1) The Court before which an accused is convicted of an offence—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in its discretion, may make an order for the payment by the convicted accused of the cost of his prosecution or any part thereof as may be agreed by the Public Prosecutor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the prosecution of the convicted accused involves evidence obtained pursuant to a request made under the Mutual Assistance in Criminal Matters Act 2002 [Act 621]; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_7__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the accused has obtained pecuniary gain, upon the application of the Public Prosecutor, shall make an order for the payment by the convicted accused of the cost of his prosecution or any part thereof, the sum of which is to be fixed by the Court as may be agreed by the Public Prosecutor.”.’."
      }
    }
  ]
}
