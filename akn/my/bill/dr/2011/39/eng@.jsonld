      "schema:name": {
        "@language": "en",
        "@value": "Criminal Procedure Code (Amendment) Bill 2010 (Amendment) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/39/eng@/~cl_1",
      "@type": "akn:clause",
