      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Kootu Funds (Prohibition) (Amendment) Act 2011. (2) This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 3"
      }
    },
    {
