      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/4/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima ribu” dengan perkataan “lima ratus ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/4/msa@/~cl_2__para_b",
