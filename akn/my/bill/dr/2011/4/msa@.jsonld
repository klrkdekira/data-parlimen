      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/4/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta (Larangan) Kumpulan Wang Kutu 1971 [Akta 28] dipinda dalam seksyen 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/4/msa@/~cl_2__para_a",
