        "@value": "Criminal Procedure Code (Amendment) Bill 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/40/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
