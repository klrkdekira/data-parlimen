      "schema:text": {
        "@language": "en",
        "@value": "a description of the sound amplification equipment or device proposed to be used, if any, during the assembly. Consent of owner or occupier of place of assembly"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The organizer of an assembly, other than a religious assembly or a funeral procession or an assembly held at a designated place of assembly, shall obtain the consent of the owner or occupier of the place of assembly for it to be used for the purpose of the assembly. Requirement to inform persons who have interests"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_12",
