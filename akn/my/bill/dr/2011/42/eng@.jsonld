      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the person appointed by the organizer to be in charge of the orderly conduct of the assembly; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_xi",
