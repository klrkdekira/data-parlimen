        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
