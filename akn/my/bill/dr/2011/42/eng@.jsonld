        "@value": "be in the form in the Fourth Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
