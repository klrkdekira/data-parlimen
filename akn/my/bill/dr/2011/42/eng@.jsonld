      "schema:text": {
        "@language": "en",
        "@value": "the protected areas and protected places declared under the Protected Areas and Protected Places Act 1959 [Act 298]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_3__para_b",
