      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~sched_4__para_10",
      "schema:text": {
        "@language": "en",
        "@value": "any place at which the procession will stop: ………………........…"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~sched_4__para_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~sched_4__para_10",
      "schema:text": {
        "@language": "en",
