      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Peaceful Assembly Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an assembly which is an election campaign under the Election Offences Act 1954 [Act 5]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "an assembly which is a strike, lock-out or picket under the Industrial Relations Act 1967 [Act 177] and the Trade Unions Act 1959 [Act 262]. Objects"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "The objects of this Act are to ensure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "so far as it is appropriate to do so, that all citizens have the right to organize assemblies or to participate in assemblies, peaceably and without arms; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the exercise of the right to organize assemblies or to participate in assemblies, peaceably and without arms, is subject only to restrictions deemed necessary or expedient in a democratic society in the interest of the security of the Federation or any part thereof or public order, including the protection of the rights and freedoms of other persons. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“rights and freedoms of other persons” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
