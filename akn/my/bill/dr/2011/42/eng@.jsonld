      "schema:text": {
        "@language": "en",
        "@value": "the name and details of the organizer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_ii",
