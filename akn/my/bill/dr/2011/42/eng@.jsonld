      "schema:text": {
        "@language": "en",
        "@value": "be accompanied by any additional document as may be specified by the Officer in Charge of the Police District, if any; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e",
