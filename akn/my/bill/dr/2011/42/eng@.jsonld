      "schema:text": {
        "@language": "en",
        "@value": "the route of the procession:…………………………........................."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~sched_4__para_10__para_b",
      "@type": "akn:paragraph",
